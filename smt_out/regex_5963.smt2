(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^(([X-Z]{1})(\d{7})([A-Z]{1}))|((\d{8})([A-Z]{1}))|(([A-Z]{1})(\d{8}))$")))
(assert (= x "<div draggable=""true"" contenteditable>drag me</div><listing ondragover=alert(1) contenteditable>drop here</listing>"))
(check-sat)
