(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "([0-9]|0[0-9]|1[0-9]|2[0-3])([.]|:)[0-5][0-9]")))
(assert (= x "<style>:target {transform: rotate(180deg);}</style><nobr id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></nobr>"))
(check-sat)
