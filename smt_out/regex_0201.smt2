(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[-A-Za-z0-9&#39;,.!()@ -]{1,32}$")))
(assert (= x "<style>:target {transform: rotate(180deg);}</style><tfoot id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tfoot>"))
(check-sat)
