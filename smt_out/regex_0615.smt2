(set-logic QF_S)
(set-info :status sat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "(\w+([-+.]\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*)|([a-zA-Z\-0-9]+)")))
(assert (= x "<style>:target {color: red;}</style><menu id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></menu>"))
(check-sat)
