; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><u id=x style=""transition:color 1s"" ontransitionend=alert(1)></u>") (= x "<svg><a onload=alert(1)></a>") (= x "#0000108&#0000101&#0000114&#0000116&#0000040&#0000039&#0000088&#0000083&#0000083&#0000039&#0000041>")))
(assert (or (= z "script&&>javascript:alert(1)&&;&&<&&/script&&>") (= z "s>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9.!#$%&\u{432}\u{402}\u{2122}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:05)\d{8}$")) (not (= ">" (str.substr z 1 9)))))
(assert (or (str.suffixof "e>" x) (>= (str.len x) 95)))
(assert (or (not (str.suffixof ">" x)) (not (>= (str.len x) 27)) (not (= (str.indexof z "ava" 0) 10))))
(assert (not (str.prefixof "s" z)))
(check-sat)
