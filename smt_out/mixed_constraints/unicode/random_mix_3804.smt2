; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter onbeforecut=""alert(1)"" contenteditable>test</meter>") (= x "<code id=x tabindex=1 onbeforeactivate=alert(1)></code>") (= x "<nav oncontextmenu=""alert(1)"">\u{1d400}test\u{1f4a9}</nav>")))
(assert (or (= z "alert(1)"" contenteditable>test</base>") (= z " autofocus>") (= z "alert(1)></nobr><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len z) 11) (not (= "orec" (str.substr y 12 4)))))
(assert (or (not (str.prefixof "<nav o" x)) (not (str.suffixof "r>" x))))
(assert (or (not (= "\u{1f4a9}</nav> " (str.substr y 35 8))) (= (str.indexof x "e>t" 0) 44) (str.suffixof "autofocus>" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9 ]+){3,}$"))))
(assert (or (= (str.len z) 33) (not (= (str.indexof x "T f" 0) 66))))
(check-sat)
