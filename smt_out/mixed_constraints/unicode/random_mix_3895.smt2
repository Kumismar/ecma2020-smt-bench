; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><br id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></br>") (= x "<basefont onmouseleave=""alert(1)"">test</basefont>")))
(assert (or (= z "aste=""alert(1)"" contenteditable>test</param>") (= z "ationend=""alert(1)""></legend>") (= z "t(1)"">test</rtc>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "eckbox id=") (not (= (str.indexof x "rt" 0) 96)) (str.contains x "style=")))
(assert (or (= "<st<b>e>@keyframes x{}</style><img style=""animation-name:x"" onanimationend=""alert(1)""></img>" (str.replace x "yl" "<b>")) (not (= "t(1)"">test<""tc>" (str.replace z "/r" """")))))
(assert (not (>= (str.len z) 146)))
(assert (str.contains y "s"" "))
(assert (not (= "pa" (str.substr z 38 2))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "[A-z0-9]{4}")))
(assert (not (str.suffixof "t</param>" y)))
(check-sat)
