; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img DYNSRC=""javascript:document.vulnerable=true;"">") (= x "<input type=radio id=x onfocus=alert(1)>")))
(assert (or (= z "useleave=""alert(1)"">test</source>") (= z "ble=""true"" ondragend=""alert(1)"">test</track>") (= z "lert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "track>" z)) (= (str.at x 28) "m")))
(assert (not (>= (str.len x) 50)))
(assert (or (not (= "urce>" (str.substr y 79 8))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._-]{1,50}"))) (= (str.at z 3) "d")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z\u{e0}\u{e1}\u{e2}\u{e4}\u{e3}\u{e5}\u{105}\u{10d}\u{107}\u{119}\u{e8}\u{e9}\u{ea}\u{eb}\u{117}\u{12f}\u{ec}\u{ed}\u{ee}\u{ef}\u{142}\u{144}\u{f2}\u{f3}\u{f4}\u{f6}\u{f5}\u{f8}\u{f9}\u{fa}\u{fb}\u{fc}\u{173}\u{16b}\u{ff}\u{fd}\u{17c}\u{17a}\u{f1}\u{e7}\u{10d}\u{161}\u{17e}\u{c0}\u{c1}\u{c2}\u{c4}\u{c3}\u{c5}\u{104}\u{106}\u{10c}\u{116}\u{118}\u{c8}\u{c9}\u{ca}\u{cb}\u{cc}\u{cd}\u{ce}\u{cf}\u{12e}\u{141}\u{143}\u{d2}\u{d3}\u{d4}\u{d6}\u{d5}\u{d8}\u{d9}\u{da}\u{db}\u{dc}\u{172}\u{16a}\u{178}\u{dd}\u{17b}\u{179}\u{d1}\u{df}\u{c7}\u{152}\u{c6}\u{10c}\u{160}\u{17d}\u{2202}\u{f0} ,'-]{2,100}"))) (str.contains x "es") (= (str.at y 8) "y")))
(check-sat)
