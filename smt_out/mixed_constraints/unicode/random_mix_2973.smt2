(assert (or (str.suffixof "</canvas>" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{0,1}$"))) (not (= "<alert(1) id=""126""><object id=""x"" classid=""clsid:CB927D12-4FF7-4a9e-A169-56E4B8A75598""></object>5rt'](1)" (str.replace y "div" "alert(1)")))))
