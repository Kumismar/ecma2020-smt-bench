; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><bdo id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></bdo>") (= x "<noscript oncopy=""alert(1)"" contenteditable>test</noscript>") (= x "<track draggable=""true"" ondrag=""alert(1)"">test</track>")))
(assert (or (= z "nstart=""alert(1)""></article>") (= z "ition:color 1s"" ontransitionend=alert(1)></title>")))
(assert (= y (str.++ x z)))
(assert (= "lert(1)" (str.substr z 33 7)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w-]+(\.[\w-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,4})$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\D{3,30}$"))) (str.suffixof ")></bdi>" x)))
(assert (or (not (str.contains x "ble=""t")) (= "<noscript oncopy=""alert(1)"" contenteditable>test<xoscript>nstart=""alert(1)""></article>" (str.replace y "/n" "x"))))
(assert (not (<= (str.len y) 52)))
(assert (not (= (str.at y 35) "r")))
(assert (or (not (str.contains (str.replace x "te" " ") " con nted")) (not (str.prefixof "<noscrip" x))))
(assert (or (= (str.at x 26) "d") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\s+-]{10,16}"))) (<= (str.len z) 38)))
(assert (or (not (= (str.indexof x "1)"" " 0) 24)) (not (str.contains (str.replace y ":" " ") "tyle> t"))))
(check-sat)
