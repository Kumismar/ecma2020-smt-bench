; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\xE2\x80\xAFjavascript:alert(1)</script>") (= x "<picture><source srcset=""validimage.png""><img onload=alert(1)></picture>")))
(assert (or (= z "put autofocus>") (= z "ript&colon;alert(1)""/>?")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<pi" y)) (str.prefixof "onmous" z) (str.prefixof "<marquee i" y)))
(assert (or (not (str.contains (str.replace z "cus" "alert(1)") "tofoalert(1)>")) (not (= """`'""ipt>\xE2\x80\xAFjavascript:alert(1)</script>put autofocus>" (str.replace y "><scr" """")))))
(assert (or (not (= "rt(" (str.substr x 38 3))) (not (str.suffixof "picture>" x)) (= "<picture>" (str.substr x 0 9))))
(assert (or (not (str.suffixof "ture>" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}a-zA-Z]+$")))))
(assert (or (= (str.len y) 93) (str.in_re y ((_ re.from_regex ecma2020 u) "^[-0-9]{1,}$"))))
(check-sat)
