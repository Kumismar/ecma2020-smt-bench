; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture id=x \u{1d400}tabindex=1 onbeforedeactivate=alert(1)></picture><inpu\u{10348}t autofocus>") (= x "<font id=x tabindex=1 onbeforedeactivate=alert(1)></font><input autofocus>")))
(assert (or (= z "ert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= z "colgroup>") (= z "d=x tabindex=1 onactivate=alert(1)></ruby>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<f" y) (not (= (str.indexof x " id=x" 0) 5)) (str.prefixof "ert(1)><s" z)))
(assert (or (= " " (str.substr z 3 1)) (not (str.contains x "eac")) (not (str.suffixof "colgroup>" y))))
(assert (not (= "grou" (str.substr z 3 4))))
(assert (not (= "<font id=x tabindex=1 onbeforedeactivate=alert(1)></foxnput autofocus>colgroup>" (str.replace y "nt><i" "x"))))
(assert (str.prefixof "<pict" x))
(assert (or (str.contains x "gable") (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z]{5,30}")))))
(check-sat)
