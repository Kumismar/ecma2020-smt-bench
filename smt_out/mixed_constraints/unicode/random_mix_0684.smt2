; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><big o\u{1f4a9}ndrop\u{20000}=alert(1) contenteditable>drop here</big>") (= x "<a href=""\xE2\x80\x86javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "'`""><\x00script>javascript:alert(1)</script>")))
(assert (or (= z "D:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "1></marquee>") (= z "rt(1)""></tfoot>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "(1" "<b>") "t<b>)")) (not (str.suffixof "ere</big>" x)) (= (str.at z 47) "a")))
(assert (or (not (str.prefixof "rt(1)""" z)) (= "rt(1)""><<b>tfoot>" (str.replace z "/" "<b>")) (= (str.at x 79) "n")))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z \u{e9}\u{e8}\u{e7}\u{e0}\u{ea}_\.-]{2,30}$")))
(assert (or (not (str.contains z "</tfoot>")) (str.contains z "D:javascri") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,}|[0-9]{1,3})(\]?)$")))))
(assert (or (not (= (str.indexof y "z" 0) 59)) (not (= (str.at x 33) "a"))))
(check-sat)
