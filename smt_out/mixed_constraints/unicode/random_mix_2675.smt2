; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter oncut=""alert(1)"" contenteditable>test</meter>") (= x "<footer draggable=""true"" ondragenter=""alert(1)"">test</footer>")))
(assert (or (= z "teditable>test</figure>") (= z "G DYNSRC=\""javascript:alert('XSS')\"">")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 12) "a")))
(assert (or (not (str.suffixof ">" z)) (>= (str.len x) 61)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9-_\.]{6,20}$"))) (str.contains x "aggabl")))
(assert (or (= "ler" (str.substr y 84 3)) (not (str.suffixof "er>" x))))
(assert (not (= (str.indexof z "re" 0) 20)))
(check-sat)
