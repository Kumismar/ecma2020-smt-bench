; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame onclick=""alert(1)"">test</frame>") (= x "<dir onfocusout=alert(1) tabindex=1 id=x></dir><input autofocus>") (= x "<input autofocus onfocusin=a\u{10348}lert(1)>")))
(assert (or (= z "enteditable>test</link>") (= z "wn=""alert(1)"" contenteditable>test</noframes>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Z,a-z, ]*"))))
(assert (not (= "e>test</l" (str.substr y 47 9))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[^0-9]{3,50}"))) (not (str.contains y "ut=")) (= "br>" (str.substr z 8 9))))
(assert (or (not (str.contains y "ent")) (not (= (str.indexof y "auto" 0) 7)) (not (str.contains x "><"))))
(check-sat)
