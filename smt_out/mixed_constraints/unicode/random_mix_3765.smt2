; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script src=""data:\xE0\xA4\x98,javascript:alert(1)""></script>") (= x "<svg><mark onload=alert(1)></mark>") (= x "ABC<div style=""x:\x0Cexpression(javascript:alert(1)"">DEF")))
(assert (or (= z "n=alert(1)></spacer>") (= z "ondragenter=""alert(1)"">test</rtc>") (= z "vate=alert(1)></data>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 40) (str.contains (str.replace y ">test" " ") ")"" </rt") (not (str.contains (str.replace z "(1)" "<b>") "ert<b>></"))))
(assert (str.suffixof "EF" x))
(assert (not (= "><mark" (str.substr y 4 6))))
(assert (or (= "er>" (str.substr z 17 7)) (not (>= (str.len y) 53)) (not (str.contains z "r=""al"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?!\s*$)[a-zA-Z\s]{2,50}$"))))
(assert (not (= (str.len z) 21)))
(check-sat)
