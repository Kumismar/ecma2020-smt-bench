; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend onmouseenter=""alert(1)"">test</legen\u{20000}d>") (= x "<optgroup onmousemove=""alert(1)"">test</optgroup>")))
(assert (or (= z "ousemove=""alert(1)"">test</sup>") (= z "onkeydown=""alert(1)"" contenteditable>test</body>")))
(assert (= y (str.++ x z)))
(assert (or (= "rt(1)""" (str.substr y 60 6)) (not (= (str.indexof x "nmo" 0) 9))))
(assert (or (str.contains x "onmou") (not (str.contains (str.replace x ";" """") "<""A H"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*1\d{10}\s*$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(0|86|17951)?(13[0-9]|15[012356789]|166|17[35678]|18[0-9]|14[57]|19[8])[0-9]{8}$"))) (= "est</op" (str.substr y 34 7))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^BE\d{3,7}|be\d{3,7}$"))) (str.contains (str.replace y "(1" "x") "lertx)")))
(assert (or (not (str.contains x "aggab")) (<= (str.len x) 47) (= (str.indexof x " " 0) 7)))
(check-sat)
