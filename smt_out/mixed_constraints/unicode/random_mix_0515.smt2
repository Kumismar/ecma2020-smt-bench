(assert (or (= x "<script onmouseout=""alert(1)"">test</script>") (= x "<acronym onkeypre\u{1f600}ss=""alert(1)"" contenteditable>tes\u{1d400}t</acronym>") (= x "></SCRIPT>"">'><SCRIPT>alert(String.fromCharCode(88,83,83))</SCRIPT>")))
