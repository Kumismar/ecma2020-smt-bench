(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len z) 3)) (= "ot.ini" (str.substr z 97 6)) (not (str.prefixof "<scrip" y))))
(assert (or (not (= (str.indexof y "O" 0) 83)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9]([0-9]?)$")))))
