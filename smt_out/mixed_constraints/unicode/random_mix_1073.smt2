; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image draggable=""true"" ondragleave=""alert(1)"">test</image>") (= x "<shadow onmouseleave=""alert(1\u{1f600})"">test</shado\u{20000}w>") (= x "<keygen id=x \u{1f600}tabindex=1 onbeforeactivate=alert(1)></keygen>")))
(assert (or (= z "image src=validimage.png onloadend=alert(1)>") (= z "namespace=""xss"" implementation=""h\u{20000}ttp://www.securitycompass.com/xss.htc""><xss:xss>\u{1d400}XSS</xss:xss></html>")))
(assert (= y (str.++ x z)))
(assert (= "e=" (str.substr y 15 2)))
(assert (or (not (str.contains x "bi")) (not (<= (str.len x) 60)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?=.*\d)(?=.*[a-zA-Z_\W])([a-zA-Z\d_\W]+)$")))))
(assert (or (str.prefixof "<k" x) (not (= (str.indexof z "end" 0) 31)) (not (str.contains x "st</"))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "(\w+([-+.]\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*)|([a-zA-Z\-0-9]+)")))
(assert (not (str.suffixof "(1)>" z)))
(assert (not (str.suffixof "s>" y)))
(assert (or (not (str.contains y "end=aler")) (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{2}$")) (= "raggab" (str.substr x 8 6))))
(check-sat)
