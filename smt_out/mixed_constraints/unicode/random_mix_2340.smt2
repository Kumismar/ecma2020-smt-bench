; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary onbeforecut=""alert(1)"" contenteditable>test</summary>") (= x "<nobr onmousedown=""alert(1)"">test</nobr>")))
(assert (or (= z "id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></span>") (= z "plet onerror applet onerror=""javascript:javascript:alert(1)""></applet onerror>") (= z "r=javascript:alert(1)>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z\u{c0}-\u{d6}\u{d8}-\u{f6}\u{f8}-\u{ff}0-9]+$"))))
(assert (or (not (= (str.indexof z "></s" 0) 61)) (str.suffixof "lert(1)>" z) (not (= (str.indexof x "ert(1" 0) 24))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{430}-\u{44f}\u{410}-\u{42f}]+$"))) (not (str.contains (str.replace y "pt:al" "alert(1)") "ascrialert(1)e")) (not (>= (str.len x) 32))))
(assert (not (str.suffixof ">" z)))
(assert (or (not (str.suffixof "t onerror>" z)) (not (= (str.at z 50) "u")) (not (= (str.at y 85) "r"))))
(assert (or (<= (str.len z) 30) (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]*[.,]?[0-9]*$")) (>= (str.len y) 78)))
(assert (= (str.at z 7) "<"))
(check-sat)
