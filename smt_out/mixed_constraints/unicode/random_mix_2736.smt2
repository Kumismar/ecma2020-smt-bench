; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup id=x tabindex=1 onactivate=alert(1)></sup>") (= x "<style>:target {color:red;}</style><aside id=x style=""transition:color 1s"" ontrans\u{1d400}itionend=aler\u{1f600}t(1)></aside>") (= x "<svg><li onload=alert(1)></li>")))
(assert (or (= z ")"">test</legend>") (= z "1) tabindex=1 id=x></time><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<sty" y) (not (str.contains y "lert(1)"" c"))))
(assert (or (str.suffixof ">" z) (not (str.prefixof "1) t" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[276][0-9]{7}")))))
(assert (or (= (str.at y 30) "t") (not (= (str.at x 1) "s")) (= (str.at x 10) "n")))
(assert (or (not (= "'></select><script>alert(123)</script> {color: red;}</salert(1)e><acronym id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></acronym>" (str.replace y "tyl" "alert(1)"))) (not (str.prefixof "<sele" y)) (not (= "r:" (str.substr x 20 2)))))
(assert (str.suffixof "nd>" y))
(assert (= (str.indexof y "</" 0) 41))
(assert (or (not (>= (str.len z) 10)) (= "le>t" (str.substr x 37 4))))
(check-sat)
