; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onerror=""alert(String.fromCharCode(88,83,83))"">") (= x "<progress onkeydown=""alert(1)"" contenteditable>test</progress>") (= x "<h1 onbeforepaste=""alert(1)"" contenteditable>test</h1>")))
(assert (or (= z "ert(1)></div><input id=y autofocus>") (= z "=""alert(1)"" contenteditable>test</li>") (= z "svg>//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (not (= "r=""alert(S" (str.substr x 17 10))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^@]+@[^\.]+\..{2,}$"))))
(assert (or (= (str.at y 5) "r") (str.contains x "st</p")))
(assert (not (str.suffixof "test</h1>" x)))
(assert (= (str.at z 10) """"))
(assert (not (str.contains (str.replace x "html>" " ") "st</ ")))
(assert (= "src=x xor=\u{1f600}""alert(1)"">" (str.replace z "onerr" "x")))
(check-sat)
