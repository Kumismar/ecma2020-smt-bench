; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody oncopy=""alert(1)"" contenteditable>test</tbody>") (= x "<style>:target {color: red;}</style><slot id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></slot>")))
(assert (or (= z "mma;eval(atob(location.hash.slice(1)))//#alert(1)") (= z "X00003c") (= z "c=x onerror=""javascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<bdo onmou" y) (= (str.indexof y "p" 0) 11) (str.suffixof "003c" z)))
(assert (or (not (str.contains x """tran")) (str.contains y """>tes")))
(assert (or (str.prefixof "<tbo" x) (= (str.at x 82) "s") (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{2}[0-9]{4,5}[0-9]{4}$")))))
(assert (not (str.contains y "ruby>/plai")))
(assert (= (str.indexof x "trans" 0) 54))
(assert (= (str.indexof x "tyl" 0) 2))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{1,12}$")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\+\(\)\-]{16}$"))))
(check-sat)
