; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "</plaintext\></|\><plaintext/onmouseover=prompt(1)") (= x "<picture onblur=alert(1) tabindex=1 id=x></picture><input autofocus>")))
(assert (or (= z "=""http://www.w3.org/TR/WD-xsl"">") (= z "est</sup>") (= z "/var>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<picture o" y))
(assert (not (= (str.indexof y "id=" 0) 5)))
(assert (str.contains x "text/on"))
(assert (or (not (str.suffixof "/var>" y)) (not (= (str.at z 0) "r"))))
(assert (or (not (str.prefixof "</pla" x)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{3041}-\u{3093}]+$"))) (<= (str.len z) 7)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^\S{6,32}$")))
(assert (str.prefixof "<audi" x))
(check-sat)
