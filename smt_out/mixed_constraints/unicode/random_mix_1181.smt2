; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dl onkeyup=""alert(1)"" contenteditable>test</dl>") (= x "<u drag\u{20000}gable=""true"" on\u{1d400}dragend=""alert(1)"">test</u>") (= x "<div style=""font-family:'foo&#10;;color:red;';"">LOL")))
(assert (or (= z "olor:red;}</style><dfn id=x style=""transition:color 1s"" ontransitionend=alert(1)></dfn>") (= z "style>@keyframes x{}</style><bdo style=""animatio\u{10348}n-name:x"" onanimationend=""alert(1)""></bdo>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "est</dl>" x)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(^(chr)?(\d{1,2}|(x|y|X|Y)):\d+$)"))) (= (str.at x 5) "a") (not (str.prefixof "<div" y))))
(assert (or (= "style>@keyframes x{}</style><bdo style=""animatio\u{10348}n-name:x"" onanimatione<b>alert(1)""></bdo>" (str.replace z "nd=""" "<b>")) (= "t(1)"">te" (str.substr x 37 8))))
(assert (or (= (str.at z 35) "t") (not (str.contains x "st</d"))))
(assert (or (not (= (str.indexof y "ag\u{20000}ga" 0) 5)) (not (= (str.at z 17) "b")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z .-]{2,}")))))
(assert (or (= "< draggable=""true"" contenteditable>drag me</div><strong ondragover=alert(1) contenteditable>drop here</strong>" (str.replace x "div " " ")) (not (str.suffixof "/dfn>" z)) (str.prefixof "<script" y)))
(check-sat)
