; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onchange=alert(1) value=xss>") (= x "<body id=x tabindex=1 ondeactivate=alert(1)></body><input id=y autofocus>")))
(assert (or (= z "st</figcaption>") (= z "t</hr>") (= z "autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= ">" (str.substr z 4 6)) (= (str.indexof y "a" 0) 12)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9A-Za-z@._-]+$")))
(assert (str.contains z "</plainte"))
(assert (or (str.contains x "value=xss>") (str.contains x "ascript:al")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(?!^0+$)[0-9]{5}")) (>= (str.len y) 85) (= (str.len x) 73)))
(assert (or (<= (str.len y) 43) (not (str.suffixof "=xss>" x))))
(assert (or (str.suffixof "t</hr>" y) (str.contains (str.replace x "y" "alert(1)") "<bodalert(1) ")))
(check-sat)
