; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe/%00/ src=javaSCRIPT&colon;alert(1)") (= x "<IMG SRC=x onloadeddata=""alert(String.fromCharCode(88,83,83))"">") (= x "<plaintext draggable=""true"" ondragend=""alert(1)"">test</plaintext>")))
(assert (or (= z """>""*""") (= z "script .\u{10348}com")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "t .\u{10348}c")))
(assert (or (<= (str.len y) 83) (str.contains (str.replace z "ipt " "<b>") "scr<b>.\u{10348}") (str.prefixof "<IM" y)))
(assert (= (str.indexof z """" 0) 0))
(assert (or (not (= (str.at y 6) "t")) (not (= (str.indexof x "ab" 0) 16)) (not (= (str.at x 35) "n"))))
(assert (not (str.contains z """>""*")))
(assert (or (= (str.indexof x "PT&" 0) 25) (str.suffixof """" z) (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Z\u{5d0}-\u{5ea}a-z ]{1,50}$"))))
(assert (<= (str.len x) 73))
(assert (or (not (= "<iframe/%00/ srjavascript:avaSCRIPT&colon;alert(1)" (str.replace x "c=j" "javascript:"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "Address")))))
(check-sat)
