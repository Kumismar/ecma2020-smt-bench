; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span onmouseenter=""alert(1)"">test</span>") (= x "<dd id=x tabindex=1 onbeforeactivate=alert(1)></dd>")))
(assert (or (= z "t&colon;\u{5c}u0061&#x6C;&#101%72t&lpar;1&rpar;""><button>") (= z "le:url() onerror=alert(41)></li>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{2,12}$"))) (>= (str.len x) 40)))
(assert (str.prefixof "<dd id=" y))
(assert (or (not (str.suffixof "colgroup>" x)) (= (str.at y 34) " ") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([0-2]?[0-9]|3[01])$")))))
(assert (= "button" (str.substr y 96 6)))
(assert (not (= (str.at z 17) "6")))
(assert (or (str.contains x "ert") (= (str.at y 17) "=")))
(assert (= (str.indexof x "st<" 0) 32))
(check-sat)
