; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound onPropertyChange bgsound onPropertyChange=""javascript:javascript:alert(1)""></bgsound onPropertyChange>") (= x "<address id=x tabindex=1 onfocusin=alert(1)></address>")))
(assert (or (= z ")></small>") (= z "table>test</sup>")))
(assert (= y (str.++ x z)))
(assert (or (= "(1)""></bg" (str.substr x 79 9)) (= "e>)></smal" (str.substr y 109 10))))
(assert (or (str.contains z "est</body>") (not (= "sin=al" (str.substr y 31 6))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\-]+$")))))
(assert (not (= (str.at x 40) "(")))
(assert (or (= (str.indexof x "a" 0) 1) (not (str.contains z "e>test</"))))
(assert (or (str.suffixof "!" z) (str.prefixof "<bg" y)))
(assert (= (str.indexof y "onPro" 0) 9))
(check-sat)
