; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;A HREF=&quot;javascript:document.location=&apos;http://www.google.com/&apos;&quot;&gt;XSS&lt;/A&gt;") (= x "<select id=x tabindex=1 onbeforedeactivate=alert(1)></select><input autofocus>") (= x "`""'><img src=xxx:x \x0Bonerror=javascript:alert(1)>")))
(assert (or (= z "nMouseUp>") (= z "tyle><header style=""animation-name:x"" onanimationstart=""alert(1)""></header>") (= z "=""alert(1)"">test</hr>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "(" 0) 22) (not (= "e" (str.substr x 57 1)))))
(assert (not (str.suffixof "test</hr>" y)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(^[0-9a-zA-Z_\.-]{1,}@([0-9a-zA-Z_\-]{1,}\.)+[0-9a-zA-Z_\-]{2,}$)")) (not (str.contains y "ion>/va"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9!#$%&()*+,.:;=?@\[\]^_{}-]+$"))) (= (str.len x) 51) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{0,2}-?[0-9]+$")))))
(assert (or (str.suffixof ">" x) (= (str.at z 2) "o")))
(check-sat)
