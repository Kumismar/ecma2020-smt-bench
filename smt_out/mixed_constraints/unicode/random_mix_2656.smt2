; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside oncopy=""alert(1)"" contenteditable>test</aside>") (= x "<kbd oncon\u{20000}textmenu=""alert(1)"">test</kbd>\u{20000}")))
(assert (or (= z "ditable>drop here</div>") (= z "lert(1)"">test</image>")))
(assert (= y (str.++ x z)))
(assert (or (= "1)"">te" (str.substr x 24 6)) (not (= (str.at x 5) "e")) (= (str.indexof y "1)"" c" 0) 21)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-\u{17e}0-9-:&.'_ ]{2,}$"))))
(assert (= "ge>" (str.substr z 18 4)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\W]+$"))))
(assert (or (= (str.indexof x "rt" 0) 28) (not (= "e " (str.substr x 5 2)))))
(assert (str.suffixof "e</div>" y))
(check-sat)
