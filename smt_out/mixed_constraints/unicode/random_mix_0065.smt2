; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><ol onload=alert(1)></ol>") (= x "<shadow onclick=""alert(1)"">test</shadow>") (= x "<a href=""\x14javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "n onmousedown=""alert(1)"">test</span>") (= z "</a>") (= z ";))"";>;")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len x) 70)) (str.contains (str.replace z "</s" "") "testp")))
(assert (or (not (= (str.at y 5) "o")) (not (= (str.at y 44) "m")) (not (= (str.indexof x "tabl" 0) 32))))
(assert (= (str.indexof x "href" 0) 3))
(assert (or (str.contains x " onclick=""") (str.contains x "%"" onmo") (str.contains z ")"";")))
(assert (or (not (str.contains (str.replace x "s" "<b>") "<<b>ha")) (= "xow onclick=""alert(1)"">test</shadow></a>" (str.replace y "<shad" "x")) (str.suffixof "()}" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?[0-9 ]{8,16}$"))))
(check-sat)
