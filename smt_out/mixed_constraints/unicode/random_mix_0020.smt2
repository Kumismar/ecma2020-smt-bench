; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><kbd ondrop=alert(1) contenteditable>drop here</kbd>") (= x "<div draggable=""true"" contenteditable>drag me</div><dd ondragover=alert(1) contenteditable>drop here</dd>")))
(assert (or (= z "est</tfoot>") (= z "le><q id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></q>") (= z "e=""true"" ondragend=""alert(1)"">test</h1>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len z) 12)))
(assert (or (not (str.contains z "st</tfoot>")) (str.prefixof "%2" y) (str.prefixof "<div " y)))
(assert (<= (str.len z) 72))
(assert (or (not (= (str.len x) 103)) (str.prefixof "<div " x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{7,8}-[0-9Kk]{1}$"))) (= "1>" (str.substr z 37 5))))
(check-sat)
