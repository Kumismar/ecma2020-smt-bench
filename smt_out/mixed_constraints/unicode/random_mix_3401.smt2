; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time onmouseup=""alert(1)"">test</time>") (= x "<menuitem onmouseup=""alert(1)"">test</menuitem>") (= x "<textarea onpaste=alert(1) autofocus></textarea>")))
(assert (or (= z "tbody>") (= z "x"" onanimationend=""alert(1)""></aside>") (= z "cript:javascript:alert(1)""></svg onLoad>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<tex" x) (str.suffixof "tbody>" z) (not (= (str.len x) 48))))
(assert (or (not (str.contains (str.replace y "=" "<b>") "p<b>""al")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\d{8}-\d{1}-\d{2}"))) (not (= (str.at y 28) "e"))))
(assert (or (>= (str.len y) 131) (= (str.indexof y "p" 0) 18)))
(assert (or (= "s></t" (str.substr y 35 5)) (not (= (str.at x 12) "e"))))
(check-sat)
