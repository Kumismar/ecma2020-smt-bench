; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<spacer onbeforecopy=""alert(1)"" contenteditable>test</spacer>") (= x "<table draggable=""true"" ondragenter=""alert(1)"">test</table>") (= x "<progress oncontextmenu=""alert(1)"">test</progress>")))
(assert (or (= z "ag=""alert(1)"">test</tr>") (= z "al\145rt'](1)") (= z "load=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 5) "a")) (str.suffixof "t</spacer>" x) (not (<= (str.len x) 65))))
(assert (or (not (str.contains z """alert(1")) (= (str.indexof x "<svg" 0) 0) (not (= (str.indexof z "r" 0) 3))))
(assert (or (not (= (str.len z) 14)) (not (<= (str.len z) 30)) (not (str.prefixof "load=a" z))))
(assert (or (str.contains (str.replace y "t" """") "<""able") (str.suffixof "r>" x) (str.in_re y ((_ re.from_regex ecma2020 u) "^.{1,8}$"))))
(assert (not (str.suffixof "ert(1)>" y)))
(assert (or (not (= (str.indexof x "g" 0) 4)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([^.@]+)(\.[^.@]+)*@([^.@]+\.)+([^.@]+)$")))))
(check-sat)
