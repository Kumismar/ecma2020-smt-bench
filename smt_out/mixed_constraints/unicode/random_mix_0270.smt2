; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onpaste=""alert(1)"" contenteditable>test</rtc>") (= x "<ol onkeydown=""alert(1)"" contenteditable>test</ol>") (= x "alert`1`")))
(assert (or (= z "trong>") (= z "</canvas>") (= z "/listing>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(01[2689]|09)[0-9]{8}$"))) (= (str.len x) 126)))
(assert (or (= "ont" (str.substr y 26 3)) (not (str.suffixof ";" y)) (not (>= (str.len x) 114))))
(assert (or (= (str.at y 39) ">") (not (= "/lisalert(1)ng>" (str.replace z "ti" "alert(1)"))) (= "ita" (str.substr x 33 3))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^((0[1-9]|[12]\d|3[01]|[4-7][0-9])([04][1-9]|[15][0-2])\d{2}(\d{5}))$")) (not (str.contains z "</canvas>"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=^.{8,}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$"))) (not (str.prefixof "</canvas>" z))))
(check-sat)
