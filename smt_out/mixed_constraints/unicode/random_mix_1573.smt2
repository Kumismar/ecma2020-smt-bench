; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd onmousemove=""alert(1)"">test</dd>") (= x "<pre onkeypress=""alert(1)"" contenteditable>test</pre>")))
(assert (or (= z "ad>") (= z "\u{1d400}us>") (= z "lert(1)"">test</img>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "\u{1d400}us>" "x") "x") (not (= (str.indexof z "us" 0) 1)) (str.contains (str.replace x "list>" "x") "atax")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\+38\s?\(\d{3}\)\s?\d{3}-?\d{2}-?\d{2}$"))))
(assert (not (str.suffixof "us>" z)))
(assert (or (not (= (str.at x 14) "e")) (= "us>" (str.substr z 1 6))))
(assert (not (str.prefixof "<" x)))
(check-sat)
