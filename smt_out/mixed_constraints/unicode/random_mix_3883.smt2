; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em draggable=""true"" ondragenter=""alert(1)"">test</em>") (= x """>/KinG-InFeT.NeT/><script>alert(document.cookie)</script>")))
(assert (or (= z "set><input id=y autofocus>") (= z "ttp://0x42.0x0000066.0x7.0x93/"">XSS</A>") (= z "ion>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "ion>" z)) (str.in_re y ((_ re.from_regex ecma2020 u) "[^ @]+@[^ @]+")) (str.in_re x ((_ re.from_regex ecma2020 u) "^(.){4,8}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z\\s\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\\s]+$"))))
(assert (str.prefixof "set" z))
(assert (or (str.prefixof "<em dr" x) (not (= """>/KinG-InFeT.NeT/><script>alert(d<b>ument.cookie)</script>" (str.replace x "oc" "<b>")))))
(assert (or (= "al" (str.substr x 4 2)) (not (= "dra" (str.substr x 23 3)))))
(assert (or (not (= "<em draggable=""true""  ndragenter=""alert(1)"">test</em>set><input id=y autofocus>" (str.replace y "o" " "))) (not (= (str.indexof y ".c" 0) 41))))
(check-sat)
