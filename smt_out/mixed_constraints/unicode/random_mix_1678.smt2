; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article id=x tabindex=1 onfocus=alert(1)></article>") (= x "<footer id=x tabindex=1 ondeactivate=alert(1)></footer><input id=y autofocus>") (= x "<STYLE>li {list-style-image: url(\""javascript:alert('XSS')\"");}</STYLE><UL><LI>XSS")))
(assert (or (= z "SS"");</SCRIPT>") (= z "t>") (= z "l>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len z) 15)))
(assert (or (= "ocus>" (str.substr x 72 9)) (not (str.prefixof "<textare" x)) (= (str.indexof y "rt(1)" 0) 40)))
(assert (or (str.suffixof "IPT>" y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*[@]).{6,}"))) (str.contains y "er>")))
(assert (or (= ">" (str.substr x 76 7)) (not (str.in_re z ((_ re.from_regex ecma2020 u) ".{16}|.{16,}"))) (str.prefixof "<ar" y)))
(assert (or (= (str.at y 8) "i") (not (str.suffixof ">" z))))
(check-sat)
