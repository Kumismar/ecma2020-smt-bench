; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<header id=x tabindex=1 onactivate=alert(1)></header>") (= x "<code onmousemove=""alert(1)"">test</code>") (= x "<div draggable=""true"" contenteditable>drag me</div><input ondragover=alert(1) contenteditable>drop here</input>")))
(assert (or (= z "k=""alert(1)"">test</figcaption>") (= z "alert(1) tabindex=1 id=x></frame><input autofocus>") (= z " DATAFORMATAS=HTML&gt;&lt;/SPAN&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^(\w\w+)+(\s\w+)*")) (not (= (str.at y 19) "a"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{30a1}-\u{30f3}\u{30f4}\u{30fc}]+$")) (str.contains x "(1")))
(assert (or (not (= (str.at x 1) "c")) (not (str.suffixof ">" x))))
(assert (or (not (= (str.at y 30) "e")) (not (str.contains (str.replace y "=""tr" " ") "able ue")) (= "tion onmou" (str.substr y 48 10))))
(assert (or (not (str.suffixof "autofocus>" z)) (str.contains (str.replace z ")><" "alert(1)") "1alert(1)/m")))
(assert (str.prefixof "<hea" x))
(assert (or (not (= "<div draggable=""true"" content<b>itable>drag me</div><input ondragover=alert(1) contenteditable>drop here</input>" (str.replace x "ed" "<b>"))) (not (str.suffixof "re</input>" x))))
(assert (not (= "t</d" (str.substr z 8 4))))
(check-sat)
