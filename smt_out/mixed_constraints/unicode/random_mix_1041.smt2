; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript onmouseleave=""alert(1)"">test</noscript>") (= x "<embed onmouseleave=""alert(1)"">test</embed>") (= x "<bgsound id=x tabindex=1 ondeactivate=alert(1)></bgsound><input id=y autofocus>")))
(assert (or (= z "alert(1) tabindex=1 id=x></code><input autofocus>") (= z "le>test</nav>") (= z "22%2b%22cript%20src=http://my.box.com/xss.js%3E%3C/script%3E%22)\u{2019}%3E")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.+@.+\.[a-zA-Z]{2,63}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([\w.-]+)@(\[(\d{1,3}\.){3}|(?!live\.fr|mail\.ru|hotmail\.fr|arcor\.de|inbox\.ru|yams08|eric\.jones)(([a-zA-Z\d-]+\.)+))([a-zA-Z]{2,4}|\d{1,3})(\]?)$"))) (str.suffixof "/embed>" x)))
(assert (or (str.contains (str.replace z "rt(1)" "x") "alex tab") (str.suffixof "/nav>" z) (not (= (str.at z 22) "="))))
(assert (or (not (str.suffixof "us>" z)) (str.prefixof "<noscr" x)))
(assert (or (= (str.indexof y "te" 0) 35) (= (str.at y 54) "v")))
(assert (not (= "lex</nav>" (str.replace z ">test" "x"))))
(check-sat)
