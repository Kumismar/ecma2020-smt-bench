; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dl onbeforecopy=""alert(1)"" contenteditable>test</dl>") (= x "<col id=x tabindex=1 onbeforeactivate=alert(1)></col>")))
(assert (or (= z "utofocus>") (= z "></dt>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "dt>" z) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9 \u{5c}u00D1\u{5c}u00F1]+$")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Z\u{c4}\u{d6}\u{dc}]{1}[a-z\u{e4}\u{f6}\u{fc}]{1,20} [A-Z\u{c4}\u{d6}\u{dc}]{1}[a-z\u{e4}\u{f6}\u{fc}]{1,20}")))))
(assert (or (not (str.contains x "1 onb")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@(?!gmail.com|hotmail.com|outlook.com|yahoo.com|icloud.com|ig.com|bol.com|uol.com)[a-z0-9.-]+\.[a-z]{2,4}$"))) (not (str.contains (str.replace x "p" " ") ">dro  h"))))
(assert (or (str.contains y "tiv") (not (str.prefixof "></dt" z))))
(assert (or (not (= (str.indexof y "</" 0) 47)) (= (str.len z) 6)))
(assert (not (= "tof" (str.substr z 1 3))))
(check-sat)
