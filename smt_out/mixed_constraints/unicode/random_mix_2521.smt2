; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark oncut=""alert(1)"" contenteditable>test</mark>") (= x "<div onmouseover=""alert(1)"">test</div>")))
(assert (or (= z "ck draggable=""true"" ondragleave=""alert(1)"">test<\u{1f600}/track>") (= z "st</nextid>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "</nextid"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\w{6}-.*$"))) (not (str.prefixof "<mark " y))))
(assert (or (<= (str.len z) 13) (= (str.at y 42) "t") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]+\.?[0-9]*")))))
(assert (or (str.contains x "k on") (= (str.at z 35) "e")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9]+"))) (not (str.contains x "(1)"" con"))))
(check-sat)
