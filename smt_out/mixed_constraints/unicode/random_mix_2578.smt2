; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<small draggable=""true"" ondragleave=""alert(1)"">test</small>") (= x "<\u{20000}div draggable=""true"" contenteditable>drag me</div><textarea ondragover=alert(1) contenteditable>\u{20000}drop here</textarea>") (= x "<div id=""62""><!-- IE 6-8\u{10348} -->")))
(assert (or (= z "autofocus>") (= z "lert(1)"">test</pre>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len y) 59)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([1-9]|[12]\d|30)$"))) (not (= "<\u{20000}div draggable=""true"" contenteditable>d e</div><textarea ondragover=alert(1) contenteditable>\u{20000}drop here</textarea>lert(1)"">test</pre>" (str.replace y "rag m" " ")))))
(assert (or (= (str.at y 62) "t") (str.prefixof "<\u{20000}div " x) (not (str.prefixof "lert(1)"">t" z))))
(assert (or (= (str.indexof z "t</" 0) 12) (= "dragover=" (str.substr x 64 9))))
(assert (or (not (str.contains x "entedit")) (not (= (str.indexof y "t(1)" 0) 41)) (str.suffixof "t</pre>" y)))
(assert (= (str.at x 8) "a"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\S+@\S+$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{8}[A-Z]$")))))
(check-sat)
