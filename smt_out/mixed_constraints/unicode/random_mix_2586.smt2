; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form><input formaction=javascript:alert(1) type=submit value=click>") (= x "<IMG SRC=\u{201d}javascript:alert(\u{2018}XSS\u{2019})\u{201d}")))
(assert (or (= z "rt(1)"">test</u>") (= z ";}</style><progress id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></progress>") (= z "editable>test</figure>")))
(assert (= y (str.++ x z)))
(assert (= (str.len x) 60))
(assert (or (not (str.contains (str.replace z "/" "x") "est<xu>")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{5}")))))
(assert (or (= "cri" (str.substr x 15 3)) (= "<IMG SRC=\u{201d}javascript:alert(\u{2018}XSS\u{2019})\u{201d};}</style><progress id=x style=""transition:transform 2s"" ontransitio""n=alert(1)></progress>" (str.replace y "nru" """")) (not (= (str.indexof y "ess " 0) 50))))
(assert (or (not (= (str.at y 80) "r")) (str.prefixof "<addre" x)))
(assert (not (= (str.at y 62) "t")))
(assert (or (not (= (str.indexof y "pt:" 0) 32)) (str.prefixof "<xss id=x" x) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?!Last Name|last name|LAST NAME)[a-zA-Z][a-zA-Z ]+")))))
(assert (or (not (= (str.at x 42) ")")) (not (= "n=j" (str.substr y 22 3)))))
(assert (not (= "edi<b>able>test</figure>" (str.replace z "t" "<b>"))))
(check-sat)
