; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form id=""test"" /><button form=""test"" formaction=""javascript:alert(123)"">TESTHTML5FORMACTION") (= x "<textarea id=x tabindex=1 onbeforedeactivate=alert(1)></textarea><input autofocus>") (= x "<p onmouseleave=""alert(1)"">test</p>")))
(assert (or (= z "red;}</style><applet id=x style=""transition:color 1s"" ontransitionend=alert(1)></applet>") (= z "SS"";)';>;") (= z "1 id=x></del><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z ]*$")) (not (= "<" (str.substr y 105 1))) (str.suffixof "test</p>" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\S.*([\s]).*\S$"))) (not (str.suffixof "autofocus>" x)) (= (str.at y 24) ")")))
(assert (or (not (= (str.at z 40) "i")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((?:19|20)\d{2})$")))))
(assert (= (str.at y 98) ";"))
(check-sat)
