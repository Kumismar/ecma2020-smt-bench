; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend draggable=""true"" ondragend=""alert(1)"">test</legend>") (= x "<keygen ondblclick=""\u{1f4a9}alert(1)"">test</keyg\u{1f4a9}en>")))
(assert (or (= z "PT ="">"" SRC=""http://ha.ckers.org/xss.js""></SCRIPT>") (= z """alert(1)"">test</menu>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "ha.ckers" (str.substr y 79 8))) (not (= (str.at x 37) "k")) (= "<legend draggable=""true"" ondragend=""alert(1)"">test</legend>PT ="">"" SRC=""http://ha.ckers.org/xssalert(1)""></SCRIPT>" (str.replace y ".js" "alert(1)"))))
(assert (not (str.contains x "ate=al")))
(assert (or (str.suffixof "test</th>" y) (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 ]{1,32}"))))
(assert (or (not (= (str.indexof z "le" 0) 2)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9-.]{10,13}$")))))
(assert (= "<legx draggable=""true"" ondragend=""alert(1)"">test</legend>" (str.replace x "end" "x")))
(check-sat)
