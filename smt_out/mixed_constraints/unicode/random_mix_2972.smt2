; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element id=x tabindex=1 onbeforeactivate=alert(1)></element>") (= x "<style>:target {color:red;}</style><data id=x style=""transition:color 1s"" ontransitionend=alert(1)></data>")))
(assert (or (= z "d=alert(1)>") (= z "nteditable>test</big>") (= z " id=x></br><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "p" 0) 14)) (not (= "style>" (str.substr x 1 6)))))
(assert (= "t>d=" (str.substr y 59 4)))
(assert (str.contains y "ditable>"))
(assert (or (= (str.at z 8) "l") (not (= (str.indexof y "da" 0) 1)) (= "b" (str.substr z 8 1))))
(assert (not (str.suffixof "t>" x)))
(assert (or (str.contains (str.replace x "lert" "alert(1)") "=aalert(1)(") (not (str.contains y "<style>:ta"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-Za-z]+)$"))) (not (str.contains z " o")) (str.in_re z ((_ re.from_regex ecma2020 u) "^[5][0-9]{9}"))))
(assert (= (str.indexof x "ansit" 0) 55))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*[a-zA-Z,\u{e7},\u{c7},\u{11f},\u{11e},\u{131},\u{130},\u{f6},\u{d6},\u{15f},\u{15e},\u{fc},\u{dc},\s]+\s*$"))))
(check-sat)
