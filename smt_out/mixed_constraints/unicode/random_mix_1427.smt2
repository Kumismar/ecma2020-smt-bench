; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><span onload=alert(1)></span>") (= x "<tt onmouseover=""alert(1)"">test</tt>")))
(assert (or (= z "gt;") (= z "/kbd>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9 +-]{5,25}"))))
(assert (or (not (= (str.indexof y "test<" 0) 27)) (<= (str.len y) 47) (str.suffixof "gt;" z)))
(assert (or (str.contains y "></s") (not (= "<" (str.substr y 0 1))) (not (str.contains x "=al"))))
(assert (= (str.at z 2) ";"))
(assert (or (not (= "r" (str.substr x 21 1))) (not (str.contains (str.replace x "id" "alert(1)") """ alert(1)=""f"))))
(assert (or (= "r=""al" (str.substr x 14 5)) (not (= (str.indexof y "o" 0) 11))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,12}")))
(assert (not (str.contains x "d=a")))
(check-sat)
