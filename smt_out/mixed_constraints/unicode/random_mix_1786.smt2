; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xml onPropertyChange xml onPropertyChange=""javascript:javascript:alert(1)""></xml onPropertyChange>") (= x "<bgsound onfocusout=alert(1) tabindex=1 id=x></bgsound><input autofocus>") (= x "<legend onbeforecut=""alert(1)"" contenteditable>test</legend>")))
(assert (or (= z "=0 onfinish=alert(1)>") (= z "extmenu=""alert(1)"">test</footer>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\w{5,5}( |-){0,1}\w{0,5}$"))) (>= (str.len x) 57)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[^\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}]{0,40}")) (= (str.indexof x "vascr" 0) 46)))
(assert (or (not (<= (str.len x) 68)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?[78][-\(]?\d{3}\)?-?\d{3}-?\d{2}-?\d{2}$")))))
(assert (or (= (str.indexof z "tmen" 0) 2) (not (<= (str.len z) 21)) (= (str.indexof x "s" 0) 3)))
(check-sat)
