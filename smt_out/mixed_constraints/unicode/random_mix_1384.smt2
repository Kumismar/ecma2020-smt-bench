; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet id=x tabindex=1 onfocus=alert(1)></applet>") (= x "<body onblur=alert(1) id=x><iframe id=x>")))
(assert (or (= z "drag\u{20000}gable=""true"" ondragend=""ale\u{20000}rt(1)"">test</del>") (= z ">") (= z "10s"" ontransitioncancel=alert(1)></shadow>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "mouse")) (str.prefixof "<applet" y) (= (str.len z) 41)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Z][a-z]* [A-Z][a-z]*$"))) (str.suffixof "dow>" z) (not (= ">" (str.substr z 41 4)))))
(assert (or (not (str.prefixof "<marq" y)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\s*(3[01]|[12][0-9]|0?[1-9])\.(1[012]|0?[1-9])\.((?:19|20)\d{2})\s*$"))) (not (= "d=x tabi" (str.substr y 9 8)))))
(assert (or (str.prefixof "<ar" y) (str.suffixof "</del>" y)))
(assert (or (= (str.at x 28) "i") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{5c}u2015\u{5c}u3000\u{5c}u30A1-\u{5c}u30F6\u{5c}u30FB-\u{5c}u30FE]+$"))) (str.contains x "ub><")))
(assert (>= (str.len x) 36))
(check-sat)
