; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onmouseup=""alert(1)"">test</html>") (= x "<menuitem id=x tabindex=1 onbeforedeactivate=alert(1)></menuitem><input autofocus>")))
(assert (or (= z "=""transition:color 1s"" ontransitionend=alert(1)></sup>") (= z """alert(1)"">test</th>") (= z "6;\u{1f4a9}&#58;&#97;&#108;&#\u{1f600}101;&#114;&#116;&#40;&#39;&#88;&#83;&#83;&#39;&#41;>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len z) 73)))
(assert (or (not (str.suffixof ">" z)) (>= (str.len y) 92) (= "6;\u{1f4a9}&#58 97;&#108;&#\u{1f600}101;&#114;&#116;&#40;&#39;&#88;&#83;&#83;&#39;&#41;>" (str.replace z ";&#" " "))))
(assert (or (not (= (str.at z 38) "=")) (str.prefixof ";}<" z)))
(assert (or (not (= (str.at z 15) "l")) (not (= "<menuitem id=x tabindex=1 onbefoalert(1)ctivate=alert(1)></menuitem><input autofocus>" (str.replace x "redea" "alert(1)")))))
(assert (>= (str.len x) 75))
(assert (or (not (= "01;&#1" (str.substr z 23 6))) (= """ale<b>(1)"">test</th>" (str.replace z "rt" "<b>")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]\d*$"))))
(assert (not (str.suffixof "/html>" x)))
(assert (or (not (str.contains x "autofoc")) (not (= (str.at x 15) "="))))
(check-sat)
