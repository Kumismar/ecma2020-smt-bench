; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript onpaste=""alert(1)"" contenteditable>test</noscript>") (= x "<noscript id=x tabindex=1 ondeactivate=alert(1)></noscript><input id=y autofocus>") (= x "<multicol oncontextmenu=""alert(1)"">test</multicol>")))
(assert (or (= z "tmenu=""alert(1)"">test</form>") (= z "quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "quot;http:" z) (not (= (str.indexof y "t;" 0) 63))))
(assert (or (not (str.contains (str.replace x "pt on" "alert(1)") "oscrialert(1)p")) (= (str.indexof x "ite i" 0) 2)))
(assert (str.suffixof "cript>" x))
(assert (or (str.prefixof "quot;htt" z) (not (str.contains (str.replace y ">qu" "alert(1)") "ptalert(1)ot;ht"))))
(assert (or (str.suffixof "PT&gt;" y) (not (str.prefixof "<noscri" x))))
(assert (or (= (str.indexof x " au" 0) 68) (str.suffixof "&gt;" z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\d\d\d\d)|([\u{ff10}-\u{ff19}][\u{ff10}-\u{ff19}][\u{ff10}-\u{ff19}][\u{ff10}-\u{ff19}])$"))))
(assert (or (= (str.at x 22) "u") (= "javascript:le>@keyframes x{}</style><ol style=""animation-name:x"" onanimationstart=""alert(1)""></ol>" (str.replace x "<sty" "javascript:"))))
(check-sat)
