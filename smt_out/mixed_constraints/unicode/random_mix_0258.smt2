; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><optgroup ondrop=alert(1) contenteditable>drop here</optgroup>") (= x "<data onkeypress=""alert(1)"" contenteditable>test</data>")))
(assert (or (= z "n=""alert(1)"">test</mark>") (= z "tarea draggable=""true"" ondragleave=""alert(1)"">test</textarea>") (= z "ript .\u{10348}com")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y "t" "javascript:") """javascript:r") (not (str.suffixof "r>" y))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\(?(\d{3})\)?[ .-]?(\d{3})[ .-]?(\d{4})$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\u{d6}\u{f6}\u{fc}\u{dc}\u{c4}\u{e4}\u{df}\s\-]*)$")))))
(assert (not (= "</style><image style=""animation-name: onanimationend=""alert(1)""></image>" (str.replace z "x"" " " "))))
(assert (or (= "\u{10348}com" (str.substr z 6 10)) (str.prefixof "<" x) (not (str.contains (str.replace y "ro" "") "ptgup o"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z\sA-Z]+$"))))
(check-sat)
