; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta http-equiv=""refresh"" content=""0;url=javascript:document.vulnerable=true;"">") (= x "<rect  fill=""white"" style=""clip-path:url(test3.svg#a);fill:url(#b);filter:url(#c);marker:url(#d);mask:url(#e);stroke:url(#f);""/>") (= x "<blockquote draggable=""true"" ondragenter=""alert(1)"">test</blockquote>")))
(assert (or (= z ">") (= z "nteditable>test</kbd>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "t</k") (not (= "<blockquot<b> draggable=""true"" ondragenter=""alert(1)"">test</blockquote>nteditable>test</kbd>" (str.replace y "e" "<b>")))))
(assert (not (= "#a);fill:u" (str.substr y 50 10))))
(assert (or (not (= (str.indexof y "sv" 0) 47)) (not (= "test</lalert(1)>" (str.replace z "ink" "alert(1)")))))
(assert (or (= (str.indexof z "e>te" 0) 9) (not (= (str.at z 17) "k"))))
(assert (or (not (str.contains (str.replace y "ndrag" "x") "oxstart")) (not (str.prefixof "<meter id" x))))
(assert (str.suffixof "quote>>" y))
(assert (or (not (<= (str.len y) 86)) (str.in_re y ((_ re.from_regex ecma2020 u) "(^[ABCEGHJKLMNPRSTVXYabceghjklmnprstvxy]{1}\d{1}[A-Za-z]{1} *\d{1}[A-Za-z]{1}\d{1}$)")) (>= (str.len z) 13)))
(check-sat)
