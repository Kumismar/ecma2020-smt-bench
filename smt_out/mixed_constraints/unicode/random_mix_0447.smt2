; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp oncut=""alert(1)"" contenteditable>test</xmp>") (= x "&apos;&apos;;!--&quot;&lt\u{1f600};XSS&gt;=&amp;{()}") (= x "<title draggable=""true"" ondragend=""alert(1)"">test</title>")))
(assert (or (= z "t {color:red;}</style><ruby id=x style=""transition:color 1s"" ontransitionend=alert(1)></ruby>") (= z "xtmenu=""alert(1)"">test</embed>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace x "trong" "x") "<sx on"))
(assert (= (str.len x) 57))
(assert (or (not (str.prefixof "xtmenu=""a" z)) (not (= (str.at z 26) "b"))))
(assert (or (str.suffixof "></ruby>" y) (not (= (str.indexof x """" 0) 17)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{1}[0-9a-zA-Z]+[\w\.-]+@[\w\.-]+\.\w{2,}$")))))
(assert (not (= (str.indexof x "gga" 0) 10)))
(check-sat)
