; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dir onmousedown=""alert(1)"">test</dir>") (= x "<shadow id=x tabindex=1 onfocusin=alert(1)></shadow>")))
(assert (or (= z "forepaste=""alert(1)"" contenteditable>test</ruby>") (= z "error=\x0Cjavascript:alert(1)\x0Csrc=xxx:x />") (= z "l onmouseout=""alert(1)"">test</multicol>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9]{8,})$")) (= (str.at z 0) "e") (= "l onmousxout=""alert(1)"">test</multicol>" (str.replace z "e" "x"))))
(assert (str.prefixof "l onmouse" z))
(assert (or (str.prefixof "l on" z) (not (= "t<" (str.substr z 27 2))) (<= (str.len x) 42)))
(assert (or (not (= (str.at z 28) "e")) (not (str.contains (str.replace x "i" "x") "ow xd=x t"))))
(assert (= (str.len z) 48))
(assert (or (= """>test<" (str.substr x 26 7)) (= (str.indexof z "</mul" 0) 28)))
(assert (not (str.prefixof "<s" x)))
(check-sat)
