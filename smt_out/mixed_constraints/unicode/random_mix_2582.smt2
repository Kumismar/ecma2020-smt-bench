; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<map onbeforepaste=""alert(1)"" contenteditable>test</map>") (= x "<div draggable=""true"" contenteditable>drag me</div><iframe ondragover=alert(1) contenteditable>drop here</iframe>")))
(assert (or (= z "d=x tabindex=1 onbeforedeactivate=alert(1)></bdi><input autofocus>") (= z "iptAccess="";always"";>;<;/EMBED>;")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 116) " ")) (not (str.prefixof "<div" y))))
(assert (or (not (= "over=alert" (str.substr y 65 10))) (= (str.at x 51) "/") (not (str.suffixof "s>" z))))
(assert (str.prefixof "iptAccess=" z))
(assert (or (str.prefixof "<" y) (not (= (str.len y) 122))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z+#-]*"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{1,4}$")))))
(assert (>= (str.len x) 101))
(assert (or (str.contains (str.replace y "r=al" "<b>") "ove<b>ert(1") (= (str.indexof y "tab" 0) 32) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(GIR[ ]?0AA|((AB|AL|B|BA|BB|BD|BH|BL|BN|BR|BS|BT|CA|CB|CF|CH|CM|CO|CR|CT|CV|CW|DA|DD|DE|DG|DH|DL|DN|DT|DY|E|EC|EH|EN|EX|FK|FY|G|GL|GY|GU|HA|HD|HG|HP|HR|HS|HU|HX|IG|IM|IP|IV|JE|KA|KT|KW|KY|L|LA|LD|LE|LL|LN|LS|LU|M|ME|MK|ML|N|NE|NG|NN|NP|NR|NW|OL|OX|PA|PE|PH|PL|PO|PR|RG|RH|RM|S|SA|SE|SG|SK|SL|SM|SN|SO|SP|SR|SS|ST|SW|SY|TA|TD|TF|TN|TQ|TR|TS|TW|UB|W|WA|WC|WD|WF|WN|WR|WS|WV|YO|ZE)(\d[\dA-Z]?[ ]?\d[ABD-HJLN-UW-Z]{2}))|BFPO[ ]?\d{1,4})$")))))
(check-sat)
