; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><cite id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></cite>") (= x "<b onmouseover=""alert(1)"">test</b>")))
(assert (or (= z "abindex=1 onbeforeactivate=alert(1)></col>") (= z "alert(1)"" contenteditable>test</select>") (= z "(1)><source src=""validaudio.wav"" type=""audio/wav""></audio>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "</col>" z)) (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z_\d]+$")) (str.suffixof "t(1)>" x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9!#$%&'*+=?_`{|}~\-]+(?:\.[a-zA-Z0-9!#$%&'*+=?_`{|}~\-]+)*@(?:[a-zA-Z0-9](?:[a-zA-Z0-9\-]*[a-zA-Z0-9])?\.)+[a-zA-Z0-9](?:[a-zA-Z0-9\-]*[a-zA-Z0-9])?"))))
(assert (or (not (str.prefixof "<b onmous" x)) (str.prefixof "<s" y)))
(assert (or (not (str.contains z "e sr")) (str.contains (str.replace x """al" "<b>") "er=<b>ert(") (= "<b onmxover=""alert(1)"">test</b>" (str.replace x "ouse" "x"))))
(assert (or (not (= (str.at z 7) ")")) (not (str.contains z "pe=""aud")) (not (str.contains x ": red;}"))))
(assert (str.suffixof "1)></col>" z))
(assert (= (str.len y) 76))
(check-sat)
