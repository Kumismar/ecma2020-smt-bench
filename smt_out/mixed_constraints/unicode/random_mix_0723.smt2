; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=validimage.png onloadstart=alert(1)>") (= x "<output id=x tabindex=1 onactivate=alert(1)></output>")))
(assert (or (= z "target {color: red;}</style><ruby id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></ruby>") (= z "id=x tabindex=1 onbeforeactivate=alert(1)></nobr>")))
(assert (= y (str.++ x z)))
(assert (or (= "target {color: red;}</style><ruby id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></rubalert(1)" (str.replace z "y>" "alert(1)")) (not (str.suffixof "ut>" x))))
(assert (not (str.contains (str.replace x " onlo" "alert(1)") "e.pngalert(1)ads")))
(assert (or (not (= (str.indexof x "r" 0) 6)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\+]?[(]?[0-9]{3}[)]?[-\s\.]?[0-9]{3}[-\s\.]?[0-9]{4,6}$")))))
(assert (or (= (str.at y 36) "a") (str.contains y "x=1est<") (not (= (str.at x 21) "n"))))
(assert (or (= (str.indexof y "rt" 0) 38) (str.in_re z ((_ re.from_regex ecma2020 u) "^(1[3-9]d{9})$")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{2}.[0-9]{3}.[0-9]{3}/[0-9]{4}-[0-9]{2}$")))))
(assert (or (= (str.at x 43) ")") (= (str.indexof z "ncanc" 0) 79)))
(check-sat)
