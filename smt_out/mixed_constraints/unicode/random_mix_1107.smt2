; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onmousemove=""alert(1)"">test</dfn>") (= x "<audio onbeforecopy=""alert(1)"" contenteditable>test</audio>") (= x "<abbr onclick=""alert(1)"">test</abbr>")))
(assert (or (= z "bindex=1 onactivate=alert(1)></rt>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9\() ]{9,}"))) (not (str.prefixof "<scr<scr" y))))
(assert (str.contains (str.replace z "=1 o" "<b>") "ndex<b>n"))
(assert (not (str.contains (str.replace y " oncl" "x") "bbrxic")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9.]{6,9}([0-9A-Z]{0,3})$")) (not (>= (str.len y) 66))))
(assert (not (>= (str.len z) 24)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 ]{1,}")) (not (>= (str.len x) 16)) (= (str.at z 0) ">")))
(assert (not (str.suffixof "></rt>" z)))
(assert (= "t</au" (str.substr x 50 5)))
(assert (str.suffixof "t>" y))
(check-sat)
