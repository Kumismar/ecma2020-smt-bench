; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture onclick=""alert(1)"">test</picture>") (= x "<blockquote draggable=""true"" ondragleave=""alert(1)"">test</blockquote>") (= x "<slot onmouseover=""alert(1)"">test</slot>")))
(assert (or (= z "t=""alert(1)"" contenteditable>test</bdi>") (= z "vascript:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len y) 61)) (not (= (str.indexof y """aler" 0) 17)) (str.suffixof "</picture>" x)))
(assert (or (not (str.contains y "ontentedit")) (not (str.prefixof "<" y)) (= "ert(1" (str.substr y 80 5))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9A-z]){17,17}$"))))
(assert (or (<= (str.len y) 71) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{5,5}$")))))
(assert (>= (str.len z) 25))
(assert (not (str.contains y "ckquo")))
(check-sat)
