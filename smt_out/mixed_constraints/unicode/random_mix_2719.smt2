; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee draggable=""true"" ondragleave=""alert(1)"">test</marquee>") (= x "<keygen onmouseover=""alert(1)"">test</keygen>")))
(assert (or (= z "ve=""alert(1)"">test</time>") (= z "editable>test</output>") (= z "=""alert(1)"">test</u>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "t(1)"))
(assert (not (str.contains x "over=""aler")))
(assert (or (not (str.prefixof "<keygen" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^@[A-Za-z0-9_]{1,15}$"))) (= (str.indexof z "e=""al" 0) 1)))
(assert (or (str.contains z "ert(1)"">te") (str.suffixof "t</u>" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[!@#/$%^&*]).{6,20}"))))
(assert (not (str.suffixof "/output>" z)))
(check-sat)
