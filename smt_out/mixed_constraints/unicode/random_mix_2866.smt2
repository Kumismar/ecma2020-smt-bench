; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div s\u{1f600}tyle=""position:absolute;top:0;left:0;width:100%;height:100%"" onmouseover=""prompt(1)"" onclick=""alert(1)"">x</button>") (= x "<hr onkeyup=""alert(1)"" contenteditabl\u{10348}e>test</hr>")))
(assert (or (= z "rop here</kbd>") (= z " contenteditable>test</a>")))
(assert (= y (str.++ x z)))
(assert (= "kb" (str.substr z 10 2)))
(assert (or (not (str.contains y "/h")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}\-_\.]+@[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}0-9\-_\.]+\.[a-zA-Z\-_\.]{2,10}$")))))
(assert (or (= (str.indexof x "t(1)""" 0) 86) (not (str.suffixof "(1)'"">" y)) (not (= "<hr ""nkeyup=""alert(1)"" contenteditabl\u{10348}e>test</hr>" (str.replace x "o" """")))))
(assert (or (str.contains y "nteditabl") (not (str.suffixof "</area>" x))))
(assert (not (= "/butt" (str.substr x 113 5))))
(check-sat)
