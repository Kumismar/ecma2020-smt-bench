; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT a=\""&gt;\"" '' SRC=\""http&#58;//ha&#46;ckers&#46;org/xss&#46;js\""&gt;&lt;/SCRIPT&gt;") (= x "<samp id=x tabindex=1 onfocus=alert(1)></samp>") (= x "<isindex oncut=""alert(1)"" contenteditable>test</isindex>")))
(assert (or (= z "ate=alert(1)></dir><input id=y autofocus>") (= z ")></tt>") (= z "alert(1)"">test</canvas>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 13) "t")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[a-zA-Z\d\w\W]{6,}$"))) (str.suffixof ")></tt>" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\+\d{2})?(?:\s*\d){9,}"))) (not (= (str.len x) 94))))
(assert (not (= (str.at z 29) "y")))
(assert (or (= (str.indexof x "rt" 0) 31) (not (str.contains (str.replace x "sam" " ") "< p")) (not (= "<samp id=x tabindex=1 onfocus=a""t(1)></samp>alert(1)"">test</canvas>" (str.replace y "ler" """")))))
(assert (not (= (str.at y 61) "g")))
(assert (= (str.len y) 97))
(check-sat)
