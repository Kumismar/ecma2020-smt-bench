; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><big ondragover=alert(1) contenteditable>drop here</big>") (= x "<body onblur body onblur=""javascript:javascript:alert(1)""></body onblur>")))
(assert (or (= z "nmousemove='alert&lpar;1&rpar;'>SPAN") (= z "ot;&gt;")))
(assert (= y (str.++ x z)))
(assert (= "r>" (str.substr z 22 5)))
(assert (str.contains (str.replace z "ot;&" "x") "xgt"))
(assert (str.contains y "contente"))
(assert (or (not (str.contains z ";&gt")) (not (str.contains z "='ale"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?:0(?!(5|7))(?:2|3|4|8|9))(?:-?\d){7}$|^(0(?=5|7)(?:-?\d){9})$"))))
(assert (not (str.prefixof "<body o" x)))
(assert (or (= (str.indexof y "d" 0) 1) (not (= (str.indexof x "ondr" 0) 23))))
(assert (= "o" (str.substr x 10 1)))
(assert (not (>= (str.len x) 100)))
(assert (or (not (str.suffixof "gt;" y)) (str.in_re y ((_ re.from_regex ecma2020 u) "^(1?(-?\d{3})-?)?(\d{3})(-?\d{4})$"))))
(assert (or (= "rt(1" (str.substr x 70 4)) (str.in_re z ((_ re.from_regex ecma2020 u) "^00[0-9]{1,4}[-\s0-9]{6,15}$"))))
(check-sat)
