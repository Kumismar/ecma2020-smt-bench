; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x contenteditable onkeydown=alert(1)>press any key!") (= x "<main onkeypress=""alert(1)"" contenteditable>test</main>") (= x "<IMG SRC=javascript\u{10348}:alert(""XSS"")>")))
(assert (or (= z """>test</p>") (= z ")"" contenteditable>test</meter>") (= z "st</figure>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "t</figure>" y))
(assert (or (= "able>te" (str.substr z 14 7)) (not (str.contains (str.replace x "<ma" "") "in"))))
(assert (or (= (str.at y 46) "g") (not (str.in_re y ((_ re.from_regex ecma2020 u) "alpha-num-hyphen")))))
(assert (or (not (= "e>" (str.substr z 9 3))) (str.in_re x ((_ re.from_regex ecma2020 u) "^.{1,4}$")) (not (= "lert(" (str.substr x 30 5)))))
(check-sat)
