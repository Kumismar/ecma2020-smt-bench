; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><nextid style=""animation-name:x"" onanimationstart=""alert(1)""></nextid>") (= x "<nobr onpaste=""alert(1)"" contenteditable>test</nobr>")))
(assert (or (= z "lert(1)"">test</option>") (= z "lert(1)"">test</li>")))
(assert (= y (str.++ x z)))
(assert (= "t</li>" (str.substr z 12 9)))
(assert (or (not (= (str.indexof x "anima" 0) 44)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{105}\u{104}\u{107}\u{107}\u{119}\u{119}\u{142}\u{141}\u{144}\u{143}\u{f3}\u{d3}\u{15b}\u{15a}\u{17c}\u{17b}\u{179}\u{179} ]{4,30}$")))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{7,15}")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_\-\.\+]{1,}@([\da-zA-Z-]{1,}\.){1,}[\da-zA-Z-]{2,4}$"))) (= (str.indexof y "est<" 0) 109)))
(assert (not (str.suffixof "</li>" z)))
(assert (or (not (str.prefixof "ler" z)) (= "<div styl=""font-family:'foo&#10;;color:red;';"">LOL" (str.replace x "e" "")) (= (str.at y 58) ")")))
(assert (>= (str.len z) 14))
(assert (or (>= (str.len y) 67) (= "<style>@keyframes x{}</style><nextid style=""anjavascript:ion-name:x"" onanimationstart=""alert(1)""></nextid>lert(1)"">test</li>" (str.replace y "imat" "javascript:"))))
(check-sat)
