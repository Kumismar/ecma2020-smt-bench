; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed src=1 onerror=alert(1) type=image/gif>") (= x "<del onmouseleave=""alert(1)"">test</del>")))
(assert (or (= z "hadow onload=alert(1)></shadow>") (= z " id=x tabindex=1 ondeactivate=alert(1)></audio><input id=y autofocus>") (= z "Ejavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "</shadow>" z))
(assert (not (>= (str.len y) 64)))
(assert (or (not (= (str.at x 35) "d")) (not (= (str.at y 1) "a")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9 ]+")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:(?:31(\/|-|\.)(?:0?[13578]|1[02]))\1|(?:(?:29|30)(\/|-|\.)(?:0?[13-9]|1[0-2])\2))(?:(?:1[6-9]|[2-9]\d)?\d{2})$|^(?:29(\/|-|\.)0?2\3(?:(?:(?:1[6-9]|[2-9]\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))$|^(?:0?[1-9]|1\d|2[0-8])(\/|-|\.)(?:(?:0?[1-9])|(?:1[0-2]))\4(?:(?:1[6-9]|[2-9]\d)?\d{2})$"))))
(assert (or (not (= (str.indexof z "sc" 0) 5)) (= (str.len y) 70)))
(assert (not (= "</del>ha" (str.substr y 33 8))))
(assert (not (= (str.at x 5) "o")))
(assert (<= (str.len x) 47))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9a-zA-Z]+[-_+.&0-9a-zA-Z]*)?[-_+0-9a-zA-Z]+@([-0-9a-zA-Z]+[.])+[a-zA-Z]{2,6}$"))))
(assert (or (not (= "age/" (str.substr x 37 4))) (str.contains x "lt;\u{1d400}/")))
(check-sat)
