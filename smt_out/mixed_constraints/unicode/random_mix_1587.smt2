; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd \u{10348}onpaste=""alert(1)"" contenteditable>test</kbd>") (= x "<?xml version=""1.0"" encoding=""ISO-8859-1""?><!DOCTYPE foo [<!ELEMENT foo ANY><!ENTITY x\u{20000}xe SYSTEM ""fil\u{1f600}e:///dev/random"">]><foo>&xee;</foo>") (= x "<svg><col onload=alert(1)></col>")))
(assert (or (= z "pT src=//14.rs>") (= z "extmenu=""alert(1)"">test</menu>") (= z "lert(1)""></noscript>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "co" 0) 6) (not (str.contains (str.replace z "T" " ") "p  sr"))))
(assert (or (not (= (str.indexof x "e" 0) 12)) (= "-1" (str.substr y 38 2))))
(assert (not (= "style=" (str.substr z 22 6))))
(assert (or (= """ c" (str.substr y 23 3)) (not (str.contains y "t(1)"))))
(assert (or (>= (str.len z) 29) (not (str.in_re z ((_ re.from_regex ecma2020 u) "\d{9}$"))) (not (= (str.indexof z "est" 0) 20))))
(check-sat)
