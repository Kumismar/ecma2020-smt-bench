; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><slot ondragover=alert(1) contenteditable>drop here</slot>") (= x "<TABLE><TD BACKGROUND=""javascript:alert('XSS')"">")))
(assert (or (= z "table>test</dd>") (= z "id=x onfocusin=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y "nted" """") "nte""i") (not (= (str.at y 124) "a"))))
(assert (or (= (str.at z 19) "<") (str.suffixof "1)>" y) (not (= (str.at y 52) "s"))))
(assert (not (str.prefixof "<div dra" y)))
(assert (not (str.prefixof "<d" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{5}([\-]\d{4})?$"))))
(check-sat)
