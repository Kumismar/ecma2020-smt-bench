; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source onmouseout=""alert(1)"">test</source>") (= x "<ins onmousemove=""alert(1)"">te\u{20000}st</ins>")))
(assert (or (= z "and>") (= z "alert(1)></center>")))
(assert (= y (str.++ x z)))
(assert (= ">te\u{20000}" (str.substr y 27 4)))
(assert (or (not (= "ource>an" (str.substr y 37 8))) (not (= "ter>" (str.substr z 14 5))) (not (str.contains (str.replace z ")></c" "<b>") "t(1<b>ent"))))
(assert (or (str.contains x "ut=""aler") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^VF\d{3,7}$")))))
(assert (or (not (str.contains x "ource onmo")) (not (str.suffixof "er>" z)) (str.contains y "out=""al")))
(assert (or (= (str.indexof x "a" 0) 20) (not (= (str.len x) 43)) (not (= (str.at y 16) "d"))))
(assert (str.prefixof "alert(1)" z))
(check-sat)
