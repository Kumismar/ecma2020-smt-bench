; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img onmouseout=""alert(1)"">test</img>") (= x "<spacer onmousemove=""alert(1)"">test</spacer>") (= x "<img src=""blah""onmouseover=""document.vulnerable=true;"">")))
(assert (or (= z "nbeforecopy=""alert(1)"" contenteditable>test</nav>") (= z "L xmlns:xss>;") (= z "g onmousedown=""alert(1)"">test</svg>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\s*)(([A-Za-z]{1,2}[ ]?[0-9]{1,4})|([A-Za-z]{3}[ ]?[0-9]{1,3})|([0-9]{1,3}[ ]?[A-Za-z]{3})|([0-9]{1,4}[ ]?[A-Za-z]{1,2})|([A-Za-z]{3}[ ]?[0-9]{1,3}[ ]?[A-Za-z])|([A-Za-z][ ]?[0-9]{1,3}[ ]?[A-Za-z]{3})|([A-Za-z]{2}[ ]?[0-9]{2}[ ]?[A-Za-z]{3})|([A-Za-z]{3}[ ]?[0-9]{4}))(\s*)$"))) (str.prefixof "<img sr" x)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(1\s*[-\/\.]?)?(\((\d{3})\)|(\d{3}))\s*[-\/\.]?\s*(\d{3})\s*[-\/\.]?\s*(\d{4})\s*(([xX]|[eE][xX][tT])\.?\s*(\d+))*$"))))
(assert (or (<= (str.len y) 112) (str.contains z "eyg") (= (str.at z 12) ";")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((((\+31|0|0031)[1-9]{2}[0-9][-]?[0-9]{6}[0-9]*)|((\+31|0|0031)[1-9][0-9][-]?[1-9][0-9]{6}))|(((\+31|0|0031)[\s]?[-]?6){1}[-]?[1-9]{1}[0-9]{7}))"))) (= "nbeforecopy=""a""t(1)"" contenteditable>test</nav>" (str.replace z "ler" """")) (<= (str.len x) 63)))
(assert (or (not (= (str.indexof x """>" 0) 53)) (str.contains (str.replace x "img" " ") "<  o")))
(assert (or (not (str.prefixof "<xmp onk" x)) (= (str.at z 24) ">")))
(check-sat)
