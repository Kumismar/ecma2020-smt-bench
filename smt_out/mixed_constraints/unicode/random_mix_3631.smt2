; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><hgroup id=x style=""transition:color 1s"" ontransitionend=alert(1)></hgroup>") (= x "<input type=""text"" value=``<div/onmouseover='alert(1)'>X</div>") (= x "<video onbeforepaste=""alert(1)"" contenteditable>test</video>")))
(assert (or (= z "text/javascript"">javascript:alert(1);</script>") (= z "me onmousemove=""alert(1)"">test</time>")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "[_A-Za-z0-9\u{621}-\u{64a}]{3,}$")))
(assert (str.suffixof "t>" y))
(assert (str.contains x "ver='alert"))
(assert (<= (str.len y) 138))
(assert (or (str.prefixof "text" z) (= (str.at x 24) "=")))
(assert (str.contains (str.replace y "nen" "<b>") "sitio<b>d=al"))
(assert (or (= (str.at z 0) "m") (not (= (str.at x 83) "i"))))
(check-sat)
