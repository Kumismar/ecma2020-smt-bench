; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s onbeforecut=""alert(1)"" contenteditable>test</s>") (= x "<style draggable=""true"" ondragleave=""alert(1)"">test</style>") (= x "<details id=x tabindex=1 ondeactivate=alert(1)></details><input id=y autofocus>")))
(assert (or (= z "rt(1)""></iframe onload>") (= z "ript>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "x"" "))
(assert (or (str.contains y ">rt(1)") (str.contains (str.replace y "ore" " ") "ef cut")))
(assert (or (not (str.contains x "<del onbef")) (str.suffixof "t>" z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{2}-\d{2}-\d{4}$"))))
(assert (or (str.suffixof "e onload>" y) (not (= (str.indexof x "=""a" 0) 40))))
(check-sat)
