; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br onbeforecopy=""alert(1)"" contenteditable>test</br>") (= x "<sub id=x tabindex=1 onbeforedeactivate=alert(1)></sub><input autofocus>")))
(assert (or (= z "rue"" ondragstart=""aler\u{1d400}t(1)"">test</map\u{10348}>") (= z "able>test</spacer>") (= z "onmouseup=""alert(1)"">test</ol>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len y) 92)))
(assert (or (not (= (str.at z 18) "a")) (not (str.contains z "e>test</")) (not (= ">test</sp" (str.substr z 4 9)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?!\s*$)[a-zA-Z'\s]{1,50}$"))) (not (= (str.at y 69) "r"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z][0-9.]{1,20}$"))) (str.contains x "x t")))
(assert (or (not (= (str.indexof y "sp" 0) 64)) (>= (str.len x) 49)))
(check-sat)
