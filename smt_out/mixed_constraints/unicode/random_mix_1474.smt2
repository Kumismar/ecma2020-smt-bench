; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i onmouseleave=""alert(1)"">test</i>") (= x "<fieldset id=x tabindex=1 ondeactivate=alert(1)></fieldset><input id=y autofocus>")))
(assert (or (= z "ntenteditable>test</video>") (= z "ement draggable=""true"" ondragstart=""al\u{20000}ert(1)"">test</element>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9A-Z]{8}$"))))
(assert (or (str.suffixof "ement>" z) (= """tru" (str.substr z 16 4)) (= (str.at y 42) "r")))
(assert (or (not (= "set" (str.substr y 55 3))) (= (str.indexof y "onmo" 0) 3)))
(assert (= "able>tes" (str.substr z 9 8)))
(assert (or (= (str.at z 2) "e") (not (str.prefixof "ement dr" z)) (= (str.indexof z "tar" 0) 30)))
(assert (not (str.prefixof "ement dra" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9@_.]{3,}$"))) (str.contains z "art=")))
(check-sat)
