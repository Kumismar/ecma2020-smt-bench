; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object data=""data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg=="">") (= x "<output onmousedown=""alert(1)"">test</output>") (= x "<h1 onmouseout=""alert(1)"">test</h1>")))
(assert (or (= z "ndex=1 ondeactivate=alert(1)></object><input id=y autofocus>") (= z "ge>") (= z "utofocus>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 30) (= (str.at z 26) "1")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-\u{17e}0-9-\u{201e}\u{201c},#+!&.?\u{2019}\u{2018}()' ]{10,}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[( )0-9]+$"))) (= "<h1 onmouseout=""alert(1)"">""/h1>utofocus>" (str.replace y "test<" """"))))
(assert (or (= """ onmouseout=""alert(1)"">test</h1>" (str.replace x "<h1" """")) (str.prefixof "<" x)))
(assert (or (= "fo" (str.substr z 3 2)) (not (= (str.at z 3) "f"))))
(assert (or (not (= (str.len y) 38)) (str.contains y "object da") (not (str.prefixof "<out" y))))
(assert (or (str.suffixof "autofocus>" y) (str.prefixof "<outpu" y)))
(check-sat)
