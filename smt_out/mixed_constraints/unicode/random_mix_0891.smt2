; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<big onblur=alert(1) tabindex=1 id=x></big><input autofocus>") (= x "<source onmousedown=""alert(1)"">test</source>") (= x "<template onbeforepaste=""alert(1)"" contenteditable>test</template>")))
(assert (or (= z "st</menu>") (= z "in=alert(1)></dialog>") (= z "te=""alert(1)"" contenteditable>test</big>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "1 id=x></b" (str.substr x 30 10))) (not (str.contains (str.replace x "te" "") "nn"))))
(assert (or (not (= (str.at z 15) "i")) (not (= "<template javascript:nbeforepaste=""alert(1)"" contenteditable>test</template>te=""alert(1)"" contenteditable>test</big>" (str.replace y "o" "javascript:"))) (not (>= (str.len x) 63))))
(assert (or (not (str.suffixof "e>" x)) (not (= (str.at z 2) "<"))))
(assert (not (str.suffixof "/template>" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^\s*]([a-zA-Z0-9\s]+){0,10}$"))) (= (str.indexof x "ble>t" 0) 47) (not (= (str.at x 19) ")"))))
(assert (or (not (<= (str.len x) 67)) (str.prefixof "in=alert" z) (str.suffixof "acronym>" x)))
(check-sat)
