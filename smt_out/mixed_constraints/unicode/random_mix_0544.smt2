; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x14javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<marquee onmouseenter=""alert(1)"">test</marquee>") (= x "<rt onmouseout=""alert(1)"">test</rt>")))
(assert (or (= z "t id=y autofocus>") (= z ">") (= z "t(1)"" contenteditable>test</dt>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 34) "e") (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{5c}u00C0-\u{5c}u00FF-]*$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "avez entendu")))))
(assert (str.prefixof "t" z))
(assert (or (= (str.at x 29) "t") (not (str.prefixof "<marqu" x)) (str.in_re x ((_ re.from_regex ecma2020 u) "^\S*$"))))
(assert (or (not (str.contains (str.replace z ">" """") "ble""t")) (<= (str.len y) 105) (str.suffixof "t>" x)))
(assert (or (not (= (str.at y 35) "a")) (str.contains z "id=y a")))
(assert (or (not (= "ipt:ja" (str.substr x 20 6))) (str.contains z "s;on")))
(assert (not (str.suffixof ";>" y)))
(check-sat)
