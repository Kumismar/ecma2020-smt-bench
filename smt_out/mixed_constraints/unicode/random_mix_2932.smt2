; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><script>alert(0)</script>") (= x "<xmp onbeforecut=""alert(1)"" contenteditable>test</xmp>") (= x "<blockquote onkeydown=""alert(1)"" contenteditable>test</blockquote>")))
(assert (or (= z "ad onload=alert(1)></thead>") (= z ".6.28 -->") (= z ">")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "." z))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z-0-9]+"))))
(assert (or (= (str.at x 22) """") (= (str.len y) 63)))
(assert (or (not (str.suffixof "test</xmp>" x)) (not (<= (str.len y) 67)) (str.prefixof """><script" y)))
(assert (or (not (= (str.indexof x "itab" 0) 42)) (not (str.contains x "=""alert")) (not (= (str.at z 5) " "))))
(assert (or (not (str.prefixof "<bl" y)) (not (= (str.at x 21) "c"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{1}[0-9a-zA-Z]+[\w\.-]+@[\w\.-]+\.\w{2,}$"))) (not (str.contains z " onload=al")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[ A-Za-z_./'#&+-]*$")))))
(check-sat)
