; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br onbeforepaste=""alert(1)"" contenteditable>test</br>") (= x "ABC<div style=""x:\xE2\x80\x88expression(javascript:alert(1)"">DEF") (= x "<;LINK REL="";stylesheet""; HREF="";javascript:alert(';XSS';);"";>;")))
(assert (or (= z "on(alert('XSS'))>") (= z "useover=""alert(1)"">test</table>") (= z "true"" ondrag=""alert(1)"">test</blink>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(\([0-9]{3}\) ?|[0-9]{3} ?|[0-9]{3}.?|[0-9]{3}-?)[0-9]{3}[ .-]?[0-9]{4}"))) (not (<= (str.len z) 21)) (not (str.prefixof "<dialo" x))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9]+(\s)?)+$"))) (>= (str.len z) 36) (str.suffixof "ble>" y)))
(assert (or (= "<option onkjavascript:""alert(1)"" contenteditable>test</option>gsound>" (str.replace y "eyup=" "javascript:")) (= (str.len x) 54)))
(assert (not (= "n(" (str.substr z 1 2))))
(assert (str.suffixof "br>" x))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\x20-\x7e\x80-\xff]*$"))) (not (str.prefixof "useover=""" z))))
(assert (= (str.indexof x """x:" 0) 14))
(assert (not (= " id=""" (str.substr y 50 5))))
(check-sat)
