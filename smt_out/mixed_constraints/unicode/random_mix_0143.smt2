; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<listing draggable=""true"" ondrag=""alert(1)"">test</listing>") (= x "<command onbeforecopy=""alert(1)"" contenteditable>test</command>")))
(assert (or (= z "ntent>") (= z ">test<\u{20000}/ul>") (= z """);")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z """);") (str.suffixof "\u{20000}/ul>" y)))
(assert (or (str.prefixof "<command o" x) (not (str.contains z "st<\u{20000}/u"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(\d+){3}\.(\d+(\.)?){1,}"))) (not (>= (str.len x) 48)) (not (str.prefixof "n" z))))
(assert (= (str.indexof z "s" 0) 3))
(assert (or (= "<command onbeforecopy=""alert(1)"" contentedit""test</command>"");" (str.replace y "able>" """")) (not (= (str.indexof x "ert(1" 0) 25))))
(check-sat)
