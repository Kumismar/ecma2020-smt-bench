; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del onmouseenter=""alert(1)"">test</del>") (= x "<\u{1d400}colgroup id=x tabindex=1 onbeforeactivate=alert(1)></colgroup>") (= x "<label\u{10348} draggable=""true"" ondragenter=""alert(1)"">test</label>")))
(assert (or (= z "';!--""<XSS>=&{()}") (= z "tmenu=""alert(1)"">test</tfoot>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9A-Za-z\u{104}\u{10c}\u{118}\u{116}\u{12e}\u{160}\u{172}\u{16a}\u{17d}\u{105}\u{10d}\u{119}\u{117}\u{12f}\u{161}\u{173}\u{16b}\u{17e}\-]{2,63}\.[A-za-z]{2}"))) (<= (str.len x) 42) (= (str.indexof x "est<" 0) 50)))
(assert (or (not (str.contains (str.replace x "a" "alert(1)") "d=x talert(1)bi")) (str.contains y "ot")))
(assert (or (not (<= (str.len x) 68)) (str.contains y "de(97, 1") (str.contains x "l onmouse")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z\u{b4}`\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{e4}\u{eb}\u{ef}\u{f6}\u{fc}\u{c4}\u{cb}\u{cf}\u{d6}\u{dc}\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{f1}\u{d1}.,\s]{5,60})+$"))))
(check-sat)
