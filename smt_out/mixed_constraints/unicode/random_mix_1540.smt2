; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid onkeypress=""alert(1)"" contenteditable>test</nextid>") (= x "<rb id=x tabindex=1 onfocus=alert(1)></rb>") (= x "<style>:target {color: red;}</style><data id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></data>")))
(assert (or (= z "/asi\u{1d400}de>\u{20000}") (= z "</body>") (= z "animationend=""alert(1)""></code>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "er" (str.substr x 97 2))) (= (str.indexof x "tabin" 0) 9)))
(assert (or (= (str.at z 3) "o") (>= (str.len y) 116) (= "<rb id=x tabindex=1 onfocus=ale></rb>" (str.replace x "rt(1)" ""))))
(assert (or (not (>= (str.len z) 12)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}$"))) (not (= (str.indexof y "=" 0) 11))))
(assert (or (= (str.at z 4) "d") (= ">\u{20000}" (str.substr z 7 2)) (not (= "</code>" (str.substr y 66 9)))))
(assert (= (str.at y 10) "r"))
(check-sat)
