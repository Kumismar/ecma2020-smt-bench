; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onpaste=""alert(1)"" contenteditable>test</rtc>") (= x "<a href=java&#1&#2&#3&#4&#5&#6&#7&#8&#11&#12script:javascript:alert(1)>XXX</a>") (= x "<label draggable=""true"" ondrag=""alert(1)"">test</label>")))
(assert (or (= z "><iframe onload=alert(2)//'></div>") (= z ">test</menu>") (= z "tofocus>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 24) (str.suffixof """>" y) (= "e" (str.substr y 38 1))))
(assert (or (= (str.at y 30) "&") (not (str.suffixof "div>" y))))
(assert (not (= (str.len x) 78)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{3,10}"))))
(assert (or (str.contains y " c") (not (str.contains (str.replace z "est<" """") ">t""/men")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z0-9\-.'\s]{0,39}$")))))
(check-sat)
