; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><div onload=alert(1)></div>") (= x "<li onkeyup=""alert(1)"" contenteditable>test</li>") (= x "<embed src=""http://corkami.googlecode.com/svn/!svn/bc/480/trunk/misc/pdf/helloworld_js_X.pdf"">")))
(assert (or (= z "le>test</ol>") (= z "abbr>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "abbr>" z)))
(assert (or (= "<embed src=""http://corkami<b>googlecode.com/svn/!svn/bc/480/trunk/misc/pdf/helloworld_js_X.pdf"">" (str.replace x "." "<b>")) (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z]{1,}[0-9]{1,}")) (>= (str.len x) 84)))
(assert (str.prefixof "<em" x))
(assert (or (<= (str.len x) 53) (= (str.indexof y "it" 0) 32) (= (str.len z) 48)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\d]{4}")) (not (str.prefixof "vascrip" z))))
(check-sat)
