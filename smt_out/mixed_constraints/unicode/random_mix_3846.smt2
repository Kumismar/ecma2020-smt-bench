; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><details ondragover=alert(1) contenteditable>drop here</details>") (= x "<canvas onmousedown=""alert(1)"">test</canvas>")))
(assert (or (= z "</style><meter id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></meter>") (= z "yle>:target {transform: rotate(180deg);}</style><strong id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></strong>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace z "ert" "javascript:") "el=aljavascript:(")))
(assert (not (= (str.len x) 115)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,10}$"))))
(assert (or (str.prefixof "<" y) (not (= (str.at x 40) "v"))))
(assert (or (= (str.at x 107) "d") (str.prefixof "yle>:ta" z)))
(assert (or (not (str.contains y ")><")) (not (= (str.at x 33) "s"))))
(check-sat)
