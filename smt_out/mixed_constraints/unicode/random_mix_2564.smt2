; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><slot ondragover=alert(1) contenteditable>drop here</slot>") (= x "</h\u{1f600}tml>//[""\u{10348}'`-->]]>]</div>") (= x "<;STYLE type="";text/css"";>;BODY{background:url("";javascript:alert(';XSS';)"";)}<;/STYLE>;")))
(assert (or (= z " id=x ta\u{20000}bindex=1 onactivate=\u{20000}alert(1)></script>") (= z "tenteditable>drop here</em>")))
(assert (= y (str.++ x z)))
(assert (= "ed" (str.substr y 10 2)))
(assert (= "<slot ondr" (str.substr x 51 10)))
(assert (or (str.contains z "ogress>") (str.prefixof "</h\u{1f600}tml>" y)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "\d\d\.\d\d\.\d\d\d\d")) (str.suffixof "ript>" z)))
(assert (or (not (str.contains (str.replace z "lert" "<b>") "e=\u{20000}a<b>(")) (str.prefixof "te" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[\d.-]{14}")))))
(assert (= (str.at z 13) "e"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{0,60}$"))) (not (str.suffixof ">;" x))))
(assert (= (str.at x 59) ":"))
(check-sat)
