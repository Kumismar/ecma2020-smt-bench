; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><img src=x onerror=javascript:alert((`1`))>") (= x "<style>@keyframes \u{10348}x{}</style><tr style=""animation-name:x"" onanimationstart=""alert(1)""></tr>")))
(assert (or (= z "=javascript:alert(1)>") (= z "</img>") (= z "7&(1)&R&UA;&&<&A9&11/script&X&>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 18) "o")))
(assert (or (str.prefixof "=javas" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*\S).{3,}"))) (>= (str.len z) 1)))
(assert (or (= (str.at x 20) "{") (<= (str.len x) 42)))
(assert (or (str.contains (str.replace z "</im" "") "g") (str.contains (str.replace x "a" "javascript:") "frjavascript:mes \u{10348}") (not (str.suffixof "script&X&>" y))))
(check-sat)
