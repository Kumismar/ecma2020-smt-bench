; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp onmouseout=""alert(1)\u{10348}"">test</\u{1d400}samp>") (= x "<a href=""about:<script>document.vulnerable=true;</script>"">")))
(assert (or (= z "alert(String.fromCharCode(88,83,83))"">") (= z "alert(1)//")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 38) (str.suffixof "3))"">" y)))
(assert (str.suffixof """>" x))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{0,180}"))))
(assert (<= (str.len x) 60))
(assert (or (= (str.at x 15) "a") (not (str.in_re x ((_ re.from_regex ecma2020 u) "https?://.*")))))
(assert (str.prefixof "<samp on" x))
(assert (not (<= (str.len y) 106)))
(assert (str.contains (str.replace y "erab" "javascript:") "njavascript:le=t"))
(check-sat)
