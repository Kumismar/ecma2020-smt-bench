; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;META HTTP-EQUIV="";refresh""; CONTENT="";0; URL=http://;URL=javascript:alert(';XSS';);"";>;") (= x "<embed code=""http://businessinfo.co.uk/labs/xss/xss.swf"" allowscriptaccess=always>?") (= x "<optgroup draggable=""true"" ondrag=""alert(1)"">test</optgroup>")))
(assert (or (= z "ndex=1 id=x></br><input autofocus>") (= z "table><TD BACKGROUND=""javascript:document.vulnerable=true;"">") (= z "le>test</param>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "tofocus>" z)))
(assert (or (= "ndex=1 id=x></brnput autofocus>" (str.replace z "><i" "")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_-|\/-]{3,24}")))))
(assert (or (str.prefixof "<;META HTT" x) (= "<embed code=""http://businessinfo.co.uk/labs/xss/xss.swf"" allowscriptaccess=al<b>>?ndex=1 id=x></br><input autofocus>" (str.replace y "ways" "<b>"))))
(assert (or (not (str.suffixof "S';);"";>;" x)) (not (= (str.indexof x "set " 0) 6))))
(assert (or (not (= (str.indexof y "agen" 0) 123)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9 ]){4,4}$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^0-9<>%]*$")))))
(assert (str.contains (str.replace z "table" "") "><TD "))
(check-sat)
