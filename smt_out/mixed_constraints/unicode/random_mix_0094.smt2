; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em oncopy=""alert(1)"" contenteditable>test</em>") (= x "<svg draggable=""true"" ondragenter=""alert(1)"">test</svg>") (= x "<figure onclick=""alert(1)"">test</figure>")))
(assert (or (= z "pan>") (= z "le>:target {color:red;}</style><select id=x style=""transition:color 1s"" ontransitionend=alert(1\u{10348})></select>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 24) "d")))
(assert (or (not (str.suffixof ">" z)) (not (= (str.len z) 107))))
(assert (or (not (str.contains (str.replace y "t</e" "javascript:") "tesjavascript:m>pa")) (= "r 1s" (str.substr y 106 4)) (not (= (str.at y 26) "a"))))
(assert (or (str.prefixof "<svg" y) (not (str.prefixof "<figure o" y))))
(assert (not (= (str.at x 32) "v")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0123456789]+$"))))
(check-sat)
