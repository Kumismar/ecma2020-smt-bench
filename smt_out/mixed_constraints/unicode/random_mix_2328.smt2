; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><span style=""animation-name:x"" onanimationstart=""alert(1)""></span>") (= x "<audio autoplay onloadedmetadata=alert(1)> <source src=""validaudio.wav"" type=""audio/wav""></audio>")))
(assert (or (= z "id=x tabindex=1 onfocusin=alert(1)></tt>") (= z "input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 76) "=") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z\d\.]{5,}$")))))
(assert (or (not (>= (str.len z) 9)) (= (str.indexof x "rt" 0) 74)))
(assert (or (not (str.contains (str.replace z "c" """") "ofo""us")) (not (str.contains x "onl"))))
(assert (or (not (= (str.len x) 97)) (not (str.prefixof "tes" z)) (str.prefixof "id=x t" z)))
(check-sat)
