; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><kbd id=x style=""transition:color 1s"" ontransitionend=alert(1)></kbd>") (= x "<main onbeforecut=""alert(1)"" contenteditable>test</main>")))
(assert (or (= z "=al\u{1d400}ert(1)></object>") (= z "name:x"" onanimationstart=""alert(1)""></center>") (= z "ert(1)"">test</\u{20000}br>\u{10348}")))
(assert (= y (str.++ x z)))
(assert (not (= "<style>:t t {color:red;}</style><kbd id=x style=""transition:color 1s"" ontransitionend=alert(1)></kbd>" (str.replace x "arge" " "))))
(assert (or (str.contains x "cut=""ale") (not (>= (str.len y) 169))))
(assert (or (str.prefixof "<main onbe" x) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^0[1-689][0-9]{8}$")))))
(assert (or (not (str.contains y "target {c")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$")))))
(assert (or (not (str.contains (str.replace x "(1)"" " "javascript:") "tjavascript:conte")) (not (str.contains z "roso"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9 ]){4,4}$"))))
(check-sat)
