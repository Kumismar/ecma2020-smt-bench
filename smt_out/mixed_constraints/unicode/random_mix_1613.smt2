; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style onmouseout=""alert(1)"">test</style>") (= x "<noframes onbeforecopy=""alert(1)"" contenteditable>test</noframes>") (= x "<thead onfocusout=alert(1) tabindex=1 id=x></thead><input autofocus>")))
(assert (or (= z "ert(1) tabindex=1 id=x></thead><input autofocus>") (= z "ge onfocusout=alert(1) tabindex=1 id=x></image><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "tofocus>" y))
(assert (or (not (str.prefixof "ert(1) t" z)) (= "1) tabind" (str.substr y 69 9))))
(assert (or (= (str.indexof z "es o" 0) 3) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{4}-\d{3}?$")))))
(assert (or (= (str.at y 18) "x") (= (str.at z 21) ")") (not (str.suffixof "es>" x))))
(assert (not (= "><input " (str.substr x 50 8))))
(assert (or (not (= "lt;/OB" (str.substr y 127 6))) (not (str.suffixof "ocus>" y)) (not (str.contains z "head><inpu"))))
(check-sat)
