; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<center draggable=""true"" ondrag=""alert(1)"">test</center>") (= x "<dd onmouseleave=""alert(1)"">test</dd>") (= x "<a href=""javascript\x3Ajavascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z ">") (= z "forepaste=""alert(1)"" contenteditable>test</body>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z ">" 0) 0))
(assert (not (= (str.len z) 48)))
(assert (or (not (= (str.indexof y "e=""a" 0) 15)) (= "<a href=""javascript\x3Ajavascript:alert(1)"" id=""fuzzelealert(1)ent1"">test</a>" (str.replace x "m" "alert(1)")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\s]{1,4}$")))))
(assert (or (str.prefixof "<summary" y) (= ">" (str.substr z 0 5)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]*$"))))
(assert (not (= (str.at y 7) " ")))
(assert (or (>= (str.len x) 33) (= (str.indexof y "r>" 0) 54) (= (str.at z 0) ">")))
(assert (or (not (str.contains x "cript:a")) (str.contains y "ascript:a") (str.prefixof "forepaste=" z)))
(check-sat)
