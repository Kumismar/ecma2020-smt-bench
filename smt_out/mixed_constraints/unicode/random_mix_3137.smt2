; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "XSS/*-*/STYLE=xss:e/**/xpression(alert('XSS'))>") (= x "<aside oncopy=""alert(1)"" contenteditable>test</aside>") (= x "<select onkeydown=""alert(1)"" contenteditable>test</select>")))
(assert (or (= z ")"">test</dd>") (= z "lert(1)></applet>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "ouse" z) (= (str.at y 56) "t") (= (str.indexof x "abl" 0) 14)))
(assert (not (str.contains x "<i")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9\u{e4}\u{fc}\u{f6}\u{c4}\u{dc}\u{d6}\u{df}]+((-|\.|\s)*[_A-z\u{e4}\u{fc}\u{f6}\u{c4}\u{dc}\u{d6}\u{df}]*(\.)*)*$"))))
(assert (= "<aside oncopy=""alert(1)"" contenteditable>test</aside>)"">test</""" (str.replace y "dd>" """")))
(assert (or (not (>= (str.len x) 52)) (str.prefixof "<" x) (not (= (str.at x 9) "T"))))
(assert (or (not (>= (str.len x) 54)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(\d{1,3},(\d{3},)*\d{3}|\d+)$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9]{11})$")))))
(assert (= "</applet>" (str.substr y 61 10)))
(check-sat)
