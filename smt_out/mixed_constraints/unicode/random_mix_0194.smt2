; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<INPUT TYPE=""IMAGE"" SRC=""javascript:javascript:alert(1);"">") (= x "<canvas draggable=""true"" ond\u{20000}ragenter=""alert(1)"">test</canvas>")))
(assert (or (= z "est</small>") (= z "trong draggable=""true"" ondragend=""alert(1)"">test</strong>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_]{4,32}$"))) (= (str.indexof z "r" 0) 1) (not (str.contains y "anvas"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9.\-_]{1,}@[a-zA-Z.\-]{2,}[.]{1}[a-zA-Z]{2,}"))) (= (str.at z 16) """")))
(assert (or (not (<= (str.len x) 68)) (str.contains (str.replace x "nd\u{20000}" "javascript:") "ue"" ojavascript:ragen")))
(assert (or (not (str.prefixof "<INPUT T" y)) (not (>= (str.len x) 54))))
(assert (= (str.at x 1) "d"))
(assert (or (str.prefixof "<can" x) (str.prefixof "<canvas " y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(.){6,100}$")))))
(assert (not (str.suffixof "mall>" y)))
(check-sat)
