; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<map id=x tabindex=1 onbeforeactivate=alert(1)></map>") (= x "<style>:target {transform: rotate(180deg);}</style><body id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></body>")))
(assert (or (= z "time>") (= z "C=javascript:alert('XSS')>") (= z "t(""XSS"");&lt;/SCRIPT&gt;")))
(assert (= y (str.++ x z)))
(assert (not (= "<col""roup onmouseout=""alert(1)"">test</colgroup>" (str.replace x "g" """"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^([0-9]{5})$)|(^[A-Za-z]{1}\d{1}[A-Za-z]{1} *\d{1}[A-Za-z]{1}\d{1}$)"))) (not (str.prefixof "t" z))))
(assert (or (str.contains (str.replace y """" " ") "tyle= tran") (str.suffixof "y>time>" y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(0*[1-9][0-9]*(\.[0-9]+)?|0+\.[0-9]*[1-9][0-9]*)$")))))
(assert (or (str.contains x ":transfor") (str.contains (str.replace z "IPT&g" "alert(1)") "SCRalert(1)t;")))
(assert (= (str.at z 2) "m"))
(check-sat)
