; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer draggable=""true"" ondragleave=""alert(1)"">test</footer>") (= x "<div draggable=""true"" contenteditable>drag me</div><wbr ondragover=alert(1) contenteditable>drop here</wbr>") (= x "<summary onpaste=""alert(1)"" contenteditable>test</summary>")))
(assert (or (= z "S'))>") (= z "teditable>test</isindex>") (= z "dex=1 id=x></abbr><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "iv d" 0) 2)) (not (>= (str.len x) 32))))
(assert (or (not (= "=""al" (str.substr x 16 4))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9 -]*[A-Za-z0-9][A-Za-z0-9 -]*$"))) (not (= (str.indexof y "m" 0) 43))))
(assert (or (<= (str.len y) 96) (not (= (str.at z 0) "s")) (not (= "<summary onpaste=""alert(1)"" contentedialert(1)e>test</summary>" (str.replace x "tabl" "alert(1)")))))
(assert (or (str.contains y "/wbr") (str.prefixof "<;!--" y)))
(assert (<= (str.len y) 76))
(assert (not (str.prefixof "<summary o" y)))
(check-sat)
