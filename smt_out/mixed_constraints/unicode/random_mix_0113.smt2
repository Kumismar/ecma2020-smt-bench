; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen onclick=""alert(1)"">test</keygen>") (= x "<nextid onmouseout=""alert(1)"">test</nextid>")))
(assert (or (= z "c=http://xss.rocks/scriptlet.html <") (= z " ondeactivate=alert(1)></section><input id=y autofocus>") (= z "nchange=alert(1) value=xss>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "><i")) (str.in_re z ((_ re.from_regex ecma2020 u) "[A-za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-za-z]{2,4}$"))))
(assert (= "<small onmouseenter=""alert(1)xt</small>" (str.replace x """>tes" "x")))
(assert (= (str.indexof z "t" 0) 3))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[0 ]{1}[0-9 ]{6,15}")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z_ -]{1,20}")))))
(assert (or (str.suffixof "t</nextid>" x) (= (str.indexof z "1) v" 0) 14)))
(assert (>= (str.len x) 41))
(assert (not (= (str.at y 81) "s")))
(check-sat)
