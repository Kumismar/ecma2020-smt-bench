; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object onpaste=""alert(1)"" contenteditable>test</object>") (= x "<progress id=x tabindex=1 ondeactivate=alert(1)></progress><input id=y autofocus>")))
(assert (or (= z "ack>") (= z " draggable=""true"" ondragenter=""alert(1)"">test</hgroup>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<obje" x))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) ".+@[^.]+\..{2,}"))) (= """ " (str.substr z 16 2))))
(assert (or (not (= (str.indexof x "e" 0) 4)) (not (= " i" (str.substr y 9 2)))))
(assert (or (not (<= (str.len z) 4)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\d.-]+$")))))
(assert (str.prefixof " drag" z))
(assert (not (= (str.at z 2) "k")))
(assert (not (str.contains z "ert(1)></t")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{4}-\d{2}$"))))
(check-sat)
