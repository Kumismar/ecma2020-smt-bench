; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object data=""http://corkami.googlecode.com/svn/!svn/bc/480/trunk/misc/pdf/helloworld_js_X.pdf"">") (= x "<div draggable=""true"" contenteditable>drag me</div><footer ondragover=alert(1) contenteditable>drop here</footer>") (= x "<summary onclick=""alert(1)"">test</summary>")))
(assert (or (= z """alert(1)"" contenteditable>test</blink>") (= z ") contenteditable>drop here</rb>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len x) 113) (not (str.in_re y ((_ re.from_regex ecma2020 u) "([\w\d]){6,12}"))) (not (str.contains (str.replace y "bjec" """") "o""t "))))
(assert (str.suffixof "nk>" z))
(assert (not (str.contains z "e>test")))
(assert (not (= (str.at y 69) ";")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "\d{12,}"))) (= (str.at y 26) """")))
(check-sat)
