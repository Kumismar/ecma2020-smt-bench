; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del draggable=""true"" ondragenter=""alert(1)"">test</del>") (= x """><script>alert(""XSS by \nxss"")</script>><marquee><h1>XSS by xss</h1></marquee>")))
(assert (or (= z "ck=""alert(1)"">test</col>") (= z "ble>test</marquee>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len x) 70) (not (= (str.len y) 97)) (not (str.contains x "del"))))
(assert (or (= (str.indexof y "=aler" 0) 40) (not (= (str.indexof y "ing" 0) 61))))
(assert (or (= (str.at z 10) "1") (str.prefixof "7/"">X" z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\(\)\-\.\s\+]{5,20}")) (not (str.suffixof "test</col>" z)) (not (str.suffixof "est</col>" z))))
(assert (or (not (str.contains (str.replace x "ary>" "<b>") "m<b>")) (= (str.at x 46) "e") (= "bjavascript:e>test</multicol>" (str.replace z "l" "javascript:"))))
(assert (or (not (str.suffixof "ee>" x)) (not (= (str.len z) 18))))
(check-sat)
