; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo onclick=""alert(1)"">test</bdo>") (= x "<optgroup onkeydown=""alert(1)"" contenteditable>test</optgroup>") (= x "<picture onmouseenter=""alert(1)"">test</picture>")))
(assert (or (= z "/header><input autofocus>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9- ]{2,8}"))) (not (str.suffixof "up>" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "(.){8,20}")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z]+ [a-zA-Z\.]+$"))) (not (str.prefixof "/h" z))))
(assert (not (str.contains y "test</optg")))
(assert (or (not (str.contains z ">")) (= "<pictxonmouseenter=""alert(1)"">test</picture>" (str.replace x "ure " "x"))))
(check-sat)
