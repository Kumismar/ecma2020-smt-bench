; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select id=x tabindex=1 onbeforeactivate=alert(1)></select>") (= x "<body onfocus=alert(1)>") (= x "<ol onmousedown=""alert(1)"">test</ol>")))
(assert (or (= z "onkeyup=""alert(1)"" contenteditable>test</label>") (= z "ert(1)"" contenteditable>test</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "1 onbefo" (str.substr x 22 8))) (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))))
(assert (not (= (str.len y) 93)))
(assert (not (= (str.at z 8) """")))
(assert (str.contains y "<body "))
(assert (or (not (<= (str.len x) 62)) (str.prefixof "<;DIV" y) (str.in_re x ((_ re.from_regex ecma2020 u) "^[()+ 0-9]+$"))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-Z]|[a-z]|[0-9]){8,11}$")))
(assert (not (str.contains x "own=")))
(assert (= "rt(1)"" c" (str.substr y 37 8)))
(check-sat)
