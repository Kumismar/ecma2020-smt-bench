; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<shadow oncontextmenu=""alert(1)"">test</shadow>") (= x "<em draggable=""true"" ondragend=""alert(1)"">test</em>")))
(assert (or (= z "es x{}</style><style style=""animation-name:x"" onanimationend=""alert(1)""></style>") (= z ";") (= z """alert(1)"" contentedita\u{20000}ble>test</keygen>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof ";" z))
(assert (or (str.contains y """>te") (str.in_re z ((_ re.from_regex ecma2020 u) "^\d\d\d\d\d(-\d\d\d\d)?$")) (>= (str.len z) 32)))
(assert (or (str.suffixof "/track>" z) (not (str.prefixof "<" y)) (not (str.suffixof "est</em>;" y))))
(assert (or (= (str.indexof z "</key" 0) 32) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[+][0-9]{11}$"))) (not (str.contains y "<shadow"))))
(check-sat)
