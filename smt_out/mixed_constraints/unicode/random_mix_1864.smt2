; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdi onkeydown=""alert(1)"" contenteditable>test</bdi>") (= x "<svg oncut=""alert(1)"" contenteditable>test</svg>")))
(assert (or (= z """javascript:alert('XSS')"">") (= z "0:#0=alert/#0#/#0#(0)})</script>") (= z "=x></s\u{20000}up><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "transfor") (not (= (str.at x 25) "t")) (= (str.at x 27) "o")))
(assert (not (= (str.at z 14) "/")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[ \t\r\n\f0-9-()-+]*$"))) (str.contains (str.replace x ")""" "alert(1)") "1alert(1) ")))
(assert (or (= "alert(""ontenteditable>drop here</kbd>" (str.replace z "1) c" """")) (str.contains y "1)"" co") (not (<= (str.len x) 53))))
(assert (or (= (str.indexof x "sv" 0) 1) (not (= "<label onmousedon=""alert(1)"">test</label>" (str.replace x "w" "")))))
(check-sat)
