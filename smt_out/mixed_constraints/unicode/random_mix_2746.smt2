; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<!--[if]><script>javascript:alert(1)</script -->") (= x "<FRAMESET><FRAME SRC=""javascript:alert('XSS');""></FRAMESET>")))
(assert (or (= z "tyle><title id=x style=""transition:color 1s"" ontransitionend=alert(1)></title>") (= z "script:alert(1)</script>") (= z "ert(1)"">test</applet>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([\w\.\-]+)@([\w\-]+)((\.(\w){2,6})+)$"))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^DE(?:\s*[0-9a-zA-Z]\s*){20}$")))
(assert (= (str.at z 48) "r"))
(assert (not (= (str.indexof x ")" 0) 35)))
(assert (str.contains z "t</a"))
(assert (or (not (= "l" (str.substr y 123 1))) (not (= (str.at y 37) "t"))))
(assert (or (= (str.at z 9) "e") (>= (str.len x) 44)))
(assert (or (= "<!--[if]><script>javascript:alert(1)</script -->tyle><title id=x style=""traalert(1)sition:color 1s"" ontransitionend=alert(1)></title>" (str.replace y "n" "alert(1)")) (not (<= (str.len z) 23))))
(assert (str.contains y "<F"))
(check-sat)
