; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><output onload=alert(1)></output>") (= x "<xmp id=x tabindex=1 onbeforeactivate=alert(1)></xmp>") (= x "<isindex onkeyup=""alert(1)"" contenteditable>test</isindex>")))
(assert (or (= z "ng.fromCharCode(49))</script ^__^") (= z "g onunload svg onunload=""javascript:javascript:alert(1)""></svg onunload>") (= z "usin=alert(1)></dir>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 3) "g")) (= ">g onu" (str.substr y 37 6)) (not (str.contains y "rt(1"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+\.[a-zA-Z]{2,10}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "([\w-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-zA-Z]{2,6}(?:\.[a-zA-Z]{2})?)$"))) (str.contains (str.replace y "ody>" "<b>") "</tb<b>")))
(assert (str.contains (str.replace z "/scri" "javascript:") "49))<javascript:pt ^_"))
(assert (or (not (str.prefixof "<svg><ou" y)) (= "<vide" (str.substr x 0 5))))
(check-sat)
