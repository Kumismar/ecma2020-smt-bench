; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame onblur=alert(1) tabindex=1 id=x></frame><input autofocus>") (= x "<style>:target {transform: rotate(180deg);}</style><rb id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></rb>")))
(assert (or (= z "true"" ondragenter=""alert(1)"">test</section>") (= z "=1 onfocus=alert(1)></mark>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "le><rb id" (str.substr x 48 9))) (str.suffixof ">" y)))
(assert (or (not (<= (str.len x) 59)) (>= (str.len y) 146) (not (<= (str.len y) 116))))
(assert (= (str.indexof x "t aut" 0) 52))
(assert (or (not (= (str.indexof x "me o" 0) 4)) (not (= """true"" " (str.substr x 15 7)))))
(assert (or (str.contains y "80\x88") (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{10}$"))))
(check-sat)
