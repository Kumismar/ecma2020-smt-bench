; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<foreignObject xlink:href=""data:text/xml,%3Cscript xmlns='http://www.w3.org/1999/xhtml'%3Ealert(88)%3C/script%3E""/>") (= x "<a style=""behavior:url(#default#AnchorClick);"" folder=""javascript:javascript:alert(1)"">XXX</a>")))
(assert (or (= z "test</input>") (= z "c=validimage.png onload=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<a styl" x)))
(assert (or (not (= "#A" (str.substr x 31 2))) (str.in_re y ((_ re.from_regex ecma2020 u) "(.*?)@(.*?).(.*?)"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9_-]+\.[a-zA-Z0-9-.]{2,61}$"))))
(assert (or (not (= " xl" (str.substr x 14 3))) (not (>= (str.len x) 110))))
(assert (or (not (str.suffixof "test</ins>" y)) (str.contains z "alert(") (not (= (str.at x 22) "("))))
(assert (or (>= (str.len z) 5) (<= (str.len x) 61)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^([\+][0-9]{1,3}(\s)?)?([0-9]{9,})$")) (not (str.prefixof "<" x)) (not (= "itionrun" (str.substr z 49 8)))))
(check-sat)
