; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot draggable=""true"" ondragend=""alert(1)"">test</tfoot>") (= x "<span onkeydown=""alert(1)"" contenteditable>test</span>") (= x "<style>:target {color: red;}</style><plaintext id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></plaintext>")))
(assert (or (= z "d=x tabindex=1 onfocus=alert(1)></mark>") (= z "1)"">test</label>") (= z "(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Z]{2,3}_[a-z]+:[0-9]{4}$"))) (not (str.contains y "an>d=")) (= (str.indexof z "(1)""" 0) 0)))
(assert (or (str.prefixof "<span " x) (not (= (str.indexof z "(1)"">" 0) 0))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[0][1-9][0-9]{8}$")) (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?\d{1,4}\s{0,}(\(\d{1,4}\))?\s{0,}(\d{1,5}\s{0,}-?){1,4}$"))))
(assert (or (not (= (str.len x) 121)) (not (str.contains (str.replace x "d" " ") "  ragg")) (not (= " dragg" (str.substr y 6 6)))))
(assert (or (not (= (str.indexof x " c" 0) 26)) (str.prefixof "<video aut" y)))
(assert (or (str.contains z "(1)") (str.suffixof "rk>" y)))
(check-sat)
