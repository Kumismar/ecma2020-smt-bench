; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><img src=x onerror=javascript:alert((`1`))>") (= x "<rt id=x tabindex=1 \u{20000}onfocusi\u{10348}n=alert(1)></rt>") (= x "&lt;META HTTP-EQUIV=\""refresh\"" CONTENT=\""0;url=javascript&#058;alert('XSS');\""&gt;")))
(assert (or (= z "em onbeforecopy=""alert(1)"" contenteditable>test</menuitem>") (= z "></dd>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "gress>" z) (str.suffixof "tem>" y)))
(assert (str.prefixof "&lt;META " x))
(assert (not (str.prefixof "em " z)))
(assert (or (str.contains x "nfoc") (= "></rt>></d" (str.substr y 40 10)) (str.contains (str.replace y "t>></" "<b>") ")></r<b>d")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^([^0-9?!+ ]{1})([^0-9?!+]{2,})$")) (not (= (str.indexof z "te" 0) 30)) (str.prefixof "&lt;META " y)))
(assert (str.contains z "></dd"))
(check-sat)
