; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x oncuechange=""alert(String.fromCharCode(88,83,83))"">") (= x "<script src=1 href=1 onerror=""javascript:alert(1)""></script>") (= x "<script>javascript:alert(1)</script>")))
(assert (or (= z ";>;<;/SCRIPT>;") (= z "rt(String.fromCharCode(88,83,83))>;")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 8) "R")))
(assert (str.contains x "trin"))
(assert (or (str.contains (str.replace x "as" "x") "<bxe") (not (str.prefixof "rt" z)) (str.suffixof ";" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s]{1,50})$"))) (not (str.suffixof "3))>;" y)) (= (str.at y 18) "a")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z\u{154}\u{c1}\u{c2}\u{102}\u{c4}\u{139}\u{106}\u{c7}\u{10c}\u{c9}\u{118}\u{cb}\u{11a}\u{cd}\u{ce}\u{10e}\u{110}\u{143}\u{147}\u{d3}\u{d4}\u{150}\u{d6}\u{158}\u{16e}\u{da}\u{170}\u{dc}\u{dd}\u{162}\u{df}\u{155}\u{e1}\u{e2}\u{103}\u{e4}\u{13a}\u{107}\u{e7}\u{10d}\u{e9}\u{119}\u{eb}\u{11b}\u{ed}\u{ee}\u{10f}\u{111}\u{144}\u{148}\u{f3}\u{f4}\u{151}\u{f6}\u{159}\u{16f}\u{fa}\u{171}\u{fc}\u{fd}\u{163}\u{2d9} \t\r\n\f]*$")))
(assert (or (not (= (str.indexof y "<sc" 0) 0)) (not (str.suffixof ">" x))))
(assert (or (not (= (str.at z 1) ">")) (str.in_re x ((_ re.from_regex ecma2020 u) "userName")) (= (str.indexof x "ert" 0) 21)))
(check-sat)
