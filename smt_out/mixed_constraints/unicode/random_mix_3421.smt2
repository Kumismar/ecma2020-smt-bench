; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""126""><object id=""x"" classid=""clsid:CB927D12-4FF7-4a9e-A169-56E4B8A75598""></object>") (= x "<table onmouseout=""alert(1)"">test</t\u{10348}able>") (= x "<frame oncontextmenu=""alert(1)"">test</frame>")))
(assert (or (= z ">") (= z "div><samp ondragover=alert(1) contenteditable>drop here</samp>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "=""" 0) 20)) (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-z0-9 ]){2,}$"))))
(assert (or (not (str.contains z ">")) (not (= (str.indexof x """" 0) 21))))
(assert (or (not (= (str.len z) 128)) (str.suffixof "/t\u{10348}able>" x) (str.in_re x ((_ re.from_regex ecma2020 u) "^\+?[0-9]{7,15}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*$"))))
(assert (or (= (str.len x) 42) (not (= "<fram<b>ontextmenu=""alert(1)"">test</frame>>" (str.replace y "e onc" "<b>")))))
(check-sat)
