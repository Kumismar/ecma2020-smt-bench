; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg draggable=""true"" ondragenter=""alert(1)"">test</svg>") (= x "<object data=javascript&colon;\u{5c}u0061&#x6C;&#101%72t(1)>") (= x "<noembed onkeydown=""alert(1)"" contenteditable>test</noembed>")))
(assert (or (= z "(1)"">test</samp>") (= z "(\\""\"";") (= z "l>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "ditable>te") (not (str.contains x """ conten")) (= """></summ" (str.substr z 18 8))))
(assert (or (not (str.contains x "%72t(")) (not (str.prefixof "<" x)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.{6,64}$")))))
(assert (not (<= (str.len x) 59)))
(assert (or (not (= (str.indexof x "d o" 0) 7)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w.-]+@[\w.-]+\.[\w]{2,6}$")))))
(assert (or (= (str.at z 5) "p") (not (= (str.indexof z "es" 0) 6))))
(assert (or (= "8" (str.substr y 147 1)) (not (str.suffixof ">" y))))
(assert (not (= (str.len x) 55)))
(check-sat)
