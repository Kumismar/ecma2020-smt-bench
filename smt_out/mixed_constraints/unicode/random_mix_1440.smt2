; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe src=""http://www.example.org/dropHere.html""></iframe>//[""'`-->]]>]</div>") (= x "<form onbeforepaste=""alert(1)"" contenteditable>test</form>")))
(assert (or (= z "(1)") (= z "ert(1)"">test</template>") (= z "eo autoplay onplay=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 82)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[^ -~]*"))) (str.suffixof "]>]</div>" x)))
(assert (str.suffixof ")" z))
(assert (or (str.contains z "(1)") (not (str.in_re x ((_ re.from_regex ecma2020 u) "(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)\d\d"))) (= "<ifame src=""http://www.example.org/dropHere.html""></iframe>//[""'`-->]]>]</div>(1)" (str.replace y "r" ""))))
(assert (or (= "<img src=x xor=\x32""javascript:alert(1)"">avascript:alert(1)"" id=""fuzzelement1"">test</a>" (str.replace y "onerr" "x")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{142}\u{15b}\u{17c}\u{f3}\u{105}\u{119}\u{144}\u{107}][0-9a-z\u{142}\u{15b}\u{17c}\u{f3}\u{105}\u{119}\u{144}\u{107}A-Z-._\-]*$"))) (= "est</temp" (str.substr z 9 9))))
(assert (str.prefixof "<picture i" x))
(assert (or (not (str.suffixof "ction>" z)) (<= (str.len x) 62)))
(assert (not (str.contains z "t</tem")))
(check-sat)
