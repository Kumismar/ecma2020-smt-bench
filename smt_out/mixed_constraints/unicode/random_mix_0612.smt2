; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onmousedown=""alert(1)"">test</html>") (= x "<style>@keyframes x{}</style><button style=""animation-name:x"" onanimationstart=""alert(1)""></butt\u{1f4a9}on>")))
(assert (or (= z "ot; Content=&quot;&lt;http://ha.ckers.org/xss.css&gt;; REL=stylesheet&quot;&gt;") (= z """ contenteditable>test</option>") (= z "t</colgroup>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "lesh" 0) 62) (not (= (str.at y 29) "<")) (not (= """ contenteditable>test</javascript:ion>" (str.replace z "opt" "javascript:")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z][\sa-zA-Z\.]*"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z\s\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$")) (not (= "te" (str.substr z 5 2)))))
(assert (or (str.contains (str.replace y " onmo" "<b>") "ml<b>us") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z \-'_]+$")))))
(assert (= (str.at y 22) "/"))
(assert (not (str.suffixof "</rb>" z)))
(assert (or (str.contains (str.replace x "n" """") "tml o""m") (not (str.prefixof "<style>" y)) (not (= (str.at y 39) "y"))))
(check-sat)
