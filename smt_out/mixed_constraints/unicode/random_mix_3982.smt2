; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><span id=x style=""transition:color 1s"" ontransitionend=alert(1)></span>") (= x "<a style=""-o-link:'javascript:javascript:alert(1)';-o-link-source:current"">X") (= x "<bdo id=x tabindex=1 onfocusin=alert(1)></bdo>")))
(assert (or (= z "style=""transition:color 10s"" ontransitioncancel=alert(1)></rp>") (= z "r 1s"" ontransitionend=alert(1)></content>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]{2,}\.[a-z]{2,}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9][0-9]-[0-9][0-9][0-9]"))))
(assert (or (>= (str.len y) 82) (= (str.indexof y "able=" 0) 14)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z ]*$"))))
(assert (or (not (str.suffixof "/content>" z)) (= "<bdo id=<b> tabindex=1 onfocusin=alert(1)></bdo>" (str.replace x "x" "<b>")) (not (str.prefixof "<a " y))))
(assert (or (= (str.at x 33) "e") (= (str.at x 68) "r") (not (= (str.indexof x "wn=""" 0) 17))))
(check-sat)
