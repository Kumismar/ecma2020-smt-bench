; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br onblur=alert(1) tabindex=1 id=x></br><input autofocus>") (= x "<strike draggable=""true"" ondragstart=""alert(1)"">test</strike>") (= x "<hgroup onmouseover=""alert(1)"">test</hgroup>")))
(assert (or (= z "/aside>") (= z "able>test</h1>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "s>" x) (not (str.suffixof ">" x))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]+\s[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+")) (not (= "<br onblur=alert(1) tabindex=1 id=x>br><input autofocus>" (str.replace x "</" ""))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\w]{8,}$")))))
(assert (= (str.at y 21) "u"))
(assert (not (= "<hgrou" (str.substr x 0 6))))
(assert (or (not (str.suffixof "trike>" x)) (not (= (str.indexof x "l" 0) 4))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{2}[A-Za-z0-9 ]*$"))))
(assert (not (str.contains y "mouseente")))
(check-sat)
