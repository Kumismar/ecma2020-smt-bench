; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<map onmouseover=""alert(1)"">test</map>") (= x "<SCRIPT SRC=//ha.ckers.org/.j>") (= x "<dd id=x tabindex=1 onbeforeactivate=alert(1)></dd>")))
(assert (or (= z """alert(1)"">test</span>") (= z "utofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[^\W]+$"))) (not (str.suffixof "/dd>" x)) (= "<dt id=x tabindexjavascript:nactivate=alert(1)></dt>olgroup>" (str.replace y "=1 o" "javascript:"))))
(assert (or (= (str.at x 15) "a") (not (>= (str.len x) 31))))
(assert (or (str.suffixof "on>" y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[(http(s)?):\/\/(www\.)?a-zA-Z0-9@:%._\+~#=]{2,256}\.[a-z]{2,6}\b([-a-zA-Z0-9@:%_\+.~#?&//=]*)")))))
(assert (or (str.suffixof "></dd>" x) (str.prefixof "<select o" x)))
(assert (or (not (str.contains y "ert(")) (not (str.contains (str.replace z "s>" "") "cu"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d).{4,}"))) (not (= (str.at y 20) "e")) (str.prefixof "<SCRIPT SR" y)))
(assert (not (= (str.len x) 30)))
(check-sat)
