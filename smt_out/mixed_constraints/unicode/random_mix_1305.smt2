; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figcaption draggable=""true"" ondrag=""alert(1)"">test</figcaption>") (= x "<isindex draggable=""true"" ondrag=""alert(1)"">test</isindex>") (= x "<div draggable=""true"" contenteditable>drag me</div><colgroup ondragover=alert(1) contenteditable>drop here</colgroup>")))
(assert (or (= z "alert(1)>click") (= z "1)></article>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "alert(1)" z) (not (>= (str.len z) 1))))
(assert (or (= (str.len x) 117) (not (str.suffixof "sindex>" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9_]*$")))))
(assert (or (str.prefixof "<isi" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,7}$")))))
(assert (or (not (<= (str.len x) 117)) (not (str.contains x "t</f")) (not (= "aler>click" (str.replace z "t(1)" "")))))
(assert (= (str.indexof y """ o" 0) 24))
(assert (or (not (= "r>" (str.substr z 5 7))) (not (str.contains y "rag=""aler"))))
(assert (= (str.at x 14) "a"))
(assert (= "<div draggable=""true"" contenteditablejavascript:g me</div><colgroup ondragover=alert(1) contenteditable>drop here</colgroup>1)></article>" (str.replace y ">dra" "javascript:")))
(check-sat)
