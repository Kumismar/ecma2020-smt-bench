; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture draggable=""true"" ondragenter=""alert(1)"">test</picture>") (= x "<link onkeyup=""alert(1)"" contenteditable>test</link>") (= x "<object onerror=javascript:javascript:alert(1)>")))
(assert (or (= z "ousedown=""alert(1)"">test</command>") (= z "ress>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "e>" x)))
(assert (or (= (str.indexof y ")" 0) 46) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z]{2}[0-9]{1,3}$"))) (not (= "<picture dragga""""true"" ondragenter=""alert(1)"">test</picture>ress>" (str.replace y "ble=" """")))))
(assert (= "s>" (str.substr z 10 6)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{12}$")))
(assert (= (str.indexof y "ictu" 0) 2))
(assert (not (str.contains z "edown")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "([A-Za-z._ ]?)+([A-Za-z\u{e9}\u{e1}\u{171}\u{fa}\u{151}\u{f3}\u{fc}\u{f6}\u{ed}\u{c9}\u{c1}\u{170}\u{da}\u{150}\u{d3}\u{dc}\u{cd}_ ]{2,})"))))
(check-sat)
