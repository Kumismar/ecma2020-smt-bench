; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article draggable=""true"" ondragend=""alert(1)"">test</article>") (= x "<listing onbeforepaste=""alert(1)"" contenteditable>test</listing>")))
(assert (or (= z "k>") (= z "=x tabindex=1 onbeforeactivate=alert(1)></optgroup>") (= z "able>test</head>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 1) ">")) (str.contains (str.replace y "<canv" "javascript:") "javascript:a")))
(assert (or (str.contains x "agend=""a") (= (str.indexof y "im" 0) 1)))
(assert (or (not (<= (str.len y) 121)) (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z\u{e9}\u{e8}\u{e2}]{3,30}")) (= (str.indexof y "le" 0) 6)))
(assert (or (str.suffixof "tgroup>" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\x20-\x7E]+$")))))
(assert (or (not (str.contains z "nb")) (str.in_re x ((_ re.from_regex ecma2020 u) "^0[0-9]{1}[\.\/_-]?[0-9]{2}[\.\/_-]?[0-9]{2}[\.\/_-]?[0-9]{2}[\.\/_-]?[0-9]{2}$")) (not (= (str.indexof z "e>tes" 0) 3))))
(assert (or (= "<arti  draggable=""true"" ondragend=""alert(1)"">test</article>" (str.replace x "cle" " ")) (str.contains y "e ") (not (= "ente" (str.substr z 25 4)))))
(check-sat)
