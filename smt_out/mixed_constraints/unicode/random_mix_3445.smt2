; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onbeforepaste=alert(1) value="""" autofocus>") (= x "&lt;BODY onload!#$%&()*~+-_&#46;,&#58;;?@&#91;/|\&#93;^`=alert(\""XSS\"")&gt;")))
(assert (or (= z "able>test</video>") (= z " onm\u{20000}ousemove=""alert(1)"">test</samp>") (= z "opy=""alert(1)"" contenteditable>test</shadow>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "rt(1") (= "ue=""" (str.substr y 33 4)) (str.suffixof "XSS\"")&gt;" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "((?=.*\w)(?=.*[0-9]).{8,})")) (str.prefixof "&lt;BOD" y) (not (str.contains (str.replace y "s" "<b>") "epa<b>te=a"))))
(assert (or (= (str.indexof x """al" 0) 17) (= "&lt;BODY onload!#$%&()*~+-_&#46;,&#58;;?"";/|\&#93;^`=alert(\""XSS\"")&gt;" (str.replace x "@&#91" """"))))
(assert (or (= (str.len z) 17) (>= (str.len x) 41) (= "div dra" (str.substr x 1 7))))
(check-sat)
