; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{1f4a9}<tt\u{1f4a9} id=x tabindex=1 onactivate=alert(1)></tt>") (= x "<isindex onmousemove=""alert(1)"">test</isindex>") (= x "<area ondblclick=""alert(1)"">test</area>")))
(assert (or (= z "ubmit>") (= z "s><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 13) "u")) (= (str.at x 7) "x") (str.contains (str.replace y "a" " ") "< rea ")))
(assert (or (not (= (str.at y 28) "v")) (not (= (str.indexof x "k=""al" 0) 15)) (str.suffixof "';XSS';)>;" x)))
(assert (or (not (str.contains y "</isinde")) (str.prefixof "&lt;L" x) (= "test" (str.substr x 32 4))))
(assert (or (str.prefixof "s><" z) (= "ivate" (str.substr x 27 5))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Z]{1,2}[0-9]{1,2}$"))) (str.contains (str.replace z "<" " ") "> i")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{3}.[0-9]{3}.[0-9]{4}"))))
(check-sat)
