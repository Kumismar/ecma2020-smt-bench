; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><time style=""animation-name:x"" onanimationend=""alert(1)""></time>") (= x "<param id=x tabindex=1 onfocusin=alert(1)></param>")))
(assert (or (= z " \u{1d400}onmouseleave=""alert(1)"">test</noembed>") (= z "el=alert(1)></dd>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 136) (not (= "ert(1)"">te" (str.substr y 68 10))) (str.contains x "focusin=a")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z\s-]+$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}\-_\.]+@[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}0-9\-_\.]+\.[a-zA-Z\-_\.]{2,10}$"))) (= (str.indexof z "=aler" 0) 2)))
(assert (str.prefixof " " z))
(assert (or (not (str.suffixof "up>>" y)) (not (= (str.indexof y """true" 0) 16))))
(assert (or (= ">" (str.substr y 92 1)) (not (str.contains x "a href")) (not (str.contains x "st"))))
(assert (or (str.suffixof "me>" x) (= "(1)></" (str.substr z 8 6))))
(check-sat)
