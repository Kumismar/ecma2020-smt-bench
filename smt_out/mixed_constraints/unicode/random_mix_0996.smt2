; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT SRC=http&#58;//ha&#46;ckers&#46;org/xss&#46;js?&lt;B&gt;") (= x "<spacer onmousedown=""alert(1)"">test</spacer>")))
(assert (or (= z "rt(1) tabindex=1 id=x></noscript><input autofocus>") (= z "=""alert(1)"" contented\u{20000}itable>test</audio>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "\([0-9]{2}\)9[0-9]{4,6}-[0-9]{3,4}$"))))
(assert (or (not (<= (str.len x) 54)) (not (str.prefixof "<tr onmo" x)) (= "ted" (str.substr z 18 3))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9,.!? ]*$")) (not (str.prefixof "&lt;S" y))))
(assert (or (not (str.prefixof "<spacer o" y)) (not (= "&#46;ckers" (str.substr y 28 10)))))
(check-sat)
