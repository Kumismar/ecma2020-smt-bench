; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas onbeforecut=""alert(1)"" contenteditable>test</canvas>") (= x "<style>@keyframes x{}</style><big style=""animation-name:x"" onanimationstart=""alert(1)""></big>")))
(assert (or (= z "div>") (= z "uot;behavior: url(http://ha.ckers.org/xss.htc);&quot;&gt;") (= z "tioncancel=alert(1)></rb>")))
(assert (= y (str.++ x z)))
(assert (not (= "e:x"" onani" (str.substr x 54 10))))
(assert (or (not (= (str.indexof y "m./" 0) 31)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-\u{17e}- ()]{2,}$")))))
(assert (or (= (str.indexof x "t=" 0) 18) (not (str.contains x "/canv")) (str.contains (str.replace x "l" "") "ut=""ae")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))) (not (str.suffixof "s>" x)) (not (= "i" (str.substr z 1 1)))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[a-zA-Z\d\w\W]{8,}$"))))
(check-sat)
