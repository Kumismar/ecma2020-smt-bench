; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<small onmouseout=""alert(1)"">test</small>") (= x "<footer onmouseenter=""alert(1)"">test</footer>")))
(assert (or (= z ")></col>") (= z " onkeydown=""alert(1)"" contenteditable>test</a>") (= z "on-name:x"" onanimationend=""alert(1)""></tbody>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "tione"))
(assert (or (str.contains y "dra") (not (str.contains (str.replace z "</col" """") ")>"">"))))
(assert (or (= (str.indexof x "oote" 0) 2) (= "=""" (str.substr x 20 2))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[\w]{13}"))) (str.prefixof "<small on" y) (not (str.prefixof "<footer" x))))
(assert (or (not (= (str.at y 7) " ")) (not (str.contains (str.replace x "mouse" "") "er onent")) (str.prefixof "<foote" y)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]+\.?[0-9]*$")))
(check-sat)
