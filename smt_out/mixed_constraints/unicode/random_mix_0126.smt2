; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ins id=x tabindex=1 ondeactivate=aler\u{1d400}t(1)></ins><input id=y autofocus>") (= x "<style>@keyframes x{}</style><summary style=""animation-name:x"" onanimationend=""alert(1)""></summary>")))
(assert (or (= z ">") (= z "A0javascript:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{4}-\d{3}-\d{4}$")) (not (str.prefixof "<ins id=" x)) (= "a" (str.substr z 3 1))))
(assert (or (not (<= (str.len x) 75)) (not (<= (str.len y) 87)) (= (str.len z) 30)))
(assert (str.prefixof "<style>@" x))
(assert (not (str.contains x ">t")))
(check-sat)
