; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menu onkeypress=""alert(1)"" contenteditable>test</menu>") (= x "<script\x2Ftype=""text/javascript"">javascript:alert(1\u{1f600});</scri\u{1f600}pt>") (= x "<title draggable=""true"" ondragstart=""alert(1)"">test</tit\u{1f600}le>")))
(assert (or (= z "b+c+d);") (= z "ndragover=alert(1) contenteditable>drop here</isindex>") (= z " tabindex=1 onfocusin=alert(1)></optgroup>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 2) "i") (not (str.contains (str.replace x "est" "javascript:") "ble>tjavascript:</me")) (str.suffixof "isindex>" z)))
(assert (or (str.suffixof "x>" y) (= (str.at y 22) "j")))
(assert (not (str.prefixof "<" x)))
(assert (or (= "rt=""alert(" (str.substr y 33 10)) (<= (str.len z) 48) (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{6,15}$"))))
(assert (or (str.prefixof "<menu" x) (not (= "group>" (str.substr z 36 9)))))
(assert (= "n=alert(" (str.substr x 29 8)))
(assert (= (str.indexof z "c+d)" 0) 2))
(assert (str.prefixof "<s" x))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*(?:\+?(\d{1,3}))?[-. (]*(\d{3})[-. )]*(\d{3})[-. ]*(\d{4})(?: *x(\d+))?\s*$")))
(check-sat)
