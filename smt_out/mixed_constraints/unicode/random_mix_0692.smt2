; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span ondblclick=""alert(1)"">test</span>") (= x "<style>:target {transform: rotate(180deg);}</style><h1 id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></h1>") (= x "<SCRIPT>a=/XSS/")))
(assert (or (= z "ert,a(1)") (= z "abindex=1 ondeactivate=alert(1)></legend><input id=y autofocus>") (= z "pression(alert('XSS'))>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9A-Za-z]+$"))) (str.prefixof "<" y)))
(assert (or (= (str.indexof z "e" 0) 1) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9_ -\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}]{3,60}$")))))
(assert (or (not (str.prefixof "<\u{10348}h" y)) (= (str.at z 21) ")")))
(assert (or (not (= "on(aler" (str.substr z 6 7))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "\([0-9]{2}\) [0-9]{4,6}-[0-9]{3,4}$")))))
(assert (or (= (str.at x 6) "T") (not (= (str.indexof y "vat" 0) 33))))
(assert (= (str.at x 14) "/"))
(assert (not (= "<SCR>a=/XSS/" (str.replace x "IPT" ""))))
(check-sat)
