; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong onmouseleave=""alert(1)"">test</strong>") (= x "<svg><sub onload=alert(1)></sub>") (= x "<IMG LOWSRC=""javascript:alert('XSS')"">")))
(assert (or (= z "rue"" ondrag=""alert(1)"">test</colgroup>") (= z "t(1)"">test</div>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) ".{4,20}$"))))
(assert (or (not (= (str.len z) 16)) (str.contains x "RC=""")))
(assert (or (not (= "di" (str.substr z 12 2))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{3041}-\u{3093}\u{30a1}-\u{30f3}]+$"))) (not (= (str.at y 47) "e"))))
(assert (not (str.prefixof "<s" y)))
(assert (= (str.at y 0) "<"))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) ".{8,}$")))
(check-sat)
