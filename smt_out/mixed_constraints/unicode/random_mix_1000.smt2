; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element onblur=alert(1) tabindex=1 id=x></element><input autofocus>") (= x "<data onclick=""alert(1)"">test</data>")))
(assert (or (= z "sition:color 10s"" ontransitioncancel=alert(1)></dialog>") (= z ";script&gt;alert(1)&lt;&sol;script&gt;") (= z "ND=\u{201d}javascript:alert(\u{2018}XSS\u{2019})\u{201d}>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "\u{2019})\u{201d}>" (str.substr y 93 8))) (not (str.contains x "lert(1)"""))))
(assert (or (not (str.contains (str.replace y "Char" "") "mCo")) (str.suffixof "XSS\u{2019})\u{201d}>" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([\w\+-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$")))))
(assert (or (not (= "(1)"">test<" (str.substr y 20 10))) (not (str.suffixof "t&gt;" z)) (not (str.prefixof "<element" y))))
(assert (not (= "10" (str.substr z 13 2))))
(check-sat)
