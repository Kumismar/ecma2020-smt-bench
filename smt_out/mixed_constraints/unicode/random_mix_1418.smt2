; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd onmouseleave=""alert(1)"">test</dd>") (= x "<style>BODY{-moz-binding:url(""http://www.securitycompass.com/xssmoz.xml#xss"")}</style>") (= x "<font onpaste=""alert(1)"" contenteditable>test</font>")))
(assert (or (= z "ationend=""alert(1)""></progress>") (= z "rame>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(\d{5}|\d{8})$")) (str.prefixof "<styl" y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?!test@test\.com$)[a-zA-Z0-9._%+-]{3,}@[a-zA-Z]{3,}\.[a-z]{2,}(?:\.[a-z]{2,})?")))))
(assert (or (= (str.indexof x """)" 0) 75) (str.prefixof "com>" z) (= (str.at x 51) "t")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{2}\/\d{2}\/\d{4}$")) (= (str.indexof z "</p" 0) 20)))
(assert (str.contains y "* */p"))
(assert (= (str.indexof x """ale" 0) 14))
(assert (or (not (str.prefixof "<style" x)) (not (= "</" (str.substr x 32 2))) (not (str.suffixof "ress>" y))))
(assert (not (str.contains (str.replace z "ert(1" """") """al"")"">")))
(check-sat)
