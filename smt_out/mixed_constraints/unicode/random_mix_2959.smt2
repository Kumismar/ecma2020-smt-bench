; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary onmousemove=""alert(1)"">test</summary>") (= x "<;BR SIZE="";&;{alert(';XSS';)}"";>;")))
(assert (or (= z "javascript:alert(1)""") (= z "dystatechange=alert(1)")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "er>") (= (str.at x 22) "a")))
(assert (= (str.at y 43) "r"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^0[2-9](?!00$)\d{1,5}$"))) (not (str.contains (str.replace x "<butt" " ") "m> on f"))))
(assert (or (str.suffixof "</summary>" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,}|[0-9]{1,3})(\]?)$"))) (not (str.contains x "e=""al"))))
(assert (not (str.suffixof "';)}"";>;" x)))
(assert (not (= (str.at x 28) ")")))
(assert (or (not (= (str.indexof x "ouse" 0) 12)) (not (= "vascript" (str.substr z 2 8)))))
(assert (or (not (= (str.indexof z "e=" 0) 12)) (str.suffixof "mmary>" x)))
(check-sat)
