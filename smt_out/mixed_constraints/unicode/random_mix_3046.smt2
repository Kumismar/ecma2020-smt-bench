; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""javascript\x0D:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x """/><img/onerror=\x60javascript:alert(1)\x60src=xxx:x />") (= x "<ol draggable=""true"" ondragenter=""alert(1)"">test</ol>")))
(assert (or (= z "eydown=""alert(1)"" contenteditable>test</bdo>") (= z "ontextmenu=""alert(1)"">test</data>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len y) 102)) (str.prefixof "eydow" z) (not (= (str.indexof y "<" 0) 0))))
(assert (or (not (str.contains z "1)"">test")) (not (<= (str.len y) 115)) (= (str.indexof z "/" 0) 27)))
(assert (not (str.suffixof ">" x)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "(^[1][3578][0-9]{9}$)|(^0\d{2,3}\d{7,8}$)")))
(assert (<= (str.len x) 65))
(assert (or (str.suffixof "</bdo>" y) (not (= (str.indexof z "st</d" 0) 24))))
(assert (or (not (str.contains z "t</d")) (not (str.prefixof "<html " x))))
(assert (not (= "a" (str.substr x 10 1))))
(check-sat)
