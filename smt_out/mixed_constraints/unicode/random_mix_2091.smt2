; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style draggable=""true"" ondragenter=""alert(1)"">test</style>") (= x "<marquee width=1 loop=1 onbounce=alert(1)>XSS</marquee>") (= x "<;XSS STYLE="";behavior: url(http://ha.ckers.org/xss.htc);"";>;")))
(assert (or (= z "p=""alert(1)"" c\u{1f4a9}ontenteditable>test</base>") (= z "rt(1)"">test</keygen>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "ita") (not (= (str.indexof z "ipt" 0) 0)) (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_.-]{1,}@[a-zA-Z0-9_.-]{1,}.[a-z0-9]{2,3}"))))
(assert (str.suffixof "e>" z))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[^\s*]([a-zA-Z\u{f1}\u{d1}\u{c0}-\u{ff}/\s]+){0,100}$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[^\d]+")))))
(assert (or (not (<= (str.len x) 62)) (= (str.at z 24) "t")))
(check-sat)
