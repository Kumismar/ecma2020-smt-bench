; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><cite id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></cite>") (= x "<isindex action=javascript:alert(1) type=submit value=click>")))
(assert (or (= z "=""alert(1)"">test</noframes>") (= z "alert(1)"">test</element>")))
(assert (= y (str.++ x z)))
(assert (or (= "n>" (str.substr z 32 3)) (not (str.suffixof "/noframes>" z)) (not (str.contains x "tyle"))))
(assert (= "e" (str.substr y 27 1)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^(.*\d.*){6,}$")))
(assert (or (= "><input a" (str.substr x 58 9)) (str.in_re z ((_ re.from_regex ecma2020 u) ".{9}")) (not (= (str.at x 13) "="))))
(assert (or (not (str.suffixof "e>" x)) (not (str.contains y "e=""tran")) (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{d1}\u{f1}\u{c1}\u{e1}\u{c9}\u{e9}\u{cd}\u{ed}\u{d3}\u{f3}\u{da}\u{fa}\s]+$"))))
(assert (or (not (= (str.indexof x "180d" 0) 34)) (not (= (str.indexof y ";>;" 0) 72)) (str.suffixof "ue=click>" x)))
(assert (not (str.contains y "ofram")))
(check-sat)
