(assert (or (not (= (str.indexof x "3" 0) 41)) (= "able=" (str.substr y 9 5)) (str.prefixof "id=x tabi" z)))
(assert (or (<= (str.len y) 84) (not (str.in_re x ((_ re.from_regex ecma2020 u) "\d+(\.\d+)?$")))))
