; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x0Ajavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<style>:target {color: red;}</style><progress id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></progress>")))
(assert (or (= z "000097&#0000118&#0000097&#0000115&#0000099&#0000114&#0000105&#0000112&#0000116&#0000058&#0000097&") (= z "br>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 96) (str.suffixof "/div>" x) (str.suffixof "</a>br>" y)))
(assert (or (not (= "progres" (str.substr x 37 7))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([SK]+[0-9\.\-]{8,10}|[0-9\.\-]{10})$"))) (str.prefixof "br>" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[\u{e4}\u{fc}\u{f6}a-z0-9.-]+\.[a-z]{2,63}$"))))
(assert (or (= "be" (str.substr x 23 2)) (str.prefixof "<a href=""\" y)))
(check-sat)
