; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<http://onxxx%3D1/") (= x "<dt onblur=alert(1) tabindex=1 id=x></dt><input autofocus>") (= x "<tt onkeydown=""alert(1)"" contenteditable>test</tt>")))
(assert (or (= z "rt(1)"" contenteditable>test</u>") (= z "&#41;>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "tp://") (>= (str.len x) 34) (= (str.at y 45) "<")))
(assert (not (= (str.indexof x "xta" 0) 3)))
(assert (or (= (str.indexof y "ut" 0) 45) (str.contains y "%3D1/&#")))
(assert (or (= (str.indexof z ">" 0) 0) (str.contains y "://onxxx%") (not (str.suffixof "</u>" z))))
(assert (or (not (= "rt(1)"" cotenteditable>test</u>" (str.replace z "n" ""))) (not (= (str.at x 44) "t")) (= (str.at x 2) "t")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^\+?(?:[0-9]|-| )+$")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9._%-]+@[a-z0-9.-]+\.[a-z]{2,4}$"))) (str.prefixof "&#" z)))
(check-sat)
