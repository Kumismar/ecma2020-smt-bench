; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed type=""image"" src=%(scriptlet)s></embed>") (= x "<TABLE BACKGROUND=""javascript:alert('XSS')"">")))
(assert (or (= z "foreactivate=alert(1)></aside>") (= z "start=""alert(1)""></dd>") (= z "genter=""alert(1)"">test</spacer>")))
(assert (= y (str.++ x z)))
(assert (or (= "<image draggable=""true"" ondragendalert(1)ert(1)"">test</image>" (str.replace x "=""al" "alert(1)")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}]).{6,}")))))
(assert (= (str.indexof x "crip" 0) 27))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{5,5}$"))) (= "animati" (str.substr z 30 7)) (not (= "<TABLE BACKGROUND="" script:alert('XSS')"">start=""alert(1)""></dd>" (str.replace y "java" " ")))))
(assert (or (= (str.indexof y "=" 0) 11) (not (str.suffixof "er>" z))))
(assert (or (not (= (str.indexof y "ACK" 0) 8)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z]+( +[a-zA-Z]+)*$"))) (not (= (str.len z) 62))))
(assert (not (str.prefixof "<" y)))
(check-sat)
