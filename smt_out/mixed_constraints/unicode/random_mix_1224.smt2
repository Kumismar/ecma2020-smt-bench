; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg onkeypress=""alert(1)"" contenteditable>test</svg>") (= x "<ruby id=x tabindex=1 onfocus=alert(1)></ruby>")))
(assert (or (= z "on=""javascript:alert(123)"">TESTHTML5FORMACTION") (= z """alert(1)"">test</data>") (= z " contenteditable>test</nobr>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace y "=""a" "") "yupl"))
(assert (or (>= (str.len x) 61) (not (= "ed" (str.substr y 38 2)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9 +]{0,15}$"))) (not (= (str.at x 36) "1")) (not (= (str.indexof z "ES" 0) 28))))
(assert (not (<= (str.len z) 37)))
(assert (or (not (= (str.at x 18) "l")) (not (str.contains x "xt o")) (= "23)"">TEST" (str.substr z 22 9))))
(assert (or (not (<= (str.len z) 54)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\+_a-z0-9-'&=]+(\.[\+_a-z0-9-']+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,})$")))))
(check-sat)
