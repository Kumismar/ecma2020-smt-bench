; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section onmouseenter=""alert(1)"">test</section>") (= x "<abbr onblur=alert(1) tabindex=1 id=x></abbr><input autofocus>") (= x "&#x000003C")))
(assert (or (= z ":target {color: red;}</style><mark id=x style=""tr\u{1f600}ansition:color 10s"" ontransitioncancel=alert(1)></mark>") (= z "1)"" contenteditable>test</b>") (= z "lert(1)></details>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "ction>" x)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\d{10}"))) (str.contains z "></deta")))
(assert (or (not (= " ontransit" (str.substr z 69 10))) (= (str.at y 4) "o") (not (str.contains (str.replace x "tes" "alert(1)") ">alert(1)t<"))))
(assert (str.prefixof "<tbod" x))
(assert (= (str.at x 23) "a"))
(assert (= "itionc" (str.substr z 77 6)))
(check-sat)
