; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet onError applet onError=""javascript:javascript:alert(1)""></applet onError>") (= x "<input type=image onloadend=alert(1) src=validimage.png>")))
(assert (or (= z " onbeforeactivate=alert(1)></bdo>") (= z "contenteditable>test</big>") (= z "S')""")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9\-\.\s\(\)]*$")) (not (= "et onErro" (str.substr y 70 9))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "-?[0-9]*?")))))
(assert (not (str.suffixof "rror>" x)))
(assert (or (str.prefixof "perl -e " x) (str.in_re y ((_ re.from_regex ecma2020 u) "^[_a-z0-9-]+(\.[_a-z0-9-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,4})$")) (not (= (str.indexof x "t" 0) 6))))
(assert (or (not (str.suffixof "test</big>" y)) (not (= (str.at y 16) "a"))))
(check-sat)
