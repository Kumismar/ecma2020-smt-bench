; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG \u{201c}\u{201d}\u{201d}><SCRIPT>alert(\u{201c}XSS\u{201d})</SCRIPT>\u{201d}>") (= x "<style>:target {color:red;}</style><canvas id=x style=""transition:color 1s"" ontransitionend=alert(1)></canvas>")))
(assert (or (= z "mation-name:x"" onanimationend=""alert(1)""></option>") (= z """true"" ondragenter=""alert(1)"">test</small>") (= z "onmousedown=""alert(1)"">test</colgroup>")))
(assert (= y (str.++ x z)))
(assert (not (= "(1)"">te" (str.substr y 65 7))))
(assert (or (str.contains (str.replace x "S" "alert(1)") "\u{201d}\u{201d}><alert(1)CR") (not (= (str.at x 21) "t")) (str.suffixof "olgroup>" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z\u{e1}\u{e0}\u{e2}\u{e3}\u{e9}\u{e8}\u{ea}\u{ed}\u{ef}\u{f3}\u{f4}\u{f5}\u{f6}\u{fa}\u{e7}\u{f1}\u{c1}\u{c0}\u{c2}\u{c3}\u{c9}\u{c8}\u{cd}\u{cf}\u{d3}\u{d4}\u{d5}\u{d6}\u{da}\u{c7}\u{d1} ]+$"))))
(assert (or (str.prefixof "<s" y) (= "e>:target " (str.substr y 5 10))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z,A-Z, ]{1,30}"))) (not (= (str.indexof z "nani" 0) 16))))
(assert (>= (str.len x) 106))
(check-sat)
