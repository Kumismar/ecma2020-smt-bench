; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IM\u{10348}G SRC=x onpause=""alert(Str\u{1f600}ing.fromCharCode(88,83,83))"">") (= x "<x%0Donxxx=1") (= x "<canvas onmousemove=""alert(1)"">test</canvas>")))
(assert (or (= z "/ins>") (= z "le>test</nav>") (= z "summary ondblclick=""alert(1)"">test</summary>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z " on" 0) 3) (not (str.contains y "mar"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*[0-9])(?=.*[a-z])(?=.*[A-Z]).{8,}"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\w\W]{1,4}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([0-9]{4}-[0-1][0-9]|[0-9][0-9])-(3[01]|[12][0-9]|0[1-9])$")))))
(assert (or (<= (str.len y) 100) (= "=""alert(St" (str.substr y 19 10))))
(assert (or (not (str.suffixof "anvas>" x)) (not (= (str.at y 29) "r"))))
(assert (or (not (= (str.at y 23) "b")) (not (= (str.at z 2) ">"))))
(check-sat)
