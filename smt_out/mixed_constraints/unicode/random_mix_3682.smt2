; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption onfocusout=alert(1) tabindex=1 id=x></caption><input autofocus>") (= x "<h1 onmousedown=""alert(1)"">test</h1>") (= x "<isindex id=x tabindex=1 onbeforeactivate=alert(1)></isindex>")))
(assert (or (= z ">test</nextid>") (= z " onmouseenter=""alert(1)"">test</rt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\s]+[-a-zA-Z0-9\s]+([-a-zA-Z0-9]+)*$"))) (<= (str.len x) 43) (str.suffixof "</nextid>" y)))
(assert (or (str.contains (str.replace y " " "javascript:") "ptjavascript:id=x ") (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9\s-]{9,11}")))))
(assert (or (not (= (str.at z 8) "e")) (str.contains y "edown=""ale")))
(assert (or (= (str.len y) 95) (not (= (str.at z 0) ">")) (not (= (str.indexof y ">" 0) 44))))
(assert (or (not (= (str.indexof y "rue" 0) 20)) (str.prefixof " onmou" z)))
(check-sat)
