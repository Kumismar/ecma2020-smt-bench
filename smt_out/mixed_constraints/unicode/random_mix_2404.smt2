; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;DIV STYLE="";background-image: url(&;#1;javascript:alert(';XSS';))"";>;") (= x "<font style='color:expression(alert(document.cookie))'>")))
(assert (or (= z "ndragstart=""alert(1)"">test</mark>") (= z "k=""alert(1)"">test</datalist>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "datalist")) (str.suffixof "re</menu>" x)))
(assert (not (= "ert(';" (str.substr y 54 6))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([0]?[1-9]|[1|2][0-9]|[3][0|1])[./-]([0]?[1-9]|[1][0-2])[./-]([0-9]{4}|[0-9]{2})$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\(\d\d\) \d\d\d\d-\d\d\d\d$"))) (= (str.indexof y "atal" 0) 75)))
(assert (or (not (str.contains z "datalist>")) (not (str.prefixof "ndr" z)) (= "ete" (str.substr x 35 3))))
(assert (or (not (= (str.indexof y "e" 0) 10)) (= (str.at y 38) "c") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(1[0-2]|0?[1-9])$")))))
(assert (or (= "ndrags=""alert(1)"">test</mark>" (str.replace z "tart" "")) (str.contains y "ession(a")))
(assert (not (str.prefixof ">test</ad" z)))
(check-sat)
