; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen oncopy=""alert(1)"" contenteditable>test</keygen>") (= x "<nobr draggable=""true"" ondragend=""alert(1)"">test</nobr>")))
(assert (or (= z "lert(1)"" contenteditable>test</sup>") (= z "\xE2\x81\x9Fjavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ">" y) (not (= (str.indexof z "o" 0) 4))))
(assert (or (str.prefixof "lert(1)"" c" z) (not (str.prefixof "<nobr d" y)) (str.contains z "ditable>t")))
(assert (or (not (= "e" (str.substr y 20 1))) (not (>= (str.len y) 86)) (= (str.indexof z "t</" 0) 28)))
(assert (or (= "(1)"" cont" (str.substr x 21 9)) (= (str.at z 32) "e") (not (= (str.at z 21) "b"))))
(assert (or (not (= ">" (str.substr y 89 8))) (str.in_re x ((_ re.from_regex ecma2020 u) "^12345$"))))
(check-sat)
