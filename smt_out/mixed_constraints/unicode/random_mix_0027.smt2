; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 id=x tabindex=1 ondeactivate=alert(1)></h1><input id=y autofocus>") (= x "<STYLE>.XSS{background-image:url(""javascript:javascript:alert(1)"");}</STYLE><A CLASS=XSS></A>")))
(assert (or (= z ">") (= z "art=""alert(1)""></param>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 126) (str.prefixof "<di" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}0-9\s\.\-]+$)"))) (= (str.len z) 23) (not (str.contains x "ent onmous"))))
(assert (not (= (str.at x 55) "d")))
(assert (or (not (= (str.len z) 1)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(^\d{5}$|^[A-Za-z0-9]{3} [A-Za-z0-9]{3}$)")))))
(check-sat)
