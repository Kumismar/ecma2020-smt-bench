; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup onkeypress=""alert(1)"" contenteditable>test</optgroup>") (= x "<xss id=x tabindex=1 onfocusout=alert(1)></xss><input autofocus>")))
(assert (or (= z ">test</data>") (= z "RC=x onscroll=""alert(String.fromCharCode(88,83,83))"">") (= z "ionca\u{10348}ncel=alert(1)></input>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "month-year"))))
(assert (not (= (str.at y 30) """")))
(assert (str.contains (str.replace y "f" "x") " onxocu"))
(assert (str.prefixof "ionca" z))
(assert (not (= "co" (str.substr x 32 2))))
(assert (or (str.prefixof "RC=x o" z) (str.in_re y ((_ re.from_regex ecma2020 u) "^(?:(?:\+?1\s*(?:[.-]\s*)?)?(?:(\s*\(?([2-9]1[02-9]|[2-9][02-8]1|[2-9][02-8][02-9])\)?\s*)|([2-9]1[02-9]|[2-9][02-8]1|[2-9][02-8][02-9]))\s*(?:[.-]\s*)?)([2-9]1[02-9]|[2-9][02-9]1|[2-9][02-9]{2})\s*(?:[.-]\s*)?([0-9]{4})$")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z-']{1,20}")))))
(assert (or (not (= (str.indexof z ">" 0) 19)) (= (str.at x 54) "a")))
(assert (not (str.suffixof "st</aside>" z)))
(assert (or (= (str.indexof x "/op" 0) 53) (= (str.indexof x "</xs" 0) 41) (str.suffixof "3))"">" z)))
(check-sat)
