; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><animatetransform onrepeat=alert(1) attributeName=transform repeatCount=2 dur=1s>") (= x "<div id=""39""><!-- up to Opera 11.52, FF 3.6.28 -->") (= x "<style>@keyframes x{}</style><body style=""animation-name:x"" onanimationstart=""alert(1)""></body>")))
(assert (or (= z "editable>test</figure>") (= z "e(180deg);}</style><svg id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></svg>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x " FF 3.6.2")) (not (<= (str.len z) 101))))
(assert (or (not (str.suffixof "/figure>" y)) (not (= "@keyframes" (str.substr x 7 10)))))
(assert (or (>= (str.len x) 44) (= (str.indexof z "</pi" 0) 19) (str.prefixof "<body " y)))
(assert (or (= (str.at y 35) ",") (str.suffixof "svg>" z) (str.in_re x ((_ re.from_regex ecma2020 u) "^[+]*[(]{0,1}[0-9]{1,4}[)]{0,1}[-\s\./0-9]*$"))))
(assert (or (not (= "<style>@keyfrmes x{}</style><body style=""animation-name:x"" onanimationstart=""alert(1)""></body>e(180deg);}</style><svg id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></svg>" (str.replace y "a" ""))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z0-9]{3,10}"))) (not (= (str.len y) 72))))
(check-sat)
