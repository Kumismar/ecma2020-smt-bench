; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset oncopy=""alert(1)"" contenteditable>test</frameset>") (= x "<embed onmouseout=""alert(1)"">test</embed>")))
(assert (or (= z "ndblclick=""alert(1)"">test</sup>") (= z "(1)></br>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len y) 74)) (not (= (str.len z) 9))))
(assert (or (not (= (str.len x) 59)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9\.,]{0,14}"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "(^[A-Za-z]{2,16})([ ]{0,1})([A-Za-z]{2,16})?([ ]{0,1})?([A-Za-z]{2,16})?([ ]{0,1})?([A-Za-z]{2,16})")))))
(assert (or (not (str.contains (str.replace z ")&N" "x") "ert(1xew")) (str.suffixof "</embed>" x)))
(assert (or (not (str.suffixof "IFRAME>" z)) (= (str.at z 4) "t") (not (= "<frameset oncopy=""alert(1)"" contenteditabalert(1)st</frameset>" (str.replace x "le>te" "alert(1)")))))
(assert (or (not (str.prefixof "<fra" y)) (not (= "alert(1)eset oncopy=""alert(1)"" contenteditable>test</frameset>" (str.replace x "<fram" "alert(1)"))) (not (= (str.at z 25) "<"))))
(check-sat)
