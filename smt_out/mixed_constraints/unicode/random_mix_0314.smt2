; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot onpaste=""alert(1)"" contenteditable>test</tfoot>") (= x "<datalist id=x tabindex=1 onfocus=alert(1)></datalist>")))
(assert (or (= z "bgsound id=x tabindex=1 onactivate=alert(1)></bgsound>") (= z "=""true"" ondragend=""alert(1)"">test</tfoot>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace x "o" "x") "tfxo")))
(assert (or (str.contains y "or=alert(") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\S)+[ ]?(\S)+[ ]?(\S)+$"))) (str.suffixof "t>" y)))
(assert (or (not (= "focus=" (str.substr y 28 6))) (not (str.contains x "=x ")) (not (= (str.at x 21) "("))))
(assert (or (= (str.indexof z "id=x " 0) 8) (not (= "<da""list id=x tabindex=1 onfocus=alert(1)></datalist>" (str.replace x "ta" """")))))
(assert (or (not (= "onf" (str.substr x 26 3))) (= (str.len x) 54)))
(assert (or (= (str.at z 23) "t") (= (str.indexof y "te=""" 0) 12)))
(check-sat)
