; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist oncontextmenu=""alert(1)"">test</datalist>") (= x "<dl onfocusout=alert(1) tabindex=1 id=x></dl><input autofocus>")))
(assert (or (= z "c=xx:x onerror=aler") (= z "ss>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ">" x) (not (str.prefixof "<datal" x)) (= (str.indexof x "pt:" 0) 51)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?!\s*$)[-a-zA-Z_.\s]{1,100}$"))) (not (str.prefixof "<dl on" x)) (not (= (str.len x) 52))))
(assert (or (not (str.contains z "ss>")) (str.in_re z ((_ re.from_regex ecma2020 u) "^([1-9]|[1-4]\d|50)$")) (not (<= (str.len y) 76))))
(assert (or (not (= (str.at x 13) "t")) (= (str.at z 0) "t")))
(assert (or (<= (str.len y) 70) (= "c=xx:x on ror=aler" (str.replace z "er" " ")) (= (str.at z 1) "=")))
(assert (not (str.prefixof "a" z)))
(check-sat)
