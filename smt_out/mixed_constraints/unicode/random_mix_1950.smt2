; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source draggable=""true"" ondrag=""alert(1)"">test</source>") (= x "<var onkeyup=""alert(1)"" contenteditable>test</var>")))
(assert (or (= z ".com/&quot;&gt;XSS&lt;/A&gt;") (= z "on-name:x"" onanimationend=""alert(1)""></pre>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "xtarea>" z)) (not (str.prefixof "<source dr" x))))
(assert (not (str.prefixof ".com/" z)))
(assert (= (str.at x 27) "."))
(assert (or (= "<xund SRC=""javascript:document.vulnerable=true;"">" (str.replace x "bgso" "x")) (not (str.suffixof "e>" z))))
(assert (not (str.contains x "ar>")))
(assert (or (= "<var onkex=""alert(1)"" contenteditable>test</var>.com/&quot;&gt;XSS&lt;/A&gt;" (str.replace y "yup" "x")) (= (str.at x 1) "v") (= (str.indexof x " onke" 0) 4)))
(assert (or (not (str.contains (str.replace y "t" " ") "ble="" ru")) (str.in_re y ((_ re.from_regex ecma2020 u) "^[6-9]{1}[0-9]{9}$"))))
(assert (>= (str.len z) 24))
(assert (= (str.indexof z "t" 0) 9))
(check-sat)
