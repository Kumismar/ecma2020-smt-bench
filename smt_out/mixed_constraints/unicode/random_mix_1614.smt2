; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<head onmousemove=""alert(1)"">test</head>") (= x "<link onclick=""alert(1)"">test</link>") (= x "<data id=x tabindex=1 onactivate=alert(1)></data>")))
(assert (or (= z "activate=alert(1)></param>") (= z "</audio>") (= z "ame:x"" onanimationstart=""alert(1)""></meter>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "i" 0) 2) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?:(?:31(\/|-|\.)(?:0?[13578]|1[02]))\1|(?:(?:29|30)(\/|-|\.)(?:0?[13-9]|1[0-2])\2))(?:(?:1[6-9]|[2-9]\d)?\d{2})$|^(?:29(\/|-|\.)0?2\3(?:(?:(?:1[6-9]|[2-9]\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))$|^(?:0?[1-9]|1\d|2[0-8])(\/|-|\.)(?:(?:0?[1-9])|(?:1[0-2]))\4(?:(?:1[6-9]|[2-9]\d)?\d{2})$"))) (not (= (str.at z 3) "i"))))
(assert (or (= "<head on" (str.substr x 0 8)) (str.suffixof "></param>" y)))
(assert (str.contains y "</"))
(assert (or (str.suffixof "io>" z) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{1,9}$")))))
(assert (not (str.prefixof "<link oncl" y)))
(assert (not (str.suffixof ">" z)))
(assert (or (= (str.indexof y "</" 0) 29) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[^0-9]+"))) (= (str.indexof x "rt(" 0) 36)))
(check-sat)
