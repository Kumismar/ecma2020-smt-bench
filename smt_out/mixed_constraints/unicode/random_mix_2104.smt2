; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form onfocusout=alert(1) tabindex=1 id=x></form><input autofocus>") (= x "<svg draggable=""true"" ondragleave=""alert(1)"">test</svg>") (= x "<div draggable=""true"" contenteditable>drag me</div><picture ondrop=alert(1) contenteditable>drop here</picture>")))
(assert (or (= z "/div><address ondrop=alert(1) contenteditable>drop here</address>") (= z " dur=1s>") (= z "tabindex=1 onfocusin=alert(1)></figcaption>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 82) "t")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9]{1})(\d{5,25})$"))) (not (str.contains x "></s"))))
(assert (or (not (= "<form onfoalert(1)usout=alert(1) tabindex=1 id=x></form><input autofocus>" (str.replace x "c" "alert(1)"))) (not (str.contains (str.replace z "i" "") "/l>")) (str.contains y "here</addr")))
(assert (= "ndrop=al" (str.substr z 15 8)))
(assert (not (str.suffixof "1s>" z)))
(assert (or (not (= (str.at y 3) "r")) (<= (str.len x) 61)))
(assert (not (= (str.len y) 83)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-\u{139}\u{13e}0-9. _-]{5,}$"))) (str.contains (str.replace x "1)""" "x") "(x>test")))
(check-sat)
