; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><code style=""animation-name:x"" onanimationend=""alert(1)""></code>") (= x "<img draggable=""true"" ondragend=""alert(1)"">test</img>")))
(assert (or (= z "ct style=""animation-name:x"" onanimationend=""alert(1)""></select>") (= z "focus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "d=""alert") (str.prefixof "<style>@" x) (str.contains x """tr")))
(assert (or (= (str.indexof z "s" 0) 4) (not (= (str.at y 21) "<")) (= (str.indexof y "matio" 0) 45)))
(assert (or (= "@key" (str.substr x 7 4)) (not (str.contains (str.replace y "tes" """") """>""t<")) (= (str.indexof y "img " 0) 1)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?:(?:31(-|\/)(?:0?[13578]|1[02]))\1|(?:(?:29|30)(-|\/)(?:0?[1,3-9]|1[0-2])\2))(?:(?:1[6-9]|[2-9]\d)?\d{2})$|^(?:29(-|\/)0?2\3(?:(?:(?:1[6-9]|[2-9]\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))$|^(?:0?[1-9]|1\d|2[0-8])(-|\/)(?:(?:0?[1-9])|(?:1[0-2]))\4(?:(?:1[6-9]|[2-9]\d)?\d{2})$"))))
(assert (not (= (str.at x 76) "a")))
(assert (not (<= (str.len y) 126)))
(assert (not (str.contains y "d=""alert")))
(check-sat)
