; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><nobr id=x style=""transition:color 1s"" ontransitionend=alert(1)></nobr>") (= x "<a id=""x""><rect fill=""white"" width=""1000"" height=""1000""/></a>") (= x "&lt;FRAMESET&gt;&lt;FRAME SRC=&quot;javascript:alert(&apos;XSS&apos;);&quot;&gt;&lt;/FRAMESET&gt;")))
(assert (or (= z "d>") (= z "leave=""alert(1)"">test</\u{1f600}thead>") (= z "ure>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "t(1)" 0) 94) (not (= "<a id=""x""><rect fill=""white"" width=""1000eight=""1000""/></a>" (str.replace x """ h" "")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((\+|00)33\s?|0)[1-9](\s?\d{2}){4}$"))) (not (str.suffixof "</a>" x))))
(assert (or (not (= "org/s" (str.substr z 7 5))) (str.contains z "st</\u{1f600}") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^@]+@[^@]+\.[a-zA-Z]{2,6}|^\(?([0-9]{3})\)?[-. ]?([0-9]{3})[-. ]?([0-9]{4})")))))
(assert (or (not (str.contains (str.replace y "fill" "<b>") "t <b>=""w")) (str.in_re x ((_ re.from_regex ecma2020 u) "^([-0-9]){8,}$")) (not (= (str.indexof z "r" 0) 1))))
(assert (str.contains z "test</\u{1f600}"))
(check-sat)
