; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tr \u{10348}onfocusout=alert(1) tabindex=1 id=x></tr><input autofocus>") (= x "<optgroup onkeypress=""alert(1)"" contenteditable>test</optgroup>") (= x "<base HREF=""javascript:document.vulnerable=true;//"">")))
(assert (or (= z "st</basefont>") (= z "))</SCRIPT>") (= z """alert(1)"">test</ul>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 15) "=")) (not (= "<base HREF=""javascript:document.vulnerxle=true;//"">st</basefont>" (str.replace y "ab" "x")))))
(assert (or (= (str.indexof x ":docu" 0) 22) (not (= (str.indexof x " au" 0) 52)) (str.contains x "t(1)"">t")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[+]?[\s./0-9]*[(]?[0-9]{1,4}[)]?[-\s./0-9]*$"))) (= (str.at y 63) """")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "7$"))))
(assert (or (not (= (str.indexof y "au" 0) 53)) (not (str.contains z "(1)"">tes")) (not (= "di" (str.substr x 39 2)))))
(assert (not (str.prefixof "<o" x)))
(assert (or (= (str.at x 3) "s") (not (str.suffixof "T>" y)) (not (str.suffixof "/ul>" y))))
(check-sat)
