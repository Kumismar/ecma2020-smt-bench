; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike onmouseout=""alert(1)"">test</strike>") (= x "<kbd id=x tabindex=1 onfocus=alert(1)></kbd>")))
(assert (or (= z "ert(1)></rtc>") (= z "orm id=x tabindex=1 onfocusin=alert(1)></form>")))
(assert (= y (str.++ x z)))
(assert (or (= "<""trike onmouseout=""alert(1)"">test</strike>" (str.replace x "s" """")) (str.suffixof "ck>" x)))
(assert (not (str.suffixof "1)></kbd>" x)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z\s]|[\u{e0}-\u{fa}]|[\u{c0}-\u{da}])+$")) (str.suffixof "/form>" y) (not (= (str.at x 7) " "))))
(assert (str.prefixof "<stri" x))
(assert (or (not (str.prefixof "<kbd i" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^0-9]+$")))))
(assert (= (str.indexof x "t=" 0) 17))
(check-sat)
