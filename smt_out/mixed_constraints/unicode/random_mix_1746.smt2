; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><tt id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tt>") (= x "<style>:target {color: red;}</style><optgroup id=x style=""transition:color 10s"" ontransitioncancel=ale\u{1f4a9}rt(1)></optgroup>")))
(assert (or (= z "test</a>") (= z "\u{20000}c;") (= z "rt(1)"">test</wbr>")))
(assert (= y (str.++ x z)))
(assert (not (= "<style>:tar""et {color: red;}</style><tt id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tt>test</a>" (str.replace y "g" """"))))
(assert (str.contains y "lor: "))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[789]\d{9,9}$"))))
(assert (= (str.indexof z "\u{20000}c" 0) 0))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\u{5c}u0026\u{5c}u003C\u{b1}!@\u{a3}$%^*_+\u{a7}\u{a1}\u{20ac}#\u{a2}\u{a7}\u{b6}\u{2022}\u{aa}\u{ba}\u{ab}\\/>?:;|=,\d]+$"))))
(assert (str.suffixof ">" z))
(assert (or (str.suffixof "\u{20000}c;" z) (not (str.contains (str.replace z "\u{20000}c;" " ") " ")) (not (str.contains (str.replace z "1)""" "javascript:") "rt(javascript:>t"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?:((?:0[1-9]|1[0-9]|2[0-9])\/(?:0[1-9]|1[0-2])|(?:30)\/(?!02)(?:0[1-9]|1[0-2])|31\/(?:0[13578]|1[02]))\/(?:19|20)[0-9]{2})"))) (not (str.prefixof "<style>:ta" x))))
(check-sat)
