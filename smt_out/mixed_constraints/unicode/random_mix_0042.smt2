; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed onbeforecopy=""alert(1)"" contenteditable>test</noembed>") (= x "<ul ondblclick=""alert(1)"">test</ul>") (= x "<q draggable=""true"" ondragend=""alert(1)"">test</q>")))
(assert (or (= z "d=x tabindex=1 onfocusin=alert(1)></s>") (= z "alert(1)"">test</ruby>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 73) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[a-z0-9.-]+.[a-z]{2,}$")))))
(assert (or (not (str.contains z "er")) (str.suffixof ")></s>" z)))
(assert (or (str.contains z "rt(1") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\/]{1,50}$"))) (str.contains x """a")))
(assert (= (str.indexof x "lick" 0) 10))
(check-sat)
