; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas onpaste=""alert(1)"" contenteditable>test</canvas>") (= x "<xmp onbeforecut=""alert(1)"" contenteditable>test</xmp>") (= x "<area onmousemove=""alert(1)"">test</area>")))
(assert (or (= z "eset onbeforepaste=""alert(1)"" contenteditable>test</frameset>") (= z "svg onpaste=""alert(1)"" conten\u{20000}teditable>test</svg>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-F][0-9]{3}"))) (not (str.prefixof "<area " y))))
(assert (or (not (= "<iframe style=""xg-p:absolute;top:0;left""idth:100%;height:100%"" onmouseover=""prompt(1)"">" (str.replace x ":0;w" """"))) (str.suffixof "test</svg>" z) (= "svg onpaste=""alert(1alert(1)nten\u{20000}teditable>test</svg>" (str.replace z ")"" co" "alert(1)"))))
(assert (or (not (= (str.at z 20) "a")) (not (= (str.indexof y "set o" 0) 41)) (str.prefixof "ame" z)))
(assert (str.prefixof "<are" x))
(check-sat)
