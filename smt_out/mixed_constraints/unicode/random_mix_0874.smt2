; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><figure ondrop=alert(1) contenteditable>drop here</figure>") (= x "<thead draggable=""true"" ondragenter=""alert(1)"">test</thead>") (= x "<script SRC=""http://www.securitycompass.com/xss.jpg""></script>")))
(assert (or (= z "e>drag me</div><listing ondrop=alert(1) contenteditable>drop here</listing>") (= z "keygen>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "e>" x)) (str.contains z "</") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{4}\s\d{4}\s\d{4}$")))))
(assert (or (= (str.indexof x "ragga" 0) 8) (not (= (str.at z 21) "n"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z\-' ]{2,}")) (not (str.prefixof "<div dragg" y))))
(assert (str.prefixof "<div" x))
(assert (or (<= (str.len x) 65) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\w([.-]\w+)?)+@\w+(\.[a-z]{2,})+$")))))
(assert (or (str.contains y "co") (not (= "e" (str.substr z 1 1)))))
(assert (str.contains x "ure ondro"))
(assert (or (not (= (str.at z 70) "i")) (<= (str.len z) 7)))
(check-sat)
