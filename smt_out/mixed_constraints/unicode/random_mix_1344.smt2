; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside onbeforepaste=""alert(1)"" contenteditable>test</aside>") (= x "&lt;SCRIPT&gt;a=/XSS/") (= x "<q onmouseup=""alert(1)"">test</q>")))
(assert (or (= z "strike>") (= z ">test</sup>") (= z "f1cscript%uff1ealert('XSS')%uff1c/script%uff1e'")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "aler")) (not (str.suffixof "XSS/" x))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9]\d*$"))) (str.contains y "/aside>")))
(assert (or (not (= "cscript%uf" (str.substr z 2 10))) (not (str.prefixof "<aside onb" y)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z ]{2,250}$")))))
(assert (or (not (= (str.len x) 60)) (not (= (str.indexof x "befor" 0) 8)) (= (str.at x 32) "c")))
(assert (or (not (str.prefixof "<q onmou" y)) (not (= """t" (str.substr x 15 2))) (str.contains z "</sup>")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[-0-9-]+"))) (= "lert" (str.substr x 15 4))))
(check-sat)
