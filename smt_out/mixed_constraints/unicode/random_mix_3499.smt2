; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre draggable=""true"" ondragend=""alert(1)"">test</pre>") (= x "<main draggable=""true"" ondragstart=""alert(1)"">test</main>") (= x "<style>:target {color: red;}</style><ruby id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></ruby>")))
(assert (or (= z "gleave=""alert(1)"">test</dd>") (= z "wn=""alert(1)"" contenteditable>test</listing>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<pre dragga true"" ondragend=""alert(1)"">test</pre>" (str.replace x "ble=""" " "))) (not (str.contains y "red;}</sty")) (not (= (str.at z 18) "t"))))
(assert (or (str.contains (str.replace x "/mai" """") "est<""n>") (= (str.at y 21) """") (not (str.contains x "rue"" ondr"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-9]\d{7,9}$"))))
(assert (or (not (str.contains (str.replace y "d=x" " ") "i  sty")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{16}$")))))
(assert (or (not (str.suffixof "ting>" z)) (not (str.prefixof "<m" x)) (not (str.contains x "ol"))))
(assert (or (not (>= (str.len x) 57)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,14}$")))))
(check-sat)
