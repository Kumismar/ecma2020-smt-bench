; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt onblur=alert(1) tabindex=1 id=x></dt><input autofocus>") (= x "<tfoot id=x tabindex=1 onfocusin=alert(1)></tfoot>") (= x "<script\x0Atype=""text/javascript"">javascript:alert(1);</script>")))
(assert (or (= z "r>") (= z "nimation-name:x"" onanimationstart=""alert(1)""></dir>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^\D*1(.*\d.*){10,}|^\D*[0,2-9](.*\d.*){9,}")) (not (= (str.len z) 2))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9]\d{5}[1-9]\d{3}((0\d)|(1[0-2]))(([0|1|2]\d)|3[0-1])\d{4}$"))))
(assert (not (str.contains (str.replace x "in=" "alert(1)") "ocusalert(1)alert")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "(.){3,}")) (= (str.len y) 60)))
(assert (or (not (= "t(" (str.substr z 39 2))) (not (= "rt(1);</s" (str.substr x 48 9)))))
(assert (or (not (str.contains (str.replace y "(1)"">" "alert(1)") "lertalert(1)</d")) (= (str.indexof x "ale" 0) 97) (str.contains (str.replace y """" " ") "e:x  on")))
(assert (not (= (str.len y) 114)))
(check-sat)
