; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><textarea id=x style=""transition:transform 2s"" ontransitionrun=alert(1)><\u{10348}/textarea>") (= x "<iframe id=x tabindex=1 onbeforedeactivate=alert(1)></iframe><input autofocus>")))
(assert (or (= z "code onmouseup=""alert(1)"">test</code>") (= z "script>") (= z "tbody>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace z "tbod" " ") " y>"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(.*\d.*){10,}"))) (str.suffixof ")></map>" x)))
(assert (or (not (= "ivat" (str.substr x 37 4))) (not (= ">" (str.substr z 5 7))) (= (str.indexof z "code>" 0) 32)))
(assert (str.prefixof "<iframe id" x))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9$&+,:;=?@#|'<>.^*()%!-_]+(?: +[A-Za-z0-9$&+,:;=?@#|'<>.^*()%!-_]+)*$"))) (str.contains (str.replace y "yl" "x") "<stxe>:ta") (not (= "ed><in""t autofocus>" (str.replace z "pu" """")))))
(assert (not (str.suffixof ">" z)))
(assert (or (not (= (str.at x 64) "p")) (= "me><" (str.substr x 58 4))))
(assert (or (str.contains z "body>") (not (str.prefixof "<object o" x))))
(check-sat)
