; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody onkeydown=""alert(1)"" contenteditable>test</tbody>") (= x "<xmp id=x tabindex=1 onbeforedeactivate=alert(1)></xmp><input autofocus>")))
(assert (or (= z "=alert(1) contenteditable>drop here</spacer>") (= z "ert(1)"" contenteditable>test</frame>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 36) "d")) (str.suffixof "ofocus>" x)))
(assert (or (= (str.at x 45) "e") (not (str.in_re x ((_ re.from_regex ecma2020 u) "(0[1-9]|1[0-2])/(0[1-9]|[12]\d|3[01])/[0-9]{4}"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z|A-Z|0-9|!,.?]{6,15}")))))
(assert (or (>= (str.len y) 100) (not (str.prefixof "ert(1)"" " z))))
(assert (or (not (= "pa" (str.substr z 38 2))) (not (= (str.at z 35) "<"))))
(assert (or (not (str.suffixof "dt>" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{30a1}-\u{30f3}|\u{30fc}]+$")))))
(check-sat)
