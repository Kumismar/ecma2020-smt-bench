; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;OBJECT TYPE=\""text/x-scriptlet\"" DATA=\""http&#58;//ha&#46;ckers&#46;org/scriptlet&#46;html\""&gt;&lt;/OBJECT&gt;") (= x "<blink id=x tabindex=1 ondeactivate=alert(1)></blink><input id=y autofocus>") (= x "<xmp onbeforecopy=""alert(1)"" contenteditable>test</xmp>")))
(assert (or (= z " rotate(180deg);}</style><tt id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tt>") (= z "nk><input autofocus>") (= z "1)"">test</acronym>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y " " """") "mp""o")) (= (str.indexof y "=ale" 0) 35) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9\.]+$")))))
(assert (not (str.contains z "dow><inpu")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9-_!*]{3,20}")) (= "ion:tr" (str.substr z 14 6))))
(assert (or (str.suffixof "us>" x) (= (str.indexof y "d=x t" 0) 8)))
(assert (or (str.prefixof "&lt;OBJEC" y) (= "nput au" (str.substr z 5 7)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "((\+\d{1,3}(-|.| )?\(?\d\)?(-| |.)?\d{1,5})|(\(?\d{2,6}\)?))(-|.| )?(\d{3,4})(-|.| )?(\d{4})(( x| ext)\d{1,5}){0,1}$")))))
(assert (not (str.prefixof "n" z)))
(assert (str.contains x "drop "))
(check-sat)
