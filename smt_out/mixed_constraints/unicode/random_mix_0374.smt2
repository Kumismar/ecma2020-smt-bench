; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><frame ondrop=alert(1) contenteditable>drop here</frame>") (= x "<menuitem oncut=""alert(1)"" contenteditable>test</menuitem>") (= x "<TABLE BACKGROUND=""javascript:javascript:alert(1)"">")))
(assert (or (= z "ve=""alert(1)"">test</th>") (= z "e=""true"" ondragstart=""alert(1)"">test</footer>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "footer>" z) (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s]{1,50})$"))))
(assert (or (str.contains y "cut=""") (not (str.contains (str.replace y """" "alert(1)") "ncut=alert(1)a"))))
(assert (or (not (str.contains z "ert(1)"">te")) (= (str.len x) 58)))
(assert (or (>= (str.len x) 55) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,6}$"))) (= "<menuitem oncut=""axert(1)"" contenteditable>test</menuitem>e=""true"" ondragstart=""alert(1)"">test</footer>" (str.replace y "l" "x"))))
(assert (or (not (= "eue"" ondragstart=""alert(1)"">test</footer>" (str.replace z "=""tr" ""))) (str.suffixof "test</th>" y)))
(check-sat)
