; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<button onbeforecopy=""\u{1d400}alert(1)"" contenteditable>test</button>") (= x "<title onbeforecut=""alert(1)"" contenteditable>test</title>") (= x "<div draggable=""true"" contenteditable>drag me</div><style ondrop=alert(1) contenteditable>drop here</style>")))
(assert (or (= z "e>:target {color:red;}</style><footer id=x style=""transition:color 1s"" ontransitionend=alert(1)></footer>") (= z "{}</style><listing style=""animation-name:x"" onanimationend=""alert(1)""></listing>") (= z "onmouseover=""alert(1)"">test</rt>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9+-/()\s]{8,15}"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z]{5,5}")) (= (str.at z 29) "r")))
(assert (or (not (= "e" (str.substr z 8 1))) (str.contains z "d;}</s") (str.contains z "listi")))
(assert (or (not (str.contains y "nend=")) (str.prefixof "e>:" z) (= (str.indexof y "ented" 0) 26)))
(check-sat)
