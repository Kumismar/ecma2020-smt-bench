; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<listing onclick=""alert(1)"">test</listing>") (= x "<samp oncontextmenu=""alert(1)"">test</samp>") (= x "<nobr onkeyup=""alert(1)"" contenteditable>test</nobr>")))
(assert (or (= z "useOver=""javascript:javascript:alert(1)""></body onMouseOver>") (= z "id=x tabindex=1 onbeforeactivate=alert(1)></dl>") (= z ">test</menu>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len x) 45) (str.contains (str.replace z "le>t" " ") "ditab est</")))
(assert (or (str.suffixof "st</\u{20000}br>\u{10348}" y) (not (= (str.at z 0) ">")) (str.contains z "/body onM")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z-_ ]{2,40}$"))) (not (= (str.at y 17) """"))))
(assert (= (str.indexof x "on" 0) 6))
(assert (not (str.suffixof "</hr>" x)))
(check-sat)
