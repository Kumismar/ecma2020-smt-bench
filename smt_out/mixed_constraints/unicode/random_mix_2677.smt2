; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onmous\u{20000}eover=""alert(1)"">t\u{20000}est</html>") (= x "<nobr oncut=""alert(1)"" contented\u{10348}itable>test\u{1f600}</nobr>")))
(assert (or (= z "aste=""ale\u{1d400}rt(1)"" contenteditable>test</dir>") (= z "e onmouseleave=""alert(1)"">test</style>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "ontente")) (str.prefixof "<nobr onc" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9\+]+$"))) (not (>= (str.len y) 75))))
(assert (or (not (= (str.at x 7) "(")) (not (= (str.at z 34) "y")) (not (= "<html onmous\u{20000}eover=""alert(1)"">xest</html>" (str.replace x "t\u{20000}" "x")))))
(assert (not (str.suffixof "test</dir>" y)))
(check-sat)
