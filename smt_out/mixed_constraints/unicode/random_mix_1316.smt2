; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote ondblclick=""alert(1)"">test</blockquote>") (= x "<big draggable=""true"" ondrag=""alert(1)"">test</big>") (= x "<div id=""95""><svg xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"">")))
(assert (or (= z "e=""true"" ondragleave=""alert(1)"">test</center>") (= z "</caption>") (= z "eg);}</style><source id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></source>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "([a-z]|[A-Z]|[\u{c0}\u{c2}\u{c4}\u{c7}\u{c9}\u{c8}\u{ca}\u{cb}\u{ce}\u{cf}\u{d4}\u{d6}\u{d9}\u{db}\u{dc}\u{178}\u{e0}\u{e2}\u{e4}\u{e7}\u{e9}\u{e8}\u{ea}\u{eb}\u{ee}\u{ef}\u{f4}\u{f6}\u{f9}\u{fb}\u{fc}\u{ff}\u{c6}\u{152}\u{e6}\u{153} '-])*"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((?!gmail)(?!yahoo)(?!outlook)(?!hotmail).)*$")))))
(assert (not (= "<bxuote ondblclick=""alert(1)"">test</blockquote>" (str.replace x "lockq" "x"))))
(assert (or (not (str.suffixof "/source>" y)) (not (str.contains y "alert(1)"">"))))
(assert (or (= "<valert(1)deo autoplay controls onseeking=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>" (str.replace x "i" "alert(1)")) (not (= (str.indexof x "sv" 0) 14))))
(assert (or (str.contains x "</blo") (not (str.in_re z ((_ re.from_regex ecma2020 u) "[\d]{1,63}")))))
(check-sat)
