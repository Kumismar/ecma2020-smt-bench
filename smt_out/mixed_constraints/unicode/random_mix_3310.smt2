; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element onbeforepaste=""alert(1)"" contenteditable>test</element>") (= x "<style>:target {color:red;}</style><col id=x style=""transition:color 1s"" ontransitionend=alert(1)></col>")))
(assert (or (= z ") tabindex=1 id=x></abbr><input autofocus>") (= z "ticle onmouseover=""alert(1)"">test</article>") (= z "ctivate=alert(1)></div>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "col>" "javascript:") ")></javascript:") (= "est</eleme" (str.substr x 51 10))))
(assert (not (= "<basefont onclick=""alert(1)"">test</basefont>e>@import ""data:,*%7bx:expression(javascript:alert(1)javascript:D"";</style>" (str.replace y ")%7" "javascript:"))))
(assert (not (<= (str.len z) 47)))
(assert (not (str.contains y ")"" content")))
(assert (not (= "onmous" (str.substr z 6 6))))
(assert (or (not (str.contains z "><input a")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(\d{5}([\-]\d{4})?)$")))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "[789]\d{9}$")))
(check-sat)
