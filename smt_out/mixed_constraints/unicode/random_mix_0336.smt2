; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame oncontextmenu=""alert(1)"">test</frame>") (= x "<IMG SRC=javascript:alert('XSS')>")))
(assert (or (= z "and>") (= z "ADEAKQ&ACAAPABi")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace z ">" "alert(1)") "andalert(1)"))
(assert (or (not (= (str.indexof y "Q&ACA" 0) 38)) (>= (str.len z) 4) (str.suffixof "and>" y)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-9]+\.?[0-9]*")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{2}[0-9]{4,6}[0-9]{3,4}$")))))
(assert (or (not (= (str.indexof x "rt('" 0) 23)) (not (<= (str.len y) 91))))
(check-sat)
