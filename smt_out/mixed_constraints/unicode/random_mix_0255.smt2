; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby onmouseleave=""alert(1)"">test</ruby>") (= x "<? echo('<SCR)';") (= x "<dd onblur=alert(1) tabindex=1 id=x></dd><input autofocus>")))
(assert (or (= z "t(1)</script>") (= z "XML SRC=&quot;http://ha.ckers.org/xsstest.xml&quot; ID=I&gt;&lt;/XML&gt;") (= z "usemove=""alert(1)"">test</section>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "s""></OBJE")) (not (str.contains z ".ckers."))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9.]{1,3}"))) (str.suffixof "n>" x)))
(assert (or (>= (str.len z) 24) (not (= "1)"">test</" (str.substr z 15 10)))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[ECIOS]-[A-Z0-9]{13,15}$"))))
(assert (not (str.contains z "use")))
(assert (or (not (= ".js?<B>g" (str.substr y 35 8))) (not (= "alert(1)" (str.substr x 11 8)))))
(assert (not (<= (str.len y) 97)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z ]+$")) (= (str.at x 1) "?")))
(check-sat)
