; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\xE1\xA0\x8Ejavascript:alert(1)</script>") (= x "<div draggable=""true"" contenteditable>drag me</div><abbr ondragover=alert(1) contenteditable>drop here</abbr>") (= x "<keygen oncut=""alert(1)"" contenteditable>test</keygen>")))
(assert (or (= z "agend=""alert(1)"">test</sup>") (= z " onselect=""alert(String.fromCharCode(88,83,83))"">") (= z "d=x tabindex=1 ondeactivate=alert(1)></meter><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace x "onte" "x") "cxnt"))
(assert (or (not (= "t:alert(1)" (str.substr y 162 10))) (str.prefixof "ABC<" x)))
(assert (or (not (= (str.indexof x "gable" 0) 9)) (not (= (str.indexof z ">" 0) 0)) (= (str.at y 129) "t")))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^([0-9]{2})-([0-9]{2})-([0-9]{4})$")))
(assert (or (= (str.len y) 121) (not (str.contains z "onsel")) (str.prefixof "<" y)))
(check-sat)
