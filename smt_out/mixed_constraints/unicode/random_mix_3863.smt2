; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<code onkeydown=""alert(1)"" contenteditable>test</code>") (= x "<basefont onmouseup=""alert(1)"">test</basefont>") (= x "<div draggable=""true"" contenteditable>drag me</div><strong ondrop=alert(1) contenteditable>drop here</strong>")))
(assert (or (= z "onerror=""javascript:alert(1)"">") (= z "dio ondblclick=""alert(1)"">test</audio>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z_-]{3,}$"))))
(assert (or (not (= (str.indexof z "ro" 0) 4)) (str.suffixof "</time>" z)))
(assert (or (str.contains y "de>") (= (str.indexof y "rt(1" 0) 35) (= "nted" (str.substr x 32 4))))
(assert (or (not (= "st</r" (str.substr x 28 5))) (not (<= (str.len y) 153))))
(assert (str.suffixof "/strong>" x))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((?=.*[0-9a-zA-Z])([a-zA-Z0-9@`~!#$%^&*()-=_+|{}\[\]|\\:;\u{5c}u0022',.<>/?]+)){8,}$"))))
(assert (or (not (str.contains z "blclick=")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z A-Z 0-9 \- ' / . &]{2,80}$"))) (not (str.suffixof "g>" x))))
(assert (or (<= (str.len z) 30) (not (str.prefixof "<code onk" x))))
(check-sat)
