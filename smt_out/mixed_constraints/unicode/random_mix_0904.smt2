; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp onmousedown=""alert(1)"">test</rp>") (= x "&lt;!--[if gt\u{20000}e IE 4]&gt;") (= x "<audio oncanplay=alert(1)><source src=""validaudio.wav"" type=""audio/wav""></audio>")))
(assert (or (= z "t(1)"">test</progress>") (= z "able ondragover=alert(1) contenteditable>drop here</table>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*[A-Za-z])[A-Za-z\s\.]*")) (= "over=ale" (str.substr z 11 8))))
(assert (or (str.suffixof "</table>" z) (not (str.prefixof "&" y)) (= "onmous" (str.substr x 4 6))))
(assert (or (= (str.len z) 21) (not (= (str.at x 48) "o"))))
(assert (not (= (str.at x 7) "t")))
(assert (str.contains (str.replace x "f" "<b>") "i<b> "))
(assert (not (>= (str.len x) 35)))
(assert (or (not (str.prefixof "t(1)" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^#[ec][0-9]+$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z0-9]+([._\\-]*[a-z0-9])*@([a-z0-9]+[-a-z0-9]*[a-z0-9]+.){1,63}[a-z0-9]+$"))) (str.contains y ">test") (not (= (str.indexof z "re" 0) 16))))
(check-sat)
