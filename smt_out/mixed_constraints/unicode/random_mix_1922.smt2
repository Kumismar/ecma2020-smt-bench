; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\&\u{1f600}quot;;\u{1d400}alert(&apos;XSS&apos;);//") (= x "<sup onkeydown=""alert(1)"" contenteditable>test</sup>")))
(assert (or (= z "applet>") (= z "1)></noscript>") (= z "st</output>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))) (not (<= (str.len z) 47)) (not (= (str.at x 7) ";"))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9-&)(:/' ]*$")))
(assert (or (= "\&\u{1f600}quot;;\u{1d400}ale<b>apos;XSS&apos;);//st</output>" (str.replace y "rt(&" "<b>")) (str.contains (str.replace z "outp" "<b>") "t</<b>ut>") (not (str.in_re z ((_ re.from_regex ecma2020 u) "[--A-Za-z0-9.@]{2,90}")))))
(assert (str.suffixof "s;);//" x))
(check-sat)
