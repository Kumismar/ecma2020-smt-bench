; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form><a href=""javascript:\u{5c}u0061lert&#x28;1&#x29;"">X</script><img/*/src=""worksinchrome&colon;prompt&#x28;1&#x29;""/*/onerror='eval(src)'>") (= x "<source onmouseup=""alert(1)"">test</source>")))
(assert (or (= z """></script>") (= z """>test</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^([0|\+[0-9]{1,5})?([1-9][0-9]{4})$")) (str.suffixof "est</dfn>" z) (not (>= (str.len z) 10))))
(assert (or (= "<form><a href=""javascript:\u{5c}u0061lert&#x28;1 ;"">X</script><img/*/src=""worksinchrome&colon;prompt&#x28;1&#x29;""/*/onerror='eval(src)'>"">test</dfn>" (str.replace y "&#x29" " ")) (= "sinchrome" (str.substr y 77 9)) (str.prefixof "tedita" z)))
(assert (not (>= (str.len z) 9)))
(assert (or (not (str.contains x "u0061ler")) (not (str.contains (str.replace x "x28;1" "<b>") "t&#<b>&#x2"))))
(assert (str.suffixof "/script>" z))
(assert (or (str.prefixof "<" y) (str.prefixof "<source " x)))
(assert (= (str.indexof x "onmo" 0) 8))
(assert (or (not (str.suffixof "'>" x)) (not (str.contains y "n;pr"))))
(check-sat)
