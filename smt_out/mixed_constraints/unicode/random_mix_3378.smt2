; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><ol ondragover=alert(1) contenteditable>drop here</ol>") (= x "<style>@keyframes x{}</style><datalist style=""animation-name:x"" onanimationend=""alert(1)""></datalist>")))
(assert (or (= z "t(1)"">test</element>") (= z ">><marquee><h1>XSS by xss</h1></marquee>")))
(assert (= y (str.++ x z)))
(assert (= (str.len y) 145))
(assert (or (not (= (str.indexof x "l" 0) 9)) (= (str.at y 14) "a") (not (= "ent>" (str.substr z 16 10)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^0[0-9]{9}$"))) (= (str.indexof x "(" 0) 71) (not (= (str.len x) 101))))
(assert (not (str.contains (str.replace z "s</h1" "alert(1)") "y xsalert(1)><")))
(assert (or (str.suffixof ">" y) (not (= (str.indexof z "</el" 0) 10))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*[a-zA-Z])[A-Za-z0-9]{4,64}$")))
(assert (str.prefixof "<div dr" y))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z\u{c4}\u{d6}\u{dc}\-]+(\s*[A-Za-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}.-]+)*$"))) (not (str.prefixof "<style>@" y))))
(check-sat)
