; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<big id=x tabindex=1 onbeforeactivate=alert(1)></big>") (= x "\x3Cscript>javascript:alert(1)</script>") (= x "<sup draggable=""true"" ondragstart=""alert(1)"">test</sup>")))
(assert (or (= z "le=""true"" ondragend=""alert(1)"">test</link>") (= z "d=x tabindex=1 onfocusin=alert(1)></b>") (= z "=""alert(1)"">test</listing>")))
(assert (= y (str.++ x z)))
(assert (or (= "in=alert(1" (str.substr y 77 10)) (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z0-9_.-]{1,}@[a-z0-9_]{2,}(.[a-z0-9_]{2,}){1,}$")) (str.prefixof "<sup" y)))
(assert (str.suffixof "b>" z))
(assert (not (= (str.at x 37) "=")))
(assert (str.contains (str.replace z "rt(1" "x") "lex)"))
(assert (or (str.contains (str.replace x "sup>" "javascript:") "/javascript:") (not (= (str.at x 26) "a"))))
(check-sat)
