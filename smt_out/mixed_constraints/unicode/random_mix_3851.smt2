; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<r\u{20000}t id=x tabindex=1 onactivate=alert(1)></rt>") (= x "<m\u{10348}ark onm\u{1f600}ouseover=""alert(1)"">test</mark>") (= x "<picture onbeforecopy=""alert(1)"" contenteditable>test</picture>")))
(assert (or (= z "height=""1000"" fill=""white""/></a>") (= z "ble=""true"" ondragend=""alert(1)"">test</rtc>") (= z "onkeydown=""alert(1)"" contenteditable>test</ol>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "C\d{8}"))) (not (= "ble""""true"" ondragend=""alert(1)"">test</rtc>" (str.replace z "=" """"))) (= (str.indexof y "ecopy" 0) 16)))
(assert (or (not (str.suffixof "est</rtc>" y)) (str.in_re x ((_ re.from_regex ecma2020 u) "[\u{6f0}\u{661}\u{662}\u{663}\u{6f4}\u{6f5}\u{6f6}\u{6f7}\u{6f8}\u{6f9}]{9}")) (str.contains z "(1)""")))
(assert (or (= (str.len y) 59) (not (= (str.at x 51) "u"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z\u{410}\u{411}\u{412}\u{413}\u{414}\u{415}\u{416}\u{417}\u{418}\u{419}\u{41a}\u{41b}\u{41c}\u{41d}\u{41e}\u{41f}\u{420}\u{421}\u{422}\u{423}\u{424}\u{425}\u{426}\u{428}\u{429}\u{42a}\u{42b}\u{42c}\u{42d}\u{42e}\u{42f}\u{430}\u{431}\u{432}\u{433}\u{434}\u{435}\u{436}\u{437}\u{438}\u{439}\u{43a}\u{43b}\u{43c}\u{43d}\u{43e}\u{43f}\u{440}\u{441}\u{442}\u{443}\u{444}\u{445}\u{446}\u{448}\u{449}\u{44a}\u{44b}\u{44c}\u{44d}\u{44e}\u{44f}]*$"))) (str.contains z "white""/></") (str.suffixof "'XSS');"">" x)))
(assert (= (str.indexof z "ab" 0) 32))
(assert (or (not (= (str.indexof z "ill=" 0) 15)) (not (str.contains z "ill=""whi")) (= (str.at y 66) "g")))
(check-sat)
