; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr onblur=alert(1) tabindex=1 id=x></hr><input autofocus>") (= x "<data id=x tabindex=1 onactivate=alert(1)></data>") (= x "<code draggable=""true"" ondragend=""alert(1)"">test</code>")))
(assert (or (= z "t</center>") (= z "t(1)"" contenteditable>test</center>") (= z """alert(1)""\u{1f600}>test\u{1f600}</object>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "\d+[\w\s]*")) (= "<hr onbluralert(1)rt(1) tabindex=1 id=x></hr><input autofocus>" (str.replace x "=ale" "alert(1)"))))
(assert (or (not (= """a(1)""\u{1f600}>test\u{1f600}</object>" (str.replace z "lert" ""))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "alpha-num-hyphen"))) (not (str.suffixof "ct>" y))))
(assert (or (not (str.suffixof "r>" y)) (= " draggable" (str.substr x 5 10))))
(assert (not (str.suffixof "bject>" y)))
(assert (or (not (= (str.len z) 26)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(https?:\/\/)?(www.)?[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_\+.~#?&//=]{0,128})$"))) (not (>= (str.len y) 90))))
(assert (or (not (= (str.len z) 10)) (not (= (str.indexof x "i" 0) 6))))
(check-sat)
