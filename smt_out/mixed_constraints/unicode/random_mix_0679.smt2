; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><em id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></em>") (= x "<svg><element onload=alert(1)></element>") (= x "&lt;META HTTP-EQUIV=&quot;Set-Cookie&quot; Content=&quot;USERID=&lt;SCRIPT&gt;alert(&apos;XSS&apos;)&lt;/SCRIPT&gt;&quot;&gt;")))
(assert (or (= z "ata>") (= z "tenteditable>test</tbody>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\s?[^\s,]+@[^\s,]+\.[^\s,]+\s?,)*(\s?[^\s,]+@[^\s,]+\.[^\s,]+)$"))) (= (str.indexof y "sform" 0) 20) (not (str.prefixof "<svg" y))))
(assert (or (str.prefixof "<svg" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([\w.-]+)@(\[(\d{1,3}\.){3}|(?!live\.fr|mail\.ru|hotmail\.fr|arcor\.de|inbox\.ru|yams08|eric\.jones|abdulah\.xyz)(([a-zA-Z\d-]+\.)+))([a-zA-Z]{2,4}|\d{1,3})(\]?)$"))) (not (= "ERID=&" (str.substr y 59 6)))))
(assert (<= (str.len x) 134))
(assert (or (not (str.contains (str.replace z "ata>" """") """")) (not (str.suffixof "\u{1f600}shadow>" y))))
(check-sat)
