; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<!-- injection --><svg height=""50px"">") (= x ">>> vectors()")))
(assert (or (= z "nclick=""alert(1)"">test</col>") (= z "![><img src=""]><img src=x onerror=alert(39)//"">") (= z ")//")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x ">" 0) 0) (not (= (str.at y 30) ">"))))
(assert (not (str.suffixof "ors())//" y)))
(assert (not (= (str.at z 0) " ")))
(assert (str.prefixof "<!-- inj" x))
(assert (or (not (str.contains y "n=alert(1")) (= (str.at y 10) "s") (<= (str.len y) 44)))
(assert (or (not (str.suffixof "ol>" z)) (str.contains (str.replace z "=" "<b>") " src<b>""")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]([a-zA-Z0-9_-]{0,29})$"))))
(assert (or (not (str.contains (str.replace y "s())/" """") "tor""/")) (not (= ">>> vxs()" (str.replace x "ector" "x")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]{1,15}"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9!#$%&()*+,.:;=?@\[\]^_{}-]+$"))))
(check-sat)
