; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext onkeypress=""alert(1)"" contenteditable>test</plaintext>") (= x "<nobr onmouseout=""alert(1)"">test</nobr>") (= x "<sup draggable=""true"" ondragend=""alert(1)"">test</sup>")))
(assert (or (= z "d/*/foo.jpg);"">X") (= z "st</p>") (= z "ert('hellox worldss')>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 60) (= "<pl<b>text onkeypress=""alert(1)"" contenteditable>test</plaintext>st</p>" (str.replace y "ain" "<b>"))))
(assert (or (= (str.indexof y "est<" 0) 31) (= "<nobalert(1) onmouseout=""alert(1)"">test</nobr>st</p>" (str.replace y "r" "alert(1)"))))
(assert (or (not (= (str.at x 41) "n")) (str.prefixof "<plaint" y)))
(assert (or (not (str.contains (str.replace z "ss')" "x") "worldx>")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{3}\s?[a-zA-Z]{2}$")))))
(assert (not (= (str.indexof z "t</p>" 0) 1)))
(check-sat)
