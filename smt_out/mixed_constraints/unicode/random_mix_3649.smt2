; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element onbeforecut=""alert(1)"" contenteditable>test</element>") (= x "<content draggable=""true"" ondragstart=""alert(1)"">test</content>") (= x "<svg><title onload=alert(1)></title>")))
(assert (or (= z "ragenter=""alert(1)"">test</nextid>") (= z "+-_.,:;?@[/|\]^`=alert("";XSS"";)>;")))
(assert (= y (str.++ x z)))
(assert (or (= ">test</c" (str.substr y 29 8)) (= (str.indexof x "deo/" 0) 74)))
(assert (>= (str.len x) 56))
(assert (not (str.prefixof "<rt on" y)))
(assert (str.suffixof "st</kbd>" z))
(assert (or (not (str.contains (str.replace y """;)>;" """") "XSS""")) (str.contains z "pt onload")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "\D{2,}"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "8YV3KD"))))
(assert (not (>= (str.len x) 62)))
(assert (or (not (str.contains (str.replace y " co" "javascript:") "t(1)""javascript:ntent")) (str.prefixof "<svg><ti" y) (= (str.at y 37) "=")))
(assert (not (str.prefixof "+-_" z)))
(check-sat)
