; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound onmouseenter=""alert(1)"">test</bgsound>") (= x "<menuitem onmouseup=""alert(1)"">test</menuitem>") (= x "<style>#x{font-famil\u{1f600}y:foo[bar;color:green;}#y];color\u{10348}:red;{}</style>//[""'`-->]]>]</div>")))
(assert (or (= z "t(1)"" contenteditable>test</multicol>") (= z "onmouseleave=""alert(1)"">test</select>") (= z "alert(1)"">test</tt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/canvas>" x)) (str.contains (str.replace z "abl" "x") "editxe") (not (str.in_re x ((_ re.from_regex ecma2020 u) "(((?=.*[a-z])(?=.*[A-Z])(?=.*[0-9]))|((?=.*[a-z])(?=.*[A-Z])(?=.*[!@#\\$%\\^&\\*]))|((?=.*[a-z])(?=.*[0-9])(?=.*[!@#\\$%\\^&\\*]))|((?=.*[A-Z])(?=.*[0-9])(?=.*[!@#\\$%\\^&\\*]))).{8,}$")))))
(assert (or (str.suffixof "ipt%3e" z) (= (str.indexof z """aler" 0) 13) (not (str.prefixof "<bgsound" y))))
(assert (or (not (str.contains (str.replace y "-->" """") "'`""]]>]<")) (not (str.prefixof "<bgsou" y)) (>= (str.len x) 42)))
(assert (or (= (str.at z 8) "n") (= "t>" (str.substr z 17 3)) (not (>= (str.len y) 59))))
(assert (or (= "-->]" (str.substr x 75 4)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^testpage$"))) (str.suffixof "icol>" y)))
(check-sat)
