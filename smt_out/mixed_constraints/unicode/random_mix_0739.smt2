; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;STYLE TYPE="";text/javascript"";>;alert(';XSS';);<;/STYLE>;") (= x "<button onmousedown=""alert(1)"">test</button>") (= x "<base id=x tabindex=1 onfocusin=alert(1)></base>")))
(assert (or (= z "org/xss.js></SCRIPT>") (= z "ert(1)></sup>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "PT>" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{1}$")))))
(assert (not (str.contains z "s.js></S")))
(assert (or (= (str.at x 41) "<") (not (= (str.indexof x "<" 0) 0))))
(assert (or (not (= "<;STYLE TYPE="";text/javascript"";>;alert(';XSS';)javascript:STYLE>;" (str.replace x ";<;/" "javascript:"))) (not (str.suffixof ")></base>" x))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9.-]+(?:\.[a-zA-Z0-9-]+)$"))) (str.prefixof "<bu" x) (str.prefixof "<;" y)))
(check-sat)
