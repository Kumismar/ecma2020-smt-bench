; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<Z oncut=alert()>x") (= x "<noframes oncut=""alert(1)"" contenteditable>test</noframes>") (= x "<slot id=x tabindex=1 onbeforeactivate=alert(1)></slot>")))
(assert (or (= z "le>test</article>") (= z "Y ONLOAD=alert('hellox worldss')>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "le>t" z)))
(assert (or (= (str.len y) 72) (not (str.suffixof "worldss')>" y)) (= "D=a" (str.substr z 7 3))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(1[3-9]\d{9})$"))) (str.suffixof "s')>" z) (str.contains (str.replace x "1)" "") "ert(></")))
(assert (or (str.prefixof "e=""aler" z) (not (= ")></slot>" (str.substr x 46 10))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(0?[1-9]|[12][0-9]|3[01])[\/](0?[1-9]|1[012])[/\\/](19|20)\d{2}$")))))
(assert (or (not (= (str.len x) 55)) (str.suffixof ">" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((\+|00)[0-9][0-9])?([0-9]{9,10})$")))))
(check-sat)
