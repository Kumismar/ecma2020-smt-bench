; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onbeforepaste=""alert(1)"" contenteditable>test</sup>") (= x "<cite id=x tabindex=1 ondeactivate=alert(1)></cite><input id=y autofocus>")))
(assert (or (= z ")"" contenteditable>test</kbd>") (= z """ contenteditable>test</pre>") (= z "t(1)"" conte\u{10348}nteditable>test\u{1d400}</cite>")))
(assert (= y (str.++ x z)))
(assert (or (= ">"" co" (str.substr y 55 5)) (not (str.contains y "usedown="""))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[-\w][-\w.]+@{1}[-a-z0-9]+[.]{1}[a-z]{2,7}$")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "(^\d{3}-\d{3}-\d{4}$)")))))
(assert (or (= (str.indexof z "tab" 0) 12) (not (str.suffixof "di>" y))))
(assert (or (str.contains y " autof") (= (str.indexof z "oty" 0) 9) (not (str.prefixof "<sup on" x))))
(assert (or (= "<sup on" (str.substr y 0 7)) (= "conte" (str.substr z 3 5))))
(assert (or (= (str.len x) 73) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((\+\d{1,3}(-| )?\(?\d\)?(-| )?\d{1,3})|(\(?\d{2,3}\)?))(-| )?(\d{3,4})(-| )?(\d{4})(( x| ext)\d{1,5}){0,1}$"))) (not (str.suffixof "st</pre>" y))))
(check-sat)
