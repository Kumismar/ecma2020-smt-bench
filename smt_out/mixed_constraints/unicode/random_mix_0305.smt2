; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a draggable=""true"" ondragleave=""alert(1)"">test</a>") (= x "<style>:target {color: red;}</style><frameset id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></frameset>")))
(assert (or (= z "</style><blink style=""animation-name:x"" onanimationend=""alert(1)""></blink>") (= z "tenteditable>drop here</div>") (= z "nteditable>test</multicol>")))
(assert (= y (str.++ x z)))
(assert (or (not (= " ondrag" (str.substr x 19 7))) (not (str.prefixof "te" z)) (= (str.indexof y "\x8B" 0) 20)))
(assert (or (str.prefixof "<c" x) (= (str.at y 8) "a")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-z ]*$"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[^ -~\u{ff61}-\u{ff9f}]*$"))))
(assert (not (= (str.at x 46) "i")))
(assert (not (str.suffixof "/multicol>" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[_A-Za-z0-9-\\+]+(\\.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(\\.[A-Za-z0-9]+)*(\\.[A-Za-z]{2,})$"))) (= "tyl" (str.substr x 31 3))))
(assert (or (not (str.prefixof "<a dra" x)) (= (str.at z 5) "t")))
(assert (str.suffixof "</blink>" y))
(check-sat)
