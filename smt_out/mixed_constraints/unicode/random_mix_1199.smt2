; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input oncopy=alert(1) value=""XSS"" autofocus>") (= x "<marquee/onstart=alert()>")))
(assert (or (= z "t</dd>") (= z "ment.cookie);//<br/><hr/>") (= z "nload=%09((pro\u{5c}u006dpt))()//")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "ut=""a" 0) 14)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "([a-zA-Z\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{fd}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{dd}\u{e2}\u{ea}\u{ee}\u{f4}\u{fb}\u{c2}\u{ca}\u{ce}\u{d4}\u{db}\u{e3}\u{f1}\u{f5}\u{c3}\u{d1}\u{d5}\u{e4}\u{eb}\u{ef}\u{f6}\u{fc}\u{ff}\u{c4}\u{cb}\u{cf}\u{d6}\u{dc}\u{178}\u{e7}\u{c7}]{2,}(\s|$)){2,}")) (= (str.at x 9) " ") (str.prefixof "<marq" x)))
(assert (or (str.prefixof "<" y) (not (= (str.at z 25) "n"))))
(assert (not (str.suffixof "/video>" z)))
(assert (or (not (= "alert()>t<" (str.substr y 17 10))) (not (= (str.indexof y "t" 0) 5))))
(assert (or (not (= (str.len z) 28)) (str.contains (str.replace y "rqu" """") "<ma""ee/")))
(check-sat)
