; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x17javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<dialog onbeforepaste=""alert(1)"" contenteditable>te\u{20000}\u{20000}st</dialog>")))
(assert (or (= z "rt(1)"" contenteditable>test</pre>") (= z " onfocusout=alert(1) tabindex=1 id=x></figure><input autofocus>") (= z "ert(1)"">test</blink>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len z) 62)) (not (str.contains (str.replace x "agov" "javascript:") "drjavascript:e")) (not (str.contains (str.replace y "ascr" " ") "v i"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*\d)(?=.*[a-zA-Z]).{6,12}$"))))
(assert (or (str.contains z "</bli") (not (str.contains y "t=a")) (= (str.at x 18) "s")))
(assert (or (= (str.at x 34) "c") (= (str.at z 7) "a")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9-._%+]+@[A-Za-z0-9.]+\.[A-Za-z]{1,63}$")) (not (= (str.indexof z "/f" 0) 38)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{3}.[0-9]{3}.[0-9]{4}")))))
(assert (= "test</a>" (str.substr x 63 9)))
(assert (not (= (str.indexof x "zel" 0) 52)))
(assert (not (= "rt(1)"">" (str.substr x 38 10))))
(check-sat)
