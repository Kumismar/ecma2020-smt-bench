; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe/src=""data:text/html;&Tab;base64&Tab;,PGJvZHkgb25sb2FkPWFsZXJ0KDEpPg=="">") (= x "<script <B>document.vulnerable=true;</script>") (= x "<video autoplay controls onpause=alert(1)><source src=""vali\u{1f4a9}dvideo.mp4"" type=""video/mp4""></video>")))
(assert (or (= z "u>") (= z "test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len x) 45) (>= (str.len x) 69) (not (str.prefixof "<script " x))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]([a-zA-Z0-9_-]{0,29})$"))) (>= (str.len y) 49)))
(assert (or (not (str.prefixof "<param on" y)) (= (str.indexof y "st</" 0) 47) (not (= "<iframe/src=""data:text/htmxab;base64&Tab;,PGJvZHkgb25sb2FkPWFsZXJ0KDEpPg=="">" (str.replace x "l;&T" "x")))))
(assert (or (not (str.contains (str.replace x "rt" "<b>") """ale<b>(1")) (= (str.at y 64) "e") (not (str.in_re y ((_ re.from_regex ecma2020 u) "[9|8|7|6|5|4|3|2|1|0]\d{9}$")))))
(check-sat)
