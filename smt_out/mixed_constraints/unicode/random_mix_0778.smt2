; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG S\u{1f4a9}RC=x onmousewheel=""alert(String.fromCharCode(8\u{20000}8,83,83))"">") (= x "<summary onbeforecopy=""alert(1)"" contenteditable>test</summary>")))
(assert (or (= z "py=""alert(1)"" contenteditable>test</th>") (= z "!--[if gte IE 4]><SCRIPT>alert('XSS');</SCRIPT><![endif]-->")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.*@.*\..*$"))) (not (= (str.at y 47) "C")) (str.suffixof "[endif]-->" y)))
(assert (or (= "tiv" (str.substr x 28 3)) (not (str.contains z "ontente"))))
(assert (or (not (= (str.indexof x "onbe" 0) 9)) (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9.]{6,9}([0-9A-Z]{0,3})$"))))
(assert (= (str.indexof x "el=""a" 0) 22))
(assert (or (not (str.prefixof "<summar" y)) (not (str.suffixof "</th>" y)) (= (str.len x) 65)))
(assert (or (not (= (str.indexof y "t " 0) 32)) (str.prefixof "<IMG S\u{1f4a9}" y)))
(assert (not (= ">" (str.substr y 62 1))))
(assert (not (str.prefixof "<style>" x)))
(check-sat)
