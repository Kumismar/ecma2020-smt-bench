; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form onmouseup=""alert(1)"">test</form>") (= x "<% foo><x foo=""%><script>alert(123)</script>"">")))
(assert (or (= z "nteditable>test</em>") (= z "zzelement1"">test</a>") (= z "ext/javascript"">javascript:alert(1);</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<% foo><x" y)) (not (= "<script\x2F>javascript:t(1)</script>" (str.replace x "aler" "")))))
(assert (or (= (str.indexof x "o" 0) 2) (= (str.len x) 38)))
(assert (str.contains y """>te"))
(assert (or (not (= (str.at z 40) "r")) (str.in_re y ((_ re.from_regex ecma2020 u) "^\S[\w \u{df}\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}]*")) (not (= (str.indexof y "pt""" 0) 50))))
(assert (or (= "<% foo><x foo=""%><script>alert(123)</script>"">nteditable>txem>" (str.replace y "est</" "x")) (str.in_re y ((_ re.from_regex ecma2020 u) "^[\t-\r \x2D0-9A-Z\xA0\u{5c}u1680\u{5c}u2000-\u{5c}u200A\u{5c}u2028\u{5c}u2029\u{5c}u202F\u{5c}u205F\u{5c}u3000\u{5c}uFEFF]{3,10}$"))))
(assert (or (not (str.prefixof "e" z)) (= (str.indexof x "t" 0) 21) (not (str.suffixof "</em>" z))))
(check-sat)
