; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<% foo><x foo=""%><script>alert(91)</script>"">//[""'`-->]]>]</div>") (= x "<div draggable=""true"" contenteditable>drag me</div><multicol ondrop=alert(1) contenteditable>\u{1f4a9}drop here</multicol>")))
(assert (or (= z "ocusout=alert(1) tabindex=1 id=x></meter><input autofocus>") (= z "le=""true"" contenteditable>drag me</div><dir ondragover=alert(1) contenteditable>drop here</dir>")))
(assert (= y (str.++ x z)))
(assert (or (= "<% foo><x foo=""%><script>alert(91)</script>"">//[""'`-->]x</div>" (str.replace x "]>]" "x")) (not (str.contains (str.replace x "e"" " """") "ru""c"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([\w-])+@([\w-])+(\.[\w-])+"))))
(assert (str.contains z "r=a"))
(assert (or (not (= (str.indexof y "sout" 0) 117)) (not (str.prefixof "le=""true" z))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_-]+[a-zA-Z0-9_.-]*@[a-zA-Z0-9_-]+[a-zA-Z0-9_.-]*\.[a-zA-Z]*"))))
(assert (= "le=" (str.substr z 0 3)))
(assert (or (not (= "<% foo><x foo=""%><script>alert(91)</script>"">//[""'`-->]]>]</div>ocusout=alert(1) tabindex=1 id=x></meter><input autjavascript:cus>" (str.replace y "ofo" "javascript:"))) (str.prefixof "<div d" x)))
(check-sat)
