; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<command id=x tabindex=1 ondeactivate=alert(1)></command><input id=y autofocus>") (= x "<listing onbeforecut=""alert(1)"" contenteditable>test</listing>")))
(assert (or (= z "bindex=1 onfocus=alert(1)></b\u{1f600}lockquote>") (= z "ouseenter=""alert(1)"">test</samp>") (= z "teditable>test</li>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[a-z0-9]+([\-.]{1}[a-z0-9]+)*\.[a-z]{2,5}(:[0-9]{1,5})?(\/.*)?$"))) (= "test</s" (str.substr z 21 7))))
(assert (or (= (str.at z 12) "s") (not (str.contains (str.replace y "npu" "") "nd><it id=")) (not (= "<listing onbeforecut=""a""1)"" contenteditable>test</listing>bindex=1 onfocus=alert(1)></b\u{1f600}lockquote>" (str.replace y "lert(" """")))))
(assert (or (not (str.suffixof "ocus>" x)) (not (= "<lis<b>onbeforecut=""alert(1)"" contenteditable>test</listing>bindex=1 onfocus=alert(1)></b\u{1f600}lockquote>" (str.replace y "ting " "<b>"))) (str.prefixof "<script " y)))
(assert (or (not (= (str.at x 58) "i")) (not (= (str.at z 6) "b"))))
(check-sat)
