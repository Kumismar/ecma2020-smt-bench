; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark draggable=""true"" ondrag=""alert(1)"">test</mark>") (= x "<IMG SRC=\""jav&#x0D;ascript:alert('XSS');\"">") (= x "<multicol draggable=""true"" ondragend=""alert(1)"">test</multicol>")))
(assert (or (= z "t\u{1f4a9}yle=""x:\xE2\x80\x81expression(javascri\u{1f600}pt:alert(1)"">DEF") (= z "ontenteditable>drop here</meta>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 15) "=")))
(assert (not (str.suffixof "F" y)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(([^<>()\[\]\.,;:\s@""]+(\.[^<>()\[\]\.,;:\s@""]+)*)|("".+""))@(([^<>()[\]\.,;:\s@""]+\.)+[^<>()[\]\.,;:\s@""]{2,})$")) (not (str.contains y "scri\u{1f600}")) (str.suffixof "ruby>" x)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^(([0-8][0-9])|(9[0-5])|(2[ab]))[0-9]{3}$")))
(assert (or (= "re</" (str.substr y 66 4)) (not (= (str.at z 9) "c"))))
(assert (or (not (= (str.len y) 112)) (not (str.prefixof "<noembed o" y))))
(assert (= (str.indexof y "ark " 0) 2))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((https?|ftp)://)?[^\s/$.?#]*\.[^\s]*$"))) (not (= (str.at y 17) "="))))
(assert (= "est<" (str.substr x 42 4)))
(check-sat)
