; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre dragga\u{10348}ble=""true"" o\u{20000}ndrag=""alert(1)"">test</pre>") (= x "<s onmousemove=""alert(1)"">test</s>")))
(assert (or (= z "get {color: red;}</style><tt id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tt>") (= z "le>:target {color:red;}</st\u{10348}yle><menu id=x style=""t\u{1f4a9}ransition:color 1s"" ontransitionend=alert(1)></menu>") (= z "bgsound>")))
(assert (= y (str.++ x z)))
(assert (= "ter__('n" (str.substr y 44 8)))
(assert (or (not (= (str.indexof x "e=" 0) 14)) (not (= " dr" (str.substr x 4 3))) (not (str.suffixof "gsound>" y))))
(assert (or (not (str.suffixof ">test</s>" x)) (not (str.contains x "e dragga"))))
(assert (or (str.prefixof "get " z) (str.in_re z ((_ re.from_regex ecma2020 u) "^[\w\-\.]+@[\w\-\.]+(\.\w+)+$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9]{13,16})$")))))
(assert (str.suffixof "T>" z))
(check-sat)
