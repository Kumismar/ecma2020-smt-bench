; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid onmouseleave=""alert(1)"">test</nextid>") (= x "<div draggable=""true"" contenteditable>drag me</div><center ondrop=alert(1) contenteditable>drop here</center>")))
(assert (or (= z ")>click") (= z "ndblcl\u{1d400}ick=""alert(1)"">test</rtc>\u{1f4a9}") (= z "t(1)></rt><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len z) 33) (not (= (str.indexof z "></" 0) 4)) (not (= "e" (str.substr z 34 1)))))
(assert (str.contains z ">click"))
(assert (or (not (= (str.indexof y "e>dr" 0) 36)) (str.prefixof "nd" z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9])+([a-zA-Z0-9\._-])*@([a-zA-Z0-9_-])+([a-zA-Z0-9\._-]+)+$")) (= (str.at x 15) """")))
(check-sat)
