; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span onmouseenter=""alert(1)"">test</span>") (= x "<style>@keyframes x{}</style><kbd style=""animation-name:x"" onanimationstart=""alert(1)""></kbd>")))
(assert (or (= z "raggable=""true"" ondragend=""alert(1)"">test</em>") (= z " oncontextmenu=""alert(1)"">test</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<st" y)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{5c}u4e00-\u{5c}u9fa5]{2,3}$")) (not (= (str.at x 13) "a"))))
(assert (or (not (= (str.at x 34) "t")) (str.suffixof "bdi>" y) (>= (str.len z) 1)))
(assert (or (= "e" (str.substr z 22 1)) (not (= "<style>@keyframes x{}</style><kbd style=""animation-name:x"" onanimationstart=""alert(1)""></kbd>raggable=""true"" ondragealert(1)""alert(1)"">test</em>" (str.replace y "nd=" "alert(1)"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{5}$|^\d{5}-\d{4}$")))))
(assert (str.contains x "tart=""al"))
(assert (or (not (= (str.len y) 139)) (not (= "yle>@" (str.substr y 3 5))) (= """ ondra" (str.substr z 14 7))))
(assert (or (str.contains y "able") (= (str.indexof z "<" 0) 30)))
(check-sat)
