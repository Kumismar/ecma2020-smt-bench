; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote onbeforecut=""alert(1)"" contenteditable>test</blockquote>") (= x "<abbr draggable=""true"" ondragleave=""alert(1)"">test</abbr>")))
(assert (or (= z "s></script>") (= z "enteditable>drop here</q>") (= z "test</tt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "t(1)" "x") "erx"">")) (>= (str.len y) 38)))
(assert (or (not (= (str.len x) 68)) (not (= (str.indexof x "(" 0) 41)) (str.contains y "LE='no\xs")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "\d+(\.\d{1})?")) (str.prefixof "<" x)))
(assert (or (not (str.contains x "br ")) (str.suffixof "</q>" y)))
(assert (or (= (str.at z 24) ">") (str.prefixof "<te" y) (not (str.contains x """true"" on"))))
(assert (or (not (= (str.at x 40) "n")) (not (= "/scr" (str.substr z 3 4))) (= (str.at y 46) "a")))
(check-sat)
