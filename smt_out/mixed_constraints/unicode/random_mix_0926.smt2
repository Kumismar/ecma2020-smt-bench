; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details id=x tabindex=1 onactivate=alert(1)></details>") (= x "></SCRIPT>"">'><SCRIPT>alert(String.fromCharCode(88,83,83))</SCRIPT>")))
(assert (or (= z "font>") (= z "utofocus>") (= z "e=""true"" ondragstart=""alert(1)"">test</figcaption>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "ut" 0) 66) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{6,12}$")) (not (>= (str.len x) 58))))
(assert (or (not (= "SCRI" (str.substr x 15 4))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{0,31}$")))))
(assert (or (not (= "></select" (str.substr y 120 9))) (not (str.suffixof "ion>" y))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{3,25}")) (not (= "lert" (str.substr z 23 4)))))
(check-sat)
