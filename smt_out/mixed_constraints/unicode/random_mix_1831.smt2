; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<template onmouseenter=""alert(1)"">test</template>") (= x "<u oncut=""alert(1)"" contenteditable>test</u>")))
(assert (or (= z "est</plaintext>") (= z "le><tfoot id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tfoot>") (= z "></q><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 31) "a") (not (str.contains z "/plaintext"))))
(assert (not (str.suffixof ">" x)))
(assert (= "<templxonmouseenter=""alert(1)"">test</template>" (str.replace x "ate " "x")))
(assert (or (str.contains (str.replace x "ca" "alert(1)") "ionalert(1)nce") (not (= "laintex" (str.substr z 6 7)))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z0-9]+$"))))
(assert (str.contains (str.replace z "></q" "alert(1)") "alert(1)><"))
(check-sat)
