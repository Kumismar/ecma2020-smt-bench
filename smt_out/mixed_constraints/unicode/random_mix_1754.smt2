; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noframes draggable=""true"" ondragleave=""alert(1)"">test</noframes>") (= x "<applet onerror applet onerror=""javascript:javascript:alert(1)""></applet onerror>") (= x "&quot;&gt;&lt;BODY onload!#$%&amp;()*~+-_.,:;?@[/|\]^`=alert(&quot;XSS&quot;)&gt;")))
(assert (or (= z "ontenteditable>test</datalist>") (= z "/select>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "&#060" x)))
(assert (not (= (str.indexof y "</" 0) 64)))
(assert (str.prefixof "<app" x))
(assert (not (str.suffixof ">" z)))
(assert (or (str.contains x "scrip") (not (= "/selecalert(1)" (str.replace z "t>" "alert(1)")))))
(assert (or (str.suffixof "select>" y) (str.contains z "select>")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^.{6,12}")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(\d{5}(-\d{4})?|[A-CEGHJ-NPRSTVXYa-ceghj-nprstvwy]\d[A-CEGHJ-NPRSTV-Za-ceghj-nprstv-z] ?\d[A-CEGHJ-NPRSTV-Za-cegj-nprstv-z]\d)$")))))
(assert (or (= "javascript" (str.substr x 43 10)) (not (<= (str.len x) 89))))
(assert (not (str.prefixof "onten" z)))
(check-sat)
