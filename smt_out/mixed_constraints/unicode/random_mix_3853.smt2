; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title oncopy=""alert(1)"" contenteditable>test</title>") (= x "<div draggable=""true"" contenteditable>drag me</div><dl ondragover=alert(1) contenteditable>drop here</dl>")))
(assert (or (= z "t</title>") (= z "quot;http://ha.ckers.org/xss.swf&quot; AllowScriptAccess=&quot;always&quot;&gt;&lt;/EMBED&gt;") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.*(?<!gmail\.com|yahoo\.com|me\.com|hotmail\.com|outlook\.com)$"))))
(assert (or (str.prefixof "im" z) (= (str.at x 0) "<") (= (str.len z) 9)))
(assert (>= (str.len x) 51))
(assert (str.suffixof ">" x))
(assert (or (= (str.indexof z ">" 0) 0) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-z0-9._-]+@[A-z0-9._-]+\.[A-z]{2,4}$")))))
(assert (or (>= (str.len y) 37) (not (str.contains z ".ckers.org"))))
(check-sat)
