; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdi id=x tabindex=1 onfocusin=alert(1)></bdi>") (= x """>/KinG-InFeT.NeT/><script>alert(document.cookie)</script>") (= x "<style>:target {color:red;}</style><table id=x style=""transition:color 1s"" ontransitionend=alert(1)></table>")))
(assert (or (= z "ntransitioncancel=alert(1)></small>") (= z "te=alert(1)></head><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace x "e><t" "") "/stylabl"))
(assert (not (<= (str.len z) 36)))
(assert (= (str.at z 28) "t"))
(assert (or (not (str.contains (str.replace x "le" "") "t>art(d")) (not (str.contains z "ert"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-Z]{1,2})?\s?\d{2,4}\s?([A-Za-z]{1,3})$")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*?[0-9])(?=.*?[A-Za-z]).+")))))
(assert (= (str.len x) 58))
(assert (not (= (str.at x 78) "r")))
(assert (or (str.contains y "t</sup>") (= "<bdi id=x tabindex=1 onfocusin=alert(1)></bdi>te=alert(1)></head><inputofocus>" (str.replace y "t au" ""))))
(assert (not (= "<s" (str.substr y 0 2))))
(assert (or (not (str.contains y "ocusi")) (= (str.at x 41) ".")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "[\u{ff71}-\u{ff9d}|\u{30a1}-\u{30f3}|\u{3000}| ]+$")))
(check-sat)
