; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<listing onbeforepaste=""alert(1)"" contenteditable>test</listing>") (= x "<img\x32src=x onerror=""javascript:alert(1)"">") (= x "<;!--[if gte IE 4]>;")))
(assert (or (= z "nimationstart=""alert(1)""></tfoot>") (= z "e=""true"" ondragstart=""alert(1)"">test</marquee>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<;!--[if " x)) (= "nimationstar<b>lert(1)""></tfoot>" (str.replace z "t=""a" "<b>")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{30a1}-\u{30f3}|\u{30fc}]+$"))))
(assert (or (= (str.at z 45) ">") (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{4,12}$"))))
(assert (or (not (= (str.len y) 66)) (not (str.prefixof "<im" y)) (= (str.indexof y "drags" 0) 55)))
(assert (= "<;!--[if gtalert(1) IE 4]>;e=""true"" ondragstart=""alert(1)"">test</marquee>" (str.replace y "e" "alert(1)")))
(assert (= (str.len x) 64))
(assert (or (not (str.contains y "bl")) (= "t(1)""" (str.substr z 19 5))))
(assert (not (str.contains (str.replace x "r" "alert(1)") "gualert(1)e d")))
(assert (not (= """alert(1)""" (str.substr x 23 10))))
(check-sat)
