; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div/style=""width:expression(confirm(1))"">X</div> {IE7}") (= x "<html onMouseUp html onMouseUp=""javascript:javascript:alert(1)""></html onMouseUp>")))
(assert (or (= z "lert(1)"" contenteditable>test</source>") (= z "alert(1)"">test</dd>") (= z "foreactivate=alert(1)></listing>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "r</var>?" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.{6,10}"))) (= (str.indexof x "</" 0) 64)))
(assert (or (not (= "<html onMo seUp html onMouseUp=""javascript:javascript:alert(1)""></html onMouseUp>" (str.replace x "u" " "))) (not (= (str.at z 2) "r"))))
(assert (= (str.at x 57) "r"))
(assert (= "<div/style=javascript:width:expression(confirm(1))"">X</div> {IE7}alert(1)"">test</dd>" (str.replace y """" "javascript:")))
(assert (= "<html onMouseUp html onMouseUp=""javasc""t:javascript:alert(1)""></html onMouseUp>" (str.replace x "rip" """")))
(assert (or (str.suffixof ">" z) (<= (str.len z) 31) (not (str.suffixof "/dd>" z))))
(assert (or (= (str.indexof x "</" 0) 43) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((19[0-9][0-9])|(20[0-9][0-9]))$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^AI\d{3,7}|AX\d{3,7}$")))))
(assert (not (str.prefixof "foreac" z)))
(check-sat)
