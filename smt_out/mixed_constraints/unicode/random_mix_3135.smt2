; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s ondblclick=""alert(1)"">test</s>") (= x "<?xml version=""1.0"" encoding=""ISO-8859-1""?><foo><![CDATA[' or 1=1 or ''=']]></foof>") (= x "<image id=x tabindex=1 onactivate=alert(1)></image>")))
(assert (or (= z "e id=x tabindex=1 onfocusin=alert(1)></time>") (= z "id=""x"" classid=""clsid:CB927D12-4FF7-4a9e-A169-56E4B8A75598""></object>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len z) 44)))
(assert (or (not (str.suffixof "ect>" y)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\s*(3[01]|[12][0-9]|0?[1-9])\.(1[012]|0?[1-9])\.((?:19|20)\d{2})\s*$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9].{6,}"))) (not (str.prefixof "id=""x"" " z))))
(assert (not (= (str.indexof x "ng" 0) 26)))
(assert (or (>= (str.len y) 117) (str.contains (str.replace y "it" "javascript:") "djavascript:a")))
(assert (or (str.contains z "1)""") (not (>= (str.len y) 68)) (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z]{5,30}"))))
(check-sat)
