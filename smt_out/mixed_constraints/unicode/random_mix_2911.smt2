; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<head onmousedown=""alert(1)"">test</head>") (= x "<del onblur=alert(1) tabindex=1 id=x></del><input autofocus>")))
(assert (or (= z "=alert(1)></del>") (= z "=""alert(1)"">test</meta>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z """>test</m")) (not (= (str.at z 22) ">"))))
(assert (= (str.at z 2) "l"))
(assert (or (>= (str.len y) 74) (>= (str.len x) 37) (str.suffixof "eta>" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?!.*@relycom\.net.*$)(.*[@]{1}.+\..+)$"))) (not (= "<del onblur=ale<b> tabindex=1 id=x></del><input autofocus>" (str.replace x "rt(1)" "<b>")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "5$"))))
(check-sat)
