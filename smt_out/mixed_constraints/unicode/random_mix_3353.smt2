; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><strong style=""animation-name:x"" onanimationend=""alert(1)""></strong>") (= x "<marquee onmousemove=""alert(1)"">test</marquee>")))
(assert (or (= z """alert(1)"">test</rb>") (= z "teditable>test</rb>") (= z "ocus=alert(1)></rb>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "ter=" "alert(1)") "nalert(1)""")) (= (str.at x 36) "<")))
(assert (or (not (= (str.at y 28) ")")) (str.suffixof "t</rb>" z) (not (= (str.indexof y "m" 0) 1))))
(assert (or (>= (str.len y) 56) (str.prefixof "<xss id=x" y)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(1?(-?\d{3})-?)?(\d{3})(-?\d{4})$"))) (str.prefixof "<" x)))
(assert (not (= "rt" (str.substr y 25 2))))
(assert (or (= (str.len z) 19) (not (= (str.at z 9) """")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{1,5}([.,]{1}[0-9]{1,2})*$")))))
(check-sat)
