; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG SRC=\""jav&#x0A;ascript&#058;alert('XSS');\""&gt;") (= x "<plaintext onmousedown=""alert(1)"">test</plaintext>") (= x "<link rel=import href=""data:text/html&comma;&lt;script&gt;alert(1)&lt;&sol;script&gt;")))
(assert (or (= z "utofocus>") (= z "}")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "t/htm")) (not (str.contains y "tofocu"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^CB\d{3,7}|cb\d{3,7}$"))) (not (= (str.at z 3) "f"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{1,2}\.[0-1]{0,1}[0-9]{0,1}\.[0-9]{4}$"))) (not (str.prefixof "utofo" z)) (not (= (str.at z 4) "o"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\s\w\-]{3,}$"))) (not (= (str.indexof x ";\" 0) 48)) (str.suffixof "tofocus>" z)))
(assert (or (not (= "<plaintext onmousedown=""aalert(1)1)"">test</plaintext>" (str.replace x "lert(" "alert(1)"))) (not (<= (str.len z) 37)) (not (>= (str.len z) 1))))
(check-sat)
