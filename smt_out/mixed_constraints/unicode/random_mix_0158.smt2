; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;A HREF="";//google"";>;XSS<;/A>;") (= x "<table onmouseleave=""alert(1)"">test</table>") (= x "<bgsound draggable=""true"" ondragleave=""alert(1)"">test</bgsound>")))
(assert (or (= z "eforeactivate=alert(1)></optgroup>") (= z "itable>test</ruby>") (= z "n=alert(1)></hr>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "test</ru")))
(assert (= (str.at x 1) "t"))
(assert (not (str.contains x "ondra")))
(assert (or (= (str.indexof x "st" 0) 33) (not (str.contains z "n=alert(1"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,7}$")) (not (= ">;" (str.substr x 30 2))) (= "st</r" (str.substr z 9 5))))
(check-sat)
