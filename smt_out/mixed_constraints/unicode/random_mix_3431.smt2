; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """'`>ABC<div style=""font-family:'foo'\x3Bx:expression(javascript:alert(1);/*';"">DEF") (= x "<element onmouseenter=""alert(1)"">test</element>")))
(assert (or (= z """fuzzelement1"">test</a>") (= z "ment.vulnerable=true; <") (= z "test</base>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "elem" 0) 87)) (str.suffixof "=true; <" z)))
(assert (not (= (str.at x 1) "e")))
(assert (str.contains z """ onanim"))
(assert (not (= (str.at z 18) "u")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s\.]{1,10}")) (str.prefixof """'" y)))
(assert (or (not (= (str.indexof y "e=""f" 0) 16)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9\.]{3,11}"))) (not (= (str.len z) 23))))
(check-sat)
