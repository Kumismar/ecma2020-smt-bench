; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption ondblclick=""alert(1)"">test</caption>") (= x "<tbody onkeyup=""\u{1f600}alert(1)"" conten\u{10348}teditable>test</tbody>") (= x "<code onmouseup=""alert(1)"">test</code>")))
(assert (or (= z "gleave=""alert(1)"">test</isindex>") (= z ")"">test</d\u{1d400}d>") (= z "/command>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len z) 13)))
(assert (or (str.suffixof "st</code>" x) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\d ()+-]+$")))))
(assert (or (not (= "gle""ve=""alert(1)"">test</isindex>" (str.replace z "a" """"))) (str.contains (str.replace z "co" "alert(1)") "/alert(1)mma") (not (= (str.indexof x "able" 0) 39))))
(assert (not (= "ve=""ale" (str.substr z 4 7))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?:(A[KLRZ]|C[AOT]|D[CE]|FL|GA|HI|I[ADLN]|K[SY]|LA|M[ADEINOST]|N[CDEHJMVY]|O[HKR]|P[AR]|RI|S[CD]|T[NX]|UT|V[AIT]|W[AIVY]))$"))))
(assert (or (str.contains y """>tes") (str.contains (str.replace z "/com" """") """mand>")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^AT\d{3,7}$"))))
(assert (or (not (= (str.indexof x "o" 0) 3)) (not (= (str.indexof z "t</" 0) 6))))
(assert (str.contains z "t<"))
(assert (>= (str.len x) 30))
(check-sat)
