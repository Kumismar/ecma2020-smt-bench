; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<center draggable=""true"" ondrag=""alert(1)"">test</center>") (= x "<link onbeforepaste=""alert(1)"" contenteditable>test</link>")))
(assert (or (= z "useleave=""alert(1)"">test</sub>") (= z "nbeforecut=""alert(1)"" contenteditable>test</sub>")))
(assert (= y (str.++ x z)))
(assert (or (= "<" (str.substr z 24 1)) (not (<= (str.len x) 78)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[_A-Za-z0-9-\+]+(\.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(\.[A-Za-z0-9]+)*(\.[A-Za-z]{2,})$")))))
(assert (or (>= (str.len y) 87) (str.prefixof "<link o" y) (str.suffixof "ub>" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+38 \([0-9]{3}\) [0-9]{3}-[0-9]{2}-[0-9]{2}"))))
(assert (or (not (= "alert(1)""" (str.substr x 21 9))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[ A-Za-z_./'#&+-]*$")))))
(assert (str.suffixof "b>" y))
(check-sat)
