; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas oncopy=""alert(1)"" contenteditable>test</canvas>") (= x "<figcaption id=x tabindex=1 onbeforeactivate=alert(1)></figcaption>") (= x "<progress id=x tabindex=1 onactivate=alert(1)></progress>")))
(assert (or (= z "=1 onactivate=alert(1)></data>") (= z "e=a\u{20000}lert(1)></in\u{1f4a9}s>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "abi" 0) 16))
(assert (or (not (str.suffixof "st</bdo>" x)) (not (= (str.at y 38) "t")) (not (str.contains x "/canva"))))
(assert (not (= (str.at y 42) "t")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{11}$|^\d{3,4}-\d{3,4}-\d{4}$"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*\d)(?=.*[a-zA-Z]).{8,}"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((?!gmail)(?!yahoo)(?!hotmail).)*$"))) (= (str.len z) 30) (str.contains y "alert(1)""")))
(assert (or (not (>= (str.len y) 86)) (not (= "pr" (str.substr x 48 2)))))
(assert (or (not (>= (str.len z) 18)) (not (= (str.indexof y "=aler" 0) 36))))
(check-sat)
