; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong id=x tabindex=1 onfocusin=alert(1)></strong>") (= x "<form><input formaction=javascript:alert(1) type=image value=click>")))
(assert (or (= z ">test</form>") (= z "=1 onactivate=alert(1)></dfn>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "\b([A-Z\u{c0}-\u{ff}][-a-z\u{e0}-\u{ff}. ']+[ ]*)+")) (str.contains (str.replace x "test" "alert(1)") """>alert(1)<")))
(assert (= (str.indexof y "n=" 0) 22))
(assert (str.suffixof ">;" z))
(assert (or (str.suffixof "/form>" z) (= (str.indexof z "m>" 0) 12)))
(assert (not (str.prefixof "<form" x)))
(assert (str.prefixof "<strong i" x))
(assert (= "<menuxm onmouseover=""alert(1)"">test</menuitem>" (str.replace x "ite" "x")))
(assert (or (not (str.contains (str.replace z "ate=a" "javascript:") "activjavascript:lert(")) (not (= "\""&g" (str.substr y 103 4))) (not (= (str.len z) 47))))
(check-sat)
