; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style onfocusout=alert(1) tabindex=1 id=x></style><input autofocus>") (= x "<cite draggable=""true"" ondragleave=""alert(1)"">test</cite>")))
(assert (or (= z "eter>") (= z "1)"">test</em>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[-+.\w]+@[-a-z0-9]+(\.[-a-z0-9]+)*\.[a-z]{2,6}$"))) (str.contains z """>test</em")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(^$)|(^.*(\S+).*$)"))) (str.in_re y ((_ re.from_regex ecma2020 u) "^(\d{7}|\d{10})$"))))
(assert (not (= (str.at z 3) ">")))
(assert (or (= "1)"">test" (str.replace z "</em>" "")) (str.suffixof "t</em>" y)))
(assert (not (str.contains x """>test<")))
(assert (not (= (str.at y 37) "r")))
(check-sat)
