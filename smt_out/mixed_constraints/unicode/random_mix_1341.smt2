; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea onselect=alert(1) autofocus>XSS</textarea>") (= x "<a href=""\xE2\x80\xA9javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z """alert(1)"" contenteditable>test</script>") (= z "javas&lt;!-- --&gt;cript&#58;alert('XSS')\""&gt;&lt;/B&gt;&lt;/I&gt;&lt;/XML&gt;")))
(assert (= y (str.++ x z)))
(assert (or (= "\x" (str.substr x 17 2)) (<= (str.len z) 87)))
(assert (or (not (str.contains z """a")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{2}"))) (str.contains y "st</script")))
(assert (or (not (= "ml""></OBJ" (str.substr z 23 9))) (= (str.len y) 119) (not (>= (str.len z) 32))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z.-]+\.[a-z]{2,3}$"))) (not (str.suffixof "&gt;" z))))
(assert (str.prefixof "<bgs\u{1f600}ou" y))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-3][0-9][\.][0-3][0-9][\.]202[1-9]$")) (not (= (str.at z 74) "L")) (= "javaslt;!-- --&gt;cript&#58;alert('XSS')\""&gt;&lt;/B&gt;&lt;/I&gt;&lt;/XML&gt;" (str.replace z "&" ""))))
(check-sat)
