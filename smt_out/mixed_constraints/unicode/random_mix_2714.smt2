; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=x\x11onerror=""javascript:alert(1)"">") (= x "<tfoot draggable=""true"" ondragenter=""alert(1)"">test</tfoot>") (= x "<HEAD><META HTTP-EQUIV=""CONTENT-TYPE"" CONTENT=""text/html; charset=UTF-7""> </HEAD>+ADw-SCRIPT+AD4-%(payload)s;+ADw-/SCRIPT+AD4-")))
(assert (or (= z "ary onfocusout=alert(1) tabindex=1 id=x></summary><input autofocus>") (= z """alert(1)"">test</dt>") (= z "/optgroup>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "=""" 0) 21) (not (str.suffixof "/dt>" y)) (not (<= (str.len z) 23))))
(assert (not (str.suffixof "base>" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9\u{c6}\u{d8}\u{c5}\u{e6}\u{f8}\u{e5}\u{dc}\u{fc}\u{d6}\u{f6}\u{c4}\u{e4}a-zA-Z+-_@./)(!#&% ]{2,99}"))))
(assert (or (str.contains (str.replace y "/aud" "<b>") "<<b>io") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{8,}$"))) (= (str.indexof y "ror=" 0) 18)))
(assert (not (str.contains (str.replace x "payl" "<b>") "-%(<b>oad)s")))
(assert (not (= (str.at x 96) "-")))
(assert (or (not (str.suffixof ">" y)) (not (= (str.indexof z "i" 0) 27))))
(assert (or (= (str.at y 19) "r") (= " oncut=\u{1d400}""a" (str.substr x 4 10))))
(assert (not (str.contains z "on")))
(check-sat)
