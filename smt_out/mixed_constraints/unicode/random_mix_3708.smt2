; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sty\u{1f4a9}le>@keyframes x{}</style><shadow style=""animation\u{1d400}-name:x"" onanimationstart=""alert(1)""></shadow>") (= x "<style>@keyframes x{}</style><ruby style=""animation-name:x"" onanimationend=""alert(1)""></ruby>")))
(assert (or (= z "t</p>") (= z "nerror=""javascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<element o" y))
(assert (or (not (str.suffixof "/p>" z)) (not (= ":x"" onani" (str.substr y 56 9))) (not (= (str.indexof y """an" 0) 41))))
(assert (str.contains (str.replace x "dow>" "<b>") "ha<b>"))
(assert (or (not (= (str.at x 6) ">")) (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z0-9._%-]+@[a-z0-9.-]+\.[a-z]{2,4}$")) (not (= (str.at x 4) "l"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9 ]+$"))) (= "r=""java" (str.substr z 5 7)) (= " sty\u{1f4a9}le>@keyframes x{}</style><shadow style=""animation\u{1d400}-name:x"" onanimationstart=""alert(1)""></shadow>" (str.replace x "<" " "))))
(check-sat)
