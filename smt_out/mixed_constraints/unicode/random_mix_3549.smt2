; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid o\u{10348}nmouseover\u{1f4a9}=""alert(1)"">test</nextid>") (= x "<body onpaste=""alert(1)"" contenteditable>test</body>") (= x "<marquee onstart='javascript:alert('1');'>=(\u{25d5}_\u{25d5})=")))
(assert (or (= z "t</details>") (= z "s.js></script>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "exti" 0) 2)) (>= (str.len y) 59)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z]{4}")))
(assert (= (str.indexof y "t" 0) 6))
(assert (or (not (str.suffixof "ipt>" y)) (str.contains (str.replace x "(" "x") "alertx'1'")))
(assert (or (= (str.len y) 66) (not (= (str.at z 7) "s")) (str.in_re z ((_ re.from_regex ecma2020 u) "^[\w]{1,}[\w.+-]{0,}@[\w-]{1,}([.][a-zA-Z]{2,}|[.][\w-]{2,}[.][a-zA-Z]{2,})$"))))
(assert (not (str.contains z "/deta")))
(assert (not (str.contains (str.replace z "tail" "alert(1)") "t</dealert(1)s>")))
(assert (not (= "sxjs></script>" (str.replace z "." "x"))))
(assert (or (str.contains y "</script>") (not (str.in_re z ((_ re.from_regex ecma2020 u) "50$")))))
(check-sat)
