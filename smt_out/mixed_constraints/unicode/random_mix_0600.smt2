; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<fieldset draggable=""true"" ondragstart=""alert(1)"">test</fieldset>") (= x "<br/><hr/>jAvascript:alert('Top Page Location: '+document.location+' Host Page Cookies: '+document.cookie);//<br/><hr/>")))
(assert (or (= z "t(1)"" contenteditable>test</ol>") (= z "><input autofocus>") (= z "ydown=""alert(1)"" contenteditable>test</div>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{4,30}"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{e2}\u{20ac}\u{2122}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")) (= (str.at z 10) "i")))
(assert (or (str.prefixof "t(1)""" z) (= "ck=""a" (str.substr x 11 5))))
(assert (or (= (str.indexof x "CDAT" 0) 51) (= (str.at x 13) "t") (= (str.at z 6) "t")))
(assert (not (str.suffixof "/>" x)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z0-9\u{430}-\u{44f}\u{451}\u{401}\u{457}\u{407}\u{456}\u{406}\u{454}\u{404}\u{4d8}\u{4d9}\u{492}\u{493}\u{49a}\u{49b}\u{4a2}\u{4a3}\u{4e8}\u{4e9}\u{4ae}\u{4af}\u{4b0}\u{4b1}\u{4ba}\u{4bb}-]*[a-z0-9\u{430}-\u{44f}\u{451}\u{401}\u{457}\u{407}\u{456}\u{406}\u{454}\u{404}\u{4d8}\u{4d9}\u{492}\u{493}\u{49a}\u{49b}\u{4a2}\u{4a3}\u{4e8}\u{4e9}\u{4ae}\u{4af}\u{4b0}\u{4b1}\u{4ba}\u{4bb}.-]*[a-z0-9\u{430}-\u{44f}\u{451}\u{401}\u{457}\u{407}\u{456}\u{406}\u{454}\u{404}\u{4d8}\u{4d9}\u{492}\u{493}\u{49a}\u{49b}\u{4a2}\u{4a3}\u{4e8}\u{4e9}\u{4ae}\u{4af}\u{4b0}\u{4b1}\u{4ba}\u{4bb}]+$")))
(assert (or (not (= (str.indexof y "cus" 0) 133)) (= (str.indexof x "I" 0) 7) (= "t(1x contenteditable>test</ol>" (str.replace z ")""" "x"))))
(check-sat)
