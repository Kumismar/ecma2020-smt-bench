; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""117""><a href=""http://attacker.org"">") (= x "&lt;DIV STYLE=\""width&#58; expression(alert('XSS'));\""&gt;") (= x ">""><script>alert(""XSS"")</script>&")))
(assert (or (= z "=""alert(1)"">test</pre>") (= z "test</textarea>") (= z "s\u{10348}t</form>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^1((3|5|7|8){1}\d{1}|70)\d{8}$")) (not (= "S'));\""&gt" (str.substr x 47 10)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\S{4,20}$"))) (str.contains x "pt") (= (str.indexof y "t(""X" 0) 15)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z]{2,}\s[a-zA-z]{1,}'?-?[a-zA-Z]{2,}\s?([a-zA-Z]{1,})?)"))) (str.prefixof ">""><scrip" x)))
(assert (str.suffixof "re>" y))
(assert (not (str.contains x "ST")))
(check-sat)
