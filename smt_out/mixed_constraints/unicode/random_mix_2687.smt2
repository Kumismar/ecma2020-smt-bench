; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onreadystatechange=alert(1)></iframe>") (= x "<dt onmouseover=""alert(1)"">test</dt>")))
(assert (or (= z "mg>") (= z "=alert(1) tabindex=1 id=x></div><input autofocus>") (= z ":document.vulnerable=true;"">")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len z) 4)) (not (= (str.indexof x " " 0) 3)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\+[0-9]{2,3}|0+[0-9]{2,5}).+[\d\s\/\(\)-]")))))
(assert (str.prefixof ":docume" z))
(assert (or (= "></iframe" (str.substr y 35 9)) (str.suffixof "/dt>" x) (not (= (str.indexof z "1 i" 0) 19))))
(assert (not (str.prefixof "<" x)))
(assert (str.prefixof "<iframe" x))
(assert (or (str.contains y "1)""") (= " onbefor" (str.substr y 72 8)) (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Z|a-z|\s-]{4,17}"))))
(assert (or (= (str.indexof x "useo" 0) 8) (str.in_re z ((_ re.from_regex ecma2020 u) "^(0|[1-9][0-9]*)$"))))
(check-sat)
