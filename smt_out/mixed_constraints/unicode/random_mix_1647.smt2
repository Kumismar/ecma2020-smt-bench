; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ol id=x tabindex=1 onfocus=alert(1)></ol>") (= x "<fieldset onmouseover=""alert(1)"">test</fieldset>")))
(assert (or (= z "/hr>") (= z "s=foo>Some text</span>") (= z "tp://1113982867/""\u{1f4a9}>XSS</A>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "ie" 0) 2)) (str.prefixof "<menuite" x) (= (str.indexof x "x=1 o" 0) 16)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}._%+-]+@[A-Za-z0-9\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}.-]+\.[A-Za-z]{2,16}$"))) (not (= "t</span>" (str.substr z 14 10)))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^1(3|4|5|7|8)\d{9}$")))
(assert (or (not (>= (str.len y) 61)) (not (= (str.at y 19) " "))))
(check-sat)
