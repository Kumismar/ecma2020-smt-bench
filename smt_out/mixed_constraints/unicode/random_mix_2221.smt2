; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody onmousemove=""alert(1)"">test</tbody>") (= x "<optgroup onkeypress=""alert(1)"" contenteditable>test</optgroup>") (= x "<footer onbeforecut=""alert(1)"" contenteditable>test</footer>")))
(assert (or (= z "dragend=""alert(1)"">test</meta>") (= z "ror=""alert(String.fromCharCode(88,83,83))""></img>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 91) (not (= (str.indexof x "deo" 0) 32))))
(assert (or (>= (str.len z) 22) (not (str.contains y "t(1)"">te"))))
(assert (or (= "fo" (str.substr y 1 2)) (str.in_re x ((_ re.from_regex ecma2020 u) "^(\+)?\d{1,20}$")) (not (= (str.at x 18) "s"))))
(assert (= ")"" contjavascript:nteditable>test</article>" (str.replace z "e" "javascript:")))
(assert (not (= (str.len z) 49)))
(assert (or (str.suffixof "ng>" y) (= (str.at z 6) "d")))
(assert (or (str.prefixof "<tbod" y) (str.contains x "table>tes")))
(assert (not (str.suffixof "up>" x)))
(assert (not (= (str.at x 3) "o")))
(check-sat)
