; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><data id=x style=""transition:color 1s"" ontransitionend=alert(1)></data>") (= x "<style>@keyframes x{}</style><ul style=""animation-name:x"" onanimationend=""alert(1)""></ul>")))
(assert (or (= z "/ol>") (= z "urce src=""validvideo.mp4"" type=video/mp4></video>") (= z "cript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 66) (str.prefixof "<st" y) (not (= (str.at x 1) "s"))))
(assert (or (not (= "<style>:target {color:red;}< yle><data id=x style=""transition:color 1s"" ontransitionend=alert(1)></data>cript:alert(1)"" id=""fuzzelement1"">test</a>" (str.replace y "/st" " "))) (str.prefixof "<" y) (not (str.suffixof "ideo>" y))))
(assert (or (not (= (str.at x 0) "&")) (str.contains y "x style")))
(assert (or (not (str.contains x "ati")) (<= (str.len z) 53) (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z]\d[a-zA-Z] \d[a-zA-Z]\d)$|^\d{5}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(([X-Z]{1})(\d{7})([A-Z]{1}))|((\d{8})([A-Z]{1}))|(([A-Z]{1})(\d{8}))$"))))
(assert (or (not (= (str.indexof y "le><" 0) 26)) (not (= (str.indexof y "><dat" 0) 34))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{5}$$")))
(check-sat)
