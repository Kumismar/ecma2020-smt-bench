; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><p style=""animation-name:x"" onanimationstart=""alert(1)""></p>") (= x "<span onbeforepaste=""alert(1)"" contenteditable>test</span>") (= x "<svg><strong onload=alert(1)></strong>")))
(assert (or (= z "=x tabindex=1 onfocus=alert(1)></img>") (= z ")"">")))
(assert (= y (str.++ x z)))
(assert (= ")>" (str.replace z """" "")))
(assert (or (= "svg><stro" (str.substr x 1 9)) (not (str.contains z "tabinde"))))
(assert (not (= (str.len z) 37)))
(assert (or (str.prefixof "<" x) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{3} ?(?!sa|sd|ss|SA|SD|SS)[A-Za-z]{2}$")))))
(assert (or (not (str.contains (str.replace x ">" """") "le""@k")) (not (= (str.indexof y "tr" 0) 7)) (str.prefixof "<sp" x)))
(assert (= (str.at y 13) "o"))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[A-Za-z]).{1,}")))
(check-sat)
