; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen onblur=alert(1) tabindex=1 id=x></keygen><input autofocus>") (= x "<IMG LOWSRC=\""javascript:alert('XSS')\"">")))
(assert (or (= z "ansition:color 1s"" ontransitionend=alert(1)></nextid>") (= z "ed onmouseenter=""alert(1)"">test</noembed>") (= z "r.vibrate(500)")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "\d\d\d-\d\d\d-\d\d\d\d$"))))
(assert (or (not (= (str.indexof y "e" 0) 2)) (not (<= (str.len x) 45)) (not (str.prefixof "<I" x))))
(assert (or (= "r.vibr" (str.substr y 66 6)) (not (= (str.indexof x "=""t" 0) 14))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{10,11}$")))
(assert (or (not (<= (str.len y) 58)) (= "ed " (str.substr z 0 3))))
(assert (or (not (= (str.at z 39) "d")) (str.contains x "le") (= (str.indexof y "bin" 0) 28)))
(check-sat)
