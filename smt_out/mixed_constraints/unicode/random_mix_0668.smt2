; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><spacer onload=alert(1)></spacer>") (= x "<div draggable=""true"" contenteditable>drag me</div><dt ondrop=alert(1) contenteditable>drop here</dt>")))
(assert (or (= z "=""alert(1)"">test</sub>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "/d" 0) 46))
(assert (or (str.prefixof "ta onkey" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "((""[^<>""]*?""|[^<>"",]*?) *<[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*>|[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*)(, *((""[^<>""]*?""|[^<>"",]*?) *<[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*>|[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*))*"))) (str.contains x "le>")))
(assert (or (str.suffixof "er>" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z\u{c9}\u{e9}\u{c1}\u{e1}\u{f3}\u{d3}\u{ed}\u{cd}\u{fa}\u{da}]{2}[a-zA-Z\u{c9}\u{e9}\u{c1}\u{e1}\u{f3}\u{d3}\u{ed}\u{cd}\u{fa}\u{da}]+(([',. -][a-zA-Z\u{c9}\u{e9}\u{c1}\u{e1}\u{f3}\u{d3}\u{ed}\u{cd}\u{fa}\u{da} ])?[a-zA-Z\u{c9}\u{e9}\u{c1}\u{e1}\u{f3}\u{d3}\u{ed}\u{cd}\u{fa}\u{da}]*)*$")))))
(assert (or (str.suffixof "b>" z) (not (= (str.at z 0) ">"))))
(check-sat)
