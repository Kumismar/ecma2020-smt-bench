; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element onmouseenter=""alert(1)"">test</element>") (= x "<style>:target {color: red;}</style><figcaption id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></figcaption>") (= x "<style>@keyframes x{}</style><hr style=""animation-name:x"" onanimationend=""alert(1)""></hr>")))
(assert (or (= z " onmouseenter=""alert(1)"">test</ruby>") (= z "me>") (= z ";""></frameset>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "set>" (str.substr z 10 7))) (str.suffixof "hr>" x)))
(assert (or (not (= (str.indexof z ")" 0) 12)) (not (= "imatio" (str.substr y 62 6))) (not (= (str.at z 32) "u"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+$"))) (not (str.contains y "seent"))))
(assert (str.prefixof "<style" y))
(assert (or (not (= (str.indexof y "t</" 0) 36)) (str.suffixof "t>" x) (= "r=""ale" (str.substr y 20 6))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[-_+a-z0-9-A-Z]+(\.[-_+a-z0-9-A-Z]+)*@[a-z0-9-A-Z]+(\.[A-Z-a-z0-9-]+)*(\.[a-z-A-Z]{2,24})$"))) (str.prefixof "r" z)))
(check-sat)
