; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time id=x tabindex=1 onbeforedeactivate=alert(1)></time><input autofocus>") (= x "<data id=x tabindex=1 onactivate=alert(1)></data>") (= x "<bgsound draggable=""true"" ondrag=""alert(1)"">test</bgsound>")))
(assert (or (= z "raggable=""true"" contenteditable>drag me</div><content ondragover=alert(1) contenteditable>drop here</content>") (= z " style=""transition:color 10s"" ontransitioncancel=alert(1)></slot>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z ">drag" 0) 31) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\(?\+?[0-9]*\)?)?[0-9_\- \(\)]*$")))))
(assert (or (not (str.contains x "me><")) (not (<= (str.len z) 67))))
(assert (not (= (str.indexof y "rt(1)" 0) 44)))
(assert (not (str.contains (str.replace z "te" "x") "onxntedi")))
(assert (or (not (str.suffixof "ontent>" y)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{5c}u0600-\u{5c}u06FF \u{623}-\u{64a}]*$")))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "\d{3}\d{3}\d{3}\d{2}")) (not (= "<bgsound drag<b>=""true"" ondrag=""alert(1)"">test</bgsound>" (str.replace x "gable" "<b>")))))
(assert (or (not (<= (str.len y) 185)) (not (str.suffixof "rquee>" z)) (= (str.at x 33) "i")))
(assert (or (not (str.suffixof "('&#49;')" y)) (not (= "<time id=x tabindex=1 onbeforedeactivate=alert(1)></time><input autofojavascript: style=""transition:color 10s"" ontransitioncancel=alert(1)></slot>" (str.replace y "cus>" "javascript:")))))
(check-sat)
