; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><kbd style=""animation-name:x"" onanimationstart=""alert(1)""></kbd>") (= x "<bdi onkeypress=""alert(1)"" contenteditable>test</bdi>")))
(assert (or (= z "t autofocus>") (= z "rt(1)"">test</acronym>") (= z "rt=""alert(1)"">test</body>")))
(assert (= y (str.++ x z)))
(assert (not (= "forep" (str.substr x 11 5))))
(assert (or (= "<bdi onkeypress=""a 1)"" contenteditable>test</bdi>" (str.replace x "lert(" " ")) (not (str.contains (str.replace y "kbd s" " ") ">< tyle")) (not (str.suffixof "/body>" z))))
(assert (or (not (str.contains z "ert")) (not (= (str.len z) 12)) (not (= (str.at z 3) "t"))))
(assert (or (= (str.at y 177) "l") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s\-']+$")))))
(assert (or (= (str.at z 12) """") (not (str.contains z "tofoc"))))
(check-sat)
