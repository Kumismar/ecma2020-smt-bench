; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area onpaste=""alert(1)"" contenteditable>test</area>") (= x "<tfoot onbeforepaste=""alert(1)"" contenteditable>test</tfoot>")))
(assert (or (= z "acer onkeydown=""alert(1)"" contenteditable>test</spacer>") (= z ")""></body onunload>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "focus>" x) (not (= "acer onkeydown=""alert(1)""<b>ontenteditable>test</spacer>" (str.replace z " c" "<b>"))) (not (= (str.at y 104) "s"))))
(assert (not (= (str.at x 15) "p")))
(assert (not (str.contains (str.replace x "see" """") "ou""nter")))
(assert (str.suffixof " onunload>" y))
(assert (or (not (= (str.indexof y "1" 0) 24)) (not (<= (str.len z) 19))))
(assert (= (str.indexof y """ con" 0) 23))
(assert (or (str.contains z "dy onunloa") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.{1,16}$")))))
(assert (= " contented" (str.substr y 31 10)))
(check-sat)
