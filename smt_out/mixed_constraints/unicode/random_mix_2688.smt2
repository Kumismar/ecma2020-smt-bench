; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<BODY ONLOAD=alert('hellox worldss')>") (= x "\x3Cscript>javascript:alert(1)</script>") (= x "<h1 onpaste=""a\u{1d400}lert(\u{1d400}1)"" contenteditable>test</h1>")))
(assert (or (= z "1 ondeactivate=alert(1)></meta><input id=y autofocus>") (= z "e=""true"" ondragend=\u{10348}""alert(1)"">test</label>")))
(assert (= y (str.++ x z)))
(assert (or (= "alert(1)"">" (str.substr z 21 10)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,15}"))) (>= (str.len x) 29)))
(assert (or (= "aler" (str.substr z 21 4)) (not (str.contains z """></body"))))
(assert (or (not (str.prefixof "raggabl" z)) (str.contains y "wo") (not (= (str.len x) 37))))
(assert (str.contains z "rt("))
(assert (or (= " ondea" (str.substr z 1 6)) (not (= (str.indexof y "ditab" 0) 33))))
(assert (not (= (str.at x 37) "t")))
(assert (or (>= (str.len z) 54) (= (str.indexof x "h" 0) 20) (= (str.indexof y "ipt>" 0) 7)))
(check-sat)
