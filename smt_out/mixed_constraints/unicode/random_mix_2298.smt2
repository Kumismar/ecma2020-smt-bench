; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><marquee id=x style=""transition:transform 2s""\u{10348} ontransitionr\u{1f4a9}un=alert(1)></marquee>") (= x "<style onfocusout=alert(1) tabindex=1 id=x></style><input autofocus>")))
(assert (or (= z "dl id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></dl>") (= z "usemove=""alert(1)"">test</rt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z0-9-]*$"))) (= (str.at y 112) "u") (str.contains (str.replace x "s>" "alert(1)") "cualert(1)")))
(assert (= (str.at z 42) "n"))
(assert (not (str.suffixof "est</data>" x)))
(assert (not (str.suffixof "ert('XSS" x)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^(?![ .]+$)\d{10}$")) (not (str.suffixof "rt>" y))))
(assert (not (str.contains x "nsform:")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!.*gmail|.*outlook|.*yahoo|.*hotmail|.*lexter).*$"))) (str.contains (str.replace x "ate" "<b>") "l<b>\u{20000} id") (str.contains x "uee i")))
(assert (or (= (str.at z 26) "t") (not (= "<style>:target {transform: rotate(1<b>0deg);}</style><var id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></var>t</option>" (str.replace y "8" "<b>")))))
(check-sat)
