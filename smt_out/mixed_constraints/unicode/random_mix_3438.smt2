; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """>/XaDoS/><script>alert(document.cookie)</script><script src=""http://www.site.com/XSS.js""></script>") (= x "<ul onkeydown=""alert(1)"" contenteditable>test</ul>") (= x "<head id=x tabindex=1 onbeforedeactivate=alert(1)></head><input autofocus>")))
(assert (or (= z "e onkeydown=""alert(1)"" contenteditable>test</pre>") (= z "enteditable>test</details>") (= z "action="""" method=""post"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^(<|>)]+$"))) (= "#97s" (str.substr x 78 4))))
(assert (or (not (= (str.at z 23) "c")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9_ -\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}]{3,60}$")))))
(assert (or (not (str.prefixof """>/X" x)) (str.in_re z ((_ re.from_regex ecma2020 u) "[1-9]+.+[0-9]")) (= """post"">" (str.substr y 116 10))))
(assert (not (<= (str.len x) 109)))
(assert (not (str.contains y "d id=x ta")))
(check-sat)
