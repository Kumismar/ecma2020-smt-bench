; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><th style=""animation-name:x"" onanimationend=""alert(1)""></th>") (= x "<div draggable=""true"" contenteditable>drag me</div><rt ondrop=alert(1) contenteditable>drop here</rt>")))
(assert (or (= z "ocus>") (= z "ere</iframe>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 6) "r")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[7,8,9][0-9,+,-]{0,10}"))) (not (str.prefixof "ere</ifr" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z,A-Z]{2}[0-9]{8}$")))))
(assert (str.contains x "ocusout"))
(assert (or (str.contains (str.replace z "us>" "alert(1)") "calert(1)") (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{5,}"))) (not (str.contains y "tion"))))
(check-sat)
