; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><a style=""animation-name:x"" onanimationstart=""alert(1)""></a>") (= x "<time onkeypress=""alert(1)"" contenteditable>test</time>") (= x "<hr onblur=alert(1) tabindex=1 id=x></hr><input autofocus>")))
(assert (or (= z "draggable=""true"" contenteditable>drag me</div><abbr ondrop=alert(1) contenteditable>drop here</abbr>") (= z "ntenteditable>test</h1>") (= z "epaste=""alert(1)"" contenteditable>test</tt>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "st</h1>" y) (not (= (str.indexof x "t" 0) 2)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]{2,}\.[A-Za-z]{2,}$")))))
(assert (or (str.suffixof "est</h1>" z) (not (= (str.len z) 43))))
(assert (or (= ">" (str.substr z 45 1)) (str.prefixof "<hr onb" x)))
(assert (or (= (str.indexof y """ co" 0) 30) (= "<hr onblur=alert(1) tabindex=1 id=x> hr><input autofocus>ntenteditable>test</h1>" (str.replace y "</" " ")) (not (str.suffixof "age>" y))))
(assert (or (str.contains z "nteditabl") (not (= "<style>@keyframes x{}</style><a style=""axation-name:x"" onanimationstart=""alert(1)""></a>epaste=""alert(1)"" contenteditable>test</tt>" (str.replace y "nim" "x"))) (= "h1>" (str.substr y 75 7))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([1-9]\d*|0)$"))))
(assert (= (str.len y) 98))
(check-sat)
