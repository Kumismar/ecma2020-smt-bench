; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<!--<value><![CDATA[<XML ID=\u{10348}I><X><C><![CDATA[<IMG SRC=""javas<![CDATA[cript:alert('XSS')\u{1f4a9};"">") (= x "<div draggable=""true"" contenteditable>drag me</div><dd ondragover=alert(1) contenteditable>drop here</dd>") (= x "<img alt='%></xmp><img src=xx:x onerror=aler")))
(assert (or (= z ">") (= z "><rtc style=""animation-name:x"" onanimationend=""alert(1)""></rtc>") (= z """true"" ondragleave=""alert(1)"">test</embed>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "< <value><![CDATA[<XML ID=\u{10348}I><X><C><![CDATA[<IMG SRC=""javas<![CDATA[cript:alert('XSS')\u{1f4a9};"">" (str.replace x "!--" " "))) (not (= (str.at y 1) "i")) (not (str.prefixof "<div dr" y))))
(assert (or (not (= (str.at y 73) ">")) (not (= (str.len z) 63))))
(assert (not (= "aler" (str.substr x 40 6))))
(assert (or (= "<track d" (str.substr x 0 8)) (not (str.contains y "<XML I"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^(.){6,}$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{1,4}-\d{4}$|^\d{2,5}-\d{1,4}-\d{4}$"))) (not (= ")"">test<" (str.substr z 27 8)))))
(assert (or (not (str.prefixof "<menuitem " x)) (>= (str.len y) 163) (not (<= (str.len y) 175))))
(check-sat)
