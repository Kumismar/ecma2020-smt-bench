; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside onclick=""alert(1)"">test</asi\u{1d400}de>\u{20000}") (= x "<style>@keyframes x{}</style><frame style=""animation-name:x"" onanimationstart=""alert(1)""></frame>") (= x "<thead id=x tabindex=1 onfocus=\u{1f600}alert(1)></thead>")))
(assert (or (= z "st</area>") (= z "ion:color 1s"" ontransitionend=alert(1)></dialog>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[-+ 0-9]$"))))
(assert (or (not (>= (str.len x) 87)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\D?(\d{2})\D?\D?(\d{5})\D?(\d{4})$"))) (not (= "dex=1 " (str.substr x 17 6)))))
(assert (not (= (str.at z 8) ">")))
(assert (or (not (= (str.indexof x "c" 0) 9)) (not (= "<style>@keyfrxes x{}</style><frame style=""animation-name:x"" onanimationstart=""alert(1)""></frame>" (str.replace x "am" "x")))))
(assert (not (= "ert(1)>" (str.substr x 34 7))))
(check-sat)
