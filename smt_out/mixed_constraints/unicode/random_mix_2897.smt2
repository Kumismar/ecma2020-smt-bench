; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "0\""autofocus/onfocus=alert(1)--><video/poster/ error=prompt(2)>""-confirm(3)-""") (= x "<x ondrag=alert(1)>drag this!") (= x "<sup id=x tabindex=1 onfocus=alert(1)></sup>")))
(assert (or (= z "mark>") (= z "l-stylesheet type=""text/xml"" href=""#stylesheet""?>")))
(assert (= y (str.++ x z)))
(assert (or (= ">" (str.substr y 33 5)) (not (= (str.at y 0) "<"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{9}?$"))))
(assert (not (str.suffixof """" x)))
(assert (or (not (str.suffixof "nfirm(3)-""" x)) (= "t type=""te" (str.substr z 11 10)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:[3]{1,1}){1}[0-9]{9,9}$")))))
(assert (not (= "('" (str.substr y 78 2))))
(assert (str.contains x "tabi"))
(assert (= (str.len x) 32))
(check-sat)
