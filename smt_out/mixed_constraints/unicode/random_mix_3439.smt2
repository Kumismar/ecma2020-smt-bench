; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend onfocu\u{20000}sout=alert(1) tabindex=1 id=x></legend><inpu\u{1d400}t autofocus>") (= x "ABC<div style=""x:\x20expression(javascript:alert(1)"">DEF") (= x "<isindex draggable=""true"" ondragstart=""alert(1)"">test</isindex>")))
(assert (or (= z "nvas>") (= z ">test</strong>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z\u{c0}\u{c1}\u{c2}\u{c3}\u{c4}\u{c5}\u{c6}\u{c7}\u{c8}\u{c9}\u{ca}\u{cb}\u{cc}\u{cd}\u{ce}\u{cf}\u{d0}\u{d1}\u{d2}\u{d3}\u{d4}\u{d5}\u{d6}\u{d8}\u{d9}\u{da}\u{db}\u{dc}\u{dd}\u{de}\u{df}\u{e0}\u{e1}\u{e2}\u{e3}\u{e4}\u{e5}\u{e6}\u{e7}\u{e8}\u{e9}\u{ea}\u{eb}\u{ec}\u{ed}\u{ee}\u{ef}\u{f0}\u{f1}\u{f2}\u{f3}\u{f4}\u{f5}\u{f6}\u{f8}\u{f9}\u{fa}\u{fb}\u{fc}\u{fd}\u{fe}\u{ff}]*$"))) (not (= (str.indexof x "oc" 0) 11)) (= (str.at x 70) "s")))
(assert (or (= (str.indexof y "<is" 0) 0) (= "strong>" (str.substr y 63 7))))
(assert (or (str.contains (str.replace x "l" """") "<""egend") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s_.-]*$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.{10,11}$")))))
(assert (or (<= (str.len y) 92) (not (= (str.len x) 63))))
(assert (or (str.suffixof ">" z) (not (>= (str.len y) 66))))
(check-sat)
