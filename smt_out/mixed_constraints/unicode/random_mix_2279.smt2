; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#00060") (= x "<b <script>alert(1)</script>0") (= x "<div draggable=""true"" contenteditable>drag me</div><isindex ondragover=alert(1) contenteditable>drop here</isindex>")))
(assert (or (= z ".fromCharCode(88,83,83))"">") (= z "ivate=alert(1)></em>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "wbr>" y)) (>= (str.len z) 1) (not (= (str.at x 21) "i"))))
(assert (or (not (str.contains x "/div><isi")) (not (= (str.indexof z "e=al" 0) 4)) (not (str.contains y "ansitio"))))
(assert (not (str.prefixof "<di" y)))
(assert (or (str.prefixof "<div dra" x) (not (= (str.len y) 51))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{8,10}$"))) (not (= (str.at x 25) "p"))))
(check-sat)
