; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<! foo=""[[[Inception]]""><x foo=""]foo><script>alert(1)</script>"">") (= x "<script for=document event=onreadystatechange>getElementById('safe123').click()</script>") (= x "<xss id=x tabindex=1 onbeforeactivate=alert(1)></xss>")))
(assert (or (= z "alert(1)"" contenteditable>test</header>") (= z """true"" ondragend=""alert(1)"">test</tt>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len z) 43)) (not (<= (str.len z) 39)) (not (str.prefixof "<x" x))))
(assert (not (str.contains z "bel><input")))
(assert (not (<= (str.len x) 74)))
(assert (= ")></rtc>" (str.substr z 13 9)))
(assert (or (str.suffixof "></ins>" x) (not (str.contains (str.replace x "ldse" "x") "fiext")) (str.suffixof "t>" z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^((https?|ftp)://)?[^\s/$.?#]*\.[^\s]*$")) (not (str.suffixof "pt></svg>" x))))
(assert (not (= (str.at x 7) " ")))
(check-sat)
