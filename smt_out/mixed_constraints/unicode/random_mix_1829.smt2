; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a onkeydown=""alert(1)"" contenteditable>test</a>") (= x "<details onblur=alert(1) tabindex=1 id=x></details><input autofocus>") (= x "<;IMG SRC=';vbscript:msgbox("";XSS"";)';>;")))
(assert (or (= z "1)"">test</span>") (= z "ascript:alert('XSS')>; REL=stylesheet"">") (= z "ndex=1 onactivate=alert(1)></sup>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "((\d{5}))"))) (= "l" (str.substr x 37 1))))
(assert (or (not (>= (str.len z) 26)) (= (str.len z) 15) (= ";" (str.substr x 39 6))))
(assert (not (str.prefixof "<deta" x)))
(assert (not (= (str.at x 26) "n")))
(assert (or (not (= "own=""aler" (str.substr y 9 9))) (str.prefixof "<detail" y) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9@_.]{3,}$"))))
(assert (str.contains x "SS"))
(check-sat)
