; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section id=x tabindex=1 onfocusin=alert(1)></section>") (= x "eval(URL.slice(-8))>#alert(1)") (= x "<tt onblur=alert(1) tabindex=1 id=x></tt><input autofocus>")))
(assert (or (= z "ntenteditable>drop here</legend>") (= z " mask: url(#maskForClickjacking);""/>") (= z "/SCRIPT&gt;")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof ")" x)))
(assert (or (not (= (str.indexof x "=""t" 0) 18)) (str.contains x ") tabin")))
(assert (not (= (str.at z 2) "e")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^0\d{9,10}"))) (not (= "</legend>" (str.substr z 23 9)))))
(assert (= (str.indexof z ">" 0) 0))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{30a1}-\u{30f3}\u{30f4}\u{30fc}]+$")))
(assert (or (= "nblur=" (str.substr x 5 6)) (not (str.contains (str.replace x "al(U" " ") "ev RL.sl"))))
(assert (= "<param id=x tabindex=1 ondeactivate=alert(1)></param><input id=y javascript:focus>nt1"">test</a>" (str.replace y "auto" "javascript:")))
(assert (or (not (= (str.at x 32) "i")) (= (str.len x) 134) (str.prefixof "<tt on" x)))
(check-sat)
