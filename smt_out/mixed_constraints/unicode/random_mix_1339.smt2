; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#x3C") (= x "<dir onkeyup=""alert(1)"" contenteditable>test</dir>") (= x "<h1 oncontextmenu=""alert(1)"">test</h1>")))
(assert (or (= z "t(1)"" contenteditable>test</noframes>") (= z "yframes x{}</style><command style=""animation-name:x"" onanimationstart=""alert(1)""></command>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len x) 29)) (= (str.indexof z "of" 0) 29)))
(assert (or (= (str.indexof x "cri" 0) 5) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9]){1,5}$"))) (not (str.suffixof "</br>" x))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "\([0-9]{2}\) [0-9]{4,5}-[0-9]{4}$"))))
(assert (or (str.contains (str.replace y "it" """") "ented""a") (not (= "name\u{20000}=""password"" type=""password"" v""ue=""secret"" />" (str.replace z "al" """")))))
(check-sat)
