; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option draggable=""true"" ondragstart=""alert(1)"">test</option>") (= x "<div draggable=""true"" contenteditable>drag me</div><multicol ondragover=alert(1) contenteditable>drop here</multicol>") (= x "<i onmouseleave=""alert(1)"">test</i>")))
(assert (or (= z "rough=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= z "pt language=""JavaScript"">alert('XSS')</script>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<div drag" y))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[-+ 0-9]$"))))
(assert (not (str.contains x "test</i")))
(assert (or (= (str.at z 50) "v") (not (= "<i onmouseleave=""alert(1)"">test</i>pt language=""JavaSct"">alert('XSS')</script>" (str.replace y "rip" "")))))
(assert (not (str.contains z "guage=")))
(assert (or (>= (str.len x) 51) (= (str.at y 126) "r")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z.]*")) (str.suffixof "tion>" x)))
(check-sat)
