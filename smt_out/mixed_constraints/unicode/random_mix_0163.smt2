; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><noembed onload=alert(1)></noembed>") (= x "<aside draggable=""true"" ondrags\u{20000}tart=""alert(1)"">test</as\u{10348}ide>") (= x "<sub onkeydown=""alert(1)"" contenteditable>test</sub>")))
(assert (or (= z "ate=alert(1)></ol>\u{1f4a9}<input id=y autofocus>") (= z "d=x></marquee><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "drags\u{20000}") (not (= "est</" (str.substr y 30 5))) (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9A-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}&\+\.\s\-]+"))))
(assert (not (= "alert(1)" (str.substr z 4 8))))
(assert (or (not (<= (str.len x) 60)) (not (= (str.len z) 31)) (not (<= (str.len z) 10))))
(assert (= (str.indexof z "e=ale" 0) 2))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^(\d{1})$")))
(assert (or (not (= "d=x></marquee><input javascript:ofocus>" (str.replace z "aut" "javascript:"))) (str.contains (str.replace y "ide d" "alert(1)") "<asalert(1)ra")))
(assert (not (str.contains x "nkeydo")))
(check-sat)
