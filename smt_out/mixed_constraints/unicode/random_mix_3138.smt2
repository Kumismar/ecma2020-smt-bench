; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a onfocusout=alert(1) tabindex=1 id=x></a><input autofocus>") (= x "ABC<div style=""x:\x09expression(javascript:alert(1)"">DEF") (= x "<tbody onclick=""alert(1)"">test</tbody>")))
(assert (or (= z "alert(1)"">test</tfoot>") (= z "ndblclick=""alert(1)"">test</tr>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 8) "s"))
(assert (or (str.prefixof "ndblc" z) (not (= (str.len z) 25))))
(assert (or (str.contains (str.replace x "ert" """") "t:al""(1)") (str.contains z "est")))
(assert (or (str.suffixof "/tfoot>" y) (str.prefixof "ndblcli" z) (str.in_re y ((_ re.from_regex ecma2020 u) "^((\+|00)33\s?|0)[1-9](\s?\d{2}){4}$"))))
(check-sat)
