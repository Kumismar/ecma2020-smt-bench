; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike onkeypress=""alert(1)"" contenteditable>test</strike>") (= x "'); alert('xss'); var x='")))
(assert (or (= z "ert(1)"">test</a>") (= z ";") (= z "CharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "ar x") (not (= (str.at z 15) ">"))))
(assert (or (str.prefixof "<strike " y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?\d{1,3}?[- .]?\(?(?:\d{2,3})\)?[- .]?\d\d\d[- .]?\d\d\d\d$")))))
(assert (or (str.contains y "; va") (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}")))))
(assert (or (not (= "><" (str.substr y 58 2))) (= (str.at y 71) "8") (not (str.contains (str.replace z ",83)" "javascript:") "88,83javascript:)"">"))))
(assert (or (str.prefixof "<stri" y) (not (str.contains y "t('xss')"))))
(assert (or (not (= (str.len y) 80)) (str.contains (str.replace z ";" "javascript:") "javascript:")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{5}$"))))
(check-sat)
