; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup id=x tabindex=1 onactivate=alert(1)></sup>") (= x "http://www.simpatie.ro/index.php?page=top_movies&cat=13&p=2 p=2 ??XSS??") (= x "<footer onfocusout=alert(1) tabindex=1 id=x></footer><input autofocus>")))
(assert (or (= z "&#46;com&#46;/\""&gt;XSS&lt;/A&gt;") (= z "le=""true"" ondragleave=""alert(1)"">test</marquee>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 38) ",")))
(assert (= (str.at x 30) "e"))
(assert (not (>= (str.len y) 116)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9 a-z A-Z]$"))) (not (= (str.len y) 64)) (not (= "pt" (str.substr x 2 2)))))
(assert (or (= "&#46;com&#46;/<b>&gt;XSS&lt;/A&gt;" (str.replace z "\""" "<b>")) (= "p id" (str.substr x 3 4)) (str.contains x "cu")))
(assert (or (str.contains (str.replace x "cus" "") "onfoout") (not (str.suffixof "autofocus>" x))))
(check-sat)
