; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot id=x tabindex=1 onbeforeactivate=alert(1)></tfoot>") (= x "<shadow onpaste=""alert(1)"" contenteditable>test</shadow>") (= x "<iframe draggable=""true"" ondrag=""alert(1)"">test</iframe>")))
(assert (or (= z "t>") (= z "us>") (= z "table>test</option>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([A-Za-z]+(\.?\s)?)+[A-Za-z]+$"))))
(assert (or (not (= (str.indexof y ">" 0) 48)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "\b[a-zA-Z0-9-_.]+@[a-zA-Z0-9-_]+\.?[a-zA-Z0-9a-zA-Z0-9-_]+?\.(com|us|org|me|net|info|edu)\b")))))
(assert (not (str.contains x "itabl")))
(assert (or (str.prefixof "<tfo" x) (str.suffixof "/option>" y)))
(assert (or (= (str.at x 39) "=") (>= (str.len y) 111) (= (str.at z 0) "t")))
(check-sat)
