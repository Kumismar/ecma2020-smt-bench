; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article onkeydown=""alert(1)"" contenteditable>test</article>") (= x "<pre onpaste=""alert(1)"" contenteditable>test</pre>")))
(assert (or (= z "ml oncopy=""alert(1)"" contenteditable>test</html>") (= z "</style><center id=x style=""transition:color 1s"" ontransitionend=alert(1)></center>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof ">" z))
(assert (not (= (str.indexof x "1)" 0) 20)))
(assert (or (not (= (str.indexof z "(" 0) 16)) (= (str.len y) 133)))
(assert (or (not (<= (str.len x) 56)) (= (str.at z 21) "c") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{0,3}$")))))
(assert (or (not (<= (str.len x) 60)) (not (str.contains y "cl"))))
(assert (or (= "editable>" (str.substr y 37 9)) (not (= (str.at y 74) "r"))))
(assert (or (str.contains x "lert") (str.contains (str.replace x "t(1" " ") "aler )") (str.contains y "est")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?:19|20)[0-9]{2}-(?:(?:0[1-9]|1[0-2])/(?:0[1-9]|1[0-9]|2[0-9])|(?:(?!02)(?:0[1-9]|1[0-2])/(?:30))|(?:(?:0[13578]|1[02])-31))"))))
(check-sat)
