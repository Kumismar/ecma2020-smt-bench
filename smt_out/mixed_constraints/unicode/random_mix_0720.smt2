; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noframes id=x tabindex=1 onfocusin=alert(1)></noframes>") (= x "<menuitem onmouseleave=""alert(1)"">test</menuitem>")))
(assert (or (= z "aste=""alert(\u{20000}1)"" contenteditable>tes\u{1f600}t</track>") (= z "ontextmenu=""alert(1)"">test</figcaption>") (= z ">@keyframes x{}</style><menu style=""animation-name:x"" onanimationstart=""alert(1)""></menu>")))
(assert (= y (str.++ x z)))
(assert (not (= "<noframes id=x tabindex=1 onfocusin=alert(1)></noframes>aste=""alert(\u{20000}1)"" contenteditablealert(1)es\u{1f600}t</track>" (str.replace y ">t" "alert(1)"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{5}$|^\d{5}-\d{4}$")) (str.prefixof "<n" x)))
(assert (or (not (= "ontextmex=""alert(1)"">test</figcaption>" (str.replace z "nu" "x"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\d{3}\d{4}")))))
(assert (or (not (= (str.at y 103) "o")) (str.contains z "rt(1)></c")))
(assert (or (str.contains z "(\u{20000}1)") (= "am" (str.substr z 7 2)) (not (str.suffixof "/track>" z))))
(check-sat)
