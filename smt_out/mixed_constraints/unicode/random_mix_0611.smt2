; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><s ondrop=alert(1) contenteditable>drop here</s>") (= x "<listing draggable=""true"" ondragenter=""alert(1)"">test</listing>")))
(assert (or (= z ")"">test</td>") (= z "amp onmouseout=""alert(1)\u{10348}"">test</\u{1d400}samp>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "amp>" y) (>= (str.len x) 98)))
(assert (not (str.suffixof "g>" x)))
(assert (or (not (= (str.at x 82) "b")) (str.contains (str.replace y "onte" "") "e"" cntedi")))
(assert (or (= (str.at x 75) "n") (= "ndr" (str.substr x 27 3)) (str.suffixof "</dl>" x)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z]*$|^[A-Za-z][A-Za-z ]*[A-Za-z]$"))))
(check-sat)
