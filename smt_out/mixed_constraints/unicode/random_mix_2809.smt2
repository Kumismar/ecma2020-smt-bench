; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<template id=x tabindex=1 onactivate=alert(1)></template>") (= x "<form><a href=""javascript:\u{5c}u0061lert&#x28;1&#x29;"">X")))
(assert (or (= z "=""alert(1)"">test</figcaption>") (= z "ur=alert(1) tabindex=1 id=x></u><input autofocus>") (= z "t onblur=alert(1) tabindex=1 id=x></output><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "rm><" 0) 3) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{406}\u{456}\u{407}\u{457}\u{404}\u{454}\s]+$"))) (= "rt&#x" (str.substr y 34 5))))
(assert (or (not (= (str.len z) 17)) (str.contains x "ctivat") (str.suffixof "autofocus>" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.+@\S+\.\S+$"))) (str.prefixof "<templ" y) (= " id=x>" (str.substr y 85 6))))
(assert (str.prefixof "<form" y))
(assert (or (not (= (str.at z 23) "d")) (= (str.indexof x "rip" 0) 21)))
(assert (or (= "lert&#x2" (str.substr y 32 8)) (= (str.at z 1) "r")))
(check-sat)
