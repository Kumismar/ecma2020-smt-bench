; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a onmouseover=""alert(document.cookie)"">xxs link</a>") (= x "<footer id=x tabindex=1 onbeforedeactivate=alert(1)></footer><input autofocus>")))
(assert (or (= z "dt onpaste=""alert(1)"" contenteditable>test</dt>") (= z "10s"" ontransitioncancel=alert(1)></script>") (= z "rop here</area>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "a>" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z\u{139}\u{17a}\u{102}\u{13d}\u{102}\u{b6}\u{c4}\u{b1}\u{c4}\u{17a}\u{102}\u{a7}\u{139}\u{17e}\u{102}\u{15b}\u{102}\u{2013}\u{c4}\u{b0}\u{c4}\u{17e}\u{102}\u{2021}0-9-_\.]{1,15}$"))) (not (str.contains (str.replace x "rt(d" """") """ale""ocume"))))
(assert (or (= (str.at y 59) "e") (not (str.contains (str.replace z "rt(1" "alert(1)") "=""alealert(1))"">"))))
(assert (not (str.contains y "te=""alert")))
(assert (not (= "transit" (str.substr z 7 7))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "(\+[\d]{1,5}|0)?[6-9]\d{9}$")) (not (= (str.at y 91) "t")) (str.contains x "ct")))
(assert (or (not (str.contains y """alert(")) (not (= (str.at y 19) "r"))))
(check-sat)
