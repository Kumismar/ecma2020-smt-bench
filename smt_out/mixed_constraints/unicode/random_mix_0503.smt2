; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onmousedown=""alert(1)""\u{1f4a9}\u{20000}>test</iframe>") (= x "<img onmouseenter=""alert(1)"">test</img>") (= x "<col draggable=""true"" ondragend=""alert(1)"">test</col>")))
(assert (or (= z "ee>") (= z "nobr ondblclick=""alert(1)"">test</nobr>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "va"))
(assert (or (not (= "<img onmouseenter=""alert(1)"">temg>" (str.replace x "st</i" ""))) (not (str.prefixof "<i" y))))
(assert (or (not (= "<o tgroup draggable=""true"" ondrag=""alert(1)"">test</optgroup>k onclick=""alert(1)"">test</blink>" (str.replace y "p" " "))) (str.prefixof "ee>" z)))
(assert (or (str.contains z "ee>") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s0-9 ]*$")))))
(assert (or (= "<img onmouseenter=""alert(1)"">test</img " (str.replace y ">ee>" " ")) (not (= (str.at x 4) "a"))))
(assert (or (not (= "img>nobr " (str.substr y 35 9))) (not (= "rue"" on" (str.substr x 17 7))) (not (str.prefixof "<img dr" x))))
(check-sat)
