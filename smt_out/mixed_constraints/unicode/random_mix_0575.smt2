; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<content onfocusout=alert(1) tabindex=1 id=x></content><input autofocus>") (= x "&lt;&lt;SCRIPT&gt;alert(&quot;XSS&quot;);//&lt;&lt;/SCRIPT&gt;")))
(assert (or (= z "</rtc>") (= z "&{()}") (= z "vate=alert(1)></nextid>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "t(1)" 0) 36) (str.in_re y ((_ re.from_regex ecma2020 u) "^([0-9 /.,]){1,}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "(((\d{2}((0[13578]|1[02])(0[1-9]|[12]\d|3[01])|(0[13456789]|1[012])(0[1-9]|[12]\d|30)|02(0[1-9]|1\d|2[0-8])))|([02468][048]|[13579][26])0229))(( |-)(\d{4})( |-)([01]8((( |-)\d{1})|\d{1}))|(\d{4}[01]8\d{1}))"))))
(assert (or (not (str.contains (str.replace y "t;&lt" " ") "&l ;SCR")) (not (str.prefixof "<" z)) (not (str.suffixof "&{()}" z))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[^':]*$"))))
(assert (= (str.indexof z "&{()" 0) 0))
(assert (or (not (str.suffixof "*""" z)) (not (= (str.indexof x ";);//" 0) 38)) (= (str.at z 2) "(")))
(check-sat)
