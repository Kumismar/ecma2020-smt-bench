; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><rtc id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></rtc>") (= x "<style>@keyframes x{}</style><bgsound style=""animation-name:x"" onanimationstart=""alert(1)""></bgsound>")))
(assert (or (= z "=""alert(1)"" contenteditable>test</form>") (= z "rames x{}</style><i style=""animation-name:x"" onanimationstart=""alert(1)""></i>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<style" y)) (str.prefixof "=""alert(1" z) (str.contains z "content")))
(assert (or (not (= (str.indexof x "80" 0) 35)) (not (str.prefixof "<" y))))
(assert (or (not (str.contains (str.replace x "-na" "javascript:") "ationjavascript:me:")) (= "=""alert(1)"" contenteditable>te""/form>" (str.replace z "st<" """"))))
(assert (or (= "<s id=x tabindex=1 ondeactivate=alert(1)<b></s>\u{1d400}<input id=y autofocus>" (str.replace x ">" "<b>")) (not (= (str.at x 32) "e"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z]).{8,}"))))
(check-sat)
