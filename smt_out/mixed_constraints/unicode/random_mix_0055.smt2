; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<td onmouseenter=\u{10348}""alert(1)"">test</td>") (= x "<div draggable=""true"" contenteditable>drag me</div><template ondragover=alert(1) contenteditable>drop here</template>") (= x "<BODY onload!#$%%&()*~+-_.,:;?@[/|\]^`=javascript:alert(1)>")))
(assert (or (= z "forecopy=""alert(1)"" contenteditable>test</noframes>") (= z "lert(1)"">test</span>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z "(1)"">" 0) 4))
(assert (or (not (= (str.at z 3) "<")) (not (str.suffixof "e>" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451} ]+$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Z\u{c5}\u{c4}\u{d6}\u{c6}\u{d8}\u{cb}\u{c9}\u{c8}\u{ca}\u{db}\u{dc}a-z\u{e5}\u{e4}\u{f6}\u{e6}\u{f8}\u{eb}\u{e9}\u{e8}\u{ea}\u{fb}\u{fc}\s\-]{1,50}$"))) (not (str.prefixof "lert(1)"">" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "([A-Za-z._ ]?)+([A-Za-z\u{e9}\u{e1}\u{171}\u{fa}\u{151}\u{f3}\u{fc}\u{f6}\u{ed}\u{c9}\u{c1}\u{170}\u{da}\u{150}\u{d3}\u{dc}\u{cd}_ ]{2,})")))))
(assert (not (= (str.indexof y "te" 0) 68)))
(assert (or (= (str.indexof z "/nofr" 0) 41) (str.contains z "(1)"">tes")))
(assert (not (str.prefixof "<div dra" y)))
(check-sat)
