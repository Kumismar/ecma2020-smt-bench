; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address onkeydown=""alert(1)"" contenteditable>test</address>") (= x "<div draggable=""true"" contenteditable>drag me</div><iframe ondragover=alert(1) contenteditable>drop here</iframe>")))
(assert (or (= z ">alert(document.cookie)</script>") (= z "rt(1)"">test</dl>") (= z "onbeforeactivate=alert(1)></area>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<address" y)) (>= (str.len z) 23) (not (str.suffixof "p>" y))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z'  -]+$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?!:\/\/)(([a-zA-Z0-9]+\.)+)?[a-zA-Z0-9][a-zA-Z0-9-]+\.[a-zA-Z]{2,6}?$")))))
(assert (or (not (<= (str.len z) 25)) (not (= "<address onkeydown=""alert(1)"" content""itable>test</address>" (str.replace x "ed" """"))) (str.contains y ">alert(d")))
(assert (or (= (str.indexof x "c" 0) 22) (not (str.suffixof "st</dl>" y))))
(assert (not (str.suffixof "ess>" x)))
(check-sat)
