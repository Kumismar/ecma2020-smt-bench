(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption ondblclick=""alert(1)"">test</caption>") (= x "<div draggable=""true"" contenteditable>drag me</div><frame ondrop=alert(1) contenteditable>drop here</frame>")))
(assert (or (= z "S&apos;);&quot;&gt;") (= z "arCode(88,83,83))"">") (= z "1)"">test</address>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "db" "x") "on onxlcl")) (not (str.contains x " d"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_]*$"))) (str.suffixof "source>" x) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9\u{5c}u4e00-\u{5c}u9fa5]{2,30}")))))
(assert (or (not (str.prefixof "<div" y)) (not (= (str.indexof z "(8" 0) 6)) (str.contains x "co")))
(assert (or (not (= (str.indexof x "x t" 0) 10)) (= (str.at z 4) "d") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\-\\'\u{2019}\u{201b}\u{2018}\u{201d}\u{201f}\u{201c}"" ]*$")))))
(assert (or (= (str.indexof y "o" 0) 23) (not (= (str.at x 102) "r"))))
(check-sat)
