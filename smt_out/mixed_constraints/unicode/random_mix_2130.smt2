; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;A HREF=&quot;http://%77%77%77%2E%67%6F%6F%67%6C%65%2E%63%6F%6D&quot;&gt;XSS&lt;/A&gt;") (= x "<footer o\u{10348}nmouseout=""alert(1)"">test</footer>")))
(assert (or (= z "rea>") (= z "col\u{1f600}or 1s"" ontransitionend=alert(1)></wbr>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "%2E%6")) (= "tgro" (str.substr z 19 4)) (not (str.contains (str.replace z "r " "") "l\u{1f600}o1s"" o"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9]{4}-[0-1][0-9]|[0-9][0-9])-(3[01]|[12][0-9]|0[1-9])$"))) (not (str.contains y "</details>"))))
(assert (not (= (str.indexof x "&quo" 0) 11)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[^:\x22]+"))) (not (= "transition" (str.substr z 13 10)))))
(assert (or (not (= "<r o\u{10348}nmouseout=""alert(1)"">test</footer>rea>" (str.replace y "foote" ""))) (not (= "eout=" (str.substr y 15 5)))))
(assert (or (>= (str.len z) 39) (not (str.contains (str.replace z "on" "<b>") "s"" <b>t")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\(([0-9\s]){3}\)\s??([0-9\s]){9}$")))))
(check-sat)
