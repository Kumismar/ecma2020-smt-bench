; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select draggable=""true"" ondragend=""alert(1)"">test</select>") (= x "<style>:target {color: red;}</style><abbr id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></abbr>")))
(assert (or (= z "cut=""alert(1)"" contenteditable>test</basefont>") (= z "=""alert(1)"">test</track>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "(?=^.{0,40}$)^\+?(\d[\d\-\.\s]+)?(\([\d\-\.\s]+\))?[\d\-\.\s]+\d$")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{0,25}$")))))
(assert (or (not (str.suffixof ">" x)) (str.suffixof "st</track>" y) (not (str.contains (str.replace z "nam" "x") "n-xe:x"""))))
(assert (or (not (str.contains x "ect dragga")) (not (= (str.at z 8) "1")) (not (str.contains (str.replace y "tab" "<b>") "ntedi<b>le>te"))))
(assert (not (= (str.at z 28) "l")))
(assert (or (not (str.contains y "ransit")) (str.contains (str.replace x "sit" "javascript:") """tranjavascript:ion:c")))
(assert (not (str.prefixof "<a href=" x)))
(check-sat)
