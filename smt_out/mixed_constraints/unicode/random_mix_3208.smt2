; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1f4a9}rtc id=x tabindex=1 onbeforeactivate=alert(1)></rtc>") (= x "<rp id=x tabindex=1 onbeforedeactivate=alert(1)></rp><input autofocus>")))
(assert (or (= z "mmary>") (= z "ame:x"" onanimationend=""alert(1)""></option>") (= z ">test</section>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "c>mmary>" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "([0-9\+\/\(\)\-]{5,})*$"))) (not (str.contains y "st</sectio"))))
(assert (or (>= (str.len y) 73) (not (str.contains y "nput aut"))))
(assert (or (not (str.contains y "/rtc>am")) (= (str.at y 74) "d") (str.in_re x ((_ re.from_regex ecma2020 u) "[A-z 0-9]{0,40}"))))
(assert (str.contains (str.replace y "nbef" "<b>") "1 o<b>orede"))
(assert (or (= (str.indexof z "/sect" 0) 6) (not (= "vid" (str.substr y 1 3))) (not (= "/canva" (str.substr x 35 6)))))
(check-sat)
