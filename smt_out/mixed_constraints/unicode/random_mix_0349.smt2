; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x15javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<time draggable=""true"" ondrag=""alert(1)"">test</time>") (= x "<ul draggable=""true"" ondrag=""alert(1)"">test</ul>")))
(assert (or (= z "ave=""alert(1)"">test</kbd>") (= z "aggable=""true"" ondrag=""alert(1)"">test</slot>") (= z "ect onerror=javascript:javascript:alert(1)>")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*\(?(020[1-9]{1}\)?[ ]?[1-9]{1}[0-9{2}[ ]?[0-9]{4})|(0[1-8]{1}[0-9]{3}\)?[ ]?[1-9]{1}[0-9]{2}[ ]?[0-9]{3})\s*$")))
(assert (or (<= (str.len x) 63) (not (str.contains y "RC=x ")) (str.contains (str.replace y "drag=" "javascript:") "onjavascript:""al")))
(assert (or (not (str.suffixof "slot>" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Z|a-z|0-9]*"))) (not (str.prefixof "<style>" y))))
(assert (or (= (str.at z 9) "o") (= "/tim" (str.substr y 46 4)) (str.contains z """true"" ")))
(assert (or (not (= (str.at z 37) "i")) (not (= "rag=" (str.substr z 18 4))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{c0}-\u{ff} .'\u{b4}`-]+$"))))
(assert (= "<time draggable=""true"" ond<b>alert(1)"">test</time>ave=""alert(1)"">test</kbd>" (str.replace y "rag=""" "<b>")))
(assert (str.suffixof "ml>" y))
(check-sat)
