; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<set attributeName=""xlink:href"" begin=""accessKey(b)"" to=""//example.com/?b"" />") (= x "<title oncut=""alert(1)"" contenteditable>test</title>")))
(assert (or (= z "lert(1)"">test</audio>") (= z "1)></noframes><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "essKe" "x") "ccxy(b)""") (not (str.suffixof "autofocus>" y))))
(assert (<= (str.len x) 62))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "[^()+^#|\u{a7}\u{192}!\u{d1}\u{d0}\u{be}{}))\u{b0}*$\u{b5}`\u{a3}E%\u{b4}`=?;@><\][\\\x22,;|]+")))
(assert (not (str.suffixof "st</rp>" z)))
(assert (or (not (= "script/src=data:,alealert(1))>" (str.replace z "rt(" "alert(1)"))) (str.contains (str.replace x "hr o" "alert(1)") "<alert(1)nc") (not (str.suffixof "b"" />" x))))
(assert (or (str.prefixof "1)></nof" z) (= "</" (str.substr z 13 2))))
(assert (or (not (= (str.at x 3) "t")) (= "alert(1)""" (str.substr x 14 9)) (not (str.prefixof "lert(1" z))))
(check-sat)
