; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script\x09>javascript:alert(1)</script>") (= x "<header oncut=""alert(1)"" contenteditable>test</header>")))
(assert (or (= z "1)><svg/1='") (= z "ter=""alert(1)"">test</textarea>") (= z "r>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "xtarea>" y)))
(assert (not (= """ " (str.substr x 23 2))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-z]+([\s][a-zA-Z]+)*$")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d+$"))))
(assert (str.contains (str.replace y "(1)" "x") "lertx"""))
(assert (or (not (= (str.indexof z "1='" 0) 8)) (not (str.suffixof ">" z)) (not (= "t\x09>" (str.substr y 6 6)))))
(assert (not (= (str.indexof x "n" 0) 9)))
(assert (or (not (str.contains (str.replace x "eade" "alert(1)") "<halert(1)r ")) (not (= "t(1)</sc" (str.substr x 27 8)))))
(check-sat)
