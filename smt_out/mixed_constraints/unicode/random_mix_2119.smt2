; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript id=x tabindex=1 onactivate=alert(1)></noscript>") (= x "<td ondblclick=""alert(1)"">test</td>")))
(assert (or (= z "le>test</basefont>") (= z "mation-name:x"" onanimationend=""alert(1)""></svg>") (= z "ut=""alert(1)"">test</wbr>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^(14)$")) (str.in_re x ((_ re.from_regex ecma2020 u) "^\+?[1-9]\d{1,14}$")) (not (str.suffixof ">" z))))
(assert (not (= (str.indexof z """a" 0) 3)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "\b[\w\.-]+@((?!gmail|yahoo|outlook|aol|mail|protonmail|icloud|gmx|yandex).)[\w\.-]+\.\w{2,4}\b"))) (not (= (str.at x 36) "="))))
(assert (or (not (str.suffixof "t</wbr>" y)) (not (= ">test</td>" (str.substr y 25 10))) (= (str.indexof x "bl" 0) 7)))
(assert (or (not (str.prefixof "<script" x)) (not (<= (str.len y) 109))))
(assert (not (str.prefixof "le>test" z)))
(assert (= "<noscr<b>pt id=x tabindex=1 onactivate=alert(1)></noscript>ut=""alert(1)"">test</wbr>" (str.replace y "i" "<b>")))
(check-sat)
