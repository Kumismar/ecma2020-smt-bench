; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nobr draggable=""true"" ondragend=""alert(1)"">test</nobr>") (= x "<h1 onkeyup=""alert(1)"" contenteditable>test</h1>")))
(assert (or (= z "wbr onfocuso\u{10348}ut=alert(1) tabindex=1 id=x></wbr><input autofocus>") (= z "</hgroup>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "st</h1>" x))
(assert (not (str.contains (str.replace x "ente" "") " contd")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "\([0-9]{2}\)[\s]{0,1}[0-9]{4,5}-[0-9]{4}$")))
(assert (or (not (str.suffixof "up>" z)) (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!s).*$")) (not (str.suffixof "nobr>" x))))
(assert (or (= (str.len y) 71) (str.contains z "ndex=1") (not (= (str.at x 35) "b"))))
(assert (not (= (str.at x 38) "t")))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-z0-9-\u{f1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{d1}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}]+$")))
(check-sat)
