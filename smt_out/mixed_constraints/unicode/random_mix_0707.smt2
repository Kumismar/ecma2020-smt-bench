; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><xss style=""animation-name:x"" onanimationend=""alert(1)""></xss>") (= x "<style onkeydown=""alert(1)"" contenteditable>test</style>")))
(assert (or (= z "index=1 onfocus=alert(1)></image>") (= z "est</dir>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 88) "s") (not (str.contains x "nt"))))
(assert (or (not (str.suffixof "st</style>" x)) (str.contains y "eyframes ")))
(assert (or (not (= (str.len x) 91)) (str.suffixof """></xss>" x) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:(\(?(0|\+44)[1-9]{1}\d{2,4}?\)?\s?\d{3,4}\s?\d{3,4}))?$")))))
(assert (or (>= (str.len z) 27) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{1,12}$")))))
(assert (str.prefixof "<styl" y))
(assert (or (not (= (str.at x 40) "b")) (not (= "<style>@keyframes x{}</style><xss style=""animation-name:x"" onanimationend=""rt(1)""></xss>" (str.replace x """ale" """")))))
(assert (or (not (str.prefixof "<s" x)) (str.contains z """ conte")))
(check-sat)
