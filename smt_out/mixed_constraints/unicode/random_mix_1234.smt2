; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr id=x tabindex=1 onactivate=alert(1)></hr>") (= x "\u{2018})alert(1);//")))
(assert (or (= z "lert(1)"">test</rb>") (= z "uee onstart='javascript:alert('1');'>=(\u{25d5}_\u{25d5})=") (= z "style=""transition:transform 10s"" ontransitioncancel=alert(1)></xss>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "cus>" 0) 86) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9][a-zA-Z0-9_-]+([.][a-zA-Z0-9_-]+)*[@][a-zA-Z0-9_-]+([.][a-zA-Z0-9_-]+)*[.][a-zA-Z]{2,}$"))) (<= (str.len z) 34)))
(assert (not (= (str.len x) 13)))
(assert (or (= (str.indexof z "=" 0) 5) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]+ [a-zA-Z]+$")) (not (= (str.indexof x "/hr>" 0) 41))))
(assert (or (not (str.prefixof "\u{2018})alert(" y)) (not (= (str.at y 52) "6"))))
(check-sat)
