; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src ?itworksonchrome?\/onerror = alert(1)") (= x "<base onkeyup=""alert(1)"" c\u{1f4a9}ontenteditable>test</base>") (= x "<bdo onmousedown=""a\u{10348}lert(1)"">test</bdo>")))
(assert (or (= z """alert(1)"" contenteditable>test</mark>") (= z "=""alert(1)"">test</frame>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace z "le" " ") "a rt("))
(assert (not (str.contains x "mo")))
(assert (or (not (str.prefixof "<bdo onmou" x)) (not (= "or " (str.substr x 33 3)))))
(assert (or (str.contains (str.replace y "</fr" """") "test""ame") (= (str.indexof x "?itw" 0) 9) (str.prefixof "=""alert" z)))
(assert (= (str.at y 43) "e"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?!(^[.-].*|.*[.-]@|.*\.{2,}.*)|^.{254}.+@)([a-z0-9!#$%&'*+\/=?^_`{|}~.-]+@)(?!.{253}.+$)((?!-.*|.*-\.)([a-z0-9-]{1,63}\.)+[a-z]{2,}|(([01]?[0-9]{2}|2([0-4][0-9]|5[0-5])|[0-9])\.){3}([01]?[0-9]{2}|2([0-4][0-9]|5[0-5])|[0-9]))"))) (= (str.indexof z "va" 0) 5) (not (= (str.at y 31) "r"))))
(assert (or (not (str.contains x "a\u{10348}ler")) (not (= (str.at z 9) ")"))))
(check-sat)
