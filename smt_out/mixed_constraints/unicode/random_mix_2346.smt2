; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=""livescript:[code]"">") (= x "<progress id=x tabindex=1 onactivate=alert(1)></progress>")))
(assert (or (= z "bindex=1 onbeforeactivate=alert(1)></object>") (= z "true"" ondragenter=""alert(1)"">test</thead>") (= z "1)"" contenteditable>test</tfoot>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 3) "m")) (= (str.indexof y "agsta" 0) 25)))
(assert (or (str.contains (str.replace y "nt" " ") "e er=""a") (= "oot>" (str.substr y 85 5))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0][12345679][-. ]?\d{2}[-. ]?\d{2}[-. ]?\d{2}[-. ]?\d{2}$$"))) (not (= "/" (str.substr y 65 1))) (not (str.suffixof "st</tfoot>" z))))
(assert (or (= "</tf" (str.substr z 24 4)) (not (str.prefixof "<IMG SRC" x))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^\D{1,30}$")))
(check-sat)
