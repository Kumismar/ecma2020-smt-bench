; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><header id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></header>") (= x "<iframe  src=""data:text/html,%3C%73%63%72%69%70%74%3E%61%6C%65%72%74%28%31%29%3C%2F%73%63%72%69%70%74%3E""></iframe>") (= x "<font id=x tabindex=1 onbeforeactivate\u{20000}=alert(1)></font>")))
(assert (or (= z "ex=1 id=x></address><input autofocus>") (= z "t(1)"">test</listing>") (= z ")%253c/script%253e")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "72%74%28%") (not (str.suffixof "/listing>" z)) (= (str.at x 10) "r")))
(assert (or (str.suffixof "ofocus>" z) (not (str.prefixof "t(1)""" z)) (str.contains (str.replace y "e)""" "<b>") "ooki<b>>")))
(assert (or (= (str.at x 30) "3") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^1[3|4|5|7|8][0-9]\d{8}$"))) (str.suffixof "s>" y)))
(assert (or (str.prefixof "<font id=" x) (= (str.indexof y ")></f" 0) 47) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{4}[\-\/\s]?((((0[13578])|(1[02]))[\-\/\s]?(([0-2][0-9])|(3[01])))|(((0[469])|(11))[\-\/\s]?(([0-2][0-9])|(30)))|(02[\-\/\s]?[0-2][0-9]))$")))))
(assert (or (str.contains (str.replace y "est<" """") ">t""/") (not (= (str.len y) 63))))
(check-sat)
