; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table draggable=""true"" ondrag\u{20000}start=""alert(1)"">test</t\u{1f600}able>") (= x "<fieldset oncontextmenu=""alert(1)"">test</fieldset>")))
(assert (or (= z " style=""font-family:'sans\27\3B color\3Ared\3B'"">X</div></div> <script>with(document.getElementById(""d""))innerHTML=innerHTML</script>") (= z "nkeyup=""alert(1)"" contenteditable>test</isindex>") (= z "se>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{2,5}-?\d{1,4}-?\d{3,4}"))) (str.suffixof "ndex>" y)))
(assert (or (not (>= (str.len x) 46)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?=.*[A-Z])(?=.*[0-9])(?=.*[a-z]).{8,128}$"))) (not (= "<IMG SRC=x ontoggle=""alert(String.fromCharCode(88,8alert(1))"">ntenteditable>test</dd>" (str.replace y "3,83)" "alert(1)")))))
(assert (not (str.suffixof "/t\u{1f600}able>" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "1{1}(\d){10}"))) (str.prefixof "c" z)))
(assert (not (= (str.at z 0) "s")))
(check-sat)
