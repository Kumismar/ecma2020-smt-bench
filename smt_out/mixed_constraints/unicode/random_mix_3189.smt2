; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li onblur=alert(1) tabindex=1 id=x></li><input autofocus>") (= x "<frame oncopy=""alert(1)"" contenteditable>test</frame>") (= x "<i onmousemove=""alert(1)"">test</i>")))
(assert (or (= z "opy=""a\u{1f4a9}lert(1)"" contenteditable>test</sect\u{20000}ion>") (= z "r=""alert(1)"">test</main>") (= z "ring.fromCharCode(88,83,83))</SCRIPT>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z'  -]+$"))) (>= (str.len x) 58)))
(assert (or (= (str.at x 10) "=") (not (str.contains z "table>tes"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9.!#$%&\u{e2}\u{20ac}\u{2122}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*"))) (not (= "nput au" (str.substr z 14 7)))))
(assert (or (str.contains z "83))</SCR") (= (str.at z 7) "o") (not (str.suffixof "focus>" x))))
(assert (= (str.at y 6) "b"))
(assert (= (str.indexof y "i" 0) 37))
(check-sat)
