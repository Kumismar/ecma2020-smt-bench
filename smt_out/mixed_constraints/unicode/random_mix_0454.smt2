; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<? echo('<SCR)';") (= x "<body onbeforeunload=""location='javascript:alert(1)'"">")))
(assert (or (= z "seover=""alert(1)"">test</li>") (= z "e</div><footer ondrop=alert(1) contenteditable>drop here</footer>") (= z ";")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 0) ";")))
(assert (str.suffixof "(1)'"">" x))
(assert (not (str.contains (str.replace y "(" " ") "echo '<SCR")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-z]+([\s][a-zA-Z]+)*$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{e1}\u{10d}\u{10f}\u{e9}\u{11b}\u{ed}\u{148}\u{f3}\u{159}\u{161}\u{165}\u{16f}\u{fa}\u{fd}\u{17e}\u{c1}\u{10c}\u{10e}\u{c9}\u{cd}\u{11a}\u{147}\u{d3}\u{158}\u{160}\u{164}\u{da}\u{16e}\u{dd}\u{17d}\s\.\-]*"))))
(assert (or (str.contains z """>test</l") (not (str.prefixof "e</div><fo" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[_A-Za-z0-9-+.]+([_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(.[A-Za-z0-9-]+)*(.[A-Za-z]{2,4}){1,2}$")))))
(assert (str.suffixof "'<SCR)';" x))
(assert (or (not (= (str.indexof y "t<" 0) 37)) (not (= "onactivate" (str.substr z 11 10)))))
(check-sat)
