; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" con\u{1f600}tenteditable>drag me</div><base ondrop=alert(1) contenteditable>drop here</base>") (= x "<audio src/onerror=alert(1)>") (= x "<pre onmouseout=""alert(1)"">test</pre>")))
(assert (or (= z "lor 1s"" ontransitionend=alert(1)></acronym>") (= z "e=""true"" contenteditable>drag me</div><kbd ondrop=alert(1) contenteditable>drop here</kbd>") (= z "=""alert('xss');"";eval(a+b+c+d);")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "/" 0) 36)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{3,4}$"))) (not (str.prefixof "<" y)) (not (str.prefixof "<au" y))))
(assert (or (= (str.len z) 90) (= "g me" (str.substr y 56 4))))
(assert (or (not (str.contains (str.replace x "nmous" "javascript:") " ojavascript:eo")) (not (= "kbd ondr" (str.substr z 39 8)))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "15$"))))
(assert (or (str.prefixof "<audio " x) (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z]{3}$"))))
(assert (or (str.suffixof ");" y) (= (str.len x) 28)))
(check-sat)
