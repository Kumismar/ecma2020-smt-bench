; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i id=x tabindex=1 onactivate=alert(1)></i>") (= x "<style>:target {color:red;}</style><aside id=x style=""transition:color 1s"" ontrans\u{1d400}itionend=aler\u{1f600}t(1)></aside>") (= x "<link onkeyup=""alert(1)"" contenteditable>test</link>")))
(assert (or (= z "</div><col ondragover=alert(1) contenteditable>drop here</col>") (= z "dragend=""alert(1)"">test</iframe>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<i id" y)))
(assert (or (str.prefixof "</div" z) (not (str.suffixof "</h1>" z)) (str.suffixof "iframe>" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\$\d\., ]+$"))) (str.contains z "/i") (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{3,80}$")))))
(assert (or (not (= (str.at z 14) "(")) (str.suffixof "ere</col>" y)))
(check-sat)
