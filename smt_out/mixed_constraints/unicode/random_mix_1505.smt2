; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;OBJECT TYPE=\""text/x-scriptlet\"" DATA=\""http&#58;//ha&#46;ckers&#46;org/scriptlet&#46;html\""&gt;&lt;/OBJECT&gt;") (= x "<figure onkeydown=""alert(1)"" contenteditable>test</figure>") (= x "<xmp id=x tabindex=1 ondeacti\u{1f600}vate=alert(1)></xmp><input id=y autofocus>")))
(assert (or (= z "(1)></slot>") (= z "t:document.vulnerable=true;"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "ofo" "alert(1)") "y autalert(1)cus>t")) (str.prefixof "e=""t" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([1-9]|[12]\d|30)$"))) (= "&lt;OBjavascript: TYPE=\""text/x-scriptlet\"" DATA=\""http&#58;//ha&#46;ckers&#46;org/scriptlet&#46;html\""&gt;&lt;/OBJECT&gt;" (str.replace x "JECT" "javascript:"))))
(assert (= (str.len y) 126))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_\-\.\+]{1,}@([\da-zA-Z-]{1,}\.){1,}[\da-zA-Z-]{2,20}$")))
(assert (or (not (str.contains (str.replace x "o" " ") "=1  ndeac")) (= """http&#58;" (str.substr x 43 10)) (= (str.at x 12) "s")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z-_ ][a-zA-Z-_ \\s]+$"))) (str.suffixof "t</figure>" x)))
(check-sat)
