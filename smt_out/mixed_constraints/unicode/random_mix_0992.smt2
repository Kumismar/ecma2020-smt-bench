; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dl id=x tabindex=1 onfocusin=alert(1)></dl>") (= x "<ins onkeydown=""alert(1)"" contenteditable>test</ins>")))
(assert (or (= z "ansition:color 10s"" ontransitioncancel=alert(1)></bdo>") (= z "></video>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "></vid") (= (str.at x 6) "=") (not (= (str.indexof y "eo>" 0) 50))))
(assert (or (not (= (str.at x 9) "1")) (not (= (str.at z 7) "e")) (not (str.suffixof "></video>" z))))
(assert (or (not (str.prefixof "<dl id=" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^1((3|5|7|8){1}\d{1}|70)\d{8}$")))))
(assert (<= (str.len x) 57))
(assert (or (str.contains y "lert(1)></") (not (str.contains (str.replace y "></v" "alert(1)") "s>alert(1)ideo>"))))
(assert (or (str.prefixof "<dl id=x" y) (str.prefixof "<d" y)))
(assert (or (<= (str.len x) 44) (>= (str.len x) 50)))
(check-sat)
