; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp id=x tabindex=1 onactivate=alert(1)></samp>") (= x "<wbr onmouseenter=""alert(1)"">test</wbr>")))
(assert (or (= z "x=1 onfocusin=alert(1)></aside>") (= z "e:x"" onanimationend=""alert(1)""></audio>") (= z "!-- Up to Opera 11.64 - see link below -->")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<sam" x)))
(assert (or (= "ttp:" (str.substr x 48 4)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^...*")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(\+)?([- \(\)]*[0-9]){5,}[- \(\)]*$"))) (not (str.contains (str.replace x "d=" "x") "ode ixx ")) (= (str.at z 18) "d")))
(assert (or (not (= "t(1)></sa" (str.substr x 37 9))) (= (str.indexof x "rt" 0) 98) (>= (str.len z) 38)))
(assert (not (= (str.at x 24) "(")))
(check-sat)
