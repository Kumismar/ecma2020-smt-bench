; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<fieldset onmousedown=""alert(1)"">test</fieldset>") (= x "<video><track default onload=alert(1) src=""data:text/vtt,WEBVTT""></video>")))
(assert (or (= z "ert(1)"" contenteditable>test</pre>") (= z " id=x tabindex=1 onbeforeactivate=alert(1)></var>") (= z "able>drag me</div><ruby ondrop=alert(1) contenteditable>drop here</ruby>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z "lert" 0) 14))
(assert (not (= (str.indexof x "ta" 0) 45)))
(assert (<= (str.len y) 97))
(assert (or (not (= (str.at y 66) "1")) (not (= "ldset>" (str.substr x 42 6))) (not (= "E" (str.substr y 58 1)))))
(assert (= "p=aler" (str.substr y 77 6)))
(assert (not (str.prefixof "<s" x)))
(assert (or (str.contains (str.replace y "onmo" "alert(1)") "et alert(1)usedo") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$")))))
(assert (= (str.len y) 90))
(assert (= (str.indexof z "uby>" 0) 68))
(check-sat)
