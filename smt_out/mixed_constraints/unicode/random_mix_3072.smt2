; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ol draggable=""true"" ondragstart=""alert(1)"">test</ol>") (= x "<picture><source srcset=""validimage.png""><image onloadend=alert(1)></picture>") (= x "<section id=x tabindex=1 onbeforeactivate=alert(1)></section>")))
(assert (or (= z "bed \u{1d400}onmouseleave=""alert(1)"">test</noembed>") (= z "i>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 14) """")) (str.prefixof "<ol" x)))
(assert (or (= (str.indexof z ">" 0) 1) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:19|20)[0-9]{2}-(?:(?:0[1-9]|1[0-2])-(?:0[1-9]|1[0-9]|2[0-9])|(?:(?!02)(?:0[1-9]|1[0-2])-(?:30))|(?:(?:0[13578]|1[02])-31))$")))))
(assert (not (= (str.len z) 2)))
(assert (or (not (= (str.at z 1) ">")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\d\d\d\d\d\d\d\d\d\d$"))) (not (= "sect" (str.substr x 53 4)))))
(assert (or (not (= (str.indexof y "1 on" 0) 23)) (not (= (str.indexof x "et=""" 0) 21))))
(check-sat)
