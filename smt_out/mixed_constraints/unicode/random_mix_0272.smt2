; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:\xE2\x80\x89expression(javascript:alert(1)"">DEF") (= x "<form><input formaction=javascript:alert(1) type=image src=SOURCE>")))
(assert (or (= z "seout=""alert(1)"">test</bdo>") (= z "content><input autofocus>") (= z "tml;base64,PHNjcmlwdD5hbGVydCgnWFNTJyk8L3NjcmlwdD4K\""&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (= "><input au" (str.substr y 73 10))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{1}.{1,}[a-zA-Z0-9]$")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9-_]+$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^(\d{3,4}-)?\d{7,8})$|^(13|15|18|14)\d{9}$"))))
(assert (or (= "cus>" (str.substr z 21 4)) (not (= (str.at x 33) ">")) (= (str.indexof y "s" 0) 7)))
(assert (or (= "iv sty" (str.substr x 5 6)) (str.suffixof "do>" y) (not (str.contains (str.replace y "rm><" " ") "fo inp"))))
(assert (= (str.at x 19) "t"))
(check-sat)
