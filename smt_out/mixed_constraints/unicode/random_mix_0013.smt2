; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;TABLE&gt;&lt;TD BACKGROUND=\""javascript&#058;alert('XSS')\""&gt;") (= x "<div id=""108""><!-- IE 5-8 standards mode -->")))
(assert (or (= z "ition:transform 2s"" ontransitionrun=alert(1)></th>") (= z "t(1)></rb><input id=y autofocus>") (= z "(1) tabindex=1 id=x></style><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y """" 0) 23) (not (= "<div id=""108""><!-- IE 5-8 standards mode<b>>" (str.replace x " --" "<b>")))))
(assert (or (= (str.len y) 94) (not (= (str.indexof y "vali" 0) 17)) (not (str.prefixof "<d" y))))
(assert (or (not (= (str.at x 31) "=")) (not (str.prefixof "t(1)><" z))))
(assert (or (str.suffixof "mode -->" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(|[0-9][0-9]*)$"))) (not (str.prefixof "&lt;TABLE" y))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[_A-zA-z- ]{1,}$"))) (not (= (str.indexof x " -->" 0) 40))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([\w\.-]+@[\w\.-]+?\.[\w-]+\w)?$"))))
(check-sat)
