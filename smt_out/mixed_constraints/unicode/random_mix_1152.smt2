(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "er" 0) 10)) (not (= (str.at z 8) "s")) (not (= (str.indexof y ">" 0) 30))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\w]{8,}$"))) (= (str.indexof z "=ale" 0) 12)))
