; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<template onmouseleave=""alert(1)"">test</template>") (= x "<style>@keyframes x{}</style><option style=""animation-name:x"" onanimationstart=""alert(1)""></option>") (= x "<isindex onclick=""alert(1)"">test</isindex>")))
(assert (or (= z "d=x onfocus=alert(1) type=text/html>") (= z "v draggable=""true"" contenteditable>drag me</div><blockquote ondragover=alert(1) contenteditable>drop here</blockquote>")))
(assert (= y (str.++ x z)))
(assert (or (= "o" (str.substr x 13 1)) (str.in_re z ((_ re.from_regex ecma2020 u) "(0)\d{9}"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{3}\s?[0-9]{2}$"))) (= (str.at x 38) "d")))
(assert (not (= "e " (str.substr z 58 2))))
(assert (or (not (= "v dra<b>ble=""true"" contenteditable>drag me</div><blockquote ondragover=alert(1) contenteditable>drop here</blockquote>" (str.replace z "gga" "<b>"))) (not (str.contains (str.replace x "/" "x") "est<xtem"))))
(assert (or (str.prefixof "v drag" z) (= "v draggxle=""true"" contenteditable>drag me</div><blockquote ondragover=alert(1) contenteditable>drop here</blockquote>" (str.replace z "ab" "x"))))
(assert (or (= "\u{1d400}t(1)""" (str.substr y 166 6)) (not (str.contains x "<option")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z\s]+)$")))))
(assert (or (not (>= (str.len x) 90)) (str.suffixof "index>" x)))
(assert (not (str.suffixof "dex>" x)))
(check-sat)
