; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame onbeforecut=""alert(1)"" contenteditable>test</frame>") (= x "<style>:target {color:red;}</style><col id=x style=""transition:color 1s"" ontransitionend=alert(1)></col>") (= x "<menu onkeyup=""alert(1)"" contenteditable>test</menu>")))
(assert (or (= z "sfer.setData('text/plain','malicious code');""><h1>Drop me</h1></div>") (= z "able>test</rp>") (= z "t><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "[[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$")) (= (str.len z) 19) (= (str.len z) 1)))
(assert (not (= "st" (str.substr z 7 2))))
(assert (str.contains x "rt(1)"" con"))
(assert (str.suffixof "</abbr>" z))
(assert (or (not (= (str.len y) 77)) (not (str.prefixof "<div o" x)) (not (= (str.at z 3) "i"))))
(check-sat)
