; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sty\u{1f4a9}le>@keyframes x{}</style><shadow style=""animation\u{1d400}-name:x"" onanimationstart=""alert(1)""></shadow>") (= x "//<form/action=javascript&#x3A;alert&lpar;document&period;cookie&rpar;><input/type='submit'>//")))
(assert (or (= z "javascript:document.vulnerable=true;"">") (= z "ntenteditable>drag me</div><keygen ondragover=alert(1) contenteditable>drop here</keygen>") (= z "st</fieldset>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "t" 0) 10)) (= (str.at z 71) "d")))
(assert (or (str.contains x "ion:absolu") (not (= "<sty\u{1f4a9}lekeyframes x{}</style><shadow style=""animation\u{1d400}-name:x"" onanimationstart=""alert(1)""></shadow>javascript:document.vulnerable=true;"">" (str.replace y ">@" "")))))
(assert (or (<= (str.len z) 40) (= (str.indexof z """;" 0) 10) (= "le><shado" (str.substr y 27 9))))
(assert (or (not (= (str.at x 4) "\u{1f4a9}")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[\u{5c}u00BF-\u{5c}u1FFF\u{5c}u2C00-\u{5c}uD7FF\w ]{3,35}"))) (not (= (str.at z 16) "a"))))
(assert (not (str.prefixof "ntent" z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "2[0-9]{3}"))))
(check-sat)
