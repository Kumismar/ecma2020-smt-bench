; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup id=x tabindex=1 onfocusin=alert(1)></colgroup>") (= x "<element id=x tabindex=1 onbeforeactivate=alert(1)></element>")))
(assert (or (= z "=""alert(1)"" contenteditable>test</big>") (= z "y>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 0) "y")))
(assert (or (str.contains (str.replace x "sin=a" "") "nfocul") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]+\.?[0-9]*")))))
(assert (or (not (= (str.indexof x "emen" 0) 3)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?[0-9]{1}[0-9 ]{2,16}[0-9]{1}$"))) (not (str.prefixof "=""alert(1" z))))
(assert (not (str.suffixof "big>" z)))
(assert (or (not (= (str.at z 26) "e")) (not (= (str.len x) 61)) (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@(?!gmail.com)(?!yahoo.com)(?!hotmail.com)(?!hotmail.co.il)(?!walla.co.il)(?!mail.ru)(?!outlook.com)(?!email.com)(?!icloud.com)(?!me.com)[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$"))))
(assert (or (str.suffixof "g>" z) (not (>= (str.len y) 91)) (not (= (str.at z 14) "n"))))
(check-sat)
