; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onmouseout=""alert(1)"">test</rtc>") (= x "<style>@keyframes x{}</style><marquee style=""animation-name:x"" onanimationend=""alert(1)""></marquee>") (= x "<ul onmousedown=""alert(1)"">test</ul>")))
(assert (or (= z "rt(1)></blockquote>") (= z "frame><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 16) "u")))
(assert (str.suffixof "ofocus>" y))
(assert (or (str.suffixof "ockquote>" y) (not (= "rt(1)"">tes" (str.substr y 20 10)))))
(assert (not (= (str.indexof x "/marq" 0) 90)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-f0-9]*$")) (not (= (str.indexof z "mage>" 0) 6))))
(assert (or (not (= (str.at z 7) "i")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{1,15}$")))))
(check-sat)
