; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time onpaste=""alert(1)"" contenteditable>test</time>") (= x "<keygen onmouseup=""alert(1)"">test</keygen>") (= x "<marquee id=x tabindex=1 onbeforedeactivate=alert(1)></marquee><input autofocus>")))
(assert (or (= z "onkeypress=""alert(1)"" contenteditable>test</frame>") (= z "ure onpaste=""alert(1)"" contenteditable>test</figure>") (= z "nte\u{10348}nteditable>test</ul\u{1d400}>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "en" 0) 27) (str.suffixof "81%29;" z)))
(assert (or (not (str.suffixof "t</ul\u{1d400}>" z)) (not (str.prefixof "onke" z)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,40}$"))))
(assert (or (str.contains x "nmou") (not (= "script U" (str.substr z 4 8))) (not (= (str.indexof x "nmo" 0) 9))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[1][3,4,5,7,8][0-9]{9}$")) (str.contains y " o")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-1][0-9]|2[0-3]):[0-5][0-9]$")) (not (str.suffixof "est</dd>" x))))
(check-sat)
