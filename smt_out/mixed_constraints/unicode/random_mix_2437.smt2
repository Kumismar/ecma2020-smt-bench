; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img SRC=""javascript:document.vulnerable=tru\u{20000}e;""") (= x "<style>@keyframes x{}</style><ul style=""animation-name:x"" onanimationend=""alert(1)""></ul>")))
(assert (or (= z "1s"" ontransitionend=alert(1)></sup>") (= z "(1) tabindex=1 id=x></kbd><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 0) "<")) (str.contains (str.replace x "n" "alert(1)") "=0 oalert(1)f") (str.prefixof "<st" y)))
(assert (or (<= (str.len z) 43) (str.suffixof ">" y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(11)$")))))
(assert (or (not (<= (str.len y) 94)) (= "rt(1)></s" (str.substr z 23 9)) (= "ndex=" (str.substr y 56 5))))
(assert (not (<= (str.len x) 85)))
(assert (or (= (str.indexof z "onten" 0) 8) (not (str.contains (str.replace y "put " "") "inautof"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{3}-\d{10}$")) (not (= "e" (str.substr x 53 1)))))
(assert (not (str.contains (str.replace y "t(" "x") "lerx1)")))
(check-sat)
