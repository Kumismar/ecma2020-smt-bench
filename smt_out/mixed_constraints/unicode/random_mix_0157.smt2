; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<set attributeName=""xlink:href"" begin=""accessKey(d)"" to=""//example.com/?d"" />") (= x "<body onbeforeprint=alert(1)>")))
(assert (or (= z "le><slot id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></slot>") (= z "/style><label id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></label>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\.\-\+]+)@([\da-zA-Z\.\-]+)\.([a-zA-Z\.]{2,12})$"))) (= "tra" (str.substr y 130 3))))
(assert (or (not (= "body" (str.substr x 1 4))) (= (str.indexof x "ert" 0) 22)))
(assert (not (= (str.indexof z " id=" 0) 8)))
(assert (or (str.prefixof "<set at" x) (not (str.prefixof "<pict\u{1f4a9}ur" y)) (= (str.indexof y "le\u{10348}" 0) 34)))
(assert (= "<style>:target {c""or:red;}</style><map id=x style=""transition:color 1s"" ontransitionend=alert(1)></map>test</progress>" (str.replace y "ol" """")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^((\+|00)33\s?|0)[1-9](\s?\d{2}){4}$")))
(check-sat)
