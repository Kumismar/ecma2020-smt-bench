; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 onpaste=""a\u{1d400}lert(\u{1d400}1)"" contenteditable>test</h1>") (= x "<style>@keyframes x{}</style><element style=""animation-name:x"" onanimationend=""alert(1)""></element>")))
(assert (or (= z " autofocus>") (= z " src=""about:blank"" onerror=javascript:alert(1)//></style>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._+-]+@[a-z0-9.-]+\.[a-z]{2,4}$")) (not (str.contains y "er")) (str.suffixof ");\u{201d}>" z)))
(assert (not (= (str.at z 43) "(")))
(assert (or (not (<= (str.len y) 97)) (= "r" (str.substr z 2 1))))
(assert (or (not (= (str.indexof x "l" 0) 4)) (not (= (str.indexof x "mpt(" 0) 24)) (not (str.contains y "ert(1)"))))
(check-sat)
