; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onmouseup=""alert(1)"">test</input>") (= x "<element draggable=""true"" ondragleave=""alert(1)"">test</element>") (= x "<meta draggable=""true"" ondragleave=""alert(1)"">test</meta>")))
(assert (or (= z "></canvas>") (= z "s>") (= z "XSS\u{2019})>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "put>s>" y) (not (= "XS<b>)>" (str.replace z "S\u{2019}" "<b>")))))
(assert (or (not (= "=y\u{20000} autofo" (str.substr z 11 10))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{8,9}$"))) (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[!@#/$%^&*]).{6,20}"))))
(assert (= (str.at x 23) "e"))
(assert (or (not (= "<meta draggable=""true"" ondra e=""alert(1)"">test</meta>" (str.replace x "gleav" " "))) (not (<= (str.len z) 3))))
(assert (<= (str.len z) 15))
(check-sat)
