; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<td onkeyup=""alert(1)"" contenteditable>test</td>") (= x "<style>@keyframes x{}</style><style style=""animation-name:x"" onanimationend=""alert(1)""></style>")))
(assert (or (= z ">test</img>") (= z "h1 onmousemove=""alert(1)"">test</h1>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "st" 0) 1)))
(assert (= (str.at z 29) "t"))
(assert (or (str.suffixof "test</img>" y) (= (str.at x 13) "a") (str.contains (str.replace z "st</" "<b>") ">te<b>i")))
(assert (or (str.contains z "r") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?:05)\d{8}$")))))
(assert (str.suffixof """>test</a>" y))
(assert (or (= "end=""alert" (str.substr x 72 10)) (not (>= (str.len z) 83)) (not (= (str.at x 6) "k"))))
(assert (or (= "t>" (str.substr x 56 3)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9 +]{9,15}$")))))
(check-sat)
