; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;A HREF=\""http&#58;//1113982867/\""&gt;XSS&lt;/A&gt;") (= x "<base onmouseup=""alert(1)"">test</base>") (= x "<dd id=x tabindex\u{10348}=1 onde\u{20000}activate=alert(1)></dd><input id=y autofocus>")))
(assert (or (= z "eg);}</style><p id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></p>") (= z "ditable>test</nobr>") (= z "rt(1)></img>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "}" z)) (str.contains (str.replace z "en" "javascript:") "gjavascript:d=""al")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^IH.+"))) (= (str.indexof x " id" 0) 3) (str.contains z ")></i")))
(assert (or (= (str.at z 1) "t") (not (str.suffixof "tion>is!" y)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9-]+\.)+[A-Za-z]{2,10}$")))))
(assert (not (= "img>" (str.substr z 8 6))))
(check-sat)
