; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input type=""text"" value=``<div/onmouseover='alert(1)'>X</div>") (= x "&#x3C;") (= x "<script>alert('XSS');</script>")))
(assert (or (= z "applet>") (= z "tofocus>") (= z ")"" contenteditable>test</var>")))
(assert (= y (str.++ x z)))
(assert (or (= "&" (str.substr x 0 1)) (str.prefixof "<input ty" y)))
(assert (or (not (str.prefixof "ndblc" z)) (not (str.contains (str.replace z "ble" "x") "itax>"))))
(assert (= "i" (str.substr x 2 1)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Z]{1}[0-9]{7}[A-Z0-9]{1}$|^[T]{1}[A-Z0-9]{8}$|^[0-9]{8}[A-Z]{1}$")) (not (str.suffixof "/script>" x)) (not (= ">" (str.substr x 54 1)))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[+()0-9]{1,}$"))))
(assert (or (str.suffixof "s>" z) (not (= "javascript:us>" (str.replace z "tofoc" "javascript:"))) (str.contains y "rt(1)""")))
(assert (= (str.at x 47) "e"))
(assert (str.prefixof "<inp" y))
(check-sat)
