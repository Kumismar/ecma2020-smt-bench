; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><a ondrop=alert(1) contenteditable>drop here</a>") (= x "<title onblur=alert(1) tabindex=1 id=x></title><input autofocus>") (= x "<address onkeydown=""alert(1)"" contenteditable>test</address>")))
(assert (or (= z "rt(1)"">test</object>") (= z "ion:color 1s"" ontransitionend=alert(1)></nobr>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 47) (= (str.len x) 60) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}0-9.-]+\.[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}]{2,}$")))))
(assert (not (str.contains (str.replace z "onend" "") "ti=al")))
(assert (or (str.suffixof "p here</a>" x) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1-9]\d{5}[1-9]\d{3}((0\d)|(1[0-2]))(([0|1|2]\d)|3[0-1])\d{4}$"))) (not (>= (str.len z) 36))))
(assert (or (= "></titl" (str.substr x 38 7)) (not (str.suffixof "r>" y))))
(assert (or (not (str.contains y "re</a>")) (str.suffixof "1)></nobr>" y)))
(check-sat)
