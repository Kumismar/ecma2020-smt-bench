; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><bgsound id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></bgsound>") (= x "<noembed \u{1d400}onmouseleave=""alert(1)"">test</noembed>") (= x "<legend onkeyup=""alert(1)"" contenteditable>test</legend>")))
(assert (or (= z """true"" ondragenter=""alert(1)"">test</legend>") (= z "onmousemove=""alert(1)"">test</marquee>") (= z "npaste=alert(1) autofocus></textarea>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "c" 0) 70) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-z0-9._%+-]{1,127}@[A-z0-9.-]+\.[A-z]{2,3}$")))))
(assert (or (= (str.indexof x "t" 0) 6) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{c0}-\u{fa}\s]{2,50}$"))) (not (str.prefixof "<styl" x))))
(assert (or (not (= (str.len y) 154)) (not (= (str.len x) 117)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[( )0-9]+$")))))
(assert (or (not (str.contains x "d=x tabi")) (= (str.indexof z "e" 0) 6)))
(assert (not (str.suffixof "tarea>" z)))
(check-sat)
