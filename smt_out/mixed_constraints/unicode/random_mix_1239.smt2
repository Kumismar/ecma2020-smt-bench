; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script onmouseover=""alert(1)"">test</script>") (= x "<table onkeyup=""alert(1)"" contenteditable>test</table>") (= x "<IMG SRC=x onseeking=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "le>test</ol>") (= z "test</menuitem>") (= z ">test</menuitem>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 21) "(")) (= (str.indexof y "n" 0) 12)))
(assert (or (= "<samp onmouseou ert(1)\u{10348}"">test</\u{1d400}samp>" (str.replace x "t=""al" " ")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]+$"))) (= "<" (str.substr x 35 1))))
(assert (str.prefixof "le>te" z))
(assert (or (= "oscrip" (str.substr y 2 6)) (not (<= (str.len y) 83)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9].*"))))
(assert (str.suffixof "uitem>" y))
(assert (not (= (str.at y 147) "r")))
(check-sat)
