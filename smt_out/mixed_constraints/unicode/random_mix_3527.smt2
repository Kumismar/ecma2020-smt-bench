; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onmouseenter=""alert(1)"">test</rtc>") (= x "</script></scri\u{20000}pt><<<<script><>>>><<<script>alert(123)</script>") (= x "<slot onmouseover=""alert(1)"">test</slot>")))
(assert (or (= z "le-image&#58; url(\""javascript&#058;alert('XSS')\"");}&lt;/STYLE&gt;&lt;UL&gt;&lt;LI&gt;XSS") (= z ">drag me</div><abbr ondragover=alert(1) contenteditable>drop here</abbr>") (= z "s&quot;&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "&#05" """") "pt""8")) (not (= "s&x;&gt;" (str.replace z "quot" "x")))))
(assert (or (str.prefixof "</sc" y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9_.]{5,25}$"))))
(assert (= (str.at x 36) "l"))
(assert (or (not (= "ble>dr" (str.substr z 1 6))) (str.suffixof "rtc>" x) (not (str.suffixof "c>" x))))
(assert (not (str.prefixof ")>click" z)))
(assert (= (str.at z 1) "<"))
(check-sat)
