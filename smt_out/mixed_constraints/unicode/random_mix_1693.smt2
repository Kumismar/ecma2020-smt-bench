; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody onbeforecut=""alert(1)"" contenteditable>test</tbody>") (= x "<div draggable=""true"" contenteditable>drag me</div><script ondragover=alert(1) contenteditable>drop here</script>") (= x "<frameset><frame onload=alert(1)>")))
(assert (or (= z "1 onfocus=aler\u{1f600}t(1)></multicol>") (= z "activate=alert(1)></tbody><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "e</script>" x)) (not (str.suffixof "l>" y)) (= "<div daggable=""true"" contenteditable>drag me</div><script ondragover=alert(1) contenteditable>drop here</script>" (str.replace x "r" ""))))
(assert (not (= "1 onfocus=aler\u{1f600}t(1)></mult >" (str.replace z "icol" " "))))
(assert (not (str.contains z "autofocu")))
(assert (or (str.suffixof "ert(1)>" x) (not (= "</tbod" (str.substr y 50 6)))))
(assert (or (str.contains y "au") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$")))))
(assert (or (= (str.at y 10) "<") (not (str.prefixof "<n" y)) (= (str.indexof z "te=" 0) 6)))
(assert (not (= (str.indexof y "itab" 0) 31)))
(check-sat)
