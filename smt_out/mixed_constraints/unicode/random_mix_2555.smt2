; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<fieldset onkeydown=""alert(1)"" contenteditable>test</fieldset>") (= x "<style>@keyframes x{}</style><param style=""animation-name:x"" onanimationstart=""alert(1)""></param>")))
(assert (or (= z ";"">") (= z " ondrag=""alert(1)"">test</br>") (= z "rt(\u{1f4a9}""XSS"")>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x " me") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\u{a3}?([0-9]{1,3},([0-9]{3},)*[0-9]{3}|[0-9]+)(.[0-9][0-9])?$"))) (not (= (str.indexof x "y" 0) 3))))
(assert (or (= (str.at x 48) "t") (str.contains x "tle onk")))
(assert (or (not (>= (str.len x) 96)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{4}-\d{1,2}-\d{1,2}$"))) (not (str.contains x "lert(1)"" c"))))
(assert (or (not (= (str.at z 1) "t")) (not (str.contains (str.replace x "</f" "javascript:") "testjavascript:ield"))))
(check-sat)
