; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<map onblur=alert(1) tabindex=1 i\u{1f600}d=x></map><input autofocus>") (= x "<input onfocus=write(XSS) autofocus>")))
(assert (or (= z "script:alert(1)""></svg onUnload>") (= z "enu=""alert(1)"">test</mark>") (= z ")></big><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<input on" x) (not (= (str.at x 47) "p")) (str.suffixof "</meta>" z)))
(assert (or (not (str.contains y "autofoc")) (>= (str.len z) 28)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^(13)$")) (not (= "=1 i\u{1f600}d" (str.substr y 29 6)))))
(assert (or (not (str.contains (str.replace z "ig" "x") "bx><")) (str.suffixof "utofocus>" y) (not (str.prefixof "scrip" z))))
(assert (or (str.contains (str.replace x "onf" "") "t ocu") (str.prefixof "script:a" z)))
(check-sat)
