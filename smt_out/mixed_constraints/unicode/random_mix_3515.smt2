; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onfocusout=alert(1) id=x><input autofocus>") (= x "<nextid draggable=""true"" ondragenter=""alert(1)"">test</nextid>") (= x "<mark onbeforepaste=""ale\u{10348}rt(1)"" contenteditable>test</mark>")))
(assert (or (= z "ut=alert(1) tabindex=1 id=x></samp><input autofocus>") (= z "rt(1)"">test</rp>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 7) " ")))
(assert (or (= "o" (str.substr z 47 1)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(17)$")))))
(assert (or (not (= (str.indexof y "=x></" 0) 84)) (not (= "<nextid draggable=""true"" ondragenter=""alert(1)"">test</nexti t=alert(1) tabindex=1 id=x></samp><input autofocus>" (str.replace y "d>u" " ")))))
(assert (or (= (str.len x) 45) (not (= "rt(1)"">tes>" (str.replace z "t</rp" "")))))
(assert (or (not (<= (str.len z) 24)) (not (str.suffixof "ark>" x)) (= (str.indexof z "l" 0) 4)))
(assert (or (not (str.contains y "xtid")) (not (= (str.at z 0) "r"))))
(assert (not (= (str.at y 101) "t")))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[\s\p{L}]+ ?[\s\p{L}]+")))
(check-sat)
