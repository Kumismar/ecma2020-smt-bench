; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image srcset=1 onerror=alert(1)>") (= x "\u{1d400}<div id=""123""><span class=foo>Some text</span>")))
(assert (or (= z "t:alert(1)"">") (= z "1)></noscript>") (= z ")"">test</html>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "\u{1d400}<dalert(1)id=""123""><span class=foo>Some text</span>" (str.replace x "iv " "alert(1)"))) (not (str.contains x "nerror=a"))))
(assert (or (str.prefixof "<im" x) (not (= "<image srcset=1 onerror=aert(1)>" (str.replace x "l" "")))))
(assert (= (str.at x 29) "("))
(assert (or (= "te" (str.substr z 3 2)) (str.prefixof "<image s" y)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^\+?[0-9]{5,15}$")))
(assert (= (str.len y) 113))
(assert (not (str.prefixof ")" z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9.-]+\.[a-z]{2,3}$")) (= (str.indexof y "/htm" 0) 41)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{0,3}$"))) (not (= (str.at z 2) "a"))))
(assert (str.contains y "<ima"))
(check-sat)
