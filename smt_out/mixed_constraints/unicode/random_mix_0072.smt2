; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT SRC=&quot;http://ha.ckers.org/xss.jpg&quot;&gt;&lt;/SCRIPT&gt;") (= x "<dir onblur=alert(1) tabindex=1 id=x></dir><input autofocus>")))
(assert (or (= z "id=x tabindex=1 onbeforeactivate=alert(1)></select>") (= z "=""alert(1)"" contenteditable>test</frameset>") (= z "alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "1 onbefore")) (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_]{3,}"))))
(assert (or (not (= (str.at y 97) "m")) (= ";/S" (str.substr x 61 3))))
(assert (not (str.contains y "ir onb")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{4}\s\d{4}\s\d{4}$"))) (= (str.indexof z "t(1)>" 0) 4)))
(assert (or (not (= (str.at x 59) ">")) (not (str.suffixof "T&gt;" x))))
(check-sat)
