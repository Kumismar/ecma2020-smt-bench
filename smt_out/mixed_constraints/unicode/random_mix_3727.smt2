; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "</\u{1f4a9}image>") (= x "<button ondblclick=""alert(1)"">test</button>")))
(assert (or (= z "PRESS ENTER</div>//[""'`-->]]>]</div>") (= z "cript&#058;alert('XSS')\""&gt;")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 1) (= (str.indexof x "</\u{1f4a9}" 0) 0) (not (= "#058;a" (str.substr z 6 6)))))
(assert (or (not (= (str.indexof y "('XS" 0) 59)) (str.prefixof "</\u{1f4a9}image>" y)))
(assert (or (str.prefixof "</\u{1f4a9}im" x) (str.suffixof "]>]</div>" y)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[^%]*$")))
(assert (or (not (str.prefixof "</\u{1f4a9}im" y)) (= "&lt;IF AME SRC=&quot;javascript:alert(&apos;XSS&apos;);&quot;&gt;&lt;/IFRAME&gt;/noscript>" (str.replace y "R" " "))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(\d *?){11}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{5}([\-]\d{4})?$"))) (not (str.contains x "image>"))))
(assert (or (= (str.at x 22) "o") (= (str.indexof z "r" 0) 1)))
(check-sat)
