; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext onclick=""alert(1)"">test</plaintext>") (= x "<ruby onmousedown=""alert(1)"">test</ruby>")))
(assert (or (= z "npaste=""alert(1)"" conten\u{20000}teditable>test</svg>") (= z "ste=""alert(1)"" contenteditable>test</col>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<ruby" y)) (not (<= (str.len x) 48))))
(assert (or (not (= (str.indexof x "ler" 0) 21)) (not (str.prefixof "<ruby onmo" y)) (= (str.at y 59) ">")))
(assert (= (str.indexof x "ss=""a" 0) 18))
(assert (not (= (str.indexof z "es" 0) 5)))
(assert (= "</svg>" (str.substr y 85 6)))
(assert (or (not (str.contains z "itable")) (not (str.suffixof "laintext>" x)) (str.contains (str.replace y "ruby" """") "<"" o")))
(assert (not (str.contains z "est</col")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!.{21,})[^.]+$"))))
(check-sat)
