; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input id=x tabindex=1 ondeactivate=alert(1)></input><input id=y autofocus>") (= x "<blink draggable=""true"" ondragleave=""alert(1)"">test</blink>") (= x "<? '=""foo""><x foo='><img src=x onerror=alert(3)//'>//[""'`-->]]>]</div>")))
(assert (or (= z "itable>drag me</div><table ondragover=alert(1) contenteditable>drop here</table>") (= z "head oncontextmenu=""alert(1)"">test</thead>") (= z "beforepaste=""alert(1)"" contenteditable>test</rp>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "st</rp>" y) (not (= (str.at y 88) "c"))))
(assert (or (str.contains z ">drop") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{4,20}$"))) (not (str.contains (str.replace x "se" "") "({t"))))
(assert (or (not (str.suffixof "</rp>" z)) (not (= "r" (str.substr y 100 1)))))
(assert (not (= ")></inp" (str.substr y 43 7))))
(check-sat)
