; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1d400}colgroup id=x tabindex=1 onbeforeactivate=alert(1)></colgroup>") (= x "<;IMG SRC=`javascript:alert("";RSnake says, ';XSS';"";)`>;")))
(assert (or (= z "/tbody>") (= z """ ondragleave=""alert(1)"">test</td>")))
(assert (= y (str.++ x z)))
(assert (or (= "t(""" (str.substr y 26 3)) (= "y>" (str.substr z 5 9))))
(assert (or (<= (str.len y) 75) (= (str.at z 5) "i")))
(assert (or (= (str.indexof x "tiva" 0) 37) (= (str.indexof z "=" 0) 13)))
(assert (or (not (= "<\u{1d400}colgroup id=x tabindex=1 onbeforeactivate=aleralert(1)1)></colgroup>" (str.replace x "t(" "alert(1)"))) (str.suffixof "roup>" x) (str.in_re z ((_ re.from_regex ecma2020 u) "^((8|\+3)[\- ]?)?(\(?\d{3}\)?[\- ]?)?[\d\- ]{7,10}$"))))
(assert (>= (str.len y) 61))
(assert (or (not (= "d=x " (str.substr x 12 4))) (not (= (str.indexof y "est" 0) 82))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[^\W][\.a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+)*@[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+)*\.[a-zA-Z]{2,4}$"))) (str.contains x "nbeforea")))
(assert (= "<;IMG SRC=`javascript:alert("";RSnake says, ';XSS';""; ;" (str.replace x ")`>" " ")))
(check-sat)
