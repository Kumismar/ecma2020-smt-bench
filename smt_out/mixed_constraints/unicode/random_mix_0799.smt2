; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select id=x tabindex=1 onactivate=alert(1)></select>") (= x "<div id=""90""><!-- Up to Opera 10.63 -->")))
(assert (or (= z "ue"" o\u{10348}ndrag=""\u{1f600}alert(1)"">test</td>") (= z "(1)"" contenteditable>test</slot>") (= z "autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "=""\u{1f600}ale") (not (= "3 -->" (str.substr x 34 7)))))
(assert (or (not (= "e" (str.substr x 2 1))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{1,2}:(?:00|15|30|45)$"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{1,7}-\d{2}-\d$"))))
(assert (not (str.prefixof "ue""" z)))
(assert (or (not (str.suffixof ">" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z]{2,20}"))) (not (<= (str.len x) 40))))
(assert (or (>= (str.len z) 31) (str.prefixof "<s" y) (not (str.prefixof "<select" y))))
(check-sat)
