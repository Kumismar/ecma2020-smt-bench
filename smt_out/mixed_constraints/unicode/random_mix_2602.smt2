(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li onkeyup=""alert(1)"" contenteditable>test</li>") (= x "<xmp draggable=""true"" ondragstart=""alert(1)"">test</xmp>") (= x "<meter onmouseleave=""ale\u{1d400}rt(1)"">test</meter>")))
(assert (or (= z "onbeforecut=""alert(1)"" contenteditable>test</svg>") (= z "rt(1)"">test</time>") (= z "/font>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "nput au")))
(assert (or (str.contains (str.replace z "est</" "x") "e>txdi") (not (= (str.indexof z "ert" 0) 33)) (not (= "te" (str.substr x 3 2)))))
(assert (not (str.contains (str.replace x "er>" "<b>") "</met<b>")))
(assert (or (not (str.contains (str.replace z "ocu" "") "ofs>")) (= (str.at x 54) ">")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?:[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*|'(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21\x23-\x5b\x5d-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])*')@(?:(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?|\[(?:(?:(2(5[0-5]|[0-4][0-9])|1[0-9][0-9]|[1-9]?[0-9]))\.){3}(?:(2(5[0-5]|[0-4][0-9])|1[0-9][0-9]|[1-9]?[0-9])|[a-z0-9-]*[a-z0-9]:(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21-\x5a\x53-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])+)\])"))) (not (str.prefixof "on" z))))
(check-sat)
