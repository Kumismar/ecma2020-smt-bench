; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<output id=x tabindex=1 onbeforedeactivate=alert(1)></output><input autofocus>") (= x "<style>:target {transform: rotate(180deg);}</style><acronym id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></acronym>") (= x "<legend onblur=alert(1) tabindex=1 id=x></legend><input autofocus>")))
(assert (or (= z "</q>") (= z "gleave=""alert(1)"">test</optgroup>") (= z "in=alert(1)></bdi>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof ":x"" onani" z)))
(assert (not (= (str.len z) 18)))
(assert (or (str.contains x "autofocus>") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((8|\+7)[\- ]?)?(\(?\d{3}\)?[\- ]?)?[\d\- ]{10}$"))) (= (str.indexof y ")" 0) 50)))
(assert (or (not (str.contains (str.replace x "rt" "javascript:") "lejavascript:(1)><")) (str.prefixof "<o" x)))
(assert (or (not (= (str.indexof x "acr" 0) 52)) (not (= (str.at x 130) "m"))))
(assert (or (= (str.len y) 109) (not (str.contains y "><"))))
(check-sat)
