; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onkeydown=""alert(1)"" contenteditable>test</sup>") (= x "<big onmouseenter=""alert(1)"">test</big>")))
(assert (or (= z ">") (= z "t(1)>") (= z "t</tr>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "(1)""" 0) 25))
(assert (or (not (str.contains (str.replace z ";" "") "t")) (= (str.at y 35) "i")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z-'\u{e0}\u{e1}\u{e2}\u{e3}\u{e4}\u{e5}\u{e7}\u{e8}\u{e9}\u{ea}\u{eb}\u{ec}\u{ed}\u{ee}\u{ef}\u{f0}\u{f2}\u{f3}\u{f4}\u{f5}\u{f6}\u{f9}\u{fa}\u{fb}\u{fc}\u{fd}\u{ff}\s]+[a-zA-Z-'\u{e0}\u{e1}\u{e2}\u{e3}\u{e4}\u{e5}\u{e7}\u{e8}\u{e9}\u{ea}\u{eb}\u{ec}\u{ed}\u{ee}\u{ef}\u{f0}\u{f2}\u{f3}\u{f4}\u{f5}\u{f6}\u{f9}\u{fa}\u{fb}\u{fc}\u{fd}\u{ff}\s]{2,}$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_-]{20}$")))))
(assert (or (= "ary id" (str.substr y 5 6)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\w.%+-]+@[\w.-]+\.[\w]{2,}$")))))
(assert (or (= (str.indexof x "eente" 0) 11) (not (= (str.indexof z "(1)""" 0) 17))))
(assert (not (= "</tr>" (str.substr z 1 9))))
(assert (or (not (= (str.len y) 53)) (str.contains x "PT S") (not (= (str.at y 20) "l"))))
(assert (= "t(" (str.substr z 0 2)))
(assert (str.prefixof "<a " y))
(check-sat)
