; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onbeforeunload=""alert(String.fromCharCode(88,83,83))"">") (= x """`'><script>\xE2\x80\xAFjavascript:alert(1)</script>")))
(assert (or (= z "p4"" type=video/mp4></video>") (= z "ert(1) contenteditable>drop here</rp>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "></video>" y))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "3[0-9]{9}"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\D{1,15}$"))) (str.prefixof """`'><scri" y)))
(assert (or (not (>= (str.len z) 35)) (not (= "\x" (str.substr x 12 2)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "([a-zA-Z\s]+)$"))) (str.suffixof "here</rp>" z) (>= (str.len z) 37)))
(assert (or (= (str.at y 21) ")") (not (str.contains z "re</r")) (= "rCode(88," (str.substr x 47 9))))
(assert (or (not (str.prefixof "<" x)) (not (str.suffixof "video>" z)) (not (= "here</" (str.substr y 80 6)))))
(check-sat)
