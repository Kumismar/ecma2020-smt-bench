(assert (or (= x "<style>:target {color:red;}</style><table id=x style=""transition:color 1s"" ontransitionend=alert(1)></table>") (= x "<TD BACKGROUND=""javascript:alert('XSS')"">") (= x "<meta charset=""x-imap4-modified-utf7"">&<script&S1&TS&1>alert&A7&(1)&R&UA;&&<&A9&11/script&X&>")))
(assert (or (= z ">") (= z "rt(1)"">test</plaintext>") (= z "></s>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 21) "r")) (str.prefixof "iv><kbd o" z) (= (str.len z) 5)))
(assert (or (<= (str.len z) 69) (= (str.indexof x "itab" 0) 31) (not (= (str.indexof x "'X" 0) 33))))
