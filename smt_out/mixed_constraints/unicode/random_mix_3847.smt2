(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!(((https?)|(ftp)):\/\/)?([\da-z\.-]+)\.([a-z\.]{2,6})([\/\w \.-]*)*\/?).*$")) (= "f7"">" (str.substr x 34 4)) (str.prefixof "<" x)))
