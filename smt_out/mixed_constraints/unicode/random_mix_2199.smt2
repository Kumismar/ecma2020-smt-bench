; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script oncut=""alert(1)"" contente\u{10348}dita\u{20000}ble>test</script>") (= x "<dd onpaste=""alert(1)"" contenteditable>test</dd>")))
(assert (or (= z "yframes x{}</style><acronym style=""animation-name:x"" onanimationstart=""alert(1)""></acronym>") (= z "/\u{1f4a9}image>") (= z "blclick=""alert(1)"">test</font>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "age>" y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^RB\d{3,7}|IA\d{3,7}$"))) (= "</field" (str.substr z 3 7))))
(assert (or (not (= (str.indexof z "main>" 0) 3)) (not (= (str.indexof y "/" 0) 44))))
(assert (or (not (= (str.at z 13) "t")) (not (= "x{}</" (str.substr y 64 5)))))
(assert (= (str.indexof x "t on" 0) 6))
(check-sat)
