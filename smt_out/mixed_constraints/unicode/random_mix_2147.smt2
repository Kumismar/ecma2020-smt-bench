; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""127""><svg xmlns=""http://www.w3.org/2000/svg"" id=""x"">") (= x "<i draggable=""true"" ondragenter=""alert(1)"">test</i>")))
(assert (or (= z "rtc>") (= z "lert(1)"">test</picture>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{1,9}$"))) (not (str.contains (str.replace y "est" "x") ")"">tx<")) (not (= (str.indexof y "w.w3." 0) 35))))
(assert (or (not (str.contains y "ure>")) (str.prefixof "<d" y)))
(assert (not (= (str.indexof z ")" 0) 3)))
(assert (<= (str.len y) 86))
(assert (not (= "ble" (str.substr y 9 3))))
(check-sat)
