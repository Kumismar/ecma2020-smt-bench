; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i onkeypress=""alert(1)"" contenteditable>test</i>") (= x "<html onfocusout=alert(1) tabindex=1 id=x></html><input autofocus>") (= x "<cite onmousemove=""alert(1)"">test</cite>")))
(assert (or (= z " contenteditable>drag me</div><time ondrop=alert(1) contenteditable>drop here</time>") (= z "=""alert(1)"" contenteditable>test</main>")))
(assert (= y (str.++ x z)))
(assert (= (str.len z) 84))
(assert (or (str.prefixof "<cite " y) (not (= (str.indexof x "ler" 0) 20))))
(assert (or (str.prefixof "<html onf" y) (not (str.suffixof "re</time>" y)) (not (str.suffixof ">" x))))
(assert (or (str.suffixof "e>" y) (= "<html onfocusout=alert(1) tabindex=1 id=x></html><input autofocus>=""alert(1)"" con teditable>test</main>" (str.replace y "ten" " ")) (not (str.prefixof "<htm" x))))
(assert (or (not (= (str.indexof y "d" 0) 49)) (= (str.indexof z "e" 0) 5) (str.contains (str.replace z "rt(" "") """ale1")))
(assert (not (= "=""alert(1)"" contenteditable>test</malert(1)" (str.replace z "ain>" "alert(1)"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1][3587][0-9]9$"))))
(check-sat)
