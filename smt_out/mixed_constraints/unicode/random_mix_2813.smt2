; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><header style=""animation-name:x"" onanimationend=""alert(1)""></header>") (= x "<label onkeypress=""alert(1)"" contenteditable>test</label>") (= x "<hr onbeforecopy=""alert(1)"" contenteditable>test</hr>")))
(assert (or (= z "st</figcaption>") (= z "-name:x"" onanimationstart=""alert(1)""></meter>") (= z "lert(1)""></nobr>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<script" y)) (<= (str.len y) 117)))
(assert (or (= (str.at x 47) "s") (not (<= (str.len x) 61)) (not (= "<label onkeypress=""alert(1)"" conjavascript:nteditable>test</label>" (str.replace x "te" "javascript:")))))
(assert (not (str.prefixof "<style>" x)))
(assert (or (= "<s" (str.substr x 0 2)) (str.prefixof "lert(1" z)))
(assert (or (= (str.indexof z " id=""" 0) 44) (not (= "<hr onbeforecopy=""alert(1)"" contenteditable>test</hr>lert(1x</nobr>" (str.replace y ")"">" "x")))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]{1,40}[@]{1}[a-z]{1,18}[.]{1}[a-z]{2,3}")))
(assert (or (not (= "-name:x"" onanimationstart=""alert(1)""></me r>" (str.replace z "te" " "))) (not (>= (str.len z) 38))))
(assert (str.suffixof "t</label>" x))
(assert (not (= (str.indexof x "le" 0) 4)))
(check-sat)
