; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col id=x tabindex=1 onbeforedeactivate=alert(1)></col><input autofocus>") (= x "<style>@keyframes x{}</style><tfoot style=""animation-name:x"" onanimationstart=""alert(1)""></tfoot>")))
(assert (or (= z "s>") (= z " onblur=alert(1) tabindex=1 id=x></u><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 150) ">")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z\u{e0}-\u{fa}\u{c0}-\u{da}]+\s*)+$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^( +)?((\+?7|8) ?)?((\(\d{3}\))|(\d{3}))?( )?(\d{3}[\- ]?\d{2}[\- ]?\d{2})( +)?$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z- _\.]{1,25}$")))))
(assert (or (= (str.indexof x "tes" 0) 42) (str.prefixof "<col i" y) (not (str.suffixof "s>s>" y))))
(assert (not (= (str.indexof y "</u><" 0) 105)))
(check-sat)
