; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main onfocusout=alert(1) tabindex=1 id=x></main><input autofocus>") (= x "<svg><hgroup onload=alert(1)></hgroup>")))
(assert (or (= z "end onload=alert(1)></legend>") (= z "ouseout=""alert(1)"">test</keygen>") (= z "ul>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((20)\d{2}|\d{2})$"))))
(assert (not (str.suffixof "keygen>" z)))
(assert (or (not (= "rt(1)></h" (str.substr x 23 9))) (not (= (str.indexof x "sv" 0) 1)) (str.prefixof "<svg" x)))
(assert (or (= "1" (str.substr y 35 1)) (str.in_re z ((_ re.from_regex ecma2020 u) "([0-9\+\/\(\)\-]{5,})*$")) (not (str.prefixof "<mai" y))))
(assert (str.prefixof "<s" x))
(check-sat)
