; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section onfocusout=alert(1) tabindex=1 id=x></section><input autofocus>") (= x "<META onpaonpageonpagonpageonpageshowshoweshowshowgeshow=""alert(1)"";")))
(assert (or (= z "r onbeforepaste=""alert(1)"" contenteditable>test</abbr>") (= z "gable=""true"" ondragenter=""alert(1)"">test</source>") (= z "ert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "ntent") (not (<= (str.len x) 76))))
(assert (str.contains y "matio"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\-\+]{9,15}$"))) (not (str.suffixof "tofocus>" x))))
(assert (or (str.prefixof "<" y) (not (str.suffixof "st</blink>" z)) (not (= (str.indexof z "t" 0) 2))))
(assert (or (not (str.suffixof "us>ert(1)>" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) ".*[^ \t\n].*")))))
(check-sat)
