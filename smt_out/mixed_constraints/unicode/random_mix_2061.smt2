; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 onfocusout=alert(1) tabindex=1 id=x></h1><input autofocus>") (= x "<caption onbeforecut=""alert(1)"" contenteditable>test</caption>") (= x "<svg><blockquote onload=alert(1)></blockquote>")))
(assert (or (= z "ble=""true"" ondragend=""alert(1)"">test</select>") (= z "blockquote ondblclick=""alert(1)"">test</blockquote>") (= z "g onmouseout=""alert(1)"">test</svg>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "ic" 0) 80))
(assert (not (= "<h1 onfocusout=alert(1) tabindex=1 id=x></h1><input autofocus>blockquote ondblcjavascript:k=""alert(1)"">test</blockquote>" (str.replace y "lic" "javascript:"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[7-9][0-9]{9}"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "(6|7|8|9)[0-9]{8}"))))
(assert (str.suffixof "ct>" y))
(assert (not (= (str.indexof z "sv" 0) 30)))
(assert (not (str.suffixof "focus>" x)))
(assert (or (= ">test<" (str.substr z 23 6)) (not (str.prefixof "<capt" y))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{5,11}"))))
(assert (or (not (str.suffixof "t</select>" y)) (= "ut autofoc" (str.substr y 49 10))))
(check-sat)
