; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script <B>document.vulnerable=true;</script>") (= x "<dl id=x tabindex=1 ondeactivate=alert(1)></dl><input id=y autofocus>") (= x "<menu onfocusout=alert(1) tabindex=1 id=x></menu><input autofocus>")))
(assert (or (= z "_js_X.pdf"">") (= z "sitioncancel=alert(1)></tfoot>") (= z " onbeforecopy=""alert(1)"" contenteditable>test</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "t(1)" 0) 37)) (str.prefixof "<scri" y)))
(assert (not (str.suffixof """>" y)))
(assert (= (str.at y 50) "i"))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^\d*(\.\d{0,1})?$")))
(assert (or (= (str.indexof z "js_" 0) 1) (= "e=true" (str.substr x 29 6))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]+\.?[0-9]*"))) (= (str.at z 9) "c") (= "e" (str.substr x 34 1))))
(assert (or (str.suffixof ">" z) (not (= (str.len z) 51))))
(check-sat)
