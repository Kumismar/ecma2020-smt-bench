; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<audio id=x controls onfocusin=alert(1) id=x><source src=""validaudio.wav""></audio>") (= x "<th id=x tabindex=1 onfocus=alert(1)></th>") (= x "<style>:target {color:red;}</style><section id=x style=""transition:color 1s"" ontransitionend=alert(1)></section>")))
(assert (or (= z "img src=x onerror=javascript:alert(1)//'>") (= z "cript:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "ript>" z)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9]{2}(?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$")))))
(assert (or (str.contains (str.replace z "s" "") " rc=") (not (str.contains (str.replace z "t:a" "javascript:") "ipjavascript:ler"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) ".{10,50}")) (str.prefixof "img sr" z) (not (= (str.indexof x "in=a" 0) 28))))
(assert (not (= (str.indexof y "</" 0) 27)))
(assert (or (str.contains y "lert(1)") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\x00-\x7F]+$"))) (= (str.at x 15) "n")))
(assert (not (= "img src=x onerror=javascript:al1)//'>" (str.replace z "ert(" ""))))
(check-sat)
