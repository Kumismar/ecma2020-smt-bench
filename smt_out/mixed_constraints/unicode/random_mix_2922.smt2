; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg id=x tabindex=1 ondeactivate=alert(1)></svg><input id=y autofocus>") (= x "<div style=""background-image: url(javascript:document.vulnerable=true;);"">") (= x "<output draggable=""true"" ondragend=""alert(1)"">test</output>")))
(assert (or (= z "s.html"">") (= z "pe html>") (= z "rt(1)"">test</big>")))
(assert (= y (str.++ x z)))
(assert (not (= "ate=a" (str.substr y 30 5))))
(assert (or (= "und-image:" (str.substr x 19 10)) (not (= (str.at y 4) " ")) (= "s.html"">" (str.substr z 0 10))))
(assert (or (not (<= (str.len z) 42)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[+\-()\s0-9]{6,}$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\+\/]+$"))) (= (str.at x 44) ":")))
(assert (not (= (str.indexof y "1)"">t" 0) 42)))
(assert (str.suffixof "</spacer>" x))
(assert (or (not (str.prefixof "<svg " x)) (not (str.suffixof "output>" x))))
(assert (or (str.contains x "=true;);""") (not (str.prefixof "<" y)) (= (str.indexof x ": ur" 0) 28)))
(check-sat)
