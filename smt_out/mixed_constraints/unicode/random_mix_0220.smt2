; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody id=x tabindex=1 onbeforeactivate=alert(1)></tbody>") (= x "<dl ondblclick=""alert(1)"">test</dl>")))
(assert (or (= z "ement>") (= z " dur=1s repeatCount=1>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 43) (not (= (str.indexof x """al" 0) 75))))
(assert (= (str.at y 37) "t"))
(assert (not (= (str.at x 42) "e")))
(assert (or (str.prefixof "<" x) (not (str.contains (str.replace x "ex=1 " " ") "ind o"))))
(assert (or (= (str.indexof x "/" 0) 31) (not (= "bi" (str.substr x 14 2))) (not (str.contains x "vate=aler"))))
(assert (or (>= (str.len x) 34) (= (str.at z 13) "t")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^([\u{5c}u4E00-\u{5c}u9FA5]{2,4})$")))
(check-sat)
