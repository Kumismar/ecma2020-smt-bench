; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext id=x tabindex=1 onactivate=alert(1)></plaintext>") (= x "<noframes oncontextmenu=""alert(1)"">test</noframes>")))
(assert (or (= z " />") (= z "ex.php?page=top_movies&cat=13&p=2 p=2 ??XSS??")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 22) "e")))
(assert (or (not (str.contains y "oncont")) (not (= " " (str.replace z " />" " ")))))
(assert (or (= (str.indexof y "aint" 0) 3) (not (str.contains x "ondrag="))))
(assert (or (not (= "3&p" (str.substr z 28 3))) (str.suffixof "??XSS??" y) (not (<= (str.len y) 108))))
(assert (or (str.suffixof "noframes>" x) (not (str.suffixof " />" z))))
(assert (or (not (= (str.indexof z "XSS" 0) 4)) (str.in_re x ((_ re.from_regex ecma2020 u) "(^\?$|^er\.[\d]{4}-[\d]{2}-[\d]{2}\.[\d.-]+)")) (str.prefixof "<;BOD" x)))
(assert (not (= "fr" (str.substr x 43 2))))
(assert (= (str.at z 0) " "))
(check-sat)
