; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onemptied=""alert(String.fromCharCode(88,83,83))"">") (= x "<div draggable=""true"" contenteditable>drag me</div><ins ondrop=alert(1) contenteditable>drop here</ins>")))
(assert (or (= z "r=""alert(1)"">test</listing>") (= z "lot id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></slot>") (= z "15""><!--[if]><script>alert(115)</script -->")))
(assert (= y (str.++ x z)))
(assert (str.contains x "(88,"))
(assert (or (not (str.prefixof "lot" z)) (not (= (str.indexof x "tied=" 0) 16))))
(assert (or (not (= "ript>ale" (str.substr z 16 8))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\([0-9]{3}\))-([0-9]{3})-([0-9]{4})$")))))
(assert (or (not (= "rxlert(1)"">test</listing>" (str.replace z "=""a" "x"))) (>= (str.len x) 57)))
(assert (not (= (str.at z 1) "5")))
(check-sat)
