; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source id=x tabindex=1 onfocus=alert(1)></source>") (= x "<multicol onbeforecut=""alert(1)"" contenteditable>test</multicol>") (= x "<IMG SRC=x ontimeupdate=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "lert(1)"">test</style>") (= z "t onmouseleave=""\u{10348}alert(1)"">test</font>") (= z "rc=""data:\xD4\x8F,javascript:alert(1)""></script>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "er" 0) 1)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^1[3-8]{1}\d{9}$)|(^\d{7,8}$)|(^\d{4}-\d{7,8}$)"))))
(assert (not (= "harCode(8" (str.substr x 43 9))))
(assert (= (str.at z 3) "t"))
(assert (or (str.contains z "rt(1)"">tes") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\([0-9]{4}\)\s[0-9]{3}\s[0-9]{2}\s[0-9]{2}$"))) (= "ip" (str.substr z 25 2))))
(assert (or (= "-->]]" (str.substr x 39 5)) (= (str.at z 13) "\") (>= (str.len x) 61)))
(assert (not (>= (str.len x) 59)))
(assert (or (= (str.at z 44) "i") (str.contains y "ut=""aler") (str.contains z ">")))
(check-sat)
