; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hgroup onkeyup=""alert(1)"" contenteditable>test</hgroup>") (= x "<IMG SRC=x ondrop=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "mg>") (= z "move=""alert(1)"">test</embed>") (= z "e=""animation-name:x"" onanimationstart=""alert(1)""></font>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len y) 50)))
(assert (or (not (= "<IMG SRC=x ondrop=""alerring.fromCharCode(88,83,83))"">" (str.replace x "t(St" ""))) (not (= (str.indexof z "t" 0) 8)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]{6,12}$")))))
(assert (= (str.indexof x "fro" 0) 32))
(assert (or (not (str.prefixof "<x co" y)) (not (str.suffixof "bed>" y))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^([A-z\u{119}\u{f3}\u{105}\u{15b}\u{142}\u{17c}\u{17a}\u{107}\u{144}\u{118}\u{d3}\u{104}\u{15a}\u{141}\u{17b}\u{179}\u{106}\u{143} ]){2,}$")) (not (= (str.at y 150) "/")) (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-\u{17e}0-9. _-]{5,}$"))))
(assert (str.prefixof "e=""ani" z))
(check-sat)
