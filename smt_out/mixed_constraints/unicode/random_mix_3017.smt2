; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr onkeypress=""alert(1)"" contenteditable>test</hr>") (= x "<acronym onmouseout=""alert(1)"">test</acronym>")))
(assert (or (= z "aggable=""true"" ondra\u{1d400}g=""alert(1)"">test</tbody>") (= z "S&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "&lt;/A")) (not (>= (str.len x) 37)) (not (<= (str.len x) 60))))
(assert (not (= (str.at x 12) "s")))
(assert (or (= "A&gt;" (str.substr z 6 9)) (not (str.contains (str.replace z "deo>" "") "i")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^0(7|8|9)0\d{8}$")))))
(assert (not (str.contains y "press=""")))
(check-sat)
