; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><footer ondrop=alert(1) contenteditable>drop here</footer>") (= x "<style>:target {color: red;}</style><param id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></param>")))
(assert (or (= z "blclick=""alert(1)"">test</ruby>") (= z "/datalist>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "ggabl" 0) 8)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\+?1[ -]?)?\(?[2-9]\d\d\)?[ -]?[2-9]\d\d[ -]?\d{4}$"))))
(assert (or (= "<style>:target {color: red;}</style><parid=x style=""transition:color 10s"" ontransitioncancel=alert(1)></param>/datalist>" (str.replace y "am " "")) (= "/data<b>>" (str.replace z "list" "<b>")) (str.contains x "rue")))
(assert (or (not (<= (str.len x) 122)) (str.suffixof "t(1)>" x) (str.prefixof "<sty" y)))
(assert (not (= "able=""" (str.substr x 10 6))))
(check-sat)
