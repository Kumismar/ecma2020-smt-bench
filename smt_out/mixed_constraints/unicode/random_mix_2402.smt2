; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><th style=""animation-name:x"" onanimationend=""alert(1)""></th>") (= x "<content onkeypress=""alert(1)"" contenteditable>test</content>")))
(assert (or (= z "nkeyup='\u{5c}u0061\u{5c}u006C\u{5c}u0065\u{5c}u0072\u{5c}u0074&#x28;1&#x29;'>") (= z ")></dir>") (= z "fieldset><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "rt(1") (= (str.len x) 89) (str.suffixof "29;'>" z)))
(assert (not (str.prefixof "fieldset>" z)))
(assert (= "field<b>t><input autofocus>" (str.replace z "se" "<b>")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(8)$"))) (not (= "r>" (str.substr z 6 7))) (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,100}$"))))
(assert (or (str.contains z "t>") (= (str.indexof y "keyf" 0) 8)))
(assert (= (str.indexof z "</dir" 0) 2))
(assert (or (= (str.indexof y "keypr" 0) 11) (= (str.at x 32) "a") (str.contains (str.replace x "olor" "x") "et {cx: ")))
(assert (str.contains x "nmouseente"))
(check-sat)
