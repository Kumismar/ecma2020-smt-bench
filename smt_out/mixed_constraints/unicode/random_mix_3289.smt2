; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table background=""javascript:javascript:alert(1)"">") (= x "/*iframe/src*/<iframe/src=""<iframe/src=@""/onload=prompt(1) /*iframe/src*/>")))
(assert (or (= z "cus>") (= z "st</rt>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 0) "d")))
(assert (or (not (str.suffixof ")"">st</rt>" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(0[1-9]|[12][0-9]|3[01])\/(0[1-9]|1[0-2])\/(19|20)([0-9]{2})$")))))
(assert (or (= (str.at x 32) "v") (not (<= (str.len y) 85)) (= (str.indexof z "t" 0) 1)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._-]+@[a-z0-9.-]+\.[a-z]{2,4}$"))) (= """alert(1)""" (str.substr y 55 10))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[\D]{2,20}"))) (not (str.contains y "src=@""/on")) (not (= "t</nobr>" (str.substr z 26 10)))))
(assert (not (>= (str.len z) 1)))
(assert (or (not (str.suffixof "*/>" x)) (str.contains (str.replace x "c*" "<b>") "me/sr<b>/<")))
(check-sat)
