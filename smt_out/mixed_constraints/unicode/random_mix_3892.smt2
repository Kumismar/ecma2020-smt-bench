(assert (or (= x "&lt;A HREF=&quot;http://1113982867/&quot;&gt;XSS&lt;/A&gt;") (= x "<frameset onmouseenter=""alert(1)"">test</frameset>")))
(assert (or (= z "adow onpaste=""alert(1)"" contenteditable>test</shadow>") (= z "edown=""alert(1)"">test</image>")))
