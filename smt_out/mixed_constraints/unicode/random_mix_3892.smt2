(assert (or (not (= (str.at x 100) "r")) (str.contains z "/imag")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(\+33[0-9]{1}[0-9]{8})$|^(^0[0-9]{9})$"))))
