; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb onkeypress=""alert(1)"" contenteditable>test</rb>") (= x "<command id=x tabindex=1 onfocus=alert(1)></command>")))
(assert (or (= z "t(1)"">test</noframes>") (= z "n id=x tabindex=1 onbeforeactivate=alert(1)></main>") (= z "forecut=""alert(1)"" contenteditable>test</code>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 90) "s")) (not (= "yp" (str.substr y 8 2))) (= "n id=x tabin<b>=1 onbeforeactivate=alert(1)></main>" (str.replace z "dex" "<b>"))))
(assert (or (not (str.prefixof "<rb on" y)) (not (str.prefixof "<comm" x))))
(assert (or (not (= ">" (str.substr y 96 4))) (= (str.indexof z "te=al" 0) 32)))
(assert (or (not (= (str.len z) 70)) (str.prefixof "<c" y)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z ]{5,}"))))
(check-sat)
