; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rt onfocusout=alert(1) tabindex=1 id=x></rt><input autofocus>") (= x "<A HREF=""http://%77%77%77%2E%67%6F%6F%67%6C%65%2E%63%6F%6D"">XSS</A>") (= x "<link oncopy=""alert(1)"" contenteditable>test</link>")))
(assert (or (= z "activate=alert(1)></basefont><input id=y autofocus>") (= z "ss=""alert(1)"" contenteditable>test</b>") (= z "pt>javascript:alert(1)</script -->")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len y) 109)))
(assert (not (= (str.indexof y "id=" 0) 87)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z \u{f6}\u{fc}\u{f3}\u{151}\u{fa}\u{e9}\u{e1}\u{171}\u{ed}\u{d6}\u{dc}\u{d3}\u{150}\u{da}\u{c9}\u{c1}\u{170}\u{cd}]{3,20}")) (<= (str.len z) 57)))
(assert (not (<= (str.len x) 63)))
(assert (str.suffixof ">" y))
(assert (or (not (= """>test</h" (str.substr z 1 9))) (not (str.contains (str.replace y "%77%7" "") "//7%77%"))))
(assert (or (= (str.indexof y "t" 0) 10) (str.suffixof "meset>" z)))
(assert (or (str.prefixof "<link o" y) (str.prefixof "activat" z)))
(assert (= "est</b>" (str.substr z 31 10)))
(assert (str.prefixof "<A HREF=""" x))
(assert (not (str.contains y "rt><input ")))
(check-sat)
