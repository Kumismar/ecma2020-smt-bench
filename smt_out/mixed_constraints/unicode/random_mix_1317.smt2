; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><em style=""animation-name:x"" onanimationstart=""alert(1)""></em>") (= x "<blockquote draggable=""true"" ondragend=""alert(1)"">test</blockquote>")))
(assert (or (= z "t</source>") (= z "</nav>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "</em>t</") (not (str.prefixof "<b" y))))
(assert (or (= (str.len x) 52) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0]*(?=[1-9])(1?[0-9]{0,2})|([1-9][0-9])|[1-9]")))))
(assert (= "mbed>" (str.substr z 21 5)))
(assert (or (not (= "e>" (str.substr z 8 4))) (str.contains z "nav") (>= (str.len x) 90)))
(assert (not (= (str.len y) 73)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z \u{e4}\u{c4}\u{f6}\u{d6}\u{fc}\u{dc}\u{df}-]+"))) (= (str.indexof x "g" 0) 8) (not (= "ble=" (str.substr y 18 4)))))
(assert (or (= "<style>@keyframes x{}</style><em style=""animation-name:x"" onanimationstart=""alert(1 /em>" (str.replace x ")""><" " ")) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z'  -]+$")) (str.contains z "</na")))
(check-sat)
