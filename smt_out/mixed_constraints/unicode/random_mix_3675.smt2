; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hgroup onpaste=""alert(1)"" contenteditable>test</hgroup>") (= x "<data onfocusout=alert(1) tabindex=1 id=x></data><input autofocus>") (= x "<h1 onfocusout=alert(1) tabindex=1 id=x></h1><input autofocus>")))
(assert (or (= z """>test</img>") (= z "redeactivate=alert(1)></tfoot><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<hgroup " y) (str.prefixof "<data " x)))
(assert (or (not (str.suffixof "</rt>" y)) (= (str.indexof y "scri" 0) 18)))
(assert (or (not (= "nmo" (str.substr y 4 3))) (not (= "est</h" (str.substr x 44 6)))))
(assert (or (not (= "a" (str.substr x 52 1))) (str.suffixof "ocus>" x)))
(assert (or (not (str.contains z "t(1)></tfo")) (not (str.contains (str.replace y "ert(" " ") "l 1)"""))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]+(([',. -][a-zA-Z0-9 ])?[a-zA-Z0-9]*)*$")))
(assert (or (str.prefixof """>test</i" z) (<= (str.len y) 106)))
(check-sat)
