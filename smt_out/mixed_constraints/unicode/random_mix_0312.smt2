; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog onkeypress=""alert(1)"" contenteditable>test</dialog>") (= x "&#x03c") (= x "<menuitem onfocusout=alert(1\u{10348}) tabindex=1 id=x></menuitem><input autof\u{20000}ocus>")))
(assert (or (= z "x28;1&#x29;""/*/onerror='eval(src)'>") (= z "raggable=""true"" ondrag=""alert(1)"">test</input>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 32) "n"))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^(http:)(.)")))
(assert (or (not (str.prefixof "&#x03" x)) (str.contains (str.replace x "&#x03" "") "c") (str.contains x "menuitem")))
(assert (str.contains x "r\u{1d400}ogress "))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{1,10}"))) (not (>= (str.len z) 38))))
(check-sat)
