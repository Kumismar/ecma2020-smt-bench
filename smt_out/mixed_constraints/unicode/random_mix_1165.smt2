; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<output onclick=""alert(1)"">test</output>") (= x "<style>:target {color:red;}</style><table id=x style=""transition:color 1s"" ontransitionend=alert(1)></table>") (= x "<div draggable=""true"" contenteditable>drag me</div><bdo ondragover=alert(1) contenteditable>drop here</bdo>")))
(assert (or (= z "itable>test</em>") (= z "(1)"">test</output>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Z]{8,11}$"))) (= (str.at z 9) "s")))
(assert (str.suffixof "</output>" z))
(assert (not (= "tors();}<" (str.substr y 7 9))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.*\..{2,}$"))) (not (= "d" (str.substr y 47 1))) (not (str.contains (str.replace x "c" """") "n""li"))))
(assert (not (str.contains (str.replace y "</sum" """") "est""mary>")))
(assert (or (str.suffixof ">test</em>" z) (not (= (str.len y) 126)) (str.suffixof ">" x)))
(check-sat)
