; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><title id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></title>") (= x "\u{bc}script\u{be}alert(\u{a2}XSS\u{a2})\u{bc}/script\u{be}")))
(assert (or (= z "st</area>") (= z "raggable=""true"" ondragstart=""alert(1)"">test</q>") (= z "lert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (= "<style>:target {color: red;}</style><fieldset id=x style=alert(1)transition:color 10s"" ontransitioncancel=alert(1)></fieldset>s x{}</style><video style=""animation-name:x"" onanimationend=""alert(1)""></video>" (str.replace y """" "alert(1)")))
(assert (or (not (str.contains y "tyle><titl")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{3}|[0-9]{1,3})(\]?)$")))))
(assert (or (= "yle>:ta" (str.substr x 3 7)) (not (= (str.indexof y "it" 0) 38))))
(assert (or (not (str.suffixof ";"">" x)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{10}"))) (<= (str.len y) 72)))
(assert (or (= (str.at y 67) ">") (not (= (str.at z 6) "l"))))
(assert (not (= (str.at x 8) "t")))
(check-sat)
