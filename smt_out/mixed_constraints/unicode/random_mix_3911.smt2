; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figcaption onkeyup=""alert(1)"" contenteditable>test</figcaption>") (= x "<img \x47src=x onerror=""javascr\u{20000}ip\u{1f600}t:alert(1)"">") (= x "<map onbeforepaste=""alert(1)"" contenteditable>test</map>")))
(assert (or (= z "ndex=1 id=x></code><input autofocus>") (= z "lert(1)"" contenteditable>test</aside>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "up=""alert("))
(assert (or (not (= (str.indexof x "ditab" 0) 39)) (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{7,}$"))))
(assert (or (not (>= (str.len y) 94)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*([A-Za-z\/\s\.'-]{1,}([\.,] |[-']| ))+[A-Za-z]+\.?\s*$|\w+"))) (= (str.at x 21) "a")))
(assert (or (str.prefixof "<form dra" y) (not (= (str.at x 46) "b"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]{1,})+$")) (not (= "<figcaption onkeyup=""alejavascript:)"" contenteditable>test</figcaption>lert(1)"" contenteditable>test</aside>" (str.replace y "rt(1" "javascript:"))) (not (= (str.at y 19) """"))))
(assert (or (not (str.contains x "erro")) (not (>= (str.len z) 20))))
(check-sat)
