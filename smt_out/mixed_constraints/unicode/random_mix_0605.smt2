; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script onmouseup=""alert(1)"">test</script>") (= x "<tt onmouseout=""alert(1)"">test</tt>")))
(assert (or (= z "GROUND=""javascript:alert('XSS')"">") (= z ") tabindex=1 id=x></ul><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len y) 75)))
(assert (not (str.contains (str.replace y "mou" "javascript:") " onjavascript:seu")))
(assert (str.prefixof "<scri" y))
(assert (or (str.contains (str.replace y "t('" "<b>") "ler<b>XSS") (str.prefixof ") tabind" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd} \s]{2,50}"))))
(assert (or (= (str.at x 75) "7") (not (= "utofocu" (str.substr z 31 7)))))
(check-sat)
