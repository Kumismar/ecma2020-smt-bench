(declare-const z String)
(assert (or (= x "ABC<div style=""x:\xE3\x80\x80expression(javascript:alert(1)"">DEF") (= x "\u{201c}><<script>alert(document.cookie);//<</script>")))
(assert (or (= z ")"" contenteditable>test</area>") (= z "put>") (= z ": rotate(180deg);}</style><colgroup id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></colgroup>")))
(assert (= y (str.++ x z)))
