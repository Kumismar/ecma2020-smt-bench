; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main onfocusout=alert(1) tabindex=1 id=x></main><input autofocus>") (= x "<style>@keyframes x{}</style><li style=""animation-name:x"" onanimationstart=""alert(1)""></li>") (= x "<menu id=x tabindex=1 onfocusin=alert(1)></menu>")))
(assert (or (= z "ble>test</option>\u{10348}") (= z "st</header>") (= z "ntextmenu=""alert(1)"">test</option>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "st</headx>" (str.replace z "er" "x"))) (not (str.contains x " x{}"))))
(assert (str.contains (str.replace y "i st" """") "l""y"))
(assert (not (= (str.at z 14) "o")))
(assert (or (not (= "=x>" (str.substr x 41 3))) (not (str.prefixof "st</he" z)) (str.in_re z ((_ re.from_regex ecma2020 u) "^((8|\+3)[\- ]?)?(\(?\d{3}\)?[\- ]?)?[\d\- ]{7,10}$"))))
(assert (= "<xonmousedown=""alert(1)"">test</a\u{1d400}rea>" (str.replace x "area " "x")))
(check-sat)
