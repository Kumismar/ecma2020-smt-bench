; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th id=x tabindex=1 onfocusin=alert(1)></th>") (= x "<img onmousemove=""alert(1)"">test</img>")))
(assert (or (= z " SRC=""http://hacker.com/xss.swf"" AllowScriptAccess=""always"">") (= z "1)"">test</blink>") (= z """alert(1)"">test</a>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9\/\-\+\s\(\)]*$"))))
(assert (or (not (= (str.indexof z ")" 0) 8)) (str.contains z "wf"" ")))
(assert (or (not (= (str.at y 41) "i")) (str.contains (str.replace y "ta" "x") "id=x xbind") (= "img>""aler" (str.substr y 34 9))))
(assert (or (not (str.prefixof " SRC=""ht" z)) (not (str.contains (str.replace y "mg>1)" "<b>") "i<b>"">tes"))))
(assert (or (not (>= (str.len x) 41)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*\d).{8,}"))) (not (<= (str.len z) 66))))
(assert (or (<= (str.len z) 23) (not (str.prefixof "<div dragg" x))))
(check-sat)
