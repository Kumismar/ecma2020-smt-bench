; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video oncopy=""alert(1)"" contenteditable>test</video>") (= x "<li onmousedown=""alert(1)"">test</li>")))
(assert (or (= z "ofocus>") (= z "cite onmouseout=""alert(1)"">test</cite>") (= z "test</ruby>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 25) """")) (not (= "ofocu" (str.substr z 0 5))) (str.in_re x ((_ re.from_regex ecma2020 u) "(^\d{5}(-\d{4})?$)$"))))
(assert (or (not (= (str.indexof x " o" 0) 3)) (not (= (str.len y) 60))))
(assert (or (= (str.indexof x "le>te" 0) 42) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Z]{2,3}_[a-z]+:[0-9]{4}$")))))
(assert (not (= (str.indexof z "foc" 0) 1)))
(assert (or (= (str.at y 50) "e") (not (>= (str.len x) 37))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z. ']*$"))))
(assert (or (not (= "st</cite" (str.substr z 29 8))) (not (str.contains z ")"""))))
(check-sat)
