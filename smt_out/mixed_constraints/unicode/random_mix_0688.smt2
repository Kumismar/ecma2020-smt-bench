; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rt onkeyup=""alert(1)"" contenteditable>test</rt>") (= x "<dialog draggable=""true"" ondragend=""alert(1)"">test</dialog>")))
(assert (or (= z "=""alert(1)""></rb>") (= z "st</li>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len z) 22))
(assert (or (str.contains (str.replace z "t</l" "alert(1)") "salert(1)i>") (not (= "t" (str.substr x 46 1))) (not (str.prefixof "<script" y))))
(assert (or (not (= "xt/html" (str.substr z 2 7))) (str.suffixof "</dialog>" x)))
(assert (or (= (str.indexof x "e" 0) 7) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1][3,4,5,7,8][0-9]{9}$"))) (not (= "<code onbeforecut=""alert(1)"" co nteditable>test</code>ondragenter=""alert(1)"">test</strong>" (str.replace y "nte" " ")))))
(assert (<= (str.len y) 75))
(check-sat)
