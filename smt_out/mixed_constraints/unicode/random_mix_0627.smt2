; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp draggable=""true"" ondragleave=""alert(1)"">test</samp>") (= x "<body onorientationchange=alert(1)>")))
(assert (or (= z "<isindex ondragover=alert(1) contenteditable>drop here</isindex>") (= z "tyle=""transition:color 10s"" ontransitioncancel=alert(1)></menuitem>") (= z "#/#0#(0)})</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 67) "a")) (str.suffixof ">" z) (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{13}$"))))
(assert (or (not (= "ri" (str.substr z 14 2))) (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9\-]+)\.(([a-zA-Z]{2,50})|([a-zA-Z]{2,50}\.[a-zA-Z]{2,50})|([a-zA-Z]{2,50}\.[a-zA-Z]{2,50}\.[a-zA-Z]{2,50}))$")) (str.contains (str.replace z ":c" "javascript:") "ionjavascript:o")))
(assert (or (<= (str.len z) 66) (str.contains z "})</scri")))
(assert (= (str.at y 61) "#"))
(assert (not (= (str.at y 81) "=")))
(check-sat)
