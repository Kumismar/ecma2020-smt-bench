; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><xmp ondrop=alert(1) contenteditable>drop here</xmp>") (= x "<div id=d><x xmlns='""><iframe onload=alert(2)//'></div>") (= x "<SCRIPT FOR\u{20000}=document EVENT=onreadystatechange>javascript:alert(1)</SCRIPT>")))
(assert (or (= z "nmous\u{1f600}eover=""alert(1)"">test</command>") (= z "e>drop here</var>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9\s]*$"))))
(assert (not (str.contains z "nd>")))
(assert (or (>= (str.len z) 11) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\(11\) [9][0-9]{4}-[0-9]{4})|(\(11\) [1-7][0-9]{3}-[0-9]{4})|(\(1[2-9]\) [5-9][0-9]{3}-[0-9]{4})|(\([2-9][1-9]\) [5-9][0-9]{3}-[0-9]{4})$")))))
(assert (not (str.prefixof "<di" y)))
(assert (or (= "dyst" (str.substr x 33 4)) (not (str.prefixof "<div drag" x)) (>= (str.len z) 29)))
(assert (not (str.contains x "ipt:")))
(check-sat)
