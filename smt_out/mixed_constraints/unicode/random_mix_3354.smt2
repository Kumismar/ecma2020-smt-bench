; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><link ondragover=alert(1) contenteditable>drop here</link>") (= x "<data\u{1f4a9}list draggable=""true"" ondragstart=""\u{1f4a9}alert(1)"">test</datalist>") (= x "<IMG DYNSRC=\""javascript:alert('XSS')\"">")))
(assert (or (= z "t(1)"">test</footer>") (= z "ue"" ondragend=""alert(1)"">test</frameset>") (= z "test</figure>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.+@.+\.[a-z]+$"))) (= (str.indexof z "t" 0) 3) (str.prefixof "u" z)))
(assert (or (str.contains (str.replace z "/fi" "") "t<gure") (str.prefixof "<dat" x)))
(assert (or (<= (str.len x) 71) (str.contains z """alert(1)")))
(assert (or (str.prefixof "<data\u{1f4a9}list" y) (= (str.indexof x "p" 0) 22)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[a-z0-9]+([\-\.]{1}[a-z0-9]+)*\.[a-z]{2,20}(:[0-9]{1,5})?(\/.*)?$")))
(assert (or (str.suffixof ">" y) (= (str.at y 45) "n") (not (= (str.indexof z "(1" 0) 1))))
(assert (not (str.contains y "=aler")))
(check-sat)
