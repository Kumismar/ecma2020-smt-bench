; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\&\u{1f600}quot;;\u{1d400}alert(&apos;XSS&apos;);//") (= x "<q id=x tabindex=1 ondeactivate=alert(1)></q><input id=y autofocus>") (= x "<style draggable=""true"" ondragend=""alert(1)"">test</style>")))
(assert (or (= z "><script>alert(navigator.userAgent)</script>></body>") (= z "1)></image><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "/sty")) (str.contains (str.replace y "m" "x") "xtxen") (not (= (str.indexof y ")</sc" 0) 69))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(?=(.*[0-9]))(?=.*[a-z\u{430}-\u{44f}])(?=(.*[A-Z\u{410}-\u{42f}]))(?=(.*)).{6,20}")) (not (= (str.at x 21) "d")) (str.contains (str.replace z "au" "<b>") " <b>tofo")))
(assert (not (str.prefixof "1)></im" z)))
(assert (or (str.contains y ":tar") (not (= (str.at x 13) "r")) (not (str.contains z "rt(navigat"))))
(assert (or (str.prefixof "<" y) (<= (str.len z) 35) (not (= "n" (str.substr y 12 1)))))
(check-sat)
