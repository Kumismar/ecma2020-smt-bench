; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;A HREF="";http://0x42.0x0000066.0x7.0x93/"";>;XSS<;/A>;") (= x "<header onclick=""alert(1)"">test</header>") (= x "&lt;SCRIPT SRC=&quot;http://ha.ckers.org/xss.jpg&quot;&gt;&lt;/SCRIPT&gt;")))
(assert (or (= z " id=x></dd><input autofocus>") (= z "ng id=x tabindex=1 onactivate=alert(1)></listing>") (= z "lert(1)"" contenteditable>test</hgroup>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof " id=x></" z)) (not (str.suffixof "/A>;" x))))
(assert (or (<= (str.len z) 50) (= "dy onaf" (str.substr x 3 7))))
(assert (or (not (str.suffixof "up>" z)) (>= (str.len x) 68)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*\d)(?=.*[A-Z])(?=.*[a-z])[0-9A-Za-z]{8,}$")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(.){6,}$"))) (not (str.contains x "00066"))))
(assert (or (<= (str.len y) 93) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^1[34578]\d{9}$")))))
(check-sat)
