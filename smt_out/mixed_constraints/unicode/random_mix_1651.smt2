; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table onmouseup=""alert(1)"">test</table>") (= x "<plaintext draggable=""true"" ondragenter=""alert(1)"">test</plaintext>")))
(assert (or (= z "t</nav>") (= z "av&#x0D;ascript:alert('XSS');"">") (= z "t</s>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 3) "n")) (not (= (str.indexof z "is" 0) 1)) (= "alert" (str.substr y 83 5))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{1,9}$"))) (not (= (str.len x) 40))))
(assert (not (= "<plaintext draggable=""true"" ondragenter=""alx1)"">test</plaintext>" (str.replace x "ert(" "x"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.{1,200}"))) (not (str.suffixof "</nav>" y))))
(check-sat)
