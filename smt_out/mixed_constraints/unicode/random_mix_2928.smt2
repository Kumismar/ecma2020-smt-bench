; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=x onerror=\x09""javascript:alert(1)"">") (= x "<nextid oncopy=""alert(1)"" contenteditable>test</nextid>")))
(assert (or (= z "e=""true"" ondragend=""alert(1)"">test</map>") (= z "wn=""alert(1)"">test</progress>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "wn=" z)) (not (<= (str.len x) 48)) (= (str.len z) 40)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.*(?<!gmail\.com|yahoo\.com|me\.com|hotmail\.com|outlook\.com)$"))))
(assert (or (str.suffixof "(1)"">" x) (= (str.indexof x "nexti" 0) 1) (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{7}-[0-9]{7}$"))))
(assert (not (= "<img src=x onerror=\x09""javascript:alert(1)""javascript:" (str.replace x ">" "javascript:"))))
(assert (= (str.at x 7) " "))
(assert (= (str.len x) 44))
(check-sat)
