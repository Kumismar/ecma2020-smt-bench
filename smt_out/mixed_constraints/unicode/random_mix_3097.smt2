; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><optgroup ondrop=alert(1) contenteditable>drop here</optgroup>") (= x "<svg><rb onload=alert(1)></rb>")))
(assert (or (= z "forecut=""alert(1)"" contenteditable>test</li>") (= z "marquee>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "r" 0) 2)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(([a-zA-Z]|[0-9])|([-]|[_]|[.]))+[@](([a-zA-Z0-9])|([-])){2,63}[.](([a-zA-Z0-9]){2,63})+$"))) (not (= (str.indexof z "=""a" 0) 7))))
(assert (or (not (str.contains y "io.wav"" ty")) (not (= (str.at z 38) "t"))))
(assert (or (not (>= (str.len z) 39)) (not (= (str.len y) 157))))
(assert (or (not (= """quee>" (str.replace z "mar" """"))) (= "<div draggabjavascript:e=""true"" contenteditable>drag me</div><optgroup ondrop=alert(1) contenteditable>drop here</optgroup>marquee>" (str.replace y "l" "javascript:"))))
(assert (= (str.indexof z "eta>" 0) 5))
(assert (str.suffixof "marquee>" y))
(assert (or (str.contains z "rquee") (= "i" (str.substr y 86 1))))
(check-sat)
