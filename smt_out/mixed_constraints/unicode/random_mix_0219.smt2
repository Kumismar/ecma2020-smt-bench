; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<header oncut=""alert(1)"" contenteditable>test</header>") (= x "<\u{10348}meter onblur=alert(1) tabinde\u{1f600}x=1 id=x></meter><input autofocus>") (= x "<iframe style=""position:absolute;top:0;left:0;width:100%;height:100%"" onmouseover=""prompt(1)"">")))
(assert (or (= z "ogress onkeydown=""alert(1)"" contenteditable>test</progress>") (= z "RIPT SRC=//ha&#46;ckers&#46;org/&#46;js&gt;") (= z "index=1 onfocus=alert(1)></q>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len x) 64)) (str.contains x "ut autof") (= ">RI" (str.substr y 53 3))))
(assert (or (str.suffixof "ails>" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{9}?$"))) (= (str.indexof y "t a" 0) 54)))
(assert (or (not (str.suffixof "ess>" z)) (not (str.suffixof "progress>" z)) (not (str.contains (str.replace z " con" """") """""te"))))
(assert (str.prefixof "index=1 " z))
(assert (not (= (str.at x 8) "o")))
(check-sat)
