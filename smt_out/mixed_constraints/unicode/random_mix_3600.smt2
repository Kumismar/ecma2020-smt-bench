; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img/&#09;&#10;&#11; src=`~` onerror=prompt(1)>") (= x "<style>:target {color:red;}</style><keygen id=x s\u{20000}tyle=""transition:color 1s"" ontransitionend=alert(1)></keygen>") (= x "<style>:target {transform: rotate(180deg);}</style><content id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></content>")))
(assert (or (= z "ite ondrop=alert(1) contenteditable>drop here</cite>") (= z "agleave=""alert(1)"">test</caption>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "arget" "alert(1)") ">:talert(1) ")) (not (str.prefixof "<img/" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+(?:[0-9] ?){6,14}[0-9]$")))))
(assert (or (not (= (str.at y 21) "e")) (not (= (str.indexof y "rm " 0) 90))))
(assert (or (not (= (str.indexof y "ati" 0) 48)) (str.prefixof "<STYLE>BO" x)))
(assert (not (= (str.len y) 80)))
(check-sat)
