; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<vi\u{1d400}\u{1f600}deo><source onerror=alert(1) src=1></video>") (= x "<style>:target {color: red;}</style><listing id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></listing>") (= x """><iframe%20src=""http://google.com""%%203E")))
(assert (or (= z """alert(1)"" contenteditable>test</rp>") (= z "ot/>//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof """" y)) (not (= (str.indexof x """ o" 0) 75))))
(assert (or (= (str.len z) 23) (= (str.len x) 48)))
(assert (str.contains x "me%20s"))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z]+@{1}[A-Za-z]+\.{1}[A-Za-z]{2,}$")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\d]{10,15}$"))))
(assert (not (str.prefixof """" x)))
(assert (or (str.contains z """'`-->]]") (not (<= (str.len z) 37)) (not (= "<style>:target {color: red;}</style><listing id=x style=""transition:color 10s"" o ansitioncancel=alert(1)></listing>" (str.replace x "ntr" " ")))))
(assert (or (not (= " src" (str.substr y 33 4))) (not (= (str.indexof x "r" 0) 13))))
(assert (= (str.at x 16) """"))
(check-sat)
