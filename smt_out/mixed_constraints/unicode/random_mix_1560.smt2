; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe id=x tabindex=1 onactivate=alert(1)></iframe>") (= x "&lt;BODY BACKGROUND=\""javascript&#058;alert('XSS')\""&gt;")))
(assert (or (= z "exp\x00ression(javascript:alert(1)"">DEF") (= z "ideo draggable=""true"" ondragend=""alert(1)"">test</video>")))
(assert (= y (str.++ x z)))
(assert (or (= "BOD" (str.substr x 4 3)) (not (= "ideo draggable=""true"" ondragend=""alert(1)"">""/video>" (str.replace z "test<" """")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(\+7|7|8)?[\s\-]?\(?[489][0-9]{2}\)?[\s\-]?[0-9]{3}[\s\-]?[0-9]{2}[\s\-]?[0-9]{2}$"))))
(assert (or (not (= "eo>" (str.substr z 52 8))) (not (>= (str.len z) 49)) (not (<= (str.len x) 57))))
(assert (or (not (str.contains (str.replace y "ndex" "x") " tabix=1")) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451} ]+$"))))
(assert (or (not (str.suffixof ")"">DEF" y)) (not (= (str.len y) 44))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^BE\d{3,7}|be\d{3,7}$"))))
(assert (str.contains x "able>test<"))
(check-sat)
