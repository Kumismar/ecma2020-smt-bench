; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend id=x tabindex=1 ondeactivate=alert(1)></legend><input id=y autofocus>") (= x "<code onmouseenter=""alert(1)"">test</code>") (= x "<D3/OnMouSEenTer=[2].find(confirm)>z")))
(assert (or (= z ":target {transform: rotate(180deg);}</style><br id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></br>") (= z "IMG SRC=# onmouseover=""alert('xxs')"">") (= z ".htc);"">")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "act" 0) 28) (= "<code xseenter=""alert(1)"">test</code>" (str.replace x "onmou" "x"))))
(assert (or (= (str.at z 11) "m") (not (str.in_re x ((_ re.from_regex ecma2020 u) "[9|8|7|6|5|4|3|2|1|0]\d{9}$"))) (str.contains (str.replace z "e=""tr" "x") "stylxan")))
(assert (str.prefixof """>test</pa" z))
(assert (or (= (str.at y 17) "e") (= (str.indexof z "ht" 0) 1)))
(assert (or (not (= "ch" (str.substr x 4 2))) (= "<summary draggable=""tru<b> ondragstart=""alert(1)"">test</summary>" (str.replace x "e""" "<b>")) (str.prefixof "<co" y)))
(assert (not (= (str.at z 95) "o")))
(check-sat)
