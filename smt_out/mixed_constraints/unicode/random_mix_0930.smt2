; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<multicol draggable=""true"" ondragstart=""alert(1)"">test</multicol>") (= x "<data onclick=""alert(1)"">test</data>")))
(assert (or (= z "ypress=""alert(1)"" contenteditable>test</tfoot>") (= z "06F\u{5c}u0077 ~ \u{5c}u0074\u{5c}u0068\u{5c}u0069\u{5c}u0073.  \u{5c}u0061\u{5c}u006C\u{5c}u0065\u{5c}u0072\u{5c}u0074(~'\u{5c}u0061')</script U+")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof ";A " z)) (= (str.len z) 91)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^05[0-9]{2}\s{1}[0-9]{3}\s{1}[0-9]{2}\s{1}[0-9]{2}$")) (= "<multicol draggable=""true"" ondragstart=""alert(1)"">test</multicol>0xF\u{5c}u0077 ~ \u{5c}u0074\u{5c}u0068\u{5c}u0069\u{5c}u0073.  \u{5c}u0061\u{5c}u006C\u{5c}u0065\u{5c}u0072\u{5c}u0074(~'\u{5c}u0061')</script U+" (str.replace y "6" "x"))))
(assert (= "/multi" (str.substr x 55 6)))
(assert (or (not (= "<daa onclick=""alert(1)"">test</data>" (str.replace x "t" ""))) (str.contains z "ert(1)"" co")))
(assert (or (str.prefixof "<data onc" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "number_greater_than_zero")))))
(check-sat)
