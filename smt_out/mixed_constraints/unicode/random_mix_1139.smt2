; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed onkeypress=""alert(1)"" contenteditable>test</noembed>") (= x "<style>:target {transform: rotate(180deg);}</style><frame id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></frame>")))
(assert (or (= z "tem>") (= z "r=""alert(1)"">test</meta>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{2,3}-?[0-9]{7}$"))))
(assert (not (str.contains (str.replace y "emb" "x") "<noxed o")))
(assert (or (= "<style>:target {transform: rotate(180deg);}</style><frame id=x style=""transition:transform  ntransitionrun=alert(1)></frame>r=""alert(1)"">test</meta>" (str.replace y "2s"" o" " ")) (str.contains z "(1)""")))
(assert (<= (str.len x) 78))
(assert (not (str.suffixof ")></frame>" x)))
(assert (not (str.contains y "onrun=ale")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?!First Name|first name|FIRST NAME)[a-zA-Z][a-zA-Z ]+"))) (str.prefixof "<li" x)))
(assert (or (not (str.prefixof "<" y)) (= "<<b> draggable=""true"" contenteditable>drag me</div><time ondrop=alert(1) contenteditable>drop here</time>oup>" (str.replace y "div" "<b>"))))
(assert (or (str.prefixof "tem>" z) (<= (str.len x) 66)))
(assert (or (not (= (str.at z 3) ">")) (str.contains y "t(1)></fra")))
(check-sat)
