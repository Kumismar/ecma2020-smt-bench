; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><center ondrop=alert(1) contenteditable>drop here</center>") (= x "<div draggable=""true"" contenteditable>drag me</div><track ondragover=alert(1) contenteditable>drop here</track>") (= x "<center onbeforepaste=\u{1f600}""alert(1)"" contenteditable>test</\u{1f600}center>")))
(assert (or (= z " onmousedown=""alert(1)"">test</del>") (= z " src=x onerror=alert(3)//'>//[""'`-->]]>]</div>") (= z "lert(1)></frameset>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "\u{1f600}center>" x) (str.contains x """true"" ond") (not (str.contains (str.replace x "it" " ") "ted able>"))))
(assert (not (= "<djavascript: draggable=""true"" contenteditable>drag me</div><track ondragover=alert(1) contenteditable>drop here</track> onmousedown=""alert(1)"">test</del>" (str.replace y "iv" "javascript:"))))
(assert (or (str.prefixof "<" y) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\d\.#\-',\/&\s]+$")) (not (str.suffixof "nter>" x))))
(assert (or (>= (str.len y) 149) (not (= (str.len x) 109))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.\-@_:]{3,50}$"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]+(([',. -][a-zA-Z0-9 ])?[a-zA-Z0-9]*)*$"))))
(assert (= "<center onbeforepaste=\u{1f600}""alert(1)"" contenteditable test</\u{1f600}center>" (str.replace x ">" " ")))
(check-sat)
