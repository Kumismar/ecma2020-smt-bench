; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup id=x tabindex=1 onfocusin=alert(1)></colgroup>") (= x "<input draggable=""true"" ondragstart=""alert(1)"">test</input>") (= x "<option onmouseup=""alert(1)"">test</option>")))
(assert (or (= z "alert(1)"" contenteditable>test</a>") (= z "nmousedown=""alert(1)"">test</code>") (= z "e=alert(1)></shado\u{20000}w>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "te" 0) 31))
(assert (not (str.contains z "rt(1")))
(assert (or (= (str.len x) 56) (= (str.len z) 33) (= (str.indexof z "sha" 0) 13)))
(assert (or (not (= (str.at y 12) "u")) (not (str.contains z "t(1")) (not (str.contains (str.replace y "ed" "x") "nmousxown"))))
(assert (or (not (<= (str.len y) 79)) (not (= (str.at x 4) "i"))))
(assert (str.contains x "bi"))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^\w{6}-.*$")))
(assert (or (= (str.indexof z "(1)>" 0) 7) (= "<colgroup id=x tabindex=1 onfocusin=alert(1)""</colgroup>" (str.replace x ">" """"))))
(assert (not (= "c" (str.substr x 1 1))))
(check-sat)
