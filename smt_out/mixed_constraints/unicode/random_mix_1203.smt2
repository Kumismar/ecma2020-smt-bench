; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<basefont id=x tabindex=1 onfocusin=alert(1)></basefont>") (= x "<IMG SRC=x oncut=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "nym id=x tabindex=1 onactivate=alert(1)></acronym>") (= z "ationstart=""alert(1)""></acronym>") (= z "dy>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*\d).{6,20}"))) (= (str.at x 25) " ")))
(assert (str.suffixof ">" x))
(assert (or (str.suffixof ">" z) (= "o" (str.substr y 29 1))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^ ]+@[^ ]+\.[a-z]{2,6}$"))) (not (= (str.at y 45) "8"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((\+|00)[0-9][0-9])?([0-9]{9,10})$"))) (not (= (str.indexof y "utpu" 0) 2)) (not (str.contains y "(1)"""))))
(assert (or (not (= (str.at z 23) "c")) (= "f" (str.substr x 28 1))))
(assert (or (not (= "<basefont id=x tabi""ex=1 onfocusin=alert(1)></basefont>" (str.replace x "nd" """"))) (not (>= (str.len x) 56))))
(check-sat)
