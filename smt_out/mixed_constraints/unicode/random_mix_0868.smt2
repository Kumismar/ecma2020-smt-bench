; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<font oncut=""alert(1)"" contenteditable>test</font>") (= x "<rtc onbe\u{10348}forepaste=""alert(\u{1f600}1)"" contenteditable>test</rtc>") (= x "<colgroup draggable=""true"" ondragleave=""alert(1)"">test</colgroup>")))
(assert (or (= z "style type=""text/css"">BODY{background:url(""javascript:document.vulnerable=true"")}</style>") (= z " tabindex=1 onbeforeactivate=alert(1)></footer>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len x) 62)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9,.!? ]*$"))) (not (= "oter>" (str.substr y 100 5)))))
(assert (or (not (>= (str.len y) 100)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{92}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+([\.]{1})[0-9a-zA-Z\._-]+$"))) (not (= (str.len x) 56))))
(assert (= (str.indexof z "/styl" 0) 82))
(assert (or (not (str.prefixof "<font o" x)) (not (str.suffixof "style>" y))))
(assert (or (str.contains x " content") (str.contains (str.replace z "r>" "x") "footex")))
(check-sat)
