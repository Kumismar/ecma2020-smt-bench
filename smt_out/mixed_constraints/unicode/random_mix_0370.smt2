; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<output onmouseover=""alert(1)"">test</output>") (= x "<span onkeydown=""alert(1)"" contenteditable>test</span>") (= x "<sup oncut=\u{1d400}""al\u{1d400}ert(1)"" contenteditable>test</sup>")))
(assert (or (= z "ivate=alert(1)></figure>") (= z "0003c;") (= z "rt(\u{2019}XSS\u{2019})>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "ivate" z)) (not (str.contains (str.replace y "oncut" "alert(1)") "<sup alert(1)=")) (not (= (str.at y 28) ")"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[^@]+@[^@]+\.[^@]+$")) (not (= "<output onmouseover=""alert("">test</output>0003c;" (str.replace y "1)" ""))) (not (str.contains y "test</s"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*[A-Z])(?=.*[0-9])(?=.*[a-z]).{8,25}"))) (not (= "pt" (str.substr x 18 2))) (= (str.at z 24) "o")))
(assert (str.prefixof "<ou" y))
(assert (or (not (str.suffixof "SS\u{2019})>" z)) (str.in_re z ((_ re.from_regex ecma2020 u) "^\(([0-9\s]){3}\)\s??([0-9\s]){9}$")) (not (= (str.at x 21) "a"))))
(assert (not (str.prefixof "0" z)))
(check-sat)
