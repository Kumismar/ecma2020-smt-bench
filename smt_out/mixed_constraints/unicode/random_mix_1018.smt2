; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onmouseleave=""alert(1)"">test</cite>") (= x "<xmp onmouseout=""alert(1)"">test</xmp>") (= x "Redirect 302 /a.jpg http://victimsite.com/admin.asp&amp;deleteuser")))
(assert (or (= z "tenteditable>test</blink>") (= z "table>drag me</div><wbr ondrop=alert(1) contenteditable>drop here</wbr>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z " contente") (not (= "eave=""ale" (str.substr x 14 9))) (not (str.contains (str.replace x "t(1" " ") """aler )"">t"))))
(assert (or (= """aler" (str.substr y 16 5)) (str.in_re y ((_ re.from_regex ecma2020 u) "^AT\d{3,7}$"))))
(assert (or (not (str.contains y "ble")) (not (= "<cite useleave=""alert(1)"">test</cite>table>drag me</div><wbr ondrop=alert(1) contenteditable>drop here</wbr>" (str.replace y "onmo" ""))) (= (str.indexof y "tente" 0) 41)))
(assert (or (str.prefixof "(1)"">tes" z) (str.contains z "op her")))
(check-sat)
