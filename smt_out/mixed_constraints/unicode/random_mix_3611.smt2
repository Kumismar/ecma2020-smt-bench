; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noframes onmouseleave=""alert(1)"">test</noframes>") (= x "<video oncopy=""alert(1)"" contenteditable>test</video>") (= x "<svg onbeforecopy=""alert(1)"" contenteditable>test</svg>")))
(assert (or (= z "n=""alert(1)"" contenteditable>test</audio>") (= z "q draggable=""true"" ondragenter=""alert(1)"">test</q>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "st</q>" y) (not (= (str.indexof y "</" 0) 49))))
(assert (= (str.at z 2) """"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9]).{8,128}$"))))
(assert (or (not (= "q draggable=""true"" genter=""alert(1)"">test</q>" (str.replace z "ondra" ""))) (= "rt(1)"" " (str.substr z 6 7))))
(assert (or (str.prefixof ">" z) (str.prefixof "<svg onbef" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z0-9 ]{1,30}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1]?[124]$")))))
(assert (= (str.indexof z "(" 0) 37))
(check-sat)
