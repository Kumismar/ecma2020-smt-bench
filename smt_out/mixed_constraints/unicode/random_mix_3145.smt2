; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<listing onmouseenter=""alert(1)"">test</listing>") (= x "<canvas onblur=alert(1) tabindex=1 id=x></canvas><input autofocus>")))
(assert (or (= z "ondragleave=""alert(1)"">test</div>") (= z "n:color 10s"" ontransitioncancel=alert(1)></wbr>")))
(assert (= y (str.++ x z)))
(assert (not (= "ert(1) " (str.substr x 17 7))))
(assert (or (not (str.contains (str.replace x "<canv" "alert(1)") "alert(1)as")) (str.prefixof "<canvas on" x) (not (str.suffixof "/div>" z))))
(assert (or (str.suffixof "isting>" x) (<= (str.len y) 96)))
(assert (or (str.suffixof "script>" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((19|20)\d{2}|\d{2})$")))))
(assert (or (str.contains (str.replace x "canv" "x") "<xa") (= (str.at z 19) "s")))
(check-sat)
