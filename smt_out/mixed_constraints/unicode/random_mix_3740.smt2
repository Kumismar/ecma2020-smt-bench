; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><command id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></command>") (= x "<style>:target {color: red;}</style><nav id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></nav>")))
(assert (or (= z "n=alert(1)></dd>") (= z "</picture>")))
(assert (= y (str.++ x z)))
(assert (not (= "picture>" (str.substr z 2 10))))
(assert (= "t(1)>" (str.substr y 138 5)))
(assert (or (str.prefixof "<h1 " y) (not (= (str.at y 116) "r"))))
(assert (not (= "n=ale1)></dd>" (str.replace z "rt(" ""))))
(assert (or (not (str.suffixof "dd>" y)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'*+=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))) (str.contains (str.replace x "e=""t" "alert(1)") "lalert(1)ransi")))
(assert (or (= (str.at y 58) "i") (= (str.indexof y "siti" 0) 57)))
(assert (or (not (= (str.at y 27) "}")) (not (str.prefixof "<style>:" y))))
(check-sat)
