; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tr onmouseout=""alert(1)"">test</tr>") (= x "<figure id=x tabindex=1 onactivate=alert(1)></figure>") (= x "<dt ondblclick=""alert(1)"">test</dt>")))
(assert (or (= z "(1)"">test</aside>") (= z "tabindex=1 ondeactivate=alert(1)></script><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len x) 35)) (str.prefixof "<" x) (= (str.indexof y "t;" 0) 2)))
(assert (or (not (= "nde" (str.substr x 17 3))) (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z\u{410}-\u{42f}\u{401}\u{430}-\u{44f}\u{451}]{2,30}"))))
(assert (or (not (str.contains y " onmous")) (not (= "<dt <b>blclick=""alert(1)"">test</dt>" (str.replace x "ond" "<b>")))))
(assert (or (not (str.contains y "gure>")) (not (str.contains z "rt("))))
(assert (or (str.suffixof "gure>" x) (>= (str.len z) 13) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-z0-9._%+-]+@[A-z0-9.-]+\.[A-z]{2,4}$")))))
(assert (= "1)"">test<" (str.substr z 1 9)))
(check-sat)
