; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody onbeforecut=""alert(1)"" contenteditable>test</tbody>") (= x "<div draggable=""true"" contenteditable>drag me</div><object ondrop=alert(1) contenteditable>drop here</object>")))
(assert (or (= z "late onmouseout=""alert(1)"">test</template>") (= z "all onkeyup=""alert(1)"" contenteditable>test</small>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<tbody " y) (not (= "est<" (str.substr z 40 4))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[+\d](?:.*\d)?$")))))
(assert (or (str.prefixof "<rtc o" y) (= (str.indexof z "ler" 0) 14)))
(assert (or (= (str.at y 152) "d") (= (str.len x) 77) (>= (str.len z) 42)))
(assert (or (= (str.indexof y "t" 0) 1) (not (str.suffixof "e>" y))))
(assert (not (str.contains y "ipt:ale")))
(assert (= "<tbody onbeforecut=""alert(1)"" contentedita<b>>test</tbody>" (str.replace x "ble" "<b>")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{7,12}")) (not (<= (str.len x) 118))))
(assert (str.suffixof "/small>" y))
(check-sat)
