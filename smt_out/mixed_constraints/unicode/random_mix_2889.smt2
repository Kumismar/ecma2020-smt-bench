; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend oncut=""alert(1)"" contenteditable>test</legend>") (= x "<style>@keyframes x{}</style><slot style=""animation-name:x"" onanimationstart=""alert(1)""></slot>") (= x "<;IMG "";"";"";>;<;SCRIPT>;alert("";XSS"";)<;/SCRIPT>;"";>;")))
(assert (or (= z "ntenteditable>tes\u{1d400}t</col>\u{1f600}") (= z "gress>") (= z "e=""true"" contenteditable>drag me</div><figcaption ondrop=alert(1) contenteditable>drop here</figcaption>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "ess>" z) (not (= (str.at z 85) "p"))))
(assert (= (str.indexof y "nte" 0) 106))
(assert (or (not (str.prefixof "<l" y)) (not (str.prefixof """><img " x)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(5)([0-9]{9})$|^[4-5]([0-9]{15})$")))))
(assert (= (str.indexof y "glea" 0) 26))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^18$")) (str.contains (str.replace z "gcap" " ") "v><fi tion ")))
(check-sat)
