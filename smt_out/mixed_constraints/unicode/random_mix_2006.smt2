; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "GIF89a/*<svg/onload=alert(1)>*/=alert(document.domain)//;") (= x "<track onbeforecopy=""alert(1)"" contenteditable>test</track>") (= x "<noframes onbeforecopy=""alert(1)"" contenteditable>test</noframes>")))
(assert (or (= z "=""true"" contenteditable>drag me</div><listing ondragover=alert(1) contenteditable>drop here</listing>") (= z "e onkeyup=""alert(1)"" contenteditable>test</blockquote>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "e>"))
(assert (or (>= (str.len x) 56) (not (= "<noframes onbefo<b>opy=""alert(1)"" contenteditable>test</noframes>" (str.replace x "rec" "<b>")))))
(assert (or (not (str.suffixof "ckquote>" y)) (= (str.indexof z """>" 0) 1)))
(assert (= "edown=""al" (str.substr x 11 9)))
(assert (or (= (str.at x 44) "t") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[A-Za-z0-9]+([\-\.]{1}[A-Za-z0-9]+)*\.[a-z]{2,5}(:[0-9]{1,5})?(\/.*)?$"))) (not (= "ing>" (str.substr z 97 4)))))
(assert (or (not (= (str.at x 11) "b")) (not (= (str.len x) 57))))
(assert (or (not (str.prefixof "<n" y)) (not (str.suffixof "canvas>" x))))
(assert (not (str.contains y "editable")))
(check-sat)
