; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote onblur=alert(1) tabindex=1 id=x></b\u{1f600}lockquote><in\u{10348}put autofocus>") (= x "<svg><acronym onload=alert(1)></acronym>")))
(assert (or (= z "ter onclick=""alert(1)"">test</footer>") (= z "ondrop=alert(1) contenteditable>drop here</picture>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "ronym ") (not (str.in_re z ((_ re.from_regex ecma2020 u) "((\|\|)|(&&)|(==)|([aA][Nn][dD])|([rR][Ee][Dd])|([Aa][Mm][Bb][Ee][Rr])|([Gg][Rr][Ee][Ee][Nn])|([Ii][Ff][Ff])|([Xx]?[Oo][Rr])|([Nn][Oo][Tt])|[RrAaGgTtFf!01^ ()?:]|[Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])*")))))
(assert (or (= (str.at x 39) ">") (= (str.indexof x "ss>" 0) 62) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9.+() ]*$")))))
(assert (or (str.contains (str.replace y "aler" " ") "ad= t(1)>") (<= (str.len z) 11)))
(assert (or (str.prefixof "[color=re" y) (str.suffixof "</footer>" y)))
(check-sat)
