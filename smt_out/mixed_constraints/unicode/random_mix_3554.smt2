; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "exp/*&lt;XSS STYLE=&apos;no\xss:noxss(&quot;*//*&quot;);") (= x "<blockquote onbeforepaste=""alert(1)"" contenteditable>test</blockquote>") (= x "<style>:target {transform: rotate(180deg);}</style><time id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></time>")))
(assert (or (= z "(1)"" contenteditable>test</code>") (= z "te onpaste=""alert(1)"" contenteditable>test</template>") (= z "7)%22>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "2>" y)))
(assert (or (str.contains x "transfor") (= (str.indexof y " ""a" 0) 7)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) ".+@.+..+"))))
(assert (or (str.suffixof "/time>" x) (>= (str.len y) 80) (= "(1)est</h1>" (str.replace z """>t\u{1f4a9}" ""))))
(assert (or (= (str.indexof y "e>(1)" 0) 68) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9,. ]*$"))))
(check-sat)
