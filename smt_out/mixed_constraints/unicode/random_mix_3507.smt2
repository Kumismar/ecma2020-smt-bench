; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q onkeydown=""alert(1)"" contenteditable>test</q>") (= x "<rt oncut=""alert(1)"" contenteditable>test</rt>")))
(assert (or (= z "st</center>") (= z "cript>") (= z "(1)"">test</p>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 8) "e")))
(assert (= (str.at y 38) "e"))
(assert (or (not (str.prefixof "v" z)) (not (str.suffixof "nd>" z))))
(assert (= (str.len y) 59))
(assert (or (not (str.prefixof "<r" x)) (str.contains (str.replace z "rip" "<b>") "c<b>t>")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^-\s][a-zA-Z0-9_\s-]+$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^@]+@[^@\.]+\.[^@]+$")))))
(check-sat)
