; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u onmouseenter=""alert(1)"">test</u>") (= x "<!-- IE 10 in IE5-9 Standards mode -->") (= x "<basefont id=x tabindex=1 ondeactivate=alert(1)></basefont><input id=y autofocus>")))
(assert (or (= z ">test</map>") (= z "able=""true"" ondragenter=""alert(1)"">test</td>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "e" 0) 9)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(.){4,8}$")))))
(assert (or (not (= " t" (str.substr y 14 2))) (not (= (str.len x) 35))))
(assert (or (str.prefixof "ondr" z) (str.suffixof "1)></col>" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[cominet]{2,}$")))))
(assert (not (= (str.indexof y "vat" 0) 34)))
(check-sat)
