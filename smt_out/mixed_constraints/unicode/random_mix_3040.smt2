; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd id=x tabindex=1 onbeforeactivate=alert(1)></dd>") (= x "<dd onbeforecut=""alert(1)"" con\u{20000}tenteditable>test</d\u{1d400}d>") (= x "<a onmouseover=alert(document.cookie)>xxs link</a>")))
(assert (or (= z "foredeactivate=alert(1)></pre><input autofocus>") (= z "ntenteditable>test</i>")))
(assert (= y (str.++ x z)))
(assert (not (= "ntenteditable>test<alert(1)i>" (str.replace z "/" "alert(1)"))))
(assert (not (str.contains x "ume")))
(assert (or (str.prefixof "<dd id" y) (str.prefixof "<a onmouse" y)))
(assert (or (str.prefixof "ntented" z) (not (= (str.indexof y " onbe" 0) 19))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,12}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[_A-z0-9]{10,}$"))) (not (= (str.at y 11) "b"))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9A-Za-z-_]+$")))
(assert (or (not (str.suffixof "data>" y)) (= (str.at y 24) "u") (= (str.at y 45) "e")))
(check-sat)
