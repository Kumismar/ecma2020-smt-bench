; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr draggable=""true"" ondragenter=""alert(1)"">test</hr>") (= x "<legend onbeforepaste=""alert(1)"" contenteditable>test</legend>")))
(assert (or (= z """; SRC="";http://ha.ckers.org/xss.js"";>;<;/SCRIPT>;") (= z "/u>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([\u{430}-\u{44f}\u{410}-\u{42f}\s\-]+[\u{430}-\u{44f}\u{410}-\u{42f}\s\.\-]+){1,30}$"))) (= (str.indexof y ";" 0) 54)))
(assert (or (not (= "<hrdraggable=""true"" ondragenter=""alert(1)"">test</hr>""; SRC="";http://ha.ckers.org/xss.js"";>;<;/SCRIPT>;" (str.replace y " " ""))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([\+]\d{11,13})$")))))
(assert (or (not (= (str.indexof y "s" 0) 18)) (not (= (str.indexof z "/u>" 0) 0))))
(assert (or (not (= "epaste=""al" (str.substr x 15 10))) (not (str.prefixof "<" y)) (not (= "1)"">tes" (str.substr y 40 7)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[_#]).{8,}"))) (= "t" (str.substr x 38 1))))
(check-sat)
