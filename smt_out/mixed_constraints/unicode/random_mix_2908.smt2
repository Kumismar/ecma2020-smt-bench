; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address id=x tabind\u{1f600}ex=1 ondeactivate=alert(1)\u{20000}></address><input id=y autofocus>") (= x "&#X000003c;") (= x "</title><script>alert(/xss/)</script>")))
(assert (or (= z ")></time><input autofocus>") (= z ":javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 48) "n") (str.suffixof "tofocus>" y)))
(assert (or (str.contains x "#X0") (str.contains (str.replace y "apt" " ") "/c ion>") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9 ]+){2,}$")))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[ABCEGHJKLMNPRSTVXYabceghjklmnprstvxy]{1}\d{1}[A-Za-z]{1} *\d{1}[A-Za-z]{1}\d{1}$")) (= "me" (str.substr y 43 2))))
(assert (not (str.prefixof "<captio" y)))
(assert (str.prefixof ":javasc" z))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-z0-9_\.+-]+)@([\da-z\.-]+)\.([a-z\.]{2,6})$"))) (not (str.suffixof "autofocus>" y)) (not (= "\u{20000}></ad" (str.substr y 47 6)))))
(assert (or (not (str.suffixof "us>" x)) (str.contains (str.replace y "(1)" " ") "rt  ") (<= (str.len z) 55)))
(check-sat)
