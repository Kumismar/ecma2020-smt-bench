; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script src=""//brutelogic.com.br&so\u{1d400}l;1.js&num;") (= x "<video onmouseout=""alert(1)"">test</video>") (= x "<div draggable=""true"" contenteditable>drag me</div><li ondrop=alert(1) contenteditable>drop here</li>")))
(assert (or (= z "f=""javascript:alert(130)"">CLICKME</math>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (= "=" (str.substr y 11 1))) (str.in_re x ((_ re.from_regex ecma2020 u) "^.{1,200}")) (not (= (str.indexof z ">CLI" 0) 25))))
(assert (or (not (= (str.indexof z ">" 0) 0)) (not (= (str.indexof z "E<" 0) 32)) (not (str.prefixof "x tabind" z))))
(assert (not (str.prefixof "t id" z)))
(assert (or (not (str.contains y "30)"">C")) (str.prefixof "f=""j" z) (not (<= (str.len y) 146))))
(check-sat)
