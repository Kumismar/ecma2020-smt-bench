; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset onkeyup=""alert(1)"" contenteditable>test</frameset>") (= x "<strong onpaste=""alert(1)"" contenteditable>test</strong>")))
(assert (or (= z "table>test</bgsound>") (= z " tabindex=1 onbeforeactivate=alert(1)></canvas>") (= z "alert(1)"">test</p>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 27) "e")) (str.contains (str.replace z "acti" "alert(1)") "realert(1)vate=") (not (str.contains z "alert"))))
(assert (str.contains y "able>te"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "([0-9]).*$"))) (str.suffixof ">test</p>" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.+@((?!gmail)(?!yahoo)(?!outlook)(?!icloud)(?!email)(?!qq)(?!aol)(?!hotmail).)+\..+$"))))
(assert (or (= (str.at z 1) "n") (not (str.contains y "g> t")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "19[0-9]{2}$|20[0-9]{2}$")))))
(check-sat)
