; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup oncopy=""alert(1)"" contenteditable>test</colgroup>") (= x "<a href=""jav&#65ascript:javascript:alert(1)"">test1</a>") (= x "<object onmouseenter=""alert(1)"">test</object>")))
(assert (or (= z "ble>\u{1d400}test</ins>") (= z "raggable=""true"" ondragenter=""alert(1)"">test</option>") (= z "m>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<isin<b>ex onmouseup=""alert(1)"">test</isindex>" (str.replace x "d" "<b>"))) (not (str.prefixof "raggabl" z))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!\s*$)[a-zA-Z'\s]{1,50}$"))))
(assert (or (<= (str.len y) 54) (not (str.prefixof "<sty" y)) (= (str.at x 32) "e")))
(assert (or (str.prefixof "<colgroup" y) (= "av&" (str.substr y 10 3))))
(assert (or (not (= (str.indexof z "er=""" 0) 25)) (not (<= (str.len x) 62))))
(check-sat)
