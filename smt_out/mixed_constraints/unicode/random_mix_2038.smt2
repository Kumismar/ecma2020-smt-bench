; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ul onfocusout=alert(1) tabindex=1 id=x></ul><input autofocus>") (= x "<style>:target {color: red;}</style><big id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></big>") (= x "</XSS/*-*/STYLE=xss:e/**/xpression(alert('XSS'))>")))
(assert (or (= z "alert(1)></xss>") (= z "<UL><LI>XSS") (= z "alert(\u{20000}1)"">test</blockquote>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-9]\d{4,9}$"))))
(assert (or (<= (str.len y) 115) (= (str.at x 34) "e")))
(assert (not (= (str.at x 27) "i")))
(assert (or (>= (str.len z) 4) (not (= "S/" (str.substr x 4 2)))))
(assert (or (= (str.len y) 77) (not (str.prefixof "http://w" x)) (not (= (str.at x 41) "i"))))
(assert (or (= (str.indexof x "rt(" 0) 18) (str.suffixof "ss>" y)))
(assert (or (not (str.suffixof "'XSS'))>" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9 +\-]{9,}"))) (= (str.indexof y "g>" 0) 107)))
(check-sat)
