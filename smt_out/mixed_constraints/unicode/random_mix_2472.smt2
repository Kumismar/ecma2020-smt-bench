; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr onclick=""alert(1)"">test</hr>") (= x "<audio autoplay controls onpause=alert(1)><source src=""validaudio.wav"" type=""audio/wav""></audio>") (= x "&lt;SPAN DATASRC=#I DATAFLD=C DATAFORMATAS=HTML&gt;&lt;/SPAN&gt;")))
(assert (or (= z """alert(1)"">test</caption>") (= z "re>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[^<>()!%_+$&]*$")) (not (str.contains z ">"))))
(assert (or (str.suffixof "/audio>re>" y) (= (str.indexof x "ATA" 0) 10)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{4}-\d{2}$"))) (>= (str.len z) 22) (= "c=""va" (str.substr y 52 5))))
(assert (str.suffixof "on>" y))
(assert (not (= (str.at x 5) "e")))
(assert (= (str.at y 17) "t"))
(assert (not (<= (str.len x) 98)))
(check-sat)
