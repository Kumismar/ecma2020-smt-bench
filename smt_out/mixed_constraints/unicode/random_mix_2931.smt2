; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><hgroup onload=alert(1)></hgroup>") (= x "<var draggable=""true"" ondrag=""alert(1)"">test</var>")))
(assert (or (= z "ue"" ondragstart=""alert(1)"">test</command>") (= z "py=""alert(1)"" contenteditable>test</optgroup>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "ert(" 0) 6)) (= "s" (str.substr y 60 1)) (not (str.suffixof "st</var>" x))))
(assert (or (not (= "a" (str.substr y 17 1))) (>= (str.len y) 83)))
(assert (or (not (= (str.at x 33) "r")) (not (str.contains y "alert")) (str.contains y "st</")))
(assert (or (str.suffixof "roup>" y) (str.contains x """true"" on") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z._\]+@[0-9a-zA-Z._\-]+$")))))
(check-sat)
