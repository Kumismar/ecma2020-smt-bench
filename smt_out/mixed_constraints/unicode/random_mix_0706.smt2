; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong id=x tabindex=1 onbeforedeactivate=alert(1)></strong><input autofocus>") (= x """`'><script>\xC2\x85javascript:alert(1)</script>") (= x "<noembed id=x tabindex=1 ondeactivate=alert(1)></noembed><input id=y autofocus>")))
(assert (or (= z "oncopy=""alert(1)"" contenteditable>test</blockquote>") (= z """>test</a>") (= z "tenteditable>test</fieldset>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof """`'" y) (= "<address onmouseout=""alert(1)"">test</address>-0080c744f389><param name=url value=javascjavascript:pt:javascript:alert(1)></OBJECT>" (str.replace y "ri" "javascript:")) (str.prefixof "<strong" x)))
(assert (not (str.suffixof "</hgroup>" y)))
(assert (or (str.contains (str.replace y "rt(1" "x") "alex)>") (= (str.at y 51) "e")))
(assert (= (str.at z 31) "l"))
(assert (or (str.prefixof """>test<" z) (not (str.contains (str.replace x "ale" "javascript:") """javascript:r"))))
(assert (not (<= (str.len x) 49)))
(assert (or (not (str.suffixof "oup>" z)) (= (str.at y 48) "(")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\+\(\) ]{8,}$"))))
(check-sat)
