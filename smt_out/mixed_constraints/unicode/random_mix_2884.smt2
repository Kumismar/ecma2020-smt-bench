; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist onkeydown=""alert(1)"" contenteditable>test</datalist>") (= x "&lt;OBJECT classid=clsid&#58;ae24fdae-03c6-11d1-8b76-0080c744f389&gt;&lt;param name=url value=javascript&#058;alert('XSS')&gt;&lt;/OBJECT&gt;") (= x "<style>@keyframes x{}</style><thead style=""animation-name:x"" onanimationend=""alert(1)""></thead>")))
(assert (or (= z "svg xmlns=""http://www\u{10348}.w3.org/2000/svg"">") (= z "></figcaption>") (= z "strike style=""animation-name:x"" onanimationstart=""alert(1)""></strike>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len y) 93)) (not (= (str.indexof y "drag" 0) 73))))
(assert (or (not (str.suffixof """>" z)) (not (= "<style>@ke<b>ames x{}</style><thead style=""animation-name:x"" onanimationend=""alert(1)""></thead>" (str.replace x "yfr" "<b>")))))
(assert (or (= (str.at z 2) "/") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(0{0,1}[1-9])$|1[0-2]$"))) (not (str.suffixof ">" z))))
(assert (not (= "tt" (str.substr z 12 2))))
(assert (<= (str.len z) 45))
(assert (or (not (str.suffixof "igcaption>" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9,A-Z,a-z,_ \.\-*?\/]+$|[A-Z,a-z][A-Z,a-z, \.'~\-]+$")))))
(assert (or (= (str.indexof z "end=a" 0) 8) (not (str.prefixof "<datalist" x)) (not (= (str.indexof x "ram" 0) 12))))
(assert (not (str.contains x "rt('X")))
(check-sat)
