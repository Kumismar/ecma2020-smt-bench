; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video oncut=""alert(1)"" contenteditable>test</video>") (= x "&#X003c;")))
(assert (or (= z "link>") (= z "rt(1)"" contenteditable>test</noscript>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s-]*$")) (not (= (str.len y) 164)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(#[a-z]+\s*)*#[a-z]+\s*$")))))
(assert (or (not (str.contains z ">")) (str.prefixof "<video" y) (= (str.at x 72) "e")))
(assert (or (not (str.suffixof "script>" y)) (= "nk>" (str.substr z 2 4))))
(assert (or (str.suffixof "st</video>" x) (not (str.prefixof "<vid" y))))
(check-sat)
