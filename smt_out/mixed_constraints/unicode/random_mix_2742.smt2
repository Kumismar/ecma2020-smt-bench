; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside oncut=""alert(1)"" contenteditable>test</aside>") (= x "&lt;BGSOUND SRC=\""javascript&#058;alert('XSS\u{1f4a9}');\""&gt;")))
(assert (or (= z "nkeyup=""alert(1)"" contenteditable>test</details>") (= z "rag me</div><mark ondrop=alert(1) contenteditable>drop here</mark>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace y "on:c" "x") "itixolor ")))
(assert (or (not (= "p here</ma" (str.substr z 53 10))) (not (str.contains y "table")) (not (= (str.at z 21) "t"))))
(assert (or (not (<= (str.len x) 66)) (= "<<b>e oncut=""alert(1)"" contenteditable>test</aside>" (str.replace x "asid" "<b>")) (not (str.suffixof "m>" x))))
(assert (or (str.contains y "tentedita") (not (= ")><" (str.substr y 63 3)))))
(assert (or (not (str.suffixof "est</s>" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{10,11}$"))) (= (str.indexof z "ont" 0) 19)))
(assert (not (str.prefixof "<button" y)))
(assert (not (str.contains x "itable")))
(check-sat)
