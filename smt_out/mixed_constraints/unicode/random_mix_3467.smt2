; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp draggab\u{1f4a9}le=""true"" ondragend=""alert(1)"">test</\u{10348}rp>") (= x "<style>@keyframes x{}</style><area style=""animatio\u{10348}n-name:x"" onanimationend=""alert(1)""></area>")))
(assert (or (= z "ggable=""true"" ondragleave=""alert(1)"">test</head>") (= z "id=x tabindex=1 onfocusin=alert(1)></article>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "(1)><") (not (<= (str.len y) 122)) (= (str.indexof x "/sty" 0) 22)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z_ ]*$"))))
(assert (= (str.at x 37) "t"))
(assert (or (not (str.contains (str.replace y " " "javascript:") "<rpjavascript:dragg")) (str.contains x "le=""anim") (not (= "<style>@keyframes x{}</style><area style=""anim o\u{10348}n-name:x"" onanimationend=""alert(1)""></area>" (str.replace x "ati" " ")))))
(assert (or (not (= "1)" (str.substr x 83 2))) (not (= (str.at x 24) "d"))))
(check-sat)
