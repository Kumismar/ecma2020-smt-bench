; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#34;&#62;<svg><style>{-o-link-source&colon;'<body/onload=confirm(1)>'") (= x "&lt;BODY onload!#$%&amp;()*~+-_.,:;?@[/|\]^`=alert(&quot;XSS&quot;)&gt;") (= x "<applet ondblclick=""alert(1)"">test</applet>")))
(assert (or (= z "=""alert(1)"" contenteditable>test</table>") (= z "(1) contenteditable>drop here</video>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 4) "c") (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._@#$()^{}~-]{8,}"))) (= (str.at x 16) "#")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.{6,}).*")) (not (= "e>dr" (str.substr z 18 4))) (str.contains x "&#62;")))
(assert (or (not (= (str.indexof x "r" 0) 23)) (= (str.at z 23) "a")))
(assert (or (not (str.contains (str.replace y "r" "") "alet(&")) (<= (str.len z) 45)))
(check-sat)
