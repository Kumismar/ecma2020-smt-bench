; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&{document.vulnerable=true;};") (= x "<style>:target {color: red;}</style><s id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></s>")))
(assert (or (= z "st</blockquote>") (= z "contextmenu=""alert(1)"">test</img>") (= z "m>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z-\s]+$"))))
(assert (or (str.suffixof "></s>" x) (str.prefixof "&{document" x)))
(assert (or (str.contains (str.replace y """tran" "javascript:") "le=javascript:sitio") (= "m>" (str.substr z 0 7)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(0[1-9]|1[0-2])\/(0[1-9]|[1-2][0-9]|3[0-1])\/[0-9]{4}$")))))
(assert (or (= (str.at z 3) "t") (= (str.at z 0) "m") (= (str.indexof z "m>" 0) 0)))
(assert (str.suffixof "ue;};" x))
(check-sat)
