; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=http://foo.bar/#x=`y></a><img alt=""`><img src=xx:x onerror=alert(108)></a>"">") (= x "<aside onmousemove=""alert(1)"">test</aside>") (= x "<div draggable=""true"" contenteditable>drag me</div><tfoot ondrop=alert(1) contenteditable>drop here</tfoot>")))
(assert (or (= z ";css';&lt;/STYLE&gt;") (= z "f=""\xE1\xA0\x8Ejavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (str.contains y """>test<"))
(assert (or (not (= (str.indexof x "side" 0) 2)) (= "ipt:al" (str.substr z 33 6)) (str.suffixof "t //|\\" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9\-\(\) ]*)$"))))
(assert (<= (str.len z) 75))
(assert (or (= (str.indexof y "e onm" 0) 5) (= (str.indexof y """fuzz" 0) 92) (str.prefixof ";css';&" z)))
(assert (not (= " h" (str.substr z 87 2))))
(assert (or (= "8)></a>" (str.substr y 75 7)) (str.contains z ";/ST")))
(assert (or (str.prefixof "<aside on" x) (str.contains y "nerror=ale")))
(assert (not (= "<a href=http://foo.bar/#x=`y></a><img alt=""`><img src=xx:alert(1)nerror=alert(108)></a>"">f=""\xE1\xA0\x8Ejavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>" (str.replace y "x o" "alert(1)"))))
(check-sat)
