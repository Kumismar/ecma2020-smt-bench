; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#x03C;") (= x "<font onmousemove=""alert(1)"">test</font>")))
(assert (or (= z "onfocus=alert(1)></b>") (= z "e>test</base>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "move" 0) 13) (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9\-\(\) ]*)$")) (not (= (str.len x) 40))))
(assert (or (not (str.contains y "ert(1)"">te")) (= (str.indexof y ";o" 0) 6) (= (str.at z 10) """")))
(assert (not (str.prefixof "onfocu" z)))
(assert (or (= (str.indexof z "base" 0) 8) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-\u{17e}0-9-:&.'_ ]{2,}$")))))
(check-sat)
