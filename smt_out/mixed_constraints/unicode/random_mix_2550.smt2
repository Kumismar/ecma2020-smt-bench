; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead draggable=""true"" ondragenter=""alert(1)"">test</thead>") (= x "<bgsound draggable=""true"" ondrag=""alert(1)"">test</bgsound>") (= x "<frameset draggable=""true"" ondragend=""alert(1)"">test</frameset>")))
(assert (or (= z "nteditable>test</nextid>") (= z "eforeactivate=alert(1)></textarea>")))
(assert (= y (str.++ x z)))
(assert (= "t" (str.substr y 42 1)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=^.{8,}$)((?=.*\d))((?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$"))) (str.suffixof "nd>" x) (str.suffixof "rea>" y)))
(assert (or (not (= "ad>ef" (str.substr y 56 5))) (not (= (str.at x 3) "s"))))
(assert (or (not (str.prefixof "g><" z)) (not (str.suffixof "ommand>" y)) (not (= "t(1)""" (str.substr y 41 5)))))
(assert (= (str.indexof x "rt" 0) 41))
(assert (not (>= (str.len x) 52)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{7,255}$"))) (not (str.contains y """>tes")) (not (= (str.at x 75) "-"))))
(check-sat)
