; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo draggable=""true"" ondrag=""alert(1)"">test</bdo>") (= x "<header id=x tabindex=1 onactivate=alert(1)></header>") (= x "<sup onkeydown=""alert(1)"" contenteditable>test</sup>")))
(assert (or (= z "li onmousemove=""alert(1)"">test</li>") (= z "<"">/*<sCRipt* */prompt()</script")))
(assert (= y (str.++ x z)))
(assert (not (= "li onmousemove=""al)"">test</li>" (str.replace z "ert(1" ""))))
(assert (not (>= (str.len y) 84)))
(assert (not (= (str.indexof y "up " 0) 2)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9-.]{10,13}$"))) (str.prefixof "<"">/*<" z)))
(assert (or (= "/ d>" (str.replace z "legen" " ")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\-\+]{9,15}$")) (not (str.contains z "t* */prom"))))
(assert (or (not (str.contains x "ge.p")) (not (= (str.indexof z """>/" 0) 1))))
(assert (or (not (= "nmou" (str.substr z 4 4))) (str.contains z "or=r")))
(check-sat)
