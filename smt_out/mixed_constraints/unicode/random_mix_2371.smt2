; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>javascript:alert(1)</script\x0B") (= x "<details draggable=""true"" ondragenter=""alert(1)"">test</details>") (= x "<output oncut=""alert(1)"" contenteditable>test</output>")))
(assert (or (= z "enteditable>test</td>") (= z "nkeydown=""alert(1)"" contenteditable>test</nobr>") (= z "editable>test</keygen>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{3,4}$"))) (str.contains x "=""")))
(assert (or (not (str.prefixof "<details d" x)) (str.contains (str.replace x "1)" "") "t(</s")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[_a-zA-Z0-9-]+(\.[_a-zA-Z0-9-]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*\.(([a-zA-Z]{2,15}))$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{4}-\d{3}?$")))))
(assert (>= (str.len z) 40))
(assert (not (str.suffixof "x0B" x)))
(check-sat)
