; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div>\u{10348}<keygen ondrop=alert(1) conten\u{10348}teditable>drop here</keygen>") (= x "<div draggable=""true"" contenteditable>drag me</div><thead ondragover=alert(1) contenteditable>drop here</thead>") (= x "<i onbeforecut=""alert(1)"" contenteditable>test</i>")))
(assert (or (= z "=alert(1) id=x><\u{1f600}/select><input autofocus>") (= z "1)"" contenteditable>test</style>") (= z "late>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ">" z) (= "=""true" (str.substr y 14 6)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{6,50}$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=[-_a-zA-Z0-9]*?[A-Z])(?=[-_a-zA-Z0-9]*?[a-z])(?=[-_a-zA-Z0-9]*?[0-9])[-_a-zA-Z0-9]{8,16}"))) (not (str.contains x "<i onbefo")) (str.suffixof "u>" y)))
(assert (not (str.suffixof "/i>" x)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*(_|[^\w])).{8,50}$")) (not (= "itable>te" (str.substr x 35 9))) (not (str.contains z "le>test"))))
(assert (or (not (= "e" (str.substr y 107 1))) (= (str.indexof z "e" 0) 3)))
(check-sat)
