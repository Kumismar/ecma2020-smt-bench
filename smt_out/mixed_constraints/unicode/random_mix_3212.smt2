; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script /**/>/**/alert(1)/**/</script /**/") (= x "<com\u{1d400}mand oncopy=""\u{20000}alert(1)"" contenteditable>test</command>") (= x "<summary onbeforecut=""alert(1)"" contenteditable>test</summary>")))
(assert (or (= z "er\u{1f4a9}t(1)></em>") (= z "mouseup=""alert(1)"">test</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 35) (str.prefixof "<script /" y)))
(assert (or (not (= (str.indexof y "e" 0) 21)) (>= (str.len z) 28) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]+@(?!cancaonova.pt)[A-Za-z0-9.-]+\.[A-Za-z]{2,4}$")))))
(assert (not (str.prefixof "&#X" y)))
(assert (or (= (str.at z 18) ">") (= (str.indexof y "ipt" 0) 58)))
(assert (= (str.indexof y "</s" 0) 29))
(check-sat)
