; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><ol ondrop=alert(1) contenteditable>drop here</ol>") (= x "<frameset draggable=""true"" ondragend=""alert(1)"">test</frameset>") (= x "<caption onbeforecut=""alert(1)"" contenteditable>test</caption>")))
(assert (or (= z """alert(1)"">test</strong>") (= z "l(javascript:document.vulnerable=true;);"">")))
(assert (= y (str.++ x z)))
(assert (>= (str.len x) 92))
(assert (or (= "<frameset alert(1)able=""true"" ondragend=""alert(1)"">test</frameset>" (str.replace x "dragg" "alert(1)")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]+$|^[0-9]+$")))))
(assert (or (not (str.suffixof ">" z)) (not (= "<frajavascript: draggable=""true"" ondragend=""alert(1)"">test</frameset>""alert(1)"">test</strong>" (str.replace y "meset" "javascript:")))))
(assert (or (not (str.suffixof "/tbody>" z)) (str.suffixof "trong>" z) (not (= (str.indexof z "(jav" 0) 1))))
(assert (or (not (= (str.at y 32) "t")) (= (str.len x) 62)))
(assert (or (str.contains y "0000") (not (<= (str.len x) 66))))
(check-sat)
