; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onpagehide body onpagehide=""javascript:javascript:alert(1)""></body onpagehide>") (= x "<svg><noembed onload=alert(1)></noembed>")))
(assert (or (= z "#0000060") (= z "/wbr>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "rip"))
(assert (or (not (str.prefixof "<bo" y)) (str.suffixof "</noembed>" x) (str.prefixof "#00000" z)))
(assert (or (not (= (str.at x 62) "1")) (= (str.indexof z "00" 0) 1) (not (= (str.len y) 45))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?![ .]+$)[a-zA-Z .]*$"))) (= (str.indexof y "be" 0) 10)))
(assert (str.contains x "vg><noembe"))
(assert (or (not (str.prefixof "<svg><" y)) (<= (str.len x) 91)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z0-9]+\.?-?[a-z0-9]+@[a-z0-9]+-?[a-z0-9]+\.[a-z]{2,4}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{7}$"))))
(check-sat)
