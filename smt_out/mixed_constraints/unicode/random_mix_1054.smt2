; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onmouseout=""alert(1)"">test</rtc>") (= x "<mark id=x tabindex=1 onbeforedeactivate=alert(1)></mark><input autofocus>")))
(assert (or (= z "id=x style=""transition:color 1s"" ontransitionend=alert(1)></abbr>") (= z "get {color: red;}</style><fieldset id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></fieldset>")))
(assert (= y (str.++ x z)))
(assert (= "1)></fi" (str.substr y 131 7)))
(assert (or (= "tyle=""tran" (str.substr y 78 10)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\-\.\(\)\s]+$")) (not (str.suffixof "utofocus>" x))))
(assert (or (not (= "<rtc onmouseout=""alert(1)"">test</rtc>get {color: red;}</style><f<b>eldset id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></fieldset>" (str.replace y "i" "<b>"))) (not (str.contains (str.replace y "ark i" """") "m""d=x t"))))
(assert (or (not (= (str.indexof z "edi" 0) 17)) (not (= (str.at x 30) "t"))))
(assert (or (= (str.at x 2) "a") (not (str.suffixof "abbr>" z)) (not (= "iti" (str.substr z 17 3)))))
(assert (or (not (= (str.indexof y "le>" 0) 59)) (not (= (str.len y) 145)) (>= (str.len x) 70)))
(check-sat)
