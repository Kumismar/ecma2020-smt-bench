; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<// style=x:expre\u{1f600}ssion\28javascript:alert(1)\29>") (= x "<html onmouseout=""alert(1)"">test</html>")))
(assert (or (= z ">test</code>") (= z "wbr id=x tabindex=1 onbeforeactivate=alert(1)></wbr>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 24) "1"))
(assert (or (not (str.prefixof "<// styl" y)) (str.suffixof "</SCRIPT>" z) (str.suffixof "rame>" z)))
(assert (or (not (= "onbef" (str.substr z 20 5))) (not (= "re\u{1f600}s" (str.substr x 15 4))) (str.contains (str.replace y "=""tra" """") "e""nsi")))
(assert (or (not (= (str.indexof z "e" 0) 15)) (not (str.contains z "x tabin"))))
(assert (or (not (str.contains y "<x%")) (not (str.suffixof "29>" x))))
(assert (= "ontente" (str.substr x 31 7)))
(assert (not (str.contains x "eout=""ale")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f} ]+"))) (not (= "<html onmouseout=""alert(x>test</html>>test</code>" (str.replace y "1)""" "x")))))
(check-sat)
