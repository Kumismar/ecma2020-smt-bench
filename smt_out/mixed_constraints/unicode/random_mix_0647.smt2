; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>BODY{-moz-binding:url(""http://www.securitycompass.com/xssmoz.xml#xss"")}</style>") (= x "<nextid onmouseup=""alert(1)"">t\u{1d400}est</nextid\u{1d400}>") (= x "<meter onmousedown=""alert(1)"">test</meter>")))
(assert (or (= z "t</a>") (= z "ite>") (= z "ouseover=""\u{1f600}alert(1)"">test</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "/200" 0) 29)) (str.contains (str.replace y "t" " ") "e er")))
(assert (or (not (= (str.len z) 31)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]+$|^[0-9]+$")))))
(assert (or (str.contains y "xss") (str.contains y "mouse") (not (= (str.len z) 51))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-z0-9_\.+-]+)@([\da-z\.-]+)\.([a-z\.]{2,6})$"))) (str.contains (str.replace x "<" "x") "xsty")))
(assert (or (= (str.indexof x "ous" 0) 11) (not (str.prefixof "<nextid" x)) (str.contains z "nteditable")))
(assert (or (not (= "eover=""\u{1f600}alert(1)"">test</dfn>" (str.replace z "ous" ""))) (not (= (str.len y) 46))))
(check-sat)
