; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><template style=""animation-name:x"" onanimationstart=""alert(1)""></template>") (= x "<hr onblur=alert(1) tabindex=1 id=x></hr><input autofocus>")))
(assert (or (= z "nd onkeypress=""alert(1)"" contenteditable>test</legend>") (= z "est</ol>") (= z "est</audio>")))
(assert (= y (str.++ x z)))
(assert (or (= "udio>" (str.substr z 6 9)) (not (str.suffixof ">" z)) (str.contains y "nstart=")))
(assert (or (not (= (str.at z 0) "e")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]{1,64}@[a-zA-Z0-9-]{1,64}[\.][a-zA-z]{2,}[\.]{0,1}[a-zA-z]{0,}$")))))
(assert (or (= (str.at y 15) "t") (not (= (str.indexof x "onbl" 0) 4))))
(assert (or (str.prefixof "<img src=""" y) (not (str.prefixof "<st" y))))
(check-sat)
