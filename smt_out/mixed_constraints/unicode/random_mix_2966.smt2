; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var onkeydown=""alert(1)"" contenteditable>test</var>") (= x "<multicol onblur=alert(1) tabindex=1 id=x></multicol><input autofocus>")))
(assert (or (= z "svg>") (= z "e=true;"">") (= z "enteditable>test</style>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len z) 17)) (= (str.len z) 24)))
(assert (str.contains (str.replace z "svg>" " ") " "))
(assert (or (not (= (str.indexof z "e=tru" 0) 0)) (str.contains z "lement>")))
(assert (or (= "ditabl" (str.substr z 4 6)) (str.in_re x ((_ re.from_regex ecma2020 u) "[0]*(?=[1-9])(1?[0-9]{0,2})|([1-9][0-9])|[1-9]")) (not (str.contains (str.replace y ")"" co" "<b>") "rt(1<b>nte"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?\d{9,20}"))) (not (<= (str.len x) 113)) (not (= (str.indexof z "edi" 0) 3))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{4}/\d{1,2}/\d{1,2}$"))))
(check-sat)
