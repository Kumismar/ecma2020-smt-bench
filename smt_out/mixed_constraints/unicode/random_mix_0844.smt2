; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dir draggable=""true"" ondragleave=""alert(1)"">test</dir>") (= x "<shadow id=x \u{1f600}tabindex=1 onbeforeactivate=alert(1)></shado\u{20000}w>") (= x "<style>@keyframes x{}</style><rp style=""animation-name:x"" onanimationend=""alert(1)""></rp>")))
(assert (or (= z ">test</multicol>") (= z "gure onpaste=""alert(1)"" contenteditable>test</figure>") (= z "t {color:red;}</style><element id=x style=""transition:color 1s"" ontransitionend=alert(1)></element>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "ement>" y) (not (str.prefixof "t {" z))))
(assert (<= (str.len x) 71))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{5}(?:[-\s]\d{4})?$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9a-zA-Z-\u{c1}\u{c0}\u{c2}\u{c4}\u{c9}\u{c8}\u{ca}\u{cb}\u{cd}\u{cc}\u{ce}\u{cf}\u{d3}\u{d2}\u{d4}\u{d6}\u{da}\u{d9}\u{db}\u{dc}\u{e1}\u{e0}\u{e2}\u{e4}\u{e9}\u{e8}\u{ea}\u{eb}\u{ed}\u{ec}\u{ee}\u{ef}\u{f3}\u{f2}\u{f4}\u{f6}\u{fa}\u{f9}\u{fb}\u{fc}\u{c7}'\u{e7},.\u{20ac}\u{a3}$_ \.]{2,100}$"))) (not (= (str.len z) 17))))
(assert (or (not (= "<style>@keyframes x{}</style><rp style=""an<b>on-name:x"" onanimationend=""alert(1)""></rp>" (str.replace x "imati" "<b>"))) (= "<<b>l onpaste=""alert(1)"" contenteditable>test</dl>" (str.replace x "d" "<b>")) (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[A-Za-z])(?=.*\d).{8,}$"))))
(assert (or (not (= (str.len x) 62)) (not (= """ cont" (str.substr z 22 6))) (not (= "<style>@keyframes x{}</style><rp style=""animation-name:x"" onanimationend="" (1)""></rp>" (str.replace x "alert" " ")))))
(assert (not (= "alert(" (str.substr y 42 6))))
(assert (str.contains x "n-na"))
(check-sat)
