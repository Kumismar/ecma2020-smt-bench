; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet onError applet onError=""javascript:javascript:alert(1)""></applet onError>") (= x "<sub onkeyup=""alert(1)"" contenteditable>test</sub>")))
(assert (or (= z "ript%3ealert('XSS')%3c/script%3e") (= z "</video>") (= z "e draggable=""true"" ondragenter=""alert(1)"">test</cite>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "ub>" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "((0[1-9]|5[0-2])|[1-4][0-9])[0-9]{3}"))) (not (= (str.at x 73) "o"))))
(assert (str.contains z "3e"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-z\u{c0}-\u{ff}-.]*$"))) (not (= "nui" (str.substr x 37 3))) (= (str.indexof z "rue"" " 0) 14)))
(assert (or (not (= (str.at y 18) "e")) (str.prefixof "<sub onke" x)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z ]+$"))) (not (str.suffixof " onError>" x))))
(check-sat)
