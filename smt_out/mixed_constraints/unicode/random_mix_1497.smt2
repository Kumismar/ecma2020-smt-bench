; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tr onmouseenter=""alert(1)"">test</tr>") (= x "<pre onmousedown=""alert(1)"">test</pre>") (= x "<code onmousedown=""alert(1)"">test</code>")))
(assert (or (= z "vulnerable=true;"">") (= z "ut=""alert(1)"" contenteditable>test</blockquote>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "useent" (str.substr x 8 6))) (str.contains z "ofra") (str.in_re z ((_ re.from_regex ecma2020 u) "^(\+\d{2})?([\- ]?\d+)+$"))))
(assert (or (>= (str.len y) 78) (not (str.suffixof "le=true;"">" y)) (not (= (str.indexof z "1" 0) 10))))
(assert (or (= (str.len x) 40) (not (str.contains y "<tr onmo")) (not (str.suffixof ">" x))))
(assert (or (str.prefixof "<cod" y) (not (str.suffixof "uote>" y))))
(assert (= " " (str.substr x 4 1)))
(check-sat)
