; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object onmouseover=""alert(1)"">test</object>") (= x "<del id=x tabindex=1 ondeacti\u{20000}vate=alert(1)></del><input id=y autofocus>") (= x "<script/src=""data&colon;text%2Fj\u{5c}u0061v\u{5c}u0061script,\u{5c}u0061lert('\u{5c}u0061')""></script a=\u{5c}u0061 & /=%2F")))
(assert (or (= z ">test</style>") (= z "le>test</noembed>") (= z "rt(1)"">test</param>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len x) 78))
(assert (or (= (str.indexof z ">tes" 0) 2) (= "d=y " (str.substr y 58 4)) (>= (str.len y) 51)))
(assert (not (= (str.indexof z "s" 0) 3)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(https:\/\/)?[a-zA-Z0-9-]*.myshopify.com\/?$"))) (not (str.contains y "/style>")) (= "link>" (str.substr z 4 6))))
(assert (or (str.suffixof "us>" x) (str.prefixof "<tt onmo" x)))
(assert (or (not (= "e>" (str.substr z 11 9))) (not (>= (str.len z) 13))))
(assert (str.contains (str.replace y "dex" "<b>") "n<b>="))
(check-sat)
