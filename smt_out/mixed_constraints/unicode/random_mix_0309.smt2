; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg%0Aonload=%09((pro\u{5c}u006dpt))()//") (= x "<link oncontextmenu=""alert(1)"">test</link>") (= x "<DIV STYLE=""width:expression(javascript:alert(1));"">")))
(assert (or (= z "t(1)//"">") (= z "test</track>") (= z " id=x tabindex=1 onbeforeactivate=alert(1)></map>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3})$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z]{3,10}$"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9A-Za-z]{6,20}")) (= (str.at z 2) "1")))
(assert (or (= "track" (str.substr y 42 5)) (= "<svg%0Aonload=%09((x\u{5c}u006dpt))()//" (str.replace x "pro" "x")) (not (str.contains y "ad=%09((p"))))
(assert (str.suffixof "(1)></map>" z))
(check-sat)
