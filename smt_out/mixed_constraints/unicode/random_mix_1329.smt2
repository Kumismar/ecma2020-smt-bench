; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select onfocusout=alert(1) id=x><\u{1f600}/select><input autofocus>") (= x "<track onclick=""alert(1)"">test</track>") (= x "<style>@keyframes x{}</style><figcaption style=""animation-name:x"" onanimationstart=""alert(1)""></figcaption>")))
(assert (or (= z ")></area>") (= z "cript>") (= z "&gt;")))
(assert (= y (str.++ x z)))
(assert (str.prefixof ")></a" z))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{5}(?:[-\s]\d{4})?"))))
(assert (not (>= (str.len x) 58)))
(assert (or (not (str.prefixof "<a href=""j" y)) (not (= (str.indexof x "selec" 0) 1))))
(assert (or (not (= (str.at x 20) "t")) (not (= (str.indexof z "gt" 0) 1)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[+]*[0-9-]*$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "1[3|5|8|7|9][0-9]{9}"))))
(assert (or (= (str.indexof z "ipt" 0) 2) (not (= (str.at x 30) "t")) (= (str.at y 67) "a")))
(assert (or (str.prefixof "<s" x) (not (>= (str.len x) 100))))
(check-sat)
