; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div onmouseout=""alert(1)"">test</div>") (= x "<marquee id=x tabindex=1 onbeforeactivate=alert(1)></marquee>") (= x "<canvas onfocusout=alert(1) tabindex=1 id=x></canvas><input autofocus>")))
(assert (or (= z "cript:alert(1)</script>") (= z "animation-name:x"" onanimationend=""alert(1)""></textarea>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^seize$"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!.+@(gmail|google|yahoo|outlook|hotmail|msn)\..+).+@.+\..+$")) (not (str.prefixof "<d" y)) (not (str.contains z "></text"))))
(assert (or (not (str.prefixof "<" y)) (str.in_re z ((_ re.from_regex ecma2020 u) "^(\+?[\d -]{8,15}[,]{0,1})*$"))))
(assert (not (str.contains z "me:x"" ona")))
(assert (= "del id=x tabindex=1 ondeacti\u{20000}vate=alert(1)javascript:l><input id=y autofocus>" (str.replace z "></de" "javascript:")))
(check-sat)
