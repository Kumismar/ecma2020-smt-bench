; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><object id=x style=""transition:color 1s"" ontransitionend=alert(1)></object>") (= x "</form>") (= x "<html onmouseleave=""alert(1)"">test</html>")))
(assert (or (= z "ert(&quot;XSS&quot;)>") (= z "=""alert(1)"">test</param>") (= z "ame:x"" onanimationend=""alert(1)""></tr>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "io") (not (str.suffixof "/tfoot>" z)) (not (str.prefixof "</form>=""a" y))))
(assert (or (= (str.indexof y "tion" 0) 21) (not (str.prefixof "<html on" y))))
(assert (or (str.suffixof ">" x) (not (= (str.len y) 65))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{4}$")) (str.prefixof "ame:x""" z)))
(assert (not (= "fo" (str.substr y 2 2))))
(assert (not (= (str.indexof z "onani" 0) 7)))
(check-sat)
