; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<progress id=x tabindex=1 ondeactivate=alert(1)></progress><input id=y autofocus>") (= x "<tfoot id=x tabindex=1 onfocus=alert(1)></tfoot>") (= x "<marquee onclick=""alert(1)"">test</marquee>")))
(assert (or (= z "oad=prompt&lpar;1&rpar;&gt;'>") (= z "drag=""alert(1)"">test</data>") (= z "nput autofocus>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 65) " "))
(assert (or (str.prefixof "nput" z) (not (<= (str.len z) 25))))
(assert (or (not (= (str.indexof x "tf" 0) 1)) (not (>= (str.len z) 21)) (not (= (str.at x 40) "e"))))
(assert (or (= "<tfoot id=x tabindex=1 onfocus=javascript:(1)></tfoot>drag=""alert(1)"">test</data>" (str.replace y "alert" "javascript:")) (= (str.indexof z "foc" 0) 9)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^@]+@[^\.]+\..{2,}$"))))
(assert (or (not (= (str.at y 47) ">")) (not (= (str.indexof x " " 0) 7))))
(check-sat)
