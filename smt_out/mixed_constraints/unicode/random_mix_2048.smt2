; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\"";;alert(';XSS';);//") (= x "<style>:target {color:red;}</style><s id=x style=""transition:color 1s"" ontransitionend=alert(1)></s>")))
(assert (or (= z ")></kbd><input id=y autofocus>") (= z "onbeforeactivate=alert(1)></content>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "nted" (str.substr z 23 4))) (not (str.contains z "alert("))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.+@(?:(?!(g|hot|y|google|hush|fast|at|short|at|proton)?mail)(?!live)(?!gmx)(?!yahoo)(?!hotmail)(?!gmail)(?!outlook)(?!msn)(?!icloud)(?!facebook)(?!aol)(?!zoho)(?!yandex)(?!lycox)(?!inbox)(?!myway)(?!aim)(?!goowy)(?!juno).)+\..+$"))))
(assert (or (str.suffixof "focus>" z) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 './,]+$")))))
(assert (or (not (str.suffixof "enu>" x)) (<= (str.len x) 49) (str.prefixof "<styl" y)))
(assert (str.contains z "=y auto"))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{4}\s\d{4}\s\d{4}$"))))
(assert (or (not (= (str.len y) 136)) (not (= (str.indexof y "te=a" 0) 35)) (not (str.contains y "t id=y au"))))
(check-sat)
