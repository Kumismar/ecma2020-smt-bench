; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""89""><svg xmlns=""http://www\u{10348}.w3.org/2000/svg"">") (= x "<style>:target {color:red;}</style><head id=x style=""transition:color 1s"" ontransitionend=alert(1)></head>") (= x "<svg onbeforecut=""alert(1)"" contenteditable>test</svg>")))
(assert (or (= z "(1)"">test</br>\u{20000}") (= z "useover=""alert(1)"">test</font>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "seov" 0) 1)))
(assert (or (not (str.prefixof "<div id" x)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\-\.\(\)\s]+$")))))
(assert (or (= (str.indexof x "efo" 0) 8) (not (= (str.indexof z ")"">t" 0) 2)) (str.suffixof "t</br>\u{20000}" z)))
(assert (or (not (str.contains x "</styl")) (not (str.suffixof "test</svg>" x))))
(check-sat)
