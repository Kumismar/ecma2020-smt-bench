; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;INPUT TYPE="";IMAGE""; SRC="";javascript:alert(';XSS';);"";>;") (= x "<OBJECT classid=clsid:ae24fdae-03c6-11d1-8b76-0080c744f389><param name=url value=javascript:javascript:alert(1)></OBJECT>") (= x "<\u{1f4a9}ul id=x tabindex=1 onfocus\u{1d400}in=alert(1)></ul>")))
(assert (or (= z "k=""alert(1)"">test</noframes>") (= z "uote>") (= z "ta\u{20000}ble>test</keygen>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\u{5c}u0026\u{5c}u003C\u{b1}!@\u{a3}$%^*_+\u{a7}\u{a1}\u{20ac}#\u{a2}\u{a7}\u{b6}\u{2022}\u{aa}\u{ba}\u{ab}\\/>?:;|=,\d]+$"))))
(assert (not (= (str.indexof z "te>" 0) 2)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]{2,}\.[a-zA-Z]{2,}$"))))
(assert (or (= "a\u{20000}" (str.substr z 1 2)) (= (str.at y 7) " ")))
(assert (or (not (= (str.len z) 28)) (not (str.contains y "89><par"))))
(assert (or (= (str.len z) 8) (not (str.suffixof ">uote>" y))))
(assert (or (str.contains (str.replace z "/no" "") "test<f") (= (str.len y) 79)))
(check-sat)
