; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside onmouseover=""alert(1)"">test</aside>") (= x "<style>:target {color: red;}</style><legend id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></legend>")))
(assert (or (= z "id=""fuzzelement1"">test</a>") (= z "e=alert(1)></caption>") (= z "rt(1)"">test</em>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len z) 13)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-z][A-z \-]+$"))) (= (str.at z 9) ")")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^[a-zA-Z\d]{3}$)|(^\d{5}$)|(^[a-zA-Z\d]{6}$)"))) (str.prefixof "n drag" z)))
(assert (or (str.suffixof ">" y) (str.contains y "lor ")))
(assert (str.contains x ")"">test</a"))
(assert (or (not (str.suffixof "ption>" y)) (not (= (str.indexof z """>tes" 0) 16))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "Il a rendu visite \u{e0} Marie.")) (str.contains x "8/js.j") (str.contains (str.replace y "r" "") ">:taget ")))
(assert (or (= (str.indexof x ")"">t" 0) 27) (not (= (str.at y 43) "d"))))
(check-sat)
