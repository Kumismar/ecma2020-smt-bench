; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<command onkeyup=""alert(1)"" contenteditable>test</command>") (= x "<svg><div onload=alert(1)></div>") (= x "'"">><script>ale\u{1f4a9}rt('XSS')</script>")))
(assert (or (= z "ouseup=""alert(1)"">test</listing>") (= z "alert(1)"">test</wbr>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "e=""ale")) (= (str.indexof y "p=""a" 0) 15) (= (str.len z) 47)))
(assert (or (not (= "br>" (str.substr z 17 8))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]+[a-zA-Z -]*")))))
(assert (str.prefixof "alert(" z))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9 _]+$"))) (str.suffixof "p>" x)))
(assert (or (not (= "'""cript>ale\u{1f4a9}rt('XSS')</script>" (str.replace x ">><s" ""))) (not (= (str.at y 39) "a"))))
(check-sat)
