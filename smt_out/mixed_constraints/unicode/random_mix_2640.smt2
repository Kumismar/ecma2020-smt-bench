; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script\x2F>javascript:alert(1)</script>") (= x "http://www.<script>\u{1f600}alert(1)</script .\u{10348}com")))
(assert (or (= z "load=alert(1)></footer>") (= z "ofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 3) "r") (not (str.contains z "=alert(1)"))))
(assert (or (>= (str.len z) 1) (not (str.suffixof "</p>" x))))
(assert (not (str.suffixof "></footer>" y)))
(assert (or (str.contains z "focu") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?:(?:31(\/|-|\.)(?:0?[13578]|1[02]))\1|(?:(?:29|30)(\/|-|\.)(?:0?[1,3-9]|1[0-2])\2))(?:(?:1[6-9]|[2-9]\d)?\d{2})$|^(?:29(\/|-|\.)0?2\3(?:(?:(?:1[6-9]|[2-9]\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))$|^(?:0?[1-9]|1\d|2[0-8])(\/|-|\.)(?:(?:0?[1-9])|(?:1[0-2]))\4(?:(?:1[6-9]|[2-9]\d)?\d{2})$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[^a-zA-Z]{5,}$")))))
(assert (str.contains (str.replace y " .\u{10348}co" "alert(1)") "riptalert(1)mo"))
(assert (not (str.suffixof "footer>" y)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\+]?[0-9]{1,3}[\s]?[\(]?[0-9]{0,2}[\)]?[\s]?[0-9\s]{10,14}"))))
(check-sat)
