; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main ondblclick=""alert(1)"">test</main>") (= x "<a href=""\x11javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "t>alert('XSS');</script>") (= z "/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg=="">")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9\s-]{5,46}"))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}0-9](?:[a-z\u{430}-\u{44f}\u{410}-\u{42f}A-Z0-9-]{0,61}[a-z\u{430}-\u{44f}\u{410}-\u{42f}A-Z0-9])?\.(?:ru|com|org|info|net|\u{440}\u{444})$")))
(assert (str.contains x "</m"))
(assert (str.suffixof ">" y))
(assert (not (= (str.len y) 63)))
(assert (= (str.at x 24) "1"))
(assert (or (not (str.suffixof """>test</a>" x)) (str.prefixof "<a href" y)))
(assert (or (not (= (str.indexof y "test" 0) 28)) (str.prefixof "<main " x) (not (= (str.len x) 39))))
(assert (not (str.suffixof ">" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(5)$"))) (not (= (str.at z 11) "4"))))
(assert (= "ma" (str.substr x 34 2)))
(check-sat)
