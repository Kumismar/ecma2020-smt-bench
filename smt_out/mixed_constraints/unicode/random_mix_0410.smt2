; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link href=validstyles.css rel=stylesheet onload=alert(1)>") (= x "<select onmouseup=""alert(1)"">test</select>")))
(assert (or (= z """ contenteditable>test</strike>") (= z "onbeforeactivate=alert(1)></output>") (= z "td>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "n" 0) 3)))
(assert (or (not (= ">" (str.substr x 41 10))) (= (str.at z 5) "t")))
(assert (or (str.contains y "tedi") (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]{2,6})+$")) (= "1)"">t" (str.substr y 25 5))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?!.*(^\u{30c6}\u{30b9}\u{30c8}\u{682a}\u{5f0f}\u{4f1a}\u{793e}$|^\u{30c6}\u{30b9}\u{30c8}$|^\u{5408}\u{540c}\u{4f1a}\u{793e}$|^\u{6709}\u{9650}\u{4f1a}\u{793e}$|^\u{4f1a}\u{793e}$|^\u{682a}\u{5f0f}\u{4f1a}\u{793e}$|^-$|^\u{30e9}\u{30f3}\u{30b5}\u{30fc}\u{30ba}\u{682a}\u{5f0f}\u{4f1a}\u{793e}$|^\u{25cb}\u{25cb}\u{682a}\u{5f0f}\u{4f1a}\u{793e}$|^\u{25cb}$|^\u{25cb}\u{25cb}$|^d$|^dd$|^\u{3042}\u{3044}\u{3046}\u{3048}\u{304a}$|^\u{3042}\u{3044}\u{3046}$|^z$|^zz$|^s$|^ss$|^q$|^qq$|^k$|^kk$|^a$|^aa$|^\u{3042}$|^\u{3042}\u{3042}$|^\u{3042}\u{3042}\u{3042}$|^\u{3042}\u{3042}\u{3042}$|^\u{3042}\u{3042}\u{3042}\u{3042}$)).+$"))))
(assert (or (not (= "<select onmouseup=""alert(1)"">st</select>"" contenteditable>test</strike>" (str.replace y "te" ""))) (<= (str.len y) 90) (str.prefixof "<select" y)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^((0?[1-9])|([1-2][0-9])|(3[0-1]))$")) (not (= "<fieldset oncut=""alert(1)"" contenteditable>t</fieldset>" (str.replace x "est" ""))) (not (= ")></html>" (str.substr z 16 9)))))
(assert (or (str.contains x "ect onmou") (not (str.suffixof "d>" z))))
(check-sat)
