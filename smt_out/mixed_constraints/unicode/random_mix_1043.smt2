; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area ondblclick=""alert(1)"">test</area>") (= x "<div draggable=""true"" contenteditable>drag me</div><header ondragover=alert(1) contenteditable>drop here</header>") (= x "<button draggable=""true"" ondragend=""alert(1)"">test</button>")))
(assert (or (= z "d=x tabindex=1 onfocus=alert(1)></noframes>") (= z " ondeactivate=alert(1)></link><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<STYLE" y) (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9a-zA-Z]([-.\w]*[0-9a-zA-Z_+])*@([0-9a-zA-Z][-\w]*[0-9a-zA-Z]\.)+[a-zA-Z]{2,9}"))))
(assert (= (str.indexof z "/lin" 0) 24))
(assert (or (>= (str.len z) 51) (str.prefixof "<button " y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{c0}-\u{fa}\s]{2,50}$")))))
(assert (or (str.contains (str.replace y "dblcl" "x") "ea onxick") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((0?[13578]|10|12)(-|\/)(([1-9])|(0[1-9])|([12])([0-9]?)|(3[01]?))(-|\/)((19|20)([2-9])(\d{1})|(20)([01])(\d{1})|([8901])(\d{1}))|(0?[2469]|11)(-|\/)(([1-9])|(0[1-9])|([12])([0-9]?)|(3[0]?))(-|\/)((19|20)([2-9])(\d{1})|(20)([01])(\d{1})|([8901])(\d{1})))$")))))
(check-sat)
