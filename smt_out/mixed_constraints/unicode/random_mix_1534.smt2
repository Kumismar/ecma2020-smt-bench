; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen draggable=""true"" ondragenter=""alert(1)"">test</keygen>") (= x "<progress onmousemove=""alert(1)"">test</progress>") (= x "<dir id=x tabindex=1 onfocus=alert(1)></dir>")))
(assert (or (= z "ous\u{1f600}eover=""alert(1)"">test</command>") (= z "script>") (= z "ut id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "gen>" x)))
(assert (or (not (str.contains x "aler")) (>= (str.len y) 94) (str.contains y "tabi")))
(assert (or (not (<= (str.len y) 84)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9_!#$%&'\x22*+/=?`{|}~^.-]+@[A-Za-z0-9[\]:.-]+\.[A-Za-z0-9[\]:-]{2,}$"))) (= (str.at x 15) """")))
(assert (not (str.suffixof "ript>" z)))
(check-sat)
