; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><dir style=""animation-name:x"" onanimationend=""alert(1)""></dir>") (= x "<body/onload=&lt;!--&gt;&#10alert(1)>")))
(assert (or (= z "says, ';XSS';"";)`>;") (= z "=""alert(1)"">test</ins>") (= z "oncut=""alert(1)"" contenteditable>test</cite>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "BLUE"))) (not (>= (str.len z) 18))))
(assert (or (str.suffixof "dir>" x) (not (str.suffixof "pt U+" y)) (= "&#10alert" (str.substr x 24 9))))
(assert (or (not (str.prefixof "=""alert(1)" z)) (= "lert" (str.substr y 29 4))))
(assert (or (not (<= (str.len z) 26)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([A-Z0-9]{5}-){6}[A-Z0-9]{5}$")))))
(check-sat)
