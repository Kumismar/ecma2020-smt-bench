; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><div style=""animation-name:x"" onanimationend=""alert(1)""></div>") (= x "<caption onbeforecut=""alert(1)"" contenteditable>test</caption>") (= x "<q onkeydown=""alert(1)"" contenteditable>test</q>")))
(assert (or (= z "e=""alert(1)"">test</content>") (= z "=%(scriptlet)s></embed>") (= z "aside>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x """aler" "x") "ove=xt") (str.prefixof "e=" z) (str.suffixof ">" x)))
(assert (or (str.prefixof "<caption " x) (str.prefixof "<" x)))
(assert (or (str.contains z "let)s") (not (= "<\u{1f4a9}ul id=x tabindex<b>nfocus\u{1d400}in=alert(1)></ul>" (str.replace x "=1 o" "<b>")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z\u{e4}\u{f6}\u{e6}\u{f8}\u{e5}0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"))))
(check-sat)
