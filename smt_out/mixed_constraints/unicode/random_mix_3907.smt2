; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menu onblur=alert(1) tabindex=1 id=x></menu><input autofocus>") (= x "<body id=x tabindex=1 onbeforedeactivate=alert(1)></body><input autofocus>") (= x "<style>:target {color:red;}</style><slot id=x style=""transition:color 1s"" ontransitionend=alert(1)></slot>")))
(assert (or (= z "t=""alert(1)"">test</ins>") (= z "st</th>") (= z "lert(1)"">test</thead>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 119) "t"))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^(12)$")) (not (= (str.at y 77) "a")) (str.prefixof "l" z)))
(assert (or (= "le (1)"">test</thead>" (str.replace z "rt" " ")) (= ">te" (str.substr z 8 3))))
(assert (or (not (str.suffixof "est</ins>" y)) (str.suffixof "t</th>" y)))
(assert (or (not (<= (str.len y) 97)) (str.contains (str.replace z "(1)" "") "lert"">tes") (str.suffixof "utofocus>" x)))
(assert (or (= (str.at z 18) "e") (not (str.prefixof "<" x)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\+]+$")))))
(check-sat)
