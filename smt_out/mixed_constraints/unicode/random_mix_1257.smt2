; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dl dr\u{20000}aggable=""true"" ondrag=""alert(1)"">tes\u{20000}t</dl>") (= x "<style>@keyframes x{}</style><dialog style=""animation-name:x"" onanimationend=""alert(1)""></dialog>")))
(assert (or (= z "aggable=""true"" ondragend=""alert(1)"">test</br>") (= z "t id=y autofocus>") (= z " ondragend=""alert(1)"">test</legend>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "=y autof") (not (= (str.indexof y "CharC" 0) 46)) (= "tes\u{20000}t</dl>" (str.substr x 40 10))))
(assert (or (not (= (str.at y 11) "b")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]*[KMGT]?$"))) (not (= "<dl dr\u{20000}aggable=""true"" ondrag=""alert(1""s\u{20000}t</dl> ondragend=""alert(1)"">test</legend>" (str.replace y ")"">te" """")))))
(assert (or (not (= "nd=""alert(" (str.substr y 105 10))) (not (str.prefixof "<st" x)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{1,3}"))))
(assert (or (str.suffixof "us!" z) (not (str.contains (str.replace z "au" "javascript:") " javascript:to")) (not (str.contains x "t</dl"))))
(assert (not (<= (str.len x) 50)))
(assert (not (str.contains z "ggable=""tr")))
(assert (= (str.at y 51) "o"))
(check-sat)
