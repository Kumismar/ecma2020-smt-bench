; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><param style=""animation-name:x"" onanimationend=""alert(1)""></param>") (= x "<style onmousemove=""alert(1)"">test</style>")))
(assert (or (= z "uote draggable=""true"" ondragstart=""alert(1)"">test</blockquote>") (= z "keyup=""alert(1)"" contentedita\u{1f600}ble>test</ou\u{1f4a9}tput>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 40) (not (= "c" (str.substr z 54 1)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([\w!#$%&'*+\-\/=?\^`{|}~]+\.)*[\w!#$%&'*+\-\/=?\^`{|}~]+@((((([a-zA-Z0-9]{1}[a-zA-Z0-9\-]{0,62}[a-zA-Z0-9]{1})|[a-zA-Z])\.)+[a-zA-Z]{2,62})|(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?)$"))) (not (= (str.at y 72) "b"))))
(assert (or (str.contains x "t(1)") (= "ert(1)"">" (str.substr x 22 8)) (not (= "uote dragga<b>""true"" ondragstart=""alert(1)"">test</blockquote>" (str.replace z "ble=" "<b>")))))
(assert (not (= "e=""a" (str.substr x 40 4))))
(assert (not (= (str.len z) 3)))
(assert (str.prefixof "<s" x))
(check-sat)
