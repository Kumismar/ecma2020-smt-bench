; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend onmouseover=""alert(1)"">test</legend>") (= x "<noscript onbeforepaste=""alert(1)"" contenteditable>test</noscript>") (= x "<area draggable=""true"" ondrag=""al\u{1f4a9}ert(1)"">test</area>")))
(assert (or (= z "st</aside>") (= z "www.w3.org/2000/svg"">") (= z "ipt>alert(""XSS by \nxss"")</script><marquee><h1>XSS by xss</h1></marquee>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<area dr" x) (not (str.prefixof "<noscript " x))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{430}-\u{44f}\u{451}\u{410}-\u{42f}\u{401}\s\-]+$"))))
(assert (not (= (str.at z 24) "s")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}]+[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}\- \/]{1,29}$"))) (not (= "org/2000" (str.substr z 7 8))) (= "<legend onmouseover=""alert(<b>test</legend>" (str.replace x "1)"">" "<b>"))))
(assert (<= (str.len y) 97))
(assert (or (not (str.contains x "itable>tes")) (= (str.at y 5) "r") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.{4,}$")))))
(assert (not (= (str.indexof y "marq" 0) 79)))
(check-sat)
