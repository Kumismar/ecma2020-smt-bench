; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onerror=""alert(String.fromCharCode(88,83,83))"">") (= x "<link onmouseen\u{20000}t\u{10348}er=""alert(1)"">test</link>") (= x "<audio draggable=""true"" on\u{20000}dragend=""alert(1)\u{1f600}"">test</audio>")))
(assert (or (= z "&#x09;ascript:alert('XSS'\u{1f4a9})\u{1f600};\"">") (= z "n=alert(1)></details>") (= z "e>test</tbody>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9 ]{1,10}$"))) (not (str.prefixof "<audio" y))))
(assert (or (>= (str.len y) 87) (not (<= (str.len z) 39))))
(assert (not (str.prefixof "<IMG" y)))
(assert (= ">te" (str.substr x 31 3)))
(assert (not (str.prefixof "<IMG SR" y)))
(assert (or (str.contains x "een") (not (str.suffixof "\u{1f4a9})\u{1f600};\"">" z))))
(assert (or (not (str.contains x "=""ale")) (not (= "o>" (str.substr x 57 4)))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._-]+@[a-zA-Z0-9.-]{2,}[.][a-zA-Z]{2,4}"))))
(assert (or (not (= (str.indexof x "rCo" 0) 40)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\+?[\d\s\-\(\)]{8,}$")))))
(check-sat)
