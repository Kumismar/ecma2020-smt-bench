; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video oncopy=""alert(1)"" contenteditable>test</video>") (= x "<iframe src=""javascript:document.vulnerable=true; <")))
(assert (or (= z "alert(1)"">test</element>") (= z " style=""animation-name:x"" onanimationend=""alert(1)""></em>") (= z "cript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "\""http&" z))
(assert (or (= (str.at y 75) """") (str.contains z "rt(1)""")))
(assert (or (not (str.suffixof ">" z)) (not (str.prefixof "<video o" y))))
(assert (or (not (= (str.at x 42) "e")) (= ":aler" (str.substr y 56 5)) (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,7}$"))))
(assert (or (str.contains (str.replace y "t" "javascript:") "cripjavascript::doc") (not (= "=""ja" (str.substr x 11 4))) (not (str.prefixof " " z))))
(assert (or (str.suffixof "video>" x) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)")))))
(check-sat)
