; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo onfocusout=alert(1) tabindex=1 id=x></bdo><input autofocus>") (= x "<details onmouseup=""alert(\u{10348}\u{1f4a9}1)"">test</details>") (= x "<section onmouseenter=""alert(1)"">test</section>")))
(assert (or (= z "X3C;") (= z "IMG SRC="" &#14;  javascript:alert('XSS');"">") (= z "javascript:alert(1);""></IFRAME>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "3C;" 0) 1) (not (str.contains y "ion onmou"))))
(assert (or (not (= "out=" (str.substr y 12 4))) (not (= (str.indexof y "tails" 0) 3))))
(assert (or (not (str.contains x "section on")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{430}-\u{44f}\u{410}-\u{42f}\s]{1,30}$")))))
(assert (or (str.contains x "eta") (not (= (str.at y 43) "l"))))
(check-sat)
