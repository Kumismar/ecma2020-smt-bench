; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "%3cscript%3ealert('XSS')%3c/script%3e") (= x "<div draggable=""true"" contenteditable>drag me</div><element ondragover=alert(1) contenteditable>drop here</element>") (= x "<!-- Up to Opera 12.x -->")))
(assert (or (= z "#101%72t(1)>") (= z ") tabindex=1 id=x></kbd><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 137) (not (= (str.at x 9) "o"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]{6,30}$"))) (not (str.suffixof "1)>" y))))
(assert (or (>= (str.len y) 56) (not (str.prefixof "javas" z))))
(assert (or (str.contains z "in") (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?!(^[.-].*|[^@]*[.-]@|.*\.{2,}.*)|^.{254}.)([a-zA-Z0-9_.-]+@)(?!-.*|.*-\.)([a-zA-Z0-9-]{1,63}\.)+[a-zA-Z]{2,15}"))) (= "<div draggable=""true"" contenteditable>drag me</div><element ondragx=alert(1) contenteditable>drop here</element>" (str.replace x "over" "x"))))
(assert (or (str.contains (str.replace y "ofo" "x") "t autxcus") (= (str.indexof x "pt" 0) 7)))
(assert (not (<= (str.len z) 19)))
(check-sat)
