; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><header id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></header>") (= x "<dt onmouseleave=""alert(1)"">test</dt>") (= x "<input onkeypress=""alert(1)"" contenteditable>test</input>")))
(assert (or (= z "r>") (= z "\"";") (= z "aggable=""true"" ondragstart=""alert(1)"">test</data>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 1) """")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "([0-9]{2}-){2}[0-9]{4}"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}a-zA-Z-]+$")))))
(assert (not (= "ut>r" (str.substr y 54 4))))
(assert (or (str.prefixof "<style" x) (not (= "\javascript:;" (str.replace z """" "javascript:")))))
(assert (or (= (str.at y 10) "r") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$")))))
(check-sat)
