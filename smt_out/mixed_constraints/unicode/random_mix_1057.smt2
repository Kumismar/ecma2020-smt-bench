; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onmouseover=""alert(String.fromCharCode(88,83,83))"">") (= x "<iframe srcdoc=""&LT;iframe&sol;srcdoc=&amp;lt;img&sol;src=&amp;apos;&amp;apos;onerror=javascript:alert(1)&amp;gt;>"">")))
(assert (or (= z "k=""alert(1)"">test</menuitem>") (= z "amp onpaste=""alert(1)"" contenteditable>test</samp>") (= z "acronym onload=alert(1)></acronym>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 50)) (not (<= (str.len x) 63)) (not (str.prefixof "<IMG SRC=" x))))
(assert (not (= (str.indexof z "t" 0) 9)))
(assert (or (not (str.contains (str.replace z "></ac" "") "1)r")) (not (= (str.at x 93) "i")) (str.contains (str.replace z "e" "alert(1)") "=""alalert(1)rt")))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z A-Z]*$")))
(check-sat)
