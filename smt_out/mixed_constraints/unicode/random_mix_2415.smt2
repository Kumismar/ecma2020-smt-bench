; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""134""><xmp>") (= x "</XSS/*-*/STYLE=xss:e/**/xpression(alert('XSS'))>") (= x "<a onblur=alert(1) tabindex=1 id=x></a><input autofocus>")))
(assert (or (= z "font onbeforepaste=""alert(1)"" contenteditable>test</basefont>") (= z "e=alert(1)></output><input autofocus>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "ofocus>" x) (not (= "<a onblur=alert(1) tab ex=1 id=x></a><input autofocus>>" (str.replace y "ind" " "))) (= "<a onblur=alert(1) tabindex=1 id=</a><input autofocus>>" (str.replace y "x>" ""))))
(assert (= (str.at z 51) "/"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([+])(9{1})(1{1})(\d{10})|(\d{10})$"))) (not (= (str.indexof x "4""><" 0) 11))))
(assert (or (= (str.at z 16) "t") (= "d=""134"">" (str.substr x 6 8))))
(assert (or (<= (str.len y) 96) (not (str.prefixof "font o" z))))
(check-sat)
