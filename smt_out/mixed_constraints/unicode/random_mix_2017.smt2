; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><link style=""animation-name:x"" onanimationstart=""alert(1)""></link>") (= x "<style>@keyframes x{}</style><option style=""animation-name:x"" onanimationend=""alert(1)""></option>") (= x "<select draggable=""true"" ondrag=""alert(1)"">test</select>")))
(assert (or (= z "({set/**/$($){_/**/setter=$,_=javascript:alert(1)}}).$=eval</script>") (= z " onmouseup=""alert(1)"">test</frameset>") (= z "small id=x tabindex=1 onbeforeactivate=alert(1)></small>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<s" x)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "\d+$")) (not (str.prefixof "({set/**" z)) (str.contains y "ava")))
(assert (or (not (= "art=" (str.substr x 73 4))) (not (str.suffixof "ipt>" z)) (not (= (str.indexof z "abin" 0) 12))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(0?[1-9]|[12][0-9]|3[01])[\/](0?[1-9]|1[012])[\/]\d{4}\s([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"))))
(assert (or (= "style" (str.substr x 37 5)) (not (str.contains (str.replace z "st</d" " ") ">te l>"))))
(check-sat)
