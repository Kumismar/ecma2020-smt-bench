; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><small id=x style=""transition:color 1s"" ontransitionend=alert(1)></small>") (= x "<basefont id=x tabindex=\u{1f4a9}1 onbeforedea\u{20000}ctivate=alert(1)></basefont><input autofocus>") (= x """><img src=x onerror=javascript:alert(('A'))>")))
(assert (or (= z "st</element>") (= z "av"" type=""audio/wav""></audio>") (= z "oad=alert(1)></pre>")))
(assert (= y (str.++ x z)))
(assert (= "io>" (str.substr y 110 9)))
(assert (not (= "x tabind" (str.substr y 13 8))))
(assert (or (not (str.contains (str.replace y ">oad" "") "l=ale")) (str.contains (str.replace y ")></s" """") "t(1""mall>")))
(assert (or (not (= (str.at y 29) "b")) (str.suffixof "ement>" y) (not (str.suffixof """></audio>" z))))
(assert (or (str.contains y "im") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e1}\u{e0}\u{e2}\u{e3}\u{e9}\u{e8}\u{ea}\u{ed}\u{ef}\u{f3}\u{f4}\u{f5}\u{f6}\u{fa}\u{e7}\u{f1}\u{c1}\u{c0}\u{c2}\u{c3}\u{c9}\u{c8}\u{cd}\u{cf}\u{d3}\u{d4}\u{d5}\u{d6}\u{da}\u{c7}0-9\s]+$"))) (not (= (str.at z 15) ">"))))
(assert (or (str.suffixof "nt>" y) (not (str.contains (str.replace x "cri" "javascript:") "javasjavascript:pt")) (not (str.prefixof """><i" x))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9 -]+$"))))
(check-sat)
