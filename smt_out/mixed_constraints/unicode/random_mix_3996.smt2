; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea onkeydown=""alert(1)"" contenteditable>test</textarea>") (= x "<label onmouseout=""alert(1)"">test</label>")))
(assert (or (= z "l"" datasrc=""#X""></div>") (= z "ousemove=""alert(1)"">test</details>") (= z "frame>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<a href=""" y)) (>= (str.len z) 47) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(([^<>()[\]\\.,;:\s@""]+(\.[^<>()[\]\\.,;:\s@""]+)*)|("".+""))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$")))))
(assert (or (str.prefixof "fr" z) (str.contains z "e=""ale")))
(assert (or (str.suffixof "a>" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9]){7,8}$")))))
(assert (or (not (= (str.at y 87) "s")) (not (= "en" (str.substr y 2 2))) (= (str.at z 5) "t")))
(assert (or (= (str.at z 33) ">") (str.contains x "nmouse")))
(check-sat)
