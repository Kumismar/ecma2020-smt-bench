; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<header onfocusout=alert(1) tabindex=1 id=x></header><input autofocus>") (= x "<;A HREF="";http://google:ha.ckers.org"";>;XSS<;/A>;\u{1d400}") (= x "<sub onfocusout=alert(1) tabindex=1 id=x></sub><input autofocus>")))
(assert (or (= z "</s>") (= z "dex=1 onfocus=alert(1)></bdi>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len y) 72)) (not (>= (str.len x) 47))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((?!abuse|info|admin|billing).)*$"))) (= "<;A HREF="";http://google:ha.ckers.org"";"";XSS<;/A>;\u{1d400}" (str.replace x ">" """"))))
(assert (or (= (str.indexof x "=1 " 0) 33) (not (str.suffixof "</bdi>" z))))
(assert (= (str.len z) 4))
(assert (not (= "ers.org"";>" (str.substr x 30 10))))
(assert (not (str.prefixof "a" z)))
(assert (not (= "/s" (str.substr z 1 2))))
(assert (not (= (str.at z 26) "d")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_\+.~#?&//=]*)"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((?=.*\d)(?=.*[a-zA-Z]).{8,})$")))))
(check-sat)
