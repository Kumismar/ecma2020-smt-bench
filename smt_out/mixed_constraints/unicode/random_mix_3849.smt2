; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd oncopy=""alert(1)"" contenteditable>test</dd>") (= x "<\u{20000}div draggable=""true"" contenteditable>drag me</div><textarea ondragover=alert(1) contenteditable>\u{20000}drop here</textarea>")))
(assert (or (= z ">") (= z "eleave=""alert(1)"">test</big>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 155) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(DE\d{20})|(CH\d{19})|(AT\d{18})")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{1,99}"))) (not (str.contains x "onten"))))
(assert (not (= "<\u{20000}div draggable=""true"" contealert(1)itable>drag me</div><textarea ondragover=alert(1) contenteditable>\u{20000}drop here</textarea>" (str.replace x "nted" "alert(1)"))))
(assert (not (= (str.at z 6) "=")))
(assert (str.prefixof "<style>:" y))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{5}-[0-9]{7}-[0-9]{1}"))))
(assert (str.suffixof "/bgsound>" y))
(check-sat)
