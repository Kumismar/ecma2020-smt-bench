; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link onkeydown=""alert(1)"" contenteditable>test</link>") (= x "<aside onmousedown=""alert(1)"">test</aside>") (= x "<meta onkeydown=""alert(1)"" contenteditable>test</meta>")))
(assert (or (= z "3c") (= z "t(1)"">test</link>") (= z "t:alert(1)""></iframe>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[^;<>=]{2,100}$")) (= (str.at y 27) "c") (not (= "t(1)"">te ink>" (str.replace z "st</l" " ")))))
(assert (not (str.suffixof "></iframe>" z)))
(assert (or (= "ble>test</" (str.substr y 39 10)) (not (str.prefixof "<meta onk" x))))
(assert (or (not (<= (str.len y) 86)) (not (<= (str.len z) 9)) (= "ydown=""a" (str.substr y 10 8))))
(assert (or (not (str.contains y "test</met")) (str.contains (str.replace z "></if" "") "1)""ra") (str.suffixof "ink>" z)))
(assert (not (str.prefixof "<link o" y)))
(check-sat)
