; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s dragg\u{1f4a9}abl\u{1f4a9}e=""true"" ondragend=""alert(1)"">test</s>") (= x "<sup id=x tabindex=1 ondeactivate=alert(1)></sup><input id=y autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><b ondrop=alert(1) contenteditable>drop here</b>")))
(assert (or (= z "tc onkeyup=""alert(1)"" contenteditable>test</rtc>") (= z ">") (= z "cript:javascript:alert(1)""></frameset onBlur>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "u" 0) 2)))
(assert (not (str.prefixof "tc onk" z)))
(assert (or (not (str.contains x "rt")) (str.contains (str.replace z ">" """") """")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-z A-Z]{3,40}$"))) (str.suffixof "us>" x) (str.prefixof ">" z)))
(assert (= (str.indexof z "her" 0) 2))
(check-sat)
