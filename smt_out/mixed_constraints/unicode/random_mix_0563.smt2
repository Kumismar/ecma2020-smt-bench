; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside draggable=""true"" ondrags\u{20000}tart=""alert(1)"">test</as\u{10348}ide>") (= x "<datalist draggable=""true"" ondragleave=""alert(1)"">test</datalist>")))
(assert (or (= z " tabindex=1 onfocusin=alert(1)></menu>") (= z "over=""alert(1)"">test</blockquote>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 51) "t") (str.contains (str.replace y "t" "<b>") "<d<b> on")))
(assert (or (str.suffixof "datalist>" x) (= (str.len y) 103) (str.suffixof "e>" x)))
(assert (str.prefixof "<data" x))
(assert (or (not (= "est<" (str.substr x 46 4))) (= (str.at x 33) "a")))
(assert (not (str.prefixof "<script" y)))
(assert (>= (str.len y) 90))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\x20-\x7e\x80-\xff]*$"))))
(assert (str.suffixof "ry>" x))
(check-sat)
