; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><blockquote onload=alert(1)></blockquote>") (= x "<listing onbeforepaste=""alert(1)"" contenteditable>test</listing>")))
(assert (or (= z "n onbeforepaste=""alert(1)"" contenteditable>test</option>") (= z ">test</acronym>") (= z "1)"">test</datalist>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 59) "t")))
(assert (or (= "r" (str.substr y 15 1)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[6-9]{1}[0-9]{9}$")))))
(assert (= (str.indexof z "r" 0) 9))
(assert (or (str.contains x "ble>") (str.contains (str.replace y "te" "<b>") "quo<b> on") (not (= (str.indexof y "on" 0) 17))))
(assert (not (str.contains (str.replace y ">1)"">" " ") "ing tes")))
(check-sat)
