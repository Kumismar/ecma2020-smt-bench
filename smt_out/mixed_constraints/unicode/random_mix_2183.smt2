; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike id=x tabindex=1 onfocusin=alert(1)></strike>") (= x "<style>:target {color: red;}</style><figure id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></figure>") (= x "<address id=x tabindex=1 onbeforede\u{1f600}activate=alert(1)></address><input autofocu\u{10348}s>")))
(assert (or (= z "ake says, 'XSS'\"")`&gt;") (= z "ert(1)"" contenteditable>test</marquee>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace y "ler" " ") "in=a t("))
(assert (<= (str.len z) 39))
(assert (str.suffixof ">" x))
(assert (not (= "x=1 onfo" (str.substr y 20 8))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([^0-9]*)$"))) (not (= (str.at y 57) "a"))))
(assert (or (str.suffixof "quee>" y) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z._-]{2,}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "|^[a-zA-Z \u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{fc}\u{e7}]*$|"))))
(assert (or (not (= "dex=" (str.substr y 18 4))) (str.prefixof "a" z) (not (= (str.at x 9) "d"))))
(check-sat)
