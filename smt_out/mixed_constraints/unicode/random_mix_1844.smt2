; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><param id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></param>") (= x """><img src=x onerror=javascript:alert(('1'))>")))
(assert (or (= z "ab;a&Tab;s&Tab;c&Tab;r&Tab;i&Tab;p&Tab;t&Tab;:a&Tab;l&Tab;e&Tab;r&Tab;t&Tab;%28&Tab;1&Tab;%29></iframe>") (= z "rue"" ondragleave=""alert(1)"">test</picture>") (= z "#46;0x7&#46;147/\""&gt;XSS&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9 ]*$"))))
(assert (or (not (= (str.indexof x " on" 0) 12)) (= "trans" (str.substr x 16 5)) (not (>= (str.len y) 156))))
(assert (or (not (= "&Tab;i&Ta" (str.substr z 22 9))) (= (str.len z) 52)))
(assert (= (str.len z) 2))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{f1}\u{d1}]{2,30}$"))))
(assert (or (str.contains z "9></ifr") (str.prefixof "1)" z)))
(assert (or (= (str.indexof x "1" 0) 40) (= (str.indexof z "\u{1f4a9}" 0) 0)))
(check-sat)
