; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem draggable=""true"" ondragenter=""alert(1)"">test</menuitem>") (= x "<samp onmouseenter=""alert(1)"">test</samp>")))
(assert (or (= z "//") (= z "nextid>") (= z "nimationstart=""alert(1)""></fieldset>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "draggable="))
(assert (or (not (str.suffixof "object>" z)) (>= (str.len z) 1) (= "javascript:/" (str.replace z "/" "javascript:"))))
(assert (str.prefixof "<menu" x))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}\s]+$"))))
(assert (or (<= (str.len z) 39) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d[0-9]{9,11}$")))))
(assert (or (not (= (str.indexof z "xtid" 0) 2)) (= "<menuitem draggable=""true"" ondragenter=""alert(1)""test</menuitem>" (str.replace x ">" "")) (>= (str.len y) 101)))
(assert (or (not (str.suffixof "nuitem>" x)) (str.suffixof "(1)></h1>" y)))
(check-sat)
