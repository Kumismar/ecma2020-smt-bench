; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame id=x tabindex=1 onactivate=alert(1)></frame>") (= x "<progress onkeypress=""alert(1)"" contenteditable>test</progress>")))
(assert (or (= z "3/"";>;XSS<;/A>;") (= z "nt>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<progress " y) (not (= (str.indexof x "focu" 0) 25)) (not (= (str.len x) 51))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?=.*?[1-9])\d{3,5}(\.\d+)?$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9-_\.]{6,20}$"))) (str.contains (str.replace x "x ta" "javascript:") "d=javascript:binde")))
(assert (not (= (str.at z 5) ">")))
(assert (or (<= (str.len z) 25) (= "XSS<;/A" (str.substr z 6 7)) (not (str.suffixof ">" z))))
(assert (or (not (str.contains x "alert(1)>")) (not (str.contains (str.replace x "/pr" """") "<""o"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[+-]?[\d\.]*$")) (not (= "ert" (str.substr x 38 3)))))
(assert (not (= "<progress onkeypress=""alert(1)"" con""nteditable>test</progress>" (str.replace x "te" """"))))
(check-sat)
