; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onmouseout=""alert(String.fromCharCode(88,83,83))"">") (= x "<datalist onpaste=""alert(1)"" contenteditable>test</datalist>")))
(assert (or (= z "lert(1)"" contenteditable>test</u>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 1)) (= (str.at y 0) "<")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(13[0-9]|15[0-9]|18[0-9])\d{8}$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z ]{4,70}"))) (= "es" (str.substr x 46 2)) (= "a" (str.substr x 52 1))))
(assert (str.prefixof "<d" x))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^1([38][0-9]|4[579]|5[0-3,5-9]|6[6]|7[0135678]|9[89])\d{8}$"))) (>= (str.len x) 61)))
(assert (str.contains x " c"))
(assert (or (not (str.contains z ">")) (= (str.at x 32) "t") (str.prefixof ">" z)))
(assert (or (not (= "ble=""tru" (str.substr z 0 8))) (not (>= (str.len x) 57))))
(check-sat)
