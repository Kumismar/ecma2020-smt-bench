; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ins onmousedown=""alert(1)"">test</ins>") (= x "<figcaption onkeypress=""alert(1)"" contenteditable>test</figcaption>")))
(assert (or (= z "><h1>XSS by xss</h1></marquee>") (= z "alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "1)>" y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9\.\-]{1,}$")))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z\s]{1,})$")) (= (str.len z) 30)))
(assert (or (not (= " " (str.substr y 4 1))) (= (str.at x 13) "n") (= (str.at x 0) "<")))
(assert (= (str.at x 34) "i"))
(assert (= "own=" (str.substr x 13 4)))
(assert (not (= "<ins onmousedown=""alert(1)""test</ins>" (str.replace x ">" ""))))
(assert (not (<= (str.len x) 77)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[ ]*[0-9\(][ 0-9-\(\)]{7,}[0-9\)][ ]*$"))) (str.contains (str.replace y "t" "javascript:") "pjavascript:ion o") (not (= "ert(1" (str.substr z 2 5)))))
(check-sat)
