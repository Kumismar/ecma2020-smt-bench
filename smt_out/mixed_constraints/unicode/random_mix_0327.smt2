; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<shadow id=x tabindex=1 onbeforedeactivate=alert(1)></shadow><input autofocus>") (= x "<sup draggable=""true"" ondragstart=""alert(1)"">test</sup>")))
(assert (or (= z "onbeforeactivate=alert(1)></cite>") (= z "est</small>") (= z "com/xss.js></SCRIPT>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "r" "javascript:") "befojavascript:eact")) (not (= "est</smx>" (str.replace z "all" "x")))))
(assert (not (= "small>" (str.substr z 5 8))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[^<>\\/]+$"))) (= (str.at y 29) "t")))
(assert (or (= "(1)""" (str.substr y 40 4)) (str.suffixof "t</small>" y) (not (= "est</smaalert(1)l>" (str.replace z "l" "alert(1)")))))
(assert (not (str.prefixof "<sup dr" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(0?[1-9]|1[012])[/-]?(0?[1-9]|[12][0-9]|3[01])$"))))
(assert (= "/cite>" (str.substr z 27 7)))
(assert (or (not (= (str.at z 6) "s")) (not (str.prefixof "<sup d" x))))
(check-sat)
