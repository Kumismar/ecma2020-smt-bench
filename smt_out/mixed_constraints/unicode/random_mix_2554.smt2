; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture onkeyup=""alert(1)"" contenteditable>test</picture>") (= x "<dir onmouseleave=""alert(1)"">test</dir>") (= x "<OBJECT TYPE=""text/x-scriptlet"" DATA=""http://hacker.com/xss.html"">")))
(assert (or (= z ">") (= z "X0003c")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "tp:/") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(\d{3})$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!\s*$)[a-zA-Z0-9\s]{1,50}$")))))
(assert (not (= (str.at x 14) "t")))
(assert (or (not (str.contains x "mouseleave")) (str.suffixof ">" x) (<= (str.len x) 67)))
(assert (or (= (str.indexof y "DATA" 0) 32) (str.contains (str.replace x "T" " ") "C  ")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+.[a-z]+$")))
(assert (or (str.suffixof ">" z) (= (str.at y 8) "o")))
(assert (or (<= (str.len x) 48) (not (str.prefixof "<d" y))))
(check-sat)
