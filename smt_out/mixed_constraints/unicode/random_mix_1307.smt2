; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><embed id=x style=""transition:color 1s"" ontransitionend=alert(1)></embed>") (= x "<figure onfocusout=alert(1) tabindex=1 id=x></figure><input autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><small ondrop=alert(1) contenteditable>drop here</small>")))
(assert (or (= z "11; src=""javascript&#58;alert(1)""&#11;&#10;&#09;;>") (= z """alert(1)"" contenteditable>test</menu>") (= z "\u{10348}<keygen ondrop=alert(1) conten\u{10348}teditable>drop here</keygen>")))
(assert (= y (str.++ x z)))
(assert (or (= "gt;" (str.substr y 25 3)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "([0-9]{1,2}).([0-9]{1,2}).[0-9]{4}")))))
(assert (str.suffixof "&#09;;>" z))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "7[0-9]{10}"))) (str.suffixof ";;>" y)))
(assert (= "<figxre onfocusout=alert(1) tabindex=1 id=x></figure><input autofocus>11; src=""javascript&#58;alert(1)""&#11;&#10;&#09;;>" (str.replace y "u" "x")))
(assert (or (<= (str.len x) 115) (not (= (str.indexof y "rt(" 0) 68))))
(assert (not (= "<aujavascript: onmouseleave=""alert(1)"">test</audio>autofocus>" (str.replace y "dio" "javascript:"))))
(check-sat)
