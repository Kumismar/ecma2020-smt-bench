; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><img id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></img>") (= x "<div draggable=""true"" contenteditable>drag me</div><article ondragover=alert(1) contenteditable>drop here</article>")))
(assert (or (= z "trong onkeydown=""alert(1)"" contenteditable>test</strong>") (= z "ad=alert(1)></keygen>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len y) 162))
(assert (str.prefixof "tr" z))
(assert (= (str.at x 8) "g"))
(assert (or (= "g>" (str.substr z 54 8)) (= "gover=ale" (str.substr y 65 9)) (not (str.in_re y ((_ re.from_regex ecma2020 u) ".{1,3}")))))
(assert (not (str.suffixof "ng>" y)))
(assert (or (not (<= (str.len y) 137)) (not (str.contains x "co")) (not (= "<div draggable="" rue"" contenteditable>drag me</div><article ondragover=alert(1) contenteditable>drop here</article>" (str.replace x "t" " ")))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^((((\+31|0|0031)[1-9]{2}[0-9][-]?[0-9]{6}[0-9]*)|((\+31|0|0031)[1-9][0-9][-]?[1-9][0-9]{6}))|(((\+31|0|0031)[\s]?[-]?6){1}[-]?[1-9]{1}[0-9]{7}))")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 ']+$"))) (= " me</di" (str.substr y 42 7))))
(assert (or (not (>= (str.len z) 56)) (not (str.contains (str.replace z "(1)""" "x") "rtx con"))))
(check-sat)
