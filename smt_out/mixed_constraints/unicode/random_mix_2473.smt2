; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<multicol onmouseup=""alert(1)"">test</multicol>") (= x "<multicol onclick=""alert(1)"">test</multicol>")))
(assert (or (= z "orm 2s"" ontransitionrun=alert(1)></spacer>") (= z "ss.js""></script>") (= z "e=""alert(1)"" contenteditable>test</dir>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<multico" y) (= (str.len z) 39)))
(assert (or (= (str.indexof x "li" 0) 13) (str.contains (str.replace x "t" " ") "<mul ic") (not (<= (str.len y) 64))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{2}[0-9]{6}$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_\-\.\+]{1,}@([\da-zA-Z-]{1,}\.){1,}[\da-zA-Z-]{2,20}$"))) (not (str.suffixof "col>" x))))
(assert (or (str.prefixof "orm 2s"" o" z) (= (str.indexof x "nmous" 0) 11)))
(assert (or (= (str.indexof x "<mul" 0) 0) (<= (str.len x) 47)))
(check-sat)
