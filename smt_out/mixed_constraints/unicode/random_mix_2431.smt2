; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bod\u{1f600}y onhashchange=""alert\u{1f4a9}(1)"">") (= x "<rtc draggable=""true"" ondrag=""alert(1)"">test</rtc>") (= x "perl -e &apos;print &quot;&lt;IMG SRC=java\0script:alert(&quot;XSS&quot;)>&quot;;&apos;&gt; out")))
(assert (or (= z "div><marquee ondragover=alert(1) contenteditable>drop here</marquee>") (= z " contenteditable>test</pre>") (= z "%3C%2Fscript%3E%3Cscript%3ERWAR%280x00010E%29%3C%2Fscript%3E")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "quee>" y) (not (= "n:tra" (str.substr z 76 5))) (not (= "edit" (str.substr z 8 4)))))
(assert (or (= (str.at z 25) "e") (not (str.contains x "c drag"))))
(assert (or (not (= "v" (str.substr z 2 1))) (= "div><marquee ondragover=alert(1) contenteditablexop here</marquee>" (str.replace z ">dr" "x"))))
(assert (or (not (str.prefixof " cont" z)) (str.prefixof " con" z) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z]+(?:\s[a-zA-Z]+)+$"))))
(assert (not (str.prefixof " conte" z)))
(assert (= (str.len y) 77))
(check-sat)
