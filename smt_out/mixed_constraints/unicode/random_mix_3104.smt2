; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound onmouseenter=""alert(1)"">test</bgsound>") (= x "<div draggable=""true"" contenteditable>drag me</div><bdi ondragover=alert(1) contenteditable>drop here</bdi>")))
(assert (or (= z "ert(1)"">test</marquee>") (= z "hange=alert(1)></iframe>") (= z "kbd>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "rt(1)" 0) 9)) (str.suffixof "s>" y)))
(assert (or (= "e >test</a>" (str.replace z "nt1""" " ")) (not (= (str.at x 21) "=")) (= """>tes" (str.substr z 6 5))))
(assert (not (str.contains y "oun")))
(assert (or (str.contains z "t(1)"">t") (str.contains x "onm") (str.prefixof "<d" y)))
(assert (not (str.prefixof "<bgsound" x)))
(assert (or (str.suffixof "sound>" x) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\sA-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]*$"))) (= (str.indexof y "bl" 0) 28)))
(assert (not (str.suffixof "e>" y)))
(assert (<= (str.len y) 132))
(check-sat)
