; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onclick=""alert(1)"">test</body>") (= x "<meter draggable=""true"" ondragend=""alert(1)"">test</meter>") (= x "<area draggable=""true"" ondragend=""alert(1)"">test</area>")))
(assert (or (= z "/menuitem><input id=y autofocus>") (= z """>test</var>") (= z "index=1 onactivate=alert(1)></source>")))
(assert (= y (str.++ x z)))
(assert (not (= "rea drag" (str.substr y 2 8))))
(assert (or (= (str.indexof x "d=""" 0) 32) (= "ag" (str.substr x 8 2))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-z]{6}\d{2}[A-z]\d{2}[A-z]\d{3}[A-z]$")) (str.prefixof """>te" z) (str.suffixof "s>" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 _-]{2,}"))) (= (str.indexof y """ale" 0) 56)))
(assert (str.prefixof "<m" x))
(assert (or (not (str.suffixof "st</body>" x)) (str.in_re z ((_ re.from_regex ecma2020 u) "^(91|92|93|96)\d{7}$"))))
(check-sat)
