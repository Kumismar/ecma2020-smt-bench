; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i onblur=alert(1) tabindex=1 id=x></i><input autofocus>") (= x "<frame oncontextmenu=""alert(1)"">test</frame>") (= x "<video id=x tabindex=1 onbeforeactivate=alert(1)></video>")))
(assert (or (= z "pt:alert('XSS');\""></FRAMESET>") (= z "ert(1) tabindex=1 id=x></rp><input autofocus>") (= z "error%3dalert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "ind" 0) 22)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{7,15}$")))))
(assert (or (not (= """ " (str.substr z 25 2))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "([a-zA-Z]|[- @\.#&!])*")))))
(assert (= "ert(1) tabindex=1 id=x></rp><input autjavascript:s>" (str.replace z "ofocu" "javascript:")))
(assert (or (str.contains x "dex=1") (not (str.contains (str.replace z "rror" """") "e""%3")) (>= (str.len y) 75)))
(assert (not (= "o>" (str.substr x 55 3))))
(assert (or (not (<= (str.len y) 66)) (not (= (str.at x 13) "s")) (str.in_re y ((_ re.from_regex ecma2020 u) "^[+][7] [(][\d]{3}[)] \d{3}-\d{2}-\d{2}$"))))
(assert (or (not (str.contains z "ale")) (= (str.at z 28) "T")))
(assert (= "ur=aler" (str.substr x 7 7)))
(check-sat)
