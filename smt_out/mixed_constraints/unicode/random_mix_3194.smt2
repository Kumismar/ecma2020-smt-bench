; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<listing onpaste=""alert(1)"" contenteditable>test</listing>") (= x "<details onkeydown=""\u{1f4a9}alert(1)"" contented\u{1f600}itable>test</details>")))
(assert (or (= z "lert(1)"">test</li>") (= z "></li>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 67) (= "<details onkeydown=""\u{1f4a9}alert(1)"" contented""le>test</details>" (str.replace x "\u{1f600}itab" """"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "..{1,}\s..+"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w\s-]*$")))))
(assert (or (str.prefixof "<detai" x) (str.contains y """ ") (not (= (str.indexof z "</li>" 0) 1))))
(assert (not (str.contains z "test</")))
(assert (or (= "s" (str.substr x 60 1)) (not (str.suffixof "li>" z))))
(assert (or (not (str.prefixof "<lis" y)) (>= (str.len x) 37)))
(assert (str.contains x "conte"))
(check-sat)
