; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend onmousedown=""alert(1)"">test</legend>") (= x "<dir onfocusout=alert(1) tabindex=1 id=x></dir><input autofocus>")))
(assert (or (= z "table>test</legend>") (= z "est</center>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "e>test</")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{30a1}-\u{30f6}\u{30f7}\u{30f8}\u{30f9}\u{30fa}\u{30fc}\u{3000} ]*$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-3][0-9][\.][0-3][0-9][\.]202[1-9]$")))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{3041}-\u{3093}\u{30a1}-\u{30f6}\u{3000}\s]+$")))
(assert (or (not (= (str.len z) 37)) (= (str.at y 31) "e")))
(assert (not (= (str.len x) 64)))
(assert (or (not (str.contains y "><input")) (= ">" (str.substr z 18 2)) (not (str.prefixof "<di" y))))
(assert (or (str.prefixof "<dir " x) (not (str.suffixof "/p>" z))))
(assert (<= (str.len z) 20))
(assert (not (= "eave=""alert(1)"">""t</code>" (str.replace z "tes" """"))))
(check-sat)
