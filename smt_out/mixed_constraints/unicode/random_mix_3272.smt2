; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script onkeyup=""alert(1)"" contenteditable>test</script>") (= x "<IMG SRC=\u{201d}jav ascript:alert(\u{2018}XSS\u{2019});\u{201d}>")))
(assert (or (= z "expression(alert('XSS'))"">") (= z "div draggable=""true"" contenteditable>drag me</div><progress ondragover=alert(1) contenteditable>drop here</progress>") (= z "e onkeypress=""alert(1)"" contenteditable>test</figure>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len x) 58)) (not (str.suffixof "XSS\u{2019});\u{201d}>" x))))
(assert (or (= (str.indexof z "ss=" 0) 10) (str.contains y "MG")))
(assert (<= (str.len z) 57))
(assert (or (= (str.indexof y "ript>" 0) 51) (= "<IMG SR<b>jav ascript:alert(\u{2018}XSS\u{2019});\u{201d}>expression(alert('XSS'))"">" (str.replace y "C=\u{201d}" "<b>"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[\u{5c}u00C0-\u{5c}u017FA-Za-z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[\u{5c}u00C0-\u{5c}u017FA-Za-z0-9.-]+\.[A-Za-z]{2,}$"))) (not (= (str.at z 16) "("))))
(assert (not (= "e"" cont" (str.substr z 18 7))))
(assert (or (not (= (str.at z 4) "e")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_\.\-]+@(?:[a-zA-Z0-9\-]+\.)+[a-z]{2,4}$")))))
(check-sat)
