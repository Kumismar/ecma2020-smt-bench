; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script src=%(jscript)s></script>") (= x "<summary id=x tabindex=1 ondeactivate=alert(1)></summary><input id=y autofocus>")))
(assert (or (= z "base>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (= "cus>" (str.substr x 75 8)) (str.contains (str.replace z "div><" "alert(1)") " me</alert(1)co")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^3$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!\s*$)[a-zA-Z0-9\s@@(.,-_)]{1,30}$"))) (not (<= (str.len z) 8))))
(assert (or (not (<= (str.len x) 56)) (not (= (str.indexof x "onb" 0) 8)) (= "javascript:" (str.replace z ">" "javascript:"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{1}[0-9]{8,9}$"))))
(check-sat)
