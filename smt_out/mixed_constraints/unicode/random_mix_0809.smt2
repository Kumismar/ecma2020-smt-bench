; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ul onkeydown=""alert(1)"" contenteditable>test</ul>") (= x "<progress onmouseup=""alert(1)"">test</progress>")))
(assert (or (= z "(1)""></h1>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z "(1)"">" 0) 0))
(assert (or (= (str.at x 21) " ") (not (<= (str.len y) 49))))
(assert (or (str.suffixof "rogress>" x) (= "<ul onkeydownalert(1)lert(1)"" contenteditable>test</ul>" (str.replace x "=""a" "alert(1)"))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9 ]{5,50}$")))
(assert (or (not (str.prefixof "(1)""></" z)) (not (str.suffixof "ddress>" y))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^( *)((([Gg][ ]*)([Ii][ ]*)([Rr][ ]*)0[ ]*([Aa][ ]*){2})|((([A-Za-z][ ]*([0-9][ ]*){1,2})|(([A-Za-z][ ]*[A-Ha-hJ-Yj-y][ ]*([0-9][ ]*){1,2})|(([A-Za-z][ ]*[0-9][ ]*[A-Za-z][ ]*)|([A-Za-z][ ]*[A-Ha-hJ-Yj-y][ ]*[0-9][ ]*[A-Za-z]?[ ]*))))( *)[0-9][ ]*([A-Za-z][ ]*){2}))( *)$"))))
(assert (= (str.at x 36) "a"))
(assert (not (str.prefixof "<progr" x)))
(check-sat)
