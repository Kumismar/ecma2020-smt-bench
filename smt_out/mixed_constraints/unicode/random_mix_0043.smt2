; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup onclick=""alert(1)"">test</colgroup>") (= x "<ol oncopy=""alert(1)"" contenteditable>test</ol>")))
(assert (or (= z "%6F%6D"";>;XSS<;/A>;") (= z "t(1)"" contenteditable>test</address>")))
(assert (= y (str.++ x z)))
(assert (= (str.at z 2) "1"))
(assert (or (not (<= (str.len x) 48)) (not (= (str.indexof x "test" 0) 29)) (str.contains x "ncopy")))
(assert (or (str.prefixof "<ol on" y) (not (= (str.indexof x "ick=""" 0) 14)) (str.contains (str.replace y "t(1)""" "<b>") "r<b>>te")))
(assert (str.contains (str.replace y "o" "alert(1)") "<calert(1)lg"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z_-]{2,}$"))) (= (str.indexof z "%6D" 0) 3)))
(assert (or (= "<ol xcopy=""alert(1)"" contenteditable>test</ol>" (str.replace x "on" "x")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\u{a5}d*"))) (str.prefixof "<selec" x)))
(check-sat)
