; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed draggable=""true"" ondragstart=""alert(1)"">test</noembed>") (= x "<iframe/%00/ src=javaSCRIPT&colon;alert(1)") (= x "<source oncopy=""alert(1)"" contenteditable>test</source>")))
(assert (or (= z ">") (= z "eactivate=alert(1)></center\u{1f600}><input id=y au\u{1f4a9}tofocus>") (= z " SRC=javascript:alert('XSS')>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len y) 101)) (not (str.prefixof " SRC=java" z)) (str.prefixof "<source o" x)))
(assert (>= (str.len z) 1))
(assert (or (not (= (str.indexof x "star" 0) 32)) (= (str.indexof y "vate" 0) 68) (not (str.suffixof ";alert(1)" x))))
(assert (str.contains z "(1"))
(assert (or (= (str.indexof z "C" 0) 3) (not (= "art=""a" (str.substr y 34 6))) (= (str.len y) 56)))
(assert (or (str.contains (str.replace z ">" " ") " ") (not (= (str.at z 0) ">")) (= "<legen<b> id=x tabindex=1 onfocusin=alert(1)></legend>s\u{1d400}trong>" (str.replace y "d" "<b>"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\d]{4}"))))
(check-sat)
