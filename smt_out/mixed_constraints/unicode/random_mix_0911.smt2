; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<STYLE>li {list-style-image: url(\""javascript:alert('XSS')\"");}</STYLE><UL><LI>XSS") (= x "<ol onmouseover=""alert(1)"">test</ol>") (= x "\u{1d400}&lt;A HREF=\""http&#58;//ha&#46;cker\u{1f600}s&#46;org@google\""&gt;XSS&lt;/A&gt;")))
(assert (or (= z "arCode(88,83,83))"">") (= z "ert(1)"">test</img>") (= z " draggable=""true"" ondragleave=""alert(1)"">test</strike>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<STYLE" x))
(assert (or (not (str.contains (str.replace x "8;/" "<b>") "tp&#5<b>/")) (= "<style>@keyframes \u{10348}x{}</style><tr style=""anima<b>on-name:x"" onanimationstart=""alert(1)""></tr>" (str.replace x "ti" "<b>"))))
(assert (or (not (str.contains y "ol onmo")) (str.contains z "ble=""true""") (not (= (str.len x) 82))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,7}$||[0-9]{5,8}")))
(assert (= (str.indexof z "rt" 0) 1))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d*(\.\d{0,8})?$"))) (str.contains z "t</svg") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9~@#$^/*()_+=<>[\]{}|\\,.?: -]*$")))))
(assert (not (str.suffixof "t</slot>" y)))
(check-sat)
