; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<template oncontextmenu=""alert(1)"">test</template>") (= x "<style>:target {transform: rotate(180deg);}</style><fieldset id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></fieldset>")))
(assert (or (= z "pt:alert((`1`))>") (= z "<th ondragover=alert(1) contenteditable>drop here</th>") (= z " contenteditable>drop here</output>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 46) "a")) (= (str.len x) 50) (str.contains (str.replace x "te>" " ") "a ")))
(assert (or (not (= (str.at y 140) "r")) (str.suffixof "fieldset>" x) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9A-Za-z@.\-_]+$"))))
(assert (or (not (str.contains z "e</t")) (not (>= (str.len x) 125)) (not (str.prefixof "<th o" z))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^\d*$")) (= "<style>:target {transform: rotate(180deg);}</style><fieldset ixstyle=""transition:transform 2s"" ontransitionrun=alert(1)></fieldset>" (str.replace x "d=x " "x"))))
(check-sat)
