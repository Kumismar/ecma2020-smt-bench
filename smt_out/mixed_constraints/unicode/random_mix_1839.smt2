; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><dl onload=alert(1)></dl>") (= x "<details onclick=""alert(1)"">test</details>") (= x "<tt onmousemove=""alert(1)"">test</tt>")))
(assert (or (= z "tyle=""animation-name:x"" onanimationend=""alert(1)""></dir>") (= z "mouseout=""alert(1)"">test</tr>") (= z "=x tabindex=1 onfocusin=alert(1)></code>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "le" " ") "gab =""tr") (not (= (str.at x 27) ">"))))
(assert (or (not (str.contains y "t=""alert(1")) (str.prefixof "<svg><d" x) (not (str.prefixof "<tt" x))))
(assert (or (= "ls onc" (str.substr x 6 6)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{6,20}$"))) (not (= (str.at x 5) "<"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9A-z /-]){5,}$"))))
(check-sat)
