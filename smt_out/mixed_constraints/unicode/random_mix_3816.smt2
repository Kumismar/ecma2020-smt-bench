; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG SRC=&quot;javascript:alert(&apos;XSS&apos;);&quot;&gt;") (= x "<strike oncopy=""alert(1)"" contenteditable>test</strike>") (= x "<dialog onmouseover=""alert(1)"">test</dialog>")))
(assert (or (= z "#X003C") (= z "st</spacer>") (= z "lot>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len y) 52)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\.\-]{8,11}$"))))
(assert (or (not (str.contains z "st</sp")) (str.suffixof "ot>" z)))
(assert (not (str.contains (str.replace x " onke" "alert(1)") "palert(1)y")))
(assert (or (str.suffixof "gt;#X003C" y) (str.prefixof "<strike on" x)))
(assert (or (= (str.at x 34) "t") (not (str.prefixof "&lt;I" y))))
(assert (or (not (str.contains x "on")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{6}$"))) (<= (str.len x) 55)))
(assert (str.contains x "mouseove"))
(check-sat)
