; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time id=x tabindex=1 onbeforeactivate=alert(1)></time>") (= x "<rp id=x tabindex=1 onfocusin=alert(1)></rp>") (= x "<legend onmouseup=""alert(1)"">test</le\u{1f600}gend>")))
(assert (or (= z "ble>drop here</meta>") (= z "st</dir>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?:(?:31(\/|-|\.)(?:0?[13578]|1[02]))\1|(?:(?:29|30)(\/|-|\.)(?:0?[13-9]|1[0-2])\2))(?:(?:1[6-9]|[2-9]\d)?\d{2})$|^(?:29(\/|-|\.)0?2\3(?:(?:(?:1[6-9]|[2-9]\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))$|^(?:0?[1-9]|1\d|2[0-8])(\/|-|\.)(?:(?:0?[1-9])|(?:1[0-2]))\4(?:(?:1[6-9]|[2-9]\d)?\d{2})$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{4,15}$"))) (= (str.at y 39) "a") (= "1)" (str.substr y 36 2))))
(assert (or (not (= "<title draggable=""true"" ondrag=""alert(1)"">test</title>ionend=aleralert(1)</progress>" (str.replace y "t(1)>" "alert(1)"))) (not (= (str.at z 7) ">")) (not (= "oreac" (str.substr y 27 5)))))
(assert (or (= (str.indexof x "vat" 0) 34) (not (str.prefixof "<style" x)) (= (str.indexof z ">dro" 0) 3)))
(assert (or (not (str.contains x " on")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z]\d[A-Za-z] *\d[A-Za-z]\d$")))))
(assert (or (= (str.at x 57) "9") (not (= "ere</" (str.substr y 54 5)))))
(check-sat)
