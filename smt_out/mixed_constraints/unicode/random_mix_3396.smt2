; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><p ondrop=alert(1) contenteditable>drop here</p>") (= x "<noembed onmouseout=""alert(1)"">test</noembed>")))
(assert (or (= z "t oncopy=""alert(1)"" contenteditable>test</basefont>") (= z "e>") (= z "t</center>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "t" (str.substr z 0 1))) (str.in_re x ((_ re.from_regex ecma2020 u) ".{10,19}"))))
(assert (or (not (str.prefixof "<div drag" y)) (not (= (str.at y 37) "n"))))
(assert (or (= (str.indexof x "rag " 0) 39) (str.in_re y ((_ re.from_regex ecma2020 u) "\S+@\S+\.\S*$"))))
(assert (str.prefixof "<form d" x))
(assert (or (not (str.prefixof "t</" z)) (= "<noembed onmouseou =""alert(1)"">test</noembed>e>" (str.replace y "t" " "))))
(assert (not (str.suffixof ">" z)))
(assert (or (not (str.contains z "ditable>")) (str.suffixof "sefont>" z)))
(assert (or (= (str.at x 23) "e") (not (= (str.at x 71) "o"))))
(check-sat)
