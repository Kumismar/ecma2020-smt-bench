; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section onbeforecut=""alert(1)"" contenteditable>test</section>") (= x "&#x03C;")))
(assert (or (= z "e><button id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></button>") (= z "error=javascript:alert(1)//></style>") (= z """alert(1)"" contenteditable>test</bgsound>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 65) "e")) (not (>= (str.len y) 63))))
(assert (or (str.prefixof "<ele" y) (not (str.suffixof "</style>" y))))
(assert (str.prefixof "per" x))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9A-Za-z_\-]+$"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^0\d([\d]{0,1})([-]{0,1})\d{7}$")) (not (= (str.indexof x "cti" 0) 3))))
(assert (= (str.indexof z "a" 0) 7))
(check-sat)
