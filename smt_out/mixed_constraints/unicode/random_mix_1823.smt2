; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<label draggable=""true"" ondragstart=""alert(1)"">test</label>") (= x "<;LINK REL="";stylesheet""; HREF="";http://ha.ckers.org/xss.css"";>;") (= x "<video id=x tabindex=1 onbeforedeactivate=alert(1)></video><input autofocus>")))
(assert (or (= z "le=""animation-name:x"" onanimationstart=""alert(1)""></sup>") (= z "lert(1) contenteditable>drop here</source>")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "([\w-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-zA-Z]{2,6}(?:\.[a-zA-Z]{2})?)$")))
(assert (= "LINK R" (str.substr x 2 6)))
(assert (or (str.contains x "de") (str.prefixof "<;LIN" y) (str.suffixof "est</em>" x)))
(assert (= (str.at y 97) "<"))
(assert (or (not (= (str.at x 13) "s")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[\u{430}-\u{44f}\u{451}\u{410}-\u{42f}\u{401}a-zA-Z -]+")))))
(assert (not (= (str.indexof y """><" 0) 107)))
(assert (or (not (= (str.at x 13) "e")) (not (str.suffixof ">" y))))
(assert (str.contains (str.replace x "g/" "x") "orxxs"))
(assert (= "ame:" (str.substr y 91 4)))
(check-sat)
