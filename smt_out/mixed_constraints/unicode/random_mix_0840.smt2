; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "#0000108&#0000101&#0000114&#0000116&#0000040&#0000039&#0000088&#0000083&#0000083&#0000039&#0000041>") (= x "<center onclick=""alert(1)"">test</center>") (= x "<kbd onkeypress=""alert(1)"" contenteditable>test</kbd>")))
(assert (or (= z "me</div><header ondrop=alert(1) contenteditable>drop here</header>") (= z "ipt:alert(1)</script -->") (= z "mes onbeforecopy=""alert(1)"" contenteditable>test</noframes>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "enter>" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_ ]*$")))))
(assert (not (str.prefixof "ipt:ale" z)))
(assert (or (str.contains x "</spa") (not (str.prefixof "<cent" y)) (not (<= (str.len y) 67))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{8}[a-zA-Z]{1}$")) (not (= (str.at x 6) "o"))))
(check-sat)
