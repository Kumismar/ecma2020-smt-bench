; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<shadow onbeforecut=""alert(1)"" contenteditable>test</shadow>") (= x "<aside oncut=""alert(1)"" contenteditable>test</aside>") (= x "<figcaption onmouseup=""alert(1)"">test</figcaption>")))
(assert (or (= z "ouseleave=""alert(1)"">test</datalist>") (= z "st</param>") (= z "lert(1)"">test</var>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len z) 34)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w]{4,}$")) (str.contains (str.replace x "e=" """") "at""al")))
(assert (or (not (str.contains z "PT&")) (not (str.prefixof "<fi" y)) (not (= (str.len y) 86))))
(assert (or (= (str.at x 13) """") (not (str.suffixof "/var>" y))))
(assert (str.contains x "nmouseup="))
(check-sat)
