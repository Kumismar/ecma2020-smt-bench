; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog onkeyup=""alert(1)"" contenteditable>test</dialog>") (= x "<code onbeforecopy=""alert(1)"" contenteditable>test</code>") (= x "<img id=x tabindex=1 onfocusin=alert(1)></img>")))
(assert (or (= z "style=""animation-name:x"" onanimationstart=""alert(1)""></footer>") (= z """alert(1)"" contenteditable>test</label>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<code" y))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?!\s*$)[a-zA-Z\s]{2,50}$"))) (str.prefixof """ale" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^yes$")))))
(assert (or (not (= "<dialog onkeyup=""alert(1)"" contentedi""le>test</dialog>style=""animation-name:x"" onanimationstart=""alert(1)""></footer>" (str.replace y "tab" """"))) (not (str.suffixof "ooter>" z))))
(assert (or (= (str.at z 20) "e") (not (str.prefixof "<u dra" y)) (not (= (str.at y 72) "n"))))
(assert (= "able>test" (str.substr y 68 9)))
(assert (or (not (= (str.indexof y "r" 0) 20)) (= "<img id=x tabindex=1 on<b>cusin=alert(1)></img>""alert(1)"" contenteditable>test</label>" (str.replace y "fo" "<b>"))))
(check-sat)
