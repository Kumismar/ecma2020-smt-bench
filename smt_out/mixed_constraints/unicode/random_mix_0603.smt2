; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{1f600}<b\u{10348}r>") (= x "<IMG SRC=javascript:javascript:alert(1)>")))
(assert (or (= z "pe=""audio/wav""></audio>") (= z "=x></em><input autofocus>") (= z "#58;ex&#x2F;*XSS*//*/*/pression(alert(\""XSS\""))'&gt;")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "wa" 0) 16) (>= (str.len z) 44)))
(assert (or (not (str.prefixof "<" y)) (not (str.contains y "ript:alert")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{8}$")))))
(assert (or (= (str.indexof x "scri" 0) 13) (str.contains z "bl")))
(assert (or (str.contains (str.replace y "avas" "alert(1)") "C=jalert(1)crip") (str.contains z "x&#x2F;*XS") (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\s][A-Za-z -]+$"))))
(check-sat)
