; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=""x` `<script>javascript:alert(1)</script>""` `>") (= x "<style>:target {transform: rotate(180deg);}</style><inpu\u{1d400}t id=x style=""transition:transform 2s"" ont\u{1d400}ransitionrun=alert(1)></input>") (= x "<style>:target {color:red;}</style><input id=x style=""transition:color 1s"" ontransitionend=alert(1)></input>")))
(assert (or (= z "ript>") (= z "t(1)"">test</hgroup>") (= z "r onmouseleave=""alert(1)"">test</spacer>")))
(assert (= y (str.++ x z)))
(assert (not (= "<img src=""x` `< pt>javascript:alert(1)</script>""` `>ript>" (str.replace y "scri" " "))))
(assert (or (not (= (str.len x) 130)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{1,2}:[0-9]{2}[.|,][0-9]{2}")))))
(assert (or (not (>= (str.len x) 45)) (str.contains (str.replace z "e" "javascript:") "sjavascript:l") (not (= "x>" (str.substr z 0 9)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{0,3}$"))) (not (= "lert(1)<" (str.substr x 34 8)))))
(check-sat)
