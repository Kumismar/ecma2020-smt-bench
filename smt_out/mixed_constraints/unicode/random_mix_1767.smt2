; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div style=""background:url(/f#&#127;oo/;color:red/*/foo.jpg);"">X") (= x "<nextid onblur=alert(1) tabindex=1 id=x></nextid><input autofocus>") (= x "<iframe draggable=""true"" ondragstart=""alert(1)"">test</iframe>")))
(assert (or (= z ";#x0A;ascript:alert(';XSS';);"";>;") (= z "ere")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<ifram" y)) (not (= """;" (str.substr z 29 2))) (not (str.suffixof "></q>" z))))
(assert (not (= (str.at z 18) "i")))
(assert (not (= "ere" (str.substr z 0 7))))
(assert (or (not (>= (str.len z) 27)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9. ]{1,8}")))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[(\w)|(a-z,A-Z,0-9,\u{430}-\u{44f},\u{410}-\u{42f}\u{401}\u{451},-,_)|(\s)]+$")))
(check-sat)
