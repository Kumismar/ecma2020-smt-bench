; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<multicol ondblclick=""alert(1)"">test</multicol>") (= x "<script\x0A>javascript:alert(1)</script>")))
(assert (or (= z " contenteditable>test</content>") (= z ">") (= z "editable>test</tr>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y ")</s" 0) 30))
(assert (or (not (str.contains y "alert(1")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]+( [a-zA-Z0-9]+)*$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s-]*$")))))
(assert (str.contains x "col>"))
(assert (= (str.indexof z ">" 0) 0))
(assert (or (not (= (str.at y 44) "o")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,7}$")))))
(check-sat)
