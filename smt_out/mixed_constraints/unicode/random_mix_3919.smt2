; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><nextid style=""animation-name:x"" onanimationend=""alert(1)""></nextid>") (= x "<rtc id=x tabindex=1 ondeactivate=alert(1)></rtc><input id=y autofocus>")))
(assert (or (= z "onbefore\u{20000}load=""javascript:javascript:alert(1)""></iframe onbeforeload>") (= z "ck=""alert(1)"">test</embed>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z ">test</em") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[-a-zA-Z0-9]+$"))) (= "onbefore\u{20000}load=""javascript:javascript:alert(1)""> /iframe onbeforeload>" (str.replace z "<" " "))))
(assert (or (not (str.prefixof "ck=""aler" z)) (= " ondea" (str.substr x 20 6))))
(assert (<= (str.len z) 71))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9\s\.\-\+x\(\)\[\]]*$"))))
(assert (or (str.contains z "lert(1") (not (= "st</" (str.substr y 87 4)))))
