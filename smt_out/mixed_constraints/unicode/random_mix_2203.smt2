; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ins onbeforepaste=""alert(1)"" contenteditable>test</ins>") (= x "ABC<div style=""x:\xE2\x80\x89expression(javascript:alert(1)"">DEF") (= x "<rt id=x t\u{20000}abindex=1 ondeactivate=alert(1)></r\u{1d400}t><input id=y autofocus>")))
(assert (or (= z "cript src=javascript:alert(1)>") (= z "t(1)"">test</object>") (= z "contenteditable>test</rt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{9,}$"))) (not (= (str.indexof x "xx" 0) 5))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\(?[1-9]{2}\)?\s?[0-9]{5}-[0-9]{4}$"))) (not (str.suffixof "rt(1)"">DEF" x)) (= (str.at z 20) "<")))
(assert (not (= (str.len z) 2)))
(assert (or (= (str.indexof z "cont" 0) 0) (not (= (str.indexof z "ript " 0) 1)) (str.prefixof "ABC<d" x)))
(assert (not (str.contains (str.replace y "r" " ") "exp essio")))
(check-sat)
