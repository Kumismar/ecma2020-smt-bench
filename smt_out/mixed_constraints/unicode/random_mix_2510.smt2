; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address id=x tabindex=1 onfocusin=alert(1)></address>") (= x "<X OnXxx=1") (= x "<style>@keyframes x{}</style><blockquote style=""animation-name:x"" onanimationend=""alert(1)""></blockquote>")))
(assert (or (= z "script>\x09javascript:alert(1)</script>") (= z "edown=""alert(1)"">test</summary>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "edown=""ale")) (not (str.contains y "al")) (not (str.prefixof "<" x))))
(assert (or (= "x tabind" (str.substr x 12 8)) (str.contains x "X OnXxx")))
(assert (or (= (str.at x 12) "r") (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.{5,}).*"))) (not (str.contains (str.replace y "ary" " ") "umm >"))))
(assert (= (str.at y 67) "o"))
(assert (= (str.indexof z "rt(" 0) 25))
(check-sat)
