; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas dragg\u{1d400}able=""true"" ondragstart=""alert(1)"">test</canvas>") (= x "<select oncontextmenu=""alert(1)"">test</select>")))
(assert (or (= z "dex=1 onfocus=alert(1)></time>") (= z "kbd>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[_a-zA-Z0-9-]+(\.[_a-zA-Z0-9-]+)*(\+[a-zA-Z0-9-]+)?@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*$"))))
(assert (or (= "tmenu=""" (str.substr y 16 7)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-z0-9-]){5,}$"))) (not (= (str.indexof z "bd" 0) 1))))
(assert (or (not (= (str.indexof z ";" 0) 0)) (not (str.prefixof "k" z)) (str.suffixof "lect>kbd>" y)))
(assert (or (= """>t" (str.substr y 31 3)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9 \u{f1}\u{d1}]{1,20}"))) (not (= (str.indexof z "kb" 0) 0))))
(check-sat)
