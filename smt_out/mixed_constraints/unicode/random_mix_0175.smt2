; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd draggable=""true"" ondragenter=""alert(1)"">test</dd>") (= x "<fieldset onpaste=""alert(1)"" contenteditable>test</fieldset>")))
(assert (or (= z "xt>") (= z "frames onfocusout=alert(1) tabindex=1 id=x></noframes><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len y) 131)) (>= (str.len y) 56)))
(assert (= "<dd draggable=""true"" ondragenter=""alert(1)"">tjavascript:dd>frames onfocusout=alert(1) tabindex=1 id=x></noframes><input autofocus>" (str.replace y "est</" "javascript:")))
(assert (or (not (str.contains (str.replace y "le" "") "b=""tr")) (str.in_re z ((_ re.from_regex ecma2020 u) "\s*[a-f\d]{128}\s*"))))
(assert (or (not (= "as" (str.substr x 13 2))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{5c}u4e00-\u{5c}u9fa5]{2,6}$"))))
(assert (or (not (= (str.at y 44) "7")) (not (str.suffixof "xt>" y))))
(assert (or (not (= ")"">t" (str.substr x 41 4))) (not (= (str.indexof z "x" 0) 0))))
(assert (not (str.contains (str.replace z "xt" "<b>") "<b>>")))
(check-sat)
