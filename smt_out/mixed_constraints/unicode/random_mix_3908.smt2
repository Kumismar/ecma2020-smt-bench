; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter onbeforecopy=""alert(1)"" contenteditable>test</meter>") (= x "<img draggable=""true"" ondrag=""alert(1)"">test</img>")))
(assert (or (= z "mg&sol;src=&amp;apos;&amp;apos;onerror=javascript:alert(1)&amp;gt;>"">") (= z "ditable>test</body>") (= z "334957647/1>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y ")"" conten")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{3,}")) (str.suffixof "mg>" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\+36)([0-9]{8,9})$")))))
(assert (not (>= (str.len z) 14)))
(assert (not (= (str.indexof x "8" 0) 47)))
(assert (or (<= (str.len y) 86) (not (str.prefixof "<" x)) (not (str.contains (str.replace y "e>t" "") "lest<"))))
(assert (or (not (= (str.at y 32) "o")) (not (str.contains y "er>di")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z][0-9a-zA-Z]*@{1}[0-9a-zA-Z]+\.(com|net|cn|com\.cn)$")))))
(assert (or (not (= "=" (str.substr z 38 1))) (<= (str.len y) 79)))
(assert (= (str.indexof z "7" 0) 5))
(check-sat)
