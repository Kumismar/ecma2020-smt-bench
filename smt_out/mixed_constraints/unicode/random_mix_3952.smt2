; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn id=x tabindex=1 onbeforedeactivate=alert(1)></dfn><input autofocus>") (= x "<header onmousemove=""alert(1)"">test</header>")))
(assert (or (= z "t:alert(1)"" id=""fuzzelement1"">test</a>") (= z "ydown=""alert(1)"" contenteditable>test</del>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 6) "t")))
(assert (or (not (>= (str.len y) 73)) (str.contains y """ =_")))
(assert (or (not (= (str.at z 27) "t")) (str.prefixof "t:alert" z) (<= (str.len z) 47)))
(assert (str.suffixof "a>" y))
(assert (or (not (= (str.at z 5) "w")) (not (= "st</he" (str.substr x 33 6)))))
(assert (or (= "ert(1)""" (str.substr z 9 7)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*\W).{6,}")))))
(assert (or (= "ct" (str.substr y 79 2)) (not (= "<strike onmouseleave=""alert(1)"">test< strike>" (str.replace x "/" " "))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?!^\s+$)[A-z\u{c0}-\u{17e}\s\-\.]{1,30}")))))
(check-sat)
