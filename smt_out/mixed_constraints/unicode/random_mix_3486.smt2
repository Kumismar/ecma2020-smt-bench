; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<XSS STYLE=""xss:expression(alert('XSS'))"">") (= x "<div draggable=""true"" contenteditable>drag me</div><sup ondragover=alert(1) contenteditable>drop here</sup>") (= x "<noscript onbeforecut=""alert(1)"" contenteditable>test</noscript>")))
(assert (or (= z "end=""alert(1)"">test</strike>") (= z "onmouseout=""alert(1)"">test</ins>") (= z "draggable=""true"" ondrag=""alert(1)"">test</ul>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "strike>" z) (not (= (str.indexof x "d" 0) 1)) (str.contains z "rag=""alert")))
(assert (or (str.suffixof "noscript>" x) (str.contains z "1)"">tes") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((13[0-9])|147|(15[0-35-9])|180|182|(18[5-9]))[0-9]{8}$")))))
(assert (= (str.at x 12) "b"))
(assert (or (= "s" (str.substr y 57 1)) (= (str.len x) 102)))
(check-sat)
