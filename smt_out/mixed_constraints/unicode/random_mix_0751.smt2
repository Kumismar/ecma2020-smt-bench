; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video onmouseenter=""alert\u{1f600}(1)"">test</video>") (= x "<audio oncut=""alert(1)"" contenteditable>test</audio>") (= x "<listing onmousedown=""alert(1)"">test</listing>")))
(assert (or (= z "vascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "di draggable=""true"" ondragenter=""alert(1)"">test</bdi>") (= z "down=""alert(1)"" contenteditable>test</strike>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace z "dra" "") "di gg"))
(assert (not (= "own=""a" (str.substr y 17 6))))
(assert (or (str.contains y "t=""alert") (str.prefixof "vasc" z)))
(assert (or (str.contains y """alert(1") (str.contains x "t(1)"">")))
(assert (= (str.indexof x "st</" 0) 46))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-z0-9](\.?[a-z0-9_-]){0,}@[a-z0-9-]+\.([a-z]{1,6}\.)?[a-z]{2,6}$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9 /]{0,40}")))))
(check-sat)
