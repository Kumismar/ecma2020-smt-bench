; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset onpageshow=alert(1)>") (= x """`'><script>\x3Bjavascript:alert(1)</script>")))
(assert (or (= z "bel\u{10348} draggable=""true"" ondragenter=""alert(1)"">test</label>") (= z "ivate=alert(1)></dialog>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len z) 47))
(assert (or (= (str.at z 13) "r") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w._-]+$")))))
(assert (or (str.contains (str.replace z "a" "") "rgga") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Z\u{5d0}-\u{5ea}a-z ]{1,50}$"))) (= "<frameset onpageshow=alertx" (str.replace x "(1)>" "x"))))
(assert (or (>= (str.len x) 42) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{9}$")))))
(assert (or (not (str.suffixof "cript>" x)) (not (str.contains y "w=alert(1)"))))
(check-sat)
