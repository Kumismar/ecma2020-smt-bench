; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><col style=""animation-name:x"" onanimationstart=""alert(1)""></col>") (= x "<s draggable=""true"" ondragenter=""alert(1)"">test</s>") (= x "<dir onmouseover=""alert(1)"">test</dir>")))
(assert (or (= z "Pt>alert\u{1d400}(1)</sCriPt>") (= z "t(1)></blockquote><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^\D{1,20}$")))
(assert (str.contains x "alert("))
(assert (= (str.at x 26) "e"))
(assert (or (= "<s dxaggable=""true"" ondragenter=""alert(1)"">test</s>Pt>alert\u{1d400}(1)</sCriPt>" (str.replace y "r" "x")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?=\d{2}([-.,\/])\d{2}\1\d{4}$)(?:0[1-9]|1\d|[2][0-8]|29(?!.02.(?!(?!(?:[02468][1-35-79]|[13579][0-13-57-9])00)\d{2}(?:[02468][048]|[13579][26])))|30(?!.02)|31(?=.(?:0[13578]|10|12))).(?:0[1-9]|1[012]).\d{4}$")))))
(assert (or (= "<s draggable=""true"" ondragenter=""aalert(1)(1)"">test</s>" (str.replace x "lert" "alert(1)")) (= (str.at z 30) "o")))
(assert (= (str.at x 27) "n"))
(check-sat)
