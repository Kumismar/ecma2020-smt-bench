; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x18javascript:javascript:alert(1)\u{1f600}"" id=""fuzzelement1"">test</a>") (= x "<h1 draggable=""true"" ondragleave=""alert(1)"">test</h1>")))
(assert (or (= z "d=""javascript:javascript:alert(1)""></svg onunload>") (= z "onblu\u{1d400}r=alert(1) id=x><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "ip")) (<= (str.len z) 73)))
(assert (or (str.contains y "t</h1>") (= (str.at z 15) ")") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s]{3,30}$")))))
(assert (or (not (= "<th onmouseup""lert(1)"">test</th>" (str.replace x "=""a" """"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9A-z/ ,.]){1,}$"))) (= (str.at y 76) "(")))
(assert (or (str.suffixof "load>" y) (not (>= (str.len y) 103))))
(assert (not (= (str.indexof x "ja" 0) 13)))
(check-sat)
