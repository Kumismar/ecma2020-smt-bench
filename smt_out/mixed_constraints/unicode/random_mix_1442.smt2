; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><td onload=alert(1)></td>") (= x "<legend onbeforecut=""alert(1)"" contenteditable>test</legend>")))
(assert (or (= z "d=d><x xmlns='""><iframe onload=alert(2)//'></div>") (= z ":alert(\u{1d400}1)""></body onkeyup>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x ">tes" 0) 46)) (not (str.prefixof ":alert(\u{1d400}1)" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{5}-\d{4}|\d{5}|[A-Z]\d[A-Z] \d[A-Z]\d$")))))
(assert (= (str.at y 46) ">"))
(assert (or (str.contains z "lns='""") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\(?(?!37|96|900|456|555)[2-9](?!11)[0-8][0-9]\)?[-.\s]?(?!555[-.\s]?(?:1212|01)|(\d)\1{2}[-.\s]?\1{4})[2-9](?!11)[0-9]{2}[-.\s]?[0-9]{4}$"))) (not (= (str.indexof y """><" 0) 40))))
(assert (not (str.prefixof "<svg>" y)))
(check-sat)
