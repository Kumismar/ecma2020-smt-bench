; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea oncontextmenu=""alert(1)"">test</textarea>") (= x "<style>:target {color: red;}</style><button id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></button>") (= x "<th onmouseout=""alert(1)"">test</th>")))
(assert (or (= z "bed onmousemove=""alert(1)"">test</embed>") (= z " onmouseout=""alert(1)"">test</body>") (= z ");""><h1>Drop me</h1></div>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<style>:t" x) (not (str.contains z " onmou"))))
(assert (>= (str.len x) 29))
(assert (or (>= (str.len x) 34) (= (str.at z 24) "e") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^EP\d{3,7}|IA\d{3,7}$")))))
(assert (or (str.suffixof ">" x) (not (= "</listing>" (str.substr x 47 10))) (= "sout=ale" (str.substr x 13 8))))
(assert (= (str.indexof z "alert" 0) 17))
(assert (not (= (str.len x) 35)))
(assert (or (not (= "eout=""" (str.substr y 10 6))) (str.prefixof "<textarea" x) (= (str.indexof z "<inp" 0) 54)))
(check-sat)
