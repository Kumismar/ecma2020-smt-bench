; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:\x00expression(javascript:\u{20000}alert(1)"">DEF") (= x "<article onkeyup=""alert(1)"" contenteditable>test</article>")))
(assert (or (= z "(1)></b>") (= z "itable>drag me</div><tfoot ondragover=alert(1) contenteditable>drop here</tfoot>")))
(assert (= y (str.++ x z)))
(assert (= (str.len x) 58))
(assert (str.contains (str.replace z "tfoo" "alert(1)") "iv><alert(1)t"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.{1,}).*"))) (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9.-]+\.[a-z]{2,}$"))))
(assert (or (= (str.at y 123) "p") (not (str.prefixof "ABC" y))))
(assert (str.contains (str.replace z "</b" """") "(1)>"">"))
(assert (or (= (str.indexof y "s>le" 0) 66) (= (str.indexof x "<ar" 0) 0) (not (str.suffixof "tfoot>" y))))
(assert (not (str.prefixof "ABC<div st" x)))
(check-sat)
