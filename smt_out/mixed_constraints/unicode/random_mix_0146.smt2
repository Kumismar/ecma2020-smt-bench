; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame id=x tabindex=1 onactivate=alert(1)></frame>") (= x "<slot oncontextmenu=""alert(1)"">test</slot>")))
(assert (or (= z "com/ogle.com/&quot;&gt;XSS&lt;/A&gt;") (= z "e>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 10) "n")) (= (str.at x 18) "e") (not (= "com" (str.substr z 0 3)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^[-_A-Za-z0-9]+$)"))) (not (= (str.indexof x "e " 0) 5))))
(assert (not (str.prefixof "<slot" y)))
(assert (or (not (str.contains x "CRIPT&")) (str.prefixof "<f" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9 ]+){3,}$")))))
(assert (or (str.suffixof ">" z) (str.contains x "on")))
(check-sat)
