; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><select id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></select>") (= x "<shadow onbeforecopy=""alert(1)"" contenteditable>test</shadow>")))
(assert (or (= z "applet>") (= z "timeupdate=alert(\u{1f600}1)><source src=""validvideo.mp4"" type=""video/mp4""></video>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "ate=alert(")) (not (= (str.at z 6) ">")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{1,}$")))))
(assert (or (str.suffixof "tofocus>p>" y) (= (str.indexof y "</is" 0) 81)))
(assert (or (= "3,83))"">" (str.substr z 0 8)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[_A-Za-z0-9-\\+]+(\\.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(\\.[A-Za-z0-9]+)*(\\.[A-Za-z]{2,})$")))))
(assert (or (not (str.contains (str.replace x """ o" """") "10s""ntran")) (not (= (str.indexof y "><s" 0) 35)) (not (= (str.at y 100) "r"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{13}$"))) (not (str.suffixof """></video>" y))))
(assert (not (= (str.at y 22) "a")))
(check-sat)
