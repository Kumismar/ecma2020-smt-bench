; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee draggable=""true"" ondragstart=""alert(1)"">test</marquee>") (= x "<body onclick=""alert(1)"">test</body>") (= x "<wbr onmouseup=""alert(1)"">test</wbr>")))
(assert (or (= z "ncancel=alert(1)></picture>") (= z "/<</SCRIPT>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 4) "y") (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da} ]{2,50}")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z0-9.-]{2,}$")))))
(assert (or (not (= (str.len y) 74)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9!#$%&'*+\/=?^_`{|}~.-]+@[a-z0-9-]+(\.[a-z0-9-]+)*"))) (= "<wbxouseup=""alert(1)"">test</wbr>" (str.replace x "r onm" "x"))))
(assert (str.contains (str.replace z "/" "alert(1)") "alert(1)<"))
(assert (or (str.contains (str.replace y """>" """") "t(1)""t") (not (= "ncancel=" (str.substr z 0 8)))))
(check-sat)
