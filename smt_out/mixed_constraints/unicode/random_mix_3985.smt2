; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><element id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></element>") (= x "<td onbeforepaste=""alert(1)"" contenteditable>test</td>")))
(assert (or (= z "');var x=\'") (= z "x{}</style><nextid style=""animation-name:x"" onanimationend=""alert(1)""></nextid>")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "[+][0-9]{11}|[+][0-9]{10}|(00)[0-9]{11}|(00)[0-9]{10}|[0][0-9]{9}|[0][0-9]{8}")))
(assert (or (not (str.contains z "r x=\'")) (str.suffixof ">" z)))
(assert (or (= (str.at z 9) "\") (str.contains y "enu ")))
(assert (<= (str.len z) 13))
(assert (or (not (= (str.at z 8) "t")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{0,31}$"))) (str.contains x ">:ta")))
(assert (not (str.suffixof "test</td>" x)))
(assert (or (= "<style>:target {color: red;}</style><el nt id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></element>');var x=\'" (str.replace y "eme" " ")) (not (<= (str.len x) 123))))
(assert (or (= "<style>:target {color: red;}</style><element id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></element>x{}</style><nextid style=""animation-name:x"" onanimationend""ert(1)""></nextid>" (str.replace y "=""al" """")) (str.in_re z ((_ re.from_regex ecma2020 u) "\b[1-9][0-9]{9}\b")) (not (= (str.indexof x "ontra" 0) 79))))
(check-sat)
