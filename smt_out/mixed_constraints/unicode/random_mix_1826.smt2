; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd onbeforecut=""alert(1)"" contenteditable>test</kbd>") (= x "<wbr onclick=""alert(1)"">test</wbr>")))
(assert (or (= z "op=alert(1) contenteditable>drop here</figure>") (= z "nmousemove=""alert(1)"">test</nextid>")))
(assert (= y (str.++ x z)))
(assert (or (= "ecut=""ale" (str.substr x 12 9)) (<= (str.len x) 61) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\w._-]+$")))))
(assert (or (= "contentedi" (str.substr y 66 10)) (= " onbef" (str.substr x 4 6)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9_]{7,15}$")))))
(assert (or (str.prefixof "nmousemove" z) (str.prefixof "<w" x)))
(assert (or (not (str.suffixof "wbr>" x)) (not (str.suffixof "nextid>" y))))
(check-sat)
