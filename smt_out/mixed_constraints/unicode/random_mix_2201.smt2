; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a draggable=""true"" ondragenter=""alert(1)"">test</a>") (= x "<element onblur=alert(1) tabindex=1 id=x></element><input autofocus>") (= x "<ruby onbeforepaste=""alert(1)"" contenteditable>test</ruby>")))
(assert (or (= z ">") (= z "get {color: red;}</style><b id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></b>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "x=1 i" 0) 32))
(assert (str.suffixof ">" z))
(assert (or (not (= "<element onblur=ert(1) tabindex=1 id=x></element><input autofocus>>" (str.replace y "al" ""))) (not (= ">" (str.substr z 0 3))) (str.suffixof ";" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9!-/:-@\u{a5}[-`{-~]+$"))))
(assert (= "<body oniut=javascript:alert(1)><input autofocus>onpaste=""alert(1)"" contenteditable>test</spacer>" (str.replace y "np" "")))
(assert (str.prefixof "<a" x))
(check-sat)
