; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><slot style=""animation-name:x"" onanimationend=""alert(1)""></slot>") (= x "<style>@keyframes x{}</style><iframe style=""animation-name:x"" onanimationstart=""alert(1)""></iframe>") (= x "<div/style=""width:expression(confirm(1))"">X</div> {IE7}")))
(assert (or (= z "lick=""alert(1)"">test</meta>") (= z "tofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 29) "t") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((?!\blose weight\b|\bfuck\b|\bsex\b|\bsexy\b|\bpersedia2022\b).)*$"))) (not (= "<div/styl""=""width:expression(confirm(1))"">X</div> {IE7}" (str.replace x "e" """")))))
(assert (= "(1)" (str.substr z 11 3)))
(assert (or (not (str.prefixof " o" z)) (not (= "ame" (str.substr y 95 3)))))
(assert (or (>= (str.len z) 7) (= (str.len y) 82)))
(check-sat)
