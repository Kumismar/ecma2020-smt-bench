; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var onbeforecut=""alert(1)"" contenteditable>test</var>") (= x "<output onmouseout=""alert(1)"">test</output>")))
(assert (or (= z ")"" contenteditable>test</mark>") (= z "ver=""alert(document.cookie)""></IFRAME>123</h1>")))
(assert (= y (str.++ x z)))
(assert (= "r=""al" (str.substr z 2 5)))
(assert (or (not (= "or" (str.substr x 10 2))) (= "e" (str.substr z 7 1))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[^@]+@[^\.]+\..+$"))) (= (str.indexof y "t>)""" 0) 41) (not (= (str.len x) 43))))
(assert (or (not (= (str.indexof x "e" 0) 8)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z-\s]+$"))) (str.prefixof "<var on" x)))
(assert (not (str.contains x "st</v")))
(check-sat)
