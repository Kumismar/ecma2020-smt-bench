; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i onbeforecut=""alert(1)"" contenteditable>test</i>") (= x "<input onmouseenter=""alert(1)"">test</input>") (= x "<button oncopy=""alert(1)"" contenteditable>test</button>")))
(assert (or (= z "st</optgroup>") (= z "u=""alert(1)"">test</style>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 5) "p")) (not (str.contains y "er=""a"))))
(assert (not (= (str.len y) 82)))
(assert (or (str.suffixof "est</i>" x) (not (= "butt" (str.substr y 48 4)))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^LC\d{3,7}$"))))
(assert (or (not (str.suffixof "script>" y)) (not (= (str.at y 31) "t")) (not (str.contains (str.replace x "a" "") "r=""lert"))))
(assert (or (not (str.contains (str.replace y "gro" " ") "opt u")) (not (= (str.indexof y "t" 0) 13))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{30a1}-\u{30f3}|\u{30fc}]+$")))
(check-sat)
