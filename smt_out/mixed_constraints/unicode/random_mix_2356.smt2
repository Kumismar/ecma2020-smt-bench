; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><ul id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></ul>") (= x "<label\u{10348} draggable=""true"" ondragenter=""alert(1)"">test</label>")))
(assert (or (= z "le>test</tt>") (= z "'XSS')"">") (= z "rt(1)""></br>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 9) "t") (= "S')"">" (str.substr z 3 8))))
(assert (or (not (= (str.at x 36) "c")) (= "<label\u{10348} <b>ggable=""true"" ondragenter=""alert(1)"">test</label>" (str.replace x "dra" "<b>"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z]+(?:\s[a-zA-Z]+)+$"))))
(assert (or (= (str.indexof x """ on" 0) 23) (= "<" (str.substr z 7 1))))
(assert (not (str.contains (str.replace y " on" "<b>") "ess<b>dblc")))
(check-sat)
