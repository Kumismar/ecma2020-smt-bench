; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=&#106;&#97;&#118;&#97;&#115;&#99;&#114;&#105;&#112;&#116;&#58;&#97;&#108;&#101;&#114;&#116;&#40;") (= x "<div draggable=""true"" contenteditable>drag me</div><footer ondrop=alert(1) contenteditable>drop here</footer>")))
(assert (or (= z "ScRiPt:alert('XSS')>") (= z "blur=alert(1) tabindex=1 id=x></content><input autofocus>") (= z "(1)></dl>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "(1)><" "x") "x/dl>")) (not (= (str.len z) 57))))
(assert (str.suffixof "#116;&#40;" x))
(assert (= (str.indexof z "S" 0) 0))
(assert (or (= "<fo" (str.substr y 51 3)) (= "dr" (str.substr y 91 2)) (not (str.suffixof "l>" z))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^([0-9A-z /-]){5,}$")) (not (= (str.at x 19) "s")) (str.prefixof "<IMG SR" x)))
(assert (or (not (= (str.indexof x "dra" 0) 5)) (str.suffixof "us>" y)))
(assert (not (= (str.indexof y "9;&" 0) 40)))
(check-sat)
