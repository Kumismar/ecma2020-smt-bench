; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><dt style=""animation-name:x"" onanimationstart=""alert(1)"">\u{10348}<\u{1f4a9}/dt>") (= x "<col onmousedown=""alert(1)"">test</col>")))
(assert (or (= z "rt(1)"">test</a\u{1d400}rea>") (= z "seover=""alert(1)"">test</marquee>") (= z ">javascript:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "uee>" z)))
(assert (or (not (>= (str.len y) 108)) (not (str.contains (str.replace z ")"">t" """") "(1""e")) (str.contains y "le><dt sty")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{1,7}$"))))
(assert (<= (str.len z) 21))
(assert (not (str.contains (str.replace x "w" " ") "o n=""a")))
(assert (= (str.indexof y "n" 0) 6))
(assert (or (not (str.contains x "><dt s")) (str.suffixof "<\u{1f4a9}/dt>" x)))
(check-sat)
