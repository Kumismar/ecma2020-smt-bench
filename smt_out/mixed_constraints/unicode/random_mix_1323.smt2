; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i onkeydown=""alert(1)"" contenteditable>test</i>") (= x "<s id=x tabindex=1 onfocusin=alert(1)></s>")))
(assert (or (= z "t.ini"">]><foo>&xee;</foo>") (= z "ssion(alert('XSS'))>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 69) "\")) (not (= "ed" (str.substr y 35 2)))))
(assert (= "<s id=x tabindex=1 onfocusin=alex1)></s>ssion(alert('XSS'))>" (str.replace y "rt(" "x")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{c4}\u{e4}\u{d6}\u{f6}\u{dc}\u{fc}\u{df} \-]{3,20}$"))))
(assert (or (not (= "ert(" (str.substr x 16 4))) (str.prefixof "s" z) (= """al" (str.substr x 21 3))))
(assert (or (= (str.len x) 42) (= (str.at x 37) ">") (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-z ]*$"))))
(assert (or (str.prefixof "<s id=x t" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z \u{c9}\u{c8}\u{ca}\u{cb}\u{c7}\u{c0}\u{e9}\u{e8}\u{ea}\u{eb}\u{e7}\u{e0}'-]{2,}$"))) (not (>= (str.len z) 14))))
(check-sat)
