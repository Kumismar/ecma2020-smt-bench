; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li onbeforepaste=""alert(1)"" contenteditable>test</li>") (= x "<IMG SRC=x onhashchange=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "true"" contenteditable>drag me</div><main ondrop=alert(1) contenteditable>drop here</main>") (= z "000060")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "00006" " ") " 0") (= (str.indexof z "00006" 0) 0)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z']+(\s+[a-zA-Z']+)+$"))) (not (= (str.at z 0) "0")) (not (= "bl" (str.substr y 41 2)))))
(assert (or (not (str.contains (str.replace x "te" """") "pas""=")) (>= (str.len x) 53) (not (= (str.at y 63) "="))))
(assert (not (= (str.indexof y "ere<" 0) 142)))
(check-sat)
