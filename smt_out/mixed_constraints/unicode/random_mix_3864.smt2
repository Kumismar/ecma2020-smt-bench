; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<big onbeforepaste=""alert(1)"" contenteditable>test</big>") (= x "<picture onmousedown=""alert(1)"">test</picture>") (= x "<;SCRIPT a="";>';>""; SRC="";http://ha.ckers.org/xss.js"";>;<;/SCRIPT>;")))
(assert (or (= z "d>") (= z "t</applet>")))
(assert (= y (str.++ x z)))
(assert (not (= "d>" (str.substr z 0 3))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z][0-9a-zA-Z]*@{1}[0-9a-zA-Z]+\.(com|net|cn|com\.cn)$"))) (= (str.at z 5) "p")))
(assert (not (str.suffixof "big>" x)))
(assert (or (not (str.suffixof "re>" x)) (= ">" (str.substr z 1 10))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[^@]+@[^@\.]+\.[^@]+$")) (not (= (str.at x 2) "e"))))
(assert (= (str.at z 1) "<"))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-Z0-9]{5}-){6}[A-Z0-9]{5}$"))))
(check-sat)
