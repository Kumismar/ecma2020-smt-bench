; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body id=x tabindex=1 onfocusin=alert(1)></body>") (= x "<nextid onmouseleave=""alert(1)"">test</nextid>")))
(assert (or (= z "=""alert(1)"">test</tt>") (= z "und>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z ")"">t" """") "t(1""es")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9\s-]{2,2}")))))
(assert (or (>= (str.len z) 18) (not (str.prefixof "<body id=" x)) (not (str.suffixof "t</tt>" z))))
(assert (not (>= (str.len z) 17)))
(assert (or (not (= "o" (str.substr y 7 1))) (not (= (str.indexof x "d on" 0) 6))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[a-zA-Z0-9]+([\-\.]{1}[a-zA-Z0-9]+)*\.[a-z]{2,5}(:[0-9]{1,5})?(\/.*)?$"))))
(check-sat)
