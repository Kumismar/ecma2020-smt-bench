; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b oncopy=""alert(1)"" contenteditable>test</b>") (= x "<track onmouseup=""alert(1)"">test</track>")))
(assert (or (= z "/mark>") (= z "list>") (= z "1)></summary>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "/m" z) (= "<b oncopy=""alert(1)"" contentedi ble>test</b>" (str.replace x "ta" " ")) (str.contains (str.replace x "k" "<b>") "rac<b> onm")))
(assert (or (not (str.contains z "mark>")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{30a1}-\u{30f6}\u{30fc}]*$"))) (not (= "input id=y" (str.substr y 64 10)))))
(assert (or (not (= "<track onmouseup=""alert(alert(1)>test</track>list>" (str.replace y "1)""" "alert(1)"))) (not (= (str.indexof y "l" 0) 12)) (not (= (str.at y 27) ">"))))
(assert (str.prefixof "<" y))
(check-sat)
