; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x11javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<command onblur=alert(1) tabindex=1 id=x></command><input autofocus>")))
(assert (or (= z "/marquee>") (= z "ck=""alert(1)"">test</textarea>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len x) 71)))
(assert (or (= "ipt:javas" (str.substr x 20 9)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\w.!#$%&?*+/=?^_`{|}~-]+@[\w-]+(?:\.[\w-]+)*$")))))
(assert (or (not (str.contains (str.replace y ">ck" " ") "focus =")) (= " a" (str.substr y 57 2))))
(assert (or (str.suffixof "ea>" y) (not (str.contains z ")"">test</t"))))
(assert (or (not (str.prefixof "<a h" y)) (str.contains z "marquee>")))
(check-sat)
