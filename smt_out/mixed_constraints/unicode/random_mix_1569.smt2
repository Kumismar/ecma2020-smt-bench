; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 oncopy=""alert(1)"" contenteditable>test</h1>") (= x "&lt;XSS STYLE=\""behavior&#58; url(xss&#46;htc);\""&gt;") (= x "<template onmouseover=""alert(1)"">test</template>")))
(assert (or (= z "-com&#58;time\""&gt;") (= z "ntenteditable>test</meta>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "a>" (str.substr z 23 7))) (not (str.contains x "teditable>")) (not (= (str.indexof x "46" 0) 39))))
(assert (not (= "-co#58;time\""&gt;" (str.replace z "m&" ""))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[^\s]+(\s.*)?$")) (= (str.indexof y "cont" 0) 22)))
(assert (or (not (= "<template onmouseover=""alert(1)"">testalert(1)plate>ntenteditable>test</meta>" (str.replace y "</tem" "alert(1)"))) (= (str.indexof z "m&#" 0) 3)))
(check-sat)
