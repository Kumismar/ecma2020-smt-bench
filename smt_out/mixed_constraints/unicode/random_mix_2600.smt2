; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#34;&#62;<h1/onmouseover='\u{5c}u0061lert(1)'>%00") (= x "<head onmousemove=""alert(1)"">test</head>")))
(assert (or (= z "table>drag me</div><plaintext ondragover=alert(1) contenteditable>drop here</plaintext>") (= z " code]);"">") (= z "contenteditable>test</blockquote>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x """aler" 0) 18) (str.suffixof "</head>" x)))
(assert (or (not (str.prefixof "&#34;&#" x)) (not (str.contains y "op"))))
(assert (or (not (>= (str.len z) 7)) (not (str.contains (str.replace y "g" "<b>") "a<b> ")) (not (= (str.at z 13) "<"))))
(assert (or (str.contains z "rt(") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\([0-9]{3}\)|[0-9]{3}-?)[0-9]{3}-?[0-9]{4}$"))) (str.contains x "\u{5c}u")))
(assert (not (= (str.at y 30) "e")))
(check-sat)
