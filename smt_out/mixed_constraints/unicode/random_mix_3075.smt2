; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd onmousemove=""alert(1)"">test</kbd>") (= x "<dir onmouseup=""alert(1)"">test</dir>")))
(assert (or (= z "teditable>drag me</div><style ondragover=alert(1) contenteditable>drop here</style>") (= z "st</sub>") (= z "st</body>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/style>" z)) (str.prefixof "<dir onmo" x) (not (str.contains z ">d"))))
(assert (or (str.prefixof "<kbd " x) (not (= "ascrip" (str.substr x 68 6)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(91|92|93|96)\d{7}$"))) (str.in_re x ((_ re.from_regex ecma2020 u) "^((?!nikitagareev22iqn)(?!pashastepanov2fgq1r)(?!karleenkla5udj).)*$"))))
(assert (or (not (<= (str.len x) 36)) (= (str.indexof x "ppl" 0) 2)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[-0-9]+$"))))
(assert (or (= (str.indexof x "s" 0) 10) (str.contains y "ous") (not (str.contains (str.replace x "test" "javascript:") "1)"">javascript:</dir"))))
(assert (not (str.prefixof "<kbd" x)))
(check-sat)
