; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param onkeyup=""alert(1)"" contenteditable>test</param>") (= x "<style>:target {color: red;}</style><form id=x style=""transition\u{1d400}:color 10s"" ontransitioncancel=alert(1)></form>") (= x "<ins onfocusout=alert(1) tabindex=1 id=x></ins><input autofocus>")))
(assert (or (= z "ble>test</dir>") (= z "usin=alert(1\u{1f600})></content>") (= z "nkeyup=""\u{1f600}alert(1)"" conten\u{10348}teditable>test</tbody>")))
(assert (= y (str.++ x z)))
(assert (or (= "t<" (str.substr z 7 2)) (not (str.contains x " o")) (not (= (str.at z 1) ">"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-2][0-9]|(3)[0-1])(-)(((0)[0-9])|((1)[0-2]))(-)\d{4}$"))) (not (= "ble>test<<b>r>" (str.replace z "/di" "<b>"))) (= (str.len y) 125)))
(assert (not (= (str.at y 67) "n")))
(assert (or (str.suffixof "/dir>" z) (= (str.indexof z "ble>t" 0) 0) (not (= "/dir" (str.substr z 9 4)))))
(assert (not (= "1) tabi" (str.substr x 22 7))))
(check-sat)
