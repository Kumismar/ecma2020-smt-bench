; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onkeyup=""alert(1)"" contenteditable>test</rtc>") (= x "<figcaption onmouseup=""alert(1)"">test</figcaption>") (= x "<title id=x tabindex=1 onfocusin=alert(1)></title>")))
(assert (or (= z "tyle><meta id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></meta>") (= z "st</col>") (= z "id>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 37) "/") (>= (str.len z) 1) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9]{2})(-[0-9]{3})$")))))
(assert (or (str.contains y "up=""alert(") (str.suffixof "gcaption>" x) (not (= (str.at y 28) "u"))))
(assert (not (str.contains y "le>tes")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[A-Za-z])[A-Za-z\s]*")) (str.prefixof "<rtc " y) (not (str.suffixof "n>st</col>" y))))
(assert (or (not (= (str.indexof z "1)" 0) 12)) (str.suffixof "caption>" x) (= (str.indexof y "figca" 0) 1)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{105}\u{107}\u{106}\u{119}\u{142}\u{141}\u{144}\u{143}\u{f3}\u{d3}\u{15b}\u{15a}\u{17c}\u{17b}\u{17a}\u{179}\-]{3,20}$")))
(check-sat)
