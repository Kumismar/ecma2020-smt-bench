; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<multicol ondblclick=""alert(1)"">test</multicol>") (= x "<li onmousemove=""alert(1)"">test</li>") (= x "<u id=x tabindex=1 onbeforedeactivate\u{1f4a9}=alert(1)></u><in\u{1f4a9}put autofocus>")))
(assert (or (= z "enu id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></menu>") (= z "ctivate=alert(1)></b><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "nu " "javascript:") "ejavascript:id")) (= (str.indexof z "cti" 0) 0)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{9,12}"))) (str.suffixof ">" y) (not (<= (str.len z) 74))))
(assert (= "<li onmoujavascript:emove=""alert(1)"">test</li>" (str.replace x "s" "javascript:")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([\w\.\-]+)@([\w\-]+)((\.(\w){2,3})+)$"))))
(assert (or (not (<= (str.len y) 153)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z-\s]+$")))))
(assert (not (str.contains (str.replace z " on" "x") " 10s""xtrans")))
(check-sat)
