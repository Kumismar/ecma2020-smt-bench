; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><ul id=x style=""transition:color 1s"" ontransitionend=alert(1)></ul>") (= x "<marquee id=x tabindex=1 onfocus=alert(1)></marquee>")))
(assert (or (= z "us=alert(1)></title>") (= z "}</style><nav style=""animation-name:x"" onanimationend=""alert(1)""></nav>") (= z "ble>test</b>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<s" y))
(assert (not (= (str.indexof y "rqu" 0) 3)))
(assert (or (str.prefixof "<svg\u{1f600}><" y) (not (str.prefixof "us" z)) (= (str.at x 27) "<")))
(assert (or (= (str.len y) 98) (not (= (str.at z 6) "s"))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^0\d{1,5}[ -]?\d{1,4}[ -]?\d{3,4}$")))
(check-sat)
