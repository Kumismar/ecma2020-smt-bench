; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr draggable=""true"" ondragend=""alert(1)"">test</abbr>") (= x "<\u{10348}vid\u{1f4a9}eo autoplay onplay=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= x "<;LINK REL="";stylesheet""; HREF="";http://ha.ckers.org/xss.css"";>;")))
(assert (or (= z "ert(1)></div>") (= z "</dd>") (= z ".org/xss.js""\u{1f600}></SCRIPT>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "</dd>")) (str.in_re y ((_ re.from_regex ecma2020 u) "^[^!@#$&%*+=]+$"))))
(assert (or (= (str.indexof y "o" 0) 22) (str.contains x "a.ckers.or")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{4,15}$"))))
(assert (= ";LIN" (str.substr x 1 4)))
(assert (= "<abbr draggable=""true"" ondragend=""alert(1)"">test</abbr>ert(1x</div>" (str.replace y ")>" "x")))
(assert (not (= (str.indexof x "o a" 0) 7)))
(check-sat)
