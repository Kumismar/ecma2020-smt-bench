; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><applet ondrop=alert(1) contenteditable>drop here</applet>") (= x "<title draggable=""true"" ondragenter=""alert(1)"">test</title>")))
(assert (or (= z "st</style>") (= z "ript onbeforecut=""alert(1)"" contenteditable>test</script>") (= z "ript:alert(&amp;quot;XSS&amp;quot;)&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "</s>" y)) (not (= "e ydown=""alert(1)"" contenteditable>test</strike>" (str.replace z " onke" " "))) (str.prefixof "<titl" x)))
(assert (or (not (= (str.indexof x "><s" 0) 42)) (>= (str.len x) 73) (not (str.suffixof "ement>" z))))
(assert (or (not (= (str.at z 29) "o")) (not (str.prefixof "<div " y))))
(assert (or (not (= "st</title>" (str.substr y 49 10))) (not (str.suffixof "yle>" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{406}\u{456}\u{407}\u{457}\u{404}\u{454}\s]+$")))))
(check-sat)
