; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u onbeforepaste=""alert(1)"" contenteditable>test</u>") (= x "<ruby id=x tabindex=1 ondeactivate=alert(1)></ruby><input id\u{1f600}=y\u{20000} autofocus>")))
(assert (or (= z "=""alert(1)"" contenteditable>test</command>") (= z "aggable=""true"" ondragstart=""alert(1)"">test</area>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<" x)))
(assert (str.contains x "y\u{20000} "))
(assert (or (str.contains (str.replace z "rt(" "") "=""ale1)"" ") (str.in_re y ((_ re.from_regex ecma2020 u) "^([+])(9{1})(1{1})(\d{10})|(\d{10})$")) (str.suffixof ">" z)))
(assert (not (= "aggable=""true"" ondragstart=xert(1)"">test</area>" (str.replace z """al" "x"))))
(assert (>= (str.len y) 156))
(assert (or (not (= "u>" (str.substr x 50 8))) (str.prefixof "<ruby" x)))
(assert (= (str.len y) 94))
(assert (not (= (str.len z) 42)))
(check-sat)
