; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<! foo=""[[[x]]""><x foo=""]foo><script>alert(91)</script>"">") (= x "<blink onmousemove=""alert(1)"">test</blink>")))
(assert (or (= z "keyup=""alert(1)"" contenteditable>test</marquee>") (= z "('XSS')>") (= z "down=""alert(1)"">test</svg>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len z) 40)) (not (str.contains (str.replace y "[[[" "") "oo=""x]]"""))))
(assert (or (str.contains (str.replace y "t" """") "scrip"":java") (not (str.suffixof "utofocus>" x)) (not (str.suffixof ")>" z))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z ]{0,24}")))
(assert (or (= (str.indexof y "edi" 0) 41) (= (str.at x 42) "(") (= (str.at z 25) "d")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{3}[0-9]{3}[0-9]{3}[0-9]{2}|[0-9]{3}[0-9]{3}[0-9]{3}[0-9]{3}[0-9]{2}|[0-9]{3}.[0-9]{3}.[0-9]{3}-[0-9]{2}|[0-9]{3}.[0-9]{3}.[0-9]{3}/[0-9]{3}-[0-9]{2}")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{4}[\-\/\s]?((((0[13578])|(1[02]))[\-\/\s]?(([0-2][0-9])|(3[01])))|(((0[469])|(11))[\-\/\s]?(([0-2][0-9])|(30)))|(02[\-\/\s]?[0-2][0-9]))$"))) (= (str.at z 15) ">")))
(assert (or (not (str.contains (str.replace x "t" """") "inpu"" on")) (str.suffixof "lert(1)"">" y)))
(check-sat)
