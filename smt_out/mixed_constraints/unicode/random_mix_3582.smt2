; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><dt onload=alert(1)></dt>") (= x "<;IMG SRC=JaVaScRiPt\u{1d400}:alert(';XSS';)>;") (= x "<style>:target {transform: rotate(180deg);}</style><head id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></head>")))
(assert (or (= z "</select>") (= z "r=confirm``> --!>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "';XSS';)>;" x)) (not (str.contains x "alert(("""))))
(assert (or (= (str.at z 9) " ") (not (str.contains (str.replace x "1)" "alert(1)") "(alert(1) "))))
(assert (or (= (str.at y 23) "r") (not (str.contains z "``> -"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-z][a-zA-Z ]*$|^[\u{5c}u0600-\u{5c}u06FF][\u{5c}u0600-\u{5c}u06FF ]*$"))) (not (= (str.at y 26) "t")) (str.in_re y ((_ re.from_regex ecma2020 u) "\+\d{1}\s\(\d{3}\)\s\d{3}-\d{4}"))))
(assert (not (= (str.indexof y "</dt>" 0) 25)))
(check-sat)
