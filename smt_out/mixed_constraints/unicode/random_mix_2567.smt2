; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ma\u{20000}p ondblclick=""alert(1)"">test</map>") (= x "<html oncut=""alert(1)"" contenteditable>test</html>")))
(assert (or (= z "=""animation-name:x"" onanimationend=""alert(1)""></colgroup>") (= z "v>") (= z "?>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 7) "n")) (str.in_re y ((_ re.from_regex ecma2020 u) "^(\d){3}(-)(\d){8}$"))))
(assert (or (= (str.indexof y "1)" 0) 24) (= "?alert(1)" (str.replace z ">" "alert(1)"))))
(assert (or (= (str.len z) 2) (str.prefixof "<htm" x) (str.in_re y ((_ re.from_regex ecma2020 u) "^00[0-9]{1,4}[-\s0-9]{6,15}$"))))
(assert (<= (str.len z) 11))
(check-sat)
