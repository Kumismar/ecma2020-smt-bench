; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><sup id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></sup>") (= x "<script src=""data:&comma;alert(1)//") (= x "<big draggable=""true"" ondragend=""alert(1)"">test</big>")))
(assert (or (= z "le>test</track>") (= z "re</script>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y "ragga" "alert(1)") " dalert(1)ble") (str.suffixof "st</track>" y) (not (= (str.at y 16) "t"))))
(assert (or (not (str.prefixof "<big d" y)) (>= (str.len y) 67)))
(assert (= "cript" (str.substr z 5 5)))
(assert (not (= (str.at z 0) "r")))
(assert (or (str.contains z "pt") (not (= (str.at x 121) "u")) (str.in_re y ((_ re.from_regex ecma2020 u) "[A-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df} | \b | -]{2,20}"))))
(assert (= "sf" (str.substr y 20 2)))
(check-sat)
