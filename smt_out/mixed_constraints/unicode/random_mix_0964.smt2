; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption draggable=""true"" ondrag=""alert(1)"">test</caption>") (= x "<acronym onkeydown=""alert(1)"" contenteditable>test</acronym>")))
(assert (or (= z """ onmouseover=""prompt(1)"">") (= z "gend=""alert(1)"">test</hr>") (= z "ert(1)></slot>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z "><inp" 0) 45))
(assert (or (str.contains y """ ond") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?!.*gmail|.*outlook|.*yahoo|.*hotmail).*$")))))
(assert (or (= "ragg" (str.substr x 10 4)) (not (str.suffixof "{()}" y))))
(assert (or (not (str.prefixof "<" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{3}-\d{2}-\d{4}$"))) (str.prefixof "<vi" x)))
(assert (not (str.prefixof "<capti" y)))
(assert (or (not (= (str.at z 9) "s")) (not (str.contains (str.replace y "down=" """") "y""""ale"))))
(assert (or (not (str.suffixof ")></slot>" y)) (str.contains y " drag")))
(assert (or (not (= (str.at z 13) ">")) (not (str.contains x "own"))))
(check-sat)
