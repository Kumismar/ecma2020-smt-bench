; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea id=x tabindex=1 onbeforeactivate=alert(1)></textarea>") (= x "<hr draggable=""true"" ondragleave=""alert(1)"">test</hr>")))
(assert (or (= z "t(1)<;/script>;") (= z "dress oncontextmenu=""alert(1)"">test</address>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 3) ")") (= (str.at z 7) "n") (not (<= (str.len y) 69))))
(assert (str.prefixof "<textarea" x))
(assert (or (not (= (str.indexof y "=a" 0) 42)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{1}-\d{3}-\d{3}-\d{2}-\d{2}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[9|6]{1}[0-9]{8}")))))
(assert (= (str.at y 7) "g"))
(assert (str.contains x " draggable"))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "\b[\w\.-]+@((?!gmail|yahoo|outlook|aol|mail|protonmail|icloud|gmx|yandex).)[\w\.-]+\.\w{2,4}\b")) (str.contains (str.replace z ";/sc" "x") "(1)<xript>") (str.contains y "te=al")))
(assert (not (= "rt(1)></te" (str.substr x 46 10))))
(check-sat)
