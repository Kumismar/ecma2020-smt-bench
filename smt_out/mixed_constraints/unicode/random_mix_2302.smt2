; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image id=x tabindex=1 onbeforeactivate=alert(1)></image>") (= x "<div draggable=""true"" contenteditable>drag me</div><q ondrop=alert(1) contenteditable>drop here</q>") (= x "<data onmouseover=""alert(1)"">test</data>")))
(assert (or (= z "t</dd>") (= z """alert(1)"" contenteditable>test</noembed>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z\d]{6,}$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 './,]+$"))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))))
(assert (or (not (= "<sx onblur=alert(1) tabindex=1 id=x></small><input autofocus>alert(1)"">test</nav>" (str.replace y "mall" "x"))) (not (= (str.at y 59) "/")) (<= (str.len y) 156)))
(assert (or (not (>= (str.len z) 1)) (= "dd" (str.substr z 3 2))))
(check-sat)
