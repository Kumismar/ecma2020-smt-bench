; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{2018}; alert(1);") (= x "<abbr draggable=""true"" ondragleave=""alert(1)"">test</abbr>") (= x "<select draggable=""true"" ondragstart=""alert(1)"">test</select>")))
(assert (or (= z "ript>") (= z "=""alert(1)"">test</b>") (= z "et {transform: rotate(180deg);}</style><param id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></param>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 40) ")")) (str.prefixof "et " z)))
(assert (or (not (str.prefixof "e" z)) (= "t>" (str.substr z 3 8)) (= (str.indexof y "sel" 0) 1)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}'][a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}-' ]+[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}']?$"))) (str.prefixof "<div dragg" y)))
(assert (str.contains x "alert("))
(assert (or (str.contains x "draggab") (not (>= (str.len x) 32))))
(check-sat)
