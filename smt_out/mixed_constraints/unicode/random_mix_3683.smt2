; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "top['al\145rt'](1)") (= x "<ruby onblur=alert(1) tabindex=1 id=x></ruby><input autofocus>") (= x "<x onmousemove=alert(1)>hover this!")))
(assert (or (= z "id=x tabindex=1 onactivate=alert(1)></tt>") (= z "n>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z ">" "<b>") "n<b>") (not (= "n<b>" (str.replace z ">" "<b>")))))
(assert (= "top['l\145rt'](1)" (str.replace x "a" "")))
(assert (or (not (str.prefixof "n" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{1,10}")))))
(assert (or (str.suffixof ">" z) (not (str.suffixof "autofocus>" x))))
(assert (= (str.len x) 35))
(check-sat)
