; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><data id=x style=""transition:color 1s"" ontransitionend=alert(1)></data>") (= x "<<SCRIPT>alert(\u{201c}XSS\u{201d});//<</SCRIPT>") (= x "<tfoot onbeforecopy=""alert(1)"" contenteditable>test</tfoot>")))
(assert (or (= z "nimation-name:x"" onanimationend=""alert(1)""></hgroup>") (= z "font-family:'foo&#10;;color:red;';"">XXX")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 33) (not (str.contains (str.replace x "eset" "<b>") "fram<b> ")) (not (str.contains z "=""alert(1)"))))
(assert (= (str.indexof x "a" 0) 9))
(assert (= """alert(1)" (str.substr x 74 9)))
(assert (or (not (= (str.len y) 86)) (not (str.contains z "#10;;c"))))
(assert (or (>= (str.len z) 37) (= "ascr" (str.substr z 18 4))))
(assert (or (not (= "-nam" (str.substr z 8 4))) (= (str.indexof y "sty" 0) 1)))
(assert (or (not (str.suffixof "foot>" x)) (not (= (str.indexof x "IPT" 0) 5)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]{6,18}$")))))
(assert (not (str.suffixof "T>" x)))
(check-sat)
