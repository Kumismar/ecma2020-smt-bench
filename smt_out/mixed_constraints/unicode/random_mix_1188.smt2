; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><img src=x onerror=javascript:alert((""A""))>") (= x "<IMG SRC=x onkeyup=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "1) contenteditable>drop here</ul>") (= z "</sup>") (= z "t(1)"">test</meter>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/meter>" z)) (not (str.contains z "t</met"))))
(assert (not (= (str.at y 54) ")")))
(assert (or (str.suffixof "</sup>" y) (not (str.contains (str.replace y "nerro" "") "=x or"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "([a-zA-Z]{4}[a-zA-Z]{2}[a-zA-Z0-9]{2}([a-zA-Z0-9]{3})?)"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{9}")) (not (= (str.indexof y "lert" 0) 21))))
(assert (not (= (str.indexof y "n" 0) 12)))
(assert (or (str.contains y "test</") (str.suffixof ")>" x) (not (= "mChar" (str.substr x 36 5)))))
(assert (or (not (<= (str.len z) 22)) (str.in_re z ((_ re.from_regex ecma2020 u) "integer")) (>= (str.len x) 35)))
(check-sat)
