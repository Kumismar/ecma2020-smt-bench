; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time oncontextmenu=""alert(1)"">test</time>") (= x "<a onmouseover=""alert(1)"">test</a>")))
(assert (or (= z "rame onmouseleave=""a\u{1f600}lert(1)"">test</iframe>") (= z "on(alert(';XSS';));"";>;") (= z "test</q>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) ".{2,30}$"))))
(assert (or (not (str.contains (str.replace z "\u{1f600}l" """") "=""a""ert")) (not (= (str.at x 40) "e"))))
(assert (str.suffixof "22>" y))
(assert (or (not (str.contains x ">test</")) (not (= (str.at y 34) "r")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.{6}$")))))
(assert (= (str.len x) 42))
(check-sat)
