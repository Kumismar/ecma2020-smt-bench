; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><summary id=x style=""transition:color 1s"" ontransitionend=alert(1)></summary>") (= x "<cite onbeforepaste=""alert(1)"" contenteditable>test</cite>") (= x "<style>:target {color:red;}</style><var id=x style=""transition:color 1s"" ontransition\u{20000}end=alert(1)></var>")))
(assert (or (= z "id=x tabindex=1 onbeforeactivate=alert(1)></footer>") (= z "pression(alert(';XSS';))"";>;")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 24) """")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(13[0-9]|14[579]|15[0-3,5-9]|16[6]|17[0135678]|18[0-9]|19[89])\d{8}$")))))
(assert (= "tyle>:" (str.substr x 2 6)))
(assert (or (str.contains (str.replace x "r" "javascript:") "pajavascript:am ") (str.prefixof "pression(a" z)))
(assert (or (not (str.suffixof "r>" y)) (not (= (str.indexof z "XS" 0) 17))))
(assert (str.suffixof ">l UA */" y))
(assert (not (= (str.at x 63) "c")))
(assert (or (not (= "T a="">'>"" " (str.substr x 6 10))) (not (= (str.indexof y "';" 0) 73))))
(assert (not (str.prefixof "p" z)))
(assert (or (not (= "t(1) co" (str.substr z 24 7))) (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{2,64}")))))
(check-sat)
