; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote draggable=""true"" ondragend=""alert(1)"">test</blockquote>") (= x "<STYLE>.XSS{background-image:url(""javascript:javascript:alert(1)"");}</STYLE><A CLASS=XSS></A>")))
(assert (or (= z "nbeforecut=""alert(1)"" contenteditable>test</wbr>") (= z "gable=""true"" ondragstart=""alert(1)"">test</command>") (= z "ndex=1 onactivate=alert(1)></iframe>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w\-_&.,`#@!\s]+.{11,}$"))) (not (str.prefixof "<blockquo" x)) (>= (str.len y) 65)))
(assert (or (= (str.indexof z "mmand" 0) 44) (not (= (str.len x) 101))))
(assert (str.prefixof "y>" z))
(assert (or (not (= (str.indexof y "ntedi" 0) 120)) (= (str.at y 9) "S")))
(assert (or (str.prefixof "<blo" x) (str.suffixof "vas>" x) (<= (str.len x) 75)))
(assert (or (= "</wbr>" (str.substr z 42 6)) (not (= "S" (str.substr y 9 1))) (= (str.at z 7) "d")))
(assert (str.contains z "=""tru"))
(check-sat)
