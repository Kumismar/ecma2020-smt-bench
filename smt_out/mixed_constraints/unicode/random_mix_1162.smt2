; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><hr onload=alert(1)></hr>") (= x "<tt id=x tabindex=1 onbeforeactivate=alert(1)></tt>")))
(assert (or (= z "true"" ondragleave=""alert(1)"">test</thead>") (= z "0script:alert(\""XSS\"")>\"";' > out")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "ft" """") "e"":0;w") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._-]+$"))) (not (str.prefixof "st" z))))
(assert (or (not (str.prefixof "true" z)) (not (str.suffixof "/tt>" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^http(s)?:\/\/(www\.)?linkedin\.com\/.*$")))))
(assert (or (not (<= (str.len y) 86)) (str.contains z "ue"" ondrag") (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z]{3,10}$")))))
(assert (or (>= (str.len z) 36) (str.prefixof "<tt id=x t" x) (str.contains x "=ale")))
(assert (<= (str.len z) 39))
(check-sat)
