; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""117""><a href=""http://attacker.org"">") (= x "<bdi onmouseleave=""alert(1)"">test</bdi>") (= x "<;SCRIPT a=`>;` SRC="";http://ha.ckers.org/xss.js"";>;<;/SCRI\u{1f600}PT>;")))
(assert (or (= z "st</nav>") (= z "d>") (= z "template>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 7) ">") (<= (str.len z) 17) (= (str.indexof z "alert" 0) 13)))
(assert (or (not (>= (str.len z) 52)) (= (str.at z 7) "e")))
(assert (= (str.at y 29) "t"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{3}-\d{4}-\d{3}$"))) (= "<div id ""117""><a href=""http://attacker.org"">template>" (str.replace y "=" " ")) (not (= (str.indexof x "/" 0) 27))))
(assert (or (not (= "<style>@alert(1)rames x{}</style><code style=""animation-name:x"" onanimationstart=""alert(1)""></code>1)</script>" (str.replace y "keyf" "alert(1)"))) (<= (str.len y) 49) (str.contains y ";/")))
(assert (or (str.contains x "mousele") (not (str.contains z "d>"))))
(check-sat)
