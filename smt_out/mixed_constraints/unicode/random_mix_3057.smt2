; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onmouseleave=""alert(1)"">test</html>") (= x "<dt oncontextmenu=""alert(1)"">test</dt>")))
(assert (or (= z "e=""alert(1)"">test</option>") (= z "cript>") (= z """alert(1)"">test</pre>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 62) "t") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9-+]+$"))) (not (= "t(1)""" (str.substr z 5 5)))))
(assert (= "<param onmouseenter=""art(1)"">test</param>teditable>test</q>" (str.replace y "le" "")))
(assert (not (str.prefixof "<dt " x)))
(assert (or (not (= ">" (str.substr x 44 3))) (str.prefixof "<" x) (= "a" (str.substr x 46 1))))
(assert (str.contains z """><x"))
(assert (= (str.at z 7) "1"))
(check-sat)
