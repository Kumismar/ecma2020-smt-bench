; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><xss onload=alert(1)></xss>") (= x "<legend onmousemove=""alert(1)"">test</legend>")))
(assert (or (= z " onblur=alert(1) tabindex=1 id=x></nav><input autofocus>") (= z """>test</details>") (= z "html>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\d\.,]+$"))) (not (= " onblur=alert(1) tabindex=1 id=x><alert(1)av><input autofocus>" (str.replace z "/n" "alert(1)"))) (not (str.prefixof "<svg><xss" x))))
(assert (or (<= (str.len x) 32) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9,(,),-]{5,15}")))))
(assert (or (not (= (str.len x) 44)) (= (str.at x 17) "a")))
(assert (or (= "ss>" (str.substr x 29 10)) (str.prefixof "<lege" y) (not (str.prefixof "<" x))))
(assert (or (not (<= (str.len y) 50)) (not (= "x=1 ondeactivate=alert(1)></font>xput id=y autofocus>" (str.replace z "<in" "x")))))
(assert (or (not (= (str.at x 38) "g")) (not (= "move=""ale" (str.substr x 15 9))) (= (str.at x 11) "n")))
(check-sat)
