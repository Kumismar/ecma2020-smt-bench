; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<label draggable=""true"" o\u{1f4a9}ndragleave=""alert(1\u{20000})"">test</label>") (= x "<ul onmousemove=""alert(1)"">test</ul>") (= x "<\u{10348}slot oncut=""alert(1)"" contenteditable>test</slot>")))
(assert (or (= z "test</big>") (= z "ontenteditable>test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len x) 55) (not (= "ert(1)"" co" (str.substr x 16 10))) (str.suffixof "t</ul>" x)))
(assert (or (str.prefixof "tes" z) (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{5}-\d{4}|\d{5}|[A-Z]\d[A-Z] \d[A-Z]\d$")) (= (str.at y 4) "o")))
(assert (or (not (= (str.indexof y "b" 0) 36)) (= (str.at x 33) "a") (= (str.len y) 61)))
(assert (or (str.suffixof "st</ul>" x) (not (str.suffixof "ig>" z))))
(assert (or (>= (str.len z) 8) (= (str.at y 32) "d")))
(check-sat)
