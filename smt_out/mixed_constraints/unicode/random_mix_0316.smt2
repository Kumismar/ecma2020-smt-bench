; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe s\u{1f4a9}rcdoc=<sv\u{10348}g/o&#x6Eload&equals;alert&lpar;1)&gt;>") (= x "<legend draggable=""true"" ondragleave=""alert(1)"">test</legend>")))
(assert (or (= z "3c") (= z "drag me</div><iframe ondrop=alert(1) contenteditable>drop here</iframe>") (= z "a:expression(alert())&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (= "ge" (str.substr y 3 2))) (str.in_re y ((_ re.from_regex ecma2020 u) "..{1,}\s..+"))))
(assert (>= (str.len z) 1))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z-_ ]{2,40}$"))) (str.contains (str.replace y "<if" "x") "xram") (not (<= (str.len y) 88))))
(assert (or (not (= (str.indexof z "em>" 0) 23)) (not (= (str.at y 41) "l"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&#])[A-Za-z\d@$!%*?&#]{8,}$"))))
(check-sat)
