; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:\xEF\xBB\xBFexpress\u{1f600}ion(javascript:alert(1)"">DEF") (= x "<colgroup oncontextmenu=""alert(1)"">test</colgroup>") (= x "<content ondblclick=""alert(1)"">test</content>")))
(assert (or (= z "nsition:color 10s"" ontransitioncancel=alert(1)></mark>") (= z "rt(1)></menuitem>") (= z "nbeforeactivate=alert(1)></dd>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "ert(1")) (str.prefixof "<c" y)))
(assert (or (= "d>" (str.substr z 28 9)) (not (str.contains (str.replace z "-" """") """")) (not (= "g" (str.substr y 4 1)))))
(assert (or (= "nbefoalert(1)ivate=alert(1)></dd>" (str.replace z "react" "alert(1)")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[-+.\w]{1,64}@[-.\w]{1,64}\.[-.\w]{2,6}$")))))
