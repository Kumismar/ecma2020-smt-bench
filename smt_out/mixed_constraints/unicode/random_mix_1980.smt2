; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span onbeforecopy=""alert(1)"" contenteditable>test</span>") (= x "<hr onkeydown=""alert(1)"" contenteditable>test</hr>")))
(assert (or (= z "enter>") (= z "\u{1f600}useup=""alert(1)"">test</style>")))
(assert (= y (str.++ x z)))
(assert (or (= "<div draggable=""true""ontenteditable>drag me</div><code ondrop=alert(1) cont\u{1d400}enteditable>d\u{1d400}rop here</code>1)></nextid>" (str.replace y """ c" """")) (= (str.indexof z "xxx" 0) 4) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{8}$|^[0-9]{10}$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*$"))))
(assert (or (str.suffixof "lt;SCR)';" x) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^0\d{9,10}$")))))
(assert (not (= (str.indexof z "gro" 0) 17)))
(assert (or (<= (str.len z) 10) (not (= (str.at x 49) ">"))))
(assert (= "conten" (str.substr x 30 6)))
(check-sat)
