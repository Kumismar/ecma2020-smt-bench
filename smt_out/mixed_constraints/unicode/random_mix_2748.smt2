; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><hgroup onload=alert(1)></hgroup>") (= x "<button onkeydown=""alert(1)"" contenteditable>test</button>")))
(assert (or (= z "contextmenu=""alert(1)"">test</iframe>") (= z "</dl>") (= z "rames>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "g>" 0) 1)) (not (<= (str.len y) 64))))
(assert (or (<= (str.len y) 67) (str.contains z "extmenu=""")))
(assert (or (str.prefixof "conte" z) (= "<svg><hgro p onload=alert(1)></hgroup>" (str.replace x "u" " ")) (not (str.suffixof "</hgroup>" x))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{1,}$"))) (not (str.suffixof "roup>" x)) (not (str.contains x " onload"))))
(assert (or (not (str.prefixof "mg sr" z)) (not (str.contains x "load=a"))))
(check-sat)
