; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter ondblclick=""\u{1f4a9}alert(1)""\u{20000}>test</meter>") (= x "<style>:target {transform: rotate(180deg);}</style><tr id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tr>")))
(assert (or (= z "ivate=alert(1)></optgroup>") (= z "nend=""alert(1)""></rb>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "optgroup>" y)) (= (str.len x) 57) (>= (str.len z) 19)))
(assert (str.contains z "ssion"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^1(3|5|7|8)\d{9}"))) (not (= (str.indexof z "rt(" 0) 9)) (not (str.contains z ")></o"))))
(assert (str.contains x "e=alert(1)"))
(check-sat)
