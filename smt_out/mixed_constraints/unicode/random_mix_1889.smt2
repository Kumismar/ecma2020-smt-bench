; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ol onbeforecopy=""alert(1)"" contenteditable>test</ol>") (= x "<progress onmousedown=""alert(1)"">test</progress>")))
(assert (or (= z """>test</frameset>") (= z """true"" ondrag=""alert(1)"">test</\u{1f4a9}th>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "frameset>" y)))
(assert (or (not (= "<ol onbeforecopy=""(1)"" contenteditable>test</ol>""true"" ondrag=""alert(1)"">test</\u{1f4a9}th>" (str.replace y "alert" ""))) (not (= (str.indexof z "fram" 0) 8)) (str.prefixof "/del>" z)))
(assert (or (not (= (str.len z) 35)) (<= (str.len z) 20) (not (= (str.at x 2) "s"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) ".{4,100}")) (= (str.at z 9) "r") (not (str.prefixof "g onmous" z))))
(assert (not (= (str.at z 12) "e")))
(assert (or (not (str.suffixof "\u{1f4a9}th>" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?\d{0,13}")))))
(assert (or (str.suffixof "ogress>" x) (not (str.prefixof "<p" y))))
(check-sat)
