; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onmouseout=""alert(1)"">test</dfn>") (= x "<BODY ONLO\u{1f600}AD=javas\u{20000}cript:alert(1)>")))
(assert (or (= z "area onmousemove=""alert(1)"">test</textarea>") (= z "t.vulnerable=true;"">") (= z "cript:javascript:alert(1)""></html onMouseUp>")))
(assert (= y (str.++ x z)))
(assert (not (= "area onmousemove=""aleralert(1)(1)"">test</textarea>" (str.replace z "t" "alert(1)"))))
(assert (or (str.contains x "DY ONLO\u{1f600}A") (>= (str.len z) 15) (= (str.at z 1) ">")))
(assert (or (str.prefixof "<BOD" x) (not (= "<BODY ONLO\u{1f600}AD=javas\u{20000}cript:alert(1)>cript:javascript:alert(1)""></html onM""eUp>" (str.replace y "ous" """")))))
(assert (not (= (str.len z) 20)))
