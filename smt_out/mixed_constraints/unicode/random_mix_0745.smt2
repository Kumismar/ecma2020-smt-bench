(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^@[A-Za-z0-9_]{1,15}$"))) (= "<kbd id=x tabindex=1 onfocusin=a<b>ert(1)></kbd> id=x></small><input autofocus>" (str.replace y "l" "<b>")) (= (str.len y) 81)))
(check-sat)
