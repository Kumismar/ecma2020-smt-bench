; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame onkeypress=""alert(1)"" contenteditable>test</frame>") (= x "<caption onkeyup=""alert(1)"" contenteditable>test</caption>") (= x "<head id=x tabindex=1 onactivate=alert(1)></head>")))
(assert (or (= z "0*/") (= z "rt(1)"">test</p\u{1d400}rogress>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "rt(" z) (str.contains y "test</foo")))
(assert (or (= "<frame onkeypressrt(1)"" contenteditable>test</frame>" (str.replace x "=""ale" "")) (not (= (str.indexof x "nk" 0) 10))))
(assert (not (str.suffixof "e>0*/" y)))
(assert (or (= (str.at x 47) "d") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(GIR[ ]?0AA|((AB|AL|B|BA|BB|BD|BH|BL|BN|BR|BS|BT|CA|CB|CF|CH|CM|CO|CR|CT|CV|CW|DA|DD|DE|DG|DH|DL|DN|DT|DY|E|EC|EH|EN|EX|FK|FY|G|GL|GY|GU|HA|HD|HG|HP|HR|HS|HU|HX|IG|IM|IP|IV|JE|KA|KT|KW|KY|L|LA|LD|LE|LL|LN|LS|LU|M|ME|MK|ML|N|NE|NG|NN|NP|NR|NW|OL|OX|PA|PE|PH|PL|PO|PR|RG|RH|RM|S|SA|SE|SG|SK|SL|SM|SN|SO|SP|SR|SS|ST|SW|SY|TA|TD|TF|TN|TQ|TR|TS|TW|UB|W|WA|WC|WD|WF|WN|WR|WS|WV|YO|ZE)(\d[\dA-Z]?[ ]?\d[ABD-HJLN-UW-Z]{2}))|BFPO[ ]?\d{1,4})$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{0,75}")))))
(assert (or (str.suffixof "pt>" z) (not (str.prefixof "rt(1)"">tes" z)) (= "<li oncoxxtmenu=""alert(1)"">test</li>" (str.replace x "nte" "x"))))
(assert (or (not (<= (str.len x) 64)) (not (= (str.indexof y "ale" 0) 19))))
(check-sat)
