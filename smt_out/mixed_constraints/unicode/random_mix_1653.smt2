; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "' onmouseover=alert(/XSS/)") (= x "<rt ondblclick=""alert(1)"">test</rt>") (= x "<summary onbeforecopy=""alert(1)"" contenteditable>test</summary>")))
(assert (or (= z "rget {color:red;}</style><image id=x style=""transition:color 1s"" ontransitionend=alert(1)></image>") (= z "tabindex=1 id=x></plaintext><input autofocus>") (= z "up onbeforecut=""alert(1)"" contenteditable>test</optgroup>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "color 1s") (not (= (str.at x 32) "t")) (not (= "oreactivate=alert(x/mark>" (str.replace z "1)><" "x")))))
(assert (or (= (str.indexof z "siti" 0) 48) (not (= (str.at x 41) "d")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([\d\+\-\(\)\s]{3,})+[0-9]{4,}$")))))
(assert (or (str.contains z "itable>te") (= """alert(1)""" (str.substr x 22 10))))
(assert (or (= (str.at z 0) ";") (not (str.suffixof "mary>" x))))
(assert (or (= (str.indexof x "l" 0) 8) (not (= (str.indexof z "ntr" 0) 66))))
(check-sat)
