; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><code id=x style=""transition:color 1s"" ontransitionend=alert(1)></code>") (= x "<tbody onblur=alert(1) tabindex=1 id=x></tbody><input autofocus>") (= x "<figcaption oncopy=""ale\u{1f4a9}rt(1\u{1f4a9})"" contenteditable>test</figcaption>")))
(assert (or (= z "=""alert(1)"">test</div>") (= z "deo>")))
(assert (= y (str.++ x z)))
(assert (or (= "dx" (str.replace z "eo>" "x")) (= (str.indexof z "deo" 0) 0) (not (= (str.at x 58) "a"))))
(assert (or (= (str.at x 43) "<") (not (= "t" (str.substr y 23 1))) (= "<style>:target {color:red;}</style><code id=x style=""t""tion:color 1s"" ontransitionend=alert(1)></code>" (str.replace x "ransi" """"))))
(assert (or (not (= (str.at x 17) "o")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z][0-9][A-Za-z][\s]?[0-9][A-Za-z][0-9][\s]?$")))))
(assert (or (str.suffixof "re>" z) (not (<= (str.len y) 115))))
(assert (or (not (str.contains y "ansi")) (= "le" (str.substr y 91 2))))
(assert (or (not (str.contains y "1)"">test")) (str.contains z "rt(1)"">tes") (not (= "<tbody onb""=alert(1) tabindex=1 id=x></tbody><input autofocus>=""alert(1)"">test</div>" (str.replace y "lur" """")))))
(check-sat)
