; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><td id=x style=""transition:color 1s"" ontransitionend=alert(1)></td>") (= x "<style>:target {transform: rotate(180deg);}</style><frame id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></frame>") (= x "<param onpaste=""alert(1)"" contenteditable>test</param>")))
(assert (or (= z "lot>") (= z "able=""true"" ondragenter=""alert(1)"">test</dt>")))
(assert (= y (str.++ x z)))
(assert (str.contains y "1)"" conten"))
(assert (or (= (str.indexof x "x3c\u{1d400}" 0) 2) (not (= (str.at x 43) "e")) (not (= (str.at y 138) "e"))))
(assert (not (= "lor:red;" (str.substr y 18 8))))
(assert (not (= (str.indexof y "head" 0) 7)))
(assert (or (not (str.contains x "t</")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=^.{8,}$)((?=.*\d)(?=.*\W+))(?![.\n])(?=.*[A-Z]?)(?=.*[a-z]?).*$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\d|[0-8]\d|90")))))
(assert (or (not (= (str.at y 46) "t")) (not (str.contains x "ntented"))))
(assert (or (= (str.indexof y "t(" 0) 115) (= "t(" (str.substr y 33 2))))
(check-sat)
