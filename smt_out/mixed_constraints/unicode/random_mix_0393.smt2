; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><textarea id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></textarea>") (= x "<img\x10src=x onerror=""javascript:alert(1)"">") (= x "<html ondblclick=""alert(1)"">\u{1d400}test</html>")))
(assert (or (= z "1)"">test</datalist>") (= z "ansition:color 10s"" ontransitioncancel=alert(1)></base>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace z " " " ") "r 10s")))
(assert (or (str.prefixof "<" x) (not (str.prefixof "a" z)) (>= (str.len z) 10)))
(assert (not (str.prefixof "<ht" y)))
(assert (or (= (str.indexof y ">" 0) 51) (str.suffixof "html>" x)))
(assert (or (str.contains (str.replace y "</bas" "alert(1)") "1)>alert(1)e") (not (= (str.at z 17) "t")) (str.in_re y ((_ re.from_regex ecma2020 u) "(?!-)[a-zA-Z0-9-]{1,63}"))))
(assert (not (= (str.at z 44) "(")))
(assert (or (not (= "eou" (str.substr z 10 3))) (not (= (str.at x 50) " ")) (= (str.indexof z "tc>" 0) 1)))
(check-sat)
