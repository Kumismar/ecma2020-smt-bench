; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark onmousemove=""alert(1)"">test</m\u{1d400}ark>") (= x "<address id=x tabindex=1 onfocusin=alert(1)></address>") (= x "<style>:target {transform: rotate(180deg);}</style><title id=x style=""transition:trans\u{10348}form 2s"" ontransitionrun=alert(1)>\u{1d400}</title>")))
(assert (or (= z "click=""alert(1)"">test</p>") (= z "=""alert(1)"">test</ruby>") (= z "</applet>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "let>" y) (not (= (str.indexof x "1)></" 0) 41))))
(assert (not (= (str.indexof y "ru" 0) 108)))
(assert (str.contains x "focusin=al"))
(assert (not (= "<address id=x tabindex=focusin=alert(1)></address>" (str.replace x "1 on" ""))))
(assert (or (not (str.prefixof "</ap" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1]{1}[-]0?[0-9]{5,15}$"))) (str.suffixof """>test</p>" z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\+?\d{1,4}\s{0,}(\(\d{1,4}\))?\s{0,}(\d{1,5}\s{0,}-?){1,4}$"))))
(check-sat)
