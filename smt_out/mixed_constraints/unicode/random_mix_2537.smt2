; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup draggable=""true"" ondragend=""alert(1)"">test</colgroup>") (= x "<svg><legend onload=alert(1)></legend>")))
(assert (or (= z "1)"" contenteditable>test</content>") (= z "rt(1) contenteditable>drop here</link>") (= z "</menu>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len y) 63)))
(assert (or (not (= "<coalert(1)roup draggable=""true"" ondragend=""alert(1)"">test</colgroup>rt(1) contenteditable>drop here</link>" (str.replace y "lg" "alert(1)"))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")) (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:(?:\+|00)33[\s.-]{0,3}(?:\(0\)[\s.-]{0,3})?|0)[1-9](?:(?:[\s.-]?\d{2}){4}|\d{2}(?:[\s.-]?\d{3}){2})$"))))
(assert (or (= (str.indexof y "ofoc" 0) 67) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]+g([a-zA-Z]{1,2}[0-9]?){1,2}"))) (not (str.suffixof "nt>" y))))
(assert (str.contains x "<s"))
(assert (or (not (str.prefixof "</m" z)) (str.prefixof "<svg" x)))
(assert (or (= (str.indexof y "ntedi" 0) 72) (not (= (str.indexof x "aler" 0) 38)) (= "<colgroup draggable=""true"" ondragend=""alert(1)st</colgroup>" (str.replace x """>te" ""))))
(assert (str.prefixof "<svg>" y))
(check-sat)
