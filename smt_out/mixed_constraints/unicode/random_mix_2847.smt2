; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><command style=""animation-name:x"" onanimationend=""alert(1)""></command>") (= x "<style>:target {color: red;}</style><big id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></big>") (= x "<canvas id=x tabindex=1 onbeforedeactivate=alert(1)></canvas><input \u{1f4a9}autofocus>")))
(assert (or (= z "alert(1)"">test</mark>") (= z "CRIPT&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y "r" "javascript:") "fojavascript:edea") (not (str.suffixof "ert(1)>" x))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{4,15}$"))) (not (str.contains x "rabl")) (not (= (str.indexof z "ler" 0) 1))))
(assert (or (str.suffixof "k>" y) (str.contains z ">test</mar") (not (= (str.at z 4) "t"))))
(assert (or (str.contains z ".org/xss.j") (not (= (str.at x 46) "n")) (not (>= (str.len z) 15))))
(check-sat)
