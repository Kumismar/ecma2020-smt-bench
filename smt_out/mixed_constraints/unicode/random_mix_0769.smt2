; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex onmousemove=""alert(1)"">test</isindex>") (= x "<em draggable=""tru\u{1d400}e"" ondragstart=""alert(1)"">test</em>") (= x "<nextid oncut=""alert(1)"" con\u{1d400}tentedit\u{1f4a9}able>test</nextid>")))
(assert (or (= z "utton onmouseup=""alert(1)"">test</button>") (= z "(30)](1)") (= z "tenteditable>test</meta>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<nextid on" x) (not (= "ist>" (str.substr z 22 5)))))
(assert (or (not (= (str.at z 3) "'")) (>= (str.len y) 78) (not (str.contains y "xti"))))
(assert (not (= "<isindex onmousemove=""alert(1)"">test</isindex>(30)javascript:)" (str.replace y "](1" "javascript:"))))
(assert (or (not (= (str.at x 53) ">")) (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{4}\s\d{4}$")) (not (= (str.len y) 62))))
(assert (= (str.indexof z "s" 0) 3))
(check-sat)
