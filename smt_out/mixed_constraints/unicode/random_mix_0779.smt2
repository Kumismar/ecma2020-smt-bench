; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x contenteditable onpaste=alert(1)>paste here!") (= x "<menuitem onkeypress=""alert(1)"" contenteditable>test</menuitem>") (= x "<figure onbeforecopy=""alert(1)"" contenteditable>test</figure>")))
(assert (or (= z "svg>") (= z "recopy=""alert(1)"" contenteditable>test</spacer>") (= z "&#x\u{10348}003C;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*[.]([a-z]{2,3})$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[_A-Za-z0-9-+.]+([_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(.[A-Za-z0-9-]+)*(.[A-Za-z]{2,4}){1,2}$"))) (not (str.prefixof "<menuite" y))))
(assert (not (str.contains (str.replace x "ansit" "") """trion")))
(assert (or (= "s" (str.substr z 0 1)) (not (= (str.indexof x "1)"" c" 0) 28))))
(assert (or (str.prefixof "<menuitem " y) (= "paste=ale" (str.substr y 21 9))))
(assert (= (str.at y 3) "g"))
(check-sat)
