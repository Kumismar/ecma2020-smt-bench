; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param onfocusout=alert(1) tabindex=1 id=x></param><input autofocus>") (= x "<XSS STYLE=""xss:expression(javascript:alert(1))"">") (= x "<del id=x tabindex=1 onfocus=alert(1)></del>")))
(assert (or (= z "br id=x tabindex=1 onfocusin=alert(1)></br>") (= z "ondragover=alert(1) contenteditable>drop here</dt>") (= z "'XSS")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 43) (not (= ") tabindex" (str.substr x 21 10)))))
(assert (or (= (str.indexof y "pt" 0) 35) (= (str.at y 53) "l") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.*@(?!gmail).*$")))))
(assert (or (= (str.at z 36) ">") (= "br id=x tabindex=1 onfocusinalert(1)t(1)></br>" (str.replace z "=aler" "alert(1)"))))
(assert (or (not (= (str.at y 11) """")) (not (str.prefixof "<meter onb" y))))
(assert (or (str.suffixof "))"">'XSS" y) (str.prefixof "<" x)))
(assert (= "r=pro" (str.substr y 52 5)))
(assert (str.suffixof "here</dt>" z))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{1,7}-\d{2}-\d$"))) (str.prefixof "<image s" x)))
(check-sat)
