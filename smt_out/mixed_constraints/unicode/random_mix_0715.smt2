; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onbeforecopy=""alert(1)"" contenteditable>test</cite>") (= x "<dt onbeforecopy=""alert(1)\u{20000}"" contenteditable>test</dt>") (= x "<style>:target {color: red;}</style><li id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></li>")))
(assert (or (= z "frames \u{10348}x{}</style><tr style=""animation-name:x"" onanimationstart=""alert(1)""></tr>") (= z "ex=1 onactivate=alert(1)></div>") (= z "lert(1)&lt;/scrscriptipt&gt;")))
(assert (= y (str.++ x z)))
(assert (= " 10s"" o" (str.substr x 68 7)))
(assert (= (str.indexof y "li>e" 0) 50))
(assert (or (str.prefixof "lert(1)" z) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{c0}-\u{fa}]{2,30}$")) (str.prefixof "<dt " x)))
(assert (or (= """ on\u{20000}drag" (str.substr y 22 9)) (= "lert(1)&lt;/scrscrxipt&gt;" (str.replace z "ipt" "x")) (= "tra" (str.substr x 76 3))))
(assert (not (= (str.at x 18) "a")))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]+([\.|,][0-9]+)?")))
(assert (not (= (str.indexof z ")&" 0) 6)))
(check-sat)
