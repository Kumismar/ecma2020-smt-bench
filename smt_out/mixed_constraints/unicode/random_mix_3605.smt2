; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th onmouseleave=""alert(1)"">test</th>") (= x """><img src=x onerror=javascript:alert(`1`)>") (= x "<embed onmousedown=""alert(1)"">test</embed>")))
(assert (or (= z "SS'))"">") (= z "=""get"";")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 16) "r") (= (str.at y 5) "e") (not (str.suffixof "SS'))"">" y))))
(assert (or (not (= (str.indexof x "al" 0) 18)) (str.contains (str.replace z "=""g" "") "et"";")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^1((3|5|8|7){1}\d{1})\d{8}$")))
(assert (or (str.prefixof "<embed o" y) (not (<= (str.len y) 59))))
(assert (or (not (str.contains y "ert(")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df} 0-9\.\-]{1,50}"))) (= (str.indexof z "get"";" 0) 2)))
(assert (or (not (= (str.indexof x ")""" 0) 25)) (= "x onerro" (str.substr x 11 8))))
(check-sat)
