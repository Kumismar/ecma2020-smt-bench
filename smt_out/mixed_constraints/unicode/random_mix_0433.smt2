; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot id=x tabindex=1 ondeactivate=alert(1)></tfoot><input id=y autofocus>") (= x "<strike id=x tabindex=1 onactivate=alert(1)></strike>") (= x "<div onmouseenter=""alert(1)"">test</div>")))
(assert (or (= z "[""al""+""ert""](1)") (= z "t(1)></figure><input autofocus>") (= z "ondragstart=""alert(1)"">test</sub>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len y) 88)) (= (str.at z 23) "v")))
(assert (or (not (= "t" (str.substr z 23 1))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([0-9]{1})(\d{5,25})$")))))
(assert (or (>= (str.len y) 76) (not (>= (str.len y) 45))))
(assert (not (str.prefixof "<strike " x)))
(assert (or (= (str.at x 1) "d") (str.prefixof "<tfoot id=" x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z]{4}[0-9]{7}"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\s*([A-Za-z\/\s\.'-]{1,}([\.,] |[-']| ))+[A-Za-z]+\.?\s*$|\w+"))) (str.suffixof "(1)" y)))
(assert (or (not (str.contains (str.replace y "ten" "") "nt")) (= (str.at x 9) "-")))
(check-sat)
