; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1f4a9}ul id=x tabindex=1 onfocus\u{1d400}in=alert(1)></ul>") (= x "<style>:target {transform: rotate(180deg);}</style><marquee id=x style=""transition:transform 2s""\u{10348} ontransitionr\u{1f4a9}un=alert(1)></marquee>")))
(assert (or (= z "nteditable>drop here</var>") (= z "ntenteditable>test</dt>") (= z "er onmouseup=""alert(1)"">test</footer>")))
(assert (= y (str.++ x z)))
(assert (= "rt(1)"">te" (str.substr z 17 9)))
(assert (or (str.prefixof "able" z) (not (= "<link REL=""stylesheet""x=""javascript:document.vulnerable=true;"">st</picture>" (str.replace y " HREF" "x"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a0-9a-zA-Z -.&\u{c4}\u{dc}\u{d6}\u{e4}\u{f6}\u{fc}\u{df}\u{c0}\u{c1}\u{c2}\u{c3}\u{c5}\u{c7}\u{c8}\u{c9}\u{ca}\u{cb}\u{ce}\u{d2}\u{d3}\u{d4}\u{d5}\u{d9}\u{da}\u{db}\u{dd}\u{e0}\u{e1}\u{e2}\u{e3}\u{e5}\u{e7}\u{e8}\u{e9}\u{ea}\u{eb}\u{ec}\u{ed}\u{ee}\u{ef}\u{f1}\u{f2}\u{f3}\u{f4}\u{f5}\u{f9}\u{fa}\u{fb}\u{fd}\u{ff}]{2,80}$")))))
(assert (or (>= (str.len x) 51) (not (= (str.indexof x "d=x" 0) 6))))
(assert (or (= (str.indexof z "s" 0) 0) (not (= "njavascript:nteditable>test</dt>" (str.replace z "te" "javascript:"))) (not (str.prefixof "<styl" y))))
(assert (str.suffixof ")></ul>" x))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\(?(?!37|96|900|456|555)[2-9](?!11)[0-8][0-9]\)?[-.\s]?(?!555[-.\s]?(?:1212|01)|(\d)\1{2}[-.\s]?\1{4})[2-9](?!11)[0-9]{2}[-.\s]?[0-9]{4}$"))))
(assert (or (not (= (str.indexof z "l" 0) 8)) (str.suffixof ">" x) (not (= "<style>:targejavascript:{transform: rotate(180deg);}</style><marquee id=x style=""transition:transform 2s""\u{10348} ontransitionr\u{1f4a9}un=alert(1)></marquee>" (str.replace x "t " "javascript:")))))
(assert (not (str.contains y "dt")))
(check-sat)
