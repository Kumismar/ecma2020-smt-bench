; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u onclick=""alert(1)"">test</u>") (= x "<wbr id=x tabindex=1 onfocus=alert(1)></wbr>")))
(assert (or (= z "t;A HREF=&quot;http://ha.ckers.org@google&quot;&gt;XSS&lt;/A&gt;") (= z "TYLE='no\xss&#58;noxss(\""*//*\"");")))
(assert (= y (str.++ x z)))
(assert (or (= "'no\" (str.substr z 5 4)) (not (= "s=ale" (str.substr x 27 5))) (= (str.at y 70) "k")))
(assert (or (not (str.contains y " HR")) (str.contains x "ick=""alert") (str.contains (str.replace y "n" " ") "abi d")))
(assert (or (not (= (str.at y 17) "(")) (str.contains z "TYLE")))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z][A-Za-z0-9 _,-.'!?]*$")))
(check-sat)
