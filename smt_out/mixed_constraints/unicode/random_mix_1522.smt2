; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><small id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></small>") (= x "<;SCRIPT SRC=//ha.ckers.org/.j>;")))
(assert (or (= z " onchange=alert(1) value=xss>") (= z "est</optgroup>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace z "</op" "alert(1)") "estalert(1)t")))
(assert (or (not (str.contains z "al")) (= (str.indexof y "/." 0) 27)))
(assert (or (= "tgroup" (str.substr z 7 6)) (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9\u{5c}u00DF\u{5c}u00E4\u{5c}u00C4\u{5c}u00F6\u{5c}u00D6\u{5c}u00FC\u{5c}u00DC _.-]+)$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9 \(\)\-\+]{0,}")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9.& _]*[A-Za-z0-9][A-Za-z0-9.& _]*$"))) (= "lert(1) " (str.substr z 11 8))))
(check-sat)
