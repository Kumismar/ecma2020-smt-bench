; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object onmouseenter=""alert(1)"">test</object>") (= x "<source onbeforecut=""alert(1)"" contenteditable>test</source>") (= x "<noembed draggable=""true"" ondragstart=""alert(1)"">test</noembed>")))
(assert (or (= z "ession(alert('XSS'))"">") (= z """>test</map>") (= z "alert(1)"">test</dd>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "n" 0) 1) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]*[.]?[0-9]{0,2}"))) (not (= (str.at y 74) "t"))))
(assert (str.contains x "ject"))
(assert (not (str.prefixof "<source " y)))
(assert (or (str.prefixof "<object" y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[a-zA-Z]).{8,}$"))) (not (= "er" (str.substr z 2 2)))))
(assert (not (str.contains z "os;XSS&apo")))
(assert (or (not (= (str.indexof y "le" 0) 23)) (not (= (str.indexof x "us" 0) 12))))
(check-sat)
