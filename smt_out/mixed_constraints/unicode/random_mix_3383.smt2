; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed onkeyup=""a\u{10348}lert(1)"" contenteditable>test</noe\u{20000}mbed>") (= x "<acronym drag\u{20000}gable=""true"" ondragleave=""alert(1)"">test</acronym>")))
(assert (or (= z "m>") (= z """>test</meter>") (= z "tyle\u{1f4a9}><rtc id=x style=""transition:color 1s"" ontransitionend=alert(1)></rtc>\u{1f4a9}")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<acronym" x)) (not (str.contains x "ve="))))
(assert (not (str.suffixof "n>" x)))
(assert (not (= "rames><inp" (str.substr z 50 10))))
(assert (or (not (str.suffixof "igure>" x)) (not (str.prefixof "<noembed " y)) (str.in_re y ((_ re.from_regex ecma2020 u) "^0[1-689][0-9]{8}$"))))
(assert (or (not (= "rue"" " (str.substr y 22 5))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(.)+@[A-Za-z0-9]([A-Za-z0-9\.-]*[A-Za-z0-9])?\.[A-Za-z]{1,13}$")))))
(assert (or (not (str.suffixof "mbed>m>" y)) (not (= "eter>" (str.substr z 9 10))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{105}\u{107}\u{106}\u{119}\u{142}\u{141}\u{144}\u{143}\u{f3}\u{d3}\u{15b}\u{15a}\u{17c}\u{17b}\u{17a}\u{179}]{4,20}$"))))
(check-sat)
