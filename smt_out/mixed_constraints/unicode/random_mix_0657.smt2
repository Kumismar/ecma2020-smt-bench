; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "[color=red' onmouseove\u{1f600}r=""alert('xss')""]mouse over[/color]") (= x "<base onblur=alert(1) tabindex=1 id=x></base><input autofocus>")))
(assert (or (= z "st</small>") (= z "=""alert(1)"" contenteditable>test</element>") (= z "round:url("";javascript:alert(';XSS';)"";)}<;/STYLE>;")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ")')>" x) (not (str.prefixof "<base" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 './,]+$")))))
(assert (str.suffixof "autofocus>" x))
(assert (or (not (= (str.len x) 62)) (str.prefixof "[co" x) (= (str.at y 53) "u")))
(assert (not (= "se onb" (str.substr y 3 6))))
(check-sat)
