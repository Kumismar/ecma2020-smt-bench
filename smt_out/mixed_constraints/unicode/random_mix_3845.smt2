; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter onmouseup=""alert(1)"">test</meter>") (= x "<pre id=x tabindex=1 onbeforedeactivate=alert(1)></pre><input autofocus>") (= x "<style>:target {transform: rotate(180deg);}</style><address id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></address>")))
(assert (or (= z "www.google.com./"";>;XSS<;/A>;") (= z "g>")))
(assert (= y (str.++ x z)))
(assert (not (= "up=""alert(" (str.substr y 14 10))))
(assert (or (= "<metealert(1)onmouseup=""alert(1)"">test</meter>g>" (str.replace y "r " "alert(1)")) (not (= (str.at y 82) "."))))
(assert (or (= (str.len z) 29) (not (= "" (str.replace z "g>" ""))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\(11\) [9][0-9]{4}-[0-9]{4})|(\(11\) [1-7][0-9]{3}-[0-9]{4})|(\(1[2-9]\) [5-9][0-9]{3}-[0-9]{4})|(\([2-9][1-9]\) [5-9][0-9]{3}-[0-9]{4})$")))))
(assert (or (str.contains (str.replace z "g" "") ">") (not (str.suffixof "utofocus>" z))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*\d)[0-9a-zA-Z]{6,}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(https?:\/\/)?\w[\w\d\.-]+\.[a-z]{2,}(?:\/.*)?$"))) (not (str.suffixof ";/A>;" z))))
(assert (or (not (<= (str.len y) 109)) (str.prefixof "<" y) (not (= " oncut=""al" (str.substr y 9 10)))))
(assert (not (<= (str.len x) 48)))
(check-sat)
