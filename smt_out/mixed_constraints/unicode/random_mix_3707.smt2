; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title onmouseup=""alert(1)"">test</title>") (= x "javascript:alert%281%29;")))
(assert (or (= z "st</form>") (= z "ert(1)""></image>") (= z "><spacer style=""animation-name:x"" onanimationend=""alert(1)""></spacer>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 9) (not (<= (str.len z) 15)) (not (= "e" (str.substr y 38 1)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?[78][-\(]?\d{3}\)?-?\d{3}-?\d{2}-?\d{2}$"))) (not (= (str.indexof z "</for" 0) 2))))
(assert (or (str.prefixof "javas" x) (not (= (str.indexof z "p=ale" 0) 20))))
(assert (not (= (str.len z) 9)))
(check-sat)
