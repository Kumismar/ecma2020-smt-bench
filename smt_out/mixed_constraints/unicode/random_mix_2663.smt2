; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<acronym onkeyup=""alert(1)"" contenteditable>test</acronym>") (= x "<abb\u{20000}r onmouseover=""alert(1)"">test\u{20000}</abbr>") (= x "<samp id=x tabindex=1 onbeforedeactivate=alert(1)></samp><input autofocus>")))
(assert (or (= z "rt(1)"">test</strong>") (= z "yle=""transition:color 1s"" ontransitionend=alert(1)></content>") (= z "lert(1)"">test</q>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 61)) (not (= "itabl" (str.substr y 37 5)))))
(assert (= (str.indexof x "t(" 0) 43))
(assert (or (not (str.suffixof "d>" z)) (str.contains x " o")))
(assert (or (not (= "<dd onpaste=""alerjavascript:1)"" contenteditable>test</dd>" (str.replace x "t(" "javascript:"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z A-Z ]*$"))) (= (str.at y 22) "x")))
(check-sat)
