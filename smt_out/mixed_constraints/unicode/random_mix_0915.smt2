; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figcaption onmouseleave=""alert(1)"">test</figcaption>") (= x "<title id=x tabindex=1 onbeforeactivate=alert(1)></title>")))
(assert (or (= z "av>") (= z "<SCRIPT>alert('XSS');</SCRIPT><![endif]-->") (= z "=""alert(1)"">test</area>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "ler" z))
(assert (= (str.at y 4) "l"))
(assert (= (str.indexof y "aut" 0) 58))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(^(chr)?(\d{1,2}|(x|y|X|Y)):\d+$)"))) (not (str.contains (str.replace z "(1)"">" " ") "t te"))))
(assert (or (= (str.indexof z "PT" 0) 5) (not (= (str.at z 1) "v"))))
(assert (or (str.prefixof "<titl" y) (str.contains (str.replace y ">a" "x") "Txl") (not (= "n><SCRIP" (str.substr y 51 8)))))
(assert (or (not (= (str.at y 89) "i")) (not (str.contains (str.replace z ">" "") "av"))))
(assert (or (not (str.suffixof ">" x)) (not (str.suffixof "dif]-->" y))))
(check-sat)
