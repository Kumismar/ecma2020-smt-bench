; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{201c}><<script>alert(document.cookie);//<</script>") (= x "<img src/onerror=alert(1)>")))
(assert (or (= z "=1 onbeforeactivate=alert(1)></textarea>") (= z "er=""alert(1)"">test\u{20000}</abbr>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len z) 5)))
(assert (not (= (str.len x) 46)))
(assert (or (= (str.indexof x "l" 0) 18) (not (= (str.at x 10) "n")) (= "<img src/onerror<b>alert(1)>" (str.replace x "=" "<b>"))))
(assert (or (str.contains y "ert(1)></") (not (= (str.at y 8) "/"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[qpQP]\d+"))) (= "ent.cooki" (str.substr y 22 9)) (not (str.prefixof "<img src/o" y))))
(assert (str.prefixof "=1 onbef" z))
(check-sat)
