; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u onbeforecut=""alert(1)"" contenteditable>test</u>") (= x "<abbr draggable=""true"" ondragstart=""alert(1)"">test</abbr>")))
(assert (or (= z ")"" contenteditable>test</shadow>") (= z " onoffline=""alert(String.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]{3,}")) (not (<= (str.len y) 110)) (not (str.contains x "drag"))))
(assert (or (= (str.indexof x ")" 0) 23) (= (str.at y 70) "e")))
(assert (or (not (str.suffixof """>" y)) (not (<= (str.len y) 114)) (not (= "<abbr draggable=""tru ndragstart=""alert(1)"">test</abbr> onoffline=""alert(String.fromCharCode(88,83,83))"">" (str.replace y "e"" o" " ")))))
(assert (or (str.contains y "ondragsta") (not (= "<u onbeforecut=""alert(1)"" contenteditable>test</u> onoffline=""alert(String.fromCharCode(javascript:3,83))"">" (str.replace y "88,8" "javascript:"))) (not (= (str.at x 28) "g"))))
(assert (not (str.contains x "tart=""a")))
(check-sat)
