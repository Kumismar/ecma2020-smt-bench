; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption ondblclick=""alert(1)"">test</caption>") (= x "<form id=x tabindex=1\u{1f600} onbeforedeactivate=alert(1)></form><input autofocus>")))
(assert (or (= z "body id=x tabindex=1 onbeforedeactivate=alert(1)></body><input autofocus>") (= z "recut=""alert(1)"" contenteditable>test</td>") (= z "t</base>")))
(assert (= y (str.++ x z)))
(assert (or (= "t" (str.substr y 136 1)) (= (str.len y) 83)))
(assert (not (str.contains z "alert(1")))
(assert (or (str.contains (str.replace y "cont" "x") """ xent") (str.contains (str.replace y "befo" """") " on""rede") (str.suffixof "ption>" x)))
(assert (or (= "<caption ondblclick=""alx(1)"">test</caption>recut=""alert(1)"" contenteditable>test</td>" (str.replace y "ert" "x")) (= (str.at z 3) "b")))
(assert (or (str.contains z "cti") (not (= "tio" (str.substr y 4 3)))))
(assert (or (str.prefixof "rt(" z) (not (= "ocus>" (str.substr x 70 8)))))
(assert (or (str.suffixof "ocus>" x) (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\d\s]+$"))))
(check-sat)
