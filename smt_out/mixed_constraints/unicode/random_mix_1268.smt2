; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main oncontextmenu=""alert(1)"">test</main>") (= x "<i draggable=""true"" ondragleave=""alert(1)"">test</i>")))
(assert (or (= z """transition:transform 2s"" ontransitionrun=alert(1)></big>") (= z "ip\u{10348}t onmousedo\u{1d400}wn=""alert(1)"">test</noscript>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "nsit")) (not (str.contains y "ys"))))
(assert (= (str.at y 10) "e"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_]+"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^http(s)?:\/\/(www\.)?linkedin\.com\/.*$")))))
(assert (or (not (>= (str.len z) 49)) (not (>= (str.len z) 38)) (str.suffixof "</source>" y)))
(check-sat)
