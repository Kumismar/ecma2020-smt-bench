; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><label id=x style=""transition:color 1s"" ontransitionend=alert(1)></label>") (= x "<image id=x tabindex=1 onfocus=alert(1)></image>")))
(assert (or (= z "ails onmousemove=""alert(1)"">test</details>") (= z "t</if\u{20000}\u{20000}rame>") (= z """ contenteditable>test</rt>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "est") (= "'" (str.substr y 28 1))))
(assert (or (str.contains x "styl") (= "<image id=x tabindex=1 onfocusrt(1)></image>" (str.replace x "=ale" ""))))
(assert (or (not (str.suffixof "\u{20000}rame>" y)) (not (str.contains (str.replace z "ert(1" """") """al"")"">")) (not (= (str.indexof x "u" 0) 28))))
(assert (or (= "teditab" (str.substr z 8 7)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{13}")))))
(check-sat)
