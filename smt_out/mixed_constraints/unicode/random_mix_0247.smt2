; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:\xE2\x80\x80expression(javascript:alert(1)"">DEF") (= x "<em id=x tabindex=1 onbeforeactivate=alert(1)></em>")))
(assert (or (= z "></output><input autofocus>") (= z "useover=""alert(1)"">test</rtc>") (= z "ut=""alert(1)"" contenteditable>test</p>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<em " x))
(assert (or (= "cus>" (str.substr y 87 7)) (not (= "ndex=1 onb" (str.substr x 13 10))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[^':]*$")))))
(assert (or (= "<" (str.substr z 34 1)) (not (str.prefixof "></out" z)) (not (str.prefixof "ABC<div st" y))))
(assert (or (= (str.at z 13) " ") (not (str.contains z "ut><inp")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9\u{c6}\u{d8}\u{c5}\u{e6}\u{f8}\u{e5}\u{dc}\u{fc}\u{d6}\u{f6}\u{c4}\u{e4}a-zA-Z+-_.._%+-]+@[0-9\u{c6}\u{d8}\u{c5}\u{e6}\u{f8}\u{e5}\u{dc}\u{fc}\u{d6}\u{f6}\u{c4}\u{e4}a-zA-Z+-_..-]+\.[\u{c6}\u{d8}\u{c5}\u{e6}\u{f8}\u{e5}\u{dc}\u{fc}\u{d6}\u{f6}\u{c4}\u{e4}a-zA-Z]{2,5}")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "['a-zA-Z0-9-#&+,@!.() ]{2,60}"))))
(assert (or (= "<em id=x tabindex=1 onbeforeactivate=al t(1)></em>ut=""alert(1)"" contenteditable>test</p>" (str.replace y "er" " ")) (<= (str.len z) 33) (not (<= (str.len z) 41))))
(assert (str.contains x "1)"">DEF"))
(check-sat)
