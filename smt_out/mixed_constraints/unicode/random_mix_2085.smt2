; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><select ondrop=alert(1) contenteditable>drop here</select>") (= x "<sub onmousemove=""alert(1)"">test</sub>") (= x "<select id=x tabindex=1 onbeforeactivate=alert(1)></select>")))
(assert (or (= z "3c") (= z "test</del>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(19[0-9]\d|20([0-1]\d|2[0-1]))"))) (not (= (str.indexof z "l>" 0) 8))))
(assert (not (= "<select id=x taalert(1)index=1 onbeforeactivate=alert(1)></select>" (str.replace x "b" "alert(1)"))))
(assert (or (str.contains x "v dragga") (not (= (str.len y) 126))))
(assert (or (str.contains (str.replace z "st</" "javascript:") "ejavascript:d") (not (str.suffixof "t>" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*(.[a-z]{2,})$")))))
(assert (not (str.prefixof "<s" x)))
(assert (= (str.indexof z "te" 0) 0))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{7,10}$"))) (str.prefixof "<sub on" x)))
(assert (or (not (= "3c" (str.substr z 0 2))) (not (str.suffixof "ub>3c" y)) (str.prefixof "t" z)))
(check-sat)
