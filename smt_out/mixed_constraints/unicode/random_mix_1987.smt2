; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base onmousedown=""alert(1)"">test</base>") (= x "<IMG SRC=x onmessage=""alert(String.fromCharCode(88,83,83))"">") (= x "<video onpaste=""alert(1)"" contenteditable>test</video>")))
(assert (or (= z "2s"" ontransitionrun=alert(1)></small>") (= z "alert(1)"" contenteditable>test</rp>") (= z "id=x></source><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^00:[0-5][0-9]:[0-5][0-9](\.\d\d?\d?)?$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^00[0-9]{1,4}[-\s0-9]{6,15}$")))))
(assert (or (not (str.prefixof "<video " y)) (not (= (str.len z) 35))))
(assert (or (str.prefixof "<b" x) (str.in_re x ((_ re.from_regex ecma2020 u) "[^@(www)]+"))))
(assert (or (str.contains (str.replace y "ce><" """") "our""in") (str.contains (str.replace y " " "alert(1)") "ealert(1)o")))
(check-sat)
