; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title id=x tabindex=1 onbeforedeactivate=alert(1)></title><input autofocus>") (= x "<iframe s\u{1f4a9}rcdoc=<sv\u{10348}g/o&#x6Eload&equals;alert&lpar;1)&gt;>") (= x "<comment><img src=""</comment><img src=x onerror=javascript:alert(1))//"">")))
(assert (or (= z "blink>") (= z "ivate=alert(1)></pre><input id=y autofocus>") (= z "ondragover=alert(1) contenteditable>drop here</aside>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 5) "o") (not (= (str.at x 39) "("))))
(assert (or (not (= "e" (str.substr z 13 1))) (= "1)"">t" (str.substr x 28 5)) (= (str.at x 18) "v")))
(assert (or (str.suffixof "k>" z) (str.suffixof ")//"">" x) (not (= (str.indexof x "m" 0) 3))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "https?://.+|\.\/\?place=[0-9]{3}"))))
(assert (or (not (str.suffixof "</aside>" z)) (not (>= (str.len z) 72))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(05)[0-9][0-9][1-9]([0-9]){6}$"))))
(check-sat)
