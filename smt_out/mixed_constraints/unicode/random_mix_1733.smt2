; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object draggable=""true"" ondragleave=""alert(1)"">test</object>") (= x "<;br size=\"";&;{alert(&#039;XSS&#039;)}\"";>;") (= x "<IMG SRC=x ondblclick=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "ndex=1 id=x></ol><input autofocus>") (= z "srcdoc=&amp;lt;img&sol;src=&amp;apos;&amp;apos;onerror=javascript:alert(1)&amp;gt;>"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 48) "t")) (not (= (str.at y 34) "3")) (not (= "po" (str.substr y 77 2)))))
(assert (not (str.suffixof """>" y)))
(assert (or (str.contains z "1)></dfn") (= (str.indexof y "t aut" 0) 66) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s]+$")))))
(assert (or (not (= (str.at x 49) ">")) (not (= "<IMG SRC=x ondblclick""ert(String.fromCharCode(88,83,83))"">" (str.replace x "=""al" """")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*[a-z])(?=.*[A-Z]).{8,64}"))))
(assert (= (str.len x) 61))
(assert (str.suffixof "83,83))"">" x))
(check-sat)
