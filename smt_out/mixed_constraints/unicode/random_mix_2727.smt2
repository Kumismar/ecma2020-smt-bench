; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hgroup onmouseover=""alert(1)"">test</hgroup>") (= x "<del draggable=""true"" ondragleave=""alert(1)"">test</del>")))
(assert (or (= z "d=alert(1)></strike>") (= z "><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "nblur=ale" z)))
(assert (or (str.suffixof "test</del>" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}"))) (= "<hgroup onmouseover=""alert(1)"">test< roup>" (str.replace x "/hg" " "))))
(assert (or (= "alert(1)" (str.substr z 2 8)) (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9-#.!,@\[\]\(\)\/ ]+$"))))
(assert (not (= "ofoc" (str.substr y 66 4))))
(assert (= (str.indexof x "est" 0) 32))
(check-sat)
