; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>var var = 1; alert(var)</script>") (= x "<bgsound onclick=""alert(1)"">test</bgsound>") (= x "<div draggable=""true"" contenteditable>drag me</div><tfoot ondrop=alert(1) contenteditable>drop here</tfoot>")))
(assert (or (= z " onblur=alert(1) tabindex=1 id=x></samp><input autofocus>") (= z "=1 ondeactivate=alert(1)></audio><input id=y autofocus>") (= z "t(1)"" c\u{1f4a9}ontenteditable>test</object>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 0) "<"))
(assert (or (not (= "t(1)"" c\u{1f4a9}ontenteditable>tes""object>" (str.replace z "t</" """"))) (= (str.indexof y "i" 0) 46) (= (str.indexof x "past" 0) 10)))
(assert (or (not (str.contains z "focus")) (not (= (str.at z 13) "t"))))
(assert (or (str.suffixof "script>" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-\u{17e}0-9. _-]{5,}$")))))
(assert (or (str.contains y "blur") (not (str.contains (str.replace x "oad=" """") "onl""al")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(([hH][Tt]{2}[Pp][Ss]?):\/\/)?([\da-zA-Z\.-]+)\.([a-zA-Z\.]{2,6})([\/\w \.-]*)*\/?$")))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[CEPcep]-\d{6}-[AaBbCc]\d{3}$")) (= (str.indexof y "test<" 0) 28)))
(check-sat)
