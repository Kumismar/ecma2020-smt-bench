; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\xE2\x80\x8Ajavascript:alert(1)</script>") (= x "\u{bc}script\u{be}alert(\u{a2}XSS\u{a2})\u{bc}/script\u{be}") (= x "<style>:target {transform: rotate(180deg);}</style><option id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></option>")))
(assert (or (= z "1)""></a>") (= z "ble=""true"" ondragleave=""alert(1)"">test</source>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x "ipt\u{be}alert(")))
(assert (>= (str.len z) 1))
(assert (or (not (str.prefixof """`'>" x)) (not (= (str.len x) 29)) (not (str.prefixof ") " z))))
(assert (str.suffixof ">" y))
(assert (or (not (str.contains y "Ajavas")) (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9 -]+$"))))
(assert (= (str.len z) 47))
(assert (not (str.contains y "</")))
(check-sat)
