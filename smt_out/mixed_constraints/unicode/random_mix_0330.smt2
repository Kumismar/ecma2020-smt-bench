; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x1Djavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<img onmouseout=""alert(1)"">test</img>")))
(assert (or (= z "yle=""animation-name:x"" onanimationend=""alert(1)""></blink>") (= z "<rt ondragover=alert(1) contenteditable>d\u{1f600}rop here</rt>") (= z "003c;")))
(assert (= y (str.++ x z)))
(assert (= " " (str.substr y 9 1)))
(assert (not (= (str.at z 4) """")))
(assert (not (= "able" (str.substr z 35 4))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\s@]+@[^\s@]+\.[^\s@]+$"))))
(assert (not (= (str.at x 36) ">")))
(assert (or (not (str.contains z "3c;")) (not (str.suffixof "img>" x)) (not (str.contains y """fu"))))
(assert (= (str.indexof z "003c;" 0) 0))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "((http|https)://)?(www.)?linkedin.com/in/.+"))) (not (= "<svg><legend onload=alert(1)></legend>rt(1)"" contentxble>test</meter>" (str.replace y "edita" "x"))) (not (str.prefixof "<img onmou" y))))
(check-sat)
