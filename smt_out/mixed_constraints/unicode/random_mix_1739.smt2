; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col id=x tabindex=1 ondeactivate=alert(1)></col><input id=y autofocus>") (= x "<tbody onmousedown=""alert(1)"">test</tbody>")))
(assert (or (= z "able>test</blockquote>") (= z "t\u{1f4a9}ure onmouse\u{1d400}out=""alert(1)"">test</picture>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "ofocus>" x)) (= "(1)" (str.substr x 39 3))))
(assert (or (= (str.len y) 64) (not (= (str.at x 29) "i"))))
(assert (or (= (str.at z 39) "u") (= (str.at y 55) "o") (not (str.contains x "edi"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) ".+[0-9]+$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\d{10}|\d{10})$")))))
(assert (or (= ")></co" (str.substr x 41 6)) (<= (str.len x) 71)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^@ ]{2,}@[a-zA-Z0-9_.-]+\.[a-z]{2,6}$"))))
(check-sat)
