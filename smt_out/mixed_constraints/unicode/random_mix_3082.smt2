; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp draggable=""true"" ondragend=""alert(1)"">test</samp>") (= x "<xmp id=x tabindex=1 onactivate=alert(1)></xmp>")))
(assert (or (= z "(\"";XSS\"";)>;\"";;&#039; >; out") (= z ")"" co\u{1f4a9}ntenteditable>test</isindex>") (= z "e=""alert(1)"">test</html>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "e=a" "") "vatle")) (not (str.prefixof "\x09expr" z))))
(assert (= ")></x" (str.substr y 39 5)))
(assert (or (= "S" (str.substr z 5 1)) (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{0,2000}"))) (not (= (str.at z 10) ")"))))
(assert (or (not (= "<object oncli\u{20000}ck=""alert(1<b>st</object>" (str.replace x ")"">te" "<b>"))) (= (str.at z 21) "e")))
(assert (or (not (= "tml>" (str.substr z 20 4))) (not (str.prefixof "<sa" y))))
(assert (not (str.prefixof "<samp drag" y)))
(check-sat)
