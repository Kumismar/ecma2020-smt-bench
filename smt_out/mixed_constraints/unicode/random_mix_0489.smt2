; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dl onkeypress=""alert(1)"" contenteditable>test</dl>") (= x "<dfn onbeforecopy=""alert(1)"" contenteditable>test</dfn>")))
(assert (or (= z "ex=1 id=x></template><input autofocus>") (= z "lert(1)"" contenteditable>test</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (= "<dl onkypress=""alert(1)"" contenteditable>test</dl>" (str.replace x "e" "")) (not (= "ex=1 i/template><input autofocus>" (str.replace z "d=x><" "")))))
(assert (not (= (str.indexof x "e=al" 0) 33)))
(assert (or (>= (str.len y) 86) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z - ` ~]+")))))
(assert (not (>= (str.len y) 91)))
(assert (not (= (str.indexof z "1)></" 0) 54)))
(assert (or (not (str.contains y "dfn>")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\w-]+(\.[\w-]+)*@[\w-]+(\.[\w-]+)+$"))) (= "oo" (str.substr x 2 2))))
(assert (= (str.len x) 51))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "\(\d\d\) \d\d\d\d-\d\d\d\d$")) (= (str.indexof y "py=""" 0) 15) (str.suffixof "/bdi>" z)))
(check-sat)
