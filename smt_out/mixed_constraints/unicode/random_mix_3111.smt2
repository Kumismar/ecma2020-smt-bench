; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead onmousedown=""alert(1)"">test</thead>") (= x "<section id=x tabindex=1 ondeactivate=alert(1)></section><input id=y autofocus>") (= x "<figcaption id=x tabindex=1 onbeforeactivate=alert(1)></figcaption>")))
(assert (or (= z "></isindex><input autofocus>") (= z ">") (= z "ransition:transform 2s"" ontransitionrun=alert(1)></rtc>")))
(assert (= y (str.++ x z)))
(assert (= "sedown=" (str.substr y 12 7)))
(assert (or (not (>= (str.len y) 125)) (not (str.contains z "asi")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}\u{104}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b} ]*$")))))
(assert (not (= "cti" (str.substr y 37 3))))
(assert (or (str.suffixof "tofocus>" x) (not (= (str.at y 26) "n"))))
(assert (not (= (str.at z 15) ">")))
(assert (or (not (str.suffixof "focus>" y)) (not (= (str.indexof z "in" 0) 5))))
(check-sat)
