; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;BASE HREF=\""javascript&#058;alert('XSS');//\""&gt;") (= x "<main onmouseout=""alert(1)"">test</main>")))
(assert (or (= z "t(1)"" contenteditable>test</progress>") (= z "ble>test</header>") (= z ")></hgroup>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "write()>" y)))
(assert (or (str.suffixof "eader>" y) (not (str.suffixof "/progress>" z))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%-]+@(?!(aol|outlook|alice|topnet|nerim|ovh|gmail|orange|yahoo|laposte|hotmail|wanadoo|free))([0-9A-Za-z-]+\.[0-9A-Za-z-]{2,})"))))
(assert (or (not (= "ditable>te" (str.substr y 53 10))) (str.prefixof "&lt;BASE " y)))
(assert (not (= (str.indexof y "/can" 0) 36)))
(assert (or (str.contains (str.replace z "r" "javascript:") "dejavascript:>") (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,4}$"))) (not (= (str.at x 4) "B"))))
(assert (or (not (= (str.indexof x ":red" 0) 21)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_-]{0,10}")))))
(check-sat)
