; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onbeforeload iframe onbefore\u{20000}load=""javascript:javascript:alert(1)""></iframe onbeforeload>") (= x "<big onbeforecopy=""alert(1)"" contenteditable>test</big>")))
(assert (or (= z "alert(1)"">test</dd>") (= z " contenteditable>test</map>") (= z "ofocus>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len z) 1))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^.{1,200}")) (not (str.contains z "ontente"))))
(assert (not (str.contains y "ented")))
(assert (or (str.contains y "nstar") (not (= "<javascript:onbeforecopy=""alert(1)"" contenteditable>test</big>" (str.replace x "big " "javascript:")))))
(assert (not (= (str.indexof z "ble>" 0) 13)))
(assert (or (str.suffixof "d>" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "namechk")))))
(check-sat)
