; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup draggable=""true"" ondrag=""alert(1)"">test</sup>") (= x """`'><script>\xE2\x80\x87javascript:alert(1)</script>") (= x "<div draggable=""true"" ondrag=""alert(1)"">test</div>")))
(assert (or (= z """\u{1f600}>test</listing>") (= z "ontenteditable>tes\u{1f600}t</track>") (= z "tml onmousemove>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "tedit" 0) 5) (= (str.len x) 52) (str.in_re y ((_ re.from_regex ecma2020 u) "^.+@.+\.[a-zA-Z]+$"))))
(assert (= (str.at z 0) "t"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9 _-\u{e9}\u{e8}\u{ef}\u{f6}\u{e7}]+$"))) (not (str.prefixof "<sup" x)) (not (str.contains x "ble=""true"""))))
(assert (or (str.contains z "XSS</A>") (<= (str.len x) 60)))
(assert (or (= "on" (str.substr z 4 2)) (not (<= (str.len x) 40)) (str.contains (str.replace z "able" "alert(1)") "teditalert(1)>t")))
(assert (not (str.prefixof """\u{1f600}>test</" z)))
(check-sat)
