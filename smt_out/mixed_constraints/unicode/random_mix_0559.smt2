; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noframes draggable=""true"" ondrag=""alert(1)"">test</noframes>") (= x "<style>*{x:\u{ff45}\u{ff58}\u{ff50}\u{ff52}\u{ff45}\u{ff53}\u{ff53}\u{ff49}\u{ff4f}\u{ff4e}(javascript:alert(1))}</style>")))
(assert (or (= z "rt(1)"" contenteditable>test</strike>") (= z "nblur=alert(1) tabindex=1 id=x></xmp><input autofocus>") (= z ")"">test</nav>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "=x " 0) 8)) (not (= "est" (str.substr z 4 3))) (not (= "alert(1))}" (str.substr y 33 10)))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "(((?=.*[a-z])(?=.*[A-Z])(?=.*[0-9]))|((?=.*[a-z])(?=.*[A-Z])(?=.*[!@#\\$%\\^&\\*]))|((?=.*[a-z])(?=.*[0-9])(?=.*[!@#\\$%\\^&\\*]))|((?=.*[A-Z])(?=.*[0-9])(?=.*[!@#\\$%\\^&\\*]))).{8,}$")))
(assert (= (str.indexof y "a\u{1f600}le" 0) 72))
(assert (str.contains y "alert(1)"))
(assert (or (str.prefixof "<style" x) (not (str.contains (str.replace z "t<" "<b>") "tes<b>/nav"))))
(assert (or (str.prefixof "<n" y) (not (str.contains y "mp><input ")) (= (str.indexof z "</n" 0) 7)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{c0}-\u{fa}\s]{2,50}$"))) (not (= (str.len y) 87))))
(check-sat)
