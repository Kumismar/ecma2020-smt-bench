; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT SRC=//ha.ckers.org/.j&gt;") (= x "<style>@keyframes x{}</style><legend style=""animation-name:x"" onanimationend=""alert(1)""></legend>")))
(assert (or (= z " onmouseup=""alert(1)"">test</q>") (= z "sub>") (= z "recut=""alert(1)"" contenteditable>test</time>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<dialog" x) (str.contains (str.replace z "t</q" "alert(1)") "esalert(1)>")))
(assert (or (not (= (str.indexof z "up=" 0) 8)) (<= (str.len z) 30) (not (str.prefixof "<" x))))
(assert (not (= "re<b>alert(1)"" contenteditable>test</time>" (str.replace z "cut=""" "<b>"))))
(assert (or (not (str.suffixof "/q>" z)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Z|a-z|\s-]{5,20}")))))
(assert (or (not (str.suffixof "ject>" z)) (not (= "n-nam" (str.substr y 52 5)))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z-0-9\s]*$")))
(assert (= (str.at y 19) "."))
(check-sat)
