; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u onbeforecopy=""alert(1)"" contenteditable>test</u>") (= x "<figcaption oncontextmenu=""alert(1)"">test</figcaption>")))
(assert (or (= z "ontenteditable>test</bdi>") (= z "<meta onload=alert(1)></meta>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]{3,}@[a-zA-Z.-]{3,}([.]{1}[a-zA-Z]{2,}|[.]{1}[a-zA-Z]{2,}[.]{1}[a-zA-Z]{2,})")) (= (str.indexof z "</met" 0) 22) (not (= (str.indexof y "t<" 0) 40))))
(assert (str.suffixof "a>" y))
(assert (or (not (= "ontenteditable>testalert(1)>" (str.replace z "</bdi" "alert(1)"))) (not (<= (str.len x) 107))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{8,}"))))
(assert (str.prefixof "<" z))
(assert (or (not (str.contains z "entedit")) (= (str.at z 13) "e")))
(assert (or (not (= "<meta onload=alert(1alert(1)/meta>" (str.replace z ")><" "alert(1)"))) (not (str.suffixof ">ion>" y))))
(assert (not (= (str.at z 21) "b")))
(check-sat)
