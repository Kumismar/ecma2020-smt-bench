; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select id=x tabindex=1 ondeactivate=alert(1)></select><input id=y autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><article ondragover=alert(1) contenteditable>drop here</article>") (= x "<plaintext oncontextmenu=""alert(1)"">test</plaintext>")))
(assert (or (= z " onbeforeunload=""javascript:j\u{1f4a9}avascript:alert(1)""></body onbeforeunload>") (= z "</style><a id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></a>") (= z " n=0;while(true){n++;}</script>]]>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[_a-zA-Z0-9-]+(\.[_a-zA-Z0-9-]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*(\.[a-zA-Z]{2,3})$"))))
(assert (or (not (str.prefixof " n=0;" z)) (not (= "<select id=x tabindex=1 ondalert(1)ivate=alert(1)></select><input id=y autofocus>" (str.replace x "eact" "alert(1)"))) (str.prefixof " n=0;wh" z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w.\-]{4,50}@{1}[\w.\-]{3,50}[\.]{1}[a-z]{2,3}$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9].{5,30}"))) (= (str.at y 2) "e") (not (str.suffixof "t>" x))))
(assert (not (str.prefixof "<pl" y)))
(assert (or (= (str.at z 9) "u") (not (str.contains y "div d"))))
(assert (= (str.at y 110) "n"))
(check-sat)
