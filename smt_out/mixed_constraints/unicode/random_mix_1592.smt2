; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col draggable=""true"" ondragleave=""alert(1)"">test</col>") (= x "<kbd onblur=alert(1) tabindex=1 id=x></kbd><input autofocus>") (= x "<frameset onload=javascript:javascript:alert(1)></frameset>")))
(assert (or (= z "s>") (= z "est</image>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "\u{10348}00" "<b>") "\u{10348}&#x<b>3C;")) (str.contains (str.replace y "ave" "<b>") "ragle<b>=""ale")))
(assert (or (= (str.at z 0) "e") (not (= "ol>est" (str.substr y 52 6)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[\+\s0-9]{9,13}"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(.+)@(.+)\.([a-z]{2,})$")))))
(assert (or (not (= (str.indexof x "&#x03" 0) 0)) (str.suffixof "mage>" z) (<= (str.len x) 116)))
(assert (or (str.contains x "l dragg") (= (str.at y 43) "<")))
(assert (= (str.indexof x "e""" 0) 19))
(check-sat)
