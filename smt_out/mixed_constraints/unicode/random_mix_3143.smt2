; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><tfoot onload=alert(1)></tfoot>") (= x """`'><script>\xE2\x80\x87javascript:alert(1)</script>")))
(assert (or (= z " implementation=""#default#time2"">") (= z "(1)"">test</tr>") (= z " onload=""document.vulnerable=true;"">")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "rip" 0) 7)))
(assert (or (not (str.suffixof ">" x)) (str.prefixof "op h" z) (not (= (str.at x 24) "("))))
(assert (or (str.suffixof ")>" z) (not (= (str.at y 62) "a"))))
(assert (= ">test</tr" (str.substr z 4 9)))
(assert (not (str.prefixof "(1)"">t" z)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{3}$")))
(assert (or (= (str.indexof y "al" 0) 35) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\s]+.*$")))))
(assert (= (str.len y) 106))
(check-sat)
