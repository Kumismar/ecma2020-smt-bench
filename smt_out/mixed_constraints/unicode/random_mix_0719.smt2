; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee id=x tabindex=1 onactivate=alert(1)></marquee>") (= x "<blink onmouseenter=""alert(1)"">test</blink>") (= x "<element draggable=""true"" ondragstart=""al\u{20000}ert(1)"">test</element>")))
(assert (or (= z "A&;#x61&;#x76&;#x61&;#x73&;#x63&;#x72&;#x69&;#x70&;#x74&;#x3A&;#x61&;#x6C&;#x65&;#x72&;#x74&;#x28&;#x27&;#x58&;#x53&;#x53&;#x27&;#x29>;") (= z "</style><title id=x style=""transition:color 1s"" ontransitionend=alert(1)></title>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len z) 126)))
(assert (or (= "styl" (str.substr y 84 4)) (not (str.contains x "<bli"))))
(assert (not (= (str.indexof z "tyle>" 0) 3)))
(assert (or (not (str.contains x "true"" ")) (= "<marquee id=x tabindex=1 onactivate=alert(1)></marquee>A&;#x61&;#x76&;#x61&;#x73&;#x63&;#x72&;#x69&;#x70&;#x74&;#x3A&;#x61&;#x6C&;#x65&;#x72&;#x74x8&;#x27&;#x58&;#x53&;#x53&;#x27&;#x29>;" (str.replace y "&;#x2" "x")) (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{407}\u{457}\u{406}\u{456}\u{404}\u{454}\u{490}\u{491}0-9\-\s]{5,60}$"))))
(assert (or (not (= "ue"" on" (str.substr x 22 6))) (= "le" (str.substr z 17 2))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*?[!@#$%^&*+`~'=?\|\]\[\(\)\-<>/]).{8,}"))) (not (= (str.indexof z "x72&;" 0) 34))))
(assert (or (str.contains x "=""al\u{20000}ert") (= (str.at y 88) "3")))
(check-sat)
