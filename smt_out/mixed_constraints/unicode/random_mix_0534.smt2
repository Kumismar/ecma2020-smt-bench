; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q onmouseenter=""alert(1)"">test</q>") (= x "<SCRIPT a="">"" SRC\u{10348}=""http://ha.ckers.org/xss.js""></SCRIPT>") (= x "<col onpaste=""alert(1)"" contenteditable>test</col>")))
(assert (or (= z "table>drop here</samp>") (= z "0` onerror=this.onerror=confirm(1)") (= z "ad><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len x) 40)) (not (str.contains (str.replace y " SR" "<b>") """<b>C\u{10348}=""h")) (not (= (str.indexof y "(1" 0) 19))))
(assert (or (str.prefixof "<q on" y) (not (str.contains y ">drop here"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9- ]{4,50}$"))) (str.suffixof "firm(1)" z)))
(assert (or (= " ieldset onkeydown=""alert(1)"" contenteditable>test</fieldset>onmouseout=""alert(1)"">test</element>" (str.replace y "<f" " ")) (not (= (str.len x) 50))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=^.{6,50}$)(?=.*\d)((?=.*[a-z])|(?=.*[A-Z]))(?!.*\s)[0-9a-zA-Z!@#$%*]*$"))) (not (str.suffixof "el>" y)) (str.contains (str.replace y "nfir" "") "com(1")))
(check-sat)
