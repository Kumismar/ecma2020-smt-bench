; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "</textarea><script>alert(/xss/)</script>") (= x "<A HREF=""http://%77%77%77%2E%67%6F%6F%67%6C%65%2E%63%6F%6D"">XSS</A>") (= x "&lt;A HREF=\""//www&#46;google&#46;com/\""&gt;XSS&lt;/A&gt;")))
(assert (or (= z "1 ondeactivate=alert(1)></command><input id=y autofocus>") (= z "aste=""alert(1)"" contenteditable>test</blockquote>")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "(^[?+])*[0-9]*")))
(assert (not (= "cus>" (str.substr z 52 9))))
(assert (or (not (= (str.at x 0) "<")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\s]*[\s\S]*[\S]+[\s\S]*[\s]*$"))) (>= (str.len z) 41)))
(assert (or (= (str.len z) 49) (str.prefixof "1 ondea" z)))
(assert (= "//www&#46;" (str.substr y 13 10)))
(assert (not (str.contains (str.replace y "m" "x") ";cox/")))
(check-sat)
