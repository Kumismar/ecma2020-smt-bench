(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<map onmouseup=""alert(1)"">test</map>") (= x "\u{1f4a9}<SCRIPT>document.write(""<SCRI"");</SCRIPT>PT SRC=""http://ha.ckers.org/xss.js""\u{1f600}></SCRIPT>")))
(assert (or (= z "(1)"">test</s>") (= z "=1 onactivate=alert(1)></fieldset>") (= z ")"">test</image>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "lert(1) c" (str.substr y 112 9))) (= (str.at z 14) ">")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9-]+"))) (not (= (str.indexof x "/" 0) 34)) (not (str.contains y ">pu"))))
(assert (or (not (str.prefixof ")"">test<" z)) (not (str.suffixof "ed>" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9]+$")))))
(assert (or (= (str.at y 31) ")") (not (= (str.len z) 34)) (= (str.indexof z ";" 0) 12)))
(check-sat)
