; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdi onbeforecopy=""alert(1)"" contenteditable>test</bdi>") (= x "<form id=x tabindex=1 ondeactivate=alert(1)></form><input id=y autofocus>") (= x "<dl onmouseout=""alert(1)"">test</dl>")))
(assert (or (= z ":transform 2s"" ontransitionrun=alert(1)></video>") (= z "st</source>") (= z "lor: red;}</style><html id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></html>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\+\d{1,4}|0+\d{1,5}|\(\d{1,5})[\d\s\/\(\)-]*\d+$"))) (not (= (str.at x 1) "b"))))
(assert (or (not (str.contains (str.replace z "rce>" " ") "ou ")) (= (str.indexof z "s"" o" 0) 55)))
(assert (or (not (= (str.at x 69) "c")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z. ]{2,50}")))))
(assert (or (= (str.indexof y "nmous" 0) 5) (not (= (str.at y 37) "e"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[_a-z0-9A-Z-]+(\.[_a-zA-Z0-9\+]+)*@[a-z0-9A-Z-]+(\.[a-zA-Z0-9-]+)*(\.[a-zA-Z]{2,})$"))))
(assert (not (= (str.indexof y "ource" 0) 60)))
(check-sat)
