; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<!-- IE 5-9 standards mode -->") (= x "<applet onmouseover=""alert(1)"">test</applet>") (= x "<style>:target {color: red;}</style><aside id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></aside>")))
(assert (or (= z "cus=alert(1)>") (= z "iframe onreadystatechange=alert(1)></iframe>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<dfn" x)) (= (str.at y 60) "t")))
(assert (or (not (str.suffixof "alert(1)>" y)) (not (= ">" (str.substr x 43 2)))))
(assert (str.contains (str.replace x "mo" "javascript:") "onjavascript:us"))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z][a-z'-]{1,}$"))))
(assert (not (= (str.at x 21) ":")))
(assert (not (str.suffixof "iframe>" y)))
(assert (= (str.indexof x "test" 0) 31))
(assert (or (= (str.indexof z "state" 0) 14) (str.contains x "ap") (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Z0-9]{4}")))))
(assert (str.contains z "er"))
(assert (or (not (= "cus=alert )>" (str.replace z "(1" " "))) (= (str.at x 27) "1")))
(check-sat)
