; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onblur=alert(1) tabind\u{1f4a9}ex=1 id=x></dfn><i\u{1f600}nput autofocus>") (= x "<mark oncopy=""alert(1)"" contenteditable>test</mark>")))
(assert (or (= z " onmouseenter=""alert(1)"">test</em>") (= z "c;") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "ented" 0) 28) (= ">" (str.substr z 0 1))))
(assert (or (not (str.contains (str.replace z "<" """") ">test""/h")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(0[1-9]|[12][0-9]|3[01])[- /.](0[1-9]|1[012])[- /.](19|20)\d\d$"))) (not (str.contains (str.replace y "t.v" "javascript:") "cumenjavascript:ulner"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\(?\d{2}\)?[\s-]?[\s9]?\d{4}-?\d{4}$"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9_]{17}$")) (not (str.prefixof ">" z))))
(check-sat)
