; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "*/alert(1)</script><script>/*") (= x "<map draggable=""true"" ondragend=""alert(1)"">test</map>")))
(assert (or (= z "/legend>") (= z "group id=x tabindex=1 ondeactivate=alert(1)></hgroup><input id=y autofocus>") (= z "image/gif>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^-\s][a-zA-Z\u{c0}-\u{fa} ]*"))) (str.contains z "image/gif>")))
(assert (= (str.at x 18) "u"))
(assert (or (= (str.at y 13) "c") (not (str.suffixof "l>" z))))
(assert (or (not (<= (str.len z) 32)) (not (str.contains (str.replace x "/scri" "alert(1)") ")<alert(1)pt><"))))
(assert (not (str.prefixof "*/alert" y)))
(assert (or (not (= "/lnd>" (str.replace z "ege" ""))) (not (= (str.len x) 42)) (= (str.at x 7) "(")))
(assert (not (= (str.indexof x "<inpu" 0) 55)))
(assert (or (str.contains (str.replace z "age/g" "alert(1)") "imalert(1)if>") (= (str.len x) 61)))
(check-sat)
