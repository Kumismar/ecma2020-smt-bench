; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<output onmouseup=""alert(1)"">test</output>") (= x "<style>@keyframes x{}</style><style style=""animation-name:x"" onanimationstart=""alert(1)""></style>")))
(assert (or (= z "wbr>") (= z "quot;//google&quot;&gt;XSS&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "wbr>" y))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*$"))))
(assert (or (= (str.indexof z "gle&q" 0) 10) (not (str.prefixof "<style>@ke" y))))
(assert (or (not (<= (str.len y) 31)) (not (= "<style>@keyframes x{}</style><style style=""animation-najavascript: onanimationstart=""alert(1)""></style>wbr>" (str.replace y "me:x""" "javascript:"))) (str.contains z "&g")))
(assert (str.contains (str.replace z "wbr" """") """>"))
(assert (= (str.indexof z "ot" 0) 2))
(check-sat)
