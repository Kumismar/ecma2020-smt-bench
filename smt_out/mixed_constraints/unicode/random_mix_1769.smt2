; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><ul id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></ul>") (= x "<noscrip\u{10348}t onmousedo\u{1d400}wn=""alert(1)"">test</noscript>")))
(assert (or (= z "emove=""alert(1)"">test</spacer>") (= z "aggable=""true"" contenteditable>drag me</div><dir ondragover=alert(1) contenteditable>drop here</dir>") (= z "able>test</span>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y ")"">" "<b>") "ert(1<b>test") (= (str.indexof x "m" 0) 13)))
(assert (not (= "1)>" (str.substr z 0 8))))
(assert (or (not (str.prefixof "<IMG S" y)) (= (str.at x 7) "p")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{30a1}-\u{30f3},\u{3000}]+$")) (<= (str.len z) 106)))
(assert (or (str.suffixof "cture>" x) (not (str.suffixof "est</span>" z))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9. +()]{9,}$")))
(check-sat)
