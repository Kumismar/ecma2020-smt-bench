; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section ondblclick=""alert(1)"">test</section>") (= x "<style>@keyframes x{}</style><nextid style=""animation-name:x"" onanimationend=""alert(1)""></nextid>")))
(assert (or (= z "tion-name:x"" onanimationend=""alert(1)""></html>") (= z "tofocus>") (= z "TYLE="";background-image: url(javascript:alert(';XSS';))"";>;")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<s" y))
(assert (or (str.prefixof "<st" x) (>= (str.len x) 42)))
(assert (or (str.contains x "</") (not (= "__^" (str.substr x 50 4)))))
(assert (or (str.contains (str.replace z "vas" "x") "(jaxcri") (not (= "TYLE="";backgroun<b>mage: url(javascript:alert(';XSS';))"";>;" (str.replace z "d-i" "<b>")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "https[A-Za-z0-9:_.\-/\x22,\x27]{1,620}"))) (not (str.suffixof "dow>" y)) (not (>= (str.len y) 99))))
(assert (>= (str.len x) 88))
(check-sat)
