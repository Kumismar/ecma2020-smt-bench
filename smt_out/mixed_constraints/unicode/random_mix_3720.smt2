; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><ol ondragover=alert(1) contenteditable>drop here</ol>") (= x "<iframe onload iframe onload=""javascript:javascript:alert(1)""></iframe onload>") (= x "top['al\145rt'](1)")))
(assert (or (= z ":javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "alert(1)"" contenteditable>test</code>") (= z " ^__^")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 29) "t") (not (= (str.indexof y "ata" 0) 2)) (= (str.at z 9) " ")))
(assert (<= (str.len z) 5))
(assert (or (str.prefixof "<div dr" y) (str.contains z "t(1")))
(assert (or (not (str.contains (str.replace z "__^" "x") " ^x")) (not (str.suffixof "code>" z))))
(assert (or (not (= (str.indexof y "zzele" 0) 46)) (not (str.contains y "me onl"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[\D0-9]{3,20}|$"))) (not (= (str.at x 4) "'"))))
(check-sat)
