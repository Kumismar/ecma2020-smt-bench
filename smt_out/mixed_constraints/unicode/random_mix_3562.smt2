; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x07javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<style>@keyfr\u{1f600}ames x{}</style\u{10348}><frame style=""animation-name:x"" onanimationend=""alert(1)""></frame>")))
(assert (or (= z "index=1 onactivate=alert(1)></tr>") (= z "t</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "/b" "<b>") "t<<b>d") (not (= (str.len x) 97))))
(assert (= (str.at x 6) "f"))
(assert (or (>= (str.len y) 127) (str.contains (str.replace z "=1" "alert(1)") "indexalert(1) on")))
(assert (or (not (= (str.len y) 104)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*(_|[^\w])).{8,50}$"))) (str.contains (str.replace y " id" """") "(1)""""=""f")))
(check-sat)
