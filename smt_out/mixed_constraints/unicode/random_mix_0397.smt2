; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<font onkeypress=""alert(1)"" contenteditable>test</font>") (= x "<summary id=x tabindex=1 ondeactivate=alert(1)></summary><input id=y autofocus>") (= x "<style>:target {color:red;}</style><applet id=x style=""transition:color 1s"" ontransitionend=alert(1)></applet>")))
(assert (or (= z "ex=1 id=x></output><input autofocus>") (= z """/>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "ontra" 0) 76) (str.in_re z ((_ re.from_regex ecma2020 u) "^.{5}$"))))
(assert (not (= (str.at x 63) "o")))
(assert (= (str.at y 83) "t"))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^\w+([.-]?\w+)*@\w+([.-]?\w+)*(.\w{2,3})+$")) (not (= "rget {c" (str.substr x 10 7)))))
(assert (not (str.prefixof "<summary " y)))
(assert (or (not (>= (str.len z) 31)) (= "/>" (str.substr z 1 2))))
(assert (or (str.contains y "<summary i") (not (= (str.at y 37) "i"))))
(assert (<= (str.len x) 63))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z\u{e1}\u{e9}\u{171}\u{151}\u{fa}\u{f3}\u{fc}\u{f6}\u{ed}\u{c1}\u{c9}\u{170}\u{da}\u{150}\u{d3}\u{dc}\u{d6}\u{cd}\s\-]{4,}"))))
(check-sat)
