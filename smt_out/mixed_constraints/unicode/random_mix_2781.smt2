; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<!-- Up to Opera 11.64 - see link below -->") (= x "<base oncontextmenu=""alert(1)"">test</base>")))
(assert (or (= z "/cite>") (= z "er onkeydown=""alert(1)"" contenteditable>test</center>") (= z "ert(1) contenteditable>drop here</nav>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{3,25}$"))) (= (str.at z 41) "e")))
(assert (or (str.contains (str.replace y "t" "x") "Up xo ") (= "table>" (str.substr z 17 6)) (not (= (str.indexof y " type" 0) 59))))
(assert (or (not (str.suffixof "re</nav>" z)) (= (str.indexof z "/del>" 0) 1)))
(assert (= (str.at x 45) "s"))
(assert (or (= "<base oncontextmenu=""alert(1javascript:test</base>" (str.replace x ")"">" "javascript:")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{1}$")))))
(check-sat)
