; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><frame ondragover=alert(1) contenteditable>drop here</frame>") (= x "<div style=""background:url(test5.svg)"">PRESS ENTER</div>//[""'`-->]]>]</div>")))
(assert (or (= z ")"" contenteditable>test</multicol>") (= z "e;"">")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "e;" "<b>") "<b>"">") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z]{1,}[A-Za-z0-9@#%&* ]*$"))) (str.contains (str.replace y "/spa" "") "<n>tes")))
(assert (not (>= (str.len x) 66)))
(assert (or (not (str.suffixof "</frame>" x)) (not (str.prefixof "<div" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*?[1-9])\d{7,8}(\.\d+)?$")))))
(assert (or (str.contains x "=x tabi") (not (str.suffixof "col>" y))))
(assert (or (not (= ">" (str.substr z 23 1))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[- _.A-z0-9\u{c0}-\u{ff}]{2,}$"))) (str.contains y "ontentedi")))
(check-sat)
