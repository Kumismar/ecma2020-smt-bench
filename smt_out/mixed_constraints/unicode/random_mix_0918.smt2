; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe/%00/ src=javaSCRIPT&colon;alert(1)") (= x "<u onclick=""alert(1)"">test</u>")))
(assert (or (= z "bdi>") (= z "pt:alert(1)""></body>") (= z "lert(1)"">test</em>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "me/%00/ " (str.substr x 5 8))) (str.contains (str.replace x "co" "") "1)"" n")))
(assert (not (<= (str.len x) 37)))
(assert (or (<= (str.len z) 12) (str.suffixof ")" x)))
(assert (or (not (str.prefixof "<u" y)) (not (str.contains y "1)")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[^/%:$&1234567890.\u{438}\u{434}\u{41f}\u{43b}\u{413}\u{44f}\u{416}\u{433}]*")))))
(assert (or (str.contains x ">test</o") (not (str.contains x "ick=""al"))))
(assert (or (str.prefixof "<u o" y) (not (str.suffixof ">" y))))
(check-sat)
