; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<command id=x tabindex=1 onfocus=alert(1)></command>") (= x "<noframes id=x tabindex=1 ondeactivate=alert(1)></noframes><input id=y autofocus>")))
(assert (or (= z "rget {color: red;}</style><article id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></article>") (= z "font>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "font>" y))
(assert (or (not (str.prefixof "<nofram" y)) (= (str.indexof z " red" 0) 12)))
(assert (or (not (str.suffixof "nt>" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[5]+$"))) (= "ntent>" (str.substr z 37 6))))
(assert (or (not (= (str.indexof z "io" 0) 54)) (= (str.at y 68) "=")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z.-]+\.[a-z]{2,}$"))) (not (>= (str.len y) 81))))
(assert (or (= (str.len z) 35) (str.contains z "font>") (not (>= (str.len z) 1))))
(check-sat)
