; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><sub style=""animation-name:x"" onanimationstart=""alert(1)""></sub>") (= x "<span onbeforepaste=""alert(1)"" contenteditable>test</span>")))
(assert (or (= z """ ondragend=""alert(1)"">test</nobr>") (= z "nvas onmouseleave=""alert(1)"">test</canvas>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace z "va" " ") "n s on"))
(assert (or (str.contains y "x"" o") (not (= (str.indexof y "nd=""a" 0) 67)) (str.in_re x ((_ re.from_regex ecma2020 u) "^Nom$"))))
(assert (or (= (str.at z 39) "a") (str.suffixof "T>" y) (= (str.at y 91) ">")))
(assert (or (>= (str.len z) 32) (not (str.prefixof "<sp" x)) (not (= "yframes " (str.substr x 10 8)))))
(assert (str.contains y "nbefor"))
(check-sat)
