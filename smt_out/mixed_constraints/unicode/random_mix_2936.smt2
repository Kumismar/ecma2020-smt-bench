; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem ondblclick=""alert(1)"">test</menuitem>") (= x "<label id=x tabindex=1 onbeforedeactivate=alert(1)></label><input autofocus>") (= x "<html onmous\u{20000}eover=""alert(1)"">t\u{20000}est</html>")))
(assert (or (= z "d;}</style><ul id=x style=""transition:color 1s"" ontransitionend=alert(1)></ul>") (= z "(1)"">DEF")))
(assert (= y (str.++ x z)))
(assert (or (= "LOWSRC=" (str.substr x 5 7)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9 +][0-9 ()-]+")) (not (str.contains (str.replace x "x=1 " """") "nde""o"))))
(assert (str.contains z "ert(1"))
(assert (not (str.contains (str.replace y "e" "x") "bxl")))
(assert (= """>te" (str.substr x 30 4)))
(assert (or (not (str.contains (str.replace y "befo" "alert(1)") "nalert(1)re")) (str.prefixof "<" y) (= "l" (str.substr z 65 1))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e0}-\u{fa}\u{c0}-\u{da} ]{3,}$"))) (<= (str.len z) 15)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{3041}-\u{3093}\u{30a1}-\u{30f6}\u{30fc}\s\u{5c}u3000]+$"))))
(check-sat)
