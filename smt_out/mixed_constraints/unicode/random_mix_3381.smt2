; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<small draggab\u{20000}le=""true"" ondragstart=""alert(1)"">te\u{20000}st</small>") (= x "<acronym onmouseup=""alert(1)"">test</acronym>") (= x "<svg draggable=""true"" ondragleave=""alert(1)"">test</svg>")))
(assert (or (= z "gcaption>") (= z "load=""javascript:alert(1)"">") (= z "rt(1)"" contenteditable>test</del>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len x) 44))
(assert (not (= "svg>" (str.substr x 51 7))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z\s]+$"))) (not (str.suffixof "</acronym>" x)) (not (= (str.indexof z "3" 0) 0))))
(assert (str.contains (str.replace y "e=""" "<b>") "\u{20000}l<b>tru"))
(assert (or (not (= "<small draggab\u{20000}le=e"" ondragstart=""alert(1)"">te\u{20000}st</small>load=""javascript:alert(1)"">" (str.replace y """tru" ""))) (not (<= (str.len x) 63))))
(assert (or (= (str.at z 19) "b") (not (<= (str.len y) 65)) (= "n>" (str.substr z 7 8))))
(assert (or (not (str.prefixof """f" z)) (str.prefixof "rt" z)))
(check-sat)
