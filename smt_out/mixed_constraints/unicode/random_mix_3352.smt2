; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer onfocusout=alert(1) tabindex=1 id=x></footer><input autofocus>") (= x "<blink id=x tabindex=1 onbeforedeactivate=alert(1)></blink><input autofocus>")))
(assert (or (= z "SRC=\""javascript:alert('XSS')\"">") (= z "k>") (= z "rameset>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len y) 98))
(assert (or (not (= (str.len x) 76)) (not (= (str.indexof x "ut " 0) 57)) (str.contains y "er onfo")))
(assert (str.contains (str.replace y "ript" "<b>") "c<b> xli"))
(assert (or (= (str.indexof y "</sm" 0) 35) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{2,4}-\d{3,4}-\d{3,4}$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9]{4,4}"))))
(assert (or (not (= (str.indexof x "p" 0) 56)) (= "rt(1) tab" (str.substr x 22 9)) (not (= (str.at x 8) "d"))))
(assert (or (<= (str.len y) 108) (not (str.suffixof "XSS')\"">" y))))
(check-sat)
