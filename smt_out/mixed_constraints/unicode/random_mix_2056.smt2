; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure onmouseup=""alert(1)"">test</figure>") (= x "<source onmouseenter=""alert(1)"">test</source>") (= x "<frameset onbeforepaste=""alert(1)"" contenteditable>test</frameset>")))
(assert (or (= z "NK REL=""stylesheet"" HREF=""javascript:javascript:alert(1);"">") (= z "get {transform: rotate(180deg);}</style><tr id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tr>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "'X" "x") "t(xSS")) (not (str.prefixof "get {" z))))
(assert (= (str.indexof z "avas" 0) 27))
(assert (not (= (str.indexof x "e" 0) 5)))
(assert (or (not (= (str.indexof y "(1);" 0) 98)) (not (str.suffixof "re>" x))))
(assert (or (str.suffixof ")](1)" y) (not (= (str.at x 76) "u"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{3}-[0-9]{4}$"))) (not (str.suffixof "r>" z))))
(assert (or (not (str.contains (str.replace y "e" " ") "m set")) (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 ]{1,32}"))))
(assert (or (= (str.at z 24) "=") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\-]{10,20}$")))))
(check-sat)
