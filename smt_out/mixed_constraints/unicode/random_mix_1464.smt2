; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 draggable=""true"" ondragleave=""alert(1)"">test</h1>") (= x "<div datafld=""b"" dataformatas=""html"" datasrc=""#X""></div>") (= x "<div draggable=""true"" contenteditable>drag me</div><label ondragover=alert(1) contenteditable>drop here</label>")))
(assert (or (= z "lert(1)"">test</listing>") (= z "le>test</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "st</h1" (str.substr x 46 6))) (not (str.suffixof ">" x))))
(assert (or (= ">test</" (str.substr y 64 7)) (= (str.indexof z "e" 0) 1)))
(assert (or (str.contains (str.replace y "v" "") "di d") (not (str.suffixof "</meta>" y))))
(assert (or (str.suffixof "est</bdi>" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "['a-zA-Z0-9-#&+,@!.() ]{2,60}")))))
(check-sat)
