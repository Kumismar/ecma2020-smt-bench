; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source onmouseout=""alert(1)"">test</source>") (= x "<embed onkeydown=""alert(1)"" contenteditable>test</embed>") (= x "<abbr onclick=""alert(1)"">test</abbr>")))
(assert (or (= z "vascri\u{1f600}\u{1f4a9}pt:alert(1)</script>") (= z "t(1)></nextid>") (= z "ols autoplay onended=alert(1)><source src=""validaudio.wav"" type=""audio/wav""></audio>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(?=^.{8,}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$")) (not (>= (str.len z) 77)) (str.contains z " xmlns:xs")))
(assert (not (str.suffixof "o>" y)))
(assert (= (str.indexof z "ed" 0) 18))
(assert (or (= (str.at z 8) "p") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([0-9]{11})?$"))) (= "dau" (str.substr z 47 3))))
(assert (or (not (str.prefixof "<ruby i" y)) (= (str.at y 56) "a")))
(assert (or (not (str.prefixof "ols autop" z)) (not (= (str.at x 40) "a")) (= "t(1)" (str.substr x 19 4))))
(assert (or (not (= "tes" (str.substr y 44 3))) (= (str.indexof x " on" 0) 5)))
(check-sat)
