; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#13;<blink/&#13; onmouseover=pr&#x6F;mp&#116;(1)>OnMouseOver {Firefox & Opera}") (= x "<body onload=""document.vulnerable=true;"">") (= x "<basefont onkeyup=""alert(1)"" contenteditable>test</basefont>")))
(assert (or (= z """>test\u{20000}</option>") (= z "e src=""http://example.com/"" style=""width:800px; height:350px; border:none; mask: url(#maskForClickjacking);""/>") (= z "col>")))
(assert (= y (str.++ x z)))
(assert (or (= "tion>" (str.substr z 11 8)) (>= (str.len x) 39)))
(assert (or (not (str.prefixof "<body o" x)) (not (str.contains y "fox & "))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^([\w-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,12}(?:\.[a-z]{2})?)$")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "/^13[0-9]{9}$|14[0-9]{9}|15[0-9]{9}$|18[0-9]{9}$/")) (= "ocum" (str.substr x 15 4))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((0[1-9])|([1-8][0-9])|(9[0-8])|(2A)|(2B))[0-9]{3}$"))))
(assert (= (str.len x) 41))
(assert (or (str.contains z "=""htt") (= (str.indexof x "r {" 0) 60) (str.prefixof "e s" z)))
(check-sat)
