; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<spacer d\u{1d400}raggable=""true"" ondrag=""alert(1)"">test</spacer>") (= x "<style type=""text/css"">BODY{background:url(""javascript:document.vulnerable=true"")}</style>") (= x "<form><input oninvalid=alert(1) required><input type=submit>")))
(assert (or (= z "1)"">test</time>") (= z "ert(1)"">test</td>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<style" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\f\n\r\t\v]{2,44}$"))) (not (str.suffixof "ofocus>" y))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{4}-\d{2}-\d{2}$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^1[35478][0-9]{9}$"))) (not (= (str.at z 4) "o"))))
(assert (not (str.suffixof "st</time>" y)))
(assert (or (= (str.indexof z "est</" 0) 5) (str.suffixof "t</td>" y)))
(check-sat)
