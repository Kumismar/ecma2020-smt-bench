; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup onmousedown=""alert(1)"">test</colgroup>") (= x "<article onbeforecut=""alert(1)"" contenteditable>test</article>")))
(assert (or (= z ">test</head>") (= z "('hellox worldss')>")))
(assert (= y (str.++ x z)))
(assert (not (= "<style>:target {color: red;}</style><col id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></colgroup>index=1 ondeactivate=alert(1)></script><input id=y autofocus>" (str.replace y "group" ""))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^1((3|5|8){1}\d{1}|70|77)\d{8}$"))))
(assert (or (not (= (str.len z) 12)) (not (= (str.at y 21) "=")) (not (= (str.at x 27) "t"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s]{1,50})$"))) (not (str.suffixof "le>" x)) (not (= (str.indexof x "e" 0) 7))))
(assert (not (<= (str.len x) 48)))
(check-sat)
