; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite id=x tabindex=1 ondeactivate=alert(1)></cite><input id=y autofocus>") (= x "<colgroup onpaste=""alert(1)"" contenteditable>test</colgroup>") (= x "<svg><animatetransform onend=alert(1) attributeName=transform dur=1s>")))
(assert (or (= z "/output>") (= z "ontenteditable>test</picture>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ">" y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\d[\s-]?)?[\(\[\s-]{0,2}?\d{3}[\)\]\s-]{0,2}?\d{3}[\s-]?\d{4}$"))) (not (str.prefixof "(1)""" z))))
(assert (= (str.at y 68) ">"))
(assert (= "e>t" (str.substr z 13 3)))
(assert (not (str.contains x "ex=1 o")))
(assert (or (not (str.contains y "tributeNam")) (str.suffixof "picture>" z) (not (= "t(1) a" (str.substr y 33 6)))))
(check-sat)
