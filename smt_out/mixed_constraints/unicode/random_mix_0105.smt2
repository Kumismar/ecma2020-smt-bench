; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist oncontextmenu=""alert(1)"">test</datalist>") (= x "<kbd draggable=""true"" ondragend=""alert(1)"">test</kbd>")))
(assert (or (= z "/kbd>") (= z "/style><iframe style=""animation-name:x"" onanimationend=""alert(1)""></iframe>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 131) (not (= (str.at z 30) "S"))))
(assert (not (= "st oncont" (str.substr y 7 9))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "((\+\d{1,3}(-|.| )?\(?\d\)?(-| |.)?\d{1,5})|(\(?\d{2,6}\)?))(-|.| )?(\d{3,4})(-|.| )?(\d{4})(( x| ext)\d{1,5}){0,1}$"))) (str.contains z "bd>") (str.prefixof "<kbd dr" y)))
(assert (str.contains z "ame s"))
(assert (or (str.suffixof "</iframe>" y) (= (str.at y 31) "=")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^\w+[-\.\w]*@(?!(?:gmail|yahoo|hotmail|aol|msn|live|rediffmail|ymail|outlook|googlemail|bigpond|rocketmail|facebook|sky|qq|mail|ntlworld|juno|mac|aim\.com$)|(?:comcast|cox|sbcglobal|verizon|att|laposte|bellsouth|charter|earthlink|optonline|gmx|frontiernet|windstream|centurytel\.net$)|(?:hotmail|yahoo|wanadoo|orange|free|sfr|live|neuf|aliceadsl|voila|club-internet\.fr)|(?:yahoo|terra\.com.br)|(?:hotmail|yahoo|live|tiscali|blueyonder\.co.uk)|(?:gmx|web|yahoo|hotmail|freenet|t-online|arcor\.de)|(?:yahoo|shaw|sympatico|live\.ca)|(?:chello|hetnet|home|live|planet|zonnet|\.nl)|(?:alice|hotmail|libero|live|tin|tiscali|virgilio|yahoo\.it)|(?:mail|rambler|yandex\.ru)|(?:skynet|telenet\.be)|(?:bluewin\.ch)|(?:hotmail\.es)|(?:live|yahoo|optusnet\.com.au)|(?:yahoo\.co.id)|(?:yahoo\.co.jp)|(?:yahoo\.com.ar)|(?:yahoo\.com.mx)|(?:yahoo\.com.sg)|(?:yahoo\.es)|(?:yahoo\.in))\w+[-\.\w]*?\.\w{2,10}$")) (not (str.prefixof "<kbd dragg" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[\D ]+")))))
(assert (or (str.contains y "ndra") (= (str.at y 25) "a") (str.prefixof "<dat" y)))
(check-sat)
