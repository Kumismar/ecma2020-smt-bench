; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dir draggable=""true"" ondragenter=""alert(1)"">test</dir>") (= x "<listing ondblclick=""alert(1)"">test</listing>") (= x "<nextid onkeydown=""alert(1)"" contenteditable>test</nextid>")))
(assert (or (= z "itable>test</xmp>") (= z "do><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<listing o" y)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[\s()+-]*([0-9][\s()+-]*){6,20}$"))))
(assert (= ">""ale" (str.substr y 39 5)))
(assert (str.contains (str.replace x "dex=" "x") "inx1 ond"))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z]+@{1}[A-Za-z]+\.{1}[A-Za-z]{2,}$")))
(assert (or (not (str.suffixof "est</xmp>" y)) (not (= ">tes" (str.substr y 51 4))) (str.prefixof "<nextid " y)))
(assert (or (not (= (str.indexof x "ac" 0) 32)) (not (str.suffixof "ng>" x))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+"))))
(check-sat)
