; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote onpaste=""alert(1)"" contenteditable>test</blockquote>") (= x "<dfn draggable=""true"" ondragstart=""alert(1)"">test</dfn>")))
(assert (or (= z "igcaption>") (= z "ACKGROUND=\""javascript&#058;alert('XSS')\""&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "n>" y) (not (= "k" (str.substr y 57 1))) (not (str.contains x "quote>"))))
(assert (or (not (= (str.indexof y "t" 0) 15)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[^@]+@[^@\.]+\.[^@]+$"))))
(assert (or (not (>= (str.len z) 2)) (str.prefixof "<block" y)))
(assert (or (not (= ")" (str.substr y 94 1))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s]{3,}$")))))
(assert (or (not (str.suffixof "y>" z)) (>= (str.len x) 50)))
(assert (or (not (str.suffixof "gcaption>" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{2}[A-Za-z0-9 ]*$")))))
(assert (str.contains z """javasc"))
(check-sat)
