; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onreset=""alert(String.fromCharCode(88,83,83))"">") (= x "<div draggable=""true"" contenteditable>drag me</div><hr ondrop=alert(1) contenteditable>drop here</hr>")))
(assert (or (= z "</base>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "tedit" "x") "enxable")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{1,2}[-][0-9]{1,2}[-][0-9]{4}$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{1,9}$"))) (str.suffixof "tid>" z)))
(assert (or (not (= "<div draggable=""true"" contenteditable>drag ""div><hr ondrop=alert(1) contenteditable>drop here</hr>" (str.replace x "me</" """"))) (= "</m" (str.substr y 112 3))))
(assert (or (not (= (str.indexof x "le>d" 0) 35)) (= (str.indexof x "bl" 0) 11)))
(assert (or (str.suffixof ":alert(1)>" x) (not (str.prefixof "<" x))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[0-9])(?=.*[a-z])(?=.*[A-Z]).{8,}"))))
(assert (= (str.indexof y "</" 0) 45))
(check-sat)
