; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><img src=x onerror=javascript:alert(""A"")>") (= x "<h1 onmousemove=""alert(1)"">test</h1>") (= x "<multicol onclick=""alert(1)"">test</multicol>")))
(assert (or (= z "s>") (= z "&#58;//ha&#46;ckers&#46;org/scriptlet&#46;html\""&gt;&lt;/LAYER&gt;")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 18) (not (<= (str.len x) 46)) (str.contains x "(""A"")")))
(assert (or (str.contains y "usemove") (= (str.at y 31) ":")))
(assert (or (str.contains x "rt(1)"" co") (not (str.suffixof "LAYER&gt;" z))))
(assert (or (not (= "s>" (str.substr z 0 4))) (= (str.indexof x "us" 0) 8)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "((?=.*\w)(?=.*[0-9]).{8,})"))) (not (= "s>" (str.substr z 0 2))) (not (= (str.at y 77) "t"))))
(assert (str.suffixof "lticol>s>" y))
(check-sat)
