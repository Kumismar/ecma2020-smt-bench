; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><blockquote ondragover=alert(1) contenteditable>drop here</blockquote>") (= x "<table draggable=""true"" ondragleave=""alert(1)"">test</table>")))
(assert (or (= z "/fieldset>") (= z "g/&#46;js&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "st</v" " ") """>te ide")) (not (= "<table draggable=""true"" ondrae=""alert(1)"">test</table>/fieldset>" (str.replace y "gleav" "")))))
(assert (or (not (= (str.len z) 13)) (<= (str.len z) 23)))
(assert (= (str.at z 5) "d"))
(assert (str.prefixof "<div dra" y))
(assert (or (str.contains x "e=""true"" ") (str.in_re z ((_ re.from_regex ecma2020 u) "(?=^[A-Za-z0-9]{6,12}$)((?=.*[A-Z])(?=.*[a-z])(?=.*[0-9]))^.*$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9A-Z]{5}")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}"))) (str.contains x "ckqu") (str.contains (str.replace x "/d" " ") " me< iv>")))
(assert (not (= (str.indexof x "dex=" 0) 29)))
(assert (or (not (str.prefixof "/f" z)) (str.prefixof "/fieldset>" z)))
(check-sat)
