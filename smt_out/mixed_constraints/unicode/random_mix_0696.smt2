; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset onclick=""alert(1)"">test</frameset>") (= x "<shadow draggable=""true"" ondragleave=""alert(1)"">test</shadow>")))
(assert (or (= z "d;}</style><tt id=x style=""transition:color 1s"" ontransitionend=alert(1)></tt>") (= z ")></pre>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 2) "<") (not (= "y on ck=""alert(1)"">test</summary>" (str.replace z "cli" " ")))))
(assert (not (= (str.indexof z ")></" 0) 0)))
(assert (= (str.indexof y "t" 0) 19))
(assert (or (str.contains (str.replace y "lor " "") "on:co1") (= (str.at y 0) "<") (str.prefixof "<figure on" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((\+)?(\d{2}[-]))?(\d{10}){1}?$"))) (not (= (str.at y 43) "(")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9\+]+")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z\W\s-]+$"))))
(check-sat)
