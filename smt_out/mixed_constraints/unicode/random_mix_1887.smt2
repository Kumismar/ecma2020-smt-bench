; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><link id=x style=""transition:color 1s"" ontransitionend=alert(1)></link>") (= x "<script src=""data:&comma;alert(1)//")))
(assert (or (= z "rt(1)></map>") (= z "vg><image href=1 onerror=alert(1)>") (= z "dex=1 id=x></param><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9-+\s()]{7,}$")) (= "ul" (str.substr y 31 2)) (not (str.prefixof "vg><im" z))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[^-\s][a-zA-Z0-9_\s-]+$")))
(assert (not (str.prefixof "<sc" x)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^\d[0-9]{9,11}$")))
(assert (not (>= (str.len x) 97)))
(assert (or (not (= (str.indexof y "am>" 0) 51)) (not (= "g><image" (str.substr z 1 8)))))
(assert (or (not (= (str.indexof x "t=""al" 0) 14)) (str.contains (str.replace y "ara" "<b>") "</p<b>m><i") (not (<= (str.len z) 13))))
(assert (str.suffixof "nvas>" y))
(check-sat)
