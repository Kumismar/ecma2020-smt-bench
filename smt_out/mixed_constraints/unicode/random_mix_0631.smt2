; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><meter style=""animation-name:x"" onanimationstart=""alert(1)""></meter>") (= x "<x%0Conxxx=1")))
(assert (or (= z "t""; HREF="";http://ha.ckers.org/xss.css"";>;") (= z "ert(1)"">test</track>") (= z "D SRC="";http://ha.ckers.org/xss.swf""; AllowScriptAccess="";always"";>;<;/EMBED>;")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 82) (= (str.indexof x "t(1)""" 0) 22) (not (str.suffixof "meter>" x))))
(assert (= "< %0Conxxx=1t""; HREF="";http://ha.ckers.org/xss.css"";>;" (str.replace y "x" " ")))
(assert (or (not (= (str.at z 12) "<")) (str.suffixof ">;" y)))
(assert (or (str.prefixof "ert(1)"">t" z) (not (= ";" (str.substr z 41 3))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]")))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) ".{20,22}")) (not (= (str.indexof z "=" 0) 0))))
(assert (or (not (= " onf" (str.substr z 8 4))) (str.prefixof "<nof" y)))
(check-sat)
