; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist onmouseleave=""alert(1)"">test</datalist>") (= x "<FRAMESET><FRAME SRC=""javascript:document.vulnerable=true;""></frameset>")))
(assert (or (= z ">") (= z "=alert(1)></ruby>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 15) "y")) (str.in_re y ((_ re.from_regex ecma2020 u) "\d*(\.\d+)?"))))
(assert (not (str.prefixof "<i " x)))
(assert (or (not (str.suffixof "></ruby>" y)) (not (= "<FRAMESET><FRAME SRC=""javascript:document.vunerable=true;""></frameset>" (str.replace x "l" "")))))
(assert (or (= (str.at x 66) "e") (not (= ">test<" (str.substr z 11 6))) (not (= (str.at y 3) "A"))))
(assert (or (not (str.suffixof "alist>>" y)) (str.prefixof "<" y)))
(check-sat)
