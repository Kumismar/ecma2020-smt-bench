; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form onmouseup=""alert(1)"">test</form>") (= x "<style>:target {color: red;}</style><footer id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></footer>") (= x "<image onmousemove=""alert(1)"">test</image>")))
(assert (or (= z "ondragend=""alert(1)"">test</th>") (= z "LE=""behavior: url(%(htc)s);"">")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x "onmousemo")))
(assert (= "<form onmouseup=""alert(x>test</form>" (str.replace x "1)""" "x")))
(assert (= (str.at x 2) "l"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^0[0-9]{8,9}"))) (not (<= (str.len z) 40))))
(assert (or (not (= " 10s"" ont" (str.substr y 72 9))) (= (str.at x 33) "t")))
(assert (or (= (str.indexof z "lert(" 0) 12) (not (str.prefixof "<center" y)) (str.suffixof "r>" y)))
(assert (str.contains (str.replace x "r" " ") "<fo m o"))
(assert (or (= (str.indexof y "ock" 0) 41) (= (str.indexof y "bod" 0) 2)))
(assert (str.contains (str.replace z "a" "alert(1)") "n=alert(1)l"))
(check-sat)
