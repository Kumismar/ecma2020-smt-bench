; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style draggable=""true"" ondragenter=""alert(1)"">test</style>") (= x "<source ondblclick=""alert(1)"">test</source>")))
(assert (or (= z "font>") (= z """>test</article>") (= z "rt(1)>double click this!")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 19) "r") (= (str.at x 17) """") (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9\W]+@[a-zA-Z0-9\W]+\.[a-zA-Z0-9-.]+$"))))
(assert (or (str.suffixof "rce>" x) (str.prefixof "<style " y)))
(assert (or (str.suffixof "source>" x) (not (str.prefixof "<s" x))))
(assert (or (not (= (str.len y) 97)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df};\.\s\-]+"))) (str.prefixof "<sty" y)))
(assert (str.suffixof "/b>" x))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{3,5}$"))) (str.contains x "style d")))
(check-sat)
