; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;XML ID="";xss"";>;<;I>;<;B>;<;IMG \u{1f600}SRC="";jav\u{20000}as<;!-- -->;cript:alert(';XSS';)"";>;<;/B>;<;/I>;<;/XML>;") (= x "<caption onmouseup=""alert(1)"">test</caption>")))
(assert (or (= z ";<;/SCRIPT>;") (= z "ttp://ha.ckers.org@google&quot;&gt;XSS&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z\u{e1}\u{e9}\u{ed}\u{f3}\u{f6}\u{151}\u{fc}\u{171}\u{fa}A-Z\u{c1}\u{c9}\u{cd}\u{d3}\u{d6}\u{150}\u{dc}\u{170}\u{da}\. ]{3,}"))))
(assert (or (= (str.indexof x "table" 0) 43) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0789][0-9]{9}"))) (not (= (str.at x 0) "<"))))
(assert (or (not (str.suffixof "&lt;/A&gt;" y)) (= "IMG" (str.substr x 30 3)) (str.suffixof "tion>" x)))
(assert (not (str.suffixof "content>" z)))
(assert (or (not (str.contains z "/SCR")) (str.contains x ";<;/XML>")))
(check-sat)
