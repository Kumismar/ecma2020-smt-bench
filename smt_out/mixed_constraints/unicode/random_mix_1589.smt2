; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title onpropertychange=javascript:alert\u{1f4a9}(1)></title><ti\u{1d400}tle title=>") (= x "<style>:target {transform: rotate(180deg);}</style><header id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></header>")))
(assert (or (= z "ea onmouseleave=""alert(1)"">test</area>") (= z "ert(1)"" contenteditable>test</output>")))
(assert (= y (str.++ x z)))
(assert (str.contains y "2s"" "))
(assert (not (str.prefixof "<st" y)))
(assert (not (= "le>:target" (str.substr x 4 10))))
(assert (or (not (str.suffixof "</area>" z)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "([A-z0-9_.-]{3,20})"))) (not (str.contains x "ascr"))))
(assert (not (>= (str.len z) 25)))
(assert (or (not (>= (str.len x) 120)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{6,20}$")) (not (str.contains y "t(("))))
(check-sat)
