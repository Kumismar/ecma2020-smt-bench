; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<com\u{1d400}mand oncopy=""\u{20000}alert(1)"" contenteditable>test</command>") (= x "<noframes onmouseenter=""alert(1)"">test</noframes>") (= x "<a oncut=""alert(1)"" contenteditable>test</a>")))
(assert (or (= z "itable>drop here</address>") (= z "me:x"" onanimationstart=""alert(1)""></mark>") (= z "nanimationend=""alert(1)""></track>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "itab" 0) 35))
(assert (= "<noframes onmouseenter=""alert(1)"">test</noframes>nanialert(1)nend=""alert(1)""></track>" (str.replace y "matio" "alert(1)")))
(assert (not (str.prefixof "<svg\u{1f600}><s " y)))
(assert (or (not (= "<noframes onmouseent alert(1)"">test</noframes>" (str.replace x "er=""" " "))) (not (= (str.indexof z "nanim" 0) 0)) (not (>= (str.len z) 33))))
(assert (or (not (str.contains z "ddre")) (not (= (str.indexof z ">" 0) 35)) (not (str.contains z "(1)"))))
(assert (not (= "ble>drop h" (str.substr z 3 10))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^([\w\.\-]+)@([\w\-]+)((\.(\w){2,3})+)$")) (<= (str.len y) 82) (not (str.prefixof "me:x"" " z))))
(check-sat)
