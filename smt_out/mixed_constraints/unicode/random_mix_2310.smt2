; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onafterprint=alert(1)>") (= x "&#x003c;")))
(assert (or (= z "(1)""></embed>") (= z "onmouseover=""alert(1)"">test</picture>") (= z "tabindex=1 id=x></listing><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "ture>" y) (= "(1)""></em >" (str.replace z "bed" " "))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([+]+)*[0-9\s-]{5,20}"))) (str.prefixof "&" x)))
(assert (or (= (str.at z 33) "u") (= "003c;" (str.substr x 3 9))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]+$|^[0-9]+$"))))
(assert (= "&#<b>003c;(1)""></embed>" (str.replace y "x" "<b>")))
(check-sat)
