; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<%78 onxxx=1") (= x "<OBJECT classid=clsid:ae24fdae-03c6-11d1-8b76-0080c744f389><param name=url value=javascript:javascript:alert(1)></OBJECT>")))
(assert (or (= z "r=1s>") (= z "ouseout=""alert(1)"">test</basefont>") (= z "reactivate=alert(1)></menu>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^\d([-|\s]{0,3}?\d){7,9}")))
(assert (or (not (str.prefixof "ouseo" z)) (not (= (str.len y) 126)) (not (= "<marquee onbeforecut=""ax1)"" contenteditable>test</marquee>enteditable>test</kbd>" (str.replace y "lert(" "x")))))
(assert (or (not (str.contains (str.replace z "out" "x") "usex=""")) (= "alert(1)"">" (str.substr z 9 10))))
(assert (or (= (str.len y) 39) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{1,4}$"))) (str.suffixof "xtarea>" x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?:((07|00447|\+447)\d{9}|(08|003538|\+3538)\d{8,9})|((0|0044|\+44)\d{10}|(08)\d{9}|(90)\d{6}|(92)\d{6}|(437)\d{5}|(28)\d{6}|(37)\d{6}|(66)\d{6}|(82)\d{6}|(777)\d{5}|(93)\d{6}))$"))))
(check-sat)
