; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<output onbeforepaste=""alert(1)"" contenteditable>test</output>") (= x "<datalist onmousedown=""alert(1)"">test</datalist>") (= x "<x '=""foo""><x foo='><img src=x onerror=javascript:alert(1)//'>")))
(assert (or (= z "tyle=""animation-name:x"" onanimationstart=""alert(1)""></article>") (= z "rquee onpaste=""ale\u{1f600}rt(1)"" contenteditable>test</marquee>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "alpha")))
(assert (or (not (str.contains x "rt(")) (str.prefixof "<x '=""foo" x)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([\w+-.%]+@[\w\-.]+\.[A-Za-z]{2,4},*[\W]*)+$"))) (<= (str.len z) 60)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(?:19|20)[0-9]{2}-(?:(?:0[1-9]|1[0-2])/(?:0[1-9]|1[0-9]|2[0-9])|(?:(?!02)(?:0[1-9]|1[0-2])/(?:30))|(?:(?:0[13578]|1[02])-31))")) (not (str.prefixof "tyle=" z)) (= "'=""" (str.substr y 3 3))))
(check-sat)
