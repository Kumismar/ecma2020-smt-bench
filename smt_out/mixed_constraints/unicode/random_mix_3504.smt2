; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav\u{1f600} ondblclick=""alert(1)"">test</nav>") (= x "<input ondblclick=""alert(1)"">test</input>")))
(assert (or (= z "able>test</svg>") (= z "=""alert(1)"">test</a>") (= z "t(1) tabindex=1 id=x></content><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y " o" 0) 6))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0|\+[0-9]{1,5})?([1-9][0-9]{4})$"))) (not (= "st<" (str.substr z 7 3)))))
(assert (or (str.prefixof "<nav\u{1f600} ondb" x) (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{5}?$")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w]{8,}$")))))
(assert (or (not (str.contains x "pu")) (not (str.contains (str.replace x "=" "javascript:") "ickjavascript:""aler"))))
(assert (not (str.contains z "\u{10348}/text")))
(check-sat)
