; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br ondblclick=""alert(1)"">test</br>") (= x "<cite onbeforepaste=""alert(1)"" contenteditable>test</cite>")))
(assert (or (= z "t(1)"" contenteditable>test</iframe>") (= z "ut autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "me>" z)))
(assert (or (not (= (str.at y 60) "t")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{0,60}$"))) (str.prefixof "<title onb" y)))
(assert (not (>= (str.len x) 54)))
(assert (or (not (= "ocus>" (str.substr z 8 10))) (not (str.suffixof "iframe>" y)) (not (str.suffixof "re>" x))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z\u{c3}\u{20ac}\u{c3}\u{81}\u{c3}\u{201a}\u{c3}\u{192}\u{c3}\u{201e}\u{c3}\u{2026}\u{c3}\u{2020}\u{c3}\u{2021}\u{c3}\u{2c6}\u{c3}\u{2030}\u{c3}\u{160}\u{c3}\u{2039}\u{c3}\u{152}\u{c3}\u{8d}\u{c3}\u{17d}\u{c3}\u{8f}\u{c3}\u{90}\u{c3}\u{2018}\u{c3}\u{2019}\u{c3}\u{201c}\u{c3}\u{201d}\u{c3}\u{2022}\u{c3}\u{2013}\u{c3}\u{2dc}\u{c3}\u{2122}\u{c3}\u{161}\u{c3}\u{203a}\u{c3}\u{153}\u{c3}\u{9d}\u{c3}\u{17e}\u{c3}\u{178}\u{c3} \u{c3}\u{a1}\u{c3}\u{a2}\u{c3}\u{a3}\u{c3}\u{a4}\u{c3}\u{a5}\u{c3}\u{a6}\u{c3}\u{a7}\u{c3}\u{a8}\u{c3}\u{a9}\u{c3}\u{aa}\u{c3}\u{ab}\u{c3}\u{ac}\u{c3}\u{ad}\u{c3}\u{ae}\u{c3}\u{af}\u{c3}\u{b0}\u{c3}\u{b1}\u{c3}\u{b2}\u{c3}\u{b3}\u{c3}\u{b4}\u{c3}\u{b5}\u{c3}\u{b6}\u{c3}\u{b8}\u{c3}\u{b9}\u{c3}\u{ba}\u{c3}\u{bb}\u{c3}\u{bc}\u{c3}\u{bd}\u{c3}\u{be}\u{c3}\u{bf}]*$"))))
(assert (or (str.prefixof "<br ondb" x) (not (str.prefixof "<br ondb" y)) (= (str.indexof y "of" 0) 41)))
(check-sat)
