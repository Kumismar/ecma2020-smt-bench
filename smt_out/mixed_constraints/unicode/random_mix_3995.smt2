; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address id=x tabind\u{1f600}ex=1 ondeactivate=alert(1)\u{20000}></address><input id=y autofocus>") (= x "\u{201c}><ScRiPt>alert(documen\u{1d400}t.cookie)</script>\u{1d400}")))
(assert (or (= z "ul style\u{1f600}=""animation-name:x"" onanimationstart=""alert(\u{1f600}1)""></ul>") (= z "paste=""alert(1)"" contenteditable>test</var>") (= z "lert(&quot;XSS&quot;)&gt;")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x ")</" 0) 32)))
(assert (or (not (str.contains (str.replace y "ok" """") "co""i")) (>= (str.len z) 56)))
(assert (= " conten" (str.substr y 97 7)))
(assert (= (str.at x 17) "e"))
(assert (not (= (str.indexof x "rt(1)" 0) 42)))
(assert (or (not (= (str.indexof y "e" 0) 12)) (not (str.suffixof "t(1)"">DEF" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?!\s+)\D{1,29}\S")))))
(assert (not (= "\u{201c}><ScRiPt>alert(docume\u{1d400}t.cookie)</script>\u{1d400}paste=""alert(1)"" contenteditable>test</var>" (str.replace y "n" ""))))
(assert (str.contains z "quo"))
(assert (= "cookie)" (str.substr x 26 7)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^@[A-Za-z0-9-_]{1,15}$"))))
(assert (str.contains z "able>tes"))
(check-sat)
