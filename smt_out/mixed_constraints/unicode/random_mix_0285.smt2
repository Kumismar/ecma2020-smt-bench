; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div onmouseover='alert&lpar;1&rpar;'>DIV</div>") (= x "<IFRAME SRC=# onmouseover=""alert(document.cookie)""></IFRAME>")))
(assert (or (= z "d=""99"">XXX<style>") (= z "tenteditable>test</bgsound>") (= z "=""alert(1)""></blockquote>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "e" 0) 10)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((\+\d{1,3}(-| )?\(?\d\)?(-| )?\d{1,5})|(\(?\d{2,6}\)?))(-| )?(\d{3,4})(-| )?(\d{4})(( x| ext)\d{1,5}){0,1}$")))))
(assert (or (not (>= (str.len z) 77)) (not (str.contains y "al"))))
(assert (or (= "p" (str.substr y 63 1)) (= (str.at y 30) "r")))
(assert (or (not (str.suffixof "XX<style>" y)) (not (= (str.indexof x "C=#" 0) 10)) (= (str.len z) 25)))
(assert (= "1)""></bloc" (str.substr z 8 10)))
(check-sat)
