; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem onkeyup=""alert(1)"" contenteditable>test</menuitem>") (= x "<picture onmouseup=""alert(1)"">test</picture>")))
(assert (or (= z "bindex=1 onfocus=alert(1)></acronym>") (= z "rm>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z "itabl" 0) 3))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^0[1-689][0-9]{8}$"))) (not (= (str.at y 26) ")"))))
(assert (or (not (= (str.indexof y "1)"" c" 0) 25)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z A-Z]{3,40}$")))))
(assert (or (not (= (str.at x 34) "<")) (not (= "test</me" (str.substr x 45 8))) (not (str.contains x "cture>"))))
(assert (or (str.contains z "ro") (not (= (str.indexof y "con" 0) 29)) (str.suffixof "ure>rm>" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$"))) (= (str.at x 33) "t")))
(assert (<= (str.len y) 52))
(check-sat)
