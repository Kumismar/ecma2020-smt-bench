; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var onfocusout=alert(1) tabindex=1 id=x></var><input autofocus>") (= x "<xml onPropertyChange xml onPropertyChange=""javascript:javascript:alert(1)""></xml onPropertyChange>")))
(assert (or (= z "vascript:alert((""1""))>") (= z "ml onmouseover=""javascript:javascript:alert(1)""></html onmouseover>") (= z "aram>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x """a" 0) 13)) (str.suffixof "over>" z) (not (= (str.len y) 86))))
(assert (= "ml" (str.substr y 23 2)))
(assert (or (= (str.at x 35) "y") (str.contains z "cript:") (str.in_re z ((_ re.from_regex ecma2020 u) "^#[ec][0-9]+$"))))
(assert (not (str.suffixof "/a>" z)))
(assert (= "ert(1) tab" (str.substr x 18 10)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z\d\-. \s]+"))) (not (= (str.at y 56) "t")) (str.suffixof "r>" z)))
(assert (or (not (= "><" (str.substr x 40 2))) (= "ml onmouseover=""javascrip""javascript:alert(1)""></html onmouseover>" (str.replace z "t:" """"))))
(check-sat)
