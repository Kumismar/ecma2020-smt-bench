; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;A HREF="";http://0102.0146.0007.00000223/"";>;XSS<;/A>;") (= x "<bdo onkeydown=""alert(1)"" contenteditable>test</bdo>") (= x "<dd onbeforepaste=""alert(1)"" contenteditable>test</dd>")))
(assert (or (= z "bindex=1 id=x></listing><input autofocus>") (= z "able>test</legend>") (= z "</option>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 26) """"))
(assert (str.suffixof "/legend>" y))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^(\d{10})$")) (= "d>" (str.substr z 16 10)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(2)$")))))
(assert (or (str.prefixof "<bd" y) (not (= (str.at y 18) "0")) (>= (str.len x) 46)))
(assert (or (not (= (str.len y) 72)) (not (str.contains x "efo")) (str.suffixof "egend>" y)))
(assert (str.contains y ";http://"))
(check-sat)
