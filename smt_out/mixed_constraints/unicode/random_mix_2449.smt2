; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext draggable=""true"" ondragenter=""alert(1)"">test</plaintext>") (= x "<colgroup onmousemove=""alert(1)"">test</colgroup>")))
(assert (or (= z "rip\u{20000}t:document.vulnerable=true;"">") (= z "art=""alert(1)""></tt>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<colg" x))
(assert (not (= (str.at z 2) "t")))
(assert (or (not (= (str.len y) 87)) (str.suffixof ">" y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(20|21)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])")))))
(assert (or (str.prefixof "<colgroup" x) (not (str.contains (str.replace y " o" """") "up""nmous")) (not (= (str.at z 12) "n"))))
(assert (or (= "<svg><br onload=alert(1)></br>orexvate=alert(1)></audio>" (str.replace y "acti" "x")) (str.prefixof "<" z)))
(assert (or (not (str.contains x "co")) (= (str.at z 3) "=")))
(assert (not (= (str.len z) 33)))
(check-sat)
