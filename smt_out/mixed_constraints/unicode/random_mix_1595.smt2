; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src\x12=x onerror=""javascript:alert(1)"">") (= x "<html id=x tabindex=1 onactivate=alert(1)></html>")))
(assert (or (= z "st</ol>") (= z " ondeactivate=alert(1)></style><input id=y autofocus>") (= z "lert(1) tabindex=1 id=x></menu><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "i" "x") "<xmg ")) (str.contains x "source sr")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z\u{c0}\u{c1}\u{c2}\u{c3}\u{c4}\u{c5}\u{c6}\u{c7}\u{c8}\u{c9}\u{ca}\u{cb}\u{cc}\u{cd}\u{ce}\u{cf}\u{d0}\u{d1}\u{d2}\u{d3}\u{d4}\u{d5}\u{d6}\u{d8}\u{d9}\u{da}\u{db}\u{dc}\u{dd}\u{de}\u{df}\u{e0}\u{e1}\u{e2}\u{e3}\u{e4}\u{e5}\u{e6}\u{e7}\u{e8}\u{e9}\u{ea}\u{eb}\u{ec}\u{ed}\u{ee}\u{ef}\u{f0}\u{f1}\u{f2}\u{f3}\u{f4}\u{f5}\u{f6}\u{f8}\u{f9}\u{fa}\u{fb}\u{fc}\u{fd}\u{fe}\u{ff} \t\r\n\f]*$"))) (not (= (str.indexof z "vat" 0) 9))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[^@]+@[^@]+\.[a-zA-Z]{2,11}"))) (<= (str.len x) 47) (not (= (str.indexof z "u><in" 0) 29))))
(assert (or (not (= "ro" (str.substr y 19 2))) (= "y autofo" (str.substr y 90 8))))
(assert (not (str.suffixof ">" y)))
(check-sat)
