; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike onclick=""alert(1)"">test</strike>") (= x "<video onmouseenter=""alert\u{1f600}(1)"">test</video>") (= x "<video oncanplaythrough=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>")))
(assert (or (= z "le>drag me</div><param ondragover=alert(1) contenteditable>drop here</param>") (= z """true"" ondragend=""alert(1)"">test</object>")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[a-zA-Z])[a-zA-Z0-9]\w{2,32}$")))
(assert (not (= "<<b>ideo oncanplaythrough=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>" (str.replace x "v" "<b>"))))
(assert (or (not (= "nkeydown=" (str.substr y 5 9))) (not (= (str.indexof x "yt" 0) 15))))
(assert (or (not (= "</objec" (str.substr z 32 7))) (not (= "<strike onclick=""alert(1)"">test</strike>le> rag me</div><param ondragover=alert(1) contenteditable>drop here</param>" (str.replace y "d" " ")))))
(assert (or (not (= (str.indexof z "d=""" 0) 15)) (= (str.len x) 40)))
(check-sat)
