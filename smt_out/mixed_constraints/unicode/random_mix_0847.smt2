; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noframes ondblclick=""alert(1)"">test</noframes>") (= x "<style>@keyframes x{}</style><plaintext style=""animation-name:x"" onanimationend=""alert(1)""></plaintext>")))
(assert (or (= z "basefont>") (= z ">test</marquee>")))
(assert (= y (str.++ x z)))
(assert (= (str.at z 2) "s"))
(assert (or (>= (str.len x) 47) (= "que" (str.substr z 10 3)) (str.contains y "noframe")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) ".([0-9]{6,30})")) (str.suffixof ">" x) (= (str.indexof x "ames>" 0) 42)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*?[\u{5c}u3041-\u{5c}u309F\u{5c}u30FC])[\u{5c}u3041-\u{5c}u309F\u{5c}u30FC\s]*")) (not (= "e" (str.substr z 2 1)))))
(check-sat)
