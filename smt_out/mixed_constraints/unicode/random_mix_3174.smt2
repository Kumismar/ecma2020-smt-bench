; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track id=x tabindex=1 onfocusin=alert(1)></track>") (= x "<style>:target {color:red;}</style><data id=x style=""transition:color 1s"" ontransitionend=alert(1)></data>") (= x "<style>:target {color: red;}</style><source id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></source>")))
(assert (or (= z "tp://;URL=javascript:alert('XSS');\"">") (= z "enteditable>test</li>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 95) "l")) (str.contains y ":red")))
(assert (or (not (str.prefixof "<embed " y)) (not (str.contains z "able>test"))))
(assert (str.contains y "n=alert(1"))
(assert (or (not (= (str.indexof x "ler" 0) 91)) (= "<track id=x tabindex=1 onfocus""alert(1)></track>" (str.replace x "in=" """"))))
(assert (= (str.indexof y " " 0) 6))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z]{1}[a-zA-Z0-9\._#\-]{0,100}@([a-zA-Z0-9\-_\.]){1,100}\.[a-zA-Z]{2,}){1}$"))) (str.prefixof "ttp:/" z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z][a-zA-Z\\s]+$"))))
(assert (= (str.at z 31) "'"))
(check-sat)
