; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style onreadystatechange=javascript:javascript:alert(1);></style>") (= x "<figcaption onfocusout=alert(1) tabindex=1 id=x></figcaption><input autofocus>")))
(assert (or (= z " ONLOAD=alert('XSS')&gt;") (= z "ut draggable=""true"" ondragleave=""alert(1)"">test</input>") (= z ".com/&quot;&gt;XSS&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len z) 26)))
(assert (or (= (str.indexof y "tes" 0) 109) (= (str.at z 10) "e")))
(assert (or (str.prefixof "<style o" y) (str.in_re z ((_ re.from_regex ecma2020 u) "^\s*[^@]+([@]{1})[0-9a-zA-Z\._-]+([\.]{1})[0-9a-zA-Z\._-]+\s*$")) (not (>= (str.len y) 82))))
(assert (or (str.contains (str.replace y "<fi" "x") "xgca") (not (= "<figcaption onfocusout=alert(1) tabindex=1 id=x></figcaption><input autofocus>.com/&&gt;XSS&lt;/A&gt;" (str.replace y "quot;" ""))) (not (str.contains x "nfocu"))))
(assert (str.contains (str.replace y "<s" "x") "xtyle "))
(assert (or (str.contains z "1)") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[-!#-'*+\/-9=?^-~]+(?:\.[-!#-'*+\/-9=?^-~]+)*@[-!#-'*+\/-9=?^-~]+(?:\.[-!#-'*+\/-9=?^-~]+)+$")))))
(assert (= (str.at x 17) "u"))
(assert (or (not (= "rt>" (str.substr z 7 7))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9A-Za-z&\u{ff66}-\u{ff9f}&\s&\/&\-]+$"))))
(check-sat)
