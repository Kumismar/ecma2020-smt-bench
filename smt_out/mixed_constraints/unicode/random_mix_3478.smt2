; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del onclick=""alert(1)"">test</del>") (= x "<nextid onkeypress=""alert(1)"" contenteditable>test</nextid>")))
(assert (or (= z "object>") (= z "ert(1)"">test</dir>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<del" y) (= "st</nexti" (str.substr y 48 9))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "\b(Gloves|gloves|GLOVES)\b"))) (not (= (str.at x 12) "c")) (str.contains (str.replace y "/dir" "<b>") "est<<b>>")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{3}[ -][0-9]{3}[ -][0-9]{4}"))))
(assert (or (str.suffixof "></col>" y) (not (= "st<" (str.substr x 26 3))) (= (str.at z 1) "b")))
(assert (not (>= (str.len z) 6)))
(check-sat)
