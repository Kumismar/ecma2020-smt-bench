; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "eval(a+b+c+d);") (= x "<div id=""124""><script src=""/\example.com\foo.js""></script> // Safari 5.0, Chrome 9, 10") (= x "<track oncut=""alert(1)"" contenteditable>test</track>")))
(assert (or (= z "x=1 id=x></option><input autofocus>") (= z "lert(1)"" contenteditable>test</strike>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len z) 18)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\S[\w \u{df}\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}]*")))))
(assert (or (str.suffixof "rike>" z) (>= (str.len x) 89)))
(assert (or (not (str.contains (str.replace y "t=""a" "x") "uxlert(")) (= ", Chrome 9" (str.substr x 72 10))))
(assert (or (= (str.indexof z ">" 0) 0) (str.suffixof "t</strike>" z)))
(assert (or (= (str.len x) 14) (= (str.indexof z "ler" 0) 32) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{5c}u00C0-\u{5c}u017F]+(([',. -][a-zA-Z\u{5c}u00C0-\u{5c}u017F])?[a-zA-Z\u{5c}u00C0-\u{5c}u017F]*)*$")))))
(assert (or (= "l(a+b+" (str.substr x 3 6)) (= "" (str.replace z ">" ""))))
(assert (not (str.suffixof "t</track>" x)))
(assert (= (str.indexof x "it" 0) 33))
(check-sat)
