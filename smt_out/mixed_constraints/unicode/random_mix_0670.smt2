; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><li onload=alert(1)></li>") (= x "<dialog draggable=""true"" ondragenter=""alert(1)"">test</dialog>")))
(assert (or (= z "t>") (= z " onload=alert(1)></table>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len x) 35)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z]{8,10}"))))
(assert (not (str.contains y "st")))
(assert (or (>= (str.len x) 60) (= (str.indexof y ">" 0) 4)))
(assert (= (str.at y 57) "l"))
(assert (or (not (= (str.indexof x "a" 0) 15)) (not (str.prefixof "<sv" y))))
(assert (or (not (str.suffixof "><source>" z)) (not (= (str.at x 12) "g"))))
(assert (str.contains z "(1)></"))
(assert (or (= "src=valid" (str.substr y 39 9)) (not (= (str.indexof y "> " 0) 60))))
(assert (str.contains z "t>"))
(check-sat)
