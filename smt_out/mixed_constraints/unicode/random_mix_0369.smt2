; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup onpaste=""alert(1)"" contenteditable>test</optgroup>") (= x "<tr onpaste=""alert(1)"" contenteditable>test</tr>")))
(assert (or (= z "e=""alert(1)"">test</p>") (= z "est</content>") (= z "</map><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len z) 38) (not (= (str.at z 5) "c")) (str.prefixof "<tr onpa" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{1,10}"))) (not (str.contains y "fromC")) (not (= (str.at z 19) "p"))))
(assert (not (= (str.at x 55) "r")))
(assert (not (str.suffixof ">" y)))
(assert (or (= (str.len x) 60) (str.in_re z ((_ re.from_regex ecma2020 u) ".*(^(bc1|[13])[a-zA-HJ-NP-Z0-9]{25,39}$).*")) (str.contains y ">test</tr")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_\+.~#?&//=]*)"))))
(assert (or (not (= (str.indexof y "ndex=" 0) 15)) (not (str.contains z " id=y ")) (not (= (str.indexof y "te=" 0) 15))))
(check-sat)
