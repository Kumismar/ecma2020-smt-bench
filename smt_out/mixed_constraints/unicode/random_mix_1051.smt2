; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=javascript:alert(String.fromCharCode(88,83,83))>") (= x "<center oncopy=""alert(1)"" contenteditable>test</center>") (= x "<;STYLE TYPE="";text/javascript"";>;alert(';XSS';);<;/STYLE>;")))
(assert (or (= z " autofocus>") (= z "editable>test</td>")))
(assert (= y (str.++ x z)))
(assert (or (not (= " a<b>tofocus>" (str.replace z "u" "<b>"))) (not (str.prefixof "editable" z))))
(assert (or (str.prefixof "<;STYLE TY" y) (not (str.suffixof ";/STYLE>;" x)) (not (str.prefixof "<IMG SRC=j" y))))
(assert (not (= (str.at z 11) "s")))
(assert (or (str.contains (str.replace z "itabl" """") "ed""e>te") (not (= (str.at z 2) "i"))))
(assert (or (str.contains y "TYPE="";tex") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s]+$")))))
(check-sat)
