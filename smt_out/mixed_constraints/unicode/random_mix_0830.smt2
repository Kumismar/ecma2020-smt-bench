; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;BR SIZE=\""&{alert('XSS')}\""&gt;") (= x "<source onmousemove=""alert(1)"">test</source>")))
(assert (or (= z "/form><input autofo\u{1f600}cus>") (= z "co\u{1f4a9}de>") (= z """>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 1) ">") (not (= (str.indexof x "l" 0) 1)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\+?[0-9]{3}-?[0-9]{6,12}$")))))
(assert (= "alert(1)""" (str.substr x 21 9)))
(assert (str.contains (str.replace y """" "") "=\&{al"))
(assert (or (not (= (str.indexof x "rt(1" 0) 24)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[-\u{6f5f}\u{773c}|| ]+$"))))
(assert (or (not (>= (str.len x) 39)) (not (str.contains x "E=\""&{ale")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{5,9}$")))))
(assert (not (= (str.indexof y "}\" 0) 28)))
(check-sat)
