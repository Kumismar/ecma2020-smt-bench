; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp onclick=""alert(1)"">test</rp>") (= x "<style>:target {color: red;}</style><tt id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tt>")))
(assert (or (= z "\u{1d400}nt>") (= z "lert`1`")))
(assert (= y (str.++ x z)))
(assert (= (str.at z 1) "e"))
(assert (str.contains x ")"" conte"))
(assert (or (= "lertalert(1)`" (str.replace z "`1" "alert(1)")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{e1}\u{10d}\u{10f}\u{e9}\u{11b}\u{ed}\u{148}\u{f3}\u{159}\u{161}\u{165}\u{16f}\u{fa}\u{fd}\u{17e}\u{c1}\u{10c}\u{10e}\u{c9}\u{cd}\u{11a}\u{147}\u{d3}\u{158}\u{160}\u{164}\u{da}\u{16e}\u{dd}\u{17d}\s]*")))))
(assert (or (str.suffixof ">" z) (str.prefixof "<st" y)))
(assert (str.suffixof "t`1`" y))
(assert (or (not (= (str.at x 1) "r")) (not (str.prefixof "<space" y))))
(assert (or (not (str.prefixof "<st" x)) (<= (str.len y) 40) (str.contains (str.replace y "s"" " "<b>") "0<b>ontra")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[-._a-z0-9]+@(?:[a-z0-9][-a-z0-9]+\.)+[a-z]{2,6}$"))) (= (str.at x 50) "=")))
(check-sat)
