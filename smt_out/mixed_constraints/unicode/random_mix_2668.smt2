; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\x0Ajavascript:alert(1)</script>") (= x "<nav id=x tabindex=1 onfocusin=alert(1)></nav>")))
(assert (or (= z ":alert(1)"" id=""fuzzelement1"">test</a>") (= z "ble>test</div>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z\d\s#.-]+$"))))
(assert (or (not (<= (str.len y) 62)) (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z].{2,}")) (not (>= (str.len z) 1))))
(assert (or (not (str.contains (str.replace x "x" "") "\0Ajav")) (= (str.len y) 76) (str.contains z "le>test")))
(assert (or (not (= (str.indexof z "b" 0) 5)) (not (= (str.indexof x ">\" 0) 11))))
(assert (or (not (= (str.indexof x "rt(1" 0) 30)) (not (= (str.at z 10) "d")) (= "ble>tealert(1)iv>" (str.replace z "st</d" "alert(1)"))))
(assert (str.contains (str.replace x "'><s" " ") """` c"))
(check-sat)
