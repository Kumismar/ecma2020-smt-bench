; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby onkeyup=""alert(1)"" contenteditable>test</ruby>") (= x "<tr onmouseout=""alert(1)"">test</tr>")))
(assert (or (= z "</div>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9]{6,}"))) (not (<= (str.len z) 9))))
(assert (str.prefixof "<ruby on" x))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[0]{1}|([0-9]{10})$")))
(assert (or (= (str.indexof x "ta" 0) 35) (= (str.indexof x "e=""t" 0) 12) (not (= "<" (str.substr z 0 1)))))
(assert (or (str.contains (str.replace z ")"">t" "x") "ert(1xest</") (= (str.indexof z "div" 0) 2) (not (<= (str.len x) 62))))
(assert (not (str.suffixof "v>" z)))
(check-sat)
