; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object id=x tabindex=1 ondeactivate=alert(1)></object><input id=y autofocus>") (= x "<command id=x tabindex=1 ondeactivate=alert(1)></command><input id=y autofocus>")))
(assert (or (= z "gen>") (= z "l ontouchcancel=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "d=" 0) 10))
(assert (or (not (>= (str.len x) 73)) (= "cut=""ale" (str.substr y 11 8)) (str.prefixof "<tfoot " x)))
(assert (or (not (= (str.at y 6) ">")) (not (= "ct id=" (str.substr x 5 6))) (str.contains y "=x tabind")))
(assert (= (str.indexof z "gen>" 0) 0))
(assert (or (= (str.at y 73) "f") (not (= "1" (str.substr z 22 1)))))
(assert (or (not (str.prefixof "<object i" y)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{4,30}"))) (str.suffixof ">" z)))
(assert (or (not (str.prefixof "<object " y)) (not (>= (str.len z) 23))))
(check-sat)
