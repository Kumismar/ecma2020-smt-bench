; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onbeforepaste=""alert(1)"" contenteditable>test</html>") (= x "<sou\u{1d400}rce onpaste=""alert(1)"" contenteditable>test</source>") (= x "&lt;BODY onload!#$%&amp;()*~+-_.,:;?@[/|\]^`=alert(&quot;XSS&quot;)&gt;")))
(assert (or (= z "table>test</dd>") (= z "ost Page Cookies: '+document.cookie);//<br/><hr/>") (= z "er=""alert(1)"">test</article>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{1,5}$"))))
(assert (or (not (= (str.at y 74) "s")) (= (str.at x 59) "S")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-z0-9._%+-]+@[a-z0-9.-]+.[a-z]{2,}$"))) (= "&lt;BODY onload!#$%&amp;()*~+-_.,:;?@[/|\]^`=alert(&quot quot;)&gt;" (str.replace x ";XSS&" " "))))
(assert (or (not (str.prefixof "er=""alert(" z)) (not (= (str.indexof y "334" 0) 15)) (not (= (str.at z 5) ">"))))
(check-sat)
