; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x oncut=""alert(String.fromCharCode(88,83,83))"">") (= x "<style>@keyframes x{}</style><marquee style=""animation-name:x"" onanimationend=""alert(1)""></marquee>")))
(assert (or (= z "lert(1)""></th>") (= z "</iframe>") (= z ":target {color:red;}</style><tfoot id=x style=""transition:color 1s"" ontransitionend=alert(1)></tfoot>")))
(assert (= y (str.++ x z)))
(assert (or (= "<style>:target {color: red;}</style><embed id=x style=""traon:color 10s"" ontransitioncancel=alert(1)></embed>" (str.replace x "nsiti" "")) (= (str.at x 23) "(") (str.suffixof "ot>" z)))
(assert (or (= (str.at y 199) ">") (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-9][\d]{0,}$")) (not (= (str.at z 5) "1"))))
(assert (or (= (str.indexof x "od" 0) 40) (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z\s']+"))))
(assert (str.prefixof "<IMG" x))
(assert (str.contains x "ion-n"))
(check-sat)
