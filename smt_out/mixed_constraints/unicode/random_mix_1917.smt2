; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details ondblclick=""alert(1)"">test</details>") (= x "<canvas onmouseleave=""alert(1)"">test</canvas>")))
(assert (or (= z "alert(1)></tr>") (= z "down=""alert(1)"" contenteditable>test</span>") (= z "e:x"" onanimationend=""alert(1)""></acronym>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{7}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\S{6,32}$")))))
(assert (or (str.prefixof "<d" y) (not (>= (str.len z) 41))))
(assert (not (= (str.at z 15) "n")))
(assert (or (not (= "<detail"" ondblclick=""alert(1)"">test</details>alert(1)></tr>" (str.replace y "s" """"))) (= "est</c" (str.substr x 33 6)) (str.suffixof "(1)></tr>" z)))
(assert (not (str.prefixof "<ca" y)))
(assert (or (= "<canvas ""nmouseleave=""alert(1)"">test</canvas>" (str.replace x "o" """")) (= (str.at y 79) "c") (not (= (str.indexof y "es" 0) 32))))
(assert (or (str.prefixof "st</aud" z) (not (= (str.indexof z ">" 0) 0))))
(check-sat)
