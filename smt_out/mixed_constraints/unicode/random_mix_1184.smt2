; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<BODY ONLOAD=alert('XSS')>") (= x "<a id=""x""><rect fill=""white"" width=""1000"" height=""1000""/></a>") (= x "<article draggable=""true"" ondragenter=""alert(1)"">test</article>")))
(assert (or (= z "t(1)"">test</i>") (= z "ark ondblclick=""alert(1)"">test</mark>")))
(assert (= y (str.++ x z)))
(assert (or (not (= " id=""x""><r" (str.substr y 2 10))) (= (str.len x) 63)))
(assert (str.prefixof "<i on" y))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?!Last Name|last name|LAST NAME)[a-zA-Z][a-zA-Z ]+"))) (str.suffixof "cus>" y) (<= (str.len z) 42)))
(assert (or (= (str.indexof x "alert" 0) 39) (not (= (str.at y 12) "g")) (not (str.suffixof "st</mark>" y))))
(check-sat)
