; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=javascript:alert(1)>click") (= x "<s draggable=""true"" ondragstart=""alert(1)"">test</s>")))
(assert (or (= z "/d\u{1d400}d>") (= z "edeactivate=alert(1)></bgsound><input autofocus>") (= z "lur=alert(1) tabindex=1 id=x></i><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 65) ">"))
(assert (= (str.indexof x ")" 0) 40))
(assert (or (not (str.prefixof "<a h" y)) (= (str.indexof z "d" 0) 1) (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{10,19}")))))
(assert (or (not (str.suffixof "/s>" x)) (str.contains (str.replace x "e" """") "<a hr""f=") (= "s>" (str.substr y 79 3))))
(assert (or (not (= "pt:alert(1" (str.substr y 16 10))) (not (str.suffixof "1)>click" x))))
(assert (or (<= (str.len z) 16) (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{5}([\-]\d{4})?$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "\b(Gloves|gloves|GLOVES)\b"))))
(check-sat)
