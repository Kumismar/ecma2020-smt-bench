; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot onkeypress=""alert(1)"" contenteditable>test</tfoot>") (= x "<frame onmouseup=""alert(1)"">test</frame>") (= x "<header id=x tab\u{1f4a9}index=1\u{10348} onbeforeactivate=alert(1)></header>")))
(assert (or (= z "ypress=""aler\u{1f600}t(\u{1d400}1)"" contenteditable>test</option>") (= z "t(1)"" contenteditable>test</spacer>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "oreactiv") (str.prefixof "s\""&gt;&l" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{1}.{6,}[a-zA-Z0-9]$")))))
(assert (not (str.prefixof "<header i" y)))
(assert (or (not (str.contains (str.replace y "1)" "javascript:") "ert(javascript:></")) (= "nteditabl" (str.substr z 25 9)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\\(]{0,1}([0-9]){3}[\\)]{0,1}[ ]?([^0-1]){1}([0-9]){2}[ ]?[-]?[ ]?([0-9]){4}[ ]*((x){0,1}([0-9]){1,5}){0,1}$")))))
(assert (or (not (str.contains y "opy=""aler")) (not (= (str.indexof y "ame>t" 0) 36))))
(assert (not (= (str.at z 31) "a")))
(check-sat)
