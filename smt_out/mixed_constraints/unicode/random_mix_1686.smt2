; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ul ondblclick=""alert(1)"">test</ul>") (= x "<img src=validimage.png onload=alert(1)>") (= x "<style>@keyframes x{}</style><ruby style=""animation-name:x"" onanimationstart=""alert(1)""></ruby>")))
(assert (or (= z "lert(1)>XSS</marquee>") (= z "alert(1)"">test</input>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len x) 25)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "[\w\u{e0}-\u{fa}\u{c0}-\u{da} ]+[\s]{1,}/?[\w\u{e0}-\u{fa}\u{c0}-\u{da} ]*")) (= (str.indexof y "ul" 0) 1) (not (= (str.indexof x "i" 0) 44))))
(assert (or (not (= (str.indexof x "t" 0) 8)) (= (str.at z 17) "n")))
(assert (or (not (= (str.at z 8) "b")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([_A-z0-9\s]){2,}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=^[\S]{12,}$)(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*\W).*$")))))
(assert (not (= "lert(1)>Xalert(1)S</marquee>" (str.replace z "S" "alert(1)"))))
(assert (or (str.contains y "idimag") (not (= (str.at x 14) "="))))
(check-sat)
