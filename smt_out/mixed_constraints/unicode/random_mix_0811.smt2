; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><datalist ondrop=alert(1) contenteditable>drop here</datalist>") (= x "<li oncontextmenu=""alert(1)"">test</li>") (= x "<svg><template onload=alert(1)></template>")))
(assert (or (= z "input id=y autofocus>") (= z ";")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z "au" 0) 11))
(assert (= "onloa" (str.substr y 15 5)))
(assert (str.prefixof "input id" z))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{7}")) (not (str.prefixof "<d" x))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\+-]+$"))) (str.prefixof "=""" z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((20)\d{2}|\d{2})$"))))
(check-sat)
