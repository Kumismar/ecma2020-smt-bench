; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span id=x tabindex=1 onbeforeactivate=alert(1)></span>") (= x "<tt onkeypress=""alert(1)"" contenteditable>test</tt>") (= x "<progress onpaste=""alert(1)"" contenteditable>test</progress>")))
(assert (or (= z " id=x tabindex=1 onfocus=alert(1)></progress>") (= z "=""alert(1)"" contenteditable>test</data>") (= z "(1)"">test</frameset>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "t</select>" z) (str.contains (str.replace y "s>" "<b>") "s<b>=")))
(assert (or (str.suffixof "A`)>" z) (not (= (str.at x 9) "x")) (str.contains y "onload")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{20}"))))
(assert (or (= (str.indexof y "e" 0) 7) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?![ .]+$)\d{10}$")))))
(check-sat)
