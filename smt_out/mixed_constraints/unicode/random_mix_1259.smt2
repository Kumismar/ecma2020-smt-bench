; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT SRC=&quot;http://ha.ckers.org/xss.jpg&quot;&gt;&lt;/SCRIPT&gt;") (= x "<!--") (= x "<;IMG SRC=javascript:alert(';XSS';)>;")))
(assert (or (= z "ocusout=alert(1) tabindex=1 id=x></mark><input autofocus>") (= z "index=1 onfocusin=alert(1)></h1>") (= z "contenteditable>test</ruby>")))
(assert (= y (str.++ x z)))
(assert (or (= "<!--ocu t=alert(1) tabindex=1 id=x></mark><input autofocus>" (str.replace y "sou" " ")) (str.suffixof "aram>" z) (not (str.suffixof "ofocus>" y))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\-\.\(\)\s]+$"))) (= (str.at y 70) "g")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\s]*[\s\S]*[\S]+[\s\S]*[\s]*$"))))
(assert (or (= (str.indexof z "u" 0) 2) (not (= (str.indexof x "secti" 0) 1))))
(assert (not (str.suffixof "--" x)))
(check-sat)
