; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong onkeydown=""alert(1)"" contenteditable>test</strong>") (= x "<marquee id=x tabindex=1 onbeforeactivate=alert(1)></marquee>")))
(assert (or (= z "end=alert(1)></input>") (= z """>test</td>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "g o") (not (str.prefixof """>test" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{7}")))))
(assert (or (not (= (str.indexof y "mar" 0) 1)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z '-]+)$")))))
(assert (= (str.indexof z "ut>" 0) 18))
(assert (not (str.contains y "uee")))
(assert (or (not (str.suffixof "input>" z)) (str.suffixof "strong>" x)))
(assert (not (str.contains (str.replace x "efor" " ") " onb ea")))
(check-sat)
