; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noframes draggable=""true"" ondragleave=""alert(1)"">test</noframes>") (= x "<IMG SRC=`javascript:javascript:alert(1)`>") (= x """></iframe><script>alert(`TEXT YOU WANT TO BE DISPLAYED`);</script><iframe frameborder=""0%EF%BB%BF")))
(assert (or (= z "eforecut=""alert(1)"" contenteditable>test</plaintext>") (= z "</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^#[ec][0-9]+$"))) (= "eforecut=""ale1)"" contenteditable>test</plaintext>" (str.replace z "rt(" "")) (not (= "(1" (str.substr x 45 2)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]{3,}"))) (not (str.contains x " SRC"))))
(assert (or (not (= (str.indexof x ">" 0) 1)) (not (str.contains (str.replace z "e" "javascript:") "javascript:forec")) (str.contains z "alert(1)><")))
(assert (or (str.contains (str.replace x " f" "<b>") "rame<b>ram") (not (>= (str.len x) 38))))
(assert (str.prefixof """" x))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[-A-Za-z0-9_]+[-A-Za-z0-9_.]*[@]{1}[-A-Za-z0-9_]+[-A-Za-z0-9_.]*[.]{1}[A-Za-z]{2,5}$")) (= (str.len x) 42)))
(assert (or (str.contains x "E DIS") (not (= (str.len x) 60))))
(check-sat)
