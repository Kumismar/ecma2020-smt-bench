; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<A HREF=""htt p:\u{1d400}//6 6.000146.0x7.147/"">XSS</A>") (= x "<form><a href=""javascript:\u{5c}u0061lert&#x28;1&#x29;"">X</script><img/*/src=""worksinchrome&colon;prompt&#x28;1&#x29;""/*/onerror='eval(src)'>")))
(assert (or (= z """ contenteditable>test</html>") (= z "w.w3.org/2000/svg"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len x) 46)) (not (str.prefixof "w.w3.org/" z))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(https?:\/\/)?(www\.)?[-a-zA-Z0-9@:%._\+~#=]{2,256}\.[a-z]{2,6}\b([-a-zA-Z0-9@:%_\+.~#()?&//=]*)"))) (not (str.contains (str.replace z "g" "alert(1)") "ralert(1)/200")) (not (= "<A HREF=javascript:t p:\u{1d400}//6 6.000146.0x7.147/"">XSS</A>" (str.replace x """ht" "javascript:")))))
(assert (or (str.contains (str.replace x "nerro" "") "or='") (str.prefixof "w" z) (not (str.contains y "java"))))
(assert (not (= (str.indexof y "lon;" 0) 89)))
(check-sat)
