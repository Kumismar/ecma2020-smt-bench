; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<progress ondblclick=""alert(1)"">test</progress>") (= x "<div id=""127""><svg xmlns=""http://www.w3.org/2000/svg"" id=""x"">") (= x "<wbr onmouseup=""alert(1)"">test</wbr>")))
(assert (or (= z "yle>:target {color: red;}</style><body id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></body>") (= z "1 id=x></frame><input autofocus>") (= z "eforecopy=alert(1) autofocus>XSS</textarea>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "ess" "alert(1)") "rogralert(1) ")) (not (= (str.indexof z "t</td" 0) 16))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\s*)?(\+)?([- _():=+\/]?\d[- _():=+]?){4,20}(\s*)?$"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[1-9]\d{9}$")) (str.contains z "rame><inp") (not (str.suffixof ")></body>" y))))
(assert (or (str.contains (str.replace y "!" "<b>") " --<b>>mmar") (not (= (str.at y 74) "s"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.{8,64}$"))) (str.contains (str.replace y "ert" "x") "k=""alx(1")))
(check-sat)
