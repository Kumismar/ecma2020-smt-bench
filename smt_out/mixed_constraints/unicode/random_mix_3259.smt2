(assert (or (not (= "on:c" (str.substr x 58 4))) (= "<style>@keyframes x{}<b>le><dir style=""animation-name:x"" onanimationstart=""alert(1)""></dir>" (str.replace x "</sty" "<b>"))))
(check-sat)
