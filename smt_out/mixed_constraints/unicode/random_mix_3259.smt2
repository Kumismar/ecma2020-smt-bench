; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><i id=x style=""transition:color 1s"" ontransitionend=alert(1)></i>") (= x "<style>@keyframes x{}</style><dir style=""animation-name:x"" onanimationstart=""alert(1)""></dir>") (= x "<div draggable=""true"" contenteditable>drag me</div><frameset ondragover=alert(1) contenteditable>drop here</frameset>")))
(assert (or (= z ">test</td>") (= z "picture draggable=""true"" ondragenter=""alert(1)"">test</picture>") (= z "arCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "ale" "javascript:") "rint=javascript:rt(") (= (str.len z) 12) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-a-z]+@[a-z0-9.-]+\.[a-z]{2,9}$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]+(([',. -][a-zA-Z0-9 ])?[a-zA-Z0-9]*)*$"))) (= "TLE&gt" (str.substr x 7 6)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^09[0-9]{8}$")))))
