; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base onmouseout=""alert(1)"">test</base>") (= x "<style>@keyframes x{}</style><select style=""animation-name:x"" onanimationend=""alert(1)""></select>") (= x "<rt oncopy=""alert(1)"" contenteditable>test</rt>")))
(assert (or (= z "fn>") (= z "ODY{-moz-binding:url("";http://ha.ckers.org/xssmoz.xml#xss"";)}<;/STYLE>;") (= z "ub>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<rt onco" x)) (not (>= (str.len z) 31)) (not (= "f" (str.substr z 0 1)))))
(assert (not (>= (str.len y) 102)))
(assert (not (= "ub>" (str.substr z 0 9))))
(assert (or (not (= (str.indexof y " onco" 0) 3)) (str.suffixof "tid>" z)))
(assert (or (= "javascript:>" (str.replace z "fn" "javascript:")) (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}0-9_.+-]+@[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}0-9_.-]+.[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}]{2,}$")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z\s]{2,10}")))))
(assert (or (= (str.at y 12) "s") (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.{2,}).*")))))
(check-sat)
