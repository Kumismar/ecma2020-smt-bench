; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt onclick=""alert(1)"">test</dt>") (= x "<style>@keyframes x{}</style><pre style=""animation-name:x"" onanimationend=""alert(1)""></pre>") (= x "<applet onkeydown=""alert(1)"" cont\u{10348}enteditable>\u{10348}test</applet>")))
(assert (or (= z "script:alert(1)//></style>") (= z "put autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (= "t>" (str.substr x 58 9))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) ".{2,2}"))) (not (str.prefixof "<style>" x))))
(assert (or (not (str.contains y "select id=")) (not (= (str.indexof z "t" 0) 5)) (not (= (str.indexof x "o" 0) 2))))
(assert (or (= "script" (str.substr y 60 6)) (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_-]{3,14}"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) ".{1,35}"))) (str.suffixof "s>" y)))
(assert (or (= (str.indexof x "t" 0) 2) (= (str.at z 0) "l")))
(assert (= "ocu" (str.substr z 9 3)))
(check-sat)
