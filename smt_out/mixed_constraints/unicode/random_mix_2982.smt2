; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<wbr on\u{1d400}keydown=""alert(1)""\u{1f600} contenteditable>test</wbr>") (= x "<textarea onfocusout=alert(1) id=x></textarea><input autofocus>")))
(assert (or (= z ");&lt;/SCRIPT&gt;") (= z ">") (= z "e ondblclick=""alert(1)"">test</style>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/style>" y)) (= (str.indexof x "t" 0) 1) (not (str.contains z "t</marque"))))
(assert (not (= (str.indexof x "ta" 0) 4)))
(assert (not (str.prefixof "}" z)))
(assert (or (= (str.at x 4) "e") (not (= (str.indexof x "ert" 0) 21)) (str.suffixof "gt;" y)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^(\w{1,25})@(\w{1,16})(\.(\w{1,4})){1,3}$")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:0|(?:\+|00) ?31 ?)(?:(?:[1-9] ?(?:[0-9] ?){8})|(?:6 ?-? ?[1-9] ?(?:[0-9] ?){7})|(?:[1,2,3,4,5,7,8,9]\d ?-? ?[1-9] ?(?:[0-9] ?){6})|(?:[1,2,3,4,5,7,8,9]\d{2} ?-? ?[1-9] ?(?:[0-9] ?){5}))$")))))
(assert (not (str.prefixof "<" y)))
(assert (or (not (str.prefixof "<textarea" y)) (not (= "tarea onfo" (str.substr y 4 10)))))
(check-sat)
