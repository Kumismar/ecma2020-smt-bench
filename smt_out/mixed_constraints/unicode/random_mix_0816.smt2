; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blink ondbl\u{1d400}click=\u{1f4a9}""alert(1)"">test</blink>") (= x "<addr\u{10348}ess draggable=""true"" ondragend=""\u{1f4a9}alert(1)"">test</address>")))
(assert (or (= z " oncut=""alert(1)"" contenteditable>test</caption>") (= z "s onmouseup=""alert(1)"">test</s>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "ndex"))
(assert (str.prefixof " oncut=" z))
(assert (or (str.contains z "=""ale") (not (<= (str.len x) 48)) (not (str.contains (str.replace x "bl\u{1d400}cl" "alert(1)") "ndalert(1)ick="))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9,\.\(\)\-\+]{5,25}"))))
(assert (not (str.prefixof "<par" y)))
(assert (not (<= (str.len z) 32)))
(check-sat)
