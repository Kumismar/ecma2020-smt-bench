; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;IMG SRC=javascript:alert(';XSS';)>;") (= x "<content onmousemove=""alert(1)"">test</content>")))
(assert (or (= z "ert(1)></bdo>") (= z "beforeactivate=alert(1)></dd>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "t</hgroup>" x))
(assert (or (str.contains (str.replace z "1)" "<b>") "rt(<b>></bd") (str.prefixof "ert(" z)))
(assert (or (>= (str.len y) 111) (str.contains z "(1)></dir>") (str.suffixof ";" x)))
(assert (or (not (= (str.indexof y "SRC" 0) 6)) (= (str.indexof x "ve=" 0) 18)))
(assert (or (not (= "up>" (str.substr z 2 10))) (not (= (str.indexof z "1)><" 0) 21)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{6}[0-9]{2}[abcdehlmprstABCDEHLMPRST]{1}[0-9]{2}([a-zA-Z]{1}[0-9]{3})[a-zA-Z]{1}$"))))
(check-sat)
