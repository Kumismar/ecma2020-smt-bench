; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><marquee id=x style=""transition:color 1s"" ontransitionend=alert(1)></marquee>") (= x "<dfn draggable=""true"" ondragend=""alert(1)"">test</dfn>")))
(assert (or (= z "dex>") (= z "oad=alert(1)></pre>") (= z "46;google&#46;com&#46;/\""&gt;XSS&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!.*(ymobile.ne.jp$|softbank.ne.jp$|i.softbank.jp$|ezweb.ne.jp$|docomo.ne.jp$|gmail.com$|yahoo.co.jp$|icloud.com$|outlook.jp$|outlook.com$|hotmail.com$|freeml.com$)).+$")) (not (= (str.at z 1) "a"))))
(assert (or (not (str.contains (str.replace x "</df" "alert(1)") "testalert(1)n>")) (str.prefixof "<t" y)))
(assert (not (str.contains (str.replace x "tyl" "") "<se>")))
(assert (or (not (str.contains x "nd=""al")) (= "<" (str.substr z 13 1))))
(assert (str.contains x "dragend="""))
(assert (or (= "dra" (str.substr y 24 3)) (= (str.indexof x ">:" 0) 6)))
(assert (str.prefixof "<dfn drag" x))
(assert (or (not (str.contains y "T=")) (= (str.at z 0) "d")))
(check-sat)
