; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th onfocusout=alert(1) tabindex=1 id=x></th><input autofocus>") (= x "<svg><rb onload=alert(1)></rb>")))
(assert (or (= z "%(jscript)s?<B>") (= z "ontenteditable>drop here</head>")))
(assert (= y (str.++ x z)))
(assert (= "<pr ess onbeforecopy=""alert(1)"" content\u{10348}editable>test</progress>" (str.replace x "ogr" " ")))
(assert (or (not (= "t< " (str.replace z "/ul>" " "))) (str.in_re y ((_ re.from_regex ecma2020 u) "(?=^.{8,}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*"))))
(assert (or (not (str.contains (str.replace z "t(1" "x") """alerx)""")) (= (str.indexof x "nd" 0) 28)))
(assert (or (not (= (str.indexof y "<rb" 0) 5)) (not (str.prefixof "<svg><" y)) (str.contains x "=1")))
(assert (or (not (str.prefixof "<th onfoc" x)) (not (= (str.len x) 30)) (= (str.len y) 45)))
(assert (or (not (str.prefixof "%(jscrip" z)) (= "}</styl" (str.substr z 10 7)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{1}[0-9]{1,3}$")))))
(check-sat)
