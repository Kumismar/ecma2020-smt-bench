; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """/><img/onerror=\x22javascript:alert(1)\x22src=xxx:x />") (= x "<span id=x tabindex=1 onfocusin=alert(1)></span>")))
(assert (or (= z "dragend=""alert(1)"">test</shadow>") (= z "g);}</style><rtc id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></rtc>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:\s*)[\w.%+-]+@[\w.-]+\.(?!(con)\b)\b\w{2,6}(?:\s*)$"))) (not (str.contains (str.replace x "rt" "<b>") "le<b>("))))
(assert (or (str.prefixof ">" z) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z ]{2,50}$")))))
(assert (or (str.suffixof "rames>" x) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z 0-9.,+-]*$")))))
(assert (or (not (str.suffixof ">" z)) (not (= (str.indexof y "x" 0) 9)) (= (str.indexof z "trans" 0) 29)))
(assert (>= (str.len y) 126))
(assert (or (not (= "<span id=x tabindexxonfocusin=alert(1)></span>" (str.replace x "=1 " "x"))) (not (str.contains y "t(1)"">te")) (not (= "</" (str.substr z 23 2)))))
(check-sat)
