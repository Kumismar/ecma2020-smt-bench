; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong onmouseleave=""alert(1)"">test</strong>") (= x "<div draggable=""true"" contenteditable>drag me</div><frameset ondragover=alert(1) contenteditable>drop here</frameset>") (= x "<multicol id=x tabindex=1 onbeforedeactivate=alert(1)></multicol><input autofocus>")))
(assert (or (= z "t\u{1f4a9}est</isindex>") (= z ")"">test</asi\u{1d400}de>\u{20000}") (= z "ex=1 id=x></html><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "us>" (str.substr z 20 6))) (str.suffixof "ex>" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9-+/]+"))) (str.suffixof "ript>"">" y) (not (str.contains (str.replace z ")" "x") "x"">tes"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-999999999999]*$"))))
(assert (or (not (str.prefixof "<a id=x ta" y)) (str.contains x "gover=a")))
(check-sat)
