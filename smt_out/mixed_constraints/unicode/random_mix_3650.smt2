; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link onmouseleave=""alert(1)"">test</link>") (= x "<body onload!#$%&()*~+-_.,:;?@[/|\]^`=document.vulnerable=true;>") (= x "<s id=x tabindex=1 onfocusin=alert(1)></s>")))
(assert (or (= z "</legend>") (= z "put autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "ocus>" z))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z0-9._-]+@[a-z0-9]{2,}\.[a-z]{2,3}$"))) (not (<= (str.len x) 74)) (= (str.indexof y "oc" 0) 50)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}0-9\s]+"))) (not (str.suffixof "end>" y)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[^@<>\t\r\n]+$"))))
(assert (or (not (str.contains x "h.s")) (not (str.contains (str.replace x ")""" "alert(1)") "ert(1alert(1)>te"))))
(check-sat)
