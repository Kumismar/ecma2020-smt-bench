; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt onfocusout=alert(1) tabindex=1 id=x></dt><input autofocus>") (= x "<embed code=%(scriptlet)s></embed>") (= x "<shadow oncut=""alert(1)"" contenteditable>test</\u{1f600}shadow>")))
(assert (or (= z " SRC=javascript:alert(&;quot;XSS&;quot;)>;") (= z "ndex=1 id=x></p><input autofocus>") (= z "onactivate=alert(1)></svg>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len x) 46)) (not (= (str.indexof y "o" 0) 5)) (= "<shadow oncut=""alert(1)"" contenteditable>test</\u{1f600}shadow>onactivate=alert(1)></x>" (str.replace y "svg" "x"))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z]{1,}[\.]{0,1}[\s]{1}[A-Za-z]{1,}[\s|-]{0,1}[A-Za-z]{0,}")))
(assert (or (not (= (str.indexof x "a" 0) 3)) (str.suffixof "autofocus>" x)))
(assert (or (= (str.indexof z "x"" o" 0) 50) (not (= "<  onfocusout=alert(1) tabindex=1 id=x></dt><input autofocus> SRC=javascript:alert(&;quot;XSS&;quot;)>;" (str.replace y "dt" " ")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9\-_\.]+)@([a-zA-Z0-9\-_]+\.)+[a-zA-Z]{2,}$"))))
(assert (or (str.contains (str.replace z "><" "") "d=x/p") (not (= "di>" (str.substr z 3 4))) (str.suffixof "focus>" x)))
(assert (not (= "=alert(1)>" (str.substr z 1 10))))
(check-sat)
