; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th id=x tabindex=1 ondeactivate=alert(1)></th><input id=y autofocus>") (= x "g'""></IFRAME>Hover the cursor to the LEFT of this Message</h1>&ParamHeight=250") (= x "<basefont onpaste=""alert(1)"" contenteditable>test</basefont>")))
(assert (or (= z "SS&quot;)>&quot;;&apos;&gt; out") (= z "javascript&#058;alert('XSS\u{1f4a9}');\""&gt;")))
(assert (= y (str.++ x z)))
(assert (<= (str.len z) 36))
(assert (not (str.prefixof "g'""" x)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}]+[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}'\u{2019}\- ]{1,24}$"))))
(assert (not (str.contains (str.replace z ">do" " ") " cu")))
(assert (or (= (str.indexof y ";" 0) 67) (str.in_re z ((_ re.from_regex ecma2020 u) "\(\d\d\) \d\d\d\d\d-\d\d\d\d$"))))
(assert (or (not (str.contains x "=1")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{4,12}$")))))
(assert (or (str.prefixof "g'""></IFR" y) (not (<= (str.len x) 84)) (= (str.at x 62) "&")))
(assert (or (not (= (str.at x 25) "1")) (not (str.prefixof "<t" y)) (= (str.indexof y "t(/X" 0) 43)))
(check-sat)
