; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param id=x tabindex=1 onfocus=alert(1)></param>") (= x "<strike onmouseenter=""alert(1)"">test</strike>")))
(assert (or (= z "nfocus=alert(1)></body>") (= z "AD=alert(\u{2019}XSS\u{2019})>") (= z "gable=""true"" ondragstart=""alert(1)"">test</frameset>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "AD=" z) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-z0-9A-Z@._\\-]+$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[_A-zA-z- ]{1,}$")) (not (str.contains x "ert(1)></p")) (= "ocus=" (str.substr z 2 5))))
(assert (or (str.suffixof "</hr>" z) (= (str.at y 52) "t")))
(assert (or (not (= (str.at x 43) "e")) (not (str.contains z "RE")) (str.prefixof "<strike on" y)))
(assert (= (str.at z 2) "="))
(assert (or (not (str.contains z "focu")) (not (= "onm" (str.substr y 8 3)))))
(assert (or (not (str.prefixof "AD=ale" z)) (not (= "<param id=x tabindex=1 onf<b>alert(1)></param>" (str.replace x "ocus=" "<b>")))))
(check-sat)
