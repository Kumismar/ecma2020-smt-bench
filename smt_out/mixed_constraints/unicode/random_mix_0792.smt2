; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed draggable=""true"" ondrag=""alert(1)"">test</noembed>") (= x "<dialog id=x tabindex=1 onbeforedeactivate=alert(1)></dialog><input autofocus>") (= x "<header onkeypress=""alert(1)"" contenteditable>test</header>")))
(assert (or (= z """>test</nav>") (= z "ontransitionend=alert(1)></header>") (= z "eshowshoweshowshowgeshow=""alert(1)"";")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[9|8|7|6|5|4|3|2|1|0]\d{8}$"))) (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{4}\s\d{4}\s\d{4}$"))))
(assert (or (not (str.prefixof "<head" y)) (not (= (str.indexof y "howe" 0) 64)) (= ">" (str.substr z 11 9))))
(assert (or (= (str.indexof z ";" 0) 35) (= "sitionen" (str.substr z 6 8))))
(assert (or (not (= (str.len x) 7)) (str.contains y ">t")))
(assert (not (= "<dialalert(1)d=x tabindex=1 onbeforedeactivate=alert(1)></dialog><input autofocus>" (str.replace x "og i" "alert(1)"))))
(assert (not (>= (str.len y) 86)))
(assert (not (= (str.len x) 58)))
(check-sat)
