; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote onmouseout=""alert(1)"">test</blockquote>") (= x "</script><script>alert('XSS');</script>") (= x "<link onmousedown=""alert(1)"">test</link>")))
(assert (or (= z "data onmouseover=""alert(1)"">test</data>") (= z "ir>") (= z "activate=alert(1)></isindex><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "m" z)) (str.suffixof "/link>" x)))
(assert (not (str.contains z "ert(1)></")))
(assert (or (not (= (str.at y 30) "<")) (= (str.indexof z "ir>" 0) 0)))
(assert (or (str.prefixof "<" y) (str.contains (str.replace z "ale" "alert(1)") """alert(1)rt") (str.in_re y ((_ re.from_regex ecma2020 u) "^\+?[0-9 ]{8,16}$"))))
(assert (not (str.prefixof "<bloc" x)))
(assert (str.suffixof ">" x))
(assert (not (= (str.at y 82) "t")))
(assert (not (= (str.at z 0) "i")))
(check-sat)
