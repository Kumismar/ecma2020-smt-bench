; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""javas\x06cript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<animate attributeName=""onunload"" to=""alert(89)""/>") (= x "<style>:target {color: red;}</style><wbr id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></wbr>")))
(assert (or (= z "enu=""alert(1)"">test</ol>") (= z "alert(1)"">test</h1>")))
(assert (= y (str.++ x z)))
(assert (or (= "tributeN" (str.substr y 11 8)) (not (str.contains (str.replace z ">te" "<b>") "able<b>s")) (str.suffixof ">" y)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9@\.]*")) (<= (str.len y) 83)))
(assert (or (not (str.contains z "test</h1>")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z \u{e4}\u{c4}\u{f6}\u{d6}\u{fc}\u{dc}\u{df}-]+"))) (not (= "<a href=""javas\x06cript:javascriptjavascript:t(1)"" id=""fuzzelement1"">test</a>enu=""alert(1)"">test</ol>" (str.replace y ":aler" "javascript:")))))
(assert (or (not (= (str.at x 25) "<")) (str.prefixof "<animate" y) (not (str.suffixof "est</h1>" z))))
(assert (not (str.suffixof "est</b>>" y)))
(assert (or (not (= (str.at y 48) """")) (not (= "t(1)"">test" (str.substr z 4 10))) (str.in_re z ((_ re.from_regex ecma2020 u) "^\(?(\d{3})\)?[\s.-]?(\d{3})[\s.-]?(\d{4})$"))))
(check-sat)
