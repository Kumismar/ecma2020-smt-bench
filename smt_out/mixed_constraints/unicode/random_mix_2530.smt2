; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><a id=x style=""transition:color 1s"" ontransitionend=alert(1)></a>") (= x "<script/src=""data:&comma;eval(atob(location.hash.slice(1)))//#alert(1)")))
(assert (or (= z "sin=alert(1) type=text/html>") (= z "click=""alert(1)"">tes\u{1d400}t</th>") (= z "ert(1)"" contenteditable>test</blink>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 4) "1") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^0\d{1,3}-?\d{2,4}-?\d{4}"))) (= "sin=alert(1) type=text/hjavascript:l>" (str.replace z "tm" "javascript:"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[-, A-Za-z0-9]+$")) (not (= (str.at x 43) "."))))
(assert (or (= (str.at z 22) "t") (= (str.indexof z "link" 0) 31)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "1[3456789]\d{9}$"))))
(check-sat)
