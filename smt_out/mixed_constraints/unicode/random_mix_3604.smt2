; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time draggable=""true"" ondragenter=""alert(1)"">test</time>") (= x "<div draggable=""true"" contenteditable>drag me</div><template ondragover=alert(1) contenteditable>drop here</template>") (= x "<style>:target {color: red;}</style><wbr id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></wbr>")))
(assert (or (= z "ontenteditable>test</section>") (= z ">test</bdi>") (= z "ut oninput=alert(1) value=xss>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<style>:ta" y)) (not (str.prefixof "1)"">" z))))
(assert (or (str.prefixof "<style>:t" y) (str.contains y "ontr") (>= (str.len x) 61)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{e4}\u{f6}\u{fc} .'-]+$"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^.+@(?:(?!(g|hot|y|google|hush|fast|at|short|at|proton)?mail)(?!live)(?!gmx)(?!yahoo)(?!hotmail)(?!gmail)(?!outlook)(?!msn)(?!icloud)(?!facebook)(?!aol)(?!zoho)(?!yandex)(?!lycox)(?!inbox)(?!myway)(?!aim)(?!goowy)(?!juno).)+\..+$"))))
(assert (not (= "ten" (str.substr z 2 3))))
(check-sat)
