; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot oncut=""alert(1)"" contenteditable>test</tfoot>") (= x "<a href=""\x12javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "s"" ontransitionend=alert(1)></rp>") (= z "map id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></map>") (= z "ert(\u{1f600}1)"" contenteditable>test</footer>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "/rp>" z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "1912"))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^((?!https://bit.ly)(?!Robot).)*$")))
(assert (= (str.len y) 143))
(assert (= "i" (str.substr x 31 1)))
(assert (or (str.prefixof "<t" y) (= "alert(1)" (str.substr x 14 8))))
(assert (or (str.prefixof "ma" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9_]{10,10}$"))) (= (str.indexof y "f" 0) 6)))
(check-sat)
