; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound id=x tabindex=1 onbeforedeactivate=alert(1)></bgsound><input autofocus>") (= x "<summary onmouseenter=""alert(1)"">test</summary>") (= x "<a href=""\x18javascript:javascript:alert(1)\u{1f600}"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "te(180deg);}</style><output id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></output>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 41) "t")) (not (= (str.len x) 72)) (= (str.indexof y "pt:ja" 0) 21)))
(assert (or (not (str.contains x " hr")) (str.suffixof ">" z)))
(assert (or (= ">" (str.substr z 0 1)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{13}"))))
(assert (or (= (str.len x) 124) (not (= (str.indexof y "tput " 0) 103))))
(assert (or (str.suffixof "t>" y) (not (= """ st" (str.substr y 31 4)))))
(check-sat)
