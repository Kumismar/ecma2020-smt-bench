; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet onmouseup=""alert(1)"">test</applet>") (= x "<style>:target {transform: rotate(180deg);}</style><font id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></font>")))
(assert (or (= z ")"">test</datalist>") (= z "rt(1)</s\u{10348}cript>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "/optgroup>" y) (not (= (str.at y 114) "("))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{0,2}\d"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,15}$"))) (str.suffixof "header>" z)))
(assert (or (not (= (str.at x 63) "t")) (not (= (str.indexof y "/appl" 0) 34)) (str.suffixof "datalist>" y)))
(assert (not (= "<applet onmouseup=""alert(1javascript:st</applet>" (str.replace x ")"">te" "javascript:"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^https:\/\/|^http:\/\/)?\w+\.\w+(\.\w+)?"))) (= "ansform 2s" (str.substr x 82 10))))
(check-sat)
