; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span onkeypress=""alert(1)"" contenteditable>test</span>") (= x "<style>@keyframes x{}</style><strike style=""animation-name:x"" onanimationstart=""alert(1)""></strike>") (= x "<time onblur=alert(1) tabindex=1 id=x></time><input autofocus>")))
(assert (or (= z "st</source>") (= z "ut=""alert(1)"">test</strong>") (= z "'s1' 's2)}@import javascript:javascript:alert(1);');}</STYLE>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "up") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\(?\d{2}\)?[\s-]?[\s9]?\d{4}-?\d{4}$"))) (= (str.at y 25) "d")))
(assert (or (= (str.indexof y "tyle=" 0) 38) (= (str.indexof x "/sp" 0) 49)))
(assert (or (= (str.indexof y "(1)" 0) 116) (not (str.contains x "style>@"))))
(assert (>= (str.len z) 8))
(check-sat)
