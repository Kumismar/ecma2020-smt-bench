; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<STYLE type=""text/css"">BODY{background:url(""javascript:alert('XSS')"")}</STYLE>") (= x "<colgroup onkeypress=""alert(1)"" contenteditable>test</colgroup>") (= x "<address onbeforepaste=""alert(1)"" contenteditable>test</address>")))
(assert (or (= z ">") (= z ")"" contenteditable>test</label>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z ">")) (= "<STYLE type=""text/css"">BODY{background:url(""javascript:alert('XSS')"")}<<b>YLE>" (str.replace x "/ST" "<b>")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\u{201c}(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,}\u{201d}")))))
(assert (= "<u id=x tabindex=1 onbeforedeac te\u{1f4a9}=alert(1)></u><in\u{1f4a9}put autofocus>" (str.replace x "tiva" " ")))
(assert (or (= (str.indexof z "able>" 0) 14) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{5c}u4e00-\u{5c}u9fa5]{0,}$")))))
(assert (or (str.prefixof ")"" co" z) (not (str.contains (str.replace x "ol" "<b>") "<c<b>group"))))
(assert (or (not (>= (str.len y) 86)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,20}")))))
(assert (not (= "aste=""aler" (str.substr y 18 10))))
(assert (not (str.prefixof "<" y)))
(check-sat)
