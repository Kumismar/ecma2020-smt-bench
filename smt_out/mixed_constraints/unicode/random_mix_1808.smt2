; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blink onclick=""alert(1)"">test</blink>") (= x "<script\x0D>javascript:alert(1)</script>") (= x "<noembed draggable=""true"" ondrag=""alert(1)"">test</noembed>")))
(assert (or (= z "le><nobr id=x style=""transition:color 1s"" ontransitionend=alert(1)></nobr>") (= z "%70%74%3E""></iframe>") (= z ":alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "e=""tran" (str.substr y 56 7))) (not (= (str.indexof x "te on" 0) 7)) (not (str.suffixof "t</blink>" x))))
(assert (str.prefixof "<scrip" y))
(assert (or (str.contains (str.replace y "scrip" """") "<""t") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9\-]{10,20}$")))))
(assert (or (not (= (str.indexof x "t(1" 0) 38)) (not (str.contains z "usedown")) (= (str.indexof x "em" 0) 3)))
(check-sat)
