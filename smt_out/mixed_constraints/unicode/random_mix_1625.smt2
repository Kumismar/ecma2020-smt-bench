; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b id=x tabindex=1 ondeactivate=alert(1)></b><input id=y autofocus>") (= x "<param onblur=alert(1) tabindex=1 id=x></param><input autofocus>") (= x "'<script>window.onload=function(){document.forms[0].message.value='1';}</script>")))
(assert (or (= z "alert(1)"">test</s>") (= z "1)"">test</sup>") (= z "ut=alert(1) tabindex=1 id=x></bdi><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "rt(1)"">te" (str.substr y 38 9)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z0-9!'#$%&*+\/=?^_`{|}~-]+(?:\.[a-z0-9!'#$%&*+\/=?^_`{|}~-]+)*@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-zA-Z]{2,}$"))) (= (str.indexof z "XS" 0) 35)))
(assert (not (str.contains z "able")))
(assert (or (= "1)""" (str.substr y 49 3)) (not (str.contains x " id=x></")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z][0-9][A-Za-z][\s]?[0-9][A-Za-z][0-9]")))))
(assert (or (not (= (str.len x) 64)) (= "1 " (str.substr y 32 2)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9 +][0-9 ()-]+")))))
(assert (or (not (str.contains (str.replace z "t" "javascript:") "alerjavascript:(1)")) (str.suffixof "/sup>" y)))
(check-sat)
