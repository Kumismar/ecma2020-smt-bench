; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IFRAME SRC=http://ha.ckers.org/scriptlet.html &lt;") (= x "<marquee draggable=""true"" ondragleave=""alert(1)"">test</marquee>")))
(assert (or (= z "onkeyup=""alert(1)"" contenteditable>test</div>") (= z "onmouseleave=""alert(1)"">test</strong>") (= z "1 id=x></noembed><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len y) 107)) (>= (str.len x) 52)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}\u{4d9}\u{4d8}\u{456}\u{406}\u{4a3}\u{4a2}\u{493}\u{492}\u{4af}\u{4ae}\u{4b1}\u{4b0}\u{49b}\u{49a}\u{4e9}\u{4e8}\u{4bb}\s.,\-]+"))) (str.suffixof ">" z) (= (str.indexof z "ble>t" 0) 31)))
(assert (not (= (str.indexof x "ptlet" 0) 39)))
(assert (or (= (str.indexof x "uee" 0) 5) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{1,}$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{3}\s[0-9]{2,4}\/[0-9]{2,4}\/[0-9]{4}$"))))
(assert (or (not (str.suffixof "ss>" x)) (not (str.contains (str.replace y "ee>o" "<b>") "marqu<b>nkey"))))
(check-sat)
