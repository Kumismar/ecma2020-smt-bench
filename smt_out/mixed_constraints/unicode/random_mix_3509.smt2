; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt onmouseenter=""alert(1)"">test</dt>") (= x "<colgroup ondblclick=""alert(1)"">\u{1f4a9}test</colgroup>")))
(assert (or (= z "mark>") (= z "log draggable=""true"" ondragstart=""alert(1)"">test</dialog>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len z) 5)))
(assert (or (= (str.at y 89) "a") (str.contains y "=""aler")))
(assert (or (= (str.at y 72) "r") (not (str.contains z "log")) (not (= "nte" (str.substr y 29 3)))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{1,16}$"))))
(assert (= (str.at y 32) "\u{1f4a9}"))
(check-sat)
