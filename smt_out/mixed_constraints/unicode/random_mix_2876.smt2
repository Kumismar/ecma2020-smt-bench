; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture onmouseleave=""alert(1)"">test</picture>") (= x "<applet onkeyup=""alert(1)"" contenteditable>test</applet>")))
(assert (or (= z "lert(1) type=text/html>") (= z "@keyframes x{}</style><select style=""animation-name:x"" onanimationend=""alert(1)""></select>")))
(assert (= y (str.++ x z)))
(assert (or (= "lert(1) " (str.substr z 0 8)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[#$^+=!*()@%&]).{8,10}$"))) (not (= "eyframes " (str.substr z 2 9)))))
(assert (or (not (<= (str.len x) 64)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9 +]*$"))) (not (= (str.len y) 79))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^(['a-zA-z\u{430}-\u{44f}\u{410}-\u{44f}\u{401}\u{451}]\s?-?){2,50}$")))
(assert (not (= "<div draggable=""true"" conteitable>drag me</div><blink ondrop=alert(1) contenteditable>drop here</blink>mport javascript:javascript:alert(1);');}</STYLE>" (str.replace y "nted" ""))))
(assert (or (not (str.contains y ":x"" onan")) (not (= (str.indexof x """al" 0) 22))))
(assert (or (str.contains z "end=""a") (str.contains (str.replace y "xt/" "<b>") "pe=te<b>htm") (not (str.contains x "ert(1)"">"))))
(assert (or (str.contains (str.replace y "nke" "<b>") "t o<b>yu") (not (<= (str.len y) 140))))
(check-sat)
