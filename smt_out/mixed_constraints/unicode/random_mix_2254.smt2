; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "</textarea><script>alert(/xss/)</script>") (= x "<s onpaste=""alert(1)"" contenteditable>test</s>") (= x "<data id=x tabindex=1 onfocus=ale\u{10348}rt(1)></data>")))
(assert (or (= z "/frame>") (= z "="";&;{alert(';XSS';)}"";>;")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<" y))
(assert (or (not (= "test</s" (str.substr x 38 7))) (str.contains x "1)")))
(assert (not (= (str.indexof x "1" 0) 19)))
(assert (or (str.contains x "ndex=1 onf") (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-4][0-9][0-9]?$|^[1-9]\d$|^[1-9]$|^500$"))))
(assert (= "rt(';XSS';" (str.substr z 9 10)))
(assert (= (str.at x 72) "r"))
(assert (or (>= (str.len x) 41) (= (str.indexof x "ipt" 0) 15) (= (str.indexof y "in" 0) 14)))
(assert (not (= "="";ert(';XSS';)}"";>;" (str.replace z "&;{al" ""))))
(check-sat)
