; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noframes draggable=""true"" ondrag=""alert(1)"">test</noframes>") (= x "<em draggable=""tru\u{1d400}e"" ondragstart=""alert(1)"">test</em>")))
(assert (or (= z "ption onmouseenter=""alert(1)"">test</caption>") (= z "efont>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._-]+@[A-Za-z0-9-]+\.[a-z]{2,}$")) (= ">" (str.substr y 115 2)) (not (>= (str.len y) 98))))
(assert (not (str.contains y "e=""true")))
(assert (or (<= (str.len y) 71) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^-?\d+(?:\.\d*)?(?:[Ee][+\-]?\d+)?$"))) (not (str.prefixof "<n" x))))
(assert (not (= (str.at z 24) "r")))
(assert (or (not (= (str.at y 23) "n")) (= (str.indexof z "t>" 0) 4)))
(assert (= (str.len y) 60))
(assert (or (str.prefixof "<em" x) (= "te" (str.substr z 30 2)) (not (= """" (str.substr y 25 1)))))
(check-sat)
