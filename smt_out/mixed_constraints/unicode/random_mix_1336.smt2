; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ol onmouseup=""alert(1)"">test</ol>") (= x "<strike onpaste=""alert(1)"" contenteditable>test</strike>")))
(assert (or (= z """ ondrag=""alert(1)"">test</header>") (= z "e=alert(1)></small><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x "extmen")))
(assert (or (str.contains y "re on") (not (<= (str.len y) 93))))
(assert (or (= (str.at z 31) "o") (str.suffixof "%00" z)))
(assert (or (= (str.indexof z "ut" 0) 23) (str.suffixof "r>" y) (not (str.contains (str.replace y "e=a" "<b>") "</ol><b>ler"))))
(assert (= "<small onkeypress=""alert(1)"" contenteditaalert(1)le>test</small>" (str.replace x "b" "alert(1)")))
(assert (not (= (str.indexof x "(""XSS" 0) 8)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "\d{5,15}"))) (not (str.prefixof """ ondra" z)) (not (str.contains (str.replace z "np" "javascript:") "l><ijavascript:ut"))))
(check-sat)
