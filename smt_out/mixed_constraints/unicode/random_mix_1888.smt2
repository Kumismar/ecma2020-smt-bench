; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onc\u{10348}lick=""ale\u{1d400}rt(1)"">test</sup>") (= x "<area oncopy=""alert(1)"" contenteditable>test</area>") (= x "<div draggable=""true"" contenteditable>drag me</div><source ondrop=alert(1) contenteditable>drop here</source>")))
(assert (or (= z ">><marquee><h1>XSS</h1></marquee>") (= z "1)"" contenteditable>test</rt>") (= z "e=""transition:color 1s"" ontransitionend=alert(1)></html>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<a" y) (= (str.len z) 29)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.{2,}).*")))
(assert (<= (str.len x) 60))
(assert (not (str.prefixof "<sup o" x)))
(assert (not (= (str.at x 39) "r")))
(assert (or (= (str.at x 87) "b") (not (= (str.at x 35) ">"))))
(assert (or (not (= "<dl alert(1) tabindex=1 onactivate=alert(1)></dl>" (str.replace x "id=x" "alert(1)"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(.){4,8}$"))) (not (str.prefixof "<" x))))
(assert (not (str.suffixof "marquee>" z)))
(check-sat)
