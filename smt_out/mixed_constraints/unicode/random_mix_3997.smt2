; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param onmouseleave=""alert(1)"">test</param>") (= x "<rt onmousedown=""alert(1)"">test</rt>") (= x "<source id=x tabindex=1 onfocusin=alert(1)></source>")))
(assert (or (= z "/onerror=\x09javascript:alert(1)\x09src=xxx:x />") (= z "tofocus>") (= z "-x509-user-cert;&NewLine;base64&NewLine;,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==""&#09;&#10;&#11;>X</a")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "rp" 0) 1)) (not (>= (str.len y) 97))))
(assert (or (= (str.at x 25) "t") (str.suffixof ">" z)))
(assert (or (str.contains z "9-") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9-+s()]*$")))))
(assert (str.contains z "tofocus>"))
(assert (not (= "cript:a" (str.substr y 30 7))))
(assert (or (not (= (str.indexof z "ocu" 0) 3)) (not (str.in_re z ((_ re.from_regex ecma2020 u) ".{0,170}"))) (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{0,20}$"))))
(assert (= (str.indexof z "64&" 0) 29))
(check-sat)
