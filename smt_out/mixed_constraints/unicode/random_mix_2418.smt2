; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><legend style=""animation-name:x"" onanimationend=""alert(1)""></legend>") (= x "<tr onmouseenter=""alert(1)"">test</tr>") (= x """><script alert(String.fromCharCode(88,83,83))</script>")))
(assert (or (= z "lementation=\""#default#time2\""&gt;") (= z "wn=""alert(1)"">test</picture>") (= z "d=x tabindex=1 onactivate=alert(1)></s>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,100}$"))) (= "</k" (str.substr z 2 3))))
(assert (or (<= (str.len y) 68) (not (str.prefixof "<t" x))))
(assert (not (= ")"">test" (str.substr y 25 7))))
(assert (or (not (= "emove=""a" (str.substr x 11 8))) (str.suffixof "</s>" y)))
(assert (or (= (str.indexof x """ale" 0) 17) (not (= (str.at y 3) " ")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "\.(pdf|doc|docx)$")))))
(check-sat)
