; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed ondblclick=""alert(1)"">test</embed>") (= x "<? foo=""><x foo='?><script>alert(1)</script>'>"">")))
(assert (or (= z "T>") (= z "ditable>test</cite>") (= z "e>:target {color:red;}</st\u{10348}yle><menu id=x style=""t\u{1f4a9}ransition:color 1s"" ontransitionend=alert(1)></menu>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "ck=" "") "cli""aler")) (not (str.contains y "alert(1)<")) (not (str.contains y "ert("))))
(assert (or (not (= "<embed ondblclic<b>""alert(1)"">test</embed>ditable>test</cite>" (str.replace y "k=" "<b>"))) (not (str.suffixof "'>"">" x))))
(assert (or (= "%65%72 XSS/)></script" (str.replace z "%74(/" " ")) (= "ta" (str.substr z 2 2))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\+[1-9]{1}[0-9]{3,14}$"))) (not (= (str.at z 0) "T"))))
(assert (not (str.suffixof ">"">T>" y)))
(assert (or (= (str.at z 45) "l") (not (= (str.len z) 103)) (not (str.suffixof "1)></menu>" y))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-za-z0-9.-]+\.[A-Za-z]{2,3}$"))))
(check-sat)
