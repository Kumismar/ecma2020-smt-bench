; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;STYLE>;@im\port';\ja\vasc\ript:alert("";XSS"";)';;<;/STYLE>;") (= x "<fieldset onmo\u{1f600}usemove=""alert(1)"">test</fi\u{1f4a9}eldset>") (= x "<bdi onmouseup=""alert(1)"">test</bdi>")))
(assert (or (= z " id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></svg>") (= z "t;&gt;&lt;/TD&gt;&lt;/TABLE&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9][-a-zA-Z0-9\. ]{2,}$"))) (not (str.suffixof "&gt;" y))))
(assert (or (not (= (str.indexof x "\u{1f600}us" 0) 14)) (= "t" (str.substr z 4 1))))
(assert (str.contains z "t;&lt;"))
(assert (or (= (str.at z 12) "D") (not (str.contains x "';;<;/STY"))))
(assert (or (not (str.contains y ">t;&")) (str.prefixof "<" x)))
(assert (not (str.prefixof "t" z)))
(check-sat)
