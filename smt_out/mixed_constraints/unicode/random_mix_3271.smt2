; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x12javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<div draggable=""true"" contenteditable>drag me</div><datalist ondrop=alert(1) contenteditable>drop here</datalist>") (= x "<rb onkeydown=""alert(1)"" contenteditable>test</rb>")))
(assert (or (= z "nbeforeactivate=alert(1)></bdo>") (= z "vate=alert(1)></legend><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<rb" x) (not (= (str.at z 7) "a")) (= "ert(" (str.substr y 18 4))))
(assert (or (= (str.at y 32) "c") (not (str.prefixof "<div dra" x)) (str.in_re x ((_ re.from_regex ecma2020 u) "\([0-9]{2}\) [0-9]{5}-[0-9]{4}$"))))
(assert (or (not (= (str.len y) 71)) (= "<small draggable=""true"" ondragend=""alert(1)"">test</small>editable>drag me</div><selealert(1) ondragover=alert(1) contenteditable>drop here</select>" (str.replace y "ct" "alert(1)")) (str.in_re y ((_ re.from_regex ecma2020 u) "(^\([0-9][1-9]\)[ ]?[0-9]{4,5}[ -][0-9]{4}$)|(^\+[0-9]{9,}$)|(^0[1-9]00[ ]?[0-9]{2,3}[ ]?[0-9]{4}$)"))))
(assert (or (= "n=""aler" (str.substr x 12 7)) (= "key" (str.substr x 6 3))))
(assert (str.contains x ") conte"))
(check-sat)
