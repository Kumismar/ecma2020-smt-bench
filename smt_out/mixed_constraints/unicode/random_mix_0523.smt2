; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<code draggable=""true"" ondragend=""alert(1)"">test</code>") (= x "&lt;BODY ONLOAD=alert(&apos;XSS&apos;)&gt;") (= x "<div draggable=""true"" contenteditable>drag me</div><ruby ondrop=alert(1) contenteditable>drop here</ruby>")))
(assert (or (= z "aggable=""true"" ondrag=""alert(1)"">test</var>") (= z " here</area>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 75) "n") (not (str.contains (str.replace x "AD=al" "x") "LOxe"))))
(assert (or (not (>= (str.len x) 56)) (str.contains z ">")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^([\w.-]+)@(\[(\d{1,3}\.){3}|(?!live\.fr|mail\.ru|hotmail\.fr|arcor\.de|inbox\.ru|yams08|eric\.jones)(([a-zA-Z\d-]+\.)+))([a-zA-Z]{2,4}|\d{1,3})(\]?)$")))
(assert (or (not (str.suffixof "l>" z)) (str.suffixof "</code>" x) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([1-9]|[1-4]\d|50)$")))))
(assert (not (str.contains z "ere</area>")))
(assert (or (not (str.contains z "true"" ond")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[9|6|7][0-9]{8}$")))))
(check-sat)
