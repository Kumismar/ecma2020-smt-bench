; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<head onbeforecopy=""alert(1)"" contenteditable>test</head>") (= x "<ol onmouseup=""alert(1)"">test</ol>")))
(assert (or (= z "mes x{}</style><i style=""animation-name:x"" onanimationend=""alert(1)""></i>") (= z "=x tabindex=1 onfocusi\u{1d400}n=alert(1)></marquee>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z ")></" 0) 32)) (<= (str.len x) 38)))
(assert (or (not (= (str.at z 14) "o")) (not (= "></i>" (str.substr y 102 6)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[ a-zA-Z ]+$"))) (str.contains z "t(1)")))
(assert (or (= (str.at y 47) "e") (= (str.indexof z "=ale" 0) 24) (str.in_re z ((_ re.from_regex ecma2020 u) ".{0}|.{2,8}"))))
(assert (not (= (str.indexof z ":java" 0) 21)))
(assert (<= (str.len z) 53))
(assert (not (>= (str.len z) 40)))
(check-sat)
