; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br onmouseover=""alert(1)"">test</br>") (= x "&lt;BASE HREF=&quot;javascript:alert(&apos;XSS&apos;);//&quot;&gt;")))
(assert (or (= z "est</link>") (= z "script:alert('XSS');"">") (= z ";")))
(assert (= y (str.++ x z)))
(assert (not (= "<br onmouseover=""alert(1) t</br>est</link>" (str.replace y """>tes" " "))))
(assert (or (not (str.prefixof "script:ale" z)) (str.suffixof "ocus>>" y)))
(assert (or (str.suffixof "est</link>" z) (str.contains (str.replace x "cont" "alert(1)") "(1)"" alert(1)ent")))
(assert (or (= "<br onmouseover=""alert(1)"">test</br>est<<b>nk>" (str.replace y "/li" "<b>")) (not (= "st" (str.substr x 29 2))) (= (str.indexof x "y" 0) 51)))
(assert (or (not (= (str.at x 5) "A")) (str.in_re y ((_ re.from_regex ecma2020 u) "(\d{15}$|^\d{18}$|^\d{17}(\d|X|x))")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(CZ|Cz|cz|cZ|SK|Sk|sk|sK)[0-9\.\-]{8,10}$")))))
(assert (or (str.contains z "S');") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[A-Za-z\d$@$!%*?&]{8,}$")))))
(assert (not (>= (str.len z) 23)))
(check-sat)
