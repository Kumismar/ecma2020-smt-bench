; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div STYLE=""background-image: url(&#1;javascript:document.vulnerable=true;)"">") (= x "<hgroup onbeforecut=""alert(1)"" contenteditable>test</hgroup>")))
(assert (or (= z """>test</noembed>") (= z "lert(1\u{10348})></select>") (= z "drag me</div><dl ondragover=alert(1) contenteditable>drop here</dl>")))
(assert (= y (str.++ x z)))
(assert (= "<""group onbeforecut=""alert(1)"" contenteditable>test</hgroup>"">test</noembed>" (str.replace y "h" """")))
(assert (str.contains (str.replace x """b" "<b>") "LE=<b>ack"))
(assert (not (= (str.at y 63) " ")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[ \t\r\n\f0-9-()+-]*$"))) (str.contains y "nteditabl") (not (str.prefixof "lert(1" z))))
(assert (or (str.prefixof "<div STYL" x) (= "<div STYLE=""background-ixage: url(&#1;javascript:document.vulnerable=true;)"">"">test</noembed>" (str.replace y "m" "x"))))
(check-sat)
