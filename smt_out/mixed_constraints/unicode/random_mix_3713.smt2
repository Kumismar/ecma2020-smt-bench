; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG SRC=&quot;jav&amp;#x0A;ascript:alert(&apos;\u{1d400}XSS&apos;);&quot;&gt;") (= x "<progress id=x tabindex=1 onactivate=alert(1)></progress>") (= x "<html id=x tabindex=1 ondeactivate=alert(1)></html><input id=y autofocus>")))
(assert (or (= z "p=""alert(1)"" contenteditable>test</section>") (= z "rt(1)"" contenteditable>test</q>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "uot;jav&am")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:(\(?(0|\+44)[1-9]{1}\d{2,4}?\)?\s?\d{3,4}\s?\d{3,4}))?$"))) (not (str.prefixof "<progress" x))))
(assert (or (= (str.len y) 88) (not (str.contains (str.replace y "seen" "<b>") "onmou<b>ter="))))
(assert (str.contains y "ate=ale"))
(assert (or (= (str.indexof y """aler" 0) 75) (not (str.prefixof "<html id=" y))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.+@((?!hotmail)(?!gmail)(?!ymail)(?!googlemail)(?!live)(?!gmx)(?!yahoo)(?!outlook)(?!msn)(?!icloud)(?!facebook)(?!aol)(?!zoho)(?!mail)(?!yandex)(?!hushmail)(?!lycox)(?!lycosmail)(?!inbox)(?!myway)(?!aim)(?!fastmail)(?!goowy)(?!juno)(?!shortmail)(?!atmail)(?!protonmail).)+\..+$"))) (= """><img src=1 rr\u{1f600}or=alert(1)>.gif" (str.replace x " one" " "))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[A-Za-z])(?=.*\d)(?=.*[@$!%.,:;-_^\u{b0}+*#?&])[A-Za-z\d@$!%.,:;-_^\u{b0}+*#?&]{8,}$")))
(assert (str.prefixof "&lt;IM" x))
(assert (not (= (str.at x 10) "g")))
(assert (not (str.contains (str.replace y "ivate" """") "act""=al")))
(check-sat)
