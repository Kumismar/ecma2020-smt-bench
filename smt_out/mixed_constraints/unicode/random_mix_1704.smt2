; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike onmouseover=""alert(1)"">test</strike>") (= x "<style>:target {transform: rotate(180deg);}</style><rt id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></rt>") (= x "<xmp onbeforecopy=""alert(1)"" contenteditable>test</xmp>")))
(assert (or (= z """ ondragleave=""alert(1)"">test</select>") (= z "nbeforecut=""alert(1)"" contenteditable>test</strike>") (= z "le=""true"" ondragenter=""alert(1)"">test</thead>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "e(18") (not (= (str.at x 13) "c"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "\([0-9]{2}\)[\s]{0,1}[0-9]{4,5}-[0-9]{4}$"))))
(assert (not (str.contains (str.replace y "r" " ") "<st ike")))
(assert (or (>= (str.len z) 33) (= (str.indexof x "nsf" 0) 19) (= (str.len y) 167)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{25,45}"))) (= "rike>" (str.substr x 39 9))))
(assert (not (= (str.indexof z "test" 0) 33)))
(assert (= "a" (str.substr z 15 1)))
(assert (or (= "t</strike" (str.substr z 41 9)) (not (str.prefixof "<xmp onbe" x)) (not (str.contains x "onmouseove"))))
(assert (not (= (str.at y 54) "a")))
(check-sat)
