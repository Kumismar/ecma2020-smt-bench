; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer id=x tabindex=1 onbeforeactivate=alert(1)></footer>") (= x "<tfoot onblur=alert(1) tabindex=1 id=x></tfoot><input autofocus>")))
(assert (or (= z "ASS=XSS&gt;&lt;/A&gt;") (= z "teditable>test</xmp>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9-+]+$")) (str.contains z "st</xm")))
(assert (or (= (str.at x 58) ">") (not (= "er>" (str.substr x 56 7))) (= "dex=1 id=x" (str.substr y 28 10))))
(assert (str.suffixof "cus>" x))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "\d{3}-\d{2}-\d{4}"))))
(assert (or (str.suffixof "est</xmp>" y) (not (= (str.at x 12) " "))))
(check-sat)
