; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option onbeforepaste=""alert(1)"" contenteditable>test</option>") (= x "<optgroup id=x tabindex=1 ondeactivate=alert(1)></optgroup><input id=y autofocus>")))
(assert (or (= z "dragstart=""alert(1)"">test</area>") (= z "ontenteditable>test</caption>") (= z "teditable>test</keygen>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<optio" x)))
(assert (or (not (= (str.indexof z """a" 0) 10)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?!0)(?!.*\.$)((1?\d?\d|25[0-5]|2[0-4]\d)(\.|$)){4}$"))) (= (str.indexof z "ca" 0) 21)))
(assert (or (str.suffixof "ion>" y) (not (= (str.indexof y "d=x" 0) 11)) (= "dragstart=""alert(1)"">test<""area>" (str.replace z "/" """"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^0([8|9|6])([0-9]{8}$)"))) (= (str.at x 2) "p") (not (str.contains x "paste"))))
(check-sat)
