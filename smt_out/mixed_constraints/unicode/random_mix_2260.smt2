; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html oncontextmenu=""alert(1)"">test</html>") (= x "<style>:target {transform: rotate(180deg);}</style><video id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></video>") (= x "<body onkeyup=""alert(1)"" contenteditable>test</body>")))
(assert (or (= z "test</nobr>") (= z "rameset onScroll frameset onScroll=""javascript:javascript:alert(1)""></frameset onScroll>") (= z "t(String.fromCharCode(88,83,83))>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "d=x" 0) 59)) (not (= "<alert(1)oncontextmenu=""alert(1)"">test</html>test</nobr>" (str.replace y "html " "alert(1)"))) (str.prefixof "<html onco" x)))
(assert (or (not (str.contains (str.replace z ")"" c" "alert(1)") "ert(1alert(1)ont")) (not (<= (str.len x) 133))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(([\d]{2} )|(2[abAB] ))*(([\d]{2})|(2[abAB]))$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^((8|\+7)[\- ]?)?(\(?\d{3}\)?[\- ]?)?[\d\- ]{5,12}$")) (str.prefixof "<b" x) (not (= (str.indexof y "<" 0) 0))))
(check-sat)
