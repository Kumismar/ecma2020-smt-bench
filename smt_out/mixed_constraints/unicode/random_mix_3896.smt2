; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdi draggable=""true"" ondragstart=""alert(1)"">test</bdi>") (= x "<IMG SRC=javascript:alert('XSS')>")))
(assert (or (= z "V=\""refresh\"" CONTENT=\""0;url=javascript:alert('XSS');\"">") (= z "alert(1)></title>") (= z "ert(1)"">test</base>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]{2,}@(?!gmail\.com)(?!yahoo\.com)(?!hotmail\.com)(?!mail\.ru)(?!g\.co)(?!yandex\.ru)(?!mail\.com)(?!iillii\.org)(?!sharklasers\.com)(?!guerillamail\.[a-zA-Z])(?!grr\.la)(?!guerillamailblock\.[a-zA-Z])(?!pokemail\.net)(?!spam4\.me)(?!networksfs\.com)(?!optimaweb\.me)(?!matra\.top)(?!wootap\.me)([a-zA-Z0-9]{1,}([.]{1}[a-zA-Z]{2,}|[.]{1}[a-zA-Z]{2,}[.]{1}[a-zA-Z]{2,}))"))))
(assert (not (= (str.at z 14) "l")))
(assert (not (str.contains x " SRC=javas")))
(assert (= (str.indexof x "rag" 0) 6))
(assert (or (= (str.at z 5) "(") (not (= (str.at y 3) "i"))))
(assert (str.suffixof "\"">" z))
(assert (or (= "gstart=""" (str.substr x 27 8)) (= "<IMG SRC=javascript:alert('XSS')>alert(1)> itle>" (str.replace y "</t" " "))))
(check-sat)
