; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<<script>document.vulnerable=true;</script>") (= x "<menuitem oncut=""alert(1)"" contenteditable>test</menuitem>") (= x "<hgroup draggable=""true"" ondragenter=""alert(1)"">test</hgroup>")))
(assert (or (= z "bindex=1 onfocus=alert(1)></col>") (= z "test</nobr>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len z) 13)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[A-Za-z]).{6,}")))))
(assert (= (str.len z) 11))
(assert (<= (str.len x) 65))
(assert (not (str.prefixof "<menuit" y)))
(assert (or (= (str.at x 33) "t") (not (= "<div draggable=""true"" contenteditable>drag me</div><isindex ondragoalert(1) contenteditable>drop here</isindex>cript>" (str.replace y "ver=" ""))) (not (str.suffixof ">" y))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[^\s@]+@([^\s@.,]+\.)+[^\s@.,]{2,}$")))
(check-sat)
