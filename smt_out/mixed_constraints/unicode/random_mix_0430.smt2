; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1f4a9}html ontouchmove=alert(1)>") (= x "<applet onmousemove=""alert(1)"">test</applet>") (= x "<rp draggable=""true"" ondrag=""alert(1)"">test</rp>")))
(assert (or (= z "t</dfn>") (= z "S');//") (= z "ument.vulnerable=true;};>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len y) 76)) (not (str.in_re z ((_ re.from_regex ecma2020 u) ".{7,50}"))) (str.in_re z ((_ re.from_regex ecma2020 u) "(?=^.{8,}$)(?=.*\d)(?=.*[!@#$%^&*]+)(?![.\u{a}])(?=.*[A-Z])(?=.*[a-z]).*$"))))
(assert (or (not (str.suffixof "strike>" z)) (not (str.contains y "ulnerab")) (= "pt>" (str.substr z 1 8))))
(assert (not (= "nd" (str.substr y 24 2))))
(assert (not (<= (str.len y) 53)))
(check-sat)
