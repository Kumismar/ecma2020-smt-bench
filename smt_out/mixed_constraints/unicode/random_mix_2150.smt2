; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<multicol id=x tabindex=1 ondeactivate=alert(1)></multicol><input id=y autofocus>") (= x "<bdo id=x tabindex=1 onfocus=alert(1)></bdo>") (= x "<tbody onkeydown=""alert(1)"" contenteditable>test</tbody>")))
(assert (or (= z " onclick=""alert(1)"">test</svg>") (= z "style><frameset id=x style=""transition:color 1s"" ontransitionend=alert(1)></frameset>") (= z "1)</script ?")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 70) "(")) (= "<bdo id=x tabindex=1 onfocus=alert(1)></bdo> ojavascript:ck=""alert(1)"">test</svg>" (str.replace y "ncli" "javascript:"))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\u{d6}\u{f6}\u{fc}\u{dc}\u{c4}\u{e4}\u{df}\s\-]*)$")))
(assert (or (not (str.contains x "x=1 o")) (not (str.suffixof "ofocus>" x))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z]{2,2}")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(\d{3}-?\d{3}-?\d{4}|XXX-XXX-XXXX)$")) (not (= "a" (str.substr z 14 1))) (str.contains (str.replace x "st" "<b>") "e<b></t")))
(assert (or (= (str.at z 25) "/") (= (str.at z 3) "/") (not (str.contains y "focus> on"))))
(assert (or (str.suffixof "ocus>" x) (not (str.contains (str.replace x " id=x" """") "<bdo"" t"))))
(check-sat)
