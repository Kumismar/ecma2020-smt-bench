; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track draggable=""true"" ondragleave=""alert(1)"">test<\u{1f600}/track>") (= x "<canvas draggable=""true"" ondragend=""alert(1)"">test</canvas>") (= x "<button draggable=""true"" ondragenter=""alert(1)"">test</button>")))
(assert (or (= z "st</li>") (= z "rt(1)"">test</ins>") (= z ")"">test</label>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z .-]{2,}"))) (not (str.contains y "es"))))
(assert (or (= "1" (str.substr x 43 1)) (not (= (str.indexof x "test" 0) 48)) (not (str.contains x "enter=""al"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{e9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{c9}'\s]+$"))))
(assert (or (str.prefixof "<canvas d" y) (str.suffixof "i>" y)))
(assert (or (= (str.at y 47) "t") (not (= "li>" (str.substr z 4 6))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z0-9._-]+@[a-z0._-]{2,}\.[a-z]{2,4}$"))))
(assert (or (= (str.at y 49) "v") (str.suffixof "</li>" y)))
(assert (or (= "<button  raggable=""true"" ondragenter=""alert(1)"">test</button>st</li>" (str.replace y "d" " ")) (= "nfocu" (str.substr x 22 5))))
(check-sat)
