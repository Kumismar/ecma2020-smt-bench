; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite ondblclick=""alert(1)"">t\u{1d400}est</cite>") (= x "<input onmouseleave=""alert(1)"">test</input>") (= x "<canvas onmouseover=""alert(1)"">test</canvas>")))
(assert (or (= z "ert(1)"">test</ul>") (= z "ivate=alert(1)></strong><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "></output>" x) (not (str.prefixof "<" x)) (not (= (str.indexof x """ale" 0) 20))))
(assert (str.contains z "</ul>"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([\w\.\-]+)@([\w\-]+)((\.(\w){2,6})+)$"))) (= (str.indexof z "rt(1" 0) 1) (not (str.prefixof "ivate" z))))
(assert (str.suffixof "t</canvas>" x))
(check-sat)
