; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp onmo\u{10348}useleave=""\u{10348}alert(1)"">test</samp>") (= x "<dd onmouseenter=""alert(1)"">test</dd\u{10348}>") (= x "<ruby id=x tabindex=1 onbeforeactivate=alert(1)></ruby>")))
(assert (or (= z "x onclick=alert(1)>click this!") (= z "d=x></sup><input autofocus>") (= z """alert(1)"">test</acronym>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof ">" x))
(assert (not (= "uby id=" (str.substr x 2 7))))
(assert (or (= (str.indexof y "iva" 0) 33) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9 ]+"))) (not (str.contains (str.replace y "lert" "<b>") """\u{10348}a<b>("))))
(assert (or (not (= "<html onpjavascript:=""alert(1)"" contenteditable>test</html>useup=""alert(1)"">test</noembed>" (str.replace y "aste" "javascript:"))) (= "\u{10348}" (str.substr y 36 1))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{1}[0-9]{7}[a-zA-Z]{1}$"))) (not (str.prefixof "<a" x)) (not (= (str.indexof x "/lab" 0) 37))))
(assert (str.contains (str.replace x "st</d" "") """>ted\u{10348}>"))
(check-sat)
