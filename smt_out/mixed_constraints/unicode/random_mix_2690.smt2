; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><option ondragover=alert(1) contenteditable>drop here</option>") (= x "<frame oncut=""alert(1)"" contenteditable>test</frame>") (= x "<element onblur=alert(1) tabindex=1 id=x></element><input autofocus>")))
(assert (or (= z "autofocus>") (= z "group>") (= z "end=""alert(1)"">test</colgroup>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "em" 0) 3) (= ":text/ht" (str.substr z 10 8))))
(assert (or (not (= "<div draggablx=""true"" contenteditable>drag me</div><option ondragover=alert(1) contenteditable>drop here</option>group>" (str.replace y "e" "x"))) (not (str.contains z "ler"))))
(assert (or (= (str.at z 2) "t") (not (str.contains (str.replace x "<h" " ") " eader"))))
(assert (or (not (str.contains y "tofocu")) (not (= (str.indexof y "ro" 0) 53))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9a-z._-]+@{1}[0-9a-z.-]{2,}[.]{1}[a-z]{2,5}$"))))
(assert (not (str.suffixof "olgroup>" z)))
(check-sat)
