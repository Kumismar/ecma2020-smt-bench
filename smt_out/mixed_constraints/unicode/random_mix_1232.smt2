; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IM\u{10348}G SRC=x onpause=""alert(Str\u{1f600}ing.fromCharCode(88,83,83))"">") (= x "<style>:target {color: red;}</style><pre id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></pre>")))
(assert (or (= z "('XSS');//") (= z """>test</nobr>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "efo" 0) 9) (str.contains x "rCode")))
(assert (not (= ">" (str.substr z 12 3))))
(assert (str.contains x "ion:c"))
(assert (= (str.indexof y "or: r" 0) 19))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*[.]([a-z]{2,3})$"))))
(assert (or (not (<= (str.len y) 76)) (not (= "test</nobr" (str.substr z 2 10)))))
(assert (or (str.prefixof "<styl" x) (= (str.len y) 123) (not (>= (str.len x) 41))))
(assert (or (str.contains y "(Str\u{1f600}ing") (= (str.at x 13) "n")))
(assert (= "G S" (str.substr x 4 3)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z._\-]+@[0-9a-zA-Z._\-]+$"))))
(check-sat)
