; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tt id=x tabindex=1 onfocusin=alert(1)></tt>") (= x "<form><input type=search onsearch=alert(1) value=""Hit return"" autofocus>") (= x "<dl id=x tabindex=1 onbeforeactivate=alert(1)></dl>")))
(assert (or (= z "/script>") (= z "1")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "abindex=1") (= "<style>@keyframes x{}</style><col style=""animation-nameonanimationend=""alert(1)""></col>ation-name:x"" on\u{1f600}animationstart=""alert(1)""></svg>" (str.replace y ":x"" " "")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^;<>=]{2,25}$")))))
(assert (or (str.contains z "t</summary") (<= (str.len z) 11)))
(assert (or (= "<dl id=x tabindex=1 onbeforea ate=alert(1)></dl>/script>" (str.replace y "ctiv" " ")) (str.prefixof "1" z)))
(assert (str.suffixof "ofocus>" x))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z \-\.]{1,34}$"))) (= " ta" (str.substr y 8 3)) (str.prefixof "<dl id=" y)))
(assert (or (not (str.suffixof "ipt>" z)) (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9_ -\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}]{3,60}$")) (not (str.contains z "/script>"))))
(assert (<= (str.len y) 133))
(check-sat)
