; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li oncopy=""alert(1)"" contenteditable>test</li>") (= x "&lt;IMG SRC=javascript&#058;alert('XSS')&gt;") (= x "<figcaption onmouseout=""alert(1)"">test</figcaption>")))
(assert (or (= z "eout=""alert(1)"">test</command>") (= z "us=alert(1)></u>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len y) 77)))
(assert (or (= (str.indexof x "c" 0) 6) (= "able=""t" (str.substr x 10 7)) (= "<fr""et onkeyup=""alert(1)"" contenteditable>test</frameset>" (str.replace x "ames" """"))))
(assert (or (not (= """alert" (str.substr x 23 6))) (not (str.contains y "alert(")) (not (= "<b>t;IMG SRC=javascript&#058;alert('XSS')&gt;eout=""alert(1)"">test</command>" (str.replace y "&l" "<b>")))))
(assert (or (str.contains (str.replace y "(" "") "ert'XSS'") (not (str.prefixof "us=alert(1" z)) (= "out" (str.substr z 1 3))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(([0-8][0-9])|(9[0-5]))[0-9]{3}$"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{c0}-\u{ff} .'\u{b4}`-]+$")) (not (= (str.indexof y "58;" 0) 25))))
(assert (or (not (>= (str.len z) 20)) (str.suffixof "(1)></u>" y)))
(check-sat)
