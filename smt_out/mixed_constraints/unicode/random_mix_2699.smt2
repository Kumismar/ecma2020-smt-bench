; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address id=x tabindex=1 onbeforede\u{1f600}activate=alert(1)></address><input autofocu\u{10348}s>") (= x "<svg><legend onload=alert(1)></legend>")))
(assert (or (= z "javascript:document.location=&apos;http://www.google.com/&apos;&quot;&gt;XSS&lt;/A&gt;") (= z "ut=""javascript:javascript:alert(1)""></html onMouseOut>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "000" z)) (not (str.suffixof "cu\u{10348}s>" x))))
(assert (or (not (= (str.at x 1) "#")) (not (= (str.at x 18) "d"))))
(assert (not (= (str.indexof x "acti" 0) 36)))
(assert (or (str.suffixof "A&gt;" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) ".+@.+\..{2,}")))))
(assert (or (str.prefixof "<a o" x) (not (str.suffixof "))"">" y))))
(assert (not (str.prefixof "<" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$"))))
(check-sat)
