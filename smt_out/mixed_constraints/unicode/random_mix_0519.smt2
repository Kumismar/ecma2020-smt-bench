; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure draggable=""true"" ondragstart=""alert(1)"">test</figure>") (= x "<figcaption draggable=""true"" ondragleave=""alert(1)"">test</figcaption>") (= x "<q id=x tabindex=1 onactivate=alert(1)></q>")))
(assert (or (= z "</track>") (= z "dir><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 3) "i") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.{8,}$"))) (str.prefixof "<q id=x t" x)))
(assert (or (not (str.contains z "</track")) (= "lert(1" (str.substr x 31 6)) (not (= (str.indexof x "ble" 0) 18))))
(assert (or (str.suffixof "figure>" x) (not (= (str.indexof x "ave=""" 0) 37)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[6-9]\d{9}$")))))
(assert (= (str.indexof z "trac" 0) 2))
(assert (not (= "</talert(1)" (str.replace z "rack>" "alert(1)"))))
(check-sat)
