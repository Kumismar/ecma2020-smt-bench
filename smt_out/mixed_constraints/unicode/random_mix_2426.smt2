; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp onbeforecut=""alert(1)"" contenteditable>test</samp>") (= x "<pre id=x tabindex=1 ondeactivate=alert(1)></pre><input id=y autofocus>") (= x "<dir oncut=""alert(1)"" contenteditable>test</dir>")))
(assert (or (= z "t type=checkbox id=x onfocusin=alert(1)>") (= z "e=""true"" ondrag=""alert(1)"">test</cite>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 19) ")")))
(assert (not (= "t type=chex id=x onfocusin=alert(1)>" (str.replace z "ckbo" ""))))
(assert (or (<= (str.len y) 115) (>= (str.len y) 82) (not (= "t(1)" (str.substr y 16 4)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-9]\d*$"))) (not (str.prefixof "<samp o" y)) (not (= (str.indexof y "st</" 0) 40))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\+?[\d\/\s\-]{8,20}$"))))
(assert (not (str.prefixof "<dir onc" y)))
(assert (not (= (str.at z 18) "=")))
(check-sat)
