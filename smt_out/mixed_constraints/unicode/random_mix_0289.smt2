; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onbeforecut=""alert(1)"" contenteditable>test</dfn>") (= x "<td draggable=""true"" ondragleave=""alert(1)"">test</td>")))
(assert (or (= z ">") (= z "ert(1)"">test</meter>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 11) "8") (<= (str.len z) 21) (not (str.contains (str.replace x "ut=""" "<b>") "c<b>a"))))
(assert (or (str.suffixof ">" z) (not (= (str.at z 4) "1"))))
(assert (str.contains y ">ert"))
(assert (or (str.suffixof "t</meter>" z) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\s\-+()]+$")))))
(assert (not (= "&# 0060" (str.replace x "000" " "))))
(check-sat)
