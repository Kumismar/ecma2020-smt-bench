; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture onbeforecut=""alert(1)"" contenteditable>test</picture>") (= x "<bdi onkeydown=""alert(1)"" contenteditable>test</bdi>") (= x "<mar\u{10348}k oncli\u{10348}ck=""alert(1)"">test</mark>")))
(assert (or (= z " rotate(180deg);}</style><nobr id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></nobr>") (= z "oframes>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<mar\u{10348}" y))
(assert (or (not (= "lert(1" (str.substr x 17 6))) (= (str.indexof y "es" 0) 49)))
(assert (or (= "nobr" (str.substr y 64 4)) (not (= (str.len x) 38))))
(assert (or (str.prefixof "<bdi " x) (str.suffixof "</nobr>" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,12}$")))))
(check-sat)
