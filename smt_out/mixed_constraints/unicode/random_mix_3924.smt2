; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead id=x tabindex=1 onfocus=\u{1f600}alert(1)></thead>") (= x "<rt onblur=alert(1) tabindex=1 id=x></rt><input autofocus>") (= x "<menuitem onkeypress=""alert(1)"" contenteditable>test</menuitem>")))
(assert (or (= z "frames onmouseout=""alert(1)"">te\u{1d400}st</noframes>") (= z "nmouseleave=""alert(1)"">test</footer>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "/thead>" x))
(assert (str.prefixof "<the" x))
(assert (or (not (= ">" (str.substr z 5 10))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(13[0-9]|14[0-9]|15[0-9]|17[0-9]|18[0-9]|19[0-9])\d{8}$")))))
(assert (or (not (= "t" (str.substr y 6 1))) (not (str.contains (str.replace x "m " "x") "nuitexonkey"))))
(assert (or (= "e=""aler" (str.substr z 10 7)) (not (<= (str.len x) 58))))
(check-sat)
