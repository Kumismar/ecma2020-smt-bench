; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup onkeyup=""alert(1)"" contenteditable>test</optgroup>") (= x "ABC<div st\u{1f4a9}yle=""x:\xE2\x80\x81expression(javascri\u{1f600}pt:alert(1)"">DEF")))
(assert (or (= z "ruby draggable=""true"" ondragleave=""alert(1)"">test</ruby>") (= z "cus>")))
(assert (= y (str.++ x z)))
(assert (or (= "s>" (str.substr z 2 7)) (not (str.contains (str.replace y "st</" "javascript:") "ejavascript:optgr"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) ".{1,}"))) (not (str.contains z "ragleav")) (= (str.at y 0) "A")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[_a-zA-Z0-9-]+(\.[_a-zA-Z0-9-]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*(\.[a-zA-Z]{2,6})$"))) (not (= (str.len x) 60)) (not (<= (str.len x) 74))))
(assert (or (str.contains z "(1)"">tes") (str.prefixof "AB" x)))
(check-sat)
