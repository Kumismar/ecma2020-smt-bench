; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "%253cscript%253ealert(document.cookie)%253c/script%253e") (= x "<head id=x tabindex=1 onfocusin=alert(1)></head>") (= x "<mark id=x tabindex=1 onfocusin=alert(1)></mark>")))
(assert (or (= z "xtmenu=""alert(1)"">test</span>") (= z """alert(document.domain)""/>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "%253cscr" x)) (= (str.indexof z "cume" 0) 9)))
(assert (or (= "t(" (str.substr x 36 2)) (not (= "%253cscript%253ealert(docalert(1)ent.cookie)%253c/script%253e" (str.replace x "um" "alert(1)"))) (str.prefixof "%253c" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{8,10}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((\\+91-?)|0)?[0-9]{10}$"))) (= (str.len z) 26)))
(assert (or (not (= (str.indexof x "rt" 0) 35)) (not (= (str.at x 16) "r")) (str.suffixof "/>" z)))
(check-sat)
