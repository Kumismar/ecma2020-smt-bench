; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav id=x tabindex=1 onfocusin=alert(1)></nav>") (= x "<style>:target {color:red;}</style><details id=x style=""transition:color 1s"" ontransitionend=alert(1)></details>")))
(assert (or (= z "ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;") (= z "</rp>")))
(assert (= y (str.++ x z)))
(assert (or (= "< put type=""text"" value=``<div/onmouseover='alert(1)'>X</div>" (str.replace x "in" " ")) (= (str.indexof y "=" 0) 46) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(([^<>()\[\]\.,;:\s@""]+(\.[^<>()\[\]\.,;:\s@""]+)*)|("".+""))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$")))))
(assert (str.contains y "</nav"))
(assert (or (= ">" (str.substr x 45 8)) (not (= "<abbr onmouseenter=""alert(1)"">x/abbr>" (str.replace x "test<" "x")))))
(assert (or (not (str.suffixof "/details>" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^#[a-fA-F0-9]{6}|#[a-fA-F0-9]{3}|rgb *\( *[0-9]{1,3}%? *, *[0-9]{1,3}%? *, *[0-9]{1,3}%? *\)|rgba *\( *[0-9]{1,3}%? *, *[0-9]{1,3}%? *, *[0-9]{1,3}%? *, *[0-9]{1,3}%? *\)|black|green|silver|gray|olive|white|yellow|maroon|navy|red|blue|purple|teal|fuchsia|aqua|url\(#[^\)]+\)$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[6|7][0-9]{8}")))))
(assert (or (not (= "//g" (str.substr x 22 3))) (not (str.contains z "&gt")) (not (= "<javascript:" (str.replace z "/rp>" "javascript:")))))
(check-sat)
