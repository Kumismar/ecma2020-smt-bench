; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title draggable=""true"" ondragend=""alert(1)"">test</title>") (= x "<samp onclick=""alert(1)"">test</samp>") (= x "<style>:target {transform: rotate(180deg);}</style><xmp id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></xmp>")))
(assert (or (= z "ave=""alert(1)"">test</figure>") (= z "le><td style=""animation-name:x"" onanimationstart=""alert(1)""></td>")))
(assert (= y (str.++ x z)))
(assert (str.contains y " sty"))
(assert (or (= "<div draggle=""true"" contenteditable>drag me</div><form ondrop=alert(1) contenteditable>drop here</form>t:alert(""A"")>" (str.replace y "ab" "")) (str.prefixof "<style>:" y)))
(assert (not (str.suffixof "</figure>" y)))
(assert (or (not (str.contains (str.replace x "e"" " "alert(1)") "rualert(1)on")) (= (str.at z 22) "i") (not (= (str.indexof y "le d" 0) 4))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(?!00)[0-1][0-9]")) (not (= " a" (str.substr x 59 2))) (not (str.suffixof "figure>" y))))
(assert (or (not (= (str.at x 11) "c")) (not (str.suffixof "ure>" z))))
(check-sat)
