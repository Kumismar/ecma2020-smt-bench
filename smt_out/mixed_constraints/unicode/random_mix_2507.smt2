(assert (or (= (str.at y 16) "/") (str.prefixof "g'""></IFRA" x)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*[^\s@]+@[^\s@]+\.[^\s@]+\s*$")) (str.in_re z ((_ re.from_regex ecma2020 u) ".{9,13}"))))
