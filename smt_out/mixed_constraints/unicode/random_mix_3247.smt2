; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><shadow ondrop=alert(1) contenteditable>drop here</shadow>") (= x "<track onmousemove=""alert(1)"">test</track>") (= x "<video onmouseenter=""alert\u{1f600}(1)"">test</video>")))
(assert (or (= z "ton>") (= z "/dialog>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "tr" "javascript:") "<javascript:ack ")) (= (str.at x 46) "/") (str.suffixof "k>/dialog>" y)))
(assert (= "<;HTML <b>s:xss>;" (str.replace x "xmln" "<b>")))
(assert (str.contains (str.replace y "er" "x") "onxr"))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9-_\.]{6,}$")) (= (str.indexof y "<vide" 0) 0) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\(([0-9\s]){3}\)\s??([0-9\s]){9}$")))))
(check-sat)
