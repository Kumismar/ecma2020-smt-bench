; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1d400}abbr onbeforecopy=""alert(1)"" contenteditable>test</abbr>") (= x "<rtc onclick=""alert(1)"">test</rtc>")))
(assert (or (= z "rt(1)"" contenteditable>test</rb>") (= z "rt(1)></th>") (= z "<samp id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></samp>")))
(assert (= y (str.++ x z)))
(assert (or (= "oreco" (str.substr x 12 5)) (not (str.contains x "(1)"">tes")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{2}[0-9]{4,5}[0-9]{4}$")))))
(assert (or (not (= "rtc>rt(1)" (str.substr y 30 9))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([A-z0-9._%+-]+@[A-z0-9.-]+\.[A-z]{2,6})|([0-9-\s]{10,})$"))) (str.prefixof "<rtc " x)))
(assert (str.suffixof "samp>" z))
(assert (or (not (= (str.at y 9) "i")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[+][7] [(][\d]{3}[)] \d{3}-\d{2}-\d{2}\d{0,1}$")))))
(assert (or (str.prefixof "<\u{1d400}abbr " x) (str.prefixof "rt(1)" z)))
(check-sat)
