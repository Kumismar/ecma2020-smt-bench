; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x0Fjavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<wbr onbeforecut=""alert(1)"" contenteditable>test</wbr>") (= x "<div draggable=""true"" contenteditable>drag me</div><datalist ondragover=alert(1) contenteditable>drop here</datalist>")))
(assert (or (= z "rt(1)>") (= z "out=alert(1) tabindex=1 id=x></plaintext><input autofocus>") (= z "(1)"">test</pre>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 8) """") (not (= (str.at y 34) ":"))))
(assert (or (not (str.contains z "pre")) (str.prefixof "<" x) (str.contains x "conte")))
(assert (= (str.at x 50) "/"))
(assert (or (= (str.len z) 6) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z]{3}$"))) (str.contains x "e>test</wb")))
(assert (or (not (= (str.indexof x "</dl" 0) 32)) (not (str.suffixof "ofocus>" y))))
(assert (or (not (= (str.indexof y "ipt:" 0) 44)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(0[1-9]|1[012])[\/](0[1-9]|(1|2)[0-9]|3[01])[\/](19|20)\d\d$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$"))))
(check-sat)
