(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<lab" x) (str.suffixof ";>\u{1f4a9}X</a>" z)))
(assert (str.contains y "ble=""t"))
(assert (or (str.contains z "r=&N") (= "t</wbr" (str.substr x 48 6))))
