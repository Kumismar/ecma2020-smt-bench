; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source onmousemove=""alert(1)"">test</source>") (= x "<bdi onmouseenter=""alert(1)"">test</bdi>") (= x "<svg><del onload=alert(1)></del>")))
(assert (or (= z "(';XSS';);"";>;") (= z "test</html>") (= z "ascript:alert(1)</script\x0A")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y ";"";" """") "SS';)"">;") (not (str.contains x "rce>")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(0|[1-9][0-9]*)$")))))
(assert (or (str.suffixof "l>" z) (= (str.len x) 44) (= (str.indexof y "E><" 0) 79)))
(assert (or (= "mo" (str.substr x 15 2)) (not (= "d""" (str.replace z ">" """"))) (not (= (str.at z 5) "S"))))
(assert (or (str.suffixof "rce>" x) (>= (str.len x) 36)))
(assert (= "txt</html>" (str.replace z "es" "x")))
(check-sat)
