; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image onbeforecut=""alert(1)"" contenteditable>test</image>") (= x "<li id=x tabindex=1 ondeactivate=alert(1)></li><input id=y autofocus>") (= x "<fieldset onmouseup=""alert(1)"">test</fieldset>")))
(assert (or (= z "frames onkeyup=""alert(1)"" contenteditable>test</noframes>") (= z "rue"" ondrag=""alert(1)"">test</isindex>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len x) 36))
(assert (or (= "onbeforec" (str.substr x 7 9)) (str.suffixof "isindex>" z) (not (>= (str.len x) 38))))
(assert (or (not (str.prefixof "<imag" x)) (= "<image onbeforecut=""alert(1)"" contenteditab st</image>" (str.replace x "le>te" " "))))
(assert (not (= ")""" (str.substr z 20 2))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.+(com|org)")) (= (str.at z 7) "o")))
(assert (or (= (str.len y) 115) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{14}$"))) (not (str.contains z "onkeyu"))))
(check-sat)
