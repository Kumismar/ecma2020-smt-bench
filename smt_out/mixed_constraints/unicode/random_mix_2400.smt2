; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<small id=x tabindex=1 onbeforedeactivate=alert(1)></small><input autofocus>") (= x "<svg><nextid onload=alert(1)></nextid>")))
(assert (or (= z "ert(1)>") (= z "/nav>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len y) 36))
(assert (or (str.suffixof "/nav>" z) (= (str.at y 2) "v")))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[_A-Za-z0-9-]+(\.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*(\.[A-Za-z0-9]{2,4})$")))
(assert (or (= (str.at x 36) "d") (not (= (str.len x) 38)) (not (str.contains z "ert(1)"" "))))
(assert (str.contains z "av>"))
(assert (or (not (str.prefixof "<small id=" y)) (str.suffixof "ert(1)>" y) (= (str.at y 39) "a")))
(assert (or (<= (str.len z) 8) (= "<small id=x tabindex=1 xbeforedeactivate=alert(1)></small><input autofocus>" (str.replace x "on" "x"))))
(assert (not (str.suffixof "(1)>" z)))
(check-sat)
