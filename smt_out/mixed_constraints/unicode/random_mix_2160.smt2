; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><tbody ondrop=alert(1) contenteditable>drop here</tbody>") (= x "&lt;TABLE BACKGROUND=&quot;javascript:alert(&apos;XSS&apos;)&quot;&gt;&lt;/TABLE&gt;")))
(assert (or (= z ">test</abbr>") (= z "1)></tfoot>")))
(assert (= y (str.++ x z)))
(assert (not (= "1)></<b>ot>" (str.replace z "tfo" "<b>"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._+-]+@[a-z0-9.-]+\.[a-z]{2,}$")) (not (str.contains x "&lt;TAB")) (str.suffixof ">" z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9]){4,12}$")) (str.prefixof "<tit" x) (str.in_re x ((_ re.from_regex ecma2020 u) "^[1][3,4,5,6,7,8,9][0-9]{9}$"))))
(assert (not (str.prefixof "&lt;TABLE " y)))
(check-sat)
