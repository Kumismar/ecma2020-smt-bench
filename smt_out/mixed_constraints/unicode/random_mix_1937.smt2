; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><option style=""animation-name:x"" onanimationstart=""alert(1)""></option>") (= x "<dfn oncopy=""\u{1f4a9}alert(1)"" co\u{20000}ntenteditable>test</dfn>") (= x "<iframe onpaste=""alert(1)"" contenteditable>test</iframe>")))
(assert (or (= z "ipt:alert('XSS'))"">") (= z "alert(1)"">test</frameset>") (= z "eforedeactivate=alert(1)></em><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/dfn>" x)) (not (= (str.at z 18) ">"))))
(assert (not (str.suffixof "/script>" x)))
(assert (or (not (= "/sty" (str.substr x 22 4))) (not (= (str.indexof y "ipt:" 0) 99)) (not (= (str.indexof x ")" 0) 21))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{1,1}[a-zA-Z0-9_]{2,13}[a-zA-Z0-9]{1,1}$"))) (not (str.contains z "tofocus")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9]{6,}")))))
(assert (= (str.at x 45) "s"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[7-9][0-9]{9}$"))) (not (= "<table ncopy=""alert(1)"" contenteditable>test</table>" (str.replace x "o" "")))))
(check-sat)
