; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript onblur=alert(1) tabindex=1 id=x></noscript><input autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><hr ondragover=alert(1) contenteditable>drop here</hr>")))
(assert (or (= z "&quot;)>") (= z "start=""alert(1)""></em>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "\u{1d400}raggable"))
(assert (or (= "o" (str.substr y 93 1)) (not (str.contains (str.replace x "nb" "x") "pt oxlur")) (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{8,14}"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) ".*[\S].*")) (str.suffixof "t""](1)" z)))
(assert (or (str.contains y "div><") (= (str.indexof z "/ul>" 0) 1)))
(assert (or (str.contains (str.replace x "r=a" """") "onblu""le") (str.in_re x ((_ re.from_regex ecma2020 u) "^([A-Z0-9]{5}-){6}[A-Z0-9]{5}$"))))
(check-sat)
