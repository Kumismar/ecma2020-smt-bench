; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<slot onbeforecopy=""alert(1)"" contenteditable>test</slot>") (= x "<menuitem id=x tabindex=1 onfocus=alert(1)></menuitem>") (= x "<listing onmouseleave=""alert(1)"">test</listing>")))
(assert (or (= z "ansitionrun=alert(1)></center>") (= z "</canvas>")))
(assert (= y (str.++ x z)))
(assert (not (= "<menuitem id=x tabindex=1 onfocus=alert(1)></menuitem></canalert(1)" (str.replace y "vas>" "alert(1)"))))
(assert (or (= (str.indexof x "orec" 0) 11) (not (= "</center" (str.substr z 21 8))) (not (= (str.at z 26) "t"))))
(assert (not (str.contains x """>tes")))
(assert (or (= (str.indexof z "nvas>" 0) 4) (<= (str.len z) 38) (str.suffixof "/slot>" x)))
(assert (or (not (= (str.at z 3) "a")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[-a-z0-9!#$%&'*+\/=?^_`{|}~]+(\.[-a-z0-9!#$%&'*+\/=?^_`{|}~]+)*@(([a-z0-9]([-a-z0-9]*[a-z0-9]+)?){1,63}\.)+([a-z0-9]([-a-z0-9]*[a-z0-9]+)?){2,63}$")))))
(check-sat)
