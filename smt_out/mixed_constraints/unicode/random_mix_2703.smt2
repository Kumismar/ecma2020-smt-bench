; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><tr id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tr>") (= x "<sup draggable=""true"" ondragenter=""alert(1)"">test</sup>")))
(assert (or (= z "rt(1)"">test</spacer>") (= z "st</listing>") (= z "=1 onbeforeactivate=alert(1)></mark>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<su" y))
(assert (or (= (str.indexof y "ent" 0) 28) (= ">" (str.substr z 26 3))))
(assert (not (str.prefixof "=1 o" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*\d).{11,}$"))) (not (= (str.indexof z "te" 0) 7)) (not (= (str.at z 34) "k"))))
(assert (not (= (str.indexof x "al" 0) 35)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{4,10}"))) (str.contains z "st</listi")))
(assert (= "ansform:" (str.substr y 18 8)))
(assert (or (not (str.suffixof "ng>" y)) (= "e=ale" (str.substr z 18 5)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+\/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+){1,}$")))))
(check-sat)
