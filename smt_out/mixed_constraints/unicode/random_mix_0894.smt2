; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li id=x tabindex=1 onbeforeactivate=alert(1)></li>") (= x "<time id=x tabindex=1 onbeforedeactivate=alert(1)></time><input autofocus>") (= x "<div onmouseover=""alert(1)"">test</div>")))
(assert (or (= z "test</dfn>") (= z "e>drop here</title>") (= z "gt;&#46;XSS{background-image&#58;url(\""javascript&#058;alert('XSS')\"");}&lt;/STYLE&gt;&lt;A CLASS=XSS&gt;&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (= "ctivate=al" (str.substr x 29 10))) (not (str.contains x "</ti"))))
(assert (not (str.contains y " autofocu")))
(assert (or (str.suffixof "lt;/A&gt;" y) (>= (str.len y) 56) (not (str.contains x "aut"))))
(assert (or (not (= "e>te" (str.substr z 34 4))) (= "(1)>" (str.substr y 46 4))))
(assert (or (not (= "gt;&#46;XSS{back<b>d-image&#58;url(\""javascript&#058;alert('XSS')\"");}&lt;/STYLE&gt;&lt;A CLASS=XSS&gt;&lt;/A&gt;" (str.replace z "groun" "<b>"))) (not (= (str.len y) 70))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "(https?:\/\/(?:www\.|(?!www))[a-zA-Z0-9][a-zA-Z0-9-]+[a-zA-Z0-9]\.[^\s]{2,}|www\.[a-zA-Z0-9][a-zA-Z0-9-]+[a-zA-Z0-9]\.[^\s]{2,}|https?:\/\/(?:www\.|(?!www))[a-zA-Z0-9]+\.[^\s]{2,}|www\.[a-zA-Z0-9]+\.[^\s]{2,})")) (not (= (str.len y) 57))))
(assert (= "<var id=x t\u{1f4a9}abindex=1 onbefo""deactivate=alert(\u{1f4a9}1)></var><input autofocus>1)""></figcaption>" (str.replace y "re" """")))
(check-sat)
