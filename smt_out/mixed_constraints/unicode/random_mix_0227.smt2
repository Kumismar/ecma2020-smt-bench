(assert (or (= x "<template onkeypress=""al\u{10348}ert(1)"" contenteditable>test</template>") (= x "<optgroup draggable=""true"" ondragleave=""alert(1)"">test</optgroup>") (= x "<style>:target {transform: rotate(180deg);}</style><dir id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dir>")))
