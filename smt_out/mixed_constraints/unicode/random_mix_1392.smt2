; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "'';!--\""&lt;XSS&gt;=&{()}") (= x "<listing onmouseup=""alert(1)"">test</listing>") (= x "<shadow draggable=""true"" ondragleave=""alert(1)"">test</shadow>")))
(assert (or (= z ">") (= z "ste=""alert(1)"" contenteditable>test</label>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "<shado")) (not (<= (str.len x) 48))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9a-zA-Z]+[-._+&])*[0-9a-zA-Z]+@([-0-9a-zA-Z]+[.])+[a-zA-Z]{2,6}$"))) (not (str.prefixof "'';!-" x))))
(assert (or (not (= (str.indexof x "lert(" 0) 39)) (not (str.suffixof ")></h1>" y)) (not (str.prefixof ">" z))))
(assert (>= (str.len x) 39))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(([\w\.\-]+)@([\w_\-]+)\.([\w_\.\-]*)[a-z][a-z])?$"))) (str.prefixof "'';!-" y)))
(assert (or (not (= (str.indexof x " " 0) 7)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[^@]+@(?!(gmail|yahoo|hotmail|aol|live|msn))[^@]+\.[a-z]{2,}$")))))
(check-sat)
