; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video autoplay controls onseeking=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= x "<A href=javas%26#9\u{1d400}9;ript:alert(1)>click")))
(assert (or (= z "d=x tabindex=1 onbeforedeactivate=alert(1)></body><input autofocus>") (= z ">drag me</div><script ondrop=alert(1) contenteditable>drop here</script>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<A hre" x))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(\d{5}(?:-\d{4})?)$")) (not (= "(1" (str.substr y 137 2)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{1}"))) (not (= (str.at x 79) "v")) (= "ea" (str.substr z 30 2))))
(assert (= (str.indexof y "dro" 0) 64))
(assert (not (str.suffixof "t>" z)))
(assert (or (= (str.at z 13) "1") (not (= (str.at x 21) "r"))))
(check-sat)
