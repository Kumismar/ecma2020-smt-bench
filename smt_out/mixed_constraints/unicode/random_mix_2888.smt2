; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><ol style=""animation-name:x"" onanimationend=""alert(1)""></ol>") (= x "<shadow id=x \u{1f600}tabindex=1 onbeforeactivate=alert(1)></shado\u{20000}w>")))
(assert (or (= z ">"">"">""*""") (= z ")"">test</code>") (= z "e>:target {color:red;}</style><dfn id=x style=""transition:color 1s"" ontransitionend=alert(1)></dfn>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-Z\u{104}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b}a-z\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}]+[,.]?[ ]?|[A-Z\u{104}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b}a-z\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}]+['-]?)+")) (not (str.suffixof ">" x)) (not (str.suffixof "(1)>'" y))))
(assert (or (not (= "<shadow id=x \u{1f600}tabindex=1 onbeforeactivate=alert(1)></sha""w>>"">"">""*""" (str.replace y "do\u{20000}" """"))) (str.prefixof "<sty" y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[-+ ()0-9]+")))))
(assert (or (not (= (str.indexof z "t<" 0) 6)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(8|\+7[\- ]?)(\(?[1-9]{1}\d{2,3}\)?[\- ]?)[\d]{1,3}[\- ]?[\d]{2}[\- ]?[\d]{2}$")))))
(assert (not (str.contains y "rt(1)""></")))
(check-sat)
