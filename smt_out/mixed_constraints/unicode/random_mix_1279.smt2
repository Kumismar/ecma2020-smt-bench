; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><spacer id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></spacer>") (= x "<embed draggable=""true"" ondragend=""alert(1)"">test</embed>") (= x "<big ondblclick=""alert(1)"">test</big>")))
(assert (or (= z " id=y autofocus>") (= z "nu>")))
(assert (= y (str.++ x z)))
(assert (= "{color: " (str.substr y 15 8)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._%+]{1}[a-zA-Z0-9._%+-]*@([a-zA-Z0-9-]{2,63}\.)+[a-zA-Z]{2,7}$"))))
(assert (not (= "<style>:target {color: red;}</style><spacer idalert(1)yle=""transition:color 10s"" ontransitioncancel=alert(1)></spacer>nu>" (str.replace y "=x st" "alert(1)"))))
(assert (or (= "ndblcl" (str.substr y 6 6)) (not (str.contains (str.replace z " id=" "alert(1)") "alert(1)y aut")) (= "able>test</optgalert(1)oup>" (str.replace z "r" "alert(1)"))))
(assert (or (not (str.prefixof "<" y)) (<= (str.len x) 71) (not (= "ed;" (str.substr x 24 3)))))
(check-sat)
