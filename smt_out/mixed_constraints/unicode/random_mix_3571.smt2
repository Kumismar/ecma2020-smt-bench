; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li onmouseout=""alert(1)"">test</li>") (= x "<IMG SRC=""jav&#x0D;ascript:alert(<WBR>'XSS');"">")))
(assert (or (= z "3))"">") (= z "1) type=image/gif>") (= z "x=1 onactivate=alert(1)></rtc>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=(.{1,64}@.{1,255}))([!#$%&'*+\-\/=?\^_`{|}~a-zA-Z0-9}]{1,64}(\.[!#$%&'*+\-\/=?\^_`{|}~a-zA-Z0-9]{0,}){0,})@((\[(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}\])|([a-zA-Z0-9-]{1,63}(\.[a-zA-Z0-9-]{2,63}){1,}))$"))) (not (str.prefixof "3)" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((19|20)\d{2}|\d{2})$")))))
(assert (str.suffixof "ed>" z))
(assert (or (= (str.at x 28) "s") (= (str.indexof x """>te" 0) 24)))
(assert (not (= "1) type=xe/gif>" (str.replace z "imag" "x"))))
(assert (str.contains (str.replace y "SRC" "x") "MG x=""jav"))
(assert (str.prefixof "<IMG SRC" y))
(assert (or (not (= (str.len x) 35)) (not (>= (str.len y) 59))))
(assert (= (str.indexof y "ript:" 0) 22))
(check-sat)
