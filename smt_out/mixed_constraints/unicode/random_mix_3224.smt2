; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<wbr id=x tabindex=1 onactivate=alert(1)></wbr>") (= x "<style>:target {transform: rotate(180deg);}</style><th id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></th>") (= x "<keygen onblur=alert(1) tabindex=1 id=x></keygen><input autofocus>")))
(assert (or (= z "yle><td id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></td>") (= z "ation-name:x"" onanimationstart=""alert(1)""></aside>") (= z "&<&A9&11/script&X&>")))
(assert (= y (str.++ x z)))
(assert (not (= "p" (str.substr z 13 1))))
(assert (not (= (str.at z 16) "X")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9]{5}|\s*)$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$"))))
(assert (or (not (= (str.indexof y "t" 0) 2)) (= "<style>:target {transform: rotate(180deg);}</style><th xd=x style=""transition:transform 2s"" ontransitionrun=alert(1)></th>" (str.replace x "i" "x"))))
(assert (not (str.prefixof "<s" x)))
(assert (or (not (str.contains x "nrun=al")) (not (= (str.indexof y "</sp" 0) 50))))
(assert (or (not (= (str.at x 21) "o")) (str.suffixof ">" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{8,10}")))))
(check-sat)
