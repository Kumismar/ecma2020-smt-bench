; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong oncut=""alert(1)"" contenteditable>test</strong>") (= x "<keygen oncontextmenu=""alert(1)"">test</keygen>")))
(assert (or (= z "</script>") (= z "ed;}</style><dt id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></dt>") (= z "test</ol>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace y "onc" "javascript:") "n javascript:ontex"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z0-9]{2,120}"))) (= (str.at z 1) "d") (not (>= (str.len x) 106))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z A-Z 0-9 \u{df}]$"))))
(assert (not (= "ODY{background:url(&quot;javascript:alert(&apos;XSS&a&quot;)}&lt;/STYLE&gt;" (str.replace z "pos;)" ""))))
(assert (str.suffixof "gen>" x))
(assert (or (not (str.suffixof "m>" x)) (= """" (str.substr y 22 1))))
(assert (= (str.indexof z "s" 0) 10))
(check-sat)
