; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del onmouseenter=""alert(1)"">test</del>") (= x "<div id=""98""><div id=d><div style=""font-family:'sans\27\2F\2A\22\2A\2F\3B color\3Ared\3B'"">X</div></div>")))
(assert (or (= z "ditable>drop here</link>") (= z "=""alert(1)"">test</progress>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[-\w.]+@([A-z0-9][-A-z0-9]+\.)+[A-z]{2,4}$"))) (not (= "/div><" (str.substr x 93 6)))))
(assert (or (not (= "<div id=""98""><div id=d><div alert(1)yle=""font-family:'sans\27\2F\2A\22\2A\2F\3B color\3Ared\3B'"">X</div></div>=""alert(1)"">test</progress>" (str.replace y "st" "alert(1)"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z]{1,}[A-Za-z0-9@#%&* ]*$"))))
(assert (or (not (str.prefixof "=" z)) (not (str.prefixof "<d" y)) (= (str.at x 22) "r")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.*[a-zA-Z0-9]{3}.*$"))))
(check-sat)
