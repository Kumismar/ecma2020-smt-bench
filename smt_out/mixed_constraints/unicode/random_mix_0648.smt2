; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><wbr id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></wbr>") (= x "<style>@keyframes x{}</style><em style=""animation-name:x"" onanimationstart=""alert(1)""></em>") (= x "<noframes onmousedown=""alert(1)"">test</noframes>")))
(assert (or (= z " '=""foo""><x foo='><img src=x onerror=alert(62)//'>") (= z "ondragstart=""alert(1)"">test</sup>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z """><x") (not (str.contains (str.replace z """>" "") "oo<x f"))))
(assert (or (not (str.suffixof "st</sup>" z)) (str.suffixof "'>" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{1,2}\.[0-1]{0,1}[0-9]{0,1}\.[0-9]{4}$")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-z0-9 ]){2,}$"))) (= "<style>@keyframes x{}</style><em style=""animation-name:x"" onanimationstart=""alert(1)""></""" (str.replace x "em>" """")) (not (str.suffixof "(1)></wbr>" x))))
(assert (or (not (str.contains z "62)//'>")) (str.in_re z ((_ re.from_regex ecma2020 u) "^"))))
(assert (not (>= (str.len z) 30)))
(check-sat)
