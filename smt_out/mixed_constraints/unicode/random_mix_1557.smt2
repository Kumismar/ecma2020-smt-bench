; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details onmouseenter=""alert(1)"">test</details>") (= x "b=\""URL(\\""\"";")))
(assert (or (= z "d=x tabindex=1 onbeforedeactivate=alert(1)></base><input autofocus>") (= z " tabindex=1 onb\u{20000}eforedeactivate=alert(1)></map><inp\u{1f4a9}ut autofocus>") (= z "contenteditable>test</dialog>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 16) (= "<details onmouseenter=""alert(1)"">test</details> tabindex=1 onb\u{20000}eforedeactivate=alert(1)javascript:/map><inp\u{1f4a9}ut autofocus>" (str.replace y "><" "javascript:"))))
(assert (or (not (= (str.indexof z "map>" 0) 43)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[9|6|7][0-9]{8}$"))))
(assert (= "te" (str.substr y 28 2)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "\d{2,4}-\d{3,4}-\d{3,4}$")))
(assert (or (not (= "te" (str.substr y 17 2))) (>= (str.len z) 8)))
(assert (not (>= (str.len y) 75)))
(check-sat)
