; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li onbeforepaste=""alert(1)"" contenteditable>test</li>") (= x "<textarea onblur=alert(1) id=x></textarea><input autofocus>") (= x "<canvas id=x tabindex=1 onactivate=alert(1)></canvas>")))
(assert (or (= z "test</tr>") (= z "/hr>") (= z "agend=""alert(1)"">test</fieldset>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "ouse")))
(assert (or (not (= (str.at y 22) "r")) (not (= "an" (str.substr y 2 2)))))
(assert (= (str.at y 51) "t"))
(assert (not (= (str.len z) 44)))
(assert (or (not (= (str.len y) 58)) (not (= (str.len z) 4))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=^.{8,}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*"))) (str.prefixof "<li on" y)))
(check-sat)
