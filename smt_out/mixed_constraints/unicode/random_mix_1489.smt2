; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><shadow id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></shadow>") (= x "<style>@keyframes x{}</style><canvas style=""animation-name:x"" onanimationend=""alert(1)""></canvas>") (= x "<style><img src=""</style><img src=x onerror=alert(123)//"">")))
(assert (or (= z "audio id=x controls onfocusin=alert(1) id=x><source src=""validaudio.wav""></audio>") (= z " onmouseup=""alert(1)"">test</script>") (= z "c=x onerror=""javascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "ript" 0) 30)) (not (str.contains x "&#058;m")) (<= (str.len y) 211)))
(assert (or (not (str.suffixof "29;'>" x)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^#(?:[0-9a-fA-F]{3}){1,2}$")))))
(assert (= (str.at x 27) "e"))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9 aA-zZ '-]*$"))))
(assert (or (= (str.indexof x "tyle" 0) 2) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{9}"))) (>= (str.len x) 94)))
(assert (or (= "le>:target" (str.substr x 4 10)) (not (= (str.at y 109) "a"))))
(check-sat)
