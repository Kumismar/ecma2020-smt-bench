; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form id=x tabindex=1 ondeactivate=alert(1)></form><input id=y autofocus>") (= x "<plaintext onmousedown=""alert(1)"">test</plaintext>")))
(assert (or (= z """>test</a>") (= z ");&quot;&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<pla" x) (not (= "<form id=x tabindex=1 ondeactivate=a""t(1)></form><input id=y autofocus>" (str.replace x "ler" """"))) (not (str.suffixof "est</a>" z))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_\.\-]+@(?:[a-zA-Z0-9\-]+\.)+[a-z]{2,4}$")) (= "<form id=x txbindex=1 ondeactivate=alert(1)></form><input id=y autofocus>" (str.replace x "a" "x")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[\-\.0-9A-Z a-z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}]{3,}$"))))
(assert (or (not (str.contains z "st</a>")) (= "<form id=x tabindex=1 ondeactiva<b>lert(1)></form><input id=y autofocus>" (str.replace x "te=a" "<b>"))))
(assert (or (not (str.contains y "activate=")) (= "ot;&gt;" (str.substr z 5 8))))
(check-sat)
