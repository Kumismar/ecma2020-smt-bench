; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><details onload=alert(1)></details>") (= x "<mark onbeforecopy=""alert(1)"" contenteditable>test</mark>") (= x "perl -e ';print "";&;<;SCR\0IPT>;alert("";XSS"";)<;/SCR\0IPT>;"";;'; >; out")))
(assert (or (= z "d>") (= z "t(1)></del><input id=y autofocus>") (= z "vascript:alert(1))%7D"";</style>")))
(assert (= y (str.++ x z)))
(assert (= "edita" (str.substr x 37 5)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "\w+([-+.]\w+)*@(?!(hotmail|gmail|yahoo|msn|excite|outlook|aol|live)\.com$)\w+([-.]\w+)*\.\w+([-.]\w+)*")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\+?\d{10,12}$")))))
(assert (or (not (= (str.indexof y "ils " 0) 10)) (str.contains x "era:-)\u{1d400}> a")))
(assert (or (not (= (str.indexof z ":" 0) 8)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{c0}-\u{ff} ,.'-]+$")))))
(assert (= "CR\" (str.substr x 50 3)))
(assert (<= (str.len y) 93))
(assert (or (not (>= (str.len z) 21)) (>= (str.len y) 88)))
(assert (or (not (= (str.at x 10) "p")) (not (str.prefixof "<svg><det" y)) (not (= (str.at z 0) "d"))))
(assert (str.suffixof "ect>" z))
(check-sat)
