; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><frameset id=x style=""transition:color 1s"" ontransitionend=alert(1)></frameset>") (= x "<list\u{1f4a9}ing onmousemove=""alert(1)""\u{1f600}>test</listing>") (= x "<menu oncopy=""alert(1)"" contenteditable>test</menu>")))
(assert (or (= z "/colgroup>") (= z """alert(1)"" contenteditable>test</nav>") (= z """>test</footer>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y " 1" 0) 73)))
(assert (or (not (= (str.at x 39) ">")) (str.contains z "olgro") (not (str.contains x "t</listin"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(1[3-9]/d{9})$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{1}$"))) (= """ co" (str.substr y 22 4)) (str.prefixof "/co" z)))
(assert (or (not (str.contains z "test</foo")) (not (= "ert(1)""" (str.substr x 16 7))) (not (= (str.indexof z ">" 0) 0))))
(check-sat)
