; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer onbeforecut=""alert(1)"" contenteditable>test</footer>") (= x "<figcaption id=x tabindex=1 ondeactivate=alert(1\u{1f4a9})></figcaption><i\u{10348}nput id=y autofocus>") (= x "<style>:target {transform: rotate(180deg);}</style><frame id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></frame>")))
(assert (or (= z "E=&quot;&amp;{alert(&apos;XSS&apos;)}&quot;&gt;") (= z "big onmousemove=""alert(1)"">test</big>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "ve=""") (not (str.contains (str.replace z "edita" "<b>") "nt<b>ble")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9\u{e9}\u{e8}\u{ef}\u{f6}\u{e7}]+$"))))
(assert (or (not (str.suffixof ">" y)) (not (str.suffixof "/b>" y))))
(assert (or (not (= "usemove=""" (str.substr z 8 9))) (not (= (str.at z 5) "n")) (= (str.indexof z " on" 0) 3)))
(assert (or (= (str.indexof y "o" 0) 9) (not (= (str.indexof x "tr" 0) 16))))
(assert (or (str.suffixof "quot;&gt;" y) (= (str.at z 8) "d") (not (= "<isindex id=x <b>ndex=1 onfocusin=alert(1)></isindex>>" (str.replace y "tabi" "<b>")))))
(check-sat)
