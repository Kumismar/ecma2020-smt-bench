; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li onbeforepaste=""alert(1)"" contenteditable>test</li>") (= x "<SCRIPT SRC=""%(jpg)s""></SCRIPT>")))
(assert (or (= z """></applet>") (= z "est</tt>") (= z ">test</q>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "edi" "x") "ntxtable") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@(?!(?:gmail|yahoo|outlook|me|icloud|aol|zoho|mail|hotmail|live|linkedin|hiredscore|entelo|ideal|monster|careerbuilder|textkernel|goarya|comcast|atipica))[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))) (not (str.suffixof "/output>" x))))
(assert (or (= "></applet>" (str.substr y 55 10)) (str.prefixof "<li onbefo" y)))
(assert (not (str.suffixof "let>" y)))
(assert (= "lert(" (str.substr y 18 5)))
(assert (not (str.prefixof ">test</q" z)))
(check-sat)
