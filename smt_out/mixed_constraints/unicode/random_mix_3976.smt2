; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav onpaste=""alert(1)"" contenteditable>test</nav>") (= x "<image onbeforepaste=""alert(1)"" contenteditable>test</image>")))
(assert (or (= z " {color: red;}</style><table id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></table>") (= z "seleave=""alert(1)"">test</label>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-z0-9_\.-]+)@([\da-z\.-]+)\.([a-z\.]{2,6})$")) (not (= (str.at z 7) "="))))
(assert (or (= (str.indexof x " con" 0) 31) (= "itab" (str.substr x 33 4)) (str.prefixof "<for" x)))
(assert (or (= (str.indexof x "av>" 0) 47) (not (str.prefixof """><s\u{1f4a9}cript" x))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "((?![^a-z\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}A-Z\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{f1}\u{d1}\u{fc}\u{dc}]).)*")))
(check-sat)
