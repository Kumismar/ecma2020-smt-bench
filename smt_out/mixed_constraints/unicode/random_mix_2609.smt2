; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><h1 id=x style=""transition:color 1s"" ontransitionend=alert(1)></h1>") (= x "<rb onmouseout=""alert(1)"">test</rb>") (= x "<code id=x tabindex=1 onactivate=alert(1)></code>")))
(assert (or (= z ")"">test</plaintext>") (= z " contenteditable>test</font>") (= z "cript:alert(1)""></video>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "deo>" y) (= " style=" (str.substr x 43 7)) (str.contains x " tabind")))
(assert (not (= ">)"">test</" (str.substr y 34 10))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{1,2}[-][0-9]{1,2}[-][0-9]{4}$")) (str.contains z "ipt:alert(") (not (str.suffixof "b>" x))))
(assert (or (str.prefixof ")" z) (not (<= (str.len z) 26))))
(assert (or (not (= "<style>:target {color:red;}</style><h1 id=x style=""transition:color 1s"" ontransitionend=alert(1x1>" (str.replace x ")></h" "x"))) (not (str.suffixof ")></h1>" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) ".{1,500}")))))
(assert (not (str.prefixof " " z)))
(assert (str.contains y "alert(1"))
(check-sat)
