; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span draggable=""true"" ondragleave=""alert(1)"">test</span>") (= x "<frame onmouseover=""alert(1)"">test</frame>") (= x "<svg><picture onload=alert(1)></picture>")))
(assert (or (= z "ndex=1 id=x></del><input autofocus>") (= z "fn style=""animation-name:x"" onanimationstart=""alert(1)""></dfn>") (= z "nput oncopy=alert(1) value=""XSS"" autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "lue=""" 0) 23) (not (str.contains (str.replace x "ragg" "x") "an dxable"))))
(assert (or (str.prefixof "<spa" y) (str.suffixof "caption>" x)))
(assert (or (= (str.at z 22) "m") (str.prefixof "n" z) (not (= (str.at x 12) "b"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "8-[0-9]{3}-[0-9]{3}-[0-9]{2}-[0-9]{2}"))))
(assert (or (str.prefixof "<frame onm" y) (str.contains y "=alert(")))
(assert (= (str.at y 90) "a"))
(check-sat)
