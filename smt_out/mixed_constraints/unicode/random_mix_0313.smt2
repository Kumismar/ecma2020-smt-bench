; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "`""'><img src=xxx:x onerror\x0D=javascript:alert(1)>") (= x "<nav draggable=""true"" ondragleave=""alert(1)"">test</nav>") (= x "<noembed onclick=""alert(1)"">test</noembed>")))
(assert (or (= z "e"">") (= z "ate(180deg);}</style><marquee id=x style=""transition:transform 2s""\u{10348} ontransitionr\u{1f4a9}un=alert(1)></marquee>")))
(assert (= y (str.++ x z)))
(assert (or (not (= ";}</style>" (str.substr z 11 10))) (not (<= (str.len x) 55)) (= (str.at x 32) "e")))
(assert (or (= (str.at y 43) """") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([\w.-]+)@(\[(\d{1,3}\.){3}|(?!live\.fr|mail\.ru|hotmail\.fr|arcor\.de|inbox\.ru|yams08|eric\.jones)(([a-zA-Z\d-]+\.)+))([a-zA-Z]{2,4}|\d{1,3})(\]?)$")))))
(assert (or (not (str.suffixof "</nav>e"">" y)) (= (str.len z) 3)))
(assert (or (not (str.suffixof "rquee>" y)) (not (= (str.len x) 42))))
(assert (= (str.indexof x """tr" 0) 15))
(check-sat)
