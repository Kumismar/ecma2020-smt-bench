; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img\x13src=x onerror=""javascript:alert(1)"">") (= x "<ul onmouseenter=""alert(1)"">test</ul>") (= x "<q onmouseup=""alert(1)"">test</q>")))
(assert (or (= z "(1)\u{20000}"">test</td>") (= z "id=x onfocus=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "tes" 0) 24)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?<!\w)(\(?(\+|00)?48\)?)?[ -]?\d{3}[ -]?\d{3}[ -]?\d{3}(?!\w)"))) (not (= (str.indexof y "est" 0) 25))))
(assert (or (not (<= (str.len z) 17)) (= "<ul onmousexter=""alert(1)"">test</ul>" (str.replace x "en" "x")) (str.suffixof "st</td>" z)))
(assert (= "es" (str.substr z 7 2)))
(assert (not (str.suffixof "est</td>" y)))
(assert (not (= "(1)xtest</td>" (str.replace z "\u{20000}"">" "x"))))
(check-sat)
