; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><video onload=alert(1)></video>") (= x "<div draggable=""true"" contenteditable>drag me</div><center ondragover=alert(1) contenteditable>drop here</center>")))
(assert (or (= z "bbr draggable=""true"" ondrag=""alert(1)"">test</abbr>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<div dragg" x)) (str.contains x "nload=ale") (not (str.suffixof "t</abbr>" y))))
(assert (or (<= (str.len z) 56) (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9.*_+-]{4,30}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{7}-[0-9]{7}$"))))
(assert (or (not (= "</abbr" (str.substr z 43 6))) (not (str.contains z "ring.fro"))))
(check-sat)
