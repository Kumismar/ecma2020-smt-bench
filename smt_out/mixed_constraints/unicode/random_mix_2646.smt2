; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form id=x tabindex=1 onfocus=alert(1)></form>") (= x "<u draggable=""true"" ondrag=""alert(1)"">test</u>")))
(assert (or (= z "ME&gt;") (= z "forecopy=""alert(1)"" contenteditable>test</section>") (= z "=alert(1)></tr><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<embed o" y)) (not (= (str.indexof z "gt;" 0) 3))))
(assert (or (not (str.contains z "ME&gt;")) (= "forecopy=""alert(1)"" contented ble>test</section>" (str.replace z "ita" " ")) (not (= "<ualert(1)ggable=""true"" ondrag=""alert(1)"">test</u>ME&gt;" (str.replace y " dra" "alert(1)")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Z]{8,11}$"))) (= "=alert(1)alert(1)tr><input autofocus>" (str.replace z "></" "alert(1)"))))
(assert (= (str.indexof x "ler" 0) 29))
(check-sat)
