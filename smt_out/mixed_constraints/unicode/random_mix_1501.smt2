; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><nav id=x style=""transition:color 1s"" ontransitionend=alert(1)></nav>") (= x "<map draggable=""true"" ondrag=""alert(1)"">test</map>")))
(assert (or (= z " draggable=""true"" o\u{1f4a9}ndragleave=""alert(1\u{20000})"">test</label>") (= z "table>test</dfn>") (= z "thead>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 47) (not (str.in_re y ((_ re.from_regex ecma2020 u) ".{7,}")))))
(assert (or (not (= "<style>:target {color: d;}</style><nav id=x style=""transition:color 1s"" ontransitionend=alert(1)></nav>thead>" (str.replace y "re" " "))) (<= (str.len y) 129) (not (str.contains (str.replace y "ad>" "javascript:") ">thejavascript:"))))
(assert (or (= "/" (str.replace z "span>" "")) (str.contains z "le>te") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^14$")))))
(assert (not (<= (str.len x) 109)))
(assert (not (str.suffixof "ad>" y)))
(assert (or (= (str.at z 1) "1") (not (= (str.at y 20) """"))))
(check-sat)
