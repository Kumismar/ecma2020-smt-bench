; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed onmousedown=""alert(1)"">test</embed>") (= x "<command onclick=""alert(1)"">test</command>")))
(assert (or (= z "03C") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace z "0" "<b>") "<b>3C")))
(assert (or (= (str.at z 0) ">") (str.contains (str.replace x "w" "x") "sedoxn=""a") (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Z1-9]{6}")))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\s*]([a-zA-Z0-9\s]+){0,10}$")) (= (str.at x 3) "b")))
(assert (or (<= (str.len z) 47) (not (= (str.len y) 45)) (not (= "com" (str.substr y 34 3)))))
(assert (>= (str.len y) 33))
(check-sat)
