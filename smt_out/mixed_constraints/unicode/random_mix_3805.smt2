; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<head ondblclick=""alert(1)"">test</head>") (= x "<kbd onbeforecopy=""alert(1)"" contenteditable>test</kbd>") (= x "<audio onmouseleave=""alert(1)"">test</audio>")))
(assert (or (= z ")?'':eval('r=1;") (= z " contenteditable>test</dl>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "al(" (str.substr z 7 3))) (= "agend=""alert(1)t</bdi>" (str.replace z """>tes" "")) (str.prefixof " conte" z)))
(assert (or (= (str.indexof z "e" 0) 10) (= "':eval('" (str.substr y 42 8))))
(assert (or (= ">" (str.substr z 25 10)) (str.in_re x ((_ re.from_regex ecma2020 u) "^([u4E00-u9FA5]{2,4})$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "09[0-9]{9}")) (= (str.indexof y "bd on" 0) 2)))
(check-sat)
