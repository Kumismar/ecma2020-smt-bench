; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid onmouseout=""alert(1)"">test</nextid>") (= x "<a onmousedown=""alert(1)"">test</a>") (= x "<shadow draggable=""true"" ondragstart=""alert(1)"">test</shadow>")))
(assert (or (= z "#x28;1&#x29;""/*/onerror='eval(src)'>") (= z """>test</strong>") (= z "eforepaste=""alert(1)"" contenteditable>test</video>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 14) "o")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{7}"))) (str.suffixof "rong>" z)))
(assert (or (not (str.contains x "a onmoused")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z]{6}[0-9]{2}[A-Za-z]{1}[0-9]{2}[A-Za-z]{1}[0-9]{3}[A-Za-z]{1}")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{5c}u4e00-\u{5c}u9fa5]{1,5}$"))) (= ">efore" (str.substr y 33 6)) (not (= "edown" (str.substr x 9 5)))))
(check-sat)
