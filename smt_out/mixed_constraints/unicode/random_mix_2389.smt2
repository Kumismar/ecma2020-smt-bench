; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdi onkeyup=""alert(1)"" contenteditable>test</bdi>") (= x "<mark onblur=alert(1) tabindex=1 id=x></mark><input autofocus>") (= x "<svg><code onload=alert(1)></code>")))
(assert (or (= z "<html onload=alert(1)></html>") (= z "t autofocus>") (= z ";1&#41;&#47;&#47;"">XYZ</a")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<mar" y) (= (str.len y) 63)))
(assert (or (not (str.contains z "tioncan")) (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9])+([a-zA-Z0-9._-])*@([a-zA-Z0-9_-])+([a-zA-Z0-9._-]+)+$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([A-Za-z0-9_\-.+])+@([A-Za-z0-9_\-.])+\.([A-Za-z]{2,})$"))) (not (= (str.at x 15) "l")) (not (= (str.indexof x "e hre" 0) 10))))
(assert (or (str.contains x "ode on") (str.suffixof "ofocus>" x)))
(assert (>= (str.len z) 25))
(check-sat)
