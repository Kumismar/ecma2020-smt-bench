; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table id=x tabindex=1 onbeforedeactivate=alert(1)></table><input autofocus>") (= x "<noscript id=x tabindex=1 ondeactivate=alert(1)></noscript><input id=y autofocus>")))
(assert (or (= z "lert(1)"">test</style>") (= z "lert(1)"">test</dd>") (= z "ins draggable=""true"" ondragleave=""alert(1)"">test</ins>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len z) 23)) (not (= (str.at z 20) "P")) (str.suffixof "st</dd>" z)))
(assert (or (not (= (str.at x 1) "n")) (= (str.indexof x "ate=a" 0) 38) (not (= "d>" (str.substr z 16 4)))))
(assert (or (= (str.indexof x "<" 0) 0) (= "l" (str.substr x 4 1)) (str.suffixof "ocus>" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 ].{3,50}"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z][- a-zA-Z]*[- ]{1}[- a-zA-Z]*[a-zA-Z]$"))) (not (str.contains y "ofocus"))))
(assert (= "le><inp" (str.substr y 56 7)))
(check-sat)
