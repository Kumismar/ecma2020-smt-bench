; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<p id=x tabindex=1 onfocus=alert(1)></p>") (= x "<br draggable=""true"" ondragend=""alert(1)"">test</br>")))
(assert (or (= z " doc [") (= z "style><image style=""animation-name:x"" onanimationstart=""alert(1)""></image>") (= z "transition:color 10s"" ontransitioncancel=alert(1)></menuitem>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{0,11}$"))))
(assert (or (not (str.contains y "(1)")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9,A-Z,a-z,_ \.\-*?\/]+$|[A-Z,a-z][A-Z,a-z, \.'~\-]+$")) (not (= (str.at y 44) "s"))))
(assert (or (str.suffixof "c [" z) (= (str.at z 32) "m") (not (<= (str.len z) 45))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\d]{4}"))) (= (str.indexof x "t</b" 0) 45)))
(check-sat)
