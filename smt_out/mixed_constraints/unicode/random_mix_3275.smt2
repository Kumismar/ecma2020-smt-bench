; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<audio onclick=""alert(1)"">test</audio>") (= x "<tfoot onkeyup=""alert(1)"" contenteditable>test</tfoot>") (= x "<pre id=x tabindex=1 ondeactivate=alert(1)></pre><input id=y autofocus>")))
(assert (or (= z "ction>") (= z "r>")))
(assert (= y (str.++ x z)))
(assert (= "it" (str.substr x 35 2)))
(assert (or (= ">test<" (str.substr y 41 6)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{e9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{c9}'\s]+$"))) (not (= (str.len z) 39))))
(assert (not (str.contains (str.replace y "i" "x") "e xd")))
(assert (or (str.prefixof "<" y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-4][0-9][0-9]?$|^[1-9]\d$|^[1-9]$|^500$"))) (str.suffixof "ocus>" x)))
(assert (or (str.suffixof "ofocus>r>" y) (= (str.at z 1) ">") (not (= (str.indexof y "rt(1)" 0) 19))))
(assert (= (str.indexof y "nc" 0) 8))
(check-sat)
