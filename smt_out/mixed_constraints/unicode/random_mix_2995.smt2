; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody onmouseleave=""alert(1)"">test</tbody>") (= x "<img onfocusout=alert(1) tabindex=1 id=x></img><input autofocus>")))
(assert (or (= z "/rp>") (= z "rs.org/.j>;")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 41) "y")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[#$^+=!*()@%&]).{8,10}$"))) (= "</tbody" (str.substr y 35 7)) (not (= ") t" (str.substr x 23 3)))))
(assert (or (not (str.suffixof "/.j>;" y)) (not (str.prefixof "<" x)) (not (= (str.indexof z "></h" 0) 5))))
(assert (= (str.at x 40) "d"))
(assert (not (= "<tbody onmouseleav""""alert(1)"">test</tbody>" (str.replace x "e=" """"))))
(assert (or (not (str.suffixof "</tbody>" x)) (not (= (str.at z 0) "="))))
(assert (= "ontente" (str.substr z 23 7)))
(check-sat)
