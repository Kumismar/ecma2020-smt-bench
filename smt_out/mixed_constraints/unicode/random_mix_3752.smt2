; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br oncopy=""alert(1)"" contenteditable>test</br>") (= x "<;INPUT TYPE="";IMAGE""; SRC="";javascript:alert(';XSS';);"";>;") (= x "<strike onmousemove=""alert(1)"">test</strike>")))
(assert (or (= z "=""about:<script>document.vulnerable=true;</script>"">") (= z " tabindex=1 onbeforeactivate=alert(1)></a>") (= z "r>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len x) 47)) (not (= (str.indexof x "st</b" 0) 40)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9 ]{5,50}$")))))
(assert (or (not (= "="";java" (str.substr x 26 7))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]{6,20}$")))))
(assert (or (str.prefixof "<;INPU" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9]).{8,}")))))
(assert (or (str.suffixof "</a>" z) (not (= "rik" (str.substr x 3 3))) (not (= (str.at y 76) "o"))))
(assert (= (str.indexof z "aler" 0) 29))
(check-sat)
