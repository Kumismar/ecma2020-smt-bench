; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite id=x tabindex=1 onfocusin=alert(1)></cite>") (= x "<button onbeforepaste=""alert(1)"" contenteditable>test</button>") (= x "<th ondblclick=""alert(1)"">tes\u{1d400}t</th>")))
(assert (or (= z "u>") (= z ">drag me</div><var ondrop=alert(1) contenteditable>drop here</var>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "u>" 0) 0)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[+a-zA-Z0-9._-][+a-zA-Z0-9._-][+a-zA-Z0-9._-]+@[+a-zA-Z0-9]\w+([\.\-]?\w+)*(\.\w{2,4})+$"))) (= (str.indexof y "bod" 0) 1)))
(assert (not (str.contains (str.replace z "u" "") ">")))
(assert (or (not (str.contains (str.replace x "l" "alert(1)") "tyalert(1)e>:")) (= (str.indexof x " o" 0) 21)))
(assert (or (= (str.at z 1) ">") (not (str.suffixof "s\u{1d400}t</th>" x))))
(assert (str.contains (str.replace y "blcli" "x") " ondxc"))
(check-sat)
