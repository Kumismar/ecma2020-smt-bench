(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select onmousemove=""alert(1)"">test</select>") (= x "<head draggable=""true"" ondragenter=""alert(1)"">test</head>")))
(assert (or (= z "/select><input autofocus>") (= z "rt(1)>")))
