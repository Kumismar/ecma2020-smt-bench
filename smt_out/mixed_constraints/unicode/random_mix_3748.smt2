(assert (or (= (str.at x 52) "h") (str.contains y "ert(1)"">t")))
(assert (or (not (>= (str.len y) 48)) (str.contains x "ue""")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9\u{e01}-\u{e59}]+")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]\d*(\.\d{0,4})?$")))))
(assert (or (= "<pre onmouseup=""alert1)"">test</pre>cument.vulnerable=true;)"">" (str.replace y "(" "")) (str.prefixof "<selec" y) (str.in_re z ((_ re.from_regex ecma2020 u) "\S+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"))))
(check-sat)
