; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onmouseout=""alert(1)"">test</iframe>") (= x "<details draggable=""true"" ondragenter=""alert(1)"">test</details>") (= x "<IMG SRC=x onkeydown=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "video onpaste=""alert(1)"" contenteditable>test</video>") (= z "0%"" onmouseover=""prompt(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?!^0+$)[0-9]{5}"))) (str.prefixof "<iframe o" y) (not (str.contains z "oreact"))))
(assert (or (not (= (str.len x) 63)) (str.contains x "mg src\x0") (str.in_re y ((_ re.from_regex ecma2020 u) ".{2,}"))))
(assert (str.suffixof "</iframe>" x))
(assert (not (str.contains (str.replace y "r" """") "e""t(S")))
(assert (or (= (str.at x 6) "e") (>= (str.len z) 22) (= (str.indexof x "alert" 0) 20)))
(assert (or (not (str.contains z """al")) (str.prefixof "<deta" y)))
(assert (or (str.prefixof "<i" y) (= ">" (str.substr z 27 7))))
(check-sat)
