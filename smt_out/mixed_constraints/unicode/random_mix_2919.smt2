; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt onkeyup=""alert(1)"" contenteditable>test</dt>") (= x "<img src=""javascript:alert(2)"">")))
(assert (or (= z "test</element>") (= z "av""></audio>") (= z "bindex=1 onbeforeactivate=alert(1)></a>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "t:al" 0) 19)) (not (str.contains (str.replace y ">t" "") "bleest<")) (str.contains (str.replace y "l" "javascript:") "=""ajavascript:e")))
(assert (not (str.prefixof "<strong" y)))
(assert (or (not (= (str.at z 21) "v")) (str.prefixof "<xmp" x) (not (= (str.indexof z "inde" 0) 1))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[6789].+[0-9]+"))))
(assert (= "test</eleme t>" (str.replace z "n" " ")))
(assert (str.suffixof "</script>" x))
(check-sat)
