; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video ondblclick=""alert(1)"">test</video>") (= x "<p draggable=""true"" ondragstart=""alert(1)"">test</p>") (= x "<style>:target {color: red;}</style><slot id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></slot>")))
(assert (or (= z "3C") (= z "test</sup>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[^0]+[0-9]{1,3}(\.?[0-9]{3})*(,[0-9]{1,2})?$"))) (str.in_re y ((_ re.from_regex ecma2020 u) "(?=^.{6,50}$)(?=.*\d)((?=.*[a-z])|(?=.*[A-Z]))(?!.*\s)[0-9a-zA-Z!@#$%*]*$")) (str.suffixof "/sup>" y)))
(assert (or (not (str.prefixof "test" z)) (not (= (str.indexof y "r" 0) 4)) (not (= "3C" (str.substr z 0 5)))))
(assert (or (not (str.prefixof "<" x)) (not (= (str.at y 64) ":"))))
(assert (or (str.contains x "=""") (not (= (str.at z 7) "u")) (= """" (str.replace z "3C" """"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{4}[A-Za-z]{2}")) (not (= (str.len x) 51))))
(assert (not (= (str.at z 8) "p")))
(check-sat)
