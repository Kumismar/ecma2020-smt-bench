; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<acronym onpaste=""alert(1)"" contenteditable>test</acronym>") (= x "<progress onclick=""alert(1)"">test</progress>")))
(assert (or (= z "88,83,83))""></img>") (= z "foredeactivate=alert(1)></ol><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "<acronym onpaste=""alert(1javascript:ontenteditable>test</acronym>" (str.replace x ")"" c" "javascript:")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(0|86|17951)?(13[0-9]|15[012356789]|17[0678]|18[0-9]|14[57]|19[189])[0-9]{8}")))))
(assert (<= (str.len y) 84))
(assert (or (not (str.contains z ",83,83))")) (str.prefixof "<progres" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,}$")))))
(assert (str.prefixof "<" x))
(assert (not (str.prefixof "</ca" z)))
(check-sat)
