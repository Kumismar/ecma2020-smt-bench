; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong id=x tabindex=1 onbeforedeactivate=alert(1)></strong><input autofocus>") (= x "<marquee width=1 loop=1 onfinish=alert(1)>XSS</marquee>")))
(assert (or (= z ")"" contenteditable>test</content>") (= z "own=""alert(1)"" contenteditable>test</strong>") (= z "/area>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "cus>" x) (= "e width=" (str.substr x 7 8)) (not (= (str.indexof x "i dr" 0) 3))))
(assert (or (not (str.contains y "=""true"" on")) (not (str.suffixof "trong>" z))))
(assert (or (not (= ")"" con nteditable>test</content>" (str.replace z "te" " "))) (>= (str.len y) 97)))
(assert (or (not (= "n" (str.substr x 28 1))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z\s]{3,}"))) (not (str.contains x "ng id=x ta"))))
(assert (str.suffixof "tofocus>" x))
(assert (not (str.contains (str.replace x "a" "alert(1)") "=x talert(1)bi")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{3}\d{4}\d{3}$"))) (str.contains y "co")))
(check-sat)
