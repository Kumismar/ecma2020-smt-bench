; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><colgroup ondragover=alert(1) contenteditable>drop here</colgroup>") (= x "<dir onfocusout=alert(1) tabindex=1 id=x></dir><input autofocus>") (= x "<b oncopy=""alert(1)"" contenteditable>test</b>")))
(assert (or (= z """alert(1)"">test</s>") (= z ";URL=javascript&#058;alert('XSS');\""") (= z "elect onmousemove=""alert(1)"">test</select>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len z) 23))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$")) (str.contains x "roup ond")))
(assert (not (str.contains x "x=1 id=x><")))
(assert (or (= (str.at z 0) """") (not (str.suffixof "t>" y)) (not (str.prefixof "<d" y))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\w\p{L}\p{N}\p{Pd}\s]*$"))) (not (str.prefixof "e" z))))
(assert (or (not (str.suffixof "st</s>" z)) (not (= (str.at x 58) "o"))))
(assert (not (str.contains (str.replace x "y=""" "") "oncopaler")))
(assert (or (not (= (str.at z 13) "s")) (not (str.contains z " id=""fuzze")) (str.in_re x ((_ re.from_regex ecma2020 u) "^AX\d{3,7}|AI\d{3,7}$"))))
(check-sat)
