; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del onmouseup=""alert(1)"">test</del>") (= x "<ol onmousedown=""alert(1)"">test</ol>")))
(assert (or (= z "/dialog>") (= z "String.fromCharCode(88,83,83))</SCRIPT>") (= z "rt(1)"">test</d\u{1d400}d>")))
(assert (= y (str.++ x z)))
(assert (or (= ">test</as" (str.substr y 53 9)) (not (str.suffixof "ialog>" y)) (not (str.suffixof "</d\u{1d400}d>" z))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([\w\d.\-+_\u{2018}]+)@((?:[-a-z0-9]+\.)+[a-z]{2,})$"))) (not (= (str.at z 1) "d")) (not (= "<style>:target {color:red;}</style><code id=x style=""traalert(1)sition:color 1s"" ontransitionend=alert(1)></code>" (str.replace x "n" "alert(1)")))))
(assert (or (not (= (str.at x 43) "e")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^@[A-Za-z0-9_]{1,15}$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\+?[\d\s\.*]+$"))) (= "es" (str.substr y 27 2))))
(assert (not (= (str.at z 1) "i")))
(check-sat)
