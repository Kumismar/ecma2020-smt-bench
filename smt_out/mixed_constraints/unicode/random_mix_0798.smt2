; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track onmouseup=""alert(1)"">test</track>") (= x "<;BODY ONLOAD=alert(';XSS';)>;")))
(assert (or (= z "><script>\x0Bjavascript:alert(1)</script>") (= z "ygen>") (= z """>test</label>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "st</label"))
(assert (or (not (= (str.indexof x "ONLO" 0) 7)) (not (str.prefixof "s" z))))
(assert (or (not (= (str.indexof z "ygen>" 0) 0)) (str.prefixof "><s" z) (not (= (str.len x) 40))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(0?[1-9]|1[012])$"))) (not (= "<;BODY ONLOAD=alert(';XSS';)>;><script>\x0Bjavascript:alert( /script>" (str.replace y "1)<" " "))) (str.suffixof "t</source>" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{e2}\u{20ac}\u{2122}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))) (not (str.suffixof "pt>" z)) (not (= (str.indexof x "ck on" 0) 4))))
(assert (str.contains x "t id=x "))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\S.{1,48}$"))))
(check-sat)
