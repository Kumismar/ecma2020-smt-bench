; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b onclick=""alert(1)"">test</b>") (= x "<style>:target {color: red;}</style><colgroup id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></colgroup>") (= x "<section draggable=""true"" ondragenter=""alert(1)"">test</section>")))
(assert (or (= z "ert(1)"">test</ruby>") (= z ")"">test</ruby>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 36) "r")) (str.suffixof "</ruby>" z) (= (str.at z 2) "t")))
(assert (or (not (str.contains z "/rub")) (>= (str.len y) 40)))
(assert (= (str.indexof y "(1)" 0) 44))
(assert (= "est</ru" (str.substr y 39 7)))
(assert (or (not (= "er" (str.substr y 63 2))) (not (str.contains (str.replace y "ic" "alert(1)") "lalert(1)k")) (str.in_re y ((_ re.from_regex ecma2020 u) "^[^A-z\u{410}-\u{44f}]{5,}"))))
(assert (= "t(1)" (str.substr z 2 4)))
(check-sat)
