; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li onkeypress=""alert(1)"" contenteditable>test</li>") (= x "<summary onfocusout=alert(1) tabindex=1 id=x></summary><input autofocus>") (= x "&quot;&gt;&lt;BODY onload!#$%&amp;()*~+-_.,:;?@[/|\]^`=alert(&quot;XSS&quot;)&gt;")))
(assert (or (= z """>test</form>") (= z "/section>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "utofocus>" x)) (not (<= (str.len y) 91)) (not (= (str.at z 3) "c"))))
(assert (= """>test<"">" (str.replace z "/form" """")))
(assert (or (str.contains x "nkeypres") (not (str.contains x "#$%&amp;")) (str.prefixof "im" z)))
(assert (or (= "<summary o cusout=alert(1) tabindex=1 id=x></summary><input autofocus>" (str.replace x "nfo" " ")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=[\x21-\x7e]{1,})[\x21-\x7e]*"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?!.*\s).*$")))))
(assert (str.prefixof """>test" z))
(assert (= (str.at z 0) """"))
(assert (not (= (str.indexof y "p" 0) 58)))
(assert (= (str.at x 18) " "))
(check-sat)
