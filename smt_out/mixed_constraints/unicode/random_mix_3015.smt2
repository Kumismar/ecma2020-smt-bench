; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ol onmouseleave=""alert(1)"">test</ol>") (= x "<!--#exec cmd=""/bin/echo '<SCRIPT SRC'""--><!--#exec cmd=""/bin/echo '=http://ha.ckers.org/xss.js></SCRIPT>'""-->")))
(assert (or (= z "npaste=""alert(1)"" contenteditable>test</ins>") (= z "eyup=""alert(1)"" contenteditable>test</image>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 13) ")") (not (= (str.at z 3) "p")) (not (str.suffixof "/ins>" z))))
(assert (or (= "<" (str.substr x 42 1)) (not (= ">" (str.substr y 80 2)))))
(assert (or (not (str.prefixof "npaste=""a" z)) (not (= "rt(1)" (str.substr y 21 5))) (str.prefixof "<!-" x)))
(assert (or (str.prefixof "<o" y) (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{5}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9 ]{1,}"))))
(check-sat)
