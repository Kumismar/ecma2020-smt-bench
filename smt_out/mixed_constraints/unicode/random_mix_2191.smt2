; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><h1><iframe width=""420"" height=""315"" src=""http://www.youtube.com/embed/sxvccpasgTE"" frameborder=""0"" allowfullscreen></iframe>123</h1>") (= x "<time onmouseenter=""alert(1)"">test</time>") (= x "<handler id=""y"">alert(127)</handler>")))
(assert (or (= z "bject id=x tabindex=\u{1f4a9}1 onactivate=al\u{1d400}ert(1)></object>") (= z "press=""alert(1)"" contenteditable>test</style>") (= z "abindex=1 id=x></optgroup><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0][1-9][0-9]{8}$"))) (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-z0-9_]{8,30}"))))
(assert (or (not (str.suffixof "me>" x)) (not (= (str.indexof z "ctiva" 0) 26))))
(assert (str.prefixof ":" z))
(assert (or (not (= (str.at x 11) "=")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{4}\/\d{1,2}\/\d{1,2}$"))) (= """><h1><iframe width=""420"" height=""315"" src=""http://www.youtube.com/embed/sxvccpasgTE"" framebord ""0"" allowfullscreen></iframe>123</h1>" (str.replace x "er=" " "))))
(assert (or (= (str.len y) 86) (not (= (str.at x 32) "g"))))
(assert (or (= ">" (str.substr z 35 3)) (str.prefixof "<h" x)))
(assert (str.contains z "vate=a"))
(check-sat)
