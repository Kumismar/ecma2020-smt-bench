; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b oncopy=""alert(1)"" contenteditable>test</b>") (= x "<button id=x tabindex=1 onbeforeactivate=alert(1)></button>") (= x "<tt draggable=""true"" ondragend=""alert(1)"">test</tt>")))
(assert (or (= z "le=""true"" ondragleave=""alert(1)"">test</summary>") (= z "t</samp>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "test</b>" x)))
(assert (str.prefixof "<tt" y))
(assert (or (str.prefixof "le=""true" z) (not (= "p" (str.substr z 6 1))) (str.contains x "py=""alert(")))
(assert (or (not (= (str.indexof y "e" 0) 5)) (= "/" (str.substr x 51 1))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "time_de"))))
(assert (or (= (str.indexof y "ate=" 0) 37) (str.contains (str.replace x "x=1 o" """") "e""nb")))
(assert (or (not (str.suffixof "summary>" y)) (not (= (str.indexof x "l" 0) 12)) (str.contains x "ctivate=")))
(assert (str.contains y "textmen"))
(assert (not (str.suffixof "t</samp>" y)))
(check-sat)
