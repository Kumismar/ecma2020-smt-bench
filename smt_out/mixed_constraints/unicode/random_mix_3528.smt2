; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<basefont onkeydown=""alert(1)"" contenteditable>test</basefont>") (= x "<article onclick=""alert(1)"">test</article>") (= x "<style>@keyframes x{}</style><dialog style=""animation-name:x"" onanimationstart=""alert(1)""></dialog>")))
(assert (or (= z "t(1) contenteditable>drop here</strong>") (= z "object data=javascript&colon;\u{5c}u0061&#x6C;&#101%72t(1)>")))
(assert (= y (str.++ x z)))
(assert (not (= "alert(1)(1) contenteditable>drop here</strong>" (str.replace z "t" "alert(1)"))))
(assert (or (str.prefixof "<" x) (not (str.prefixof "<article o" x))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-1][0-9]|2[0-3]):[0-5][0-9]$"))) (= (str.indexof x "di" 0) 39) (= (str.at x 7) ":")))
(assert (or (str.contains (str.replace x "dialo" "") "yle><g ") (str.contains x "ck=") (not (str.contains z "\u{5c}u0061"))))
(assert (or (str.contains y "art") (str.suffixof "ong>" z) (= "ck=""ale" (str.substr x 14 7))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9].{9,9}")) (not (str.contains (str.replace x "efont" " ") "bas  "))))
(check-sat)
