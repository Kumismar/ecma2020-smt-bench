; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select autofocus onfocus=alert(1)>") (= x "<meta onbeforecopy=""alert(1)"" contenteditable>test</meta>")))
(assert (or (= z "lpar;1)&gt;>") (= z "le>drop here</applet>")))
(assert (= y (str.++ x z)))
(assert (or (= "<meta onbeforecopy=""alert(1)"" contenteditalert(1)>test</meta>" (str.replace x "able" "alert(1)")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\s)*([0-9]{3})(\s)*([0-9])(\s)*([0-9])(\s)*([0-9]{2})(\s)*([0-9]{1})(\s)*([0-9]{3})(\s)*$")))))
(assert (or (not (= (str.indexof x "alog>" 0) 47)) (not (str.contains (str.replace z "lpar;" "x") "x1)&g"))))
(assert (or (not (= "o" (str.substr z 5 1))) (str.prefixof "lp" z) (str.prefixof "<meta " y)))
(assert (not (= (str.indexof z "ar;" 0) 2)))
(assert (or (= (str.indexof y """a" 0) 19) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^0?1[3|4|5|6|7|8|9][0-9]\d{8}$")))))
(check-sat)
