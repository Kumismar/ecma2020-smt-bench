; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""41""><li style=list-style:url() onerror=alert(41)></li>") (= x "<cite draggable=""true"" ondragend=""alert(1)"">test</cite>") (= x "<pr\u{1d400}ogress oncopy=""alert(1)"" contenteditable>test</progress>")))
(assert (or (= z " onmousedown=""alert(1)"">test</object>") (= z "lert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (= "rt(1)" (str.substr z 17 5)) (not (str.contains y "rue"" ")) (= (str.at y 38) "i")))
(assert (or (not (str.suffixof "/script>" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9.-]+@[a-z0-9.-]+\.[a-z0-9.-]{2,10}"))) (str.in_re y ((_ re.from_regex ecma2020 u) "^([(][0-9]{1,3}[)][-]?)?([0-9][-]?){3,16}[0-9]$"))))
(assert (or (not (str.suffixof "t>" z)) (not (= (str.indexof z "ert(1" 0) 1)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{9,}$")))))
(assert (= (str.len y) 97))
(check-sat)
