; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onmouseup=""alert(1)"">test</sup>") (= x "<style>@keyframes x{}</style><fieldset style=""animation-name:x"" onanimationend=""alert(1)""></fieldset>")))
(assert (or (= z "ecut=""alert(1)"" contenteditable>test</time>") (= z "id=""134""><xmp>") (= z " id=x tabindex=1 onfocusin=alert(1)></body>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len x) 96)) (= "/tem" (str.substr z 1 4))))
(assert (= "ecut=""alert(1)"" contenteditabest</time>" (str.replace z "le>t" "")))
(assert (or (not (= (str.at x 15) "a")) (not (= (str.indexof x " on" 0) 4))))
(assert (or (= (str.at x 11) "e") (not (str.contains (str.replace z "eet" "") "h"" ")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]{4,}$")))))
(assert (or (= "<sup onmouseup=""alert(""est</sup> id=x tabindex=1 onfocusin=alert(1)></body>" (str.replace y "1)"">t" """")) (>= (str.len x) 94)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^(17)$")))
(check-sat)
