; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onFocus body onFocus=""javascript:javascript:alert(1)""></body onFocus>") (= x "<img usemap=#x><map name=""x""><area href onfocusin=alert(1) id=x>") (= x "<style>:target {color: red;}</style><iframe id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></iframe>")))
(assert (or (= z "beforeactivate=alert(1)></rb>") (= z "=alert(1) attributeName=transform>")))
(assert (= y (str.++ x z)))
(assert (or (= ">" (str.substr z 33 6)) (not (str.prefixof "beforeact" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([0-9-A-z ]){9,}$")))))
(assert (or (str.suffixof "</main>" y) (str.in_re x ((_ re.from_regex ecma2020 u) "([0-9\s]+([.,][0-9\s]*)?|[.,][0-9\s]+)")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-z ]*$")))))
(assert (or (str.suffixof ">" y) (not (str.prefixof "beforeac" z))))
(assert (= (str.at y 39) " "))
(check-sat)
