; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script /*%00*/>/*%00*/alert(1)/*%00*/</script /*%00*/") (= x "<span draggable=""true"" ondragleave=""alert(1)"">test</span>") (= x "<keygen oncontextmenu=""alert(1)"">test</keygen>")))
(assert (or (= z "D=al\u{20000}ert(\u{1f4a9}""XSS"")>") (= z "te=""alert(1)"" contenteditable>test</td>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "10$"))) (= (str.indexof z "nt" 0) 16) (not (str.prefixof "D=al\u{20000}er" z))))
(assert (or (<= (str.len y) 76) (str.prefixof "<keygen on" x) (str.prefixof "D=" z)))
(assert (or (not (>= (str.len y) 61)) (str.contains y ">tes")))
(assert (not (= (str.at x 7) "r")))
(check-sat)
