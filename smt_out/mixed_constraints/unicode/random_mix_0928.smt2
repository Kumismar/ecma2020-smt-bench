; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<audio draggable=""true"" ondragstart=""alert(1)"">test</audio>") (= x "<?xml version=""1.0"" encoding=""ISO-8859-1""?><foo><![CDATA[<]]>SCRIPT<![CDATA[>]]>alert('gotcha');<![CDATA[<]]>/SCRIPT<![CDATA[>]]></foo>")))
(assert (or (= z "foreprint=alert(1)>") (= z " onclick=""alert(1)"">test</audio>") (= z "d=x tabindex=1 onfocusin=alert(1)></dl>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "DAT" 0) 52)) (= (str.at y 73) "T")))
(assert (or (str.contains z "lert(1)"">t") (= (str.indexof z "t(1)" 0) 29)))
(assert (= "RIP" (str.substr x 112 3)))
(assert (not (str.suffixof "st</audio>" z)))
(assert (not (str.suffixof "/dl>" z)))
(assert (or (not (= "apo" (str.substr x 64 3))) (not (str.contains z "am")) (= (str.indexof x "=" 0) 16)))
(assert (= (str.at x 11) "g"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[2-9]{1}\d{2}[- ]?\d{3}[- ]?\d{4}$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{1,12}$"))) (not (= (str.at x 3) "d"))))
(check-sat)
