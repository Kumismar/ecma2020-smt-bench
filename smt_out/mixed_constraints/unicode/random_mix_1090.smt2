; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext id=x tabindex=1 onfocusin=alert(1)></plaintext>") (= x "&lt;DIV STYLE=&quot;background-image: url(javascript:alert(&apos;XSS&apos;))&quot;&gt;") (= x "<acronym draggable=""true"" ondragstart=""alert(1)"">test</acronym>")))
(assert (or (= z ");</SCRIPT>") (= z "(1)"" contenteditable>test</u>") (= z "(\u{10348}1)")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "g" "<b>") " dra<b>g") (str.prefixof ");</" z) (= (str.indexof z "/sub>" 0) 14)))
(assert (= "/" (str.substr y 47 1)))
(assert (not (= (str.indexof z ";" 0) 1)))
(assert (not (= (str.indexof z "rt(1" 0) 10)))
(assert (or (not (str.contains (str.replace z "=t" "<b>") "e<b>rue;")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\w.%+-]+@[\w.-]+\.[A-Za-z]{2,6}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z \u{fc}\u{dc}\u{f6}\u{d6}\u{e4}\u{c4}\u{df}.-]*")))))
(assert (not (= ")" (str.substr z 3 4))))
(check-sat)
