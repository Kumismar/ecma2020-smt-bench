; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><tr onload=alert(1)></tr>") (= x "<body onscroll=alert(1)><br><br><br><br>") (= x "<xmp draggable=""true"" ondragenter=""alert(1)"">test</xmp>")))
(assert (or (= z "EQUIV="";refresh""; CONTENT="";0;url=data:text/html;base64,PHNjcmlwdD5hbGVydCgnWFNTJyk8L3NjcmlwdD4K"";>;") (= z ">test</section>")))
(assert (= y (str.++ x z)))
(assert (not (= "><tr o" (str.substr x 4 6))))
(assert (= (str.at x 13) "l"))
(assert (or (not (= (str.at x 21) "1")) (= (str.at y 54) "n")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "(?=[-_a-zA-Z0-9]*?[A-Z])(?=[-_a-zA-Z0-9]*?[a-z])(?=[-_a-zA-Z0-9]*?[0-9])[-_a-zA-Z0-9]{8,16}")) (not (= ">" (str.substr y 44 9)))))
(assert (not (str.suffixof "4K"";>;" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "ssn"))) (not (= "<""tr onload=alert(1)></tr>" (str.replace x "svg><" """"))) (= "pt:ale" (str.substr y 73 6))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) ".+[0-9]+$"))) (not (str.suffixof "eader>" x))))
(check-sat)
