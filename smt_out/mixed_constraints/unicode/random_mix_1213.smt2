; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col onmouseup=""alert(1)"">test</col>") (= x "<center oncopy=""alert(1)"" contenteditable>test</center>")))
(assert (or (= z ";quot;)>;") (= z "wbr>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(?=^.{8,}$)((?=.*\d))((?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$")) (not (= "</col>;" (str.substr y 30 7)))))
(assert (not (str.contains y "ol>")))
(assert (or (not (str.suffixof "io>" z)) (not (= (str.indexof y "py=""a" 0) 12)) (not (>= (str.len y) 55))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^([-0-9]){8,}$")) (not (str.suffixof "</input>" x))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{11,11}$"))) (str.suffixof "col>" x) (str.contains (str.replace z "br>" "x") "wx")))
(assert (or (= (str.indexof y "t</" 0) 29) (not (>= (str.len x) 33))))
(check-sat)
