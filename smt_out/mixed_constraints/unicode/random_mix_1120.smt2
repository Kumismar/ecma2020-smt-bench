; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><div id=x style=""transition:color 1s"" ontransitionend=alert(1)></div>") (= x "<shadow oncut=""alert(1)"" contenteditable>test</\u{1f600}shadow>")))
(assert (or (= z "ot;//google&quot;&gt;XSS&lt;/A&gt;") (= z "<xmp style=""animation-name:x"" onanimationstart=""alert(1)""></xmp>") (= z "able>drag me</div><dfn ondrop=alert(1) contenteditable>drop here</dfn>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 21) ":"))
(assert (str.suffixof ">" z))
(assert (or (not (= (str.at x 13) "i")) (not (str.suffixof "er>" y)) (>= (str.len z) 64)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z\u{139}\u{17a}\u{102}\u{13d}\u{102}\u{b6}\u{c4}\u{b1}\u{c4}\u{17a}\u{102}\u{a7}\u{139}\u{17e}\u{102}\u{15b}\u{102}\u{2013}\u{c4}\u{b0}\u{c4}\u{17e}\u{102}\u{2021}0-9-_\.]{1,15}$")) (str.in_re x ((_ re.from_regex ecma2020 u) "[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}A-Za-z\s]{3,30}"))))
(assert (not (= "v><" (str.substr y 120 3))))
(assert (not (<= (str.len z) 38)))
(check-sat)
