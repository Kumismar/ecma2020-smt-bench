; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><isindex id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></isindex>") (= x "<dialog onpaste=""alert(1)"" contenteditable>test</dialog>") (= x "<div draggable=""true"" contenteditable>drag me</div><figcaption ondragover=alert(1) contenteditable>drop here</figcaption>")))
(assert (or (= z "leave=""alert(1)"">test</center>") (= z ">") (= z "(1)"">test</area>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x ";}<" 0) 26) (not (>= (str.len x) 108)) (= "ers>/" (str.substr y 25 5))))
(assert (or (not (= (str.at z 2) ")")) (= ">" (str.substr z 0 5))))
(assert (or (str.prefixof "<output " x) (not (= " here</fi" (str.substr x 103 9))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((13[0-9])|(14[5|7])|(15([0-3]|[5-9]))|(18[0,5-9]))\d{8}$|^((13[0-9])|(14[5|7])|(15([0-3]|[5-9]))|(18[0,5-9]))\d{8}$")))))
(assert (or (= (str.at z 15) ">") (<= (str.len x) 61) (not (= (str.indexof z ">t" 0) 16))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s]{1,50})$")) (<= (str.len x) 124)))
(check-sat)
