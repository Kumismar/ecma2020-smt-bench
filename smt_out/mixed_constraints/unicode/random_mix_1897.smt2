; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tt onmouseenter=""alert(1)"">test</tt>") (= x "<body onload body onload=""javascript:javascript:alert(1)""></body onload>")))
(assert (or (= z "e>test</mete\u{10348}r>") (= z "name:x"" onanimationstart=""alert(1)""></select>") (= z "003C;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<tt onmous" y)) (= "<tt o<b>ouseenter=""alert(1)"">test</tt>" (str.replace x "nm" "<b>")) (= "onload=""" (str.substr y 18 8))))
(assert (or (= "<body on<b>d body onload=""javascript:javascript:alert(1)""></body onload>" (str.replace x "loa" "<b>")) (not (str.contains y "rt(1)"""))))
(assert (or (= (str.at y 62) "d") (= "<tt onmouseente<b>=""alert(1)"">test</tt>" (str.replace x "r" "<b>")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\d{12}$")))))
(assert (or (not (<= (str.len z) 55)) (= (str.at x 38) "a") (not (str.prefixof "<style>:t" x))))
(assert (or (str.contains x "st</t") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(19|20)\d{2}"))) (str.prefixof "003C;" z)))
(check-sat)
