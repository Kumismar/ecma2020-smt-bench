; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG SRC=\""jav&#x09;ascript&#058;alert('XSS');\""&gt;") (= x "<output id=x tabindex=1 onfocusin=alert(1)></output>")))
(assert (or (= z ";1&#x29") (= z """javascript\x00:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "nput autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 16) "i")) (>= (str.len x) 49)))
(assert (or (= (str.len x) 52) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{4,12}$"))) (not (str.contains z "jav"))))
(assert (or (not (str.contains x "ick=""ale")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((8|\+7)[\- ]?)?(\(?\d{3}\)?[\- ]?)?[\d\- ]{6,10}$"))) (= "1&#x29" (str.substr z 1 8))))
(assert (or (not (= (str.indexof x "8;a" 0) 34)) (not (= "t(E)\u{17e}/scriptu" (str.replace z "EXSS" ""))) (str.prefixof "<output" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-\u{17e}0-9-:&.'_ ]{2,}$"))) (not (= (str.at y 95) "z")) (= (str.indexof x "utput" 0) 2)))
(check-sat)
