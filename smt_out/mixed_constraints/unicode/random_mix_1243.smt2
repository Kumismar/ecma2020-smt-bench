; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ul draggable=""true"" ondrag=""alert(1)"">test</ul>") (= x "<div draggable=""true"" contenteditable>drag me</div><del ondragover=alert(1) contenteditable>drop here</del>") (= x "<input onblur=write(XSS) autofocus><input autofocus>")))
(assert (or (= z "=alert(1)></del>") (= z "1) contenteditable>drop here</thead>") (= z "l>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "rt(" 0) 39)) (str.prefixof "<" x) (str.prefixof "<BR SI" y)))
(assert (not (str.suffixof ">" x)))
(assert (or (= (str.at x 46) "l") (not (= "iv>" (str.substr y 48 3))) (str.prefixof "=" z)))
(assert (not (= "t(1)></se" (str.substr z 20 9))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) ".+[0-9]+$")) (str.suffixof "l>" z)))
(check-sat)
