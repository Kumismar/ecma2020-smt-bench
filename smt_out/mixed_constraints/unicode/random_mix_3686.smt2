; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr onbeforepaste=""alert(1)"" contenteditable>test</hr>") (= x "<dl onmouseleave=""alert(1)"">test</dl>")))
(assert (or (= z "onym>") (= z "h>//[""'`-->]]>]</div>") (= z "(1)"" contenteditable>test</dl>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z .]+"))))
(assert (not (str.prefixof "<dl" x)))
(assert (not (= (str.len z) 30)))
(assert (or (not (= (str.indexof y "ta" 0) 39)) (= (str.indexof y "<dl " 0) 0) (str.suffixof ">" z)))
(assert (or (str.suffixof "m>" y) (not (str.contains (str.replace x "te=""a" "x") "sxle")) (= "/dl>" (str.substr x 33 6))))
(assert (or (not (str.contains x "l ")) (not (= (str.at z 2) "y")) (not (= (str.at x 6) "m"))))
(assert (not (= "edita" (str.substr x 36 5))))
(check-sat)
