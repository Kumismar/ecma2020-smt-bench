; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script src=""#"">{alert(1)}</script>;1") (= x "<header id=x tabind\u{1f600}ex=1 onfocusin=alert(1)></hea\u{10348}der>") (= x "<svg><fieldset onload=alert(1)></fieldset>")))
(assert (or (= z "le>test</ol>") (= z "1)"" contenteditable>test</svg>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-z-]{3,30}\s[A-z-]{3,30}$"))))
(assert (or (str.contains y "=alert(1)") (>= (str.len y) 67) (str.contains (str.replace x "a\u{10348}der" " ") "he >")))
(assert (or (not (str.suffixof ">" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{430}-\u{44f}\u{410}-\u{42f}\s]{1,30}$")))))
(assert (not (= (str.at z 25) "/")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_\.\-]+?@[A-Za-z0-9_\.\-]+$")))
(assert (or (not (>= (str.len x) 32)) (= (str.indexof x "1" 0) 28)))
(assert (not (= (str.len x) 42)))
(check-sat)
