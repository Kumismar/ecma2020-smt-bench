; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp id=x tabindex=1 onfocus=alert(1)></samp>") (= x "<frameset><frame id=x onfocusin=alert(1)>") (= x """'`><p><svg><script>a='hello\x27;javascript:alert(1)//';</script></p>")))
(assert (or (= z "\x85javascript:alert(1)</script>") (= z "nd=""alert(1)"">test</data>") (= z "ontenteditable>test</var>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof ">" x)))
(assert (str.prefixof "\x85j" z))
(assert (str.prefixof "cmlwdD4" z))
(assert (or (not (= "ript" (str.substr z 10 4))) (= (str.indexof z "st<" 0) 16) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{5}([\-]\d{4})?$")))))
(assert (or (not (= "focu" (str.substr x 24 4))) (str.in_re z ((_ re.from_regex ecma2020 u) "([0-9]{3}([-][0-9]{3}) ([-][0-9]{3}) ([-][0-9]{1})$)"))))
(check-sat)
