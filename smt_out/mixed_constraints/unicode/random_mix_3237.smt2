; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<acronym draggable=""true"" ondragstart=""alert(1)"">test</acronym>") (= x "<article id=x tabindex=1 ondeactivate=alert(1)></article><input id=y autofocus>") (= x "<svg xmlns=""http://www.w3.org/2000/svg"" onload=""alert(document.domain)""/>")))
(assert (or (= z "e>test</script>") (= z ">test</sup>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "aler" 0) 15)) (not (str.suffixof ";" z)) (= ">test</s" (str.substr z 0 8))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\+)?([- \(\)]*[0-9]){5,}[- \(\)]*$"))) (str.suffixof "/script>" y)))
(assert (= (str.at x 16) ":"))
(assert (or (not (= (str.at z 8) "s")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z A-Z0-9\\_\\\\.\\""]{1,30}$")))))
(check-sat)
