; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "echo('IPT&gt;alert(\""XSS\"")&lt;/SCRIPT&gt;'); ?&gt;") (= x "<nextid ondblclick=""alert(1)"">test</nextid>") (= x "<style>@keyframes x{}</style><keygen style=""animation-name:x"" onanimationstart=""alert(1)""></keygen>")))
(assert (or (= z "2s"" ontransitionrun=alert(1)></command>") (= z "font>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x " ond" 0) 7) (str.contains z "nrun=alert")))
(assert (or (not (str.suffixof "IPT>" z)) (= (str.len x) 51) (str.prefixof "fon" z)))
(assert (not (= "</nextid>2" (str.substr y 34 10))))
(assert (or (not (<= (str.len z) 41)) (not (= (str.at x 15) "i"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z]+.*\S.*")) (= (str.indexof z "font>" 0) 0) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{30a1}-\u{30f3}\u{30f4}\u{30fc}\u{ff0d}\-\u{ff10}-\u{ff19}0-9|\u{3000}| ]+$")))))
(assert (not (str.prefixof "2s"" on" z)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[^\._%+-][a-zA-Z0-9._%+-]+[^\._%+-]@[^\._%+-]([a-zA-Z0-9]([.-]?))+[^\._%+-]\.[a-zA-Z]{2,4}$")))
(assert (or (= "IPT&" (str.substr y 6 4)) (not (str.suffixof "and>" y))))
(check-sat)
