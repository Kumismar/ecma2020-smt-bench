; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend id=x tabindex=1 onbeforedeactivate=alert(1)></legend><input autofocus>") (= x "<style></style\x0A<img src=""about:blank"" onerror=javascript:alert(1)//></style>") (= x "<div draggable=""true"" contenteditable>drag me</div><dir ondrop=alert(1) contenteditable>drop here</dir>")))
(assert (or (= z "cript>") (= z "shadow onmouseover=""alert(1)"">test</shadow>") (= z "ames>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "(^[0-9a-zA-Z_\.-]{1,}@([0-9a-zA-Z_\-]{1,}\.)+[0-9a-zA-Z_\-]{2,}$)")) (str.contains (str.replace z "t" "alert(1)") "cripalert(1)>") (= (str.indexof z "a" 0) 2)))
(assert (or (= "e</div><d" (str.substr x 44 9)) (str.contains z "ript>")))
(assert (or (str.prefixof "<" x) (= (str.at y 48) "e")))
(assert (not (= "aggab" (str.substr x 7 5))))
(check-sat)
