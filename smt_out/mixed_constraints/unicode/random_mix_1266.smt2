; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select onchange=alert(1)><option>change me</option><option>XSS</option></select>") (= x "<img src=1 href=1 onerror=""javascript:alert(1)""></img>")))
(assert (or (= z "cle>") (= z "t(1)"" contenteditable>test</var>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<dt o" y)) (not (= "error=""ja" (str.substr x 20 9)))))
(assert (or (not (str.prefixof "<" x)) (not (str.suffixof "/var>" y)) (not (str.contains (str.replace x "ec" "") "selt o"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^(chr)?(\d{1,2}|(x|y|X|Y)):\d+$)"))))
(assert (= (str.len y) 86))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9 ]){4,4}$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.+@.+$"))) (= "rc=" (str.substr x 6 3))))
(assert (or (str.prefixof "<img src=" y) (not (str.contains y ">t(1)"" co"))))
(check-sat)
