; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;A HREF=&quot;http://google.com/&quot;&gt;XSS&lt;/A&gt;") (= x "<a style=""-o-link:'javascript:javascript:alert(1)';-o-link-source:current"">X")))
(assert (or (= z "alert(2)//'>") (= z "%253ealert(1)%253c/script%253e") (= z "/pre>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "EF" (str.substr x 8 2))) (not (= (str.indexof x "&" 0) 0))))
(assert (str.prefixof "&l" x))
(assert (not (str.prefixof "<a" x)))
(assert (or (not (str.prefixof "%253ealert" z)) (str.contains z "rt(2")))
(assert (not (= (str.indexof x " s" 0) 2)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\S.*$"))) (str.contains (str.replace x "&q" "javascript:") "=javascript:uot;") (<= (str.len x) 58)))
(assert (= ";http://g" (str.substr x 16 9)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9\u{a0}]+")) (<= (str.len y) 93) (not (str.contains y "m/&quot;&"))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[A-Za-z]).{6,}")))
(check-sat)
