; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onPageHide body onPageHide=""javascript:javascript:alert(1)""></body onPageHide>") (= x "<strike oncopy=""alert(1)"" contenteditable>test</strike>")))
(assert (or (= z "tenteditable>drag me</div><section ondrop=alert(1) contente\u{1f4a9}ditable>drop here</section>") (= z "t(1)"">test</progress>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y """" """") "y=""al") (not (str.prefixof "<body " x))))
(assert (or (not (= (str.at z 18) "m")) (not (str.suffixof "t>;" z)) (not (str.suffixof "t</strike>" x))))
(assert (or (= "n" (str.substr y 117 1)) (= (str.len y) 171)))
(assert (<= (str.len x) 58))
(assert (or (not (<= (str.len x) 63)) (not (str.contains (str.replace y ">ten" "") "ete"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[ABCEGHJKLMNPRSTVXY]\d[ABCEGHJKLMNPRSTVWXYZ]( )?\d[ABCEGHJKLMNPRSTVWXYZ]\d$"))))
(assert (or (= ">]]>]</" (str.substr z 2 7)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-Za-z]+[,.]?[ ]?|[A-Za-z]+['-]?)+$")))))
(check-sat)
