; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onblur body onblur=""javascript:javascript:alert(1)""></body onblur>") (= x "<hgroup id=x tabindex=1 onactivate=alert(1)></hgroup>")))
(assert (or (= z " contenteditable>test</xmp>") (= z "lert(1)"" contenteditable>test</fieldset>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "u" 0) 8)))
(assert (not (= (str.at y 30) "e")))
(assert (= (str.len z) 40))
(assert (or (str.contains (str.replace x " tabi" "alert(1)") "=xalert(1)nde") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.{4,}$"))) (not (= (str.at z 35) "d"))))
(assert (or (not (= "in" (str.substr z 2 2))) (str.contains z "t<")))
(check-sat)
