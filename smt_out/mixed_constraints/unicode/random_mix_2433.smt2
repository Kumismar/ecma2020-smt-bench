; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select draggable=""true"" ondragenter=""alert(1)"">test</select>") (= x "<marquee onstart=alert(1)>") (= x "<title onclick=""alert(1)"">test</title>")))
(assert (or (= z "or=alert(1)>") (= z "enu=""alert(1)"">test</datalist>")))
(assert (= y (str.++ x z)))
(assert (or (= "alert(1)" (str.substr x 15 8)) (not (= (str.indexof y "l" 0) 4))))
(assert (not (= (str.at z 25) "l")))
(assert (or (not (= (str.len y) 68)) (not (= (str.len y) 38)) (= (str.at z 0) "o")))
(assert (or (not (str.contains x "ted")) (str.contains (str.replace y "rue"" " """") "e=""t""ond") (not (str.contains z "est</d"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\D?(\d{2})\D?\D?(\d{5})\D?(\d{4})$"))) (= (str.indexof x "</sel" 0) 52)))
(assert (or (not (= "or t(1)>" (str.replace z "=aler" " "))) (<= (str.len z) 20)))
(check-sat)
