; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote id=x tabindex=1 onbeforedeactivate=alert(1)></blockquote><input autofocus>") (= x "<img src=""/"" =_="" title=""onerror='prompt(1)'"">")))
(assert (or (= z "emove=""alert(1)"">test</marquee>") (= z "SS';))"";>;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9!-/:-@\u{a5}[-`{-~]+$"))) (str.suffixof "output>" z)))
(assert (or (not (str.prefixof "<blockqu" x)) (not (= ";>;" (str.substr z 7 4))) (str.contains y "itle")))
(assert (str.contains y "lockqu"))
(assert (or (= "<blockquote id=x tabindex=1 onbeforedeactiva alert(1)></blockquote><input autofocus>" (str.replace x "te=" " ")) (not (str.prefixof "emove=" z))))
(check-sat)
