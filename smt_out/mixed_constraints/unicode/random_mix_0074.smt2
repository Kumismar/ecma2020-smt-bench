; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img onkeydown=""alert(1)"" contenteditable>test</img>") (= x "<option draggable=""true"" ondragenter=""alert(1)"">test</option>")))
(assert (or (= z "le>drag me</div><td ondragover=alert(1) contenteditable>drop here</td>") (= z "1)"">test</html>") (= z "alert(1)></aside>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "side" 0) 2)))
(assert (or (str.prefixof "a" z) (str.prefixof "le>drag m" z) (= (str.at y 8) "=")))
(assert (or (not (= (str.indexof x "bb" 0) 2)) (not (= "<img onkjavascript:n=""alert(1)"" contenteditable>test</img>" (str.replace x "eydow" "javascript:"))) (not (>= (str.len y) 114))))
(assert (= (str.at z 8) "<"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((0[13578]|1[02])[\/.]31[\/.](19|20)[0-9]{2})|((01|0[3-9]|1[0-2])[\/.](29|30)[\/.](19|20)[0-9]{2})|((0[1-9]|1[0-2])[\/.](0[1-9]|1[0-9]|2[0-8])[\/.](19|20)[0-9]{2})|((02)[\/.]29[\/.](((19|20)(04|08|[2468][048]|[13579][26]))|2000))*$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^*?].*$"))) (= "rt(1)" (str.substr z 3 5))))
(assert (or (not (= (str.len y) 122)) (not (<= (str.len x) 62))))
(assert (or (not (= "tent" (str.substr x 29 4))) (str.contains y "test</l")))
(check-sat)
