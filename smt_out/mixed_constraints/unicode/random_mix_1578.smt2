; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<code oncut=""alert(1)"" contenteditable>test</code>") (= x """;>;<;BODY onload!#$%&;()*~+-_.,:;?@[/|\]^`=alert("";XSS"";)>;") (= x "<script onmouseleave=""alert(1)"">test</script>")))
(assert (or (= z " ontimeupdate=alert(1)><source src=""validaudio.wav"" type=""audio/wav""></audio>") (= z "/tfoot>") (= z "dex=1 id=x></cite><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 0) "/")) (not (= "javascript:x=1 id=x></cite><input autofocus>" (str.replace z "de" "javascript:")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z0-9_-]{3,15}$"))))
(assert (or (>= (str.len z) 2) (not (str.contains y "oreco"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9 ]{1,13}"))) (not (= (str.len z) 57)) (not (= "dex=1 id=x></citjavascript:input autofocus>" (str.replace z "e><" "javascript:")))))
(assert (not (str.prefixof "<c" x)))
(assert (or (not (= (str.at x 52) "X")) (str.prefixof "dex" z)))
(assert (or (not (= "t" (str.substr y 50 1))) (not (= (str.at z 3) "o"))))
(assert (or (not (= "/tx" (str.replace z "foot>" "x"))) (not (str.contains x "ve="""))))
(check-sat)
