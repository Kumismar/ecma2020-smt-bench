; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG LOWSRC=\""javascript:alert('XSS')\"">") (= x "<body onBeforeUnload body onBeforeUnload=""javascript:javascript:alert(1)""></body onBeforeUnload>")))
(assert (or (= z "lect>") (= z "t(1)"" contenteditable>test</form>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) ".{1,85}")) (str.prefixof "t(1)"" " z)))
(assert (or (= (str.indexof y "o" 0) 2) (not (= (str.at x 22) "p")) (not (= (str.at x 15) "r"))))
(assert (or (not (str.contains z "ditable>te")) (not (>= (str.len y) 67))))
(assert (or (not (str.contains z "lect")) (= "lec<b>>" (str.replace z "t" "<b>")) (not (= "<body onBeforeUnloalert(1)d body onBeforeUnload=""javascript:javascript:alert(1)""></body onBeforeUnload>t(1)"" contenteditable>test</form>" (str.replace y "a" "alert(1)")))))
(assert (or (not (str.prefixof "<" x)) (not (= "<body onBeforeUnload body onBeforeUnload=""javasc<b>pt:javascript:alert(1)""></body onBeforeUnload>t(1)"" contenteditable>test</form>" (str.replace y "ri" "<b>")))))
(assert (not (str.suffixof "ct>" y)))
(check-sat)
