; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""113""><div id=""x"">XXX</div>") (= x "<colgroup onclick=""alert(1)"">test</colgroup>") (= x "<\u{10348}ol id=x tabindex=1 ondeactivate=alert(1)></ol>\u{1f4a9}<input id=y autofocus>")))
(assert (or (= z "HTML&gt;&lt;BODY&gt;") (= z "ert(1)"">test</blockquote>") (= z "ivate=alert(1)></plaintext>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "t;&lt;B")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?:(\(?(0|\+44)[1-9]{1}\d{2,4}?\)?\s?\d{3,4}\s?\d{3,4}))?$"))) (not (= "</IFRAM" (str.substr y 57 7))) (not (str.prefixof "<div i" y))))
(assert (>= (str.len y) 64))
(assert (or (= (str.indexof y "c" 0) 1) (= (str.at y 2) "i") (= (str.indexof x "<\u{10348}ol" 0) 0)))
(assert (or (not (= (str.at y 9) "1")) (not (str.prefixof "HT" z))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?!^\s+$)[A-z\u{c0}-\u{17e}0-9()\s\-\.]{1,30}"))) (not (= (str.indexof y "y a" 0) 59))))
(assert (<= (str.len z) 28))
(assert (not (str.prefixof "i" z)))
(check-sat)
