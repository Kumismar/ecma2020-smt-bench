; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><h1><iframe width=""420"" height=""315"" src=""http://www.youtube.com/embed/sxvccpasgTE"" frameborder=""0"" allowfullscreen></iframe>123</h1>") (= x "<tfoot onmouseover=""alert(1)"">test</tfoot>") (= x "ABC<div style=""x:\xEF\xBB\xBFexpress\u{1f600}ion(javascript:alert(1)"">DEF")))
(assert (or (= z "onmouseleave=""alert(1)"">test</datalist>") (= z "area oncut=""alert(1)"" contenteditable>test</area>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z]+[\w\.-]+@[\w\.-]+\.\w{2,}$"))) (not (str.suffixof ">" z))))
(assert (or (= (str.indexof x "llsc" 0) 109) (str.prefixof "<" x) (= (str.len z) 39)))
(assert (str.contains (str.replace x "e" """") "yl""="""))
(assert (<= (str.len y) 97))
(assert (or (str.contains y "cut=""aler") (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z\u{e7}\u{c7}\u{e3}\u{f5}\u{f3}\u{e1}\u{e9}\u{ed}\u{e2}\u{f4}\u{ea}\s]+$"))) (= (str.at z 23) ">")))
(assert (= (str.at x 18) "e"))
(check-sat)
