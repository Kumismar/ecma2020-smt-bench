; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{10348}element ondblclick=""alert(1)"">test</element>") (= x "<script>alert(1)</script>") (= x "<svg><a xmlns:xlink=http://www.w3.org/1999/xlink xlink:href=?><circle r=400 /><animate attributeName=xlink:href begin=0 from=javascript:alert(1) to=&>")))
(assert (or (= z " autofocus>") (= z "ouseover=""alert(1)"">test\u{20000}</abbr>") (= z "y draggable=""true"" ondragstart=""alert(1)"">test</body>")))
(assert (= y (str.++ x z)))
(assert (or (= "\u{20000}" (str.substr y 70 1)) (= (str.len z) 53) (= (str.indexof x "rt('X" 0) 7)))
(assert (or (not (= "focu" (str.substr z 5 4))) (= (str.at z 6) "e") (not (= "embed>" (str.substr x 57 6)))))
(assert (not (= (str.indexof y "m" 0) 5)))
(assert (or (not (str.contains (str.replace x "nt o" "javascript:") "elemejavascript:ndblc")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((8|\+3)[\- ]?)?(\(?\d{6}\)?[\- ]?)?[\d\- ]{6,10}$"))) (= (str.at z 16) "1")))
(assert (= (str.indexof x "<a " 0) 5))
(check-sat)
