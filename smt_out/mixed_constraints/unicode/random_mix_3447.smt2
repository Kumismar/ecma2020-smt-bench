; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=javascript:alert(String.fromCharCode(88,83,83))>") (= x "<center id=x tabindex=1 ondeactivate=alert(1)></center\u{1f600}><input id=y au\u{1f4a9}tofocus>") (= x "<aside onblur=alert(1) tabindex=1 id=x></aside><input autofocus>")))
(assert (or (= z "e=""true"" ondrag=""alert(1)"">test</sup>") (= z "teditable>test</q>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 13) "t") (= (str.len y) 97)))
(assert (not (str.contains (str.replace z "a" "x") "itxble>")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[$@!%*#?&^()]).{6,20}")) (str.contains (str.replace x "=""ale" "") "pastert(")))
(assert (or (not (= " ondrag" (str.substr y 65 7))) (not (str.contains (str.replace z "=""ale" "x") "ndragxr")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{2}.[0-9]{3}.[0-9]{3}/[0-9]{4}-[0-9]{2}|[0-9]{2}[0-9]{3}[0-9]{3}[0-9]{4}[0-9]{2}$"))))
(assert (or (= (str.indexof y "cus>" 0) 60) (not (>= (str.len z) 59))))
(check-sat)
