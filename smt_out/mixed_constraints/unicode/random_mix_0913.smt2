; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onbe\u{10348}forepaste=""alert(\u{1f600}1)"" contenteditable>test</rtc>") (= x "<content onkeydown=""alert(1)"" contenteditable>test</content>") (= x "<body onmousemove=""alert(1)"">test</body>")))
(assert (or (= z "script:alert('XSS')>") (= z "le=""true"" ondragend=""alert(1)"">test</big>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 83) "t") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?!0\.00)[1-9]\d{0,7}(,\d{3})*(\.\d{0,4})?$")))))
(assert (or (= (str.indexof y "bo" 0) 1) (str.contains x "</h") (= (str.at x 18) """")))
(assert (or (not (str.contains (str.replace x "e\u{10348}for" "<b>") "onb<b>epast")) (str.suffixof "83))"">" y) (str.contains z "ert('X")))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}A-Za-z0-9\s]+$")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z-.\u{f3}]|[\u{e0}-\u{fa}]|[\u{c0}-\u{da}]|[-z0-9-\s])+$"))) (<= (str.len z) 22)))
(assert (or (not (str.suffixof "t('XSS')>" y)) (not (= "<body onmousemove=alert(1)lert(1)"">test</body>" (str.replace x """a" "alert(1)")))))
(check-sat)
