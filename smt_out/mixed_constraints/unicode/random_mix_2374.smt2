; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext onmouseenter=""alert(1)"">test</plaintext>") (= x "<svg><tr onload=alert(1)></tr>")))
(assert (or (= z "mouseleave=""a\u{1f600}lert(1)"">test</iframe>") (= z "t</tfoot>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "oot>") (str.suffixof "/tfoot>" z) (not (str.contains x "nload=ale"))))
(assert (or (= (str.indexof z "=""" 0) 10) (= (str.at z 1) "<")))
(assert (or (= ")></tr>mou" (str.substr y 23 10)) (= (str.indexof x "<svg" 0) 0)))
(assert (str.contains (str.replace x """>t" "alert(1)") "rt(1)alert(1)est"))
(assert (= (str.len x) 51))
(assert (or (not (str.suffixof "foot>" z)) (not (str.prefixof "mouse" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{4}$")))))
(assert (not (str.suffixof "t</tfoot>" y)))
(check-sat)
