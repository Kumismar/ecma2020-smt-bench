; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead id=x tabindex=1 onactivate=alert(1)></thead>") (= x "<svg><table onload=alert(1)></table>")))
(assert (or (= z "<rtc draggable=""true"" ondragstart=""alert(1)"">test</rtc>") (= z "crscriptipt>") (= z "ary ondblclick=""alert(1)"">test</summary>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^1[3|4|5|8][0-9]\d{8}$"))) (= "ary ondblcx""alert(1)"">test</summary>" (str.replace z "lick=" "x"))))
(assert (or (not (= (str.at x 25) "1")) (str.contains (str.replace y "r" "") "alet(1")))
(assert (not (= "<caption onmouseleave=""alert(1 >test</caption>" (str.replace x ")""" " "))))
(assert (or (= (str.indexof z "rsc" 0) 1) (= (str.at x 28) "<") (str.suffixof "io>" x)))
(assert (not (str.prefixof "crscriptip" z)))
(assert (= "t(1)"">tes" (str.substr z 20 9)))
(check-sat)
