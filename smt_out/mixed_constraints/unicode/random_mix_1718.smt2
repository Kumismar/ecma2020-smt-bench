; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<DIV STYLE=""width:expression(javascript:alert(1));"">") (= x "<hr onkeyup=""alert(1)"" contenteditabl\u{10348}e>test</hr>")))
(assert (or (= z ">test</section>") (= z "(1)></footer>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "ter>" y)) (= (str.at z 1) "1")))
(assert (not (str.prefixof "<" y)))
(assert (str.suffixof "tion>" z))
(assert (or (>= (str.len z) 12) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{5,11}"))) (str.contains y "editable>t")))
(assert (or (not (= (str.indexof y "avas" 0) 30)) (not (str.contains z "se")) (str.in_re y ((_ re.from_regex ecma2020 u) "^.{0,65}$"))))
(assert (str.contains (str.replace x "E=""" "") "Lw"))
(check-sat)
