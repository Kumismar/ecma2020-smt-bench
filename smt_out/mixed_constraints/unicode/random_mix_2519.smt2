; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><noembed ondrop=alert(1) contenteditable>drop here</noembed>") (= x "<nav oncontextmenu=""alert(1)"">\u{1d400}test\u{1f4a9}</nav>") (= x "<SCRIPT SRC=%(jscript)s?<B>")))
(assert (or (= z "mark>") (= z " tabindex=1 ondeactivate=alert(1)></rp><input id=y autofocus>") (= z "t</font>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<SCRI" x)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "(?!(^[.-].*|[^@]*[.-]@|.*\.{2,}.*)|^.{254}.)([a-zA-Z0-9_.-]+@)(?!-.*|.*-\.)([a-zA-Z0-9-]{1,63}\.)+[a-zA-Z]{2,15}")) (not (= (str.indexof y "al" 0) 20))))
(assert (or (not (= "B>" (str.substr y 25 2))) (= (str.indexof y "t</" 0) 27) (not (str.contains x "edit"))))
(assert (= "T SRC" (str.substr x 6 5)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@(?!gmail.com)(?!yahoo.com)(?!hotmail.com)(?!hotmail.co.il)(?!walla.co.il)(?!mail.ru)(?!outlook.com)(?!email.com)[a-z0-9.-]+\.[a-z]{2,}$"))))
(assert (not (str.suffixof "/noembed>" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{3,5}$"))) (not (str.contains y "t\u{1f4a9}<")) (= "<div draggable=""true"" contenteditable>drag me</div><noembed ondrop=alert(1) contenteditable>drop here</noembed>t</fon<b>" (str.replace y "t>" "<b>"))))
(assert (or (str.prefixof """alert(1)""" z) (= (str.at z 52) "u")))
(check-sat)
