; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><time id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></time>") (= x "<bgsound id=x tabindex=1 onbeforedeactivate=alert(1)></bgsound><input autofocus>")))
(assert (or (= z "ecopy=""alert(1)"" contenteditable>test</tbody>") (= z "ir>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "eco" z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{1}[0-9]{10,10}"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z]{1}[a-zA-Z0-9\._#\-]{0,100}@([a-zA-Z0-9\-_\.]){1,100}\.[a-zA-Z]{2,}){1}$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([- \w\d\u{5c}u00c0-\u{5c}u024f]+)$"))) (not (str.prefixof "ecop" z))))
(assert (or (= "cance" (str.substr x 88 5)) (not (= (str.indexof x ">te" 0) 43))))
(assert (or (str.suffixof "/time>ir>" y) (= "<tyle>:target {color: red;}</style><time id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></time>" (str.replace x "s" ""))))
(check-sat)
