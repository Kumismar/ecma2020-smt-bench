; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style onload=alert(1)></style>") (= x "<style>@keyframes x{}</style><col style=""animation-name:x"" onanimationend=""alert(1)""></col>")))
(assert (or (= z "lert(1)"" contenteditable>test</blink>") (= z "e>test</rtc>") (= z " ondragend=""alert(1)"">test</abbr>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof """" y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?<!\w)(\(?(\+|00)?48\)?)?[ -]?\d{3}[ -]?\d{3}[ -]?\d{3}(?!\w)")))))
(assert (not (= (str.at z 7) "e")))
(assert (or (not (str.contains (str.replace y "aler" "") "oad=t(1")) (str.in_re y ((_ re.from_regex ecma2020 u) "^([- \w\d\u{5c}u00c0-\u{5c}u024f]+)$")) (not (str.contains z "abb"))))
(assert (or (not (str.prefixof """`'><" x)) (not (= (str.indexof x "on" 0) 7))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([A-z\u{119}\u{f3}\u{105}\u{15b}\u{142}\u{17c}\u{17a}\u{107}\u{144}\u{118}\u{d3}\u{104}\u{15a}\u{141}\u{17b}\u{179}\u{106}\u{143} /,.]){2,}$"))) (not (str.suffixof "t</blink>" y))))
(check-sat)
