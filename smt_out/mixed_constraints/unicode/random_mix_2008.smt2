; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<%<!--'%><script>alert(1);</script -->") (= x """><img src=x onerror=javascript:alert(('A'))>")))
(assert (or (= z "tml ontouchcancel=alert(1)>") (= z "ut=""alert(1)"" contenteditable>test</font>") (= z "lert(1)"" contenteditable>test</bdi>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "t(1);" 0) 21)))
(assert (or (str.contains (str.replace x "src=x" "javascript:") "g javascript: o") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^()?[0-9\- ]{10}[0-9\- ]*$"))) (not (= (str.at y 49) "n"))))
(assert (or (= (str.at x 23) "v") (>= (str.len x) 35) (not (= (str.indexof z "el=" 0) 15))))
(assert (not (str.suffixof "</content>" y)))
(check-sat)
