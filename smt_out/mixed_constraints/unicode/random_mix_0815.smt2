; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<big id=x tabindex=1 ondeactivate=alert(1)></big><input id=y autofocus>") (= x "<script>({0:#0=alert/#0#/#0#(0)})</script>")))
(assert (or (= z "enteditable>test</b>") (= z """animation-name:x"" onanimationstart=""alert(1)""></title>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "e=""tr" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^yes$"))) (not (= (str.indexof z "ntra" 0) 38))))
(assert (or (<= (str.len x) 76) (str.suffixof ">" y) (= (str.at y 27) "t")))
(assert (or (>= (str.len y) 87) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\S[\w \u{df}\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}]*"))) (str.contains z "n-")))
(assert (or (not (= "(1)></" (str.substr x 39 6))) (str.contains x "aler")))
(check-sat)
