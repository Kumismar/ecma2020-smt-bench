; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr draggable=""true"" ondragstart=""alert(1)"">test</abbr>") (= x "<figure draggable=""true"" ondragenter=""alert(1)"">test</figure>")))
(assert (or (= z "usedown=""alert(1)"">test</th>") (= z "le>test</body>") (= z "cript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 18) "l")))
(assert (or (str.contains z ")"">tes") (= """>tes" (str.substr z 17 5))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "first-name-validator"))) (not (= "<abbr draggable=""tru"" ondragstart=""alert(1)"">test</abbr>" (str.replace x "e""" """")))))
(assert (not (= (str.indexof z "use" 0) 0)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z\u{154}\u{c1}\u{c2}\u{102}\u{c4}\u{139}\u{106}\u{c7}\u{10c}\u{c9}\u{118}\u{cb}\u{11a}\u{cd}\u{ce}\u{10e}\u{110}\u{143}\u{147}\u{d3}\u{d4}\u{150}\u{d6}\u{158}\u{16e}\u{da}\u{170}\u{dc}\u{dd}\u{162}\u{df}\u{155}\u{e1}\u{e2}\u{103}\u{e4}\u{13a}\u{107}\u{e7}\u{10d}\u{e9}\u{119}\u{eb}\u{11b}\u{ed}\u{ee}\u{10f}\u{111}\u{144}\u{148}\u{f3}\u{f4}\u{151}\u{f6}\u{159}\u{16f}\u{fa}\u{171}\u{fc}\u{fd}\u{163}\u{2d9} \t\r\n\f]*$"))) (not (str.contains y "tart=""aler")) (str.suffixof "e>" x)))
(assert (or (str.suffixof "ody>" y) (not (= (str.indexof z " " 0) 18))))
(check-sat)
