; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onmouseover=""alert(1)"">test</cite>") (= x "<b id=x tabindex=1 onactivate=alert(1)></b>") (= x "<script>alert(1)<!\u{2013}")))
(assert (or (= z "dir onmousedown=""alert(1)"">test</dir>") (= z "ate=alert(1)></details><input id=y autofocus>") (= z "ntenteditable>test</aside>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<script>alert(1)<!\u{2013}dir onmousedown=""alerjavascript:>test</dir>" (str.replace y "t(1)""" "javascript:"))) (not (= "est</cite>" (str.substr y 30 10))) (not (= "x tabindex" (str.substr y 6 10)))))
(assert (or (not (str.contains y "tenteditab")) (= "activate=a" (str.substr x 21 10)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{8}$|^[0-9]{10}$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.*(?<!gmail\.com|yahoo\.com|me\.com|hotmail\.com|outlook\.com|nodeficit\.org)$"))))
(assert (or (not (str.suffixof ">" y)) (= "<body \u{1f600}on<b>eunload body onbeforeunload=""javascript:j\u{1f4a9}avascript:alert(1)""></body onbeforeunload>" (str.replace x "befor" "<b>"))))
(assert (or (str.prefixof "<b id" x) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+\/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+){1,}$")) (not (str.contains (str.replace z "uto" " ") " a f"))))
(assert (not (= (str.indexof x "binde" 0) 10)))
(check-sat)
