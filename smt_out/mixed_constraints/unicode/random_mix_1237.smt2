; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup draggable=""true"" ondragenter=""alert(1)"">test</colgroup>") (= x "<th onmou\u{1f600}seover=""alert(1)"">test</th>")))
(assert (or (= z "</bgsound><input autofocus>") (= z "ascript&colon;\u{5c}u0061&#x6C;&#101%72t&lpar;1&rpar;""><button>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "ale" 0) 40) (= ">" (str.substr x 64 2)) (= (str.indexof y "6C;" 0) 60)))
(assert (not (str.contains (str.replace x "er=" "<b>") "seov<b>""")))
(assert (str.prefixof "<th onm" x))
(assert (or (not (= (str.at x 26) " ")) (not (<= (str.len y) 105))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "\w{4,16}"))) (not (str.prefixof "ascrip" z))))
(assert (= (str.at z 10) "l"))
(assert (or (not (str.suffixof "n>" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$"))) (= "<audio onpaste=""alert(1)"" contenteditable><b></audio>" (str.replace x "test" "<b>"))))
(assert (not (= "<c lgroup draggable=""true"" ondragenter=""alert(1)"">test</colgroup></bgsound><input autofocus>" (str.replace y "o" " "))))
(check-sat)
