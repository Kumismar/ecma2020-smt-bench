; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sub draggable=""true"" ondragleave=""alert(1)"">test</sub>") (= x "<style>:target {transform: rotate(180deg);}</style><picture id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></picture>") (= x "<em o\u{1d400}nmouseleave=""alert(1)"">test</\u{20000}em>")))
(assert (or (= z "ue"" ondragleave=""alert(1)"">test</style>") (= z "alert(1)"">test</ol>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^(\d{3}-\d{7}-\d{7})$")) (not (= "alert(1)"">tjavascript:</ol>" (str.replace z "est" "javascript:")))))
(assert (str.suffixof "xmp>" y))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{5}([\-]\d{4})?$"))) (str.suffixof "st</ol>" y) (not (>= (str.len x) 128))))
(assert (or (= """>test</o" (str.substr z 8 9)) (not (str.contains y "tur")) (>= (str.len y) 70)))
(assert (or (not (= (str.at x 30) "s")) (= (str.at y 160) "e") (not (str.prefixof "ue"" " z))))
(assert (or (>= (str.len x) 45) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=(([0-9]+[^0-9]+)|([a-zA-Z]+[^a-zA-Z]+)|([@._\-]+[^@._\-]+)))[a-zA-Z0-9.@_\-]{8,50}|[0-9]{8}|[0-9]{10}")))))
(assert (= (str.at z 14) "<"))
(check-sat)
