; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp onbeforepaste=""alert(1)"" contenteditable>test</xmp>") (= x "<svg><br onload=alert(1)></br>") (= x "<header onbeforepaste=""alert(1)"" contenteditable>test</header>")))
(assert (or (= z "n \u{1d400}ondblclick=""alert(1)"">test</option>") (= z "ndex=1 id=x></br><input autofocus>") (= z "ip\u{10348}t onmousedo\u{1d400}wn=""alert(1)"">test</noscript>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "he" (str.substr y 1 2))) (str.suffixof "cript>" y) (not (= "wn=""a" (str.substr x 11 5)))))
(assert (<= (str.len z) 44))
(assert (or (not (str.contains y "1)"">")) (str.contains x "ten")))
(assert (or (= (str.indexof x "/h" 0) 54) (= "<header onbeforepaste=""alert(1)"" contenteditle>test</header>" (str.replace x "ab" ""))))
(assert (not (= (str.at z 15) "a")))
(assert (= (str.indexof y ">" 0) 48))
(assert (= "er" (str.substr x 20 2)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((?!test@altoromutual.com).)*$"))))
(check-sat)
