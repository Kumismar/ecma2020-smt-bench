; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b\u{1d400}do draggable=""true"" ond\u{1f4a9}ragleave=""alert(1)"">test</bdo>") (= x "<html xmlns=""http://www.w3.org/\u{1f4a9}1999/xhtml"">")))
(assert (or (= z "est</output>") (= z "alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "dysta" 0) 13) (not (str.contains x "lns=""h"))))
(assert (not (str.prefixof "est</out" z)))
(assert (or (str.contains (str.replace y "opy=""" "alert(1)") "forecalert(1)ale") (= (str.indexof x "1)"">" 0) 43) (not (>= (str.len z) 29))))
(assert (<= (str.len x) 60))
(assert (or (not (>= (str.len z) 7)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{4}-\d{2}$")))))
(check-sat)
