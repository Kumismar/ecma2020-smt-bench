; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex id=x tabindex=1 onfocusin=alert(1)></isindex>") (= x "<i onmouseover=""alert(1)"">test</i>")))
(assert (or (= z "=""video/mp4""></video>") (= z "gable=""true"" ondragend=""alert(1)"">test</svg>")))
(assert (= y (str.++ x z)))
(assert (= "t(1)"">tes" (str.substr x 20 9)))
(assert (or (str.suffixof ">" x) (str.in_re y ((_ re.from_regex ecma2020 u) "^[- _A-z0-9\u{c0}-\u{ff}]{2,}$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9a-z][a-z0-9\._-]{1,}@[a-z0-9-]{1,}[a-z0-9]\.[a-z\.]{1,}[a-z]$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[7|8|9]\d{9}$"))) (not (str.suffixof "></video>" y))))
(assert (or (not (str.suffixof """&gt;" z)) (not (str.prefixof "<is" x)) (= (str.indexof x "d" 0) 38)))
(assert (or (not (= "onmous" (str.substr x 3 6))) (= "/svg>" (str.substr y 73 6))))
(assert (or (str.contains y "t<") (<= (str.len y) 55) (>= (str.len z) 19)))
(assert (not (= (str.at x 11) "v")))
(check-sat)
