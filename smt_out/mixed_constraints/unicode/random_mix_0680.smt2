; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """></iframe><script>alert(123)</script>") (= x "<script src=""#"">{alert(1)}</script>;1") (= x "<fieldset id=x tabindex=1 onbeforeactivate=alert(1)></fieldset>")))
(assert (or (= z "alert(1)></pre>") (= z "ipt:javascript:alert(1)""></iframe onbeforeload>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace y "s" " ") ">< crip"))
(assert (not (= (str.indexof y "src=/" 0) 67)))
(assert (or (not (= (str.at x 10) "c")) (not (str.contains x ">{aler"))))
(assert (= (str.at x 44) "l"))
(assert (or (str.contains z "(1)") (str.in_re x ((_ re.from_regex ecma2020 u) "[\u{410}-\u{42f}\u{430}-\u{44f}A-Za-z]{2,8}")) (<= (str.len z) 11)))
(assert (not (str.contains (str.replace z "ert(" """") "l""1")))
(check-sat)
