(declare-const z String)
(assert (or (= x "<bgsound src=""javascript:document.vulnera\u{10348}ble=true\u{20000};"">") (= x "<style>:target {color: red;}</style><body id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></body>")))
(assert (or (= z "usemove=""alert(1)"">test</m\u{1d400}ark>") (= z "ert(1)"">test</data>")))
