(assert (or (str.contains (str.replace y "=tr" "<b>") "le<b>ue\u{20000};") (= (str.indexof z "ov" 0) 4)))
(assert (or (not (>= (str.len z) 10)) (not (str.contains (str.replace x ":do" " ") "cript c"))))
(assert (or (not (= (str.indexof y "=al" 0) 94)) (not (= (str.len y) 142)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{1}[0-9a-zA-Z]+[\w\.-]+@[\w\.-]+\.\w{2,}$")))))
