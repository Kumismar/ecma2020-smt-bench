; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script src=%(jscript)s></script>") (= x "<legend ondblclick=""alert(1)"">test</legend>") (= x "<tbody onkeyup=""\u{1f600}alert(1)"" conten\u{10348}teditable>test</tbody>")))
(assert (or (= z "/fieldset>") (= z "ate=alert(1)></area><input id=y autofoc\u{1d400}us>") (= z "click=""alert(1)"">test</frameset>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$"))) (str.prefixof "meta" z)))
(assert (or (not (= "<tbody on =""\u{1f600}alert(1)"" conten\u{10348}teditable>test</tbody>" (str.replace x "keyup" " "))) (not (= "id=y au" (str.substr y 70 7))) (= (str.at y 10) "e")))
(assert (or (= "pt src=%" (str.substr x 5 8)) (= "/fijavascript:dset>" (str.replace z "el" "javascript:")) (= (str.indexof y "y " 0) 5)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\(?(\d{3})\)?[ .-]?(\d{3})[ .-]?(\d{4})$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^1\d{10})|^((\d{7,8})|(\d{4}|\d{3})-(\d{7,8})|(\d{4}|\d{3})-(\d{7,8})-(\d{4}|\d{3}|\d{2}|\d{1})|(\d{7,8})-(\d{4}|\d{3}|\d{2}|\d{1}))$")))))
(check-sat)
