; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=&#x6A&#x61&#x76&#x61&#x73&#x63&#x72&#x69&#x70&#x74&#x3A&#x61&#x6C&#x65&#x72&#x74&#x28&#x27&#x58&#x53&#x53&#x27&#x29>") (= x "<content onmouseup=""a\u{1f600}lert(1)"">test</cont\u{1f600}ent>") (= x "<abbr onmouseleave=""alert(1)"">test</abbr>")))
(assert (or (= z "ert(1)"">test</section>") (= z "rt(1)></b>") (= z "st</nav>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 13) "u") (= "<IMG SRC=alert(1)A&#x61&#x76&#x61&#x73&#x63&#x72&#x69&#x70&#x74&#x3A&#x61&#x6C&#x65&#x72&#x74&#x28&#x27&#x58&#x53&#x53&#x27&#x29>" (str.replace x "&#x6" "alert(1)"))))
(assert (or (str.prefixof "ert(1)"">te" z) (str.contains z "><in")))
(assert (or (not (= (str.indexof z "test<" 0) 8)) (str.contains x "useup=""a")))
(assert (or (not (str.suffixof "t>" z)) (str.suffixof "r>" x)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{8,14}$"))) (not (= (str.len z) 22))))
(assert (or (not (= "mo" (str.substr x 11 2))) (= (str.len x) 46)))
(assert (str.suffixof "v>" z))
(assert (or (not (= (str.len z) 10)) (not (= (str.indexof z "rt(1" 0) 0))))
(check-sat)
