; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details onmousedown=""alert(1)"">test</details>") (= x "<optgroup onblur=alert(1) tabindex=1 id=x></optgroup><input autofocus>")))
(assert (or (= z "le=""true"" ondragstart=""alert(1)"">test</m\u{20000}enu>") (= z "able>test</xmp>") (= z ")"">test</a\u{1d400}rea>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1-6]{2,5}$"))))
(assert (or (not (= "lert(1)" (str.substr y 94 7))) (not (str.contains (str.replace y "nbl" """") "o""ur")) (= (str.at y 93) " ")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-z\u{e4}\u{f6}\u{fc}A-Z\u{c4}\u{d6}\u{dc}\u{df}0-9\-]{0,63})$"))))
(assert (or (not (str.prefixof "le=""t" z)) (not (str.contains z "test</xm")) (not (= (str.at y 38) "d"))))
(assert (not (str.prefixof "<" x)))
(assert (not (= "=""alert(" (str.substr z 21 8))))
(check-sat)
