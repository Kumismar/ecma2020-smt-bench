; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<<SCRIPT>%(payload)s//<</SCRIPT>") (= x "<style>:target {transform: rotate(180deg);}</style><dd id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dd>")))
(assert (or (= z "raggable=""true"" ondragleave=""alert(1)"">test</samp>") (= z "v style=""x:\xE2\x80\x84expression(javascript:alert(1)"">DEF")))
(assert (= y (str.++ x z)))
(assert (str.contains z "script"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]{2,}"))) (not (str.suffixof "rt(1)"">DEF" y))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{3041}-\u{3093}\u{3094}\u{30fc}\u{3000} ]*$"))))
(assert (or (str.suffixof ">DEF" z) (str.suffixof """>DEF" y) (= (str.at y 36) "y")))
(assert (not (= (str.indexof z "ivate" 0) 7)))
(assert (not (= "IPT>" (str.substr x 5 4))))
(assert (or (str.prefixof "<output dr" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])\S{8,32}$")))))
(check-sat)
