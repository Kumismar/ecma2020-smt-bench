; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article onmouseup=""alert(1)"">test</article>") (= x "<dt ondblclick=""alert(1)"">test</dt>") (= x "<option id=x tabindex=1 onfocus=alert(1)></option>")))
(assert (or (= z "tyle>@keyframes x{}</style><hgroup style=""animation-name:x"" onanimationstart=""alert(1)""></hgroup>") (= z "ert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "e=""an" "javascript:") "styljavascript:imat")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[^' ']+"))) (not (str.contains x "=al"))))
(assert (or (str.contains z "rt(1)"">") (= "=""ale" (str.substr x 31 5)) (not (str.suffixof "(1)"">" z))))
(assert (= (str.indexof x "drag" 0) 8))
(assert (str.prefixof "<option" y))
(check-sat)
