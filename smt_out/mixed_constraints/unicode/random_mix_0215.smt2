; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><dl onload=alert(1)></dl>") (= x "<rb id=x tabindex=1 onbeforeactivate=alert(1)></rb>")))
(assert (or (= z "t(1)"">test</th>") (= z "lockquote onblur=alert(1) tabindex=1 id=x></b\u{1f600}lockquote><in\u{10348}put autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^(13[0-9]|14[579]|15[0-3,5-9]|16[6]|17[0135678]|18[0-9]|19[89])d{8}$")) (= (str.at y 44) ")") (not (str.prefixof "<svg><dl o" y))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@(?!gmail.com|hotmail.com|outlook.com|yahoo.com|icloud.com|ig.com|bol.com|uol.com)[a-z0-9.-]+\.[a-z]{2,4}$")))
(assert (or (not (= (str.at x 18) "e")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{2}$")))))
(assert (<= (str.len x) 33))
(assert (not (str.contains (str.replace x "alert" "<b>") "oad=<b>(1)>")))
(assert (or (= "rb>" (str.substr x 48 6)) (= (str.indexof y "de" 0) 14) (not (= (str.at z 63) " "))))
(assert (or (not (= (str.indexof z "test<" 0) 6)) (str.contains x "=x ta")))
(assert (= (str.indexof z " tabi" 0) 7))
(check-sat)
