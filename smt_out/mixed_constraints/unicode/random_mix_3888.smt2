; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<animate attributeName=""xlink:href"" begin=""0"" from=""javascript:alert(137)"" to=""&"" />") (= x "<main id=x tabindex=1 onfocusin=alert(1)></main>")))
(assert (or (= z "ve=""javascript:javascript:alert(1)""></html onMouseLeave>") (= z "T&gt;") (= z "AD><META HTTP-EQUIV=""CONTENT-TYPE"" CONTENT=""text/html; charset=UTF-7""> </HEAD>+ADw-SCRIPT+AD4-%(payload)s;+ADw-/SCRIPT+AD4-")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9 \u{5c}u00D1\u{5c}u00F1]+$")) (= (str.indexof x "rt(" 0) 35) (str.suffixof "seLeave>" z)))
(assert (or (= (str.at x 73) """") (not (str.suffixof "IPT+AD4-" z)) (not (= (str.at z 19) "s"))))
(assert (or (= "m" (str.substr x 4 1)) (not (str.contains y "ert"))))
(assert (not (str.contains z "avas")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\w+([-+.]\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*$"))))
(assert (not (str.suffixof "t;" z)))
(check-sat)
