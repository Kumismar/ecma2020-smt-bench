; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base onkeydown=""alert(1)"" contenteditable>test</base>") (= x "<body onkeyup=""alert(1)"" contenteditable>test</body>") (= x "<caption onclick=""alert(1)"">test</caption>")))
(assert (or (= z "(1)"">test</h1>") (= z "style><dir id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dir>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "\x") (not (str.in_re x ((_ re.from_regex ecma2020 u) "(^rs\d+$)|(^chr(\d{1,2}|(x|y|X|Y)):\d+$)")))))
(assert (or (>= (str.len x) 41) (not (= " e><dir id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dir>" (str.replace z "styl" " ")))))
(assert (str.contains y "aption on"))
(assert (or (>= (str.len x) 48) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{4,15}$")) (str.suffixof "se>" x)))
(assert (or (= (str.at x 10) "y") (str.contains x "onclick=""a") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[_A-z0-9@$_.#*]{1,}$")))))
(assert (not (= (str.indexof x " o" 0) 5)))
(check-sat)
