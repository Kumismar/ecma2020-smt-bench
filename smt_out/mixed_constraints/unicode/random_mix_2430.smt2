; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong onpaste=""alert(1)"" contenteditable>test</strong>") (= x "<br onblur=alert(1) tabindex=1 id=x></br><input autofocus>")))
(assert (or (= z ":alert('XSS')\"">") (= z "rt(1)>click this!")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z0-9]{10}"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z-_ ]{1,}")))))
(assert (or (not (= (str.indexof x "<br o" 0) 0)) (str.contains z "ck") (= (str.len x) 58)))
(assert (or (not (= (str.indexof y "=" 0) 10)) (not (str.prefixof """'`><\x" x))))
(assert (or (= """ contente" (str.substr x 25 10)) (not (str.prefixof "rt(" z))))
(assert (not (= (str.at x 24) "n")))
(assert (or (= (str.indexof y "<stro" 0) 0) (not (= "click " (str.substr z 6 6))) (str.contains y "1) tabinde")))
(check-sat)
