; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body id=x tabindex=1 onbeforeactivate=alert(1)></body>") (= x "<style>:target {color:red;}</style><basefont id=x style=""transition:color 1s"" ontransitionend=alert(1)></basefont>") (= x "<nav onmouseleave=""alert(1)"">test</nav>")))
(assert (or (= z "onmouseleave=""alert(1)"">test</bdi>") (= z "nteditable>test</rp>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "d" 0) 3)) (not (= (str.indexof y "r" 0) 28))))
(assert (= "s"" ontra" (str.substr y 75 8)))
(assert (str.contains x """>test"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,10}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z\u{df}A-Z0-9_.,\- ]*$"))) (not (= (str.indexof x "av o" 0) 2))))
(assert (or (str.suffixof "font>" x) (str.prefixof "onmou" z) (= "</na" (str.substr x 33 4))))
(check-sat)
