; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "exp/*<;XSS STYLE=';no\xss:noxss("";*//*"";);") (= x "<bdo onkeydown=""alert(1)"" contenteditable>test</bdo>")))
(assert (or (= z "ex=1 onbeforeactivate=alert(1)></li>") (= z "ofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<bdo o" x)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\s\p{L}]+ ?[\s\p{L}]+")))))
(assert (or (not (= (str.at y 44) "o")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-z0-9._-])+@([a-z0-9.-])+(.)([a-z]){2,4}$")))))
(assert (or (str.suffixof ";);ofocus>" y) (= (str.at y 28) "x") (not (= "<svg" (str.substr y 13 4)))))
(assert (or (= "exp/*<;XSS STYLE=';no\xalert(1)s:noxss("";*//*"";);ex=1 onbeforeactivate=alert(1)></li>" (str.replace y "s" "alert(1)")) (str.prefixof "exp/*<;XSS" x)))
(check-sat)
