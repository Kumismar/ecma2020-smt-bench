; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption draggable=""true"" ondragstart=""alert(1)"">test</caption>") (= x "&lt;br size=\&quot;&amp;{alert(&#039;XSS&#039;)}\&quot;&gt;") (= x "<svg><option onload=alert(1)></option>")))
(assert (or (= z "=alert(1)>") (= z "nd dragga\u{1f600}ble=""true"" ondragleave=""alert(1)"">test</command>")))
(assert (= y (str.++ x z)))
(assert (or (= "<ca""tion draggable=""true"" ondragstart=""alert(1)"">test</caption>" (str.replace x "p" """")) (= "e=" (str.substr x 10 2))))
(assert (= "<caption draggable=""tr"" ondragstart=""alert(1)"">test</caption>" (str.replace x "ue""" """")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_]+$")) (not (str.suffixof "ke>" y)) (= (str.at z 54) "a")))
(assert (or (str.contains (str.replace z "1)""" "x") "ert(x>test") (= (str.indexof y "edita" 0) 35)))
(check-sat)
