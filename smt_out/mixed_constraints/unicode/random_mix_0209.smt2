; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><nav id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></nav>") (= x "<footer onclick=""alert(1)"">test</footer>") (= x "<del draggable=""true"" ondragleave=""alert(1)"">test</del>")))
(assert (or (= z """alert(1)"">test</style>") (= z "e"" ondragleave=""alert(1)"">test</datalist>")))
(assert (= y (str.++ x z)))
(assert (or (= "est" (str.substr z 27 3)) (= (str.at y 40) ")") (= (str.at z 25) ">")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{9}$"))) (not (= "f" (str.substr x 1 1)))))
(assert (str.prefixof """ale" z))
(assert (or (str.contains y "2s"" o") (not (= "ncli" (str.substr y 9 4)))))
(assert (not (str.contains y ")"">te")))
(check-sat)
