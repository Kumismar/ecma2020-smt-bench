; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onpaste=""alert(1)"" contenteditable>test</sup>") (= x "<FRAMESET><FRAME SRC=\""javascript:alert('XSS');\""></FRAMESET>") (= x "<eval>new ActiveXObject(&apos;htmlfile&apos;).parentWindow.alert(135)</eval>")))
(assert (or (= z "(1)"">test</tr>") (= z "x003C")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9\-\s]{5,60}$"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{1}-\d{3}-\d{3}-\d{2}-\d{2}$")) (str.suffixof "tr>" y) (not (<= (str.len z) 13))))
(assert (not (= "0" (str.substr z 2 1))))
(assert (= (str.indexof x "(&apo" 0) 23))
(assert (not (>= (str.len y) 81)))
(assert (str.prefixof "x00" z))
(assert (or (str.contains x "/s") (not (str.in_re z ((_ re.from_regex ecma2020 u) "8939[0-9]{15,19}")))))
(check-sat)
