; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "//<form/action=javascript&#x3A;alert&lpar;document&period;cookie&rpar;><input/type='submit'>//") (= x "<script\x0Ctype=""text/javascript"">javascript:alert(1);</script>")))
(assert (or (= z "t><script>alert(123)</script>") (= z "e><u id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></u>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 6) "m")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^testpage$"))) (= (str.indexof y "23)<" 0) 111)))
(assert (or (str.contains y """trans") (not (= (str.len y) 134))))
(assert (not (= (str.at x 80) "p")))
(assert (= (str.indexof z "ionru" 0) 51))
(assert (or (not (= (str.at z 9) " ")) (= (str.indexof y "cri" 0) 2)))
(check-sat)
