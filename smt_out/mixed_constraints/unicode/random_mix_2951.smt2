; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT&gt;document.write(&quot;&lt;SCRI&quot;);&lt;/SCRIPT&gt;PT SRC=&quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;") (= x "<del oncut=""alert(1)"" contenteditable>test</del>")))
(assert (or (= z "le=""true"" ondrag=""alert(1)"">test</content>") (= z "est</ins>")))
(assert (= y (str.++ x z)))
(assert (not (= "<del oncut=""alert(1)"" contenteditable>test</del>le=""true"" ondrag=""alert(1)"">test<xtent>" (str.replace y "/con" "x"))))
(assert (str.contains (str.replace x "J" """") "<;OB""ECT c"))
(assert (or (= ";SCRI&qu" (str.substr y 38 8)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-2]{0,1}[0-9]{1}$")))))
(assert (not (= (str.indexof z "n" 0) 6)))
(assert (or (not (= (str.indexof y "del>" 0) 44)) (= "es" (str.substr z 0 2)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z .'-]+$"))))
(assert (or (>= (str.len x) 130) (not (str.contains z "t</"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9-_]{4,25}"))))
(assert (= (str.indexof x "rt(1)" 0) 15))
(check-sat)
