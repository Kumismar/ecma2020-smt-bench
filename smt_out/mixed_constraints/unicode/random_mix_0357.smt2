; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot onmouseout=""alert(1)"">test</tfoot>") (= x "<nobr draggable=""true"" ondragenter=""alert(1)"">test</nobr>")))
(assert (or (= z "ert(1)//") (= z "mes x{}</style><nav style=""animation-name:x"" onanimationend=""alert(1)""></nav>") (= z "t</acronym>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "true"" ondr") (str.prefixof "ert(1)/" z) (not (= (str.indexof x "t=""" 0) 16))))
(assert (not (str.contains z "1)"">test")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{3}[0-9]{2}[0-9]{3}[0-9]{2}"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z]{6}[0-9]{2}[a-zA-Z][0-9]{2}[a-zA-Z][0-9]{3}[a-zA-Z]"))) (str.prefixof "<nobr d" x)))
(assert (= "<nobr draggable=""true"" ondragenter=""alert(1)"">test</nobr>mes x{}</style>< tyle=""animation-name:x"" onanimationend=""alert(1)""></nav>" (str.replace y "nav s" " ")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z][a-z]*"))) (= "t</nobr>m" (str.substr y 49 9))))
(check-sat)
