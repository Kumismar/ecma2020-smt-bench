; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" ondragstart=""alert(1)"">test</div>") (= x "<nextid id=x tabindex=1 onfocus=alert(1)></nextid>")))
(assert (or (= z "id=x tabindex=1 onbeforeactivate=alert(1)></abbr>") (= z "frames x{}</style><wbr style=""animation-name:x"" onanimationstart=""alert(1)""></wbr>") (= z " ondblclick=""alert(1)"">test</xmp>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof """></wbr>" y)) (not (str.contains z "1)"">test"))))
(assert (or (not (= "mp>" (str.substr z 30 6))) (not (>= (str.len y) 92)) (str.suffixof "</div>" x)))
(assert (or (<= (str.len y) 112) (str.contains z "tyle=""ani") (str.in_re y ((_ re.from_regex ecma2020 u) "^([0-9 /.,]){1,}$"))))
(assert (= (str.indexof z "le" 0) 14))
(check-sat)
