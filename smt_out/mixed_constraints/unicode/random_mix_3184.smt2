; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><ol onload=alert(1)></ol>") (= x "<style\u{1d400}>@keyframes x{}</style><sup style=""animation-name:x"" onanimationend=""alert(1)""></sup>")))
(assert (or (= z "ditable>test</\u{1f600}shadow>") (= z "put id=x tabindex=1 ondeactivate=alert(1)></input><input id=y autofocus>") (= z "(1)""></i>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 4) ">") (not (= "e=true;" (str.substr z 12 7)))))
(assert (or (not (= (str.at z 3) ">")) (>= (str.len z) 20)))
(assert (or (not (>= (str.len x) 23)) (not (str.suffixof "</\u{1f600}shadow>" z)) (str.prefixof "<svg>" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-Za-z0-9_\-.+])+@([A-Za-z0-9_\-.])+\.([A-Za-z]{2,})$"))) (<= (str.len z) 24)))
(assert (not (str.prefixof "<st" x)))
(check-sat)
