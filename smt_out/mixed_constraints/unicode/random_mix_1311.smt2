; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><nextid style=""animation-name:x"" onanimationend=""alert(1)""></nextid>") (= x "<br draggable=""true"" ondragenter=""alert(1)"">test</br>")))
(assert (or (= z "(javascript:alert(1)"">DEF") (= z "enteditable>test</dd>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ">" y) (not (str.prefixof "<style>" x))))
(assert (or (not (str.contains x " ondrag")) (not (str.prefixof "<style>@k" y))))
(assert (or (= (str.indexof y "a" 0) 6) (str.in_re y ((_ re.from_regex ecma2020 u) "(^$)|(^.*(\S+).*$)"))))
(assert (or (not (str.prefixof "<br dr" x)) (str.contains (str.replace x "me:x" "<b>") "on-na<b>"" on")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]+(\.[0-9]{1,2})?$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[1-9]{1}$"))) (not (= (str.at y 54) "i"))))
(check-sat)
