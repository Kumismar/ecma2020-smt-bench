; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr id=x tabindex=1 onfocus=alert(1)></abbr>") (= x "<script onmouseover=""alert(1)"">test</script>")))
(assert (or (= z "shchange=""alert\u{1f4a9}(1)"">") (= z "\xE2\x80\x83javascript:javascript:alert(1)"" id=""fuzzelement1"">\u{10348}test</a>") (= z "alert(1)>press any key!")))
(assert (= y (str.++ x z)))
(assert (not (= "ey!" (str.substr y 64 8))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Z0-9._%+-]+@(?:[A-Z0-9-]+\.)+[A-Z]{2,}$")))
(assert (or (not (>= (str.len y) 107)) (str.prefixof "<abbr" x) (= (str.indexof y "va" 0) 58)))
(assert (or (str.suffixof "section>" y) (not (str.prefixof "<abb" y)) (not (str.contains z "1)>pres"))))
(assert (or (not (= "ndex=1 " (str.substr x 28 7))) (not (str.suffixof "ipt>" x))))
(check-sat)
