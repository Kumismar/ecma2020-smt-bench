; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src\x32=x onerror=""javascript:alert(1)"">") (= x "<IMG SRC=javascript:alert(\u{2018}XSS\u{2019})>") (= x "<rt onkeyup=""alert(1)"" contenteditable>test</rt>")))
(assert (or (= z "h onblur=alert(1) tabindex=1 id=x></th><input autofocus>") (= z "</a>") (= z " style=""x:\xE3\x80\x80expression(javascript:alert(1)"">DEF")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "javasc")))
(assert (or (str.prefixof "<" x) (not (= "ndex=1 " (str.substr y 55 7)))))
(assert (or (= (str.at z 1) "r") (not (= (str.indexof x ")>" 0) 31))))
(assert (or (= (str.indexof x "d" 0) 1) (str.prefixof "<rb" y) (str.prefixof "h onbl" z)))
(assert (or (not (= (str.at x 24) "j")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9]{5})$")))))
(check-sat)
