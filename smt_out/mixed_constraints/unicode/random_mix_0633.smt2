; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><svg style=""animation-name:x"" onanimationend=""alert(1)""></svg>") (= x "<p onmouseenter=""alert(1)"">test</p>") (= x "<iframe src=javascript&colon;alert&lpar;document&period;location&rpar;>")))
(assert (or (= z "test</blockquote>") (= z ">") (= z " 2s"" ontransitionrun=alert(1)></embed>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "lo" 0) 98) (= (str.indexof x "=x " 0) 8) (= (str.at x 17) "a")))
(assert (or (str.suffixof "est</p>" x) (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9\-]*"))))
(assert (or (not (str.prefixof "<style" x)) (= (str.at y 95) "s")))
(assert (or (str.prefixof ">" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{6,}")))))
(assert (or (not (= "" (str.replace z ">" ""))) (= "e" (str.substr z 35 1))))
(assert (str.prefixof "<iframe s" x))
(check-sat)
