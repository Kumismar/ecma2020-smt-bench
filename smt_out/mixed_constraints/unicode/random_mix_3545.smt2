; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option onclick=""alert(1\u{20000})"">test\u{20000}</option>") (= x "<iframe src iframe src=""javascript:javascript:alert(1)""></iframe src>")))
(assert (or (= z "nload=alert(1)></nextid>") (= z "le>test</i>") (= z "tofocus>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 69) "t")))
(assert (not (str.suffixof "</i>" z)))
(assert (or (not (= "<iframe src iframe src=""javascript:javascript:alxt(1)""></iframe src>nload=alert(1)></nextid>" (str.replace y "er" "x"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{1,15}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9-#.!,@\[\]\(\)\/ ]+$")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "((?=^.{6,}$).*$)"))) (not (<= (str.len x) 47)) (not (str.prefixof "<optio" x))))
(assert (= "opy" (str.substr y 10 3)))
(check-sat)
