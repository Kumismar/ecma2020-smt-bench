; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script onkeyup=""alert(1)"" contenteditable>test</script>") (= x "<ol onmousedown=""alert(1)"">test</ol>")))
(assert (or (= z ")&quot;);}&lt;/STYLE&gt;&lt;A CLASS=XSS&gt;&lt;/A&gt;") (= z "ert(1)>click")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[-A-Za-z0-9_&%!#/.\s]{5,60}"))))
(assert (or (str.contains (str.replace y "t" """") "crip"" o") (str.in_re x ((_ re.from_regex ecma2020 u) "^[^*?]*$"))))
(assert (or (= "<script onkeyup=""a""1)"" contenteditable>test</script>" (str.replace x "lert(" """")) (not (= "onmoused" (str.substr x 4 8))) (>= (str.len y) 108)))
(assert (or (not (str.prefixof ")&quot;);}" z)) (not (>= (str.len z) 1))))
(assert (not (str.contains y "}&")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([1-9][0-9]*)$"))))
(assert (= (str.indexof z "r" 0) 1))
(check-sat)
