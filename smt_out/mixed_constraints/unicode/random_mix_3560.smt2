; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby draggable=""true"" ondragleave=""alert(1)"">test</ruby>") (= x "<a href=""\xE3\x80\x80javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "1 onfocusin=alert(1)></abbr>") (= z "'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 48) "s")) (<= (str.len x) 87) (str.contains x "e=")))
(assert (= "ipt:jav" (str.substr x 28 7)))
(assert (or (str.suffixof "ocus>" x) (not (= (str.at y 39) "m")) (str.suffixof "></q>" x)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[\w\.+\-_]+@([\w\d-]+\.)+[\w]{2,12}$")))
(check-sat)
