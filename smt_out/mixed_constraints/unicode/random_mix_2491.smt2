; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onkeydown=""alert(1)"" contenteditable>test</sup>") (= x "<aside draggable=""true"" ondragleave=""alert(1)"">test</aside>")))
(assert (or (= z "test</video>") (= z "</xmp>") (= z "X03c;")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 10) "g") (not (= "<b>/xmp>" (str.replace z "<" "<b>")))))
(assert (str.prefixof "<aside" x))
(assert (or (str.contains x "st</sup") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\s][A-Za-z -]+$")))))
(assert (not (str.contains z "/xmp")))
(assert (or (= "c;" (str.substr z 3 10)) (= (str.indexof x "ente" 0) 30) (= (str.indexof y """true" 0) 17)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[ \u{3000}\u{3041}-\u{3096}\u{309d}\u{309e}\u{30fc}]+$")) (= (str.indexof y "e" 0) 8)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9\s-]{0,11}")) (not (str.contains x "ontent"))))
(assert (or (not (= ")></m" (str.substr y 65 5))) (not (= "mp>" (str.substr z 3 7)))))
(check-sat)
