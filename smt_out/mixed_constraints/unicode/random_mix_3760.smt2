; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""96""><iframe src=mhtml:http://html5sec.org/test.html!xss.html></iframe>") (= x "<var onmouseover=""alert(1)"">test</var>")))
(assert (or (= z "br ondrop=alert(1) contenteditable>drop here</wbr>") (= z "gable=""true"" ondragstart=""alert(1)"">test</basefont>") (= z "</script>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 18) "m") (not (str.prefixof "<" z)) (<= (str.len y) 91)))
(assert (or (= (str.len x) 38) (str.contains (str.replace z "<" "javascript:") "javascript:/") (str.suffixof "ame>" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) ".*(^(bc1|[13])[a-zA-HJ-NP-Z0-9]{25,39}$).*"))) (= (str.len x) 79)))
(assert (or (not (str.contains (str.replace z "pt" "alert(1)") "scrialert(1)>")) (not (str.suffixof "basefont>" z)) (= (str.at x 72) "i")))
(assert (str.suffixof "rame>" x))
(assert (not (str.contains x """alert(1")))
(check-sat)
