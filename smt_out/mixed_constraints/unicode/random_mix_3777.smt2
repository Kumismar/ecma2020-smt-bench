; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""40""><style><img src=""</style><img src=x onerror=alert(40)//"">//[""'`-->]]>]</div>") (= x "<style>:target {transform: rotate(180deg);}</style><bdi id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></bdi>") (= x "<svg><menuitem onload=alert(1)></menuitem>")))
(assert (or (= z "true"" ondragend=""alert(1)"">test</hr>") (= z "></textarea>") (= z "alert(1) contenteditable>drop here</kbd>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "on" 0) 15)) (str.contains x "<bdi")))
(assert (= ">//[" (str.substr y 69 4)))
(assert (or (not (= (str.at z 7) "a")) (not (str.prefixof "<styl" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{105}\u{107}\u{106}\u{119}\u{142}\u{141}\u{144}\u{143}\u{f3}\u{d3}\u{15b}\u{15a}\u{17c}\u{17b}\u{17a}\u{179}\-]{3,20}$")))))
(assert (str.prefixof "alert" z))
(assert (not (= (str.len x) 51)))
(check-sat)
