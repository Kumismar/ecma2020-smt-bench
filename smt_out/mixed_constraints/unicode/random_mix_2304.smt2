; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem draggable=""true"" ondragstart=""alert(1)"">test</menuitem>") (= x "<style></style\x20<img src=""about:blank"" onerror=javascript:alert(1)//></style>")))
(assert (or (= z "t(1)"">test</marquee>") (= z " SRC=JaVaScRiPt:alert('XSS')>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^BC\d{3,7}|bc\d{3,7}$"))) (not (= (str.at x 41) "l")) (not (str.prefixof "<s" y))))
(assert (or (not (= (str.len z) 37)) (= "ip" (str.substr x 56 2)) (not (<= (str.len x) 48))))
(assert (= "ad" (str.substr z 3 2)))
(assert (= (str.indexof x "ui" 0) 4))
(assert (or (not (= "t(1)"">test</m<b>e>" (str.replace z "arque" "<b>"))) (not (str.contains (str.replace z "SS')" "alert(1)") "Xalert(1)>"))))
(assert (or (not (= (str.at y 66) "1")) (not (str.prefixof " SRC=JaVaS" z)) (= "ond" (str.substr x 27 3))))
(check-sat)
