; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe src=javascript:alert(1)>") (= x "<dfn id=x tabindex=1 onbeforedeactivate=alert(1)></dfn><input autofocus>") (= x "&lt;IMG SRC=\""livescript&#058;&#91;code\u{1d400}&#\u{1f600}93;\""&gt;")))
(assert (or (= z "dex=1 ondeactivate=alert(1)></meta><input id=y autofocus>") (= z "ascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9@]+$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\([0-9]{2}\)[\s]{0,1}[0-9]{4,5}-[0-9]{4}$")))))
(assert (or (not (= (str.indexof z "ipt" 0) 4)) (>= (str.len z) 22)))
(assert (or (not (<= (str.len y) 115)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "http://www\.linkedin\.com\/(.+)|https://www\.linkedin\.com\/(.+)|www\.linkedin\.com\/(.+)"))) (str.prefixof "<" y)))
(assert (or (not (str.suffixof "ocus>" y)) (not (>= (str.len y) 106))))
(check-sat)
