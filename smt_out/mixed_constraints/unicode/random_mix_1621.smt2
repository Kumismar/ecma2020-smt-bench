; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed draggable=""true"" ondragleave=""alert(1)"">test</embed>") (= x "<input onfocusout=alert(1) id=x><input autofocus>")))
(assert (or (= z "</bdo>") (= z "0003c") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace x ") i" "javascript:") "rt(1javascript:d=x")))
(assert (not (str.contains x "1)"">test")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z._-]+@[0-9a-zA-Z._-]+[\\.]{1}[0-9a-zA-Z]+[\\.]?[0-9a-zA-Z]+$"))) (not (>= (str.len x) 22)) (str.suffixof ">" x)))
(assert (= (str.len x) 49))
(assert (or (not (str.suffixof "s>>" y)) (<= (str.len x) 66) (not (= ">test</e" (str.substr x 46 8)))))
(assert (= (str.indexof z "0003c" 0) 0))
(check-sat)
