; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><b ondragover=alert(1) contenteditable>drop here</b>") (= x "<blink id=x tabindex=1 onactivate=alert(1)></blink>")))
(assert (or (= z " draggable=""true"" ondragenter=""alert(1)"">test</video>") (= z "rames x{}</style><select style=""animation-name:x"" onanimationend=""alert(1)""></select>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "r" (str.substr z 34 1))) (str.contains z "el")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^.+@.+\.[a-zA-Z]{2,63}$"))))
(assert (not (str.prefixof "r" z)))
(assert (not (= """true"" o" (str.substr z 11 8))))
(assert (or (not (= " " (str.substr x 6 1))) (>= (str.len y) 186)))
(assert (or (str.suffixof "t</video>" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9+]*"))) (not (str.prefixof "<blink " x))))
(assert (not (str.contains (str.replace x "te" "") """ connted")))
(check-sat)
