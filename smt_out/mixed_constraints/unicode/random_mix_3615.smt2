; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><meter onload=alert(1)></meter>") (= x "<ruby id=x tabindex=1 ondeactivate=alert(1)></ruby><input id\u{1f600}=y\u{20000} autofocus>")))
(assert (or (= z "alert(1)></sup>") (= z "nxxx=1 \u{20000}onxxx=1")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<" y)) (not (= (str.indexof z "me>" 0) 0))))
(assert (or (= (str.indexof y "1)><" 0) 25) (not (str.suffixof "nxxx=1" z)) (str.in_re x ((_ re.from_regex ecma2020 u) "^.{5,20}$"))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^\+?\d{0,13}")))
(assert (or (= ">" (str.substr z 12 1)) (= (str.indexof x "(" 0) 42)))
(check-sat)
