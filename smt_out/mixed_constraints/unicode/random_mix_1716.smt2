; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<code dragga\u{1f4a9}ble=""true"" ondragstart=""alert(1)"">test</cod\u{1d400}e>") (= x "<output oncopy=""alert(1)"" contenteditable>test</output>") (= x "<div STYLE=""width: expression(document.vulnerable=true);"">")))
(assert (or (= z ">") (= z "rt(1) tabindex=1 id=x></tbody><input autofocus>") (= z ")></rp>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 29) ">")) (not (= " STYLE=""wi" (str.substr y 4 10)))))
(assert (str.suffixof "ut>)></rp>" y))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 '.]+$"))) (not (= (str.at y 79) ">"))))
(assert (or (not (str.prefixof "&l" y)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\S.*\S"))) (not (= "<div STYLE=""width: alert(1)ssion(document.vulnerable=true);"">>" (str.replace y "expre" "alert(1)")))))
(assert (or (<= (str.len y) 104) (not (str.in_re x ((_ re.from_regex ecma2020 u) "((\d{11})|^((\d{7,8})|(\d{4}|\d{3})-(\d{7,8})|(\d{4}|\d{3})-(\d{7,8})-(\d{4}|\d{3}|\d{2}|\d{1})|(\d{7,8})-(\d{4}|\d{3}|\d{2}|\d{1}))$)")))))
(assert (not (str.contains (str.replace x "k sty" "") "nl")))
(check-sat)
