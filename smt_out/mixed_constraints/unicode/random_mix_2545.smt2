; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "//<form/action=javascript&#x3A;alert&lpar;document&period;cookie&rpar;><input/type='submit'>//") (= x "<applet onReadyStateChange applet onReadyStateChange=""javascript:javascript:alert(1)""></applet onReadyStateChange>") (= x "<label\u{10348} draggable=""true"" ondragenter=""alert(1)"">test</label>")))
(assert (or (= z "var ondrop=alert(1) contenteditable>drop here</var>") (= z "\u{1d400}ipt:alert(1);}</script>") (= z "onmouseenter=""alert(1)"">test</area>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "lert" "") "x3A;a&lpa")) (= (str.indexof x "ut/t" 0) 75) (str.in_re y ((_ re.from_regex ecma2020 u) "1955$"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,8}$")) (not (= "//<form/action=javascript&#x3A;alert&lpar;document&period;cookie&rpar;><in""/type='submit'>//" (str.replace x "put" """"))) (= "usee" (str.substr z 4 4))))
(assert (or (not (= "vdrop=alert(1) contenteditable>drop here</var>" (str.replace z "ar on" ""))) (= (str.indexof z "ert(" 0) 7) (>= (str.len x) 50)))
(assert (or (= "action=" (str.substr x 8 7)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "([Gg][Ii][Rr] 0[Aa]{2})|((([A-Za-z][0-9]{1,2})|(([A-Za-z][A-Ha-hJ-Yj-y][0-9]{1,2})|(([A-Za-z][0-9][A-Za-z])|([A-Za-z][A-Ha-hJ-Yj-y][0-9]?[A-Za-z]))))\s?[0-9][A-Za-z]{2})"))) (<= (str.len z) 41)))
(assert (not (str.prefixof "//<form/a" y)))
(check-sat)
