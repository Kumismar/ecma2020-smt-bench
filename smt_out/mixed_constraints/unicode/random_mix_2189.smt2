; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>alert(""hellox worldss"")</script>&safe=high&cx=006665157904466893121:su_tzknyxug&cof=FORID:9#510") (= x "<IMG SRC=x oninput=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "src=""blah""onmouseover=""document.vulnerable=true;"">") (= z "script>iPt>alert(1)</SCr</script>IPt>") (= z "rt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=^.{8,}$)((?=.*\d)|(?=.*\W+))(?=.*[A-Z])(?=.*[a-z]).*$"))) (not (str.contains (str.replace y "ug&" "") "zknyxcof"))))
(assert (not (str.contains y "nt.vulner")))
(assert (str.suffixof ",83))"">" x))
(assert (or (str.contains (str.replace z "aler" """") ">""t(1)<") (not (= (str.at y 16) "u"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^0([8|9|6])([0-9]{8}$)")) (not (= (str.len y) 108)) (not (= "e=" (str.substr x 44 2)))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&?*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))))
(assert (or (not (str.suffixof "83))"">" x)) (str.contains x "rt(")))
(check-sat)
