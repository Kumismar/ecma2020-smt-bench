; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt draggable=""true"" ondrag=""alert(1)"">test</dt>") (= x "<svg><xss onload=alert(1)></xss>")))
(assert (or (= z "id=x></label><input autof\u{10348}ocus>") (= z "ontenteditable>test</fieldset>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof ">" y)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?!^\s+$)[A-z\u{c0}-\u{17e}0-9()\s\-\.]{1,40}"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_ +-,.?]{3,}$")))))
(assert (not (str.suffixof "/script>" z)))
(assert (= (str.at z 29) "s"))
(assert (or (<= (str.len y) 65) (not (= (str.at x 14) """")) (not (str.suffixof "/fieldset>" y))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w\.]+@[a-zA-Z_]+\.[a-zA-Z]{1,4}$")))
(check-sat)
