; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb onbeforecopy=""alert(1)"" contenteditable>test</rb>") (= x "<video draggable=""true"" ondragenter=""alert(1)"">test</video>")))
(assert (or (= z ")"">test</content>") (= z " onbeforedeactivate=alert(1)></frame><input autofocus>") (= z "le><noframes style=""animation-name:x"" onanimationstart=""alert(1)""></noframes>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$"))) (not (str.suffixof "/noframes>" z))))
(assert (str.prefixof "<" y))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e4}\u{c4}\u{eb}\u{cb}\u{ef}\u{cf}\u{f6}\u{d6}\u{fc}\u{dc}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{c2}\u{ca}\u{ce}\u{d4}\u{db}\u{e2}\u{ea}\u{ee}\u{f4}\u{fb}\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9} _-]{3,30}$")) (not (= (str.at y 37) "a"))))
(assert (or (= (str.indexof z "</" 0) 66) (not (str.suffixof "us>" z)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{11,11}$"))))
(check-sat)
