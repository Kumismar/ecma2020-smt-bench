; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas onpaste=""alert(1)"" contenteditable>test</canvas>") (= x "<IMG DYNSRC=""javasc\u{10348}ript:alert('XSS')"">") (= x "<acronym onbeforecut=""alert(1)"" contenteditable>test</acronym>")))
(assert (or (= z "[""'`-->]]>]</div>") (= z "rt(1)""></rb>") (= z "1)"">test</body>")))
(assert (= y (str.++ x z)))
(assert (or (= "-" (str.substr z 4 1)) (not (str.suffixof "t</pre>" x))))
(assert (or (not (str.prefixof "<acronym o" y)) (= (str.at z 7) "t")))
(assert (or (str.prefixof "1)"">test<" z) (not (= "e" (str.substr x 39 1)))))
(assert (or (not (str.suffixof "t</body>" z)) (not (= "t=""ale" (str.substr x 19 6))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\+)?(\d)+$")))))
(check-sat)
