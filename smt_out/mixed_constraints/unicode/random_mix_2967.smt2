; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del id=x tabindex=1 onfocusin=alert(1)></del>") (= x "<style>@keyframes x{}</style><audio style=""animation-name:x"" onanimationend=""alert(1)""></audio>")))
(assert (or (= z "(1)></span>") (= z "><frame id=x style=""transition:color 1s"" ontransitionend=alert(1)></frame>") (= z "ggable=""true"" ondragstart=""alert(1)"">test</content>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "e=""tr" 0) 5)) (= (str.len x) 84)))
(assert (str.contains (str.replace x "i" "javascript:") "del javascript:d=x t"))
(assert (not (= (str.indexof x "=""al" 0) 75)))
(assert (or (str.suffixof ")></del>" x) (not (str.prefixof "<select dr" x))))
(assert (str.prefixof "><frame i" z))
(assert (not (= "tion" (str.substr y 48 4))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^1[3456789][0-9]{9}$")) (not (= (str.indexof y "1" 0) 83)) (str.contains y "/src=")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\+?[\d\s\-\(\)]{8,}$"))) (not (str.suffixof ">" x)) (not (str.prefixof "<article" y))))
(assert (not (str.suffixof "</del>" x)))
(check-sat)
