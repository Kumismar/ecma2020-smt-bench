; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pict\u{1f4a9}ure onmouse\u{1d400}out=""alert(1)"">test</picture>") (= x "<marquee id=x tabindex=1 onfocus=alert(1)></marquee>") (= x "<xmp onkeydown=""alert(1)"" contenteditable>test</xmp>")))
(assert (or (= z "lert(1)></a>") (= z "true"" ondragenter=""alert(1)"">test</input>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "ert(1)") (= "foo >" (str.replace z "ter" " "))))
(assert (or (str.prefixof "<marquee" y) (not (= (str.indexof z "ue"" o" 0) 2))))
(assert (or (not (= (str.at z 16) "r")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[A-Z])(?=.*[a-z])(?=.*\d).{6,}$")))))
(assert (or (= (str.at z 33) "r") (not (= "(1)" (str.substr y 38 3))) (str.suffixof "ture>" x)))
(check-sat)
