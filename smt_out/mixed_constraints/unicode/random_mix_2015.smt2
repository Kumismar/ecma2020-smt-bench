; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp onmouseup=""alert(1)"">test</samp>") (= x "<samp onmouseenter=""alert(1)"">test</samp>") (= x "<style></style\x20<img src=""about:blank"" onerror=javascript:alert(1)//></style>")))
(assert (or (= z "aggable=""true"" ondragleave=""alert(1)"">test</meta>") (= z " tabindex=1 onfocusin=alert(1)></bdo>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "mp" 0) 3))
(assert (not (= (str.at z 2) "g")))
(assert (or (not (= (str.at z 3) "t")) (str.contains x "st</sam")))
(assert (not (str.contains z "si")))
(assert (str.contains z "(1)"">test"))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9.]*$")) (not (<= (str.len x) 54))))
(assert (not (= (str.indexof z "t(1)>" 0) 26)))
(assert (or (not (<= (str.len z) 58)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^dontmakemethink$")))))
(assert (or (not (str.contains (str.replace x "or" "x") "rx=j")) (not (= (str.indexof x "0<img" 0) 17))))
(check-sat)
