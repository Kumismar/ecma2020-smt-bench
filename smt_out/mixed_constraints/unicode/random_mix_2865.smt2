; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script src=//3334957647/1>") (= x "<dir onmouseup=""alert(1)"">test</dir>") (= x """><img src=x onerror=prompt(1);>")))
(assert (or (= z "enuitem><input id=y autofocus>") (= z "(1)"">test</sub>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<c" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0789][0-9]{9}"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[\d\- ]+$"))))
(assert (or (not (= (str.indexof y "up=""a" 0) 12)) (= (str.indexof y "647/1" 0) 21)))
(assert (or (not (str.contains y " onbefor")) (= (str.indexof x " " 0) 10)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^.{5}$")))
(check-sat)
