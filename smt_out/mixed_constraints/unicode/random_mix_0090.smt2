; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript onmouseout=""alert(1)"">test</noscript>") (= x "<x ondblclick=alert(1)>double click this!")))
(assert (or (= z "es x{}</style><tfoot style=""animation-name:x"" onanimationstart=""alert(1)""></tfoot>") (= z "nt.vulnerable=true;"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "es x" z)) (str.suffixof ">" x) (not (= (str.indexof z "imat" 0) 30))))
(assert (or (not (= (str.len x) 47)) (not (str.prefixof "es x{}</s" z))))
(assert (or (= (str.len z) 82) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]{2,}\.[a-z]{2,}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{1,4}(\.[0-9]{1,2}?)?"))))
(assert (or (str.contains x "ondblclic") (not (= (str.indexof z "ne" 0) 6))))
(assert (str.prefixof "<x " x))
(check-sat)
