; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "eval(location.hash.slice(1)>#alert(1)") (= x "<sVg><scRipt >alert&lpar;1&rpar; {Opera}")))
(assert (or (= z "ontenteditable>test</title>") (= z "ript>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(([V]|[v]|\s){1})([0-9]{12})"))))
(assert (or (not (str.contains z "est</titl")) (not (>= (str.len y) 42)) (not (= "< <scRipt >alert&lpar;1&rpar; {Opera}" (str.replace x "sVg>" " ")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z .]+"))) (= (str.at z 3) "d")))
(assert (not (>= (str.len z) 18)))
(assert (or (not (str.suffixof "e>" y)) (not (str.contains (str.replace y " {Op" "") "r;era}o")) (str.contains (str.replace z "le>" "javascript:") "tabjavascript:test<")))
(assert (or (not (str.prefixof "eval(" y)) (str.prefixof "<strong " x)))
(assert (not (= (str.at z 20) "/")))
(check-sat)
