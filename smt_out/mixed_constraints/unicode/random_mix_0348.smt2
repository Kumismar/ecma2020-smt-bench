; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br onbeforepaste=""alert(1)"" contenteditable>test</br>") (= x "<tr onmouseout=""alert(1)"">test</tr>")))
(assert (or (= z "</body \u{1f4a9}onMouseMove>") (= z "/caption>")))
(assert (= y (str.++ x z)))
(assert (str.contains y "onmo"))
(assert (or (str.contains y "bo") (not (= (str.at x 16) "a"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[1-9]{1}$"))) (not (str.prefixof "<br o" y)) (not (= (str.at z 8) "o"))))
(assert (or (not (str.contains x "eo")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9~@#$^/*()_+=<>[\]{}|\\,.?: -]*$"))) (= (str.at y 25) "1")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z \s]+$"))))
(check-sat)
