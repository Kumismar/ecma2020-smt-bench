; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param onmousemove=""alert(1)"">test</param>") (= x "<multicol id=x tabindex=1 onbeforedeactivate=alert(1)></multicol><input autofocus>")))
(assert (or (= z "er=alert(1) contenteditable>drop here</figure>") (= z "test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "\d+(\.\d+)?"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]{1,62}(?:\.[a-zA-Z0-9-]{1,62}){1,3}$"))) (str.contains y "en")))
(assert (or (= (str.at y 120) "/") (str.prefixof "<styl" x) (str.contains z "ere</figur")))
(assert (or (= (str.indexof z "a>" 0) 6) (= (str.at y 71) " ") (not (= "ea id=x st" (str.substr z 37 10)))))
(assert (not (str.contains y "able>drop ")))
(assert (or (not (str.contains (str.replace x "(1)" """") "rt""></")) (not (str.contains (str.replace x "ale" """") "ove=""""rt(1"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\d\.,]+$"))))
(check-sat)
