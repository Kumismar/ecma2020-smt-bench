(assert (or (= "<img src=x\x09onerror<b>avascript:alert(1)"">" (str.replace x "=""j" "<b>")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?!.+@(gmail|google|yahoo|outlook|hotmail|msn)\..+).+@.+\..+$"))) (not (= "(1)""<b>st</hr>" (str.replace z ">te" "<b>")))))
