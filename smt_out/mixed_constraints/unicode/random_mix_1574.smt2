; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe id=x tabindex=1 onbeforeactivate=alert(1)></iframe>") (= x "<dt oncontextmenu=""alert(1)"">test</dt>") (= x "<link draggable=""true"" ondragend=""alert(1)"">test</link>")))
(assert (or (= z "=alert(1) tabindex=1 id=x></canvas><input autofocus>") (= z "org/xss.htc);"";>;") (= z "/form>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) ".{0}|.{2,8}")) (str.contains z "rt(1)""")))
(assert (or (str.suffixof "</option>" x) (not (>= (str.len y) 57))))
(assert (or (not (= "vate" (str.substr x 36 4))) (not (= "m>" (str.replace z "/for" "")))))
(assert (or (not (= (str.at z 3) "r")) (= (str.at x 22) "0")))
(assert (or (not (str.prefixof "<ifra" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[a-zA-Z\d\w\W]{6,}$"))) (not (str.contains y "/embed>tof"))))
(assert (or (not (= (str.indexof y """;" 0) 51)) (not (str.suffixof "l>" x))))
(check-sat)
