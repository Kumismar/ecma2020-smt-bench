; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee onbeforecopy=""alert(1)"" contenteditable>test</marquee>") (= x """ \u{1f600}on\u{1f4a9}focus=alert(document.domain) ""> <""")))
(assert (or (= z "ntenteditable>test</dir>") (= z " onmousedown=""alert(1)"">test</button>") (= z "useover=""alert(1)"">test</ol>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_ +-,.?]{3,}$"))))
(assert (not (= "test<" (str.substr y 49 5))))
(assert (str.suffixof "</dir>" y))
(assert (or (not (= (str.indexof y "over=" 0) 66)) (str.prefixof """ \u{1f600}on\u{1f4a9}" x)))
(assert (or (not (= (str.len x) 63)) (not (= "<marquee onbeforecopy=""a""(1)"" contenteditable>test</marquee>useover=""alert(1)"">test</ol>" (str.replace y "lert" """"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z. ]*$")))))
(assert (or (= (str.at z 8) """") (str.contains (str.replace y "docum" "") "(e")))
(assert (>= (str.len z) 24))
(assert (str.contains x ">test</ou"))
(assert (or (= (str.indexof x "t(d" 0) 16) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(\+\d{1,2}\s)?\(?\d{1,4}\)?[\s.-]?\d{2,4}[\s.-]?(\d{1}[\s.-]?)*$")))))
(check-sat)
