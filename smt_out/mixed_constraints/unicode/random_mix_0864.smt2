; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea autofocus onfocusin=alert(1)>test</textarea>") (= x "<video autoplay controls onpause=alert(1)><source src=""vali\u{1f4a9}dvideo.mp4"" type=""video/mp4""></video>") (= x "<dd oncopy=""alert(1)"" contenteditable>test</dd>")))
(assert (or (= z ")"" contenteditable>test</br>") (= z "le>test</thead>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]+$")))
(assert (not (str.prefixof "<dd o" x)))
(assert (<= (str.len x) 65))
(assert (= "op" (str.substr y 7 2)))
(assert (or (not (str.contains (str.replace x "ale" "alert(1)") "py=""alert(1)rt")) (str.suffixof """></video>" x)))
(assert (<= (str.len z) 29))
(assert (or (not (str.prefixof "<vi" x)) (not (= (str.at x 25) "1"))))
(assert (or (= (str.at y 3) "d") (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z ].+ \d{5} [a-zA-Z ].+$")) (not (= (str.indexof z "ary>" 0) 0))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[\W\w\s]{4,}"))) (str.contains z ">")))
(check-sat)
