; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas oncopy=""alert(1)"" contenteditable>test</canvas>") (= x "<tbody draggable=""true"" ondragend=""alert(1)"">test</tbody>")))
(assert (or (= z "usemove=""alert(1)"">test</spacer>") (= z "draggable=""true"" ondrag=""alert(1)"">test</textarea>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "usemove=""a" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9+\(\)\.\s\/ext-]+$"))) (not (= "val(locati" (str.substr x 1 10)))))
(assert (not (= "<tbody dra""gable=""true"" ondragend=""alert(1)"">test</tbody>usemove=""alert(1)"">test</spacer>" (str.replace y "g" """"))))
(assert (= "<li draggable=""true"" ondrag=""ale<b>(1)"">test</li>ge.png onload=alert(1)>" (str.replace y "rt" "<b>")))
(assert (or (= "<aside onbeforepaste=""alert(1)"" contenteditable>test</aside>nblur=alert(1) tabindex=1 id /hgroup><input autofocus>" (str.replace y "=x><" " ")) (str.prefixof "usemo" z) (not (= "er>" (str.substr z 29 4)))))
(assert (>= (str.len x) 66))
(assert (= (str.at y 18) "t"))
(check-sat)
