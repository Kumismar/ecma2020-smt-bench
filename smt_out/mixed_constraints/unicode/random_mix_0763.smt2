; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var onmouseleave=""alert(1)"">test</var>") (= x "<IMG SRC=x oninput=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "sitioncancel=alert(1)></bdo>") (= z "ontenteditable>test</audio>") (= z "itioncancel=alert(1)></ol>")))
(assert (= y (str.++ x z)))
(assert (or (= "rcset" (str.substr y 6 5)) (not (str.prefixof "<var" x))))
(assert (or (= (str.at y 11) "o") (= (str.len x) 58) (str.suffixof "))"">" x)))
(assert (not (str.suffixof "t(1)></ol>" z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{12}|[0-9]{18}"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?[0-9]{2,6}[/\-]?[0-9]{2,12}$"))))
(check-sat)
