; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "eval(URL.slice(-8))>#alert(1)") (= x "<menu onclick=""alert(1)"">test</menu>") (= x "<picture oncopy=""alert(1)"" contenteditable>test</picture>")))
(assert (or (= z "t(1)></nextid><input autofocus>") (= z "onkeypress=""alert(1)"" contenteditable>test</script>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (= ">" (str.substr z 0 1))))
(assert (not (str.suffixof "pt>" y)))
(assert (or (not (= (str.at z 1) """")) (str.suffixof "focus>" y) (not (str.contains (str.replace y "t" "javascript:") "erjavascript:(1)"""))))
(assert (or (not (str.prefixof "<menu oncl" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\+42(0|1) ?|0)?([1-9]{1}[0-9]{2} ?[0-9]{3} ?[0-9]{3})$")))))
(assert (str.prefixof "t(1)></ne" z))
(assert (str.suffixof "alert(1)" x))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Z \d-]{4,10}$"))))
(assert (not (= (str.indexof z "rt(1" 0) 17)))
(assert (= "<picture oncopy=""alert(1)"" contenteditable>t/picture>" (str.replace x "est<" "")))
(check-sat)
