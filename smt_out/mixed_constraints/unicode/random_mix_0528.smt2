; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col draggable=""true"" ondragstart=""alert(1)"">test</col>") (= x "<meter id=x tabindex=1 onbeforeactivate=alert(1)></meter>")))
(assert (or (= z "alert(1)></legend>") (= z "enuitem>") (= z "rue"" ondragend=""alert(1)"">test</video>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len x) 56)))
(assert (or (str.suffixof "urce>" y) (not (str.suffixof "test</col>" x))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:\d{4})$"))))
(assert (not (str.suffixof "eo>" y)))
(assert (not (= "q>" (str.substr z 13 6))))
(assert (or (not (= "d=" (str.substr x 8 2))) (not (= (str.at z 1) "n")) (= "ndrag" (str.substr z 6 5))))
(assert (or (not (= (str.len x) 57)) (>= (str.len y) 85)))
(check-sat)
