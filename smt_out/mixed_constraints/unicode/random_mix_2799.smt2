; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1d400}dd oncut=""alert(1)"" contenteditable>test</dd>") (= x "<style>@keyframes x{}</style><input style=""animation-name:x"" onanimationstart=""alert(1)""></input>")))
(assert (or (= z "=alert(1)></shadow><input id=y autofocus>") (= z "le=""animation-name:x"" onanimationstart=""alert(1)""></command>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "rt(1)""></i")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[1-9]{1,15}")))))
(assert (>= (str.len y) 137))
(assert (or (not (str.prefixof "<style>" y)) (not (= "tionstart=" (str.substr x 68 10))) (= "<style>@keyframes x{<b>tyle><input style=""animation-name:x"" onanimationstart=""alert(1)""></input>=alert(1)></shadow><input id=y autofocus>" (str.replace y "}</s" "<b>"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\+?\d{6,14}$|^\(?\+?\d{1,3}\)?[ \-]?\d{3,4}[ \-]\d{3,4}([ \-]\d{3,4})?$"))) (not (str.contains (str.replace y "ey" """") "n onk""up"))))
(assert (not (= (str.at z 48) """")))
(check-sat)
