; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select onmouseenter=""alert(1)"">test</select>") (= x "<progress onbeforepaste=""alert(1)"" contenteditable>test</progress>")))
(assert (or (= z "P-EQUIV=""Link"" Content=""<javascript:alert('XSS')>; REL=stylesheet"">") (= z "r:red;}</style><keygen id=x s\u{20000}tyle=""transition:color 1s"" ontransitionend=alert(1)></keygen>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 24) "e") (not (= (str.at x 21) "t")) (str.prefixof "r" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(((0[1-9]|[12][0-9]|3[01])[/](0[13578]|1[02])|(0[1-9]|[12][0-9]|30)[/](0[469]|11)|(0[1-9]|1\d|2[0-8])[/]02)[/]\d{4}|29[/]02[/](\d{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[1359][26])00))$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%\x26'*+\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$")))))
(assert (not (str.contains (str.replace z "lor 1" """") ":co""s")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[^':]*$")) (>= (str.len y) 147)))
(check-sat)
