; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><strike ondragover=alert(1) contenteditable>drop here</strike>") (= x "<body onresize=alert(1)>press F12!") (= x "<head draggable=""true"" ondragleave=""alert(1)"">test</head>")))
(assert (or (= z "nerror\x09=javascript:alert(1)>") (= z "ert(1)"" contenteditable>test</marquee>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[^@]+@[^@]+[.]{1}[^@]{2,}$")) (not (str.contains (str.replace y "nres" "alert(1)") " oalert(1)ize=a")) (not (str.prefixof "1)></xmp>" z))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\w{11,}$"))) (not (= "<div draggable=""true"" co tenteditable>drag me</div><strike ondragover=alert(1) contenteditable>drop here</strike>" (str.replace x "n" " "))) (not (str.prefixof "<s" x))))
(assert (not (str.suffixof "quee>" y)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^(7)$")) (= (str.at y 29) "e") (not (= "=""tru" (str.substr x 14 5)))))
(assert (or (not (= "<svg><![CDATA[><image xlinxhref=""]]><img src=xx:x onerror=alert(2)//""></svg>//[""'`-->]]>]</div>l>" (str.replace y "k:" "x"))) (str.prefixof "ert(1)"" " z)))
(assert (not (= (str.indexof z "arq" 0) 31)))
(check-sat)
