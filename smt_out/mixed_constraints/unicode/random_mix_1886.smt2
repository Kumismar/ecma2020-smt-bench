; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><optgroup style=""animation-name:x"" onanimationstart=""alert(1)""></optgroup>") (= x "<caption draggable=""true"" ondragend=""alert(1)"">test</caption>")))
(assert (or (= z "rt(1)"">test</address>") (= z "mouseup=""alert(1)"">test</col>") (= z "//www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"">")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 126) (= (str.at z 19) "t") (not (= (str.indexof x "d=""al" 0) 34))))
(assert (or (= (str.at x 19) """") (= "a" (str.substr y 13 1)) (not (<= (str.len y) 135))))
(assert (not (= (str.indexof x "ions" 0) 72)))
(assert (or (not (str.contains x "abindex=1 ")) (= (str.at z 3) "1")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*(.[a-z]{2,})$"))))
(assert (not (str.suffixof "</col>" y)))
(check-sat)
