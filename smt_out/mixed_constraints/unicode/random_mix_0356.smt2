; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col onclick=""alert(1)"">test</col>") (= x "<applet onclick=""alert(1)"">test</applet>")))
(assert (or (= z "=""alert(1)"" contenteditable>test</samp>") (= z "tart=""alert(1)"">test</s>") (= z "e>test</td>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "e]"">" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])(?!.\n)(?!.*\s).{6,}")))))
(assert (= (str.len y) 51))
(assert (or (not (= "ol>" (str.substr x 31 3))) (not (str.contains (str.replace y "ert" "") """al("))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*(\S+\s+){0,4}\S*$"))) (not (= (str.indexof z "le>" 0) 25)) (not (= "applet o" (str.substr y 1 8)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1990-2020]*$"))) (not (= "nclick=" (str.substr y 9 7)))))
(assert (or (not (str.contains y "ocu")) (str.contains z "ble>test<") (<= (str.len y) 89)))
(assert (not (= (str.len z) 11)))
(check-sat)
