; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta onbeforecut=""alert(1)"" contenteditable>test</meta>") (= x "'""></title><script>alert(1337)</script>><marquee><h1>XSS by xss</h1></marquee>") (= x "<IMG SRC=x ondurationchang\u{1f600}e=""al\u{1f4a9}ert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "h1></marquee>") (= z "est</dt>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len y) 141)) (str.contains y "t</dt")))
(assert (or (str.contains z "</m") (not (= (str.indexof y "XSS " 0) 53))))
(assert (or (not (= (str.indexof y "))"">h" 0) 65)) (not (= "'""></title><alert(1)cript>alert(1337)</script>><marquee><h1>XSS by xss</h1></marquee>h1></marquee>" (str.replace y "s" "alert(1)")))))
(assert (or (str.prefixof "'""></tit" y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{8}[a-zA-Z]{1}$"))) (not (str.suffixof "uee>" x))))
(assert (or (not (str.contains y "ationcha")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{3,4}(\d{6})((\D|\d){8})?$")))))
(assert (or (str.suffixof "</marquee>" x) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\d\s\w&\-.]{3,}$"))) (not (= (str.at z 5) "m"))))
(assert (not (= (str.at z 4) "/")))
(check-sat)
