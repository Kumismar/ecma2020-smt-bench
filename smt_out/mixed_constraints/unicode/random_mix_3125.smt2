; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite oncut=""alert(1)"" contenteditable>test</cite>") (= x "--><!--*{color:red}   /* all UA */") (= x "<template onmouseenter=""alert(1)"">test</template>")))
(assert (or (= z "/marquee>") (= z "epaste=""alert(1)"" contenteditable>test</content>") (= z "m oncopy=""alert(1)"" contenteditable>test</param>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "us" 0) 14)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{2,12}$"))) (not (str.suffixof ">" z))))
(assert (or (str.prefixof "m oncopy=""" z) (= "<template""nmouseenter=""alert(1)"">test</template>" (str.replace x " o" """"))))
(assert (str.prefixof "<a href=" y))
(assert (or (= (str.at x 14) "u") (not (= (str.at y 32) "*")) (= "t\x0Atype=""text/javascript""""script:alert(1);</script>" (str.replace z ">java" """"))))
(assert (= (str.len x) 49))
(assert (str.contains (str.replace y "py=""" """") "co""alert"))
(check-sat)
