; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<center onmouseout=""alert(1)"">test</center>") (= x "<h1 onblur=alert(1) tabindex=1 id=x></h1><input autofocus>")))
(assert (or (= z "style><hr id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></hr>") (= z "ndrop=alert(1) contenteditable>drop here</nextid>") (= z "ert(1)"">test</col>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 17) "n")) (= (str.indexof z "l>" 0) 16) (str.suffixof "est</col>" y)))
(assert (or (= (str.indexof x "><i" 0) 40) (str.in_re y ((_ re.from_regex ecma2020 u) "^(?!\s*$)[-a-zA-Z_.\s]{1,100}$"))))
(assert (= (str.at z 38) " "))
(assert (not (str.prefixof "ert(1)"">te" z)))
(assert (or (str.contains x "sed") (= (str.len z) 77) (not (= "<center onmouseout=alert(1)"">test</center>" (str.replace x """" "")))))
(check-sat)
