; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb onkeypress=""alert(1)"" contenteditable>test</rb>") (= x "<q id=x tabindex=1 onactivate=alert(1)></q>") (= x "<image src=validimage.png onloadend=alert(1)>")))
(assert (or (= z "/embed>") (= z "ll*/red/*all*/;/[0]*IE,Safari*[0]/color:green;color:bl/*IE*/ue;}</style>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\+?[\-\u{30fc}\u{ff0d}\u{ff10}-\u{ff19}0-9]+$"))))
(assert (or (not (= (str.at y 17) "m")) (= (str.indexof y " on" 0) 18)))
(assert (or (not (str.contains (str.replace y "ont" " ") "1)"" c en")) (not (= (str.indexof z ":bl/" 0) 51))))
(assert (or (not (str.suffixof "le>" y)) (str.suffixof ";}</style>" z)))
(assert (or (not (str.suffixof "mbed>" z)) (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z][a-zA-Z ]+[a-zA-Z]$"))))
(check-sat)
