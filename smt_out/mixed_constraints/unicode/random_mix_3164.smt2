; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot onmouseup=""alert(1)"">test</tfoot>") (= x "<style\u{1d400} onmou\u{10348}seenter=""alert(1)"">test</style>")))
(assert (or (= z "header>") (= z "1)"">test</image>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "image>" y))
(assert (= "ouseup=""" (str.substr x 10 8)))
(assert (or (not (>= (str.len x) 37)) (not (= "mage>" (str.substr z 11 10)))))
(assert (or (not (str.contains (str.replace z "heade" "<b>") "<b>r>")) (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z\s]+")) (not (str.contains z "ea"))))
(assert (or (str.contains (str.replace y "t on" """") "<tfoo""mouse") (not (str.prefixof "<style\u{1d400} " x))))
(check-sat)
