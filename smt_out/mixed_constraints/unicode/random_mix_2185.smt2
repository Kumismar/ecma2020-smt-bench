; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<STYLE>.XSS{background-image:url(""javascript:javascript:alert(1)"");}</STYLE><A CLASS=XSS></A>") (= x "<table oncontextmenu=""alert(1)"">test</table>")))
(assert (or (= z "abel onpaste=""alert(1)"" contenteditable>test</label>") (= z "tes\u{1d400}t</caption>") (= z "IMG SRC=x onblur=""alert(String.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 11) "e")) (= "ing.from" (str.substr y 120 8))))
(assert (or (not (str.suffixof "m>" x)) (= "<table oncontextmenu=""alert(1)"">test</table>abel onpaste=""alert(1)"" contenteditabl""est</label>" (str.replace y "e>t" """")) (str.prefixof "<table o" x)))
(assert (or (not (= "rt" (str.substr x 25 2))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9A-Za-z@._-]+$")))))
(assert (or (not (= (str.at z 28) "*")) (= (str.indexof y "3))""" 0) 95)))
(assert (or (= (str.indexof x "tedit" 0) 28) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((?!\.{2}\/|\.{2}\\|\.\/|\.\\|\.{2}).)*$")))))
(assert (str.contains (str.replace z "x o" " ") " SRC= n"))
(check-sat)
