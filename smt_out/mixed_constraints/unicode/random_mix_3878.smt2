; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#000060") (= x "<script>Object.__noSuchMethod__ = Function,[{}][0].constructor._('javascript:alert(1)')()</script>") (= x "<a draggable=""true"" ondragend=""alert(1)"">test</a>")))
(assert (or (= z "1 onbeforeactivate=alert(1)></summary>") (= z "(1) tabindex=1 id=x></tbody><input autofocus>") (= z "y controls onvolumechange=alert(1)><source src=""validaudio.wav"" type=""audio/wav""></audio>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "slot>" 0) 18) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d+([.]\d{0,2}){0,1}$")))))
(assert (or (not (= (str.at z 41) "e")) (= "=x>" (str.substr y 25 3)) (not (str.contains (str.replace z "t1" """") "emen"""">"))))
(assert (or (not (str.suffixof "utofocus>" y)) (not (= (str.at z 64) "t"))))
(assert (or (not (str.suffixof "focus>" z)) (<= (str.len z) 10) (str.in_re y ((_ re.from_regex ecma2020 u) "^[_0-9]{10,10}$"))))
(check-sat)
