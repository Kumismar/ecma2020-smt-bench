; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link ondblclick=""alert(1)"">test</link>") (= x "<legend onkeypress=""alert(1)"" contenteditable>test</legend>") (= x "<object data=""data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg=="">")))
(assert (or (= z "spacer>") (= z ">test</i>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "data:tex")))
(assert (not (= (str.indexof x "ta" 0) 13)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9()+\s]{9,25}$"))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$")) (str.contains x "draggable=")))
(assert (or (str.suffixof "er>" z) (= "t(1" (str.substr x 24 3))))
(assert (or (= "D5hb" (str.substr y 45 4)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[^\.]+$"))))
(assert (or (not (= (str.len x) 74)) (str.suffixof "nk>spacer>" y)))
(assert (or (not (str.contains (str.replace y "dat" " ") "t  a=")) (not (>= (str.len x) 38))))
(assert (or (= (str.at x 20) "a") (str.suffixof "/i>" z)))
(check-sat)
