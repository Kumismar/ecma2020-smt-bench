; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><select ondrop=alert(1) contenteditable>drop here</select>") (= x "<keygen onmouseout=""alert(1)"">test</keygen>") (= x "<listing ondblclick=""alert(1)"">test</listing>")))
(assert (or (= z "</footer>") (= z "ad=alert(1)></sup>") (= z " oncut=""alert(1)"" contenteditable>test</title>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "ditab" "x") "tentexle>")) (not (= "d" (str.substr y 61 1))) (= (str.indexof z "/ti" 0) 39)))
(assert (or (<= (str.len z) 54) (not (str.contains x "asc"))))
(assert (or (>= (str.len z) 15) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9+\s]+$")))))
(assert (= "lert(1)""" (str.substr x 22 8)))
(assert (or (not (= "alert(" (str.substr y 21 6))) (= (str.at z 0) "<")))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z '-]+$")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^(?:\d{4}[\-]\d{2}[\-]\d{2})$")) (str.suffixof "kbd>" y) (str.prefixof "ad" z)))
(assert (not (= (str.len z) 9)))
(check-sat)
