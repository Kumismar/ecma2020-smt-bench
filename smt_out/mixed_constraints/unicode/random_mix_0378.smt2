; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<big onmouseout=""alert(1)"">test</big>") (= x "<style>:target {transform: rotate(180deg);}</style><body id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></body>")))
(assert (or (= z ";no\xss:noxss("";*//*"";);") (= z "rue"" contenteditable>drag me</div><hgroup ondragover=alert(1) contenteditable>drop here</hgroup>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z]{3,10}$"))) (str.contains x "si")))
(assert (not (= "ig>" (str.substr x 34 6))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z -\u{df} -\u{e4} -\u{f6} -\u{fc}]{2,100}"))))
(assert (or (not (= (str.len z) 96)) (str.contains (str.replace y "n" "<b>") "tra<b>s") (not (str.contains x "un=ale"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w.%+-]+@([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,6}$"))) (not (str.prefixof "<big onm" x))))
(check-sat)
