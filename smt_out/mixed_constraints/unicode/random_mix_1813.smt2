; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<audio onmousedown=""alert(1)"">test</audio>") (= x "<br ondblclick=""alert(1)"">test</br>") (= x "<multicol onmouseleave=""alert(1)"">test</multicol>")))
(assert (or (= z "blclick=""alert(1)"">test</iframe>") (= z "copy=""alert(1)"" contenteditable>test</marquee>") (= z "br>")))
(assert (= y (str.++ x z)))
(assert (or (= "<style>:target {color:red;}</stylxabel id=x style=""transition:color 1s"" ontransitionend=alert(1)></label>ress>" (str.replace y "e><l" "x")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[,\s0-9]+"))) (str.suffixof "()" x)))
(assert (or (not (str.contains (str.replace x "au" "") "<dio o")) (not (str.contains (str.replace x " " "<b>") "<br<b>o")) (not (str.prefixof """>test<" z))))
(assert (or (not (<= (str.len z) 19)) (not (str.suffixof "arquee>" y)) (not (str.suffixof "col>br>" y))))
(assert (or (not (<= (str.len x) 54)) (not (>= (str.len x) 43)) (not (str.prefixof "<" y))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^\+[0-9\s]{6,20}$")) (str.prefixof "<audio o" x) (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$"))))
(check-sat)
