; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source onkeydown=""alert(1)"" contenteditable>test</source>") (= x "<nobr onkeypress=""alert(1)"" contenteditable>test</nobr>")))
(assert (or (= z "click=""alert(1)"">test</u>") (= z "ert(1)"" contenteditable>test</dialog>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z.-]+\.[a-z]{2,}$"))) (= (str.at x 21) "e")))
(assert (or (str.suffixof "g>" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(\w[-._\w]*\w@\w[-._\w]*\w\.\w{2,3})"))) (not (str.suffixof "test</u>" z))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0]*[1-9][0-9]{4,5}$"))))
(assert (or (>= (str.len z) 30) (<= (str.len x) 60)))
(assert (or (not (= (str.indexof x " co" 0) 27)) (not (= (str.len y) 80)) (not (str.prefixof "click=""al" z))))
(assert (or (= "1)" (str.substr y 71 2)) (str.contains y "keydown=")))
(assert (not (= (str.at z 34) "o")))
(check-sat)
