; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><th style=""animation-name:x"" onanimationend=""alert(1)""></th>") (= x "<option onmousemove=""alert(1)"">test</option>") (= x "<? foo=""><script>javascript:alert(1)</script>"">")))
(assert (or (= z "1)></em>") (= z "ble>drop here</kbd>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<? foo" x)))
(assert (or (>= (str.len z) 11) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[- 0-9A-Za-z|\u{2122} ]+$"))) (not (str.contains (str.replace x "s" "javascript:") """><javascript:cr"))))
(assert (not (= "a" (str.substr x 42 1))))
(assert (or (not (str.suffixof "1)></em>" y)) (>= (str.len z) 1) (= (str.len z) 19)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[a-zA-Z])(?=\w*[0-9])\w{6,12}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,3})$"))) (= "1) >" (str.replace z "></em" " "))))
(check-sat)
