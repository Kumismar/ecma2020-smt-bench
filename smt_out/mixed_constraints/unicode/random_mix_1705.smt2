; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>d.innerHTML+='';</script>//[""'`-->]]>]</div>") (= x "<dfn id=x tabindex=1 onbeforeactivate=alert(1)></dfn>") (= x "<ruby draggable=""true"" ondragenter=""alert(1)"">test</ruby>")))
(assert (or (= z " contenteditable>\u{1f4a9}drop here</multicol>") (= z "nkeydown=""alert(1)"" contenteditable>test</kbd>") (= z "id draggable=""true"" ondragend=""alert(1)"">test</nextid>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 4) "t")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{454}\u{404}\u{457}\u{407}\u{406}\u{456}Ii\u{490}\u{491}\u{2018}'\u{2019}\u{b4}`\s]+$")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9_\u{5c}u00C0-\u{5c}u00D6\u{5c}u00D8-\u{5c}u00F6\u{5c}u00F8-\u{5c}u1FFF]+([-+.']*[A-Za-z0-9_\u{5c}u00C0-\u{5c}u00D6\u{5c}u00D8-\u{5c}u00F6\u{5c}u00F8-\u{5c}u1FFF]+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*$"))))
(assert (= (str.len y) 99))
(assert (str.contains (str.replace y "tedi" "") "ntable"))
(assert (not (str.contains (str.replace x "stin" "") "ig id")))
(assert (str.contains y "keydo"))
(assert (>= (str.len z) 29))
(check-sat)
