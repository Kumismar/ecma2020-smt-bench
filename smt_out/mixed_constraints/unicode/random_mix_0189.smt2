; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onmouseleave=""alert(1)"">test</sup>") (= x "}</style><script>a=eval;b=alert;a(b(/XSS/.source));</script>") (= x "<style>@keyframes x{}</style><code style=""animation-name:x"" onanimationend=""alert(1)""></code>")))
(assert (or (= z "/link><input autofocus>") (= z ")"">test</img>") (= z "*")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{0,65}$"))) (not (str.suffixof ">" y))))
(assert (or (not (str.prefixof "<object id" y)) (not (= "<style>@keyframes x{}</style><codtyle=""animation-name:x"" onanimationend=""alert(1)""></code>)"">test</img>" (str.replace y "e s" ""))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?:\d*\.)?\d+")))))
(assert (not (= ")"">te" (str.substr z 0 5))))
(assert (= (str.indexof y "e sty" 0) 33))
(assert (or (str.prefixof "<style>" x) (>= (str.len x) 58)))
(assert (or (>= (str.len x) 60) (not (= (str.at y 35) "s")) (not (= (str.at y 21) "a"))))
(assert (= "(/XSS/.so" (str.substr x 35 9)))
(check-sat)
