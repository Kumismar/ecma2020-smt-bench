; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</di\u{1f600}v><br ondrop=alert(1) contenteditable>drop here</br>") (= x "<td onbeforec\u{10348}opy=""alert(1)"" contentedi\u{10348}table>test</td>") (= x "<p draggable=""true"" ondragend=""alert(1)"">test</p>")))
(assert (or (= z "l>") (= z "om/ogle.com/&quot;&gt;XSS&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "om/ogl" z)) (= (str.len z) 35)))
(assert (or (= (str.at y 10) "l") (not (= "e=""tr" (str.substr y 13 5))) (= (str.at y 53) "a")))
(assert (or (str.suffixof "t;" y) (not (str.contains y """true"" ond")) (not (= "st</p" (str.substr x 43 5)))))
(assert (or (= (str.at y 66) ">") (>= (str.len x) 44) (str.prefixof "<;IMG S" x)))
(assert (or (not (= "/br>" (str.substr x 98 9))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[\d\.,]+$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{5,}")))))
(check-sat)
