; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var oncut=""alert(1)"" contenteditable>test</var>") (= x "<element id=x tabindex=1 onfocusin=alert(1)></element>")))
(assert (or (= z "1)"">test</tbody>") (= z "x%3D1")))
(assert (= y (str.++ x z)))
(assert (or (= "lert(1)"" " (str.substr x 13 9)) (= (str.at x 42) "<") (not (str.prefixof "<;SCRIPT " x))))
(assert (or (= (str.indexof x "t" 0) 9) (str.prefixof "<" x) (>= (str.len z) 13)))
(assert (or (not (str.suffixof "tbody>" y)) (not (= "ck=""alert(" (str.substr x 10 10)))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "(U\+)?(10|[0-9A-Fa-f])?[0-9A-Fa-f]{1,4}")) (str.in_re z ((_ re.from_regex ecma2020 u) "[\d\-]{8,}\d$"))))
(assert (or (= (str.indexof y "/ul>" 0) 43) (not (= "st</var" (str.substr y 40 7)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?!\s*$)[a-zA-Z\s]{1,50}$"))) (= (str.at x 31) "i") (not (str.suffixof "%3D1" y))))
(check-sat)
