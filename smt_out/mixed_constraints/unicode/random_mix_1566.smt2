(assert (or (= x "<ul oncopy=""alert(1)"" contenteditable>test</ul>") (= x "<HEAD><META HTTP-EQUIV=""CONTENT-TYPE"" CONTENT=""text/html; charset=UTF-7""> </HEAD>+ADw-SCRIPT+AD4-alert('XSS');+ADw-/SCRIPT+AD4-")))
(assert (or (= z "83,83))"">") (= z "ert(1)") (= z "teditable>test</div>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "))"">" (str.substr z 5 7))) (str.contains (str.replace z "v" """") "di"">")))
(assert (= (str.at y 9) "n"))
(assert (or (str.contains (str.replace y "t=UT" "<b>") "e<b>F-7") (not (str.suffixof "3,83))"">" y))))
(assert (not (= (str.indexof x "/html" 0) 51)))
(assert (or (str.contains y "yle>:targe") (>= (str.len x) 37)))
(assert (or (= "te" (str.substr x 25 2)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:[3]{1,1}){1}[0-9]{9,9}$")))))
(assert (or (str.prefixof "<ul" x) (= (str.at y 65) "=")))
(assert (or (str.suffixof "PT+AD4-" x) (= (str.indexof y "+A" 0) 81)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 +]{3,}"))))
(check-sat)
