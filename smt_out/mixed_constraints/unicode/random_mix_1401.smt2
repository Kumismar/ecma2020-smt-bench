; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdi onfocusout=alert(1) tabindex=1 id=x></bdi><input autofocus>") (= x "<form onmousemove=""al\u{1f600}ert(1)"">te\u{1d400}st</form>")))
(assert (or (= z ">;") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 12) "o")) (not (str.prefixof "<form onm" x)) (not (>= (str.len z) 1))))
(assert (str.suffixof ">" z))
(assert (or (not (str.contains x "(1)"">te\u{1d400}st")) (str.in_re y ((_ re.from_regex ecma2020 u) "\d{0,3}")) (not (= (str.indexof z ">" 0) 0))))
(assert (or (not (= "<rt onmousemove=""alert(1)"">alert(1)/rt>" (str.replace x "test<" "alert(1)"))) (not (= (str.at z 1) ";"))))
(assert (not (= (str.at y 35) "<")))
(assert (or (str.suffixof "/strike>" z) (str.contains z ">;") (not (str.contains y "cusout=a"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((8|\+375)[\- ]?)?(\(?\d{2}\)?[\- ]?)?[\d\- ]{7,10}$"))))
(check-sat)
