; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><head style=""animation-name:x"" onanimationstart=""alert(1)""></head>") (= x "<image oncopy=""alert(1)"" contenteditable>test</image>") (= x "<marquee onkeydown=""alert(1)"" contenteditable>test</marquee>")))
(assert (or (= z "1)""></aside>") (= z "le=""true"" contenteditable>drag me</div><menu ondrop=alert(1) contenteditable>drop here</menu>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{2}[0-9]{6}$"))) (= "aside>" (str.substr y 66 6))))
(assert (or (= (str.indexof z "her" 0) 82) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z]{4}[0-9]{6}[A-Za-z]{6}[A-Za-z-0-9]{1}[0-9]{1}"))) (<= (str.len x) 61)))
(assert (not (str.prefixof "<image on" y)))
(assert (or (str.contains (str.replace z ") c" "") "(1onten") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z0-9-_\s]{1,30}$")))))
(check-sat)
