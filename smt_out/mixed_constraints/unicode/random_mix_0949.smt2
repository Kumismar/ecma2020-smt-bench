; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param onkeydown=""alert(1)"" contenteditable>test</param>") (= x "<img srcset=1 onerror=alert(1)>") (= x "<address onblur=alert(1) tabindex=1 id=x></address><input autofocus>")))
(assert (or (= z """>test</img>") (= z "lert(1)"">test</menu>") (= z "=1 onactivate=alert(1)></meter>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "=alert(1)>" x) (not (str.suffixof ">" y)) (= (str.indexof z "us" 0) 10)))
(assert (or (str.contains z "aut") (not (= "(1" (str.substr y 27 2)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^pass$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{6,13}$"))) (<= (str.len x) 31)))
(assert (not (= (str.indexof y "=a" 0) 15)))
(check-sat)
