; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter onclick=""alert(1)"">test</meter>") (= x "<style>@keyframes x{}</style><embed style=""animation-name:x"" onanimationend=""alert(1)""></embed>") (= x "<script> document.getElementById(%22safe123%22).setCapture(); document.getElementById(%22safe123%22).click(); </script>")))
(assert (or (= z ">") (= z "=""true"" ondragstart=""alert(1)"">test</base>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[5]+$"))))
(assert (or (not (= (str.at z 19) "=")) (not (= (str.indexof z ">" 0) 0))))
(assert (not (= (str.at x 2) "t")))
(assert (or (str.suffixof ">" z) (not (= (str.indexof x "ipt>" 0) 4))))
(assert (or (not (= (str.at y 116) "p")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[( )a-zA-Z]+$"))) (not (= "tt d" (str.substr y 1 4)))))
(assert (not (str.contains y "ames x{}<")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) ".{5,5}"))))
(check-sat)
