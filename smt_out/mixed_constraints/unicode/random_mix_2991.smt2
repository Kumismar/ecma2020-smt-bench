; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img srcset=validimage.png onload=alert(1)>") (= x "<output onmouseup=""alert(1)"">test</output>")))
(assert (or (= z "1)"" contenteditable>test</figure>") (= z "alist>")))
(assert (= y (str.++ x z)))
(assert (or (= "<colgroup onmousedown=xlert(1)"">test</colgroup>" (str.replace x """a" "x")) (= "oa" (str.substr x 30 2))))
(assert (not (str.prefixof "<ou" y)))
(assert (or (not (str.contains x ".png on")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{6,20}$")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z\u{c4}\u{e4}\u{d6}\u{f6}\u{dc}\u{fc}\u{df}])().{4,}"))) (not (= (str.at z 4) "t")) (not (str.contains (str.replace y " on" """") "e.png""load="))))
(check-sat)
