; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=jAVasCrIPt:alert(\u{2018}XSS\u{2019})>") (= x "<span onmouseover=""alert(1)"">test</span>")))
(assert (or (= z "textmenu=""alert(1)"">test</bgsound>") (= z "tion>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<sp<b>n onmouseover=""alert(1)"">test</span>" (str.replace x "a" "<b>"))) (not (= (str.at z 10) "a")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?=.*?[a-zA-Z])(?=.*?\d)[a-zA-Z\d]{8,16}$")))))
(assert (or (= "span onm" (str.substr x 1 8)) (not (= (str.at x 5) " ")) (not (= ">" (str.substr y 66 8)))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{1,12}$"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9-+.,() _*/]{5,150}")) (= (str.indexof z "t" 0) 0)))
(assert (or (str.prefixof "<" x) (str.contains (str.replace x "pa" "<b>") "s<b>n ")))
(check-sat)
