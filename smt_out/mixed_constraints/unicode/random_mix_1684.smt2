; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;XSS STYLE="";xss:expression(alert(';XSS';))"";>;") (= x "<progress onmousele\u{10348}ave=""alert(1)"">test</p\u{1d400}rogress>") (= x "<? foo=""><script>javascript:alert(1)</script>"">")))
(assert (or (= z "ocusin=alert(1)></dialog>") (= z "t</style>") (= z "table>drag me</div><label ondragover=alert(1) contenteditable>drop here</label>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1-9]+\.?[0-9]*"))) (not (str.prefixof "<;XSS STY" x)) (str.contains (str.replace z "sty" "<b>") "t</<b>le>")))
(assert (or (str.contains y "label") (not (= (str.at x 29) "l")) (not (= (str.at z 47) "o"))))
(assert (not (str.contains z "ty")))
(assert (or (= (str.len x) 48) (= "table>drag me</div><labeldragover=alert(1) contenteditable>drop here</label>" (str.replace z " on" "")) (str.contains x "(1)""")))
(assert (str.prefixof "<" x))
(check-sat)
