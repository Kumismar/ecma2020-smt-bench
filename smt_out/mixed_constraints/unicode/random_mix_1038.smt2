; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<EMBED SRC=""http://ha.ckers.org/xss.swf"" AllowScriptAccess=""always""></EMBED>") (= x "&lt;")))
(assert (or (= z "drop=alert(1) contenteditable>drop here</p>") (= z "e><div id=x style=""transition:color 1s"" ontransitionend=alert(1)></div>") (= z "E=""xss:expression(javascript:alert(1))"">")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "sion" "x") "resx(jav") (not (= (str.at z 21) "e"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]{2,30}@[a-z0-9.-]{3,20}\.[a-z]{2,4}$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z.`'-]{2,24}( [A-Za-z0-9.`'-]{1,24}){0,5}")) (not (= (str.indexof x "s" 0) 26))))
(assert (or (not (= (str.at z 1) ">")) (str.contains x "ay")))
(assert (or (not (>= (str.len y) 37)) (= (str.at x 1) "l") (str.prefixof "e><div id=" z)))
(assert (or (= (str.indexof x ";" 0) 3) (str.suffixof ";" x) (not (str.suffixof "rea>" z))))
(assert (= (str.indexof y "on(j" 0) 91))
(check-sat)
