; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><source id=x style=""transition:color 1s"" ontransitionend=alert(1)></source>") (= x "<del onmouseover=""alert(1)"">test</del>")))
(assert (or (= z "hr onmousemove=""alert(1)"">test</hr>") (= z "ut=""alert(1)"">test</output>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 142) (not (= "mo" (str.substr x 7 2))) (not (str.prefixof "ut=""" z))))
(assert (or (not (= ">tes" (str.substr z 13 4))) (str.contains y "est</em>")))
(assert (or (not (= """>t" (str.substr z 12 3))) (str.prefixof "<s" y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^^[\u{30a1}-\u{30f3}\u{30f4}\u{30fc}]+$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9]).{8,}"))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "[\d\-( )]+$")))
(assert (= (str.at y 64) "f"))
(assert (or (not (= (str.at y 55) "t")) (= (str.at x 8) "o")))
(check-sat)
