; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt onfocusout=alert(1) tabindex=1 id=x></dt><input autofocus>") (= x "<\u{10348}meter onblur=alert(1) tabinde\u{1f600}x=1 id=x></meter><input autofocus>") (= x "<rtc id=x tabindex=1 onbeforedeactivate=alert(1)></rtc><input autofocus>")))
(assert (or (= z "s x{}</style><rb style=""animation-name:x"" onanimationstart=""alert(1)""></rb>") (= z "d=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 9) (= "l" (str.substr z 61 1))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "(((0)[1-9]{2}[0-9][-]?[1-9][0-9]{5})|((\+31|0|0031)[1-9][0-9][-]?[1-9][0-9]{6})|(((\+31|0|0031)6){1}[1-9]{1}[0-9]{7}))$"))))
(assert (or (not (str.contains y "s>d=y")) (= "<rtc id=x tabindex=1 onbeforedeactivate=alert(1)></rtc><input autofocus>s x{}</style><rb style=""a ion-name:x"" onanimationstart=""alert(1)""></rb>" (str.replace y "nimat" " "))))
(assert (or (not (str.contains y ">d=y a")) (= (str.len x) 89)))
(assert (or (str.prefixof "<dt onfo" y) (not (= "ocu" (str.substr y 81 3)))))
(assert (str.suffixof "(1)""></rb>" y))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9])(?=.*?[#?!@$%^&*-]).{8,}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,6}$")))))
(check-sat)
