; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer draggable=""true"" ondragenter=""alert(1)"">test</footer>") (= x "<IMG SRC=x oncuechange=""alert(String.fromCharCode(88,83,83))"">") (= x "<strong onkeyup=""alert(1)"" contenteditable>test</strong>")))
(assert (or (= z ";") (= z """alert(1)"">test</legend>") (= z "eleave=""alert(1)"">test</\u{20000}em>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len z) 36))
(assert (or (= "1)"" con" (str.substr x 17 7)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\w.%+-_]+@[\w.-]+\.[\w]{2,6}$"))) (not (str.contains y "ty"))))
(assert (= (str.at x 7) "C"))
(assert (str.prefixof "<I" y))
(assert (str.prefixof "<strong" x))
(assert (or (str.suffixof "/footer>" z) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\d+#\-*]{12}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d).{6,20}")))))
(check-sat)
