; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script/src=""data&colon;text%2Fj\u{5c}u0061v\u{5c}u0061script,\u{5c}u0061lert('\u{5c}u0061')""></script a=\u{5c}u0061 & /=%2F") (= x "<b draggable=""true"" ondragstart=""alert(1)"">test</b>") (= x "<th oncut=""alert(1)"" contenteditable\u{10348}>test</th>")))
(assert (or (= z """ AllowScriptAccess=""always"">") (= z "frame>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/b>" x)) (not (>= (str.len x) 48))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!\s*$)[a-zA-Z0-9\s@@(.,-_)]{1,50}$")))
(assert (not (<= (str.len z) 39)))
(assert (or (str.contains y """a") (str.prefixof "<sc" y) (= (str.at y 45) " ")))
(assert (not (= "cess=""" (str.substr z 15 6))))
(assert (not (= (str.indexof z """al" 0) 20)))
(assert (not (str.contains z "ess=""a")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(?!.*\d{7,}).*")) (not (str.contains (str.replace y "e" " ") "t=""al rt"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^SNB|snb$"))) (str.prefixof "<footer d" x)))
(check-sat)
