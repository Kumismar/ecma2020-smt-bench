; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main onclick=""alert(1)"">test</main>") (= x "<SCRIPT a="">'>"" SRC=""http://ha.ckers.org/xss.js""></SCRIPT>") (= x "\u{20000}&LT;")))
(assert (or (= z "ex=1 onactivate=alert(1)></nextid>") (= z "aonpageonpagonpageonpageshowshoweshowshowgeshow=""alert(1)"";") (= z " onkeydown=""alert(1)"" contenteditable>test</hr>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len y) 97)) (= "t(1)" (str.substr x 19 4))))
(assert (or (not (str.prefixof "<main on" y)) (not (= "T;" (str.substr x 3 4))) (not (str.prefixof "\u{20000}" x))))
(assert (= (str.at y 29) "X"))
(assert (or (= "ale" (str.substr x 15 3)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w\-\.]+@[\w\-\.]+(\.\w+)+$")))))
(assert (not (str.prefixof "aonpageonp" z)))
(check-sat)
