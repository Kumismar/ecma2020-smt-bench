; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style id=x tabindex=1 onfocus=alert(1)></style>") (= x "<figure onkeydown=""alert(1)"" contenteditable>test</figure>") (= x "<STYLE TYPE=""text/javascript"">javascript:alert(1);</STYLE>")))
(assert (or (= z "('XSS')"">") (= z "e=""true"" ondragleave=""alert(1)"">test</ol>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x " TY" 0) 6) (not (= (str.indexof y "e>@" 0) 5))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^(.){6,100}$")))
(assert (or (not (= "editable>t" (str.substr x 36 10))) (= (str.at x 6) " ")))
(assert (or (not (= (str.at y 21) "a")) (not (>= (str.len y) 86)) (not (= (str.indexof y "l" 0) 20))))
(assert (or (str.prefixof "e=""true""" z) (not (str.prefixof "<STYLE TY" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+[0-9]+$")))))
(assert (str.contains x "t"">javascr"))
(check-sat)
