; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base draggable=""true"" ondragleave=""alert(1)"">test</base>") (= x "<;STYLE>;@im\port';\ja\vasc\ript:alert("";XSS"";)';;<;/STYLE>;") (= x "<meta onmouseleave=""alert(1)"">test</meta>")))
(assert (or (= z "/summary>") (= z "est</thead>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(13[0-9]|14[5|7]|15[0|1|2|3|5|6|7|8|9]|18[0|1|2|3|5|6|7|8|9])[0-9]{8}$"))))
(assert (or (str.suffixof "ummary>" z) (not (str.prefixof "est</thead" z))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_]+(?:\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?!([a-zA-Z0-9]*\.[a-zA-Z0-9]*\.[a-zA-Z0-9]*\.))(?:[A-Za-z0-9](?:[a-zA-Z0-9-]*[A-Za-z0-9])?\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?"))) (not (<= (str.len y) 89)) (not (str.contains (str.replace x "st" " ") "e </b"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[A-Z])(?=.*[a-z])(?=.*\d).{6,}$")) (= (str.indexof z "/" 0) 0) (= (str.len z) 9)))
(assert (str.suffixof "summary>" z))
(check-sat)
