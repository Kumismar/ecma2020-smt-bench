; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\xE2\x80\x83javascript:alert(1)</script>") (= x "<audio onloadeddata=alert(1)><source src=""validaudio.wav"" type=""audio/wav""></audio>") (= x "<header onmouseout=""alert(1)"">test</header>")))
(assert (or (= z "ontextmenu=""alert(1)"">test</p>") (= z "1)//></style>") (= z "e=alert(1)></dfn>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 2) "t")))
(assert (or (not (str.prefixof "<" y)) (not (<= (str.len x) 53))))
(assert (not (str.prefixof """`'><scri" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(https?:\/\/)?((?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61})?)?[A-Za-z0-9]\\.)*[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z]{2,})?(\.[a-zA-Z]{2,})?\.[a-zA-Z]{2,}\/?(:[0-9]{1,5})?$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\(\)\+\- ]{3,45}$"))) (not (= (str.indexof z "1)//" 0) 0))))
(assert (or (str.prefixof "<blink on" y) (not (= "3javascri" (str.substr x 23 9)))))
(assert (or (not (= (str.indexof y ">/tra" 0) 59)) (not (str.contains y "1)</script"))))
(assert (= "rt(1)></df" (str.substr z 5 10)))
(assert (or (not (str.contains y "cript:")) (not (= (str.indexof z ")//" 0) 1))))
(check-sat)
