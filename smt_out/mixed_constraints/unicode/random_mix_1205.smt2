; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img onblur=alert(1) tabindex=1 id=x></img><input autofocus>") (= x "<img src=# onerror\x3D""javascript:alert(1)"" >") (= x "<basefont onkeyup=""alert(1)"" contenteditable>test</basefont>")))
(assert (or (= z "e draggable=""true"" ondragleave=""alert(1)"">test</title>") (= z "ter>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "gs to th")) (= (str.at y 44) ">") (str.contains z "e"" ondrag")))
(assert (not (str.prefixof "<img " x)))
(assert (or (not (= (str.indexof y "au" 0) 50)) (= "ble" (str.substr y 53 3)) (str.in_re x ((_ re.from_regex ecma2020 u) "^(.){4,100}$"))))
(assert (= (str.indexof y "t:" 0) 32))
(assert (not (= "<img onblur=alert(1) tabindex=1 id=x></img><i""autofocus>" (str.replace x "nput " """"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z]+([0-9a-zA-Z]*[-._+])*[0-9a-zA-Z]+@[0-9a-zA-Z]+([-.][0-9a-zA-Z]+)*([0-9a-zA-Z]*[.])[a-zA-Z]{2,6}$"))))
(assert (not (str.suffixof "us>ter>" y)))
(assert (not (= (str.indexof y "tab" 0) 39)))
(assert (= (str.len x) 60))
(assert (not (str.contains z "er>")))
(check-sat)
