; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<A href=""javascript%26colon;confirm()"">click") (= x "<script>document.write(""<SCRI"");</SCRIPT>PT\u{10348} SRC=""http://www.securitycompass.com/xss.js""></script>") (= x "<small oncopy=""alert(1)"" contenteditable>test</small>")))
(assert (or (= z "=""alert(1)"" contenteditable>test</menu>") (= z "1)"">test</span>") (= z """alert(1)"">test</details>")))
(assert (= y (str.++ x z)))
(assert (= "doc" (str.substr y 8 3)))
(assert (not (= "s" (str.substr z 6 1))))
(assert (not (str.suffixof "me onLoad>" y)))
(assert (not (= (str.at z 11) "p")))
(assert (or (= (str.indexof z "<" 0) 8) (<= (str.len x) 103) (= (str.at z 12) "a")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$"))) (not (= "<command id=x tabindex=1 onbeforeactivate=alert(x></command>" (str.replace x "1)" "x"))) (str.contains z "est</me")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9+]*$"))))
(check-sat)
