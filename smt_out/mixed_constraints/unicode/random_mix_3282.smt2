; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "'';!--\""&lt;XSS&gt;=&{()}") (= x "<svg onload=alert(1)\u{1f600}>") (= x "<script draggable=""true"" ondragenter=""alert(1)"">test</script>")))
(assert (or (= z "ick=""alert(1)"">test</area>") (= z "st</html>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len z) 9) (str.contains z "ick=""al")))
(assert (not (= ">" (str.substr z 8 3))))
(assert (not (>= (str.len y) 45)))
(assert (or (not (str.prefixof "<scr" x)) (not (= "}" (str.substr x 24 4)))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9A-Za-z@.\-_]+$")))
(assert (or (not (<= (str.len z) 10)) (not (= (str.at x 21) ">"))))
(check-sat)
