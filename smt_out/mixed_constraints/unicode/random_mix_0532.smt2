; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script onkeydown=""alert(1)"" contenteditable>test</script>") (= x "ABC<div style=""x:\xE2\x80\x8Aexpression(javascript:alert(1)"">DEF")))
(assert (or (= z "area>") (= z "ue"" contenteditable>drag me</div><nextid ondrop=alert(1) contenteditable>drop here</nextid>") (= z "ame>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "ABC<d" x)) (not (= "e" (str.substr z 12 1)))))
(assert (or (= (str.indexof y "expr" 0) 29) (str.in_re z ((_ re.from_regex ecma2020 u) "^.{4,}$"))))
(assert (or (not (= (str.indexof x ")""" 0) 58)) (str.contains y "\xE2\x80")))
(assert (= (str.indexof y "o" 0) 8))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[1-9][0-9]{4,}"))))
(assert (or (= "<caption" (str.substr x 0 8)) (not (str.prefixof "<sc" x))))
(assert (not (= (str.len z) 91)))
(assert (or (not (str.contains z "rea")) (not (str.contains y "<in"))))
(assert (not (= "<" (str.substr y 146 1))))
(check-sat)
