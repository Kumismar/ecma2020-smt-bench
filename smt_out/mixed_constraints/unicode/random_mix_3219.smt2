; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><img src=1 onerr\u{1f600}or=alert(1)>.gif") (= x "<body onload body onload=""javascript:javascript:alert(1)""></body onload>") (= x "<canvas oncut=""alert(1)"" contenteditable>test</canvas>")))
(assert (or (= z """>test</u>") (= z "e>test</noembed>")))
(assert (= y (str.++ x z)))
(assert (not (= "/noembed>" (str.substr z 7 9))))
(assert (or (str.contains z "t</noe") (str.contains (str.replace x "/ca" "x") "test<xn") (str.in_re z ((_ re.from_regex ecma2020 u) "^\s*\S+.*$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[\w\s-]{1,128}"))) (<= (str.len x) 38)))
(assert (not (str.contains z "te=ale")))
(assert (or (str.prefixof """><img" x) (= (str.indexof y "a" 0) 2)))
(assert (or (str.prefixof "<style>" x) (str.contains z "1)><") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{0,6}\/[1-9][0-9]30\/[1-9][0-9]{0,1}$")))))
(assert (not (= "nload bo" (str.substr y 7 8))))
(assert (str.suffixof "embed>" y))
(assert (not (>= (str.len z) 16)))
(check-sat)
