; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ins onmousedown=""alert(1)"">test</ins>") (= x "<<script>document.vulnerable=true;</script>")))
(assert (or (= z "lclick=""alert(1)"">test</meta>") (= z "tion>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<in" x)))
(assert (or (str.contains (str.replace z "ion" "x") "tx>") (not (str.suffixof "eta>" y)) (str.contains (str.replace y "/met" "alert(1)") "t<alert(1)a>")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]{2,}")))
(assert (or (not (str.prefixof "tion>" z)) (str.prefixof "<<script>" x) (= (str.at y 33) "/")))
(assert (or (= "a" (str.substr x 24 1)) (>= (str.len x) 41) (str.suffixof "st</meta>" z)))
(assert (or (not (= (str.indexof z "tion>" 0) 0)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z]\w{2,9}")))))
(assert (not (str.contains y "nmous")))
(assert (= (str.indexof y "e=t" 0) 27))
(check-sat)
