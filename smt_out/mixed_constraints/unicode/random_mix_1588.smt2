; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<command id=x tabindex=1 onfocus=alert(1)></command>") (= x "<form onmousemove=""al\u{1f600}ert(1)"">te\u{1d400}st</form>") (= x "<IMG SRC=x onplaying=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "ript:alert(1)\x20src=xxx:x />") (= z "mmary oncopy=""alert(1)"" contenteditable>test</summary>") (= z "ter=""alert(1)"">test</textarea>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x " SR" "alert(1)") "Galert(1)C=x ")) (not (= (str.indexof x "s" 0) 11)) (= "<IMG SRC=x onplaying=""alert(String.fromCharCode(88,8<b>83))"">" (str.replace x "3," "<b>"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{10}$"))))
(assert (not (= "lert(1)"">" (str.substr y 48 9))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?!.*\d{7,}).*"))) (str.suffixof "3,83))"">" x) (str.contains x "od")))
(assert (or (not (>= (str.len x) 48)) (= "<form onmousemove=""aljavascript:1)"">te\u{1d400}st</form>ter=""alert(1)"">test</textarea>" (str.replace y "\u{1f600}ert(" "javascript:")) (str.contains z "ert(1)\x")))
(assert (not (= (str.indexof z "e>tes" 0) 38)))
(check-sat)
