; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset draggable=""true"" ondragenter=""alert(1)"">test</frameset>") (= x "<acronym onmouseenter=""alert(1)"">test</acronym>") (= x "<body onkeyup body onkeyup=""javasc\u{1f600}ript:javascript:alert(\u{1d400}1)""></body onkeyup>")))
(assert (or (= z "p here</abbr>") (= z "group>") (= z "dex=1 onfocusin=alert(1)></title>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?!\s*$)[a-zA-Z0-9\s]{1,50}$"))))
(assert (or (= "gr" (str.replace z "oup>" "")) (not (str.contains (str.replace z "sin=a" """") "focu""le")) (not (= "<strike oncopy=""alert(1)"" contenteditable>test</strik""t(1)"">test</dd>" (str.replace y "e>ler" """")))))
(assert (or (not (= (str.len z) 21)) (= (str.indexof x "ac" 0) 1) (= "oreactiv" (str.substr z 14 8))))
(assert (= "p b" (str.substr x 12 3)))
(check-sat)
