; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rt id=x tabindex=1 onbeforedeactivate=alert(1)></rt><input autofocus>") (= x "<td onmouseover=""alert(1)"">test</td>") (= x "<input onkeydown=""alert(1)"" contenteditable>test</input>")))
(assert (or (= z "tion>") (= z "ss=""alert(1)"" contenteditable>test</param>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "ted" 0) 20)) (>= (str.len z) 40) (= "er" (str.substr x 13 2))))
(assert (or (= (str.len x) 44) (not (= (str.at y 24) "f"))))
(assert (or (= (str.at x 22) "t") (= "te=""alert(" (str.substr z 11 10))))
(assert (str.suffixof "/td>" x))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^;<>=]{2,30}$"))))
(assert (or (not (<= (str.len x) 38)) (not (str.prefixof "<input onk" y)) (str.contains (str.replace z "tion>" """") """")))
(assert (str.contains (str.replace z "tio" "<b>") "<b>n>"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(00?|\+?)(\d{2,3})?\d{9}$"))))
(assert (str.suffixof "/input>" x))
(check-sat)
