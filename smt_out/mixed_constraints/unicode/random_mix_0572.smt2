; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""66""><?xml version=""1.0""?>") (= x "<fieldset onmousedown=""alert(1)"">test</fieldset>") (= x "<aside onmouseleave=""\u{10348}alert(1)"">test</aside>")))
(assert (or (= z "@keyframes x{}</style><i style=""animation-name:x"" onanimationstart=""alert(1)""></i>") (= z "ss')>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<field" x) (not (str.contains x "t</fiel")) (not (= ")>" (str.substr z 3 9)))))
(assert (not (str.prefixof "ss')" z)))
(assert (or (not (= "<fieldset onmousedown="" rt(1)"">test</fieldset>@keyframes x{}</style><i style=""animation-name:x"" onanimationstart=""alert(1)""></i>" (str.replace y "ale" " "))) (not (= (str.indexof y """" 0) 20))))
(assert (or (str.contains y "set ") (str.suffixof "ss')>" y) (str.in_re x ((_ re.from_regex ecma2020 u) "^.{0,4}$"))))
(assert (str.prefixof "<fieldset " y))
(assert (or (not (str.contains z "frames ")) (str.suffixof "1)""></i>" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9 ]{0,6}$")))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z]+(\s[a-zA-Z]+)?$")))
(check-sat)
