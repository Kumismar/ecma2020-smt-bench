; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound id=x tabindex=1 onbeforedeactivate=alert(1)></bgsound><input autofocus>") (= x "<figcaption onclick=""alert(1)"">test</figcaption>") (= x "<h1 oncontextmenu=""alert(1)"">test</h1>")))
(assert (or (= z "blclick=""alert(1)"">test</section>") (= z "ipt>") (= z "s>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "ip" z) (= (str.at x 14) "e")))
(assert (not (<= (str.len z) 41)))
(assert (or (not (str.suffixof "aption>" x)) (not (= "<h1 o" (str.substr y 0 5))) (not (= (str.len x) 80))))
(assert (str.contains z "</sect"))
(assert (not (= (str.indexof x "st</h" 0) 31)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{8,18}"))) (>= (str.len x) 47) (not (= "ction>" (str.substr z 27 9)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{3041}-\u{3093}\u{30a1}-\u{30f6}\u{3000}\s]+$"))) (str.contains x "lert(")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?[0-9]{8,14}$"))))
(check-sat)
