; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "SRC=&#10<IMG 6;&#97;&#118;&#97;&#115;&#99;&#114;&#105;&#112;&#116;\u{1f4a9}&#58;&#97;&#108;&#\u{1f600}101;&#114;&#116;&#40;&#39;&#88;&#83;&#83;&#39;&#41;>") (= x "<style>@key\u{1f600}frames x{}</style><track style=""animation-name:x"" onanimationend=""alert(1)""></track>")))
(assert (or (= z "1 id=x></th><input autofocus>") (= z "useleave=""alert(1)"">test</dd>")))
(assert (= y (str.++ x z)))
(assert (= "#114;&#1" (str.substr x 43 8)))
(assert (or (not (str.prefixof "<" x)) (not (str.suffixof "test</dd>" z))))
(assert (or (str.prefixof "<style>@" y) (<= (str.len z) 30)))
(assert (str.suffixof "ack>" x))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^1([38][0-9]|4[579]|5[0-3,5-9]|6[6]|7[0135678]|9[89])\d{8}$"))) (not (= (str.indexof x "o" 0) 4))))
(assert (or (not (str.contains x "0000")) (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{4}-[0-9]{2}-[0-9]{2}"))))
(assert (or (not (str.prefixof "S" x)) (not (= (str.indexof z "focu" 0) 23))))
(assert (str.contains y "7;&#118;"))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{2}\/[0-9]{2}\/[0-9]{4}$")) (not (= "SRC=&#10<IMG 6;&#97;&#118;&#97;&#115;&#99;&#114;&#105;&#112;&#116;\u{1f4a9}&#58;&#97;&#108;&#\u{1f600}101;&#114;&#116;&#40;&#39;&#88;&#83;&#83;&#39;&#41;>1 id=x></th><ialert(1) autofocus>" (str.replace y "nput" "alert(1)")))))
(check-sat)
