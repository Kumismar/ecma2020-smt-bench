; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<w contenteditable id=x onfocus=alert()>") (= x "<div draggable=""true"" contenteditable>drag me</div><picture ondragover=alert(1) contenteditable>drop here</picture>")))
(assert (or (= z "t(1)"">test</dialog>") (= z "rt)(1)") (= z "ocusin=alert(1)></dfn>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "ert(" 0) 34) (not (str.prefixof "oc" z)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[\-\.0-9A-Z a-z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}]{3,}$"))))
(assert (str.prefixof "<w cont" y))
(assert (or (not (str.contains (str.replace x "nte" " ") "o n")) (not (str.prefixof "<div drag" x))))
(assert (or (>= (str.len x) 39) (not (= (str.at z 0) "o")) (str.suffixof "s=alert()>" x)))
(assert (= "transf" (str.substr y 16 6)))
(assert (or (<= (str.len x) 123) (<= (str.len y) 126)))
(check-sat)
