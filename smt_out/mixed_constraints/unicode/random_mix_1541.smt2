; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;BASE HREF=&quot;javascript:alert(&apos;XSS&apos;);//&quot;&gt;") (= x "<code oncontextmenu=""alert(1)"">test</code>")))
(assert (or (= z "}</script>;1") (= z "</link>") (= z "\u{1f600}tml>//[""\u{10348}'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "m" 0) 15))
(assert (str.suffixof "k>" y))
(assert (or (>= (str.len y) 72) (str.contains (str.replace y "t</" "") "sc")))
(assert (not (str.prefixof "<a onblur=" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{2}-\d{3}$"))) (not (<= (str.len z) 12)) (not (str.suffixof "pt>;1" z))))
(assert (str.prefixof "}</" z))
(check-sat)
