; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog id=x tabindex=1 onfocusin=alert(1)></dialog>") (= x "<area onmousemove=""alert(1)"">test</area>") (= x "<embed src=""data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg=="">")))
(assert (or (= z "paste=""alert(1)"" contenteditable>test</strong>") (= z " here</small>") (= z "e=""audio/wav""></audio>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9 ]*$"))) (not (str.contains x "=x tabin")) (not (str.contains (str.replace y "/s" "<b>") "<<b>mall>"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Z|a-z|\s-]{3,15}")) (not (str.prefixof "<e" x))))
(assert (= (str.len y) 94))
(assert (or (= (str.at y 23) "t") (= (str.at z 16) "1") (str.contains (str.replace z "/s" " ") "ere< m")))
(assert (not (str.suffixof "</strong>" y)))
(assert (not (str.suffixof "rea>" x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?!.*gmail|.*outlook|.*yahoo|.*hotmail|.*lexter).*$"))))
(assert (or (not (= "<dialog id=x tabindex=1 onfocusin=alx(1)></dialog>" (str.replace x "ert" "x"))) (not (str.contains y """ con")) (not (str.contains z "/wav""></au"))))
(check-sat)
