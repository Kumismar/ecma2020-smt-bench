; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<HEAD><META HTTP-EQUIV=""CONTENT-TYPE"" CONTENT=""text/html; charset=UTF-7""> </HEAD>+ADw-SCRIPT+AD4-%(payload)s;+ADw-/SCRIPT+AD4-") (= x "<style id=x tabindex=1 onactivate=alert(1)></style>")))
(assert (or (= z "id=""62""><!-- IE 6-8\u{10348} -->") (= z "SS&apos;);//")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[+()0-9]{1,}$"))) (= (str.indexof y "cnQ" 0) 73)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^(?!.*http|script|php|\s|\u{3000}).*$")) (not (= "=""62""><!--" (str.substr y 53 10)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(\w.+\s).+"))) (not (str.contains (str.replace y "D4-%" "x") "T+Ax(p")) (str.contains (str.replace y "AD4-%" "") "IPT+(p")))
(assert (not (= (str.at z 14) "E")))
(assert (not (str.prefixof "<caption d" y)))
(assert (not (str.contains z "pos")))
(assert (or (not (= (str.at x 23) "u")) (<= (str.len x) 56) (not (str.suffixof ";);//" z))))
(assert (or (str.contains x "NT-TYPE""") (not (str.suffixof "/video>" z))))
(check-sat)
