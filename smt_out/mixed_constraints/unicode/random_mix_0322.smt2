; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "b=\""URL(\\""\"";") (= x """`'><script>\xE2\x80\x82javascript:alert(1)</script>")))
(assert (or (= z "rue"" ondragenter=""alert(1)"">test</center>") (= z "a>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace x " onpa" """") "ETA""onpag")))
(assert (or (= (str.at z 35) "n") (str.suffixof "</param>" z)))
(assert (or (not (str.prefixof "b" x)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-999999999999]*$"))) (str.prefixof "do on" z)))
(assert (or (not (= """`'><script>\xE2\x80\x82javascript:aalert(1)t(1)</script>" (str.replace x "ler" "alert(1)"))) (= "e"" o" (str.substr z 2 4)) (not (= (str.indexof z "1)"">t" 0) 12))))
(assert (str.suffixof ">" z))
(assert (= ">" (str.substr z 1 5)))
(assert (not (str.contains z "(1)"">")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9!-/:-@\u{2260}\[-`{-~]+$"))))
(assert (or (not (str.prefixof "b=" x)) (not (= (str.at z 41) "a"))))
(check-sat)
