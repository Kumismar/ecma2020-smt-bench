; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark draggable=""true"" ondragstart=""alert(1)"">test</mark>") (= x "<IMG SRC=x onstorage=""alert(String.fromCharCode(88,83,83))"">") (= x "<IMG SRC=x onwaiting=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z """alert(String.fromCharCode(88,83,83))"">") (= z "ect><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[\u{30a1}-\u{30f4}][\u{30a1}-\u{30f4}\u{30fc}]*(\u{30fb}[\u{30a1}-\u{30f4}][\u{30a1}-\u{30f4}\u{30fc}]*)*"))) (str.contains (str.replace z "i" "<b>") "t(Str<b>n") (= (str.at y 60) "<")))
(assert (or (str.contains (str.replace z "ocus" "") "f>") (not (= (str.indexof x "x o" 0) 9))))
(assert (or (= (str.at z 5) "<") (<= (str.len y) 65) (not (= (str.at y 27) "("))))
(assert (not (str.contains (str.replace x " onwa" "<b>") "x<b>i")))
(assert (or (str.contains z "rt(String.") (str.suffixof "3))"">" y) (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{4}\/\d{1,2}\/\d{1,2}$"))))
(check-sat)
