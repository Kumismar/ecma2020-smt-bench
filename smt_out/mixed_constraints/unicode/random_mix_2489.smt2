; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead onfocusout=alert(1) tabindex=1 id=x></thead><input autofocus>") (= x "<style>@keyframes x{}</style><option style=""animation-name:x"" onanimationstart=""alert(1)""></option>")))
(assert (or (= z "ble>test</dd>") (= z "=alert(document.cookie)>") (= z "lert(1)"">test</p>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "1)"" c" 0) 1) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9A-z\u{119}\u{f3}\u{105}\u{15b}\u{142}\u{17c}\u{17a}\u{107}\u{144}\u{118}\u{d3}\u{104}\u{15a}\u{141}\u{17b}\u{179}\u{106}\u{143} /-]){2,}$")))))
(assert (or (not (= (str.at z 8) "<")) (not (>= (str.len x) 99)) (= (str.len y) 116)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^\s.1-9<>&%$()]+(?: {1}[^\s\s.1-9<>&%$()]+)+ *$"))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^1[3|4|5|8][0-9]\d{4,8}$")))
(assert (not (= (str.at y 34) "o")))
(assert (not (= """ani" (str.substr y 43 4))))
(assert (or (not (= (str.len z) 13)) (not (str.prefixof "<" y))))
(assert (not (= (str.at x 26) """")))
(assert (str.contains z "test</dd>"))
(check-sat)
