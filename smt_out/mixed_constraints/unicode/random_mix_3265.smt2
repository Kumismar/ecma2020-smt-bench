; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param onkeyup=""alert(1)"" contenteditable>test</param>") (= x "<?xml version=""1.0"" encoding=""ISO-8859-1""?><!DOCTYPE foo [<!ELEMENT foo ANY><!ENTITY x\u{20000}xe SYSTEM ""fil\u{1f600}e:///dev/random"">]><foo>&xee;</foo>")))
(assert (or (= z "est</textarea>") (= z "><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "ofocus>" z)) (not (= "<""ng onkeyup=""alert(1)"" contenteditable>test</strong>" (str.replace x "stro" """"))) (str.suffixof "area>" y)))
(assert (or (= (str.at y 8) "n") (str.prefixof "><inpu" z) (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*?!?\(?\+?0{0,2}4?\)?[-. ]?0[-. ]?[37]\d{2}\)?[-. ]?\d{3}[-. ]?\d{3}\s*?$"))))
(assert (not (str.prefixof "><input" z)))
(assert (not (<= (str.len x) 140)))
(assert (or (not (str.prefixof "<?xml" x)) (not (str.contains x "ri")) (not (str.contains (str.replace z "cr" "alert(1)") "/</salert(1)ipt>"))))
(assert (not (= "rt(1)"" con" (str.substr x 19 10))))
(assert (not (= (str.indexof x "e" 0) 10)))
(check-sat)
