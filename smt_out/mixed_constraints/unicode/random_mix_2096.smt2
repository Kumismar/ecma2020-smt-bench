; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><label style=""animation-name:x"" onanimationend=""alert(1)""></label>") (= x "<input draggable=""true"" ondragend\u{20000}=""alert(1)"">test</input>")))
(assert (or (= z "sting>") (= z ".jpg""></script>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "t</p>")) (str.prefixof "g me</div>" z) (= (str.at x 79) "e")))
(assert (not (= (str.indexof z "</i" 0) 15)))
(assert (or (str.contains z "t autofocu") (= (str.indexof x "=""" 0) 16) (not (= (str.indexof y "ab" 0) 13))))
(assert (or (not (= (str.len x) 58)) (not (= "ame:x"" ona" (str.substr y 54 10))) (str.in_re z ((_ re.from_regex ecma2020 u) "^()?[0-9\- ]{10}[0-9\- ]*$"))))
(check-sat)
