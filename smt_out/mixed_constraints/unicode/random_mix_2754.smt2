; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form ondblclick=""alert(1)"">test</form>") (= x "<div draggable=""true"" contenteditable>drag me</div><font ondrop=alert(1) contenteditable>drop here</font>") (= x "<svg><dl onload=alert(1)></dl>")))
(assert (or (= z "ment.vulnerable=true;</script>") (= z """alert(1)"" contenteditable>test</col>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len x) 114)) (not (>= (str.len y) 87)) (not (= "<div draggable=""true"" contenteditable>drag me</div><font ondrop=alert(1) contenteditable>drop here<<b>ont>ment.vulnerable=true;</script>" (str.replace y "/f" "<b>")))))
(assert (or (not (= (str.len z) 30)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-za-z0-9.-]+\.[A-Za-z]{2,3}$"))) (not (= "g" (str.substr x 3 1)))))
(assert (or (not (str.contains z "ditable>")) (not (str.suffixof ">" x)) (not (= (str.indexof x "ble>" 0) 34))))
(assert (= "le>d" (str.substr x 35 4)))
(assert (or (not (str.contains y "s x{}<")) (= "<style>@keyframes x{}</style><plainjavascript:t style=""animation-name:x"" onanimationstart=""alert(1)""></plaintext>st</progress>" (str.replace y "tex" "javascript:"))))
(check-sat)
