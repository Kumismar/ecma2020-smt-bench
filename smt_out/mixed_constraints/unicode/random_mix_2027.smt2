; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed onmousemove=""alert(1)"">test</noembed>") (= x "<sVg oNloaD=write()>") (= x "<legend id=x tabindex=1 onactivate=alert(1)></legend>")))
(assert (or (= z "t(1)"">test</basefont>") (= z "lick=""alert(1)"">test</nextid>") (= z "ondragend=""alert(1)"">test</blink>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z]{2}[0-9]{2}[ ?][(A-Za-z0-9)( )?]{12,37}$"))) (not (= (str.len z) 33)) (str.contains z "ick=""alert")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0][12345679][-. ]?\d{2}[-. ]?\d{2}[-. ]?\d{2}[-. ]?\d{2}$$"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "\b(Gloves|gloves|GLOVES)\b")) (not (str.prefixof "<sVg oNloa" x)) (str.prefixof "<noem" x)))
(assert (not (str.prefixof "<secti" y)))
(check-sat)
