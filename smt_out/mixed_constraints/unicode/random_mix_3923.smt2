; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<td onmousele\u{1d400}ave=""alert(1)\u{20000}"">test</td>") (= x "<bdo oncopy=""alert(1)"" contenteditable>test</bdo>")))
(assert (or (= z "t id=x tabindex=1 onbeforedeactivate=alert(1)></applet><input autofocus>") (= z "nteditable>test</base>") (= z "d\u{1f4a9}ex=1 id=x></label><input autof\u{10348}ocus>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "ontente"))
(assert (or (= (str.indexof x "t" 0) 1) (str.prefixof "<bdo o" x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z0-9-_\.]{1,30}$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) ".{0}|.{8,70}"))) (not (str.suffixof "utof\u{10348}ocus>" y)) (str.in_re x ((_ re.from_regex ecma2020 u) ".+@[a-z0-9.-]+\.[a-z]{2,}"))))
(assert (not (= "<bdo oncopy=""alert(1)"" contente le>test</bdo>" (str.replace x "ditab" " "))))
(assert (or (not (str.suffixof "est</base>" y)) (not (str.suffixof "st</td>" x))))
(check-sat)
