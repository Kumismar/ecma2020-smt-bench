; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo oncopy=""alert(1)"" contenteditable>test</bdo>") (= x "<mark id=x tabindex=1 onbeforeactivate=alert(1)></mark>")))
(assert (or (= z "t(1)</script>") (= z "y>") (= z "le>test</source>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "ou")))
(assert (or (str.prefixof "t(" z) (not (str.prefixof "<m" y))))
(assert (not (= (str.at y 4) "k")))
(assert (str.contains z "est</sourc"))
(assert (or (not (str.contains z "lert(1)")) (= "itable" (str.substr x 32 6)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z-0-9\s]*$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1]+[3,8]+\d{9}$"))) (= (str.len y) 65) (= (str.at x 11) "=")))
(check-sat)
