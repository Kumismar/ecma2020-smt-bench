; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a onmouseup=""alert(1)"">test</a>") (= x "<rp dragga\u{10348}ble=""true"" ondragenter=""alert(1)"">test</rp>") (= x "<canvas onmouseleave=""alert(1)"">test</canvas>")))
(assert (or (= z " id=y autofocus>") (= z "(1)</script>") (= z "rt(1)"">test</frameset>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x "as")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]+$|^[0-9]+$")) (str.contains x "leave=""ale")))
(assert (or (not (str.prefixof "<canva" y)) (str.contains z ")</script>")))
(assert (= "seup=""a" (str.substr x 8 7)))
(assert (or (>= (str.len x) 50) (not (= (str.indexof z "1" 0) 1))))
(assert (not (= (str.indexof y "gg" 0) 7)))
(assert (or (str.contains (str.replace y "p dr" "") "ragga\u{10348}") (not (str.suffixof "1)""></bdi>" x)) (= (str.at y 30) "a")))
(assert (not (= (str.at z 5) " ")))
(check-sat)
