; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x onmouseover=alert(1)>hover this!") (= x "<html onbeforecut=""alert(1)"" contenteditable>test</html>")))
(assert (or (= z "ex=1 onactivate=alert(1)></sup>") (= z """alert(1)"">test</nobr>") (= z ")"">")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z ")""")))
(assert (or (= (str.at x 7) "u") (not (= (str.at z 1) "a"))))
(assert (or (not (= "lert(1)></" (str.substr z 17 10))) (str.suffixof "</html>" x)))
(assert (not (= (str.indexof z ")""" 0) 0)))
(assert (or (not (= "ggable=""true"" ondragenter=javascript:rt(1)"">test</b>" (str.replace z """ale" "javascript:"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^\d{3}-\d{3}-\d{4}$|^\d{10}$)")))))
(assert (not (= "(1)" (str.substr y 24 3))))
(assert (or (not (str.suffixof ">" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([\w\.\-]+)@([\w\-]+)((\.(\w){2,6})+)$")))))
(assert (not (str.contains (str.replace y "eo" "alert(1)") "ousalert(1)ve")))
(check-sat)
