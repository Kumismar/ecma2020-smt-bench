; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><th style=""animation-name:x"" onanimationend=""alert(1)""></th>") (= x "&#X00003c") (= x "<th onclick=""alert(1)"">test\u{1f600}</th>")))
(assert (or (= z "ert(1)"">") (= z "genter=""alert(1)"">test</bdo>") (= z "teditable>test</colgroup>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "test\u{1f600}</th>" x) (str.prefixof "<style>@" x) (str.suffixof "/colgroup>" z)))
(assert (or (str.contains (str.replace z "/f" "x") "<xoo") (= "test</bd" (str.substr y 27 8)) (str.in_re y ((_ re.from_regex ecma2020 u) "[^'\x22]+"))))
(assert (not (= (str.indexof y "#X" 0) 1)))
(assert (or (not (= ">" (str.substr z 7 3))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z\u{e4}\u{c4}\u{f6}\u{d6}\u{fc}\u{dc}\-]*\.[0-9A-Za-z]*$"))) (str.contains y "=""a")))
(assert (not (str.contains y "roup")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-Za-z0-9]*)$"))) (= (str.at z 1) "e")))
(check-sat)
