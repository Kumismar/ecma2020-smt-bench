; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details onmouseout=""alert(1)"">test</details>") (= x "\u{1f4a9}<tt\u{1f4a9} id=x tabindex=1 onactivate=alert(1)></tt>")))
(assert (or (= z "onmouseup=""alert(1)"">test</area>") (= z "html xmlns:html='http://www.w3.org/1999/xhtml'><html:script>javascript:alert(1);</html:script></html:html>") (= z "e"" ondragend=""alert(1)"">test</keygen>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "ml='")) (<= (str.len x) 50)))
(assert (or (not (str.prefixof "<" y)) (str.prefixof "\u{1f4a9}<" y) (not (= (str.indexof y "rue""" 0) 22))))
(assert (or (= (str.at x 7) "s") (not (= ">" (str.substr z 0 2))) (not (str.contains y ";</html:sc"))))
(assert (or (= (str.indexof y "onact" 0) 22) (>= (str.len x) 37)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^P[0-9]+$"))))
(assert (not (str.contains (str.replace x "out" " ") "ouse =""")))
(check-sat)
