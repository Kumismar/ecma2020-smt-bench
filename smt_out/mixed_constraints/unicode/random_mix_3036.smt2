(assert (or (= z "imationstart=""alert(1)""></colgroup>") (= z "g me</div><body ondragover=alert(1) contenteditable>drop here</body>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x " cont")))
(assert (or (= (str.at x 19) "t") (not (= "bindex" (str.substr y 15 6)))))
(assert (or (not (= "oup>" (str.substr z 31 9))) (str.prefixof ";backgroun" z)))
(assert (or (not (= (str.indexof z "ati" 0) 2)) (not (str.suffixof "ut>" x)) (str.prefixof "g me<" z)))
