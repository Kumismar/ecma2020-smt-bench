(assert (or (= (str.indexof y "st</o" 0) 46) (= (str.at z 8) ">") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\+[0-9]{2,3}|0+[0-9]{2,5}).+[\d\s\/\(\)-]")))))
(check-sat)
