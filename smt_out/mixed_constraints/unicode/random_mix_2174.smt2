; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area onpaste=""alert(1)"" contenteditable>test</area>") (= x "&#x00003C;")))
(assert (or (= z "l draggable=""true"" ondrag=""alert(1)"">test</col>") (= z ";") (= z "ragend=""alert(1)"">test</picture>")))
(assert (= y (str.++ x z)))
(assert (or (= "able" (str.substr x 36 4)) (not (= "rag alert(1)"">test</picture>" (str.replace z "end=""" " ")))))
(assert (or (not (= (str.indexof y "p" 0) 8)) (not (str.suffixof ">" z)) (str.suffixof "/picture>" z)))
(assert (= (str.indexof x "in" 0) 4))
(assert (or (not (str.prefixof ";" z)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9.-]+$"))) (= (str.at x 3) "0")))
(assert (not (= "s=alert(" (str.substr x 30 8))))
(check-sat)
