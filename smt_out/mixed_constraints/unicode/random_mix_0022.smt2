; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i\u{20000}frame onmouseleave=""a\u{1f600}lert(1)"">test</iframe>") (= x "<div draggable=""true"" contenteditable>drag me</div><listing ondragover=alert(1) contenteditable>drop here</listing>") (= x "<abbr onblur=alert(1) tabindex=1 id=x></abbr><input autofocus>")))
(assert (or (= z "nanimationstart=""alert(1)""></em>") (= z "ea draggable=""true"" ondragenter=""alert(1)"">test</textarea>") (= z "le>test</hr>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "p=""al")))
(assert (or (not (= (str.indexof y "t" 0) 16)) (not (str.suffixof "e>" x)) (not (str.prefixof "<" y))))
(assert (not (str.suffixof ">" x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?:0[1-9]|1[0-2])"))))
(assert (or (not (= (str.indexof y "e>dra" 0) 36)) (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{0,2}-?[0-9]+$"))))
(check-sat)
