; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=\""jav&#x09;ascript:alert('XSS'\u{1f4a9})\u{1f600};\"">") (= x "<kbd \u{10348}onpaste=""alert(1)"" contenteditable>test</kbd>") (= x "<dialog onmouseleave=""alert(1)"">test</dialog>")))
(assert (or (= z "orecut=""alert(1)"" contenteditable>test</caption>") (= z "opy=""alert(1)"" contenteditable>test</aside>") (= z "id=x tabindex=1 ondeactivate=alert(1)></br><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "ontentedit" (str.substr x 26 10)) (not (str.prefixof "<elemen" x))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z\u{c4}\u{e4}\u{d6}\u{f6}\u{dc}\u{fc}\u{df}])().{4,}")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w0-9_\+-]+(\.[\w0-9_\+-]+)*@[\w0-9-]+(\.[\w0-9-]+)*\.([a-zA-Z]{2,4})$")) (not (= (str.len z) 48)) (str.suffixof "t</kbd>" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*\W).{6,}"))) (not (str.suffixof "st</kbd>" x)) (str.prefixof "nload=ale" z)))
(assert (= "tion>" (str.substr z 43 8)))
(assert (not (= (str.indexof z "e=al" 0) 27)))
(assert (or (not (= (str.at y 5) " ")) (not (= (str.at y 54) "x"))))
(check-sat)
