; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup onmouseenter=""alert(1)"">test</optgroup>") (= x "<div draggable=""true"" contenteditable>drag me</div><dl ondragover=alert(1) contenteditable>drop here</dl>")))
(assert (or (= z "t onmouseleave=""alert(1)"">test</output>") (= z "t(\u{1f600}1)""></ul>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<optgroup " x)) (>= (str.len y) 45) (= (str.at x 18) "n")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{3}?(?!sa|sd|ss)[a-zA-Z]{2}$"))))
(assert (not (= (str.indexof y "&#1" 0) 62)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{4}\s\d{4}\s\d{4}$"))))
(assert (not (= (str.indexof z "org/" 0) 41)))
(assert (or (str.prefixof "y" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-z ]*$")))))
(check-sat)
