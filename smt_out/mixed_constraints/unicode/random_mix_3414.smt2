; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style id=x tabindex=1 onactivate=alert(1)></style>") (= x "<svg onResize svg onResize=""javascript:javascript:alert(1)""></svg onResize>")))
(assert (or (= z "option onmousedown=""alert(1)"">test</option>") (= z "ice(-8))>#alert(1)") (= z "t(1)"">test</datalist>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z ">tes" 0) 1))
(assert (or (= ">tes" (str.substr z 3 4)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[+]*[(]{0,1}[0-9]{1,4}[)]{0,1}[-\s\./0-9]*$")))))
(assert (or (= "io" (str.substr z 3 2)) (= (str.indexof y "sc" 0) 1) (= (str.len z) 21)))
(assert (not (str.contains z "st</kbd")))
(assert (or (= (str.at x 38) ":") (not (str.suffixof "t(1)" z))))
(assert (not (= (str.at z 17) "i")))
(assert (>= (str.len z) 18))
(assert (or (not (= (str.indexof x "ize" 0) 10)) (str.contains y "size>ic") (not (str.prefixof "<styl" x))))
(assert (= (str.len x) 44))
(check-sat)
