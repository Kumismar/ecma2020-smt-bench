; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><script src=data:&comma;alert(1)//") (= x "<img src=x onerror=\x00""javascript:alert(1)"">") (= x "<spacer onmouseout=""alert(1)"">test</spacer>")))
(assert (or (= z "alert(1)"" contenteditable>test</b>") (= z "true"" ondragend=""alert(1)"">test</colgroup>") (= z "es>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "//es>" y) (str.contains x "q d")))
(assert (not (= (str.at y 38) ">")))
(assert (not (str.contains x "lert(1)""")))
(assert (or (= """><script src=data:&comma;alert(1)// " (str.replace y "es>" " ")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "([A-Z]{1})([a-z]{2,20})((\s{1,2}|-{1})([A-Z]{1})([a-z]{2,20}))?$")))))
(assert (= (str.indexof x "/mar" 0) 54))
(assert (not (= (str.at z 1) "m")))
(assert (or (>= (str.len y) 78) (not (str.suffixof "s>" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-\u{17c}A-\u{17b}]{2,20}$")))))
(assert (or (>= (str.len x) 32) (= (str.indexof x "st</" 0) 32)))
(assert (not (str.suffixof "oup>" y)))
(assert (= (str.at z 11) "g"))
(check-sat)
