; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike draggable=""true"" ondragend=""alert(1)"">test</strike>") (= x "<blink id=x tabindex=1 onfocus=alert(1)></blink>") (= x "<tfoot onmouseup=""alert(1)"">test</tfoot>")))
(assert (or (= z "lert(1)"">test</abbr>") (= z "=x tabindex=1 ondeactivate=alert(1)></input><input id=y autofocus>") (= z "drop here</frameset>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "lert(1)></") (not (= (str.indexof x "id" 0) 7)) (not (= (str.indexof z "r" 0) 1))))
(assert (str.contains x "ouse"))
(assert (= (str.at x 1) "t"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w._%-]+@[\w.-]+\.[a-zA-Z]{2,4}$"))) (not (= "/" (str.substr x 41 1)))))
(assert (or (not (= "ge" (str.substr x 30 2))) (not (= (str.len y) 106)) (not (= (str.at y 23) "o"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[_A-z0-9\u{410}-\u{44f}]{1,}$")) (>= (str.len z) 1)))
(assert (not (= "a" (str.substr z 15 1))))
(assert (or (not (= (str.indexof z "t(1" 0) 3)) (not (str.prefixof "<tfoot on" x))))
(check-sat)
