; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr id=x tabindex=1 onfocus=alert(1)></abbr>") (= x "<;SCRIPT a="";blah""; ';'; SRC="";http://ha.ckers.org/xss.js"";>;<;/SCRIPT>;")))
(assert (or (= z "n=""alert(1)"">test</hgroup>") (= z """alert(1)"">test</sub>") (= z "e onmouseout=""alert(1)"">test</code>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x ";#\u{1f4a9}1" 0) 54) (not (= "t=""alert(1" (str.substr y 17 10))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "([a-z0-9]+[._-]){0,}?[a-z0-9]+@[a-z0-9]+[.]{1}[a-z]{2,4}$")))))
(assert (not (= (str.len x) 72)))
(assert (not (= "est" (str.substr z 25 3))))
(assert (or (not (>= (str.len z) 20)) (not (= (str.indexof z "nmo" 0) 3)) (= (str.indexof x "le=" 0) 12)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z0-9A-Z._%+-]+@[a-z0-9A-Z.-]+\.[a-zA-Z]{2,4}$"))))
(check-sat)
