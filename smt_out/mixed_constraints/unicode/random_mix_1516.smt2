; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<label id=x tabindex=1 ondeactivate=alert(1)></label><input id=y autofocus>") (= x "<svg><mark onload=alert(1)></mark>") (= x "<div draggable=""true"" contenteditable>drag me</div><map ondragover=alert(1) contenteditable>drop here</map>")))
(assert (or (= z "rame onfocusout=alert(1) id=x><input autofocus>") (= z " oncopy=""alert(1)"" contenteditable>test</ruby>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 68) "o")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z]+(?:\s[A-Za-z]+)+$"))) (str.suffixof "e>" x) (str.contains (str.replace x "dr" "javascript:") " javascript:agg")))
(assert (or (= (str.indexof x "gover" 0) 61) (str.in_re y ((_ re.from_regex ecma2020 u) "^0\d{1,3}-\d{7,8}(#\d+)?"))))
(assert (or (not (str.prefixof "<svg>" x)) (not (= (str.at x 70) "o")) (= (str.indexof x "ap " 0) 53)))
(assert (not (str.prefixof "<label " y)))
(assert (not (= "nde" (str.substr x 24 3))))
(assert (or (str.contains (str.replace z "</ul>" """") "t""") (not (str.suffixof "ark>" x))))
(check-sat)
