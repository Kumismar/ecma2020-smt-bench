; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "foo\\u{2019}; alert(document.cookie);//\u{2019};") (= x "<font draggable=""true"" ondragenter=""al\u{1f600}ert(1)"">test</font>\u{20000}") (= x "<img/src=`%00` onerror=this.onerror=confirm(1)")))
(assert (or (= z " id=x tabindex=1 onbeforeactivate=alert(1)></rt>") (= z " SRC=\""mocha&#58;&#91;code&#93;\""&gt;") (= z "ulticol oncontextmenu=""alert(1)"">test</multicol>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "rm(" 0) 41)))
(assert (not (<= (str.len y) 112)))
(assert (or (str.suffixof "gt;" z) (= "ert(docume" (str.substr x 9 10)) (str.contains y "8;&")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{7,12}$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*[A-Za-z]).{1,}"))) (str.contains (str.replace x "`%00`" "javascript:") "/src=javascript: oner")))
(assert (or (not (>= (str.len y) 99)) (not (str.suffixof "multicol>" y)) (not (= (str.at y 8) "a"))))
(assert (or (not (= "bef" (str.substr z 19 3))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?!\s+)\D{1,19}\S")))))
(check-sat)
