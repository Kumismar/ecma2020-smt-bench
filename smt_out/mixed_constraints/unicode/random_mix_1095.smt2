; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<command draggable=""true"" ondragenter=""alert(1)"">test</command>") (= x "<dt id=x tabindex=1 ondeactivate=alert(1)></dt><input id=y autofocus>") (= x "<wbr draggable=""true"" ondrag=""alert(1)"">test</wbr>")))
(assert (or (= z """XSS\"")'&gt;") (= z "arget {transform: rotate(180deg);}</style><multicol id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></multicol>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len y) 87))
(assert (or (not (= (str.at x 49) "n")) (str.contains y "tionrun=a") (str.contains (str.replace x "tru" "x") "e=""xe"" o")))
(assert (not (= (str.indexof y "t</tt" 0) 31)))
(assert (or (= (str.indexof y """>" 0) 38) (not (str.suffixof "lticol>" z)) (not (= "ert(1)"">te" (str.substr x 41 10)))))
(assert (or (= (str.at y 7) "R") (not (= "est</mai" (str.substr z 6 8))) (str.in_re y ((_ re.from_regex ecma2020 u) "^(10)$"))))
(check-sat)
