; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer onbeforepaste=""alert(1)"" contenteditable>test</footer>") (= x "<nav id=x tabindex=1 onactivate=alert(1)></nav>") (= x "<embed type=""image"" src=%(scriptlet)s></embed>")))
(assert (or (= z " contenteditable>test</dialog>") (= z "ve=""al\u{1f600}ert(1)"">test</xmp>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len x) 49) (not (= (str.at y 4) "e")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{2}")))))
(assert (or (not (str.prefixof "<" y)) (str.suffixof "st</xmp>" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\+)?(\d)+$")))))
(assert (or (not (= (str.at z 17) """")) (not (= (str.indexof x "<emb" 0) 0))))
(assert (= (str.at y 28) "r"))
(check-sat)
