; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><thead id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></thead>") (= x "<marquee draggable=""true"" ondragleave=""alert(1)"">test</marquee>")))
(assert (or (= z "XSS</textarea>") (= z "p here</header>") (= z "</noframes>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "ead>" x))
(assert (not (= (str.len z) 22)))
(assert (or (= (str.len y) 142) (= (str.indexof x "tion" 0) 76)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{1,2}\/[0-9]{1,2}\/[0-9]{2,4}$"))) (not (str.contains y "e"" ondragl")) (not (= (str.at y 63) "<"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z0-9._-]{2,}@[a-z0-9-]{2,}.[a-z.]{2,}$"))))
(check-sat)
