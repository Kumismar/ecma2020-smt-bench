; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onkeypress=""alert(1)"" contenteditable>test</dfn>") (= x "<col onbeforecopy=""alert(1)"" contenteditable>test</col>")))
(assert (or (= z ">") (= z "/a&#46;jpg http&#58;//victimsite&#46;com/admin&#46;asp&deleteuser") (= z " \nxss"")</script><marquee><h1>XSS by xss</h1></marquee>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "3,83))"">" x)))
(assert (or (= "<dfn onkeypress=""alert(1)"" contenteditable>test</dfn>/a&#46;jpg http&#58;//victim<b>e&#46;com/admin&#46;asp&deleteuser" (str.replace y "sit" "<b>")) (= (str.at y 60) "s") (= (str.indexof y "e>te" 0) 41)))
(assert (or (not (str.contains x "</d")) (not (<= (str.len x) 53))))
(assert (or (= (str.len x) 53) (not (= (str.indexof z "min&#" 0) 43)) (not (= "t" (str.substr y 124 1)))))
(assert (or (not (= "h1>XSS by " (str.substr y 80 10))) (= "<dfn onkeypress=""aleralert(1)(1)"" contenteditable>test</dfn> \nxss"")</script><marquee><h1>XSS by xss</h1></marquee>" (str.replace y "t" "alert(1)")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9a-z\u{f1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa},\s\-]+$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9 (),.&'-]+$")) (not (str.contains (str.replace z "<" "alert(1)") ")alert(1)/scri"))))
(assert (str.suffixof "st</col>" x))
(check-sat)
