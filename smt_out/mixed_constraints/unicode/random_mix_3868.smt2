; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time draggable=""true"" ondragstart=""alert(1)"">test</time>") (= x "'>><marquee><h1>XSS</h1></marquee>")))
(assert (or (= z """true"" contenteditable>drag me</div><time ondragover=alert(1) contenteditable>drop here</time>") (= z "ble=""true"" ondrag=""alert(1)"">test</figure>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace y ">bl" "x") "rqueexe=")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(([0,1][0-9])|(2[0-3])):[0-5][0-9]$"))))
(assert (= "h" (str.substr x 21 1)))
(assert (or (str.prefixof "'" x) (str.suffixof "</figure>" y)))
(assert (or (= "<heade" (str.substr y 0 6)) (= (str.len y) 76)))
(assert (not (= (str.indexof y "rue;" 0) 37)))
(check-sat)
