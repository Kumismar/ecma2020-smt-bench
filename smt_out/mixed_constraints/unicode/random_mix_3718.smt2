; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object id=x onfocus=alert(1) type=text/html>") (= x "<div draggable=""true"" contenteditable>drag me</div><abbr ondrop=alert(1) contenteditable>drop here</abbr>") (= x "<style>@keyframes x{}</style><rp style=""animation-name:x"" onanimationstart=""alert(1)""></rp>")))
(assert (or (= z "nk>") (= z "me:x"" onanimationend=""alert(1)""></table>") (= z "address onpaste=""alert(1)"" contenteditable>test</address>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "nk" z) (not (str.suffixof ">" x))))
(assert (or (not (str.prefixof "<div " x)) (= (str.indexof x "obje" 0) 1) (str.in_re z ((_ re.from_regex ecma2020 u) ".{4,50}"))))
(assert (or (= (str.indexof z "t(1" 0) 26) (not (str.contains (str.replace y "(1)"">" "javascript:") "ertjavascript:<")) (not (str.prefixof "<pre onk" y))))
(assert (or (not (= (str.at x 60) "a")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\d\s\w]*$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}s]+$")))))
(assert (or (str.suffixof "ble>" z) (not (str.suffixof "></table>" y))))
(assert (not (str.contains z "nk>")))
(check-sat)
