; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src\x47=x onerror=""javascript:alert(1)"">") (= x "<image style='filter:url(""data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22><script>parent.alert(129)</script></svg>"")'>") (= x "<bdo onmouseover=""alert(1)"">test</bdo>")))
(assert (or (= z "src=x onerror=javascript:alert(('A'))>") (= z "ment.vulnerable=true)'>") (= z "ontenteditable>test</cite>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<h" y) (not (= (str.at x 1) "i"))))
(assert (or (str.prefixof "m" z) (= (str.at y 81) "/")))
(assert (or (not (= (str.indexof z "nt." 0) 2)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z \u{5c}u0600-\u{5c}u06FF]+$"))))
(assert (or (str.contains x """javascri") (str.contains (str.replace y ")" "x") "129x</") (= (str.at y 8) "k")))
