(assert (not (<= (str.len z) 43)))
(assert (str.contains (str.replace z ")'>" "") "ue"))
(assert (or (not (= "s" (str.substr x 30 1))) (not (= (str.indexof y "g%2" 0) 84))))
(check-sat)
