; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea oncontextmenu=""alert(1)"">test</textarea>") (= x "</script><script>alert('XSS');</script>")))
(assert (or (= z "le>:target {color:red;}</style><video id=x style=""transition:color 1s"" ontransitionend=alert(1)></video>") (= z "eygen id=x tabindex=1 onbeforedeactivate=alert(1)></keygen><input autofocus>") (= z "seup=""alert(1)"">test</main>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<textarea <b>textmenu=""alert(1)"">test</textarea>seup=""alert(1)"">test</main>" (str.replace y "oncon" "<b>"))) (not (str.prefixof "<" x)) (not (= (str.indexof z "le" 0) 0))))
(assert (or (not (= "<br onkeypress=""alert(1)"" contenteditable>test</br>on\u{1d400}mouseover=""alert(1 est</table>" (str.replace y ")"">t" " "))) (= (str.indexof z "ntr" 0) 72)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{1,2}([0-9]{1,2}|[0-9][a-zA-Z])\s*[0-9][a-zA-Z]{2}$"))) (str.contains x "script>") (not (str.suffixof "n>" z))))
(assert (or (not (str.contains z "e>test")) (str.suffixof "side>" y)))
(check-sat)
