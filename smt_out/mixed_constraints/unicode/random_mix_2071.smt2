; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x onmousemove=alert(1)>hover this!") (= x "<form><button formaction=""javascript:alert(123)"">crosssitespt") (= x "<form onbeforepaste=""alert(1)"" contenteditable>test</form>")))
(assert (or (= z "nt&period;location&rpar;>") (= z "1'onxxx=1") (= z "&#x29;'>^__^")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 33) "s") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^1[3|4|5|8][0-9]\d{4,8}$")))))
(assert (or (str.prefixof "nt&" z) (not (str.contains z "ar;>")) (str.suffixof "sitespt" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[^@]+@(?!(yahoo|hotmail|gmail|googlemail|mail|email|cuoly))[^@]+\.[a-z]{2,}$"))) (<= (str.len z) 27) (not (str.prefixof "nt" z))))
(assert (or (str.suffixof "nxxx=1" y) (not (str.suffixof "itespt" x)) (>= (str.len x) 41)))
(assert (<= (str.len z) 18))
(check-sat)
