; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><img id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></img>") (= x "<noembed id=x tabindex=1 onbeforedeactivate=alert(1)></noembed><input autofocus>")))
(assert (or (= z "2s"" ontransitionrun=alert(1)></rp>") (= z "w3.org/2000/svg"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "CRI")) (= (str.indexof x "e=""tr" 0) 65) (str.in_re x ((_ re.from_regex ecma2020 u) "\d\d\d\d\d$"))))
(assert (str.prefixof "<" y))
(assert (or (= (str.at x 14) " ") (not (<= (str.len x) 90)) (not (str.contains y "ty"))))
(assert (<= (str.len z) 44))
(assert (or (not (= (str.at y 1) "s")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\$\d\., ]+$")))))
(assert (not (= "tyle><im" (str.substr x 46 8))))
(check-sat)
