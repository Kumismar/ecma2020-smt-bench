; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo id=x tabindex=1 onbeforeactivate=alert(1)></bdo>") (= x "<svg><script xlink:href=data&colon;,window.open('https://www.google.com/') </script")))
(assert (or (= z "alert(1)"">test</li>") (= z "=""alert(1)"" contenteditable>test</ol>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "/') ") (= (str.len z) 37)))
(assert (not (= (str.indexof y "rt(1)" 0) 86)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^(#[a-z]+\s*)*#[a-z]+\s*$")))
(assert (or (not (= (str.at z 21) "q")) (= (str.at y 32) "i") (not (= "i>" (str.substr z 17 6)))))
(assert (str.contains z ">te"))
(assert (not (= "le.co" (str.substr x 65 5))))
(check-sat)
