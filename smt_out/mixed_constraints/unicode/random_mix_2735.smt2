; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby onmouseenter=""alert(1)"">test</ruby>") (= x "<img src=""javascript:alert('XSS');"">")))
(assert (or (= z "=x></source><input autofocus>") (= z "seenter=""alert(1)"">test</nobr>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 42) "e") (str.prefixof "seenter=" z)))
(assert (or (not (>= (str.len z) 19)) (not (str.contains (str.replace z "c" "<b>") "ur<b>e>"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 ']+$")) (str.prefixof "<" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z.A-Z0-9]+$")) (str.prefixof "<img src=" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,5}$")) (not (= (str.indexof y ">" 0) 29))))
(check-sat)
