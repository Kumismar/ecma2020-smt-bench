; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>~'\u{5c}u0061' ;  \u{5c}u0074\u{5c}u0068\u{5c}u0072\u{5c}u006F\u{5c}u0077 ~ \u{5c}u0074\u{5c}u0068\u{5c}u0069\u{5c}u0073.  \u{5c}u0061\u{5c}u006C\u{5c}u0065\u{5c}u0072\u{5c}u0074(~'\u{5c}u0061')</script U+") (= x "<li oncopy=""alert(1)"" contenteditable>test</li>")))
(assert (or (= z "pt:alert(1)"" id=""fuzzelement1"">test</a>") (= z "+b+c+d);")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 66) "z") (str.prefixof "pt" z)))
(assert (or (= (str.at z 36) "/") (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=^[.\/+\-() \d]{5,16}$)(?=^((?![.\/+\-() ]{2}).)*$).*$"))) (str.prefixof "pt:alert" z)))
(assert (= "\" (str.substr x 54 1)))
(assert (not (str.suffixof "b+c+d);" z)))
(assert (or (= "<isindex formaction=javascript:alert(1) type=submit valuealert(1)ick>\u{20000}le>test</abbr>" (str.replace y "=cl" "alert(1)")) (not (str.contains y """ cont"))))
(assert (or (not (= (str.len x) 133)) (not (>= (str.len x) 43)) (= (str.at z 7) ";")))
(assert (or (<= (str.len x) 55) (not (= "<var onbeforecut=""alert(1)"" xntenteditable>test</var>t</hr>" (str.replace y "co" "x"))) (= "lert(1)><" (str.substr y 44 9))))
(check-sat)
