; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer id=x tabindex=1 onbeforeactivate=alert(1)></footer>") (= x "<sub onclick=""alert(1)"">test</sub>")))
(assert (or (= z "<input autofocus>") (= z "u onbeforecopy=""alert(1)"" contenteditable>test</menu>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z]*$"))))
(assert (or (not (= (str.indexof x "nde" 0) 17)) (str.suffixof "</EMBED>" y)))
(assert (or (not (= (str.indexof x "r" 0) 6)) (= (str.len y) 87) (str.in_re y ((_ re.from_regex ecma2020 u) "(^\d{5}$)|(^\d{5}-\d{4}$)"))))
(assert (or (not (str.prefixof "<sub" x)) (not (= (str.indexof y "ndex=" 0) 17))))
(assert (str.contains (str.replace z "83" "") "e(88,,8"))
(assert (or (= "(1)"" c" (str.substr y 55 6)) (not (= (str.at x 10) "c")) (= (str.at x 8) "l")))
(assert (or (str.suffixof "est</menu>" y) (not (= "<footer id=x tabindex=1 o foreactivate=alert(1)></footer>u onbeforecopy=""alert(1)"" contenteditable>test</menu>" (str.replace y "nbe" " ")))))
(check-sat)
