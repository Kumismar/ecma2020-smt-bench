; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn ondblclick=""alert(1)"">test</dfn>") (= x "<kbd onblur=alert(1) tabindex=1 id=x></kbd><input autofocus>") (= x "<progress draggable=""true"" ondragleave=""alert(1)"">test</progress>")))
(assert (or (= z "</style><strike id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></strike>") (= z "t(1)></xss>") (= z "t</strong>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "/style><st")) (not (str.contains (str.replace x "kqu" "javascript:") "cjavascript:ote ")) (= (str.indexof y ";XSS" 0) 39)))
(assert (or (not (str.suffixof "ng>" z)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\s*)?(\+)?([- _():=+]?\d[- _():=+]?){6,14}(\s*)?$"))) (not (str.contains x "lert"))))
(assert (or (= (str.at x 20) " ") (str.prefixof "<dfn on" y)))
(assert (or (= (str.indexof x ">" 0) 26) (not (str.contains z "t(1)></x")) (= (str.indexof z "r" 0) 11)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^1[3,5,8]d{9}$"))) (not (= "ong>" (str.substr z 6 9)))))
(assert (= "fn>" (str.substr x 34 10)))
(check-sat)
