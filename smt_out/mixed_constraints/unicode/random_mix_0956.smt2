; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup ondblclick=""alert(1)"">test</optgroup>") (= x "<style>:target {color:red;}</style><basefont id=x style=""transition:color 1s"" ontransitionend=alert(1)></basefont>")))
(assert (or (= z "rack ondragover=alert(1) contenteditable>drop here</track>") (= z "onload=alert(1)></menu>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "er=ale")))
(assert (or (not (str.prefixof "<s" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z A-Z ]*$"))) (str.contains (str.replace y "t" """") "p"":aler")))
(assert (not (= "(1)"">test<" (str.substr y 27 10))))
(assert (or (str.suffixof "</track>" y) (not (str.suffixof "ption>" z))))
(assert (str.suffixof "</menu>" y))
(check-sat)
