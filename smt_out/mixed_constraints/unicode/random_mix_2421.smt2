; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blink onmouseenter=""alert(1)"">test</blink>") (= x "<div draggable=""true"" contenteditable>drag me</div><ul ondrop=alert(1)\u{10348} contenteditable>drop here</ul>")))
(assert (or (= z "0Conxxx=1") (= z "caption oncontextmenu=""alert(1)"">test</caption>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._-]+([a-zA-Z0-9])_?@(([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})|(([a-zA-Z\-0-9]+\.){1,4}[a-zA-Z]{2,}))$"))) (str.contains z "ion")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[^\s@]+@[^\s@]+\.[^\s@]+$")) (not (str.suffixof "</main>" x))))
(assert (or (not (str.prefixof "0Conx" z)) (not (= (str.at y 2) "l")) (not (str.suffixof "/ul>" x))))
(assert (str.contains (str.replace z "1)"">t" "alert(1)") "lert(alert(1)e"))
(assert (or (str.suffixof "py this!" z) (not (= "onx" (str.substr y 45 3)))))
(check-sat)
