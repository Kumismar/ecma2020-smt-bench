; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta http-equiv=""refresh\u{10348}"" \u{1f600}content=""0;javascript&colon;alert(1)""/>") (= x "<input onfocus=write(XSS) autofocus>") (= x "<a href=""\x0Cjavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "f=//0>") (= z "gable=""true"" ondragend=""alert(1)"">test</div>")))
(assert (= y (str.++ x z)))
(assert (or (= "<meta http-equiv=""refresh\u{10348}"" \u{1f600}content=""0;javascript&xn;alert(1)""/>" (str.replace x "colo" "x")) (str.contains y " autofocu") (not (str.prefixof "<a href=""" x))))
(assert (not (= "<meta http-equiv=""refresh\u{10348}"" \u{1f600}contalert(1)""0;javascript&colon;alert(1)""/>" (str.replace x "ent=" "alert(1)"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9\-]+)\.(([a-zA-Z]{2,50})|([a-zA-Z]{2,50}\.[a-zA-Z]{2,50})|([a-zA-Z]{2,50}\.[a-zA-Z]{2,50}\.[a-zA-Z]{2,50}))$"))) (not (= "used" (str.substr x 11 4))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(13[0-9]|14[579]|15[0-3,5-9]|16[6]|17[0135678]|18[0-9]|19[89])\\d{8}$")))))
(assert (not (str.suffixof "us>" z)))
(assert (or (= "a htt" (str.substr x 4 5)) (= "p>" (str.substr z 33 5)) (not (str.suffixof "/del>" y))))
(assert (not (str.suffixof "test</a>" x)))
(assert (not (str.contains x "ou")))
(check-sat)
