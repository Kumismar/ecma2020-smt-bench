; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><meta id=x style=""transition:color 1s"" ontransitionend=alert(1)></meta>") (= x "<shadow id=x \u{1f600}tabindex=1 onbeforeactivate=alert(1)></shado\u{20000}w>")))
(assert (or (= z "aggable=""true"" ondragenter=""alert(1)"">test</table>") (= z "and>") (= z "tyle><span id=x style=""transition:color 1s"" ontransitionend=alert(1)></span>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "e" 0) 5)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{3,5}$"))) (str.suffixof "></meta>" x)))
(assert (= "e=a" (str.substr y 40 3)))
(assert (or (not (str.contains z "ert(1) c")) (not (str.prefixof "<" x))))
(assert (or (not (= "=""a" (str.substr z 26 3))) (= (str.at x 29) "s") (not (= (str.indexof y "edit" 0) 34))))
(assert (not (str.contains z ")></spa")))
(assert (or (= "=aler" (str.substr x 41 5)) (str.prefixof "aggable" z) (not (str.contains x "onen"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{5,6}$"))) (<= (str.len z) 55)))
(check-sat)
