; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><embed ondragover=alert(1) contenteditable>drop here</embed>") (= x "\&\u{1f600}quot;;\u{1d400}alert(&apos;XSS&apos;);//") (= x "<aside id=x tabindex=1 ondeactivate=alert(1)></aside><input id=y autofocus>")))
(assert (or (= z "est</dfn>") (= z "t;@import&apos;http://ha.ckers.\u{20000}org/xss.css&apos\u{10348};;&lt;/STYLE&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "//t" 0) 33)) (= (str.len y) 120) (not (str.contains z "dfn>"))))
(assert (or (= (str.at x 12) "t") (= (str.at x 20) """")))
(assert (or (not (= "t;<b>ort&apos;http://ha.ckers.\u{20000}org/xss.css&apos\u{10348};;&lt;/STYLE&gt;" (str.replace z "@imp" "<b>"))) (not (= (str.indexof y ">dra" 0) 37))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-z A-z]+$"))) (not (str.prefixof "<a" x)) (= ">" (str.substr y 43 4))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{5c}u4E00-\u{5c}u9FA5]+$"))))
(assert (= "t</q>" (str.substr z 8 9)))
(assert (= ";" (str.substr z 64 6)))
(assert (not (= (str.len y) 140)))
(check-sat)
