; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<progress id=x tabindex=1 onbeforeactivate=alert(1)></progress>") (= x "<blink draggable=""true"" ondragleave=""alert(1)"">test</blink>")))
(assert (or (= z "e>test</bdo>") (= z "SS&apos;);//&quot;&gt;") (= z ":javascript:alert(1)""></html onMouseOut>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 12)) (<= (str.len x) 73) (not (str.suffixof "und>" x))))
(assert (not (= (str.indexof z ">t" 0) 1)))
(assert (or (>= (str.len x) 57) (not (= (str.indexof z "e>te" 0) 0)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.{8,20})(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9]).*$")))))
(assert (or (not (= "<blink draggable=""true"" ondraeave=""alert(1)"">test</blink>" (str.replace x "gl" ""))) (str.prefixof "<blin" y)))
(assert (= (str.indexof y "x=1 " 0) 22))
(check-sat)
