; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdi onclick=""alert(1)"">test</bdi>") (= x "&lt;STYLE&gt;&#46;XSS{background-image&#58;url(\""javascript&#058;alert('XSS')\"");}&lt;/STYLE&gt;&lt;A CLASS=XSS&gt;&lt;/A&gt;") (= x "<p onclick=""alert(1)"">test</p>")))
(assert (or (= z "est</q>") (= z "egend><input autofocus>") (= z "st</rt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof """>test</p>" x)) (not (<= (str.len x) 126))))
(assert (or (not (= "<p onclick=""alert(1)"">test</p""st</q>" (str.replace y ">e" """"))) (= "1" (str.substr x 20 1))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\d{9})$"))))
(assert (or (str.suffixof "est</p>" x) (str.contains (str.replace y "b" "<b>") "<<b>di ") (not (= (str.at y 104) "A"))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "(^0$|^[1-9]\d{1,5}$)")))
(check-sat)
