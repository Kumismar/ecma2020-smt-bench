; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT =&quot;blah&quot; SRC=&quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;") (= x "ABC<div style=""x:exp\x00ression(javascript:alert(1)"">DEF")))
(assert (or (= z "</main>") (= z "ditable>test</h1>") (= z "br>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 26) ">")))
(assert (not (str.prefixof "<if" y)))
(assert (or (not (= (str.at z 0) "<")) (not (str.suffixof "t;" x)) (not (str.suffixof "rt(1)"">DEF" x))))
(assert (or (not (= (str.indexof x "tyle=" 0) 9)) (not (= (str.len z) 11))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{3,4}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "\b([1-9]|[1][0-9]|2[0])\b"))) (= (str.at z 34) "1")))
(assert (not (str.suffixof ">DEFbr>" y)))
(assert (not (= (str.indexof x " o" 0) 7)))
(check-sat)
