; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span draggable=""true"" ondragstart=""alert(1)"">test</span>") (= x "<div draggable=""true"" contenteditable>drag me</div><font ondragover=alert(1) contenteditable>drop here</font>")))
(assert (or (= z "dy onclick=""alert(1)"">test</body>") (= z "</slot>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 106) "n") (not (= """al" (str.substr x 16 3))) (str.contains z "e>test<")))
(assert (= (str.at x 2) "i"))
(assert (or (str.contains z "</slot") (str.suffixof "font>" x)))
(assert (or (= (str.at y 68) """") (str.in_re z ((_ re.from_regex ecma2020 u) "^(\s*|[A-Za-z \-]){1,1}$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}a-zA-Z0-9]+$"))) (= (str.indexof x ">" 0) 37)))
(assert (or (not (= (str.indexof x "agg" 0) 8)) (= (str.indexof x "rop" 0) 94)))
(assert (or (not (str.contains y "able>drag")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z\._-]*@[a-zA-Z]*\.[a-zA-Z]{2,}(\.[a-zA-z]{2})?$")))))
(assert (not (str.suffixof "</span>" x)))
(check-sat)
