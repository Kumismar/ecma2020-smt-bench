; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figcaption draggable=""true"" ondragleave=""alert(1)"">test</figcaption>") (= x "<OBJECT classid=clsid:ae24fdae-03c6-11d1-8b76-0080c744f389><param name=url value=javascript:javascript:alert(1)></OBJECT>") (= x "<span onmousedown=""alert(1)"">test</span>")))
(assert (or (= z "</style><center style=""animation-name:x"" onanimationstart=""alert(1)""></center>") (= z "/basefont>") (= z "e><code style=""animation-name:x"" onanimationstart=""alert(1)""></code>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<figc" x) (not (str.contains z "tio")) (not (= (str.at y 91) ":"))))
(assert (or (>= (str.len x) 39) (str.contains (str.replace z "ani" """") "le=""""m")))
(assert (= (str.indexof y "test" 0) 29))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\d\s\w&\-.]{3,}$"))))
(assert (not (str.contains y "ame:x"" ")))
(assert (or (not (str.prefixof "e><c" z)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"))) (not (>= (str.len x) 40))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[(99)(98)](\d*)$"))) (str.contains (str.replace z "sefo" "alert(1)") "/baalert(1)nt>")))
(assert (or (= "ionst" (str.substr y 118 5)) (str.contains (str.replace x "BJECT" "alert(1)") "<Oalert(1) clas")))
(check-sat)
