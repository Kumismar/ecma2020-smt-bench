; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col onmousemove=""alert(1)"">test</col>") (= x "<style>@keyframes x{}</style><element style=""animation-name:x"" onanimationend=""alert(1)""></element>")))
(assert (or (= z ")></listing>") (= z "edeactivate=alert(1)></abbr><input autofocus>") (= z ";IMAGE""; SRC="";javascript:alert(';XSS';);"";>;")))
(assert (= y (str.++ x z)))
(assert (<= (str.len y) 75))
(assert (not (= (str.at x 16) "g")))
(assert (or (str.suffixof "/tfoot>" z) (not (str.suffixof "focus>" z)) (not (= (str.len z) 45))))
(assert (or (not (str.contains (str.replace z ">;" """") """;""")) (not (str.contains (str.replace y "n" "<b>") "o<b>mouse"))))
(assert (or (not (= "onmo" (str.substr x 5 4))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\- ]+$")))))
(assert (or (str.suffixof "/listing>" z) (not (= (str.indexof z "<" 0) 2))))
(assert (str.prefixof "<body/" x))
(assert (or (not (= (str.at z 5) "i")) (str.contains z "er")))
(check-sat)
