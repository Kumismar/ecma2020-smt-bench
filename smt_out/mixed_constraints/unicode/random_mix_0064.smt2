; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee onstart='javascript:alert('1');'>=(\u{25d5}_\u{25d5})=") (= x "<li onkeydown=""alert(1)"" contenteditable>test</li>")))
(assert (or (= z "'XSS');\\"")\"";") (= z "en>") (= z " onpaste=""alert(1)"" contenteditable>test</li>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len z) 53)) (str.contains (str.replace x "li" """") "<"" onk") (str.suffixof "t</li>" y)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,4}$"))))
(assert (not (= (str.len x) 49)))
(assert (or (not (str.prefixof "'XSS');\" z)) (str.prefixof "<style>:ta" y)))
(assert (= (str.len z) 3))
(check-sat)
