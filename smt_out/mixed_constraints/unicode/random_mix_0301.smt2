; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><listing ondrop=alert(1) contenteditable>drop here</listing>") (= x "<marquee onstart=alert(1)>")))
(assert (or (= z "ggable=""true"" contenteditable>drag me</div><area ondrop=alert(1) contenteditable>drop here</area>") (= z "cusin=alert(1)></abbr>")))
(assert (= y (str.++ x z)))
(assert (or (not (= " onst" (str.substr x 8 5))) (str.suffixof "abbr>" z)))
(assert (not (= (str.indexof x "nsta" 0) 10)))
(assert (or (str.contains x "rue"" conte") (= (str.at x 40) "l")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(0|86|17951)?(13[0-9]|15[012356789]|17[0678]|18[0-9]|14[57]|19[189])[0-9]{8}")) (str.contains z "abb") (not (str.contains (str.replace z "t;=" "javascript:") "S&gjavascript:&{()}"))))
(assert (str.suffixof ">" y))
(assert (not (= "ag me<" (str.substr y 58 6))))
(assert (or (not (= """>te" (str.substr x 28 4))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9.-]+$"))) (not (= (str.at z 83) "o"))))
(assert (not (= (str.indexof z "ea on" 0) 46)))
(check-sat)
