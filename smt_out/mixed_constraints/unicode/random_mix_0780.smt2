; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg id=x tabindex=1 onbefore\u{1f4a9}activate=alert(1)></svg>") (= x "ABC<div style=""x:\xE2\x80\x8Bexpression(javascript:alert(1)"">DEF") (= x "<a onmouseover=alert(document.cookie)>xxs link</a>")))
(assert (or (= z "teditable>test</link>") (= z "DY BACKGROUND=""javascript:alert('XSS')"">") (= z "ue"" ondragleave=""alert(1)"">test</mark>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "a>tedit" (str.substr y 48 7))) (not (str.contains y "nmouseov"))))
(assert (or (not (= (str.at y 23) "8")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]([._](?![._])|[a-zA-Z0-9]){6,18}[a-zA-Z0-9]$"))) (= "1" (str.substr z 23 1))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s]{1,32}"))) (str.suffixof "t</mark>" z) (= (str.indexof z "e" 0) 1)))
(assert (or (not (= "teditable>test</li""" (str.replace z "nk>" """"))) (not (= (str.indexof y "d>ro" 0) 38))))
(assert (or (not (>= (str.len y) 102)) (not (str.suffixof "colgroup>" y)) (not (str.prefixof "ue" z))))
(assert (<= (str.len z) 45))
(check-sat)
