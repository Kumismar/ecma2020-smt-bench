; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<LAYER SRC=""http://ha.ckers.org/scriptlet.html""></LAYER>") (= x "<pre draggable=""true"" ondragenter=""alert(1)"">test</pre>")))
(assert (or (= z "1)"" contenteditable>test</dialog>") (= z ")"">test</table>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<ti" x)))
(assert (str.contains x " dr"))
(assert (or (not (= (str.len x) 55)) (str.prefixof "<pr" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}$")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:19|20)[0-9]{2}$"))) (not (= (str.at x 13) "e"))))
(assert (str.prefixof ")"">test<" z))
(assert (or (<= (str.len z) 51) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9]{10})$"))) (not (= (str.indexof x "agg" 0) 7))))
(assert (or (not (<= (str.len x) 57)) (not (= (str.at y 12) "l"))))
(check-sat)
