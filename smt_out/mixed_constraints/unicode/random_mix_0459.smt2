; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter oncontextmenu=""alert(1)"">test</meter>") (= x "<style>:target {transform: rotate(180deg);}</style><tfoot id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tfoot>") (= x "<command onkeypress=""alert(1)"" contenteditable>test</command>")))
(assert (or (= z "</time>") (= z "/q><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "/q><in" z) (<= (str.len y) 143)))
(assert (or (not (= (str.indexof z "><i" 0) 2)) (not (= "180deg" (str.substr y 34 6)))))
(assert (not (= (str.at y 117) "1")))
(assert (or (not (= "<meter oncontextmenu=""alert(1)"">teeter>" (str.replace x "st</m" ""))) (str.contains y "meter on")))
(assert (= (str.indexof x "/co" 0) 52))
(assert (or (not (= (str.len y) 80)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s\-']+$")))))
(assert (str.suffixof "me>" z))
(assert (or (not (str.contains x "otate")) (not (= "te" (str.substr y 12 2))) (not (<= (str.len y) 71))))
(assert (not (= (str.at z 5) "e")))
(check-sat)
