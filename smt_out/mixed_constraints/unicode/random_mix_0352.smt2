; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "'<script>window.onload=function(){document.forms[0].message.value='1';}</script>") (= x "<style>@keyframes x{}</style><b sty\u{10348}le=""animation-name:x"" onanimationend=""alert(1)"">\u{10348}</b>")))
(assert (or (= z "avascript:document.vulnerable=true;"">") (= z "us=alert(1)></th>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{3}\.[0-9]{3}\.[0-9]{3}-[0-9]{2}$"))))
(assert (or (not (= (str.at z 3) "a")) (not (<= (str.len z) 22)) (not (str.contains x "forms"))))
(assert (or (not (= "l" (str.substr x 18 1))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z\u{e0}\u{e1}\u{e2}\u{e7}\u{e8}\u{e9}\u{ea}\u{eb}\u{ec}\u{ed}\u{ee}\u{ef}\u{f0}\u{f1}\u{f2}\u{f3}\u{f4}\u{f5}\u{f9}\u{fa}\u{fb}\u{fc}]*$"))) (str.contains x "{doc")))
(assert (or (not (= "on-name:" (str.substr x 47 8))) (not (str.contains (str.replace y "=" "x") "adxfunc"))))
(assert (or (not (>= (str.len y) 92)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9.@]{2,32}"))) (= (str.indexof x "e:x" 0) 53)))
(assert (= (str.len y) 126))
(check-sat)
