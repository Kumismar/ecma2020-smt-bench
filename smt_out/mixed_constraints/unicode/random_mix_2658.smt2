; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><data onload=alert(1)></data>") (= x "<dialog oncontextmenu=""alert(1)"">test</dialog>")))
(assert (or (= z ".fromCharCode(88,83,83))"">") (= z "1)""></a>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len y) 71)) (not (str.prefixof "<svg><dat" x)) (>= (str.len x) 26)))
(assert (or (= (str.at x 27) "=") (= (str.indexof z """>" 0) 2)))
(assert (or (not (= "<dialog on ontextmenu=""alert(1)"">test</dialog>" (str.replace x "c" " "))) (= (str.indexof z " co" 0) 12)))
(assert (not (= (str.at y 16) "t")))
(assert (not (str.suffixof "></data>" x)))
(assert (or (= """" (str.substr y 30 1)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{1,2}.\d{1,2}\.\d{4}$")))))
(assert (or (not (= (str.at z 7) ">")) (not (= "<alert(1)g oncontextmenu=""alert(1)"">test</dialog>1)""></a>" (str.replace y "dialo" "alert(1)")))))
(check-sat)
