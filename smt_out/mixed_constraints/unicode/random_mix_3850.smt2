; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><section onload=alert(1)></section>") (= x "<sub onmousedown=""alert(1)"">test</sub>") (= x "<svg><rtc onload=alert(1)></rtc>")))
(assert (or (= z "tenteditable>test</font>") (= z "t(1)"" contenteditable>test</var>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "fo"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "not_only_whitespace"))) (not (= (str.at y 109) "m")) (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9.-]+\.[a-z]{2,}$"))))
(assert (or (str.contains (str.replace y "1)></" "<b>") "t(<b>se") (not (= "rop her" (str.substr x 90 7))) (not (str.contains x "onbeforep"))))
(assert (str.prefixof "t" z))
(assert (or (<= (str.len z) 25) (not (str.suffixof "/font>" z))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([wW]{3}[\.][a-zA-Z0-9\.\-]+\.[a-zA-Z]+)*$"))) (str.prefixof "tent" z)))
(check-sat)
