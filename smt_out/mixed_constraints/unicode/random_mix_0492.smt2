; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "!--"" /><script>alert('xss');</script>") (= x "<title onmouseenter=""alert(1)"">test</title>") (= x "<button autofocus onfocusin=alert(1)>test</button>")))
(assert (or (= z "iframe onmousemove=""alert(1)"">test</iframe>") (= z """ autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "</script>" x)))
(assert (or (str.suffixof "t>" x) (= "aggabl" (str.substr x 7 6)) (str.contains x "to")))
(assert (or (= "style-image: url(&quot;javascripjavascript:lert(&#39;XSS&#39;)&quot;);}&lt;/STYLE&gt;&lt;UL&gt;&lt;LI&gt;XSS" (str.replace z "t:a" "javascript:")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[^\s]+")))))
(assert (or (not (str.contains z "(1)""")) (not (str.contains z " autof")) (not (= "t(1)" (str.substr y 32 4)))))
(check-sat)
