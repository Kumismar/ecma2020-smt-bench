; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre ondblclick=""alert(1)"">test</pre>") (= x "--><!-- ---> <img src=xxx:x onerror=javascript:alert(1)> -->")))
(assert (or (= z "ert(1)></slot>") (= z "keygen>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 45) (not (= (str.indexof x "1)"">" 0) 23))))
(assert (or (str.suffixof "est</ol>" x) (str.prefixof "<pr" x)))
(assert (or (not (= (str.at x 19) "e")) (str.prefixof "<p" x) (not (str.suffixof "t</pre>" x))))
(assert (or (not (str.contains (str.replace z "l" "") "</so")) (= (str.len x) 37)))
(assert (or (= (str.indexof z "rt(1)" 0) 12) (= " onerr" (str.substr x 27 6))))
(assert (or (not (= (str.at z 14) "o")) (str.in_re z ((_ re.from_regex ecma2020 u) "(([a-zA-Z]{1})\\d{7})")) (not (str.contains z "rt("))))
(assert (not (>= (str.len z) 18)))
(check-sat)
