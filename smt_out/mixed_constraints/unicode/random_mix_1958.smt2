; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area onkeyup=""alert(1)"" contenteditable>test</area>") (= x "<table id=x tabindex=1 ondeactivate=alert(1)></table><input id=y autofocus>")))
(assert (or (= z "ste=""alert(1)"" contenteditable>test</video>") (= z "t(1)></var>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "nkeyup")) (not (= (str.len z) 11))))
(assert (or (str.contains y "(1)></va") (= "x=1 on" (str.substr y 19 6))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z][A-Za-z0-9]*$")))
(assert (str.contains z "t(1)></"))
(assert (not (= (str.at z 38) "i")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([\w-]+(?:[\.\+][\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z])?)$"))))
(assert (or (= (str.indexof z """ con" 0) 13) (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{2,10}(\s?|[\.]?\d+)*$"))))
(check-sat)
