; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "javascript:alert(""hellox worldss"")") (= x "<bdi onmouseleave=""alert(1)"">test</bdi>") (= x "<command dragga\u{1f600}ble=""true"" ondragleave=""alert(1)"">test</command>")))
(assert (or (= z "lclick=""alert(1)"">test</content>") (= z "cut=""alert(1)"" contenteditable>test</thead>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "k=""al" 0) 5)) (str.prefixof "</font>/<s" x)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "\d\d\d\.\d\d\d\.\d\d\d-\d\d$"))))
(assert (or (not (= (str.at z 0) "n")) (str.contains (str.replace z ")"" " "") "rt(1c") (not (= (str.at z 14) " "))))
(assert (not (str.contains z "e>test<")))
(assert (>= (str.len x) 58))
(check-sat)
