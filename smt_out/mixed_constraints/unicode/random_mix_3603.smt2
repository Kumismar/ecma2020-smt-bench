; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><optgroup style=""animation-name:x"" onanimationend=""alert(1)""></optgroup>") (= x "<textarea onmouseleave=""alert(1)"">test</textarea>") (= x "<datali\u{1f600}st onmouseenter=""aler\u{1f600}t(1)"">test</datalist>")))
(assert (or (= z "t=""alert(1)"">test</em>") (= z "able>test</ul>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof ">" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}\s]+$")))))
(assert (or (not (= "<style>@keyframes <b>/style><optgroup style=""animation-name:x"" onanimationend=""alert(1)""></optgroup>able>test</ul>" (str.replace y "x{}<" "<b>"))) (not (str.contains x "rage")) (str.in_re y ((_ re.from_regex ecma2020 u) "^\D{1,30}$"))))
(assert (str.suffixof "-(" y))
(assert (str.contains y "datali\u{1f600}"))
(assert (or (= "<style>@keyframes x{}</style><optgroup style=""animation-name:x"" onanimationend=""alert(1)""></optgro""alert(1)"">test</em>" (str.replace y "up>t=" "")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\d\s]+$"))))
(check-sat)
