; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><frameset id=x style=""transition:color 1s"" ontransitionend=alert(1)></frameset>") (= x "<main onpaste=""alert(1)"" contenteditable>test</main>") (= x "<dialog id=x tabindex=1 onactivate=alert(1)></dialog>")))
(assert (or (= z "aggable=""true"" ondrag=""alert(1)"">test</nextid>") (= z "style=""animation-name:x"" onanimationstart=""alert(1)""></form>")))
(assert (= y (str.++ x z)))
(assert (or (= ")"">test</n" (str.substr y 83 10)) (str.contains y "y>nteditab") (= (str.at z 2) "e")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?:\+?\d+\s*)?\(?\d{3}\)?[\s\.-]?\d{3}[\s\.-]?\d{4}$"))) (not (= (str.indexof x "</s" 0) 27)) (str.in_re y ((_ re.from_regex ecma2020 u) "[\D0-9]{3,20}|$"))))
(assert (>= (str.len y) 92))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^([A-z. \u{e1}\u{c1}\u{e9}\u{c9}\u{f3}\u{d3}\u{f6}\u{d6}\u{151}\u{150}\u{fa}\u{da}\u{fc}\u{dc}\u{171}\u{170}]){3,}$")) (not (= "<input onmousemove=""alert(1)"">test</input>;livescript:[code]&quo<b>gt;" (str.replace y "t;&" "<b>"))) (not (str.prefixof "<main o" x))))
(assert (or (not (str.prefixof "style=""ani" z)) (not (str.contains (str.replace z "e=" "<b>") "gabl<b>""t"))))
(assert (= (str.at x 29) "e"))
(check-sat)
