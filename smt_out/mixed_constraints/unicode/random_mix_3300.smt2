; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<acronym onmousemove=""alert(1)"">test</acronym>") (= x "<data id=x tabindex=1 onfocusin=alert(1)></data>") (= x "<ul onfocusout=alert(1) tabindex=1 id=x></ul><input autofocus>")))
(assert (or (= z "ve=""alert(1)"">test</isindex>") (= z "/rt>") (= z ">test</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "</bdi>" y) (not (= (str.at y 64) "s"))))
(assert (str.suffixof "us>" x))
(assert (= (str.indexof y """" 0) 65))
(assert (not (str.prefixof "<aud" y)))
(assert (or (not (str.suffixof "isindex>" y)) (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z-\s]+$"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^\S+@\S+\.([0-9a-z]{2,3}|[0-9]{1,3})$")) (not (str.contains (str.replace x "FRAM" "") "&lt;E")) (= "/<b>t>" (str.replace z "r" "<b>"))))
(assert (or (str.prefixof "<ul onfoc" x) (= "alert(1)" (str.replace z "/rt>" "alert(1)"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{3,6}"))))
(assert (not (str.prefixof "<acr" y)))
(check-sat)
