; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ins onbeforecut=""alert(1)"" contenteditable>test</ins>") (= x "<x contenteditable oninput=alert(1)>input here!")))
(assert (or (= z "ditable>test</spacer>") (= z "ut oninput=alert(1) value=xss>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[$@$!%*?&])[A-Za-z\d$@$!%*?&]{8,}"))) (= "<ins onbeforecut=""alert(1)"" coalert(1)editable>test</ins>ditable>test</spacer>" (str.replace y "ntent" "alert(1)")) (not (str.prefixof "<x content" y))))
(assert (or (not (str.suffixof ">" x)) (= "r" (str.substr y 10 1))))
(assert (str.contains x "frame on"))
(assert (or (not (str.contains (str.replace z "te" "") "le>st</s")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z'  -]+$")))))
(assert (or (not (str.contains (str.replace y "cut=""" "") "orealer")) (not (str.contains z "itable>te")) (not (= (str.indexof y ")"" " 0) 25))))
(assert (not (str.contains z "st<")))
(check-sat)
