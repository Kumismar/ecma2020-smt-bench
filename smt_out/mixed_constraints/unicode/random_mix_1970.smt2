; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form onclick=""alert(1)"">test</form>") (= x "<x/onxxx=1") (= x "<img src=x\x12onerror=""javascript:alert(1)"">")))
(assert (or (= z "er=""alert(1)"">test</rtc>") (= z "editable>test</var>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 5) "x"))
(assert (not (= (str.len x) 44)))
(assert (str.contains y """java"))
(assert (not (= "<style>@keyframes x{}</style><ol style=""animation-name:x"" onanimationend=""alert(1)""></ol>dio id=x tex=1 onbeforedeactivate=alert(1)></audio><input autofocus>" (str.replace y "abind" ""))))
(assert (or (not (str.contains z "est</v")) (not (= "/va" (str.substr z 14 3))) (str.in_re z ((_ re.from_regex ecma2020 u) "^([A-z\u{119}\u{f3}\u{105}\u{15b}\u{142}\u{17c}\u{17a}\u{107}\u{144}\u{118}\u{d3}\u{104}\u{15a}\u{141}\u{17b}\u{179}\u{106}\u{143} ]){2,}$"))))
(assert (or (not (>= (str.len z) 9)) (str.suffixof "rtc>" y)))
(assert (or (str.contains x "m onclic") (>= (str.len x) 1)))
(assert (or (not (= (str.at x 17) "r")) (not (= (str.indexof z "i>" 0) 0))))
(check-sat)
