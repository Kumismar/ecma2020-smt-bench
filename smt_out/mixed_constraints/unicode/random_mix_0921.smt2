; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG SRC=&quot;jav&amp;#x0D;ascript:alert(&apos;XSS&apos;);&quot;&gt;") (= x "&#X0003C;")))
(assert (or (= z "ert;pg(""XSS"")") (= z "(1)></span>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z\s.-]+"))) (not (>= (str.len x) 4)) (= "#x0D;ascri" (str.substr y 26 10))))
(assert (str.contains y "rt(1)>"))
(assert (or (str.prefixof "(1)><" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9 -]+$")))))
(assert (or (not (= (str.len z) 11)) (not (= ";#x0D;" (str.substr x 25 6))) (not (str.suffixof ";" x))))
(assert (or (str.suffixof """)" z) (>= (str.len z) 22) (not (str.contains z "></spa"))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\-\.\+]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,7}|[0-9]{1,3})(\]?)$")))
(assert (or (not (= (str.at z 1) "r")) (not (str.contains z "(""XS"))))
(check-sat)
