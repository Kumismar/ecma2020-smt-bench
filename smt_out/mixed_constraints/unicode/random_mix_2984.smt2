; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rt onmouseleave=""alert(1)"">test</rt>") (= x "<x onmousedown=alert(1\u{20000})>click this!") (= x "<footer onmouseup=""alert(1)"">test</footer>")))
(assert (or (= z "ert(1)></slot>") (= z "e"" ondragenter=""alert(1)"">test</dfn>") (= z "r onkeyup=""alert(1)"" contenteditable>test</tr>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^DE\d{2}[ ]\d{4}[ ]\d{4}[ ]\d{4}[ ]\d{4}[ ]\d{2}|DE\d{20}$"))))
(assert (or (= (str.indexof x "09" 0) 21) (= "<" (str.substr y 43 1))))
(assert (or (str.contains (str.replace x "es" "alert(1)") "talert(1)t</rt") (str.prefixof "e"" ond" z) (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451} ]{1,28}"))))
(assert (or (= """alert(1" (str.substr y 18 8)) (not (= (str.indexof z "di" 0) 9))))
(assert (or (str.contains (str.replace y "lick" "x") ">cx thi") (not (= "<rt onmouseleave=""alert""test</rt>r onkeyup=""alert(1)"" contenteditable>test</tr>" (str.replace y "(1)"">" """")))))
(check-sat)
