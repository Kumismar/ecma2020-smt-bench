; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><output id=x style=""transition:color 10s"" ontransitioncancel=alert(1\u{1d400})></output>") (= x "<option onbeforepaste=""alert(1)"" contenteditable>test</option>") (= x "<dir onmouseup=""alert(1)"">test</dir>")))
(assert (or (= z "rt(&apos;XSS&apos;);&quot;&gt;") (= z "progress><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<smal" x) (str.contains (str.replace x ":c" "x") "ionxo")))
(assert (or (= "gt;" (str.substr z 27 7)) (not (= "rt(&apos;XSS&apos;);&quot;&"";" (str.replace z "gt" """")))))
(assert (= (str.at y 10) "s"))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9#,-:;()&@_.\r\n ]{5,200}$")))
(assert (or (= (str.at x 30) "<") (= (str.at y 45) "<")))
(check-sat)
