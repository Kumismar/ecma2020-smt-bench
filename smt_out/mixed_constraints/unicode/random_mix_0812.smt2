; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><bgsound onload=alert(1)></bgsound>") (= x "<thead id=x tabindex=1 onactivate=alert(1)></thead>")))
(assert (or (= z "dl>") (= z "rt(1)></big>") (= z "ble>test</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[\\.0-9]+$")) (= "></b" (str.substr y 45 4))))
(assert (or (not (str.suffixof "d>" x)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\D{1,20}$"))) (not (str.contains z "l>"))))
(assert (or (str.suffixof "></big>" z) (not (= (str.at y 14) "b")) (not (= "dl>" (str.substr z 0 4)))))
(assert (= (str.indexof x "th" 0) 1))
(assert (not (str.prefixof "rt" z)))
(assert (or (str.prefixof "<thead i" y) (not (>= (str.len z) 1)) (not (= (str.at x 8) "d"))))
(assert (or (str.suffixof "gsound>dl>" y) (= (str.indexof z "l>" 0) 1)))
(check-sat)
