; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src\x32=x onerror=""javascript:alert(1)"">") (= x "<svg><ins onload=alert(1)></ins>") (= x "<rb id=x tabindex=1 onfocus=alert(1)></rb>")))
(assert (or (= z "u=""alert(1)"">test</section>") (= z "ble>test</shadow>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<svg><ins" x)) (= (str.at y 50) "<")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9 () + -]{1,20}$"))) (str.suffixof "(1)></ins>" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z][a-zA-Z ]+[a-zA-Z]$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) ".*[0-9]{10}.*"))) (= (str.indexof y "er" 0) 30) (= (str.len y) 69)))
(assert (str.contains z "st</sec"))
(check-sat)
