; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<math>") (= x "<a href=""\x0Cjavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<embed src=/ onload=alert(1)>")))
(assert (or (= z " onclick=""alert(1)"">test</tr>") (= z "r=""a\u{1f600}lert(\u{1d400}1)"">test</bdi>") (= z "ditable>drag me</div><rp ondrop=alert(1) contenteditable>drop here</rp>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z " conte") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^AI\d{3,7}|AX\d{3,7}$"))) (= (str.indexof z """a\u{1f600}le" 0) 2)))
(assert (or (= "<a href=""\x0Cjava""cript:javascript:alert(1)"" id=""fuzzelement1"">test</a>r=""a\u{1f600}lert(\u{1d400}1)"">test</bdi>" (str.replace y "s" """")) (not (str.prefixof "st</kbd" z)) (str.contains z "/div")))
(assert (or (not (str.suffixof "r>" y)) (str.contains z "entedi")))
(assert (not (= (str.indexof z "b" 0) 10)))
(assert (or (not (str.suffixof ">" z)) (str.in_re z ((_ re.from_regex ecma2020 u) ".{3,75}")) (not (= (str.len y) 58))))
(assert (or (not (str.suffixof " here</rp>" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?!.*\s)[a-zA-Z\d\W\D]{8,99}$"))) (= "rt(1)>" (str.substr x 23 8))))
(check-sat)
