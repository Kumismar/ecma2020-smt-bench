; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr id=x tabindex=1 onfocusin=alert(1)></abbr>") (= x "<svg><template onload=alert(1)></template>") (= x "<svg><hr onload=alert(1)></hr>")))
(assert (or (= z "t><input autofocus>") (= z "bindex=1 ondeactivate=alert(1)></em><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._+-]*@[a-zA-Z0-9._+-]+\.[a-z]{2,4}$"))) (not (= (str.len y) 88)) (= (str.indexof x " tab" 0) 10)))
(assert (or (not (<= (str.len y) 74)) (not (str.prefixof "TML&gt;&l" z))))
(assert (or (str.suffixof "us>" y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9\/]{1,50}$"))) (not (= (str.indexof y "t" 0) 20))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Z]{2,3}_[a-z]+:[0-9]{4}$"))) (= "<noemb<b>aggable=""true"" ondrag=""alert(1)"">test</noembed>" (str.replace x "ed dr" "<b>")) (<= (str.len y) 62)))
(assert (or (str.contains y "br>t><in") (not (= (str.at z 24) "e"))))
(assert (not (str.suffixof "fieldset>" x)))
(assert (not (str.prefixof "<div drag" x)))
(check-sat)
