; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=""livescript:[code]"">") (= x "<a href=""\x08javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<div draggable=""true"" contenteditable>drag me</div><nobr ondrop=alert(1) contenteditable>drop here</nobr>")))
(assert (or (= z "\u{1f600}gend>") (= z "/menu>") (= z "t(1)"">test</basefont>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "nu>" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^\.]+$"))) (= (str.at x 10) "x")))
(assert (or (not (str.prefixof "1) tabin" z)) (not (= "cri" (str.substr x 18 3)))))
(assert (str.prefixof "<a href=" y))
(assert (or (not (str.contains (str.replace y "ml>//" " ") "/ht ")) (not (str.contains (str.replace y ">/m" " ") "]"" enu>"))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9-]*$")))
(check-sat)
