; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea onfocusout=alert(1) id=x></textarea><input autofocus>") (= x "<hgroup onmouseout=""alert(1)"">test</hgroup>")))
(assert (or (= z "</time>") (= z "vascript:alert(';XSS';)>;") (= z "IZE=""&{alert('XSS')}"">")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<hgrou" y)))
(assert (or (str.prefixof "<" x) (str.contains (str.replace z "/tim" "javascript:") "<javascript:e>")))
(assert (or (= (str.at y 49) "p") (str.prefixof "vascrip" z) (= (str.indexof y "><" 0) 34)))
(assert (str.contains (str.replace x "put a" "<b>") "><in<b>utof"))
(assert (or (str.contains x "eo") (str.in_re z ((_ re.from_regex ecma2020 u) "^[\+]?[0-9]{1,3}[\s]?[\(]?[0-9]{0,2}[\)]?[\s]?[0-9\s]{10,14}"))))
(check-sat)
