; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main onmouseup=""alert(1)"">test</main>") (= x "</title><SCRIPT>document.vulnerable=true;</script>")))
(assert (or (= z "tion ondblclick=""alert(1)"">test</section>") (= z "in=alert(1)></nextid>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]2-?[0-9]3$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_+-]{3,15}")))))
(assert (or (= "able=true" (str.substr y 31 9)) (not (= (str.at z 20) "r")) (not (= (str.at y 70) ">"))))
(assert (or (not (= (str.at x 16) """")) (not (= (str.indexof y "e" 0) 6)) (not (str.suffixof "extid>" y))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z0-9\?\-\.+!_]{3,14}$")) (= "tion ondblcli<b>=""alert(1)"">test</section>" (str.replace z "ck" "<b>"))))
(assert (or (not (= "javascript:on ondblclick=""alert(1)"">test</section>" (str.replace z "ti" "javascript:"))) (not (str.contains z "alert")) (= "^`=alert(\" (str.substr y 54 10))))
(assert (not (= (str.indexof x """>" 0) 25)))
(check-sat)
