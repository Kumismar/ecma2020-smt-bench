; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog onmouseleave=""alert(1)"">test</dialog>") (= x "<acronym id=x tabindex=1 onfocusin=alert(1)></acronym>") (= x "<header onblur=alert(1) tabindex=1 id=x></header><input autofocus>")))
(assert (or (= z "ble=""true"" ondragend=""alert(1)"">test</tfoot>") (= z "rtc>") (= z "1)""></iframe>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "cro" 0) 2)))
(assert (or (str.suffixof "me>" y) (= (str.len y) 58)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._-]+@[a-zA-Z0-9.-]{2,}[.][a-zA-Z]{2,4}$"))) (str.contains y "dialog>rtc") (not (>= (str.len y) 110))))
(assert (or (not (= "ti" (str.substr z 21 2))) (not (str.suffixof ">" z))))
(assert (str.suffixof "s>" x))
(assert (not (str.contains (str.replace y "></" "") "d=xhe")))
(assert (not (= "dex=" (str.substr x 29 4))))
(assert (str.prefixof "<META HTT" y))
(check-sat)
