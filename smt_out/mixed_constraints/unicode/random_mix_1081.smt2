; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>alert(1)</script>") (= x "<!--<img src=""--><img src=x onerror=javascript:alert(1)//"">")))
(assert (or (= z "=1 onbeforeactivate=alert(1)></caption>") (= z "1 onactivate=alert(1)></footer>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len y) 73)) (not (str.suffixof "</footer>" y))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[A-Z])(?=.*[0-9])(?=.*[a-z]).{8,40}$")) (<= (str.len z) 39)))
(assert (or (not (= (str.at z 38) ">")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(['a-zA-z\u{430}-\u{44f}\u{410}-\u{44f}\u{401}\u{451}]\s?-?){2,50}$")))))
(assert (not (>= (str.len x) 49)))
(assert (or (= (str.at y 69) "t") (not (str.suffixof "t(1)//"">" x))))
(assert (or (not (= (str.indexof z "t</" 0) 20)) (str.contains (str.replace y ">" "alert(1)") """--alert(1)<")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^0\d-?\d{4}-?\d{4}$"))))
(assert (= "ip" (str.substr x 21 2)))
(check-sat)
