; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<BODY ONLO\u{1f600}AD=javas\u{20000}cript:alert(1)>") (= x "<center id=x tabindex=1 onbeforedeactivate=alert(1)></center><input autofocus>")))
(assert (or (= z " ondblclick=""alert(1)"">test</dfn>") (= z "\u{1f600}shadow>")))
(assert (= y (str.++ x z)))
(assert (not (= "\u{1f600}shadoalert(1)" (str.replace z "w>" "alert(1)"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z .]+$"))))
(assert (or (= "<center " (str.substr y 0 8)) (not (= (str.indexof z "w" 0) 6)) (not (= "t</df" (str.substr z 26 5)))))
(assert (or (not (= "r id=x " (str.substr x 6 7))) (str.suffixof ":alert(1)>" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1][3,4,5,7,8][0-9]{9}$")))))
(assert (not (= (str.indexof x " on" 0) 23)))
(assert (= (str.len x) 52))
(assert (or (not (= "<center id=x index=1 onbeforedeactivate=alert(1)></center><input autofocus>\u{1f600}shadow>" (str.replace y " tab" " "))) (= (str.at z 26) "t")))
(check-sat)
