; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<button id=x tabindex=1 ondeactivate=alert(1)></button><input id=y autofocus>") (= x """/></a></><img src=1.gif onerror=alert(1)>")))
(assert (or (= z "ouseleave=""alert(1)"">test</article>") (= z "1)"" contenteditable>test</menuitem>") (= z "ol onkeyup=""alert(1)"" contenteditable>test</multicol>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len y) 112)) (= (str.at y 30) "o")))
(assert (or (not (= (str.indexof z "ousel" 0) 0)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+.[w]+$")))))
(assert (or (= "<meter<b>onbeforecut=""alert(1)"" contenteditable>test</meter>" (str.replace x " " "<b>")) (not (= "up o" (str.substr x 7 4))) (not (= (str.indexof z "onte" 0) 5))))
(assert (not (= (str.len y) 130)))
(assert (not (str.prefixof "1)"" c" z)))
(assert (= "teditable" (str.substr z 28 9)))
(check-sat)
