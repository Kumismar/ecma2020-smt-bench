; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame ondblclick=""alert(1)"">test</frame>") (= x "<video onmouseup=""alert(1)"">test</video>") (= x "<TD BACKGROUND=""javascript:alert('XSS')"">")))
(assert (or (= z "ntenteditable>test</dt>") (= z "s>") (= z "</base>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "'" 0) 33)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[1|2]{1}[0-9]{3}-[0|1]{1}[0-9]{1}-[0-3]{1}[0-9]{1}$")))))
(assert (not (= "<frame oalert(1)click=""alert(1)"">test</frame>" (str.replace x "ndbl" "alert(1)"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z._\-]+@[0-9a-zA-Z._\-]+$"))) (= (str.at y 25) ")") (not (str.suffixof "')"">" x))))
(assert (or (not (= ">ntent" (str.substr y 39 6))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df} -]+$"))))
(assert (or (= (str.at x 14) "u") (= (str.indexof x "D=""ja" 0) 13)))
(assert (not (= (str.indexof y "est" 0) 29)))
(assert (or (not (str.suffixof "le=true;"">" x)) (not (= "<TD BACKGROUND=vascript:alert('XSS')"">" (str.replace x """ja" "")))))
(check-sat)
