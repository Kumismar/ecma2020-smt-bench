; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset id=x tabindex=1 onactivate=alert(1)></frameset>") (= x "<script onpaste=""alert(1)"" contenteditable>test</script>")))
(assert (or (= z "script>alert(1);</script>") (= z "t:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (not (= "&#13;<blink/&#13; onmouseover=pr&#x6F;mp&#116;(1)>OnMous<b>er {Firefox & Opera}" (str.replace x "eOv" "<b>"))))
(assert (or (= (str.len z) 25) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{2,5}-[0-9]{1,4}-[0-9]{4,5}")))))
(assert (str.contains z "sele"))
(assert (or (= (str.indexof z ">" 0) 29) (= (str.at x 42) "(")))
(assert (= ">" (str.substr z 1 6)))
(assert (>= (str.len x) 48))
(check-sat)
