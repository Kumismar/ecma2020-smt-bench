; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><li id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></li>") (= x "<embed id=x tabindex=1 onbeforedeactivate=alert(1)></embed><input autofocus>") (= x "<picture><source srcset=""validimage.png""><img onload=alert(1)></picture>")))
(assert (or (= z ";") (= z "t(1)"">test</tt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<embed" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9a-zA-Z-\u{c1}\u{c0}\u{c2}\u{c4}\u{c9}\u{c8}\u{ca}\u{cb}\u{cd}\u{cc}\u{ce}\u{cf}\u{d3}\u{d2}\u{d4}\u{d6}\u{da}\u{d9}\u{db}\u{dc}\u{e1}\u{e0}\u{e2}\u{e4}\u{e9}\u{e8}\u{ea}\u{eb}\u{ed}\u{ec}\u{ee}\u{ef}\u{f3}\u{f2}\u{f4}\u{f6}\u{fa}\u{f9}\u{fb}\u{fc}\u{c7}'\u{e7},.\u{20ac}\u{a3}$_ \.]{1,300}$")))))
(assert (or (not (str.prefixof "<" y)) (not (str.prefixof "<sty" x))))
(assert (= (str.at z 9) "t"))
(assert (or (= (str.len z) 15) (not (= (str.at y 41) "=")) (not (str.in_re y ((_ re.from_regex ecma2020 u) ".+@.+\..+$")))))
(assert (or (= "<embed ialert(1)tabindex=1 onbeforedeactivate=alert(1)></embed><input autofocus>t(1)"">test</tt>" (str.replace y "d=x " "alert(1)")) (= "t(1)""><b>t</tt>" (str.replace z "tes" "<b>")) (= "lert(1)><" (str.substr x 94 9))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z\u{b4}`\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{e4}\u{eb}\u{ef}\u{f6}\u{fc}\u{c4}\u{cb}\u{cf}\u{d6}\u{dc}\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{f1}\u{d1}\s]{5,40})+$")) (not (= (str.indexof z "(1)""" 0) 1))))
(check-sat)
