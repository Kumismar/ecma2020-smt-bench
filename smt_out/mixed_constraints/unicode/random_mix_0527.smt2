(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg onResize svg onResize=""javascript:javascript:alert(1)""></svg onResize>") (= x "<noembed oncut=""alert(1)"" contenteditable>test</noembed>") (= x "<select onbeforepaste=""alert(1)"" contenteditable>test</select>")))
(assert (or (= z "tenteditable>drag me</div><code ondrop=alert(1) cont\u{1d400}enteditable>d\u{1d400}rop here</code>") (= z ") contenteditable>drop here</i>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 43) "s"))
(assert (or (not (str.suffixof "3,83))"">" z)) (str.contains (str.replace y "t" """") "ec"" on")))
(assert (or (str.contains (str.replace y ":a" "x") "txlert") (not (= "<html onMouseMove html onMouseMovvascript:javascript:alert(1)""></html onMouseMove>" (str.replace x "e=""ja" ""))) (>= (str.len x) 47)))
(assert (or (= "t</select>" (str.substr x 52 10)) (str.contains z "aler")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\+7\s\([0-9]{3}\)\s[0-9]{3}-[0-9]{2}-[0-9]{2}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}A-Za-z\s]{2,50}$")))))
(check-sat)
