; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x12javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<b draggable=""true"" ondragenter=""alert(1)"">test</b>")))
(assert (or (= z "yle><td style=""animation-name:x"" onanimationstart=""alert(1)""></td>") (= z "onanimationstart=""alert(1)""></table>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "e=""a" 0) 12)) (not (str.contains z "mation-nam")) (not (<= (str.len x) 72))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*\S).{3,}"))) (str.suffixof ">" x)))
(assert (or (not (>= (str.len z) 34)) (not (= "enter=""" (str.substr x 26 7))) (= (str.indexof z """></" 0) 26)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "\b([1-9]|[1][0-9]|2[0])\b"))) (not (str.suffixof "</acronym>" x))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{3}-\d{10}$"))))
(check-sat)
