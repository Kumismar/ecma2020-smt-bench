; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script ^__^>alert(String.fromCharCode(49))</script ^__^") (= x "<image id=x tabindex=1 onfocus=alert(1)></image>")))
(assert (or (= z "'xss'); var x='") (= z "]>]</div>") (= z "nd=""alert(1)""></bdi>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9a-z\u{f1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa},\s\-]+$"))) (str.prefixof "<html" x)))
(assert (or (not (str.suffixof "div>" z)) (not (str.contains (str.replace x "alert" "") "_^>(St"))))
(assert (or (not (str.prefixof "<s" x)) (not (= (str.len y) 65)) (not (= "iv>" (str.substr z 6 6)))))
(assert (not (= (str.indexof x "<st" 0) 13)))
(assert (str.contains z "t>"))
(assert (or (not (= (str.indexof y "1 " 0) 21)) (str.contains (str.replace x "ri" "alert(1)") "calert(1)pt ^") (str.in_re z ((_ re.from_regex ecma2020 u) "(?=^.{4,10}$)((?=.*\d)|(?=.*\W+))(?![.\n])((?=.*[A-Z])|(?=.*[a-z])).*$"))))
(check-sat)
