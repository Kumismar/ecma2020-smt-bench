; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a onmousemove=""alert(1)"">test</a>") (= x "<label id=x tabindex=1 onfocus=alert(1)></label>") (= x "<form id=x tabindex=1 onactivate=alert(1)></form>")))
(assert (or (= z """alert(1)"" contenteditable>test</samp>") (= z "alert(1)"" contenteditable>test</colgroup>") (= z "t;IMG SRC=\""jav&#x0A;ascript&#058;alert('XSS');\""&gt;")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 47) (str.contains (str.replace y ">te" "") "tablest</c")))
(assert (= (str.indexof z "test" 0) 10))
(assert (or (not (str.contains x "inde")) (not (str.prefixof "t=""" z))))
(assert (not (str.contains (str.replace y "ipt&#" "x") "scrx058;")))
(assert (or (= "for" (str.substr y 1 3)) (= (str.at y 24) """") (str.suffixof "est</tt>" z)))
(assert (or (= (str.indexof z "co" 0) 10) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^<>&%\t\n]+$"))) (not (= "alert(1)"" contenteditable>txcolgroup>" (str.replace z "est</" "x")))))
(assert (or (str.contains y "058;") (= (str.len z) 41)))
(check-sat)
