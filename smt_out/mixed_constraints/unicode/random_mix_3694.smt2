; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext id=x tabindex=1 onfocus=alert(1)></plaintext>") (= x "<video src=1 onerror=alert(1)>")))
(assert (or (= z "t ^__^") (= z "r>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z])\w\S{6,}"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\d{10})$")))))
(assert (or (not (str.prefixof "<plaintex" y)) (str.suffixof "text>" x)))
(assert (or (not (= "alert(1)" (str.replace z "r>" "alert(1)"))) (str.contains x "></pl") (not (str.contains (str.replace y "r=a" "<b>") "ro<b>lert"))))
(assert (not (str.contains x "rt(1)")))
(check-sat)
