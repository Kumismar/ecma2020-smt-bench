; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s onpaste=""alert(1)"" contenteditable>test</s>") (= x "&#X0003C")))
(assert (or (= z "td><input autofocus>") (= z "ns=""#""></svg>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<s onpa" x))
(assert (or (= (str.at x 39) "e") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-HJ-NPR-Za-hj-npr-z\d]{8}[\dX][A-HJ-NPR-Za-hj-npr-z\d]{8}"))) (not (str.suffixof "cus>" z))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{2}[0-9]{4,6}[0-9]{3,4}$"))))
(assert (or (= (str.indexof y "d>" 0) 9) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\s*(\+420)?\s*[1-9]\s*[0-9]\s*[0-9]\s*[0-9]\s*[0-9]\s*[0-9]\s*[0-9]\s*[0-9]\s*[0-9]\s*$")))))
(assert (or (not (str.contains (str.replace z "s=""#" "alert(1)") "nalert(1)""")) (= "table>test" (str.substr y 32 10))))
(assert (or (= ")""" (str.substr z 6 2)) (not (= (str.indexof y "put" 0) 52)) (= (str.indexof y "ocu" 0) 23)))
(check-sat)
