; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main ondblclick=""alert(1)"">test</main>") (= x "<label>type a,b,c,d - watch the network tab/traffic (JS is off, latest NoScript)</label>") (= x "<style>:target {color:red;}</style><option id=x style=""transition:color 1s"" ontransitionend=alert(1)></option>")))
(assert (or (= z "menuitem>") (= z "tails id=x tabindex=1 onactivate=alert(1)></details>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.+@((?![aA][sS][dD][fF]).)+\..+$"))) (str.contains (str.replace x "crip" """") "javas""t")))
(assert (= "/opti" (str.substr x 102 5)))
(assert (or (not (= "menuite" (str.substr y 39 7))) (not (str.prefixof "<label>t" y))))
(assert (not (= "tyle>:targ" (str.substr y 2 10))))
(assert (= "<main ondblclick=""alert(1)"">tjavascript:/main>" (str.replace x "est<" "javascript:")))
(assert (not (= (str.len y) 51)))
(check-sat)
