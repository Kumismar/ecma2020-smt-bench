; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:\xE2\x80\x83expression(javascript:alert(1)"">DEF") (= x "<tr onmouseenter=""alert(1)"">test</tr>")))
(assert (or (= z "di onload=alert(1)></bdi>") (= z "nload=alert(1)></dialog>") (= z "ut autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len y) 59)))
(assert (= "us" (str.substr z 10 2)))
(assert (or (not (= (str.len x) 37)) (not (= (str.at y 47) "u"))))
(assert (str.suffixof "tr>" x))
(assert (or (str.prefixof "di onl" z) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(0941)([0-9]{7})")))))
(assert (str.suffixof "</tr>" x))
(assert (= "1)""" (str.substr y 57 3)))
(assert (or (= "e" (str.substr y 16 1)) (not (= "<form onfocusout=alert(1) ""ndex=1 id=x></form><input autofocus>" (str.replace x "tabi" """"))) (= (str.indexof x """>D" 0) 59)))
(assert (= (str.at x 32) "r"))
(check-sat)
