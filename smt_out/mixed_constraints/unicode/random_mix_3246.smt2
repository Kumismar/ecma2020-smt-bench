; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen onmouseleave=""alert(1)"">test</keygen>") (= x "<listing onbeforepaste=""alert(1)"" contenteditable>test</listing>") (= x "<INPUT TYPE=""IMAGE"" SRC=""javascript:javascript:alert(1);"">")))
(assert (or (= z ";\u{1d400}alert(&apos;XSS&apos;);//") (= z "test</datalist>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "t</da" 0) 3)))
(assert (or (not (= (str.at x 29) "e")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((\+?32)?(4)\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d)|((04)\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d)$"))) (not (= (str.indexof x "=""al" 0) 22))))
(assert (or (not (= (str.indexof z "tali" 0) 8)) (not (str.contains x "mpo")) (not (str.contains z "</dat"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^(\d{4}[- ]){3}\d{2,4}|\d{14,16}$")) (str.suffixof ")"">DEF" z) (not (= (str.len x) 45))))
(check-sat)
