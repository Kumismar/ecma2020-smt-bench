; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><tfoot style=""animation-name:x"" onanimationend=""alert(1)""></tfoot>") (= x "<blockquote onm\u{1f4a9}ouseup=""alert(\u{20000}1)"">test</blockquote>")))
(assert (or (= z ")"">test</html>") (= z "rameset>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<bl" x)))
(assert (or (not (str.contains y "7/&qu")) (not (str.contains (str.replace z "st<" " ") ">te /h")) (not (str.suffixof "ript>" x))))
(assert (not (str.suffixof "eset>" y)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^.+@((?!gmail)(?!yahoo)(?!outlook)(?!icloud)(?!email)(?!qq)(?!aol)(?!hotmail).)+\..+$")))
(assert (or (= ")"">javascript:est</html>" (str.replace z "t" "javascript:")) (not (str.prefixof "ra" z))))
(assert (not (= (str.indexof z "eset" 0) 3)))
(assert (or (= (str.indexof x "/st" 0) 22) (str.suffixof "ml>" z)))
(assert (<= (str.len y) 117))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9]{1}"))) (str.prefixof "<style>" y)))
(assert (not (= (str.indexof z "t>" 0) 6)))
(check-sat)
