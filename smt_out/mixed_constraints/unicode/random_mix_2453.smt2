; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc oncopy=""alert(1)"" contenteditable>test</rtc>") (= x "<div onblur=alert(1) tabindex=1 id=x></div><input autofocus>") (= x "<style>@keyframes x{}</style><s style=""animation-name:x"" onanimationend=""alert(1)""></s>")))
(assert (or (= z "l>") (= z "\u{10348}drag=""alert\u{10348}(1)"">test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "ta" 0) 21)) (not (str.contains (str.replace z "l>" " ") " ")) (= "down=""" (str.substr x 13 6))))
(assert (str.prefixof "<div on" x))
(assert (str.contains (str.replace x "<rt" "x") "xc on"))
(assert (or (str.suffixof "us>l>" y) (not (str.prefixof "<sty" x))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\w([\w .]*[\w.])?$"))))
(check-sat)
