(assert (or (= x "<path d=""M0,0"" style=""marker-start:url(test4.svg#a)""/>") (= x "<blink draggable=""true"" ondrag=""alert(1)"">test</blink>")))
(assert (or (= z "alert(1)></big>") (= z "e"" ondrag=""alert(1)"">test</applet>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z0-9-_\.]{8,20}$")))
(assert (not (= (str.indexof z "1)"">" 0) 17)))
(assert (str.contains x """marker-s"))
(assert (= (str.at x 2) "l"))
(assert (or (not (str.contains z "nimati")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\(?[1-9]{2}\)?\s?[0-9]{5}-[0-9]{4}$"))) (str.in_re z ((_ re.from_regex ecma2020 u) "^.*(?<!gmail\.com|yahoo\.com|me\.com|hotmail\.com|outlook\.com|nodeficit\.org)$"))))
