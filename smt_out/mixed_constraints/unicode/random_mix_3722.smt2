; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><summary style=""animation-name:x"" onanimationstart=""alert(1)""></summary>") (= x "<center onclick=""alert(1)"">test</center>")))
(assert (or (= z "ode draggable=""true"" ondrag=""alert(1)"">test</code>") (= z "label id=x tabindex=1 ondeactivate=alert(1)></label><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9-+\s()]{14}$")))
(assert (or (= "-name:" (str.substr y 54 6)) (not (= "ode draggable=""true"" ondrag=""alert(1)""><b></code>" (str.replace z "test" "<b>")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([A-z\u{119}\u{f3}\u{105}\u{15b}\u{142}\u{17c}\u{17a}\u{107}\u{144}\u{118}\u{d3}\u{104}\u{15a}\u{141}\u{17b}\u{179}\u{106}\u{143} ,.]){2,}$"))))
(assert (= (str.len z) 74))
(assert (or (= (str.indexof y "dr" 0) 9) (str.contains y "mationst") (= """aler" (str.substr x 16 5))))
(assert (not (= "y " (str.substr z 62 2))))
(assert (not (= (str.indexof z "ndra" 0) 22)))
(assert (not (= (str.indexof y "ncli" 0) 9)))
(assert (or (= (str.at x 38) "s") (not (= (str.at y 45) "("))))
(check-sat)
