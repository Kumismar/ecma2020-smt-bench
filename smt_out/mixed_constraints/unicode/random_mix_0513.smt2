; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q id=x tabindex=1 onfocusin=alert(1)></q>") (= x "<marquee/onstart=alert()>") (= x "<template onmouseover=""alert(1)"">test</template>")))
(assert (or (= z "ke>") (= z "alert(1)></audio>") (= z "est</html>")))
(assert (= y (str.++ x z)))
(assert (str.contains x ")"">test"))
(assert (or (= "es<b>html>" (str.replace z "t</" "<b>")) (str.in_re x ((_ re.from_regex ecma2020 u) "^(19|20)\d{2}$")) (= (str.at x 20) "r")))
(assert (or (= ">" (str.substr z 2 5)) (str.suffixof "e>" x)))
(assert (or (not (= "=ale" (str.substr x 57 4))) (= (str.indexof y "ip" 0) 4)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d$|^\d+\.?\d+$"))))
(assert (not (= (str.indexof x "ar" 0) 9)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\-]+$"))))
(assert (str.suffixof ")></audio>" y))
(check-sat)
