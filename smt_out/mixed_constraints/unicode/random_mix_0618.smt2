; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgs\u{1f600}ound id=x tabindex=1 onbeforeactivate=alert(1)></bgsound>") (= x "<tbody id=x tabindex=1 onfocus=alert(1)></tbody>") (= x "<param onmouseout=""a\u{1d400}lert(1)"">test</param>")))
(assert (or (= z "down=""alert(1)"">test</data>") (= z "<script>\x00javascript:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "l" 0) 32)) (not (= "vascript:" (str.substr z 14 9)))))
(assert (or (not (str.contains y "ou")) (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?[0-9 ]{8,16}$")) (str.contains z "own=""aler")))
(assert (or (str.prefixof "<param on" x) (not (= "</script" (str.substr y 79 8)))))
(assert (or (= (str.at y 56) """") (not (str.contains (str.replace y ":aler" "<b>") "cript<b>t(1"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) ".{3,120}"))) (str.contains y "n=")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{13}")))
(check-sat)
