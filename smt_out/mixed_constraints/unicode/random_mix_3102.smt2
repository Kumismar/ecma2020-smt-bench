; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><kbd id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></kbd>") (= x "<aside onmouseout=""alert(1)"">test</aside>") (= x "<td onfocusout=alert(1) tabindex=1 id=x></td><input autofocus>")))
(assert (or (= z "ption onmouseout=""alert(1)"">test</option>") (= z "\u{1f600}ag me</div><isindex ondrop=alert(1) cont\u{1f4a9}enteditable>drop here</isindex>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "ption o" z))
(assert (or (= (str.indexof z " on" 0) 5) (not (<= (str.len z) 50)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w.-]+@[\w.-]+\.[\w]{2,6}$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-z0-9-]*$"))) (not (= (str.indexof x "t:" 0) 25))))
(assert (or (= (str.at x 38) "d") (not (= (str.indexof x "</kb" 0) 103))))
(assert (not (str.contains y "onpaste")))
(check-sat)
