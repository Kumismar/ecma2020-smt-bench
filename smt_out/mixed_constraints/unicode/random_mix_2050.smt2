; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script\x0Ctype=""text/javascript"">javascript:alert(1);</script>") (= x "<x onxxx=alert(1) 1='")))
(assert (or (= z "nteditable>test</iframe>") (= z "xx=1")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "=1")) (not (str.suffixof "/iframe>" z))))
(assert (or (str.prefixof "<x on" x) (= (str.at z 7) "b")))
(assert (not (= (str.indexof y "\x0C" 0) 7)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^1[345789]{1}[0-9]{9}$"))) (not (str.contains x "rt(1) 1='"))))
(assert (or (not (= "t(1);</s" (str.substr y 49 8))) (= (str.indexof z "ocus>" 0) 3) (not (str.suffixof "/iframe>" y))))
(assert (not (= (str.indexof y "e>" 0) 30)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "\w{2,50}")) (str.contains y ")""") (not (str.in_re y ((_ re.from_regex ecma2020 u) ".+\.[a-zA-Z]+$")))))
(assert (not (str.suffixof "ame>" y)))
(check-sat)
