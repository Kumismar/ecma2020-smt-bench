; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;/script>;<;script>;alert(1)<;/script>;") (= x "<svg><nobr onload=alert(1)></nobr>") (= x "<body oncopy=""alert(1)"" contenteditable>test</body>")))
(assert (or (= z "id=x></textarea><input autofocus>") (= z "=""alert(1)"">test</input>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 39) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\d'_\-+]+(?:\.[a-zA-Z\d'_\-+]+)*@[a-zA-Z\d][a-zA-Z\d._\-]*\.[a-zA-Z\d._\-]+$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d*(\.\d+)?$"))) (= (str.at x 28) ")")))
(assert (or (not (= (str.indexof y "put " 0) 59)) (= (str.indexof x "r" 0) 42)))
(assert (or (not (= ";" (str.substr x 1 1))) (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{3}-\d{4}-\d{3}$"))))
(assert (or (not (= (str.at z 8) "1")) (str.contains (str.replace y "al" """") "ad=""ert(1")))
(assert (not (= "vg><n" (str.substr x 2 5))))
(assert (not (str.suffixof "est</body>" x)))
(assert (>= (str.len y) 46))
(check-sat)
