; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby onmouseenter=""alert(1)"">test</ruby>") (= x "<main id=x tabindex=1 onbeforeactivate=alert(1)></main>")))
(assert (or (= z "dblclick=""alert(1)"">test</applet>") (= z " onfocus=alert(1)></command>") (= z "eet\"" HREF=\""javascript&#058;alert('XSS');\""&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<td dra" y) (not (= "<main id=x ta x=1 onbeforeactivate=alert(1)></main>eet\"" HREF=\""javascript&#058;alert('XSS');\""&gt;" (str.replace y "binde" " "))) (str.prefixof "<ruby onmo" x)))
(assert (not (str.contains z "test</appl")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z]\S+$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*[0-9])(?=.*[a-z])(?=.*[A-Z])\S{8,50}"))) (not (= (str.indexof x "t</" 0) 34))))
(assert (or (str.prefixof "<mai" y) (str.suffixof "/main>" x)))
(check-sat)
