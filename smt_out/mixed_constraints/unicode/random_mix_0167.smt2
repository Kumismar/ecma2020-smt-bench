; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section onclick=""alert(1)"">test</section>") (= x "&lt;XSS STYLE=\""behavior&#58; url(xss&#46;htc);\""&gt;")))
(assert (or (= z "ert(1)></img>") (= z ";")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "hav" 0) 18))
(assert (or (not (str.suffixof "ion>;" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z\s\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$")))))
(assert (not (= (str.at x 17) """")))
(assert (not (str.prefixof ";" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(.){2,}$"))) (= " " (str.substr x 9 1))))
(assert (str.suffixof ")></img>" z))
(assert (str.contains (str.replace x "LE" "") " STY=\""be"))
(check-sat)
