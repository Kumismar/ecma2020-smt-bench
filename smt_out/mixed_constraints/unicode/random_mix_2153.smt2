; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form draggable=""true"" ondragstart=""aler\u{10348}t(1)"">test</form>") (= x "<option onbeforepaste=""alert(1)"" contenteditable>test</option>")))
(assert (or (= z ">") (= z "alert(String.fromCharCode(88,83,83))"">") (= z "/form>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "\d{7}"))) (= "rror=\" (str.substr x 11 6))))
(assert (or (= (str.indexof y "aler" 0) 22) (not (str.suffixof "3,83))"">" z)) (= (str.len x) 62)))
(assert (or (str.prefixof "<for" x) (str.contains (str.replace x "for" "x") "<xm dr")))
(assert (not (str.prefixof ">" z)))
(assert (not (>= (str.len z) 32)))
(assert (or (>= (str.len x) 55) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{c0}-\u{ff} .'\u{b4}`-]+$"))) (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*[A-Za-z])[A-Za-z0-9.'\s]*"))))
(assert (not (= (str.indexof z "/fo" 0) 0)))
(check-sat)
