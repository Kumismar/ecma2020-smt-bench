; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x20javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<body onload body onload=""javascript:javascript:alert(1)""></body onload>") (= x "<script>alert(document.documentElement.innerHTML.match(/'([^']%2b)/)[1])</script>")))
(assert (or (= z ">test</span>") (= z "=""alert(1)"">test</button>") (= z "mall>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "est</" 0) 2)) (str.prefixof "<div " y) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z-_.@]+$"))))
(assert (not (str.suffixof "/script>" x)))
(assert (not (<= (str.len x) 80)))
(assert (not (str.contains (str.replace y "])</" "javascript:") "1javascript:sc")))
(assert (or (<= (str.len x) 76) (= "xef=""\x20javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>" (str.replace x "<a hr" "x"))))
(assert (not (str.suffixof ">" x)))
(check-sat)
