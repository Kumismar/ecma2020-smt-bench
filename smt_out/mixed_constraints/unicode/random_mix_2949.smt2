; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid onmouseup=""alert(1)"">t\u{1d400}est</nextid\u{1d400}>") (= x "\u{5c}u003C")))
(assert (or (= z "style><tfoot id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tfoot>") (= z "command>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9]{6,15}"))))
(assert (or (= "tid onm" (str.substr x 4 7)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(\w.+\s).+"))) (not (= (str.indexof y "le>" 0) 47))))
(assert (or (not (<= (str.len x) 105)) (= "oot id=x s" (str.substr z 9 10))))
(assert (not (str.prefixof "\u{5c}u003Cstyl" y)))
(assert (or (not (= (str.len y) 89)) (not (str.suffixof "C" x)) (= (str.indexof y "e" 0) 19)))
(check-sat)
