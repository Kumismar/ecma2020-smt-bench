; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt onkeypress=""alert(1)"" contenteditable>test</dt>") (= x "<table onmouseup=""alert(1)"">test</table>") (= x "<;STYLE>;BODY{-moz-binding:url("";http://ha.ckers.org/xssmoz.xml#xss"";)}<;/STYLE>;")))
(assert (or (= z "(javascript:alert(1)"">DEF") (= z "SCRIPT&gt;") (= z "onmouseenter=""alert(1)"">test</canvas>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "ter=""a") (= (str.at y 82) "<") (not (= "seup=" (str.substr y 12 5)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?:(?:[B-DF-HJ-NP-TV-Z]|[AEIOU])[AEIOU][AEIOUX]|[B-DF-HJ-NP-TV-Z]{2}[A-Z]){2}[\dLMNP-V]{2}(?:[A-EHLMPR-T](?:[04LQ][1-9MNP-V]|[1256LMRS][\dLMNP-V])|[DHPS][37PT][0L]|[ACELMRT][37PT][01LM])(?:[A-MZ][1-9MNP-V][\dLMNP-V]{2}|[A-M][0L](?:[1-9MNP-V][\dLMNP-V]|[0L][1-9MNP-V]))[A-Z]$"))) (= (str.indexof y ")"">" 0) 72) (str.contains x "e>test")))
(assert (or (not (str.contains (str.replace x "s" "x") ".ckerx.")) (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 \u{eb}\u{ef}\u{f6}\u{e4}\u{fc}\u{e0}\u{e8}\u{e1}\u{e9}-]{3,36}"))))
(assert (or (= "xss"";" (str.substr x 64 5)) (str.contains (str.replace x "nmou" " ") "e o s") (not (= (str.indexof x "ag" 0) 10))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "\d{1,4}[\-\s]?\d{2,4}[\-\s]?\d{2,4}"))) (>= (str.len z) 31)))
(check-sat)
