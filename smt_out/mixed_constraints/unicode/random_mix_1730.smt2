; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog onfocusout=alert(1) tabindex=1 id=x></dialog><input autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><map ondragover=alert(1) contenteditable>drop here</map>")))
(assert (or (= z "1)"" contenteditable>test</bdo>") (= z "eset id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></frameset>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 24) (not (str.suffixof "/bdo>" z)) (str.suffixof "est</bdo>" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^Grac1as!$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9-+\s()]{7,}$")))))
(assert (str.suffixof "o>" y))
(assert (not (= (str.indexof z "(1) " 0) 10)))
(assert (<= (str.len y) 194))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^0\d{1,3}-?\d{2,4}-?\d{4}$")) (not (str.prefixof "<div dragg" y))))
(check-sat)
