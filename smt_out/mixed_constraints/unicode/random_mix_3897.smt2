; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onmouseup=""alert(1)"">test</dfn>") (= x "<body oncut=""alert(1)"" contente\u{1f4a9}ditable>test</body>\u{10348}") (= x "<audio onkeyup=""alert(1)"" contenteditable>test</audio>")))
(assert (or (= z "C;") (= z ">@keyframes x{}</style><xss style=""animation-name:x"" onanimationstart=""alert(1)""></xss>") (= z "t(1)></output><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "s>" y)) (not (= "t</bo" (str.substr y 43 5)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{2}-\d{3}$"))) (= (str.indexof z "oc" 0) 26) (not (str.prefixof "C;" z))))
(assert (not (= (str.len y) 139)))
(assert (str.contains z "utput><inp"))
(assert (or (str.contains z "=x ") (str.contains (str.replace x " " "alert(1)") "dfnalert(1)o")))
(assert (not (= "<meter id=x tabindex=<b> onbeforeactivate=alert(1)></meter>" (str.replace x "1" "<b>"))))
(assert (or (str.contains x ")"">test<") (= (str.indexof y "C><X" 0) 83)))
(check-sat)
