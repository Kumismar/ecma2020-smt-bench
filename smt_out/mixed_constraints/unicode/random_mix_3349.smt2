; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><menuitem onload=alert(1)></menuitem>") (= x "<center draggable=""true"" ondragstart=""alert(1)"">test</center>")))
(assert (or (= z "drop here</caption>") (= z "ransition:color 1s"" ontransitionend=alert(1)></output>") (= z "le>test</mark>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "ransition" z) (not (>= (str.len x) 36)) (= "on>" (str.substr z 16 6))))
(assert (not (= (str.indexof x "mpl" 0) 3)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^(05)[0-9][0-9][1-9]([0-9]){6}$")))
(assert (or (str.prefixof "<dd i" y) (= (str.indexof z ")>" 0) 43)))
(assert (= "d=alert(1" (str.substr y 76 9)))
(assert (or (str.suffixof "er>" x) (not (str.in_re y ((_ re.from_regex ecma2020 u) "([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$"))) (not (str.prefixof "l" z))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "(^\d{5}$)|(^\d{5}-\d{4}$)"))))
(check-sat)
