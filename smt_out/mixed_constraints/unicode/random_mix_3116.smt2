; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onkeypress=""alert(1)"" contenteditable>test</cite>") (= x "\'><SCRIPT>alert(String.fromCharCode(88,83,83))</SCRIPT><img src="""" alt=\'")))
(assert (or (= z "put autofocus>") (= z """alert(1)"">test</noembed>") (= z "le=""true"" ondragleave=""alert(1)"">test</main>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{5,14}$"))))
(assert (or (not (str.suffixof "r>oter>" y)) (str.suffixof "alt=\'" x) (str.prefixof "<cite onke" x)))
(assert (or (str.prefixof "<ci" y) (= (str.at y 14) "r") (not (str.prefixof "<cite onk" y))))
(assert (not (= "put a" (str.substr z 0 5))))
(assert (not (= (str.indexof x "ng" 0) 21)))
(assert (or (= (str.indexof z "a" 0) 1) (not (str.suffixof "/main>" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0]*[1-9][0-9]{0,5}$")))))
(assert (= (str.indexof y "tabl" 0) 38))
(check-sat)
