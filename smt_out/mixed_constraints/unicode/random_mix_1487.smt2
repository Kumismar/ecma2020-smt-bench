; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee onmouseleave=""alert(1)"">test</marquee>") (= x "<;IFRAME SRC="";javascript:alert(';XSS';);"";>;<;/IFRAME>;") (= x "<tt onpaste=""alert(1)"" contenteditable>test</tt>")))
(assert (or (= z "ert(1)></wbr>") (= z "ine; 1 &NewLine;; JAVASCRIPT&colon; alert(1)"" http-equiv=""refresh""/>") (= z "i id=x style=""transition:color 1s"" ontransitionend=alert(1)></i>")))
(assert (= y (str.++ x z)))
(assert (or (= "in" (str.substr y 66 2)) (not (str.contains z "e=""t")) (not (str.prefixof "<section o" y))))
(assert (or (<= (str.len y) 115) (not (= (str.indexof x "ME" 0) 6))))
(assert (not (str.contains z "/wbr")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(^[-_A-Za-z0-9]+$)"))) (>= (str.len y) 69)))
(assert (or (str.contains (str.replace x "e" "javascript:") "ujavascript:e") (not (= "<;IFRAME SRC="";javascript:alert(';XSS';);"";>;<;/IFRAME>;ine; 1 &Ne""e;; JAVASCRIPT&colon; alert(1)"" http-equiv=""refresh""/>" (str.replace y "wLin" """")))))
(check-sat)
