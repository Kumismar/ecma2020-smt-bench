; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x 1="">"" onxxx=1") (= x "<h1 oncut=""alert(1)"" contenteditable>test</h1>") (= x "<header onkeydown=""alert(1)"" contenteditable>test</header>")))
(assert (or (= z "SRC=# onmouseover=""alert('xxs')"">") (= z "RC=""jav&#x09;ascript:alert('XSS');"">") (= z "ss="";always"";>;<;/EMBED>;")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9()\-+Xx\s,]+$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9A-Za-z -]{2,16}$"))) (not (= (str.at z 0) "S"))))
(assert (not (= (str.indexof z "('XS" 0) 26)))
(assert (or (not (= (str.indexof x "tar" 0) 74)) (not (= "SRC=<b>onmouseover=""alert('xxs')"">" (str.replace z "# " "<b>")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\-\+\.\s\(\)]*$"))))
(assert (or (not (= (str.at x 5) """")) (not (= "<header onkeydown=""alert(1)"" contenteditable>t<b>header>ss="";always"";>;<;/EMBED>;" (str.replace y "est</" "<b>")))))
(check-sat)
