; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp onmouseup=""alert(1)"">test</xmp>") (= x "<x %6Fnxxx=1") (= x "<embed onfocusout=alert(1) tabindex=1 id=x></embed><input autofocus>")))
(assert (or (= z "ert(1)\u{10348}"">test</shadow>") (= z "javascript:alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "out=" 0) 14) (str.in_re x ((_ re.from_regex ecma2020 u) "^\(?\d{2}\)?[\s-]?[\s9]?\d{4}-?\d{4}$"))))
(assert (not (str.suffixof ":alert(1)>" z)))
(assert (or (str.prefixof "<x" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^0([8|9|6])([0-9]{8}$)")))))
(assert (or (not (= "xmp onmous" (str.substr x 1 10))) (not (str.contains x "6Fnxxx")) (not (= (str.indexof x "Fnxx" 0) 5))))
(assert (or (not (str.contains y "eforepa")) (= (str.at y 11) "c") (= "xxx" (str.substr x 7 3))))
(assert (not (= "ut auto" (str.substr x 55 7))))
(assert (not (>= (str.len y) 83)))
(check-sat)
