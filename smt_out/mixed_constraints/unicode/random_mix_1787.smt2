; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><wbr onload=alert(1)></wbr>") (= x "<legend draggable=""true"" ondrag=""alert(1)"">test</legend>")))
(assert (or (= z "eforecut=""alert(1)"" contenteditable>test</th>") (= z "ontenteditable>test</h1>") (= z "id=x tabindex=1 onfocusin=alert(1)></tfoot>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len z) 24) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\S[\w \u{df}\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}]*")))))
(assert (or (not (= "<legend draggable=""true"" ondrag=""alert(1)"">test</legend>eforecut=""alert(1)"" contenxtable>test</th>" (str.replace y "tedi" "x"))) (not (str.contains x "g><wbr on")) (not (= ">" (str.substr z 44 4)))))
(assert (or (= "ten" (str.substr z 2 3)) (not (= "ta" (str.substr x 35 2))) (not (= (str.at y 71) "("))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\$\d\., ]+$"))) (not (str.contains y "ntentedi"))))
(assert (>= (str.len y) 71))
(assert (or (not (= (str.indexof x "est<" 0) 44)) (= "<legend draggabljavascript:""true"" ondrag=""alert(1)"">test</legend>" (str.replace x "e=" "javascript:"))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^1(3|4|5|6|7|8|9)\d{9}")))
(check-sat)
