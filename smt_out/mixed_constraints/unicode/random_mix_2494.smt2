; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet id=x tabindex=1 onbeforeactivate=alert(1)></applet>") (= x "<textarea autofocus onfocus=alert(1)>test</textarea>") (= x "<style>:target {color: red;}</style><dd id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></dd>")))
(assert (or (= z "em onmousemove=""alert(1)"">test</em>") (= z """></rb>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "lor 10s"" ")))
(assert (not (= """al" (str.substr y 67 3))))
(assert (or (str.suffixof "let>" x) (not (<= (str.len y) 88))))
(assert (or (>= (str.len x) 39) (= (str.indexof x "t(1)>" 0) 32) (not (= (str.at y 5) "a"))))
(assert (not (str.prefixof "em o" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{2}$"))))
(check-sat)
