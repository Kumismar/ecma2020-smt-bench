; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure id=x tabindex=1 onfocus=alert(1)></figure>") (= x "&lt;A HREF=&quot;http://google.com/&quot;&gt;XSS&lt;/A&gt;") (= x "<div draggable=""true"" contenteditable>drag me</div><dir ondragover=alert(1) contenteditable>drop here</dir>")))
(assert (or (= z "activate=alert(1)></div>") (= z "s onclick=""alert(1)"">test</noframes>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "x=1 ") (str.prefixof "s onc" z) (not (= (str.indexof y "rt(1)" 0) 35))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])\S{8,32}$"))))
(assert (or (not (= "><if" (str.substr x 5 4))) (str.suffixof "e>" z)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{8,14}$")))
(assert (not (str.contains y "nxxx=1")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-z]{2,4}$"))) (>= (str.len z) 14) (not (= (str.len y) 54))))
(assert (str.contains z "ivate=aler"))
(check-sat)
