; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><source ondrop=alert(1) contenteditable>drop here</source>") (= x "<section onmousemove=""alert(1)"">test</section>")))
(assert (or (= z "id=x tabindex=1 onbeforedeactivate=alert(1)></dt><input autofocus>") (= z "bd onbeforepaste=""alert(1)"" contenteditable>test</kbd>") (= z "t(1)"">test</applet>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "tion>" x))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(0[1-9]|1[0-2])\/(0[1-9]|[1-2][0-9]|3[0-1])\/[0-9]{4}$")) (not (= "=" (str.substr x 18 1)))))
(assert (not (= " here</so" (str.substr y 95 9))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((?!hotmail|gmail|icloud|yahoo|outlook|live|yopmail|neuf).)*$"))) (str.suffixof "/section>" x)))
(assert (not (str.prefixof "bd onbefo" z)))
(assert (or (not (str.prefixof "t(1)""" z)) (>= (str.len z) 18)))
(assert (str.contains z "plet"))
(assert (or (<= (str.len z) 76) (= (str.at y 42) " ")))
(check-sat)
