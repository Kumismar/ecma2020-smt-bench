; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot onkeypress=""alert(1)"" contenteditable>test</tfoot>") (= x "<style>:target {color: red;}</style><data id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></data>") (= x "<param onmouseenter=""alert(1)"">test</param>")))
(assert (or (= z "a\u{20000}te(1\u{1f600}80deg);}</style><blockquote id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></blockquote>") (= z "test</table>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y """></d" 0) 45)) (str.in_re z ((_ re.from_regex ecma2020 u) "I AM WITH THEE AND WILL KEEP THEE IN ALL PLACES WHITHER THOU GOEST"))))
(assert (or (not (= (str.indexof y "m " 0) 5)) (= "<param onmouseenter=""alert(1)"">test</param>a\u{20000}te(1\u{1f600}80deg);}</style><blockquote""d=x style=""transition:transform 2s"" ontransitionrun=alert(1)></blockquote>" (str.replace y " i" """"))))
(assert (or (not (>= (str.len x) 47)) (not (str.prefixof "<tfo" y)) (str.contains x "olor ")))
(assert (str.prefixof "<" y))
(assert (or (not (str.contains y "tran")) (str.contains (str.replace z "tabl" "") "t</e>") (not (str.contains (str.replace x "/styl" " ") ";}< e><da"))))
(assert (or (str.contains x "keypre") (= (str.indexof y "(1" 0) 100) (str.in_re z ((_ re.from_regex ecma2020 u) "^([\u{410}-\u{42f}0-9][\u{430}-\u{44f}0-9]{0,}[ \-]?){1,}$"))))
(check-sat)
