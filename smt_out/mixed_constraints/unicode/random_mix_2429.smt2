; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<wbr onmouseleave=""alert(1)"">test</wbr>") (= x "<frameset draggable=""true"" ondragstart=""alert(1)"">test</frameset>") (= x "<var id=x tabindex=1 ondeactivate=alert(1)></var><input id=y autofocus>")))
(assert (or (= z "x=1 onactivate=alert(1)></plaintext>") (= z "3c")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9]).{8,}")))
(assert (or (not (str.contains y "=1 ")) (not (= "c" (str.substr z 1 6))) (str.suffixof "ameset>3c" y)))
(assert (not (str.contains (str.replace x ">" " ") "1)"" test")))
(assert (or (= "ctivat" (str.substr y 26 6)) (not (>= (str.len y) 12)) (str.suffixof "text>" z)))
(assert (or (not (= (str.indexof x " " 0) 4)) (str.contains x "vat")))
(check-sat)
