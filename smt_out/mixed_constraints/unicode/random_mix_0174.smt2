; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param draggable=""true"" ondragenter=""alert(1)"">test</param>") (= x "<command id=x tabindex=1 ondeactivate=alert(1)></command><input id=y autofocus>") (= x "<a href=""\xE2\x80\x84javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "orm><input formaction=javascript:alert(1) type=image value=click>") (= z """>test</meter>") (= z "ert&lpar;1&rpar;"">X</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "ble=" """") "gga""""tru")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9.-]+\.[a-zA-Z]{2,3}$"))) (not (= (str.indexof x "t" 0) 14))))
(assert (or (not (>= (str.len x) 77)) (not (str.suffixof "a>" y)) (>= (str.len z) 9)))
(assert (= """>test</metealert(1)>" (str.replace z "r" "alert(1)")))
(assert (not (= "ref=""\x" (str.substr x 4 7))))
(assert (not (= (str.at x 39) "1")))
(check-sat)
