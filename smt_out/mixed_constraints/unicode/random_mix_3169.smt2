; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li onmouseout=""alert(1)"">test</li>") (= x "<progress onmouseup=""alert(1)"">test</progress>") (= x "<body onBeforeUnload body onBeforeUnload=""javascript:javascript:alert(1)""></body onBeforeUnload>")))
(assert (or (= z "/style><rtc style=""animation-name:x"" onanimationstart=""alert(1)""></rtc>") (= z "</span>") (= z "xt onbeforepaste=""alert(1)"" contenteditable>test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<body " y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s]{1,32}"))) (str.suffixof "t>" z)))
(assert (or (not (str.contains z " style=""an")) (= (str.len y) 103)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$"))))
(assert (= "a" (str.substr z 4 1)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9]{0,3})$"))) (not (= (str.at x 14) "="))))
(assert (or (>= (str.len y) 196) (= (str.indexof y "-name" 0) 63)))
(assert (or (str.suffixof "/li>" x) (= ")""></rtc>" (str.substr z 62 10))))
(assert (not (str.contains z "/sp")))
(check-sat)
