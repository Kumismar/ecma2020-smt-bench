(assert (or (not (= ">" (str.substr x 42 9))) (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}]+[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}'\u{2019}\- \.]{1,24}[0-9a-zA-Z \-]{0,5}$"))))
