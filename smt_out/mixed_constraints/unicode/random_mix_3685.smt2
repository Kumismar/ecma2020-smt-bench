(assert (or (= z "name:x"" onanimationend=""alert(1)""></xss>") (= z "(1)"" contenteditable>test</tt>") (= z "ttp://www.gohttp://www.google.com/ogle.com/"";>;XSS<;/A>;")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "(1)""></x")))
(assert (or (str.prefixof "ttp://www" z) (str.contains x "te id") (not (= "<IMG SRC=x onshow=""alert(String.fromCharCode(88,83,83))"">ttp://www.gohttp://www.googalert(1)om/ogle.com/"";>;XSS<;/A>;" (str.replace y "le.c" "alert(1)")))))
