(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-za-z.\s]*"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(([^<>()\[\]\.,;:\s@""]+(\.[^<>()\[\]\.,;:\s@""]+)*)|("".+""))@(([^<>()[\]\.,;:\s@""]+\.)+[^<>()[\]\.,;:\s@""]{2,})$")))))
