; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<header draggable=""true"" ondragend=""alert(1)"">test</header>") (= x "<figcaption onmousemove=""alert(1)"">test</figcaption>") (= x "<body draggable=""true"" ondrag=""alert(1)"">test</body>")))
(assert (or (= z """>test</dir>") (= z "vascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "igcap" 0) 2)) (str.suffixof "t</body>" x) (not (= (str.len z) 28))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[a-z0-9]+([\-\.]{1}[a-z0-9]+)*\.[a-z]{2,5}(:[0-9]{1,5})?(\/.*)?$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[+]?\d?[ .-]?[(]?\d{3}[)]?[ .-]?\d{3}[ .-]?\d{4}$")))))
(assert (not (str.contains (str.replace z "ir>" "") "t</d")))
(assert (or (not (= (str.indexof x "rt(1)" 0) 34)) (str.contains y "dragg")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}]).{6,}"))) (= (str.at z 26) "z") (not (str.prefixof "ABC<div s" y))))
(assert (not (= "<figcaption onmousemove=""alert(1)"">test<b>igcaption>" (str.replace x "</f" "<b>"))))
(check-sat)
