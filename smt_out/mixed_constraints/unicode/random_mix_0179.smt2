; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>li {list-style-image: url(""javascript:document.vulnerable=true;"");</STYLE><UL><LI>XSS") (= x "<content onbeforepaste=""alert(1)"" contenteditable>test</content>") (= x "<mete\u{10348}r id=x tabindex=1 onbeforedeactivate=alert(1)></meter><input autofocus>")))
(assert (or (= z "video>") (= z ">") (= z "el onmouseout=""alert(1)"">test</label>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "tofoc")) (str.prefixof "enu onbef" z) (not (str.contains x "activa"))))
(assert (or (str.suffixof "<LI>XSS" x) (str.contains y "/s>") (not (= "content>" (str.substr x 56 9)))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{5c}u00C0-\u{5c}u00FF-]*$"))))
(assert (or (>= (str.len y) 111) (= (str.at y 56) "l")))
(assert (or (= "<script>~'\u{5c}u0061' ;  \u{5c}u0074\u{5c}u0068\u{5c}u0072\u{5c}u006F\u{5c}u0077 ~ \u{5c}u0074\u{5c}u0068\u{5c}u0069\u{5c}u0073.  \u{5c}u0061\u{5c}u006C\u{5c}u0065\u{5c}u0072\u{5c}u0074(~'\u{5c}u0061')</script U" (str.replace x "+" "")) (= (str.indexof z "=""" 0) 13) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\s\-+()]+$"))))
(check-sat)
