; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary onmouseleave=""alert(1)"">test</summary>") (= x "<dfn draggable=""true"" ondragleave=""alert(1)"">test</dfn>") (= x "<strong draggable=""true"" ondragstart=""alert(1)"">test</strong>")))
(assert (or (= z "x42.0x0000066.0x7.0x93/&quot;&gt;XSS&lt;/A&gt;") (= z "mCharCode(8\u{20000}8,83,83))"">") (= z "/onxxx%3D1/")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^SS\d{2,7}|ss\d{3,7}$"))) (= (str.indexof z "x000" 0) 5)))
(assert (or (not (str.suffixof ">" x)) (not (= "ndrag" (str.substr y 79 5)))))
(assert (or (str.contains y "ert(1)") (not (= "fn>mCha" (str.substr y 52 7)))))
(assert (= (str.at z 7) "0"))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z]+[\w.-]+@[\w\.-]+\.\w{2,}$")))
(assert (or (= (str.at x 49) "<") (str.contains z "x93/&quot") (str.suffixof ";/A&gt;" z)))
(assert (or (<= (str.len z) 29) (str.contains z "gt;XSS&lt;") (not (str.in_re z ((_ re.from_regex ecma2020 u) "(^\d{5}$)|(^\d{9}$)|(^\d{5}-\d{4}$)")))))
(check-sat)
