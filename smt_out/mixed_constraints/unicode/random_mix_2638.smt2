; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><option ondragover=alert(1) contenteditable>drop here</option>") (= x "<label onmouseleave=""alert(1)"">test</label>") (= x "<sub id=x tabindex=1 onfocus=alert(1)></sub>")))
(assert (or (= z "rt(1)"">test</area>") (= z " id=x tabindex=1 onactivate=alert(1)></mark>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^00[0-9]{1,4}[-\s0-9]{6,15}$"))) (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{2}\.?\d{2}\.?\d{2}\.?\d{2}\.?\d{2}$$")) (not (= "able" (str.substr x 10 4)))))
(assert (not (str.suffixof "></mark>" y)))
(assert (or (not (= (str.indexof y "ub " 0) 2)) (not (>= (str.len z) 13)) (= " contenteditable>dra"" me</div><tt ondragover=alert(1) contenteditable>drop here</tt>" (str.replace z "g" """"))))
(assert (not (= "</area" (str.substr z 11 6))))
(check-sat)
