; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var onbeforepaste=""alert(1)"" contenteditable>test</var>") (= x "<rt onmouseover=""alert(1)"">test</rt>")))
(assert (or (= z "cript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "est</option>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "n=""alert")) (not (= "<b>t</option>" (str.replace z "es" "<b>")))))
(assert (or (= (str.indexof x "er" 0) 13) (not (str.suffixof "a>" z)) (= (str.len y) 98)))
(assert (not (str.prefixof "<var onb" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9-_]+$"))) (not (= "t(\u{10348}" (str.substr y 9 3))) (= (str.indexof z "<" 0) 3)))
(assert (or (not (str.prefixof "<" y)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?=.*[A-Za-z])(?=.*\d)(?=.*[$@$!%*#?&])[A-Za-z\d$@$!%*#?&]{8,}")))))
(assert (not (= "</va" (str.substr y 50 4))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[A-Za-z]{2,}$")) (not (str.prefixof "<font " y))))
(assert (not (= "le>test" (str.substr x 43 7))))
(check-sat)
