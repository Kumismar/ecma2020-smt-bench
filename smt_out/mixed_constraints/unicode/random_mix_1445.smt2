; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<spacer id=x tabindex=1 onfocus=alert(1)></spacer>") (= x "<plaintext onmousedown=""alert(1)"">test</plaintext>") (= x "<style>:target {transform: rotate(180deg);}</style><rt id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></rt>")))
(assert (or (= z "activate=alert(1)></div><input autofocus>") (= z "/script>""` `>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 16) "t")))
(assert (or (= "<style>:target {tra sform: rotate(180deg);}</style><rt id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></rt>" (str.replace x "n" " ")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.-_+]{1,}@[a-zA-Z.-]{2,}[.]{1}[a-zA-Z]{2,}"))) (not (<= (str.len x) 55))))
(assert (or (not (str.contains x "</title><s")) (str.contains y "entedit") (not (= (str.at x 10) " "))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-z\u{410}-\u{44f} ,.'-]+$")))
(check-sat)
