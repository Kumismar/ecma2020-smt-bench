; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><br id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></br>") (= x "<div draggable=""true"" contenteditable>drag me</div><pre ondragover=alert(1) contenteditable>drop here</pre>")))
(assert (or (= z "ur=alert(1) tabindex=1 id=x></svg><input autofocus>") (= z "x tabindex=1 onbeforedeactivate=alert(1)></col><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<style>:t" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{6,20}$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\w+([\.-]?\w+)*@(?!.*qq)\w+([\.-]?\w+)*(\.\w{2,3})+$")))))
(assert (or (str.contains y "editabl") (not (= "x tabindex=1 onbeforedeactivate=alert(1)><b>ol><input autofocus>" (str.replace z "</c" "<b>"))) (not (<= (str.len z) 55))))
(assert (or (= (str.at z 23) "a") (>= (str.len x) 106) (= (str.at y 128) "d")))
(assert (or (= "<o"" onbeforepaste=""alert(1)"" contenteditable>test</ol>>@keyframes x{}</style><th style=""animation-name:x"" onanimationstart=""alert(1)""></th>" (str.replace y "l" """")) (>= (str.len x) 97) (= (str.at x 4) " ")))
(assert (or (not (= "e>d" (str.substr x 36 3))) (not (str.suffixof "ere</pre>" x)) (not (= (str.indexof z "ivate" 0) 26))))
(check-sat)
