; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<td id=x tabindex=1 onbeforedeactivate=alert(1)></td><input autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><rt ondragover=alert(1) contenteditable>d\u{1f600}rop here</rt>")))
(assert (or (= z "ert(1)"">test</tr>") (= z "(1)"">test</rp>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 9) (<= (str.len x) 73)))
(assert (or (not (= (str.indexof z "st" 0) 10)) (str.in_re y ((_ re.from_regex ecma2020 u) "^((?!(gmail.com|hotmail.com|yahoo.com|yandex.ru|hey.com|aol.com|mailinator.com|protonmail.com)).)*$")) (= (str.len z) 14)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{4,15}$"))))
(assert (or (str.suffixof "ere</rt>" x) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^0[0-9]{9}$")))))
(assert (not (str.prefixof "<td " y)))
(check-sat)
