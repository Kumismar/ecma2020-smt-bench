; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div onmouseover='alert&lpar;1&rpar;'>DIV</div>") (= x "<wbr draggable=""true"" ondragend=""alert(1)"">test</wbr>") (= x "<acronym draggable=""true"" ondragstart=""alert(1)"">test</acronym>")))
(assert (or (= z "x=1 onbeforedeactivate=alert(1)></sub><input autofocus>") (= z "alert(2)""></if>")))
(assert (= y (str.++ x z)))
(assert (= "<se" (str.substr y 81 3)))
(assert (= (str.indexof z "><inp" 0) 37))
(assert (or (= "utof" (str.substr z 46 4)) (not (str.prefixof "g>" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\+[0-9]{2,}[0-9]{4,}[0-9]*)(x?[0-9]{1,})?$")))))
(assert (or (not (str.contains z "alert(2)")) (not (= "ggable=" (str.substr y 12 7)))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[\w\u{5c}u0391-\u{5c}uFFE5]{1,40}"))))
(check-sat)
