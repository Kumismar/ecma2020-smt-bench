; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video oncontextmenu=""alert(1)"">test</video>") (= x "<slot onmouseup=""alert(1)"">test</slot>") (= x "<iframe style=""xg-p:absolute;top:0;left:0;width:100%;height:100%"" onmouseover=""prompt(1)"">")))
(assert (or (= z "id=x onfocusin=alert(1)>") (= z "</article>") (= z "activate=alert(1)></hr><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<sl" y))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([^0-9?!+ ]{1})([^0-9?!+]{2,})$"))))
(assert (not (str.prefixof "<slo" y)))
(assert (or (str.contains z "rt(") (<= (str.len y) 64)))
(assert (or (not (<= (str.len z) 28)) (not (= "est</" (str.substr x 33 5)))))
(assert (not (<= (str.len z) 26)))
(assert (str.contains x "slot onm"))
(check-sat)
