; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><head id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></head>") (= x "<main onblur=alert(1) tabindex=1 id=x></main><input autofocus>") (= x "<embed src=""http://corkami.googlecode.com/svn/!svn/bc/480/trunk/misc/pdf/helloworld_js_X.pdf""> ?")))
(assert (or (= z "alert(1)></footer>") (= z "nmouseover=""alert(1)"">test</aside>") (= z "ation-name:x"" onanimationstart=""alert(1)""></butt\u{1f4a9}on>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 56) " "))
(assert (or (str.contains z "(1") (not (= "<main onblur=alex(1) tabindex=1 id=x></main><input autofocus>alert(1)></footer>" (str.replace y "rt" "x"))) (not (= "e>" (str.substr z 32 4)))))
(assert (str.suffixof "side>" y))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([@\._A-z0-9]){3,}$"))) (not (str.contains z "lert("))))
(assert (or (= (str.len y) 148) (= (str.len z) 18)))
(assert (or (not (= "n>" (str.substr z 50 5))) (not (= (str.len x) 96)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{2}/\d{2}/\d{4}$")))))
(assert (or (not (= (str.indexof y "p://c" 0) 15)) (not (= "ontrans tioncancel=alert(1)></tr>" (str.replace z "i" " "))) (not (= "nde" (str.substr x 26 3)))))
(check-sat)
