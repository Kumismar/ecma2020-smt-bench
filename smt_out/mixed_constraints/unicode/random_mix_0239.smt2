; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead draggable=""true"" ondragstart=""alert(1)"">test</thead>") (= x "<sup onblur=alert(1) ta\u{1d400}bindex=1 id=x></s\u{20000}up><input autofocus>") (= x "<html onfocusout=alert(1) tabindex=1 id=x></html><input autofocus>")))
(assert (or (= z "id=x style=""transition:color 1s"" ontransitionend=alert(1)></hgroup>") (= z "d=x tabindex=1 onfocus=alert(1)></picture>") (= z "raggable=""true"" ondrag=""alert(1)"">test</xmp>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{1,4}$"))) (= (str.len z) 67) (not (str.in_re z ((_ re.from_regex ecma2020 u) "\w{6,9}")))))
(assert (or (not (= "d" (str.substr y 68 1))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{1}[0-9a-zA-Z]+[\w\.-]+@[\w\.-]+\.\w{2,}$")))))
(assert (not (= (str.indexof x "ti" 0) 60)))
(assert (or (str.prefixof "<html " y) (not (= (str.indexof z """" 0) 9)) (not (= (str.at x 38) "<"))))
(assert (not (= "ex=1" (str.substr z 10 4))))
(assert (or (str.contains (str.replace y """" "<b>") "e=<b>tran") (not (str.prefixof "<x %6Fn" y)) (str.contains (str.replace z "=""t" " ") "able rue")))
(check-sat)
