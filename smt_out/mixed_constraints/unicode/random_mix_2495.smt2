; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas onkeydown=""alert(1)"" contenteditable>test</canvas>") (= x "<style>:target {color: red;}</style><footer id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></footer>") (= x "<address id=x tabindex=1 onbeforede\u{1f600}activate=alert(1)></address><input autofocu\u{10348}s>")))
(assert (or (= z "ditable>drag me</div><div ondragover=alert(1) contenteditable>drop here</div>") (= z "ndrop=alert(1) contenteditable>drop here</col>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "iv>" y) (not (= (str.at x 30) "n")) (= (str.len x) 58)))
(assert (or (not (= (str.indexof y "ov" 0) 90)) (not (<= (str.len z) 37))))
(assert (or (str.suffixof "</div>" y) (str.in_re x ((_ re.from_regex ecma2020 u) "^1\d{10}$|^(0\d{2,3}-?|\(0\d{2,3}\))?[1-9]\d{4,7}(-\d{1,8})?$"))))
(assert (str.suffixof "here</col>" z))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]+$|^[0-9]+$"))) (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9\s]+$"))))
(check-sat)
