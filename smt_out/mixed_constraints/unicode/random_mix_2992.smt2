; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo draggable=""true"" ondrag=""alert(1)"">test</bdo>") (= x "<style>:target {color:red;}</style><thead id=x style=""transition:color 1s"" ontransitionend=alert(1)></thead>")))
(assert (or (= z "trike>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "ue"" ondra")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{5,9}$"))))
(assert (or (not (= "<style>:t rget {color:red;}</style><thead id=x style=""transition:color 1s"" ontransitionend=alert(1)></thead>trike>" (str.replace y "a" " "))) (= "<""IPT "";a=';>;';""; SRC="";http://ha.ckers.org/xss.js"";>;<;/SCRIPT>;" (str.replace x ";SCR" """")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-z]+")))))
(assert (or (not (= (str.indexof x "/sty" 0) 28)) (not (= (str.indexof x "/st" 0) 28)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{11,11}$")))))
(assert (or (not (= (str.len x) 50)) (str.contains (str.replace x "1)"">t" "x") "rt(xest<")))
(assert (not (= (str.indexof y "colo" 0) 16)))
(check-sat)
