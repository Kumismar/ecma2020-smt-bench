; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe draggable=""true"" ondragenter=""alert(1)"">test</iframe>") (= x "<iframe onmousedown=""alert(1)""\u{1f4a9}\u{20000}>test</iframe>")))
(assert (or (= z "1)>") (= z """alert(1)"">test</tfoot>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len z) 1)))
(assert (or (not (= "cont" (str.substr y 74 4))) (>= (str.len y) 85) (not (= (str.at x 23) "e"))))
(assert (not (str.suffixof "ame>" x)))
(assert (or (not (str.contains z "alert(1)")) (not (= (str.len z) 3))))
(assert (or (not (str.contains z ")>")) (= "<iframe draggable ue"" ondragenter=""alert(1)"">test</iframe>" (str.replace x "=""tr" " "))))
(assert (or (not (str.prefixof "<ifr" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?!.*(\.ru|\.site|28dtdbnfomen\.com|19mdgszxomen\.com|cannabis7oil\.com)).*$")))))
(assert (or (not (str.suffixof "t>" z)) (str.suffixof "mes>" x) (str.contains (str.replace x "ente" "") "gr=""al")))
(check-sat)
