; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<wbr draggable=""true"" ondrag=""alert(1)"">test</wbr>") (= x "<section id=x tabindex=1 onbeforedeactivate=alert(1)></section><input autofocus>") (= x "<hgroup id=x tabindex=1 onfocus=alert(1)></hgroup>")))
(assert (or (= z "1)"">test</font>") (= z "oup><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "a" (str.substr y 26 1)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0]{1}[0-9]{2,3}")))))
(assert (or (not (= "p><input " (str.substr z 2 9))) (not (str.prefixof "<hgr" x))))
(assert (not (= "<<b>p id=x tabindex=1 onfocus=alert(1)></hgroup>" (str.replace x "hgrou" "<b>"))))
(assert (or (= (str.indexof z " au" 0) 15) (= (str.at x 42) "/") (not (str.in_re y ((_ re.from_regex ecma2020 u) "\+?\d{9,13}\s?")))))
(assert (or (= (str.len z) 3) (= (str.at z 24) "i")))
(assert (not (= (str.indexof x "ab" 0) 15)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?!0{5})(\d{5})(?!-?0{4})(-?\d{4})?"))) (str.prefixof "<hgroup " x)))
(assert (= "</wb" (str.substr x 44 4)))
(check-sat)
