; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet onfocusout=alert(1) tabindex=1 id=x></applet><input autofocus>") (= x "<img onfocusout=alert(1) tabindex=1 id=x></img><input autofocus>") (= x "<aside id=x tabindex=1 onbe\u{1f4a9}foreactivate=alert(1)></aside>")))
(assert (or (= z "ascript:javascript:alert(1)'}{}*{-o-link-source:current}]{color:red};</style>") (= z "nload=alert(1)></section>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof ";</style>" y)) (not (= "]{" (str.substr z 56 2)))))
(assert (or (str.suffixof "</col>" z) (not (= (str.len y) 76))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z- ]*$"))))
(assert (or (= "o" (str.substr y 43 1)) (not (= (str.indexof z "our" 0) 42)) (str.contains (str.replace z "l" " ") "n oad=")))
(assert (or (not (str.suffixof ">" x)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\+?[78][-\(]?\d{3}\)?-?\d{3}-?\d{2}-?\d{2}$")))))
(assert (= (str.at y 58) "a"))
(assert (not (str.prefixof "as" z)))
(assert (not (= "ction" (str.substr z 19 5))))
(check-sat)
