; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tt onblur=alert(1) tabindex=1 id=x></tt><input autofocus>") (= x "<style>@keyframes x{}</style><tbody style=""animation-name:x"" onanimationstart=""alert(1)""></tbody>")))
(assert (or (= z "oncancel=alert(1)></progress>") (= z "mouseleave=""alert(1)"">test</span>") (= z "ight click this!")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?!000|666)[0-8][0-9]{2}-(?!00)[0-9]{2}-(?!0000)[0-9]{4}"))))
(assert (or (not (= (str.at y 78) " ")) (= (str.indexof y """ on" 0) 21) (not (= "rompt(2)>""" (str.substr y 83 10)))))
(assert (not (>= (str.len y) 114)))
(assert (not (str.suffixof "/progress>" y)))
(assert (or (str.prefixof "i" z) (<= (str.len x) 99)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9 -]){6,6}$"))) (= (str.at z 27) "s")))
(assert (or (not (= (str.indexof y "anim" 0) 43)) (= (str.indexof y "nput" 0) 43)))
(assert (not (= "<tt onblur=alert(1) tabindex=1 ix</tt><input autofocus>" (str.replace x "d=x>" "x"))))
(check-sat)
