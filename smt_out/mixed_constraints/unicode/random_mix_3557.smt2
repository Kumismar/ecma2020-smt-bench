; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed onbeforecut=""alert(1)"" contenteditable>test</noembed>") (= x "<header oncontextmenu=""alert(1)"">test</header>") (= x "\x3C")))
(assert (or (= z "/details>") (= z "tofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "\<b>C" (str.replace x "x3" "<b>"))) (= (str.len y) 13)))
(assert (or (not (= (str.at y 27) "t")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z][a-z0-9._%+-]{2,14}[a-z0-9]$"))) (not (str.suffixof "s>" y))))
(assert (or (= (str.indexof z "ert(1" 0) 13) (not (str.contains z "tofoc"))))
(assert (or (str.suffixof "er>" x) (not (= "ta" (str.substr z 3 2)))))
(assert (or (not (= (str.indexof z "/di" 0) 0)) (not (str.prefixof "<f" y)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{3}\s*[A-Za-z]{2}$")))))
(check-sat)
