; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><bgsound ondragover=alert(1) contenteditable>drop here</bgsound>") (= x "<header draggable=""true"" ondragstart=""alert(1)"">test</header>")))
(assert (or (= z "ditable>test</abbr>") (= z "source onbeforecopy=""alert(1)"" contenteditable>test</source>") (= z "e onload=alert(1)></style>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 24) " ") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{e4}\u{c4}\u{eb}\u{cb}\u{ef}\u{cf}\u{f6}\u{d6}\u{fc}\u{dc}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{c2}\u{ca}\u{ce}\u{d4}\u{db}\u{e2}\u{ea}\u{ee}\u{f4}\u{fb}\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9} _-]{3,30}$")))))
(assert (or (str.suffixof "urce>" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'* /=?^_`{|}~-] @[a-zA-Z0-9-] (?:\.[a-zA-Z0-9-] )*$")))))
(assert (or (not (str.contains (str.replace y "op" "<b>") "e>dr<b> her")) (not (= (str.at y 39) "l")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\s*(?:\+?(\d{1,3}))?[-. (]*(\d{3})[-. )]*(\d{3})[-. ]*(\d{4})(?: *x(\d+))?\s*$")))))
(assert (not (<= (str.len y) 91)))
(check-sat)
