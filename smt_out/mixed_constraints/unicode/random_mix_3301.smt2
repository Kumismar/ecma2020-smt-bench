; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sou\u{1d400}rce onpaste=""alert(1)"" contenteditable>test</source>") (= x "<template onfocusout=alert(1) tabindex=1 id=x></template><input autofocus>")))
(assert (or (= z "enteditable>test</strong>") (= z "keydown=""alert(1)"" contenteditable>t\u{1d400}est</title>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "ente" (str.substr z 0 4))) (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@(?!gmail.com)(?!yahoo.com)(?!hotmail.com)(?!hotmail.co.il)(?!walla.co.il)(?!mail.ru)(?!outlook.com)(?!email.com)[a-z0-9.-]+\.[a-z]{2,}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9\s]*$"))))
(assert (str.contains (str.replace y "dit" "<b>") "e<b>abl"))
(assert (or (>= (str.len z) 24) (not (= "enteditabxe>test</strong>" (str.replace z "l" "x")))))
(assert (or (not (= (str.at x 13) "o")) (not (str.suffixof "ticol>" x))))
(check-sat)
