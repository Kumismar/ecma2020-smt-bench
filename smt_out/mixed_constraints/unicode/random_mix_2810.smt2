; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<font onblur=alert(1) tabindex=1 id=x></font><input autofocus>") (= x "<summary onkeydown=""alert(1)"" contenteditable>test</summary>")))
(assert (or (= z "alert(1)"">test</data>") (= z "rt(1)"" contenteditable\u{1d400}>test</u>")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{6,12}$")))
(assert (or (not (= (str.at y 14) "l")) (str.suffixof "ummary>" x) (not (= "</fo" (str.substr x 38 4)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9()-.^+*%\s^]{5,16}$"))) (not (= (str.len y) 81)) (str.prefixof "<fo" x)))
(assert (= "<div style=""behaviour: url([linkxcode]);"">" (str.replace x " to " "x")))
(assert (or (not (str.prefixof "<font on" y)) (not (= (str.at y 77) "a"))))
(assert (or (= (str.indexof y "id" 0) 33) (= (str.at x 17) "t")))
(assert (not (= (str.len x) 62)))
(check-sat)
