(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "<s" 0) 1)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\s*1\d{10}\s*$")))))
(assert (or (not (= (str.at x 32) "e")) (str.in_re y ((_ re.from_regex ecma2020 u) "^(0[1-9]|[12][0-9]|3[01])[-](0[1-9]|1[012])[-](19|20)\d\d$")) (not (>= (str.len z) 34))))
