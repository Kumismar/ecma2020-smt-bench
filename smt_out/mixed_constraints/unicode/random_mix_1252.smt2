; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onmouseup=""alert(1)"">test</dfn>") (= x "<progress oncut=""alert(1)"" contenteditable>test</progress>")))
(assert (or (= z "t=""alert(String.fromCharCode(88,83,83))"">") (= z "mage onload=alert(1)></picture>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len x) 61)) (str.suffixof ">" z)))
(assert (or (= "ad=al" (str.substr z 9 5)) (not (= (str.at y 39) "a"))))
(assert (or (not (= (str.len x) 25)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\t-\r \x2D0-9A-Z\xA0\u{5c}u1680\u{5c}u2000-\u{5c}u200A\u{5c}u2028\u{5c}u2029\u{5c}u202F\u{5c}u205F\u{5c}u3000\u{5c}uFEFF]{3,10}$"))) (= (str.indexof z "83,83" 0) 32)))
(assert (not (= "<keygen onblur=alert(1) tabindex=1 id=x></keyalert(1)input autofocus>vate=alert(1)></dl><input autofocus>" (str.replace y "gen><" "alert(1)"))))
(assert (not (= (str.indexof y "n>" 0) 34)))
(check-sat)
