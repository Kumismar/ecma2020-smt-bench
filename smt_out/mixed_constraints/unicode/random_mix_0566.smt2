; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd draggable=""true"" ondragenter=""alert(1)"">test</dd>") (= x "<slot id=x tabindex=1 ondeactivate=alert(1\u{1f600})></slot><input id=y autofocus>") (= x "<maction actiontype=""statusline#http://google.com"" xlink:href=""javascript:ale\u{1f4a9}rt(2)"">CLICKME</maction>")))
(assert (or (= z "</element>") (= z "nvas>") (= z "vascript:alert(1);//"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "focus>" x)) (= (str.at x 51) ">")))
(assert (or (not (= (str.at x 53) "i")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9\.]{3,8}")))))
(assert (or (= (str.indexof y "ti" 0) 4) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9_ +-,.?]{3,}$"))) (not (str.suffixof "s>" z))))
(assert (or (not (str.suffixof "as>" z)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\x20-\x7e\x80-\xff]*$")))))
(assert (= (str.at y 63) "i"))
(check-sat)
