; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup oncontextmenu=""alert(1)"">test</optgroup>") (= x "<col onmousedown=""alert(1)"">test</col>")))
(assert (or (= z "st</keygen>") (= z "nmouseleave=""alert(1)"">test</dir>") (= z """XSS\""))'&gt;")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 25) ")") (not (str.contains x "ptgroup o")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "([a-zA-Z])+$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(6|7|8|9)[ -]*([0-9][ -]*){8}"))) (= (str.indexof x "on" 0) 5) (not (str.contains x "ed"))))
(assert (or (not (str.prefixof """" z)) (not (= (str.at y 47) "/"))))
(assert (or (not (str.contains z "</keyge")) (= ">" (str.substr z 10 9))))
(check-sat)
