; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{1f4a9}\u{5c}u003c") (= x "<br draggable=""true"" ondragend=""alert(1)"">test</br>") (= x "<dialog id=x tabindex=1 onfocusin=alert(1)></dialog>")))
(assert (or (= z ";") (= z "le=x:expre\u{1f600}ssion\28javascript:alert(1)\29>") (= z "ript:alert(1)')()</script>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len x) 58)))
(assert (or (not (<= (str.len y) 201)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^L[0-9]{2}P[0-9]{4}$")))))
(assert (str.contains x "\u{5c}u003"))
(assert (not (str.suffixof ";" z)))
(assert (or (not (str.suffixof "pt>" z)) (= (str.at y 7) "r") (not (str.contains x ">t"))))
(assert (or (str.contains y "(1)\29>") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{3} ?(?!sa|sd|ss|SA|SD|SS)[A-Za-z]{2}$")))))
(check-sat)
