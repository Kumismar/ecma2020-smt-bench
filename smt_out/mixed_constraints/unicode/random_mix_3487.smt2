; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image src=""javascript:alert(1)"">") (= x "<button onmousemove=""alert(1)"">test</button>")))
(assert (or (= z "<LI>XSS") (= z "ion id=x tabindex=1 onactivate=alert(1)></option>") (= z "rue"" ondra\u{1d400}g=""alert(1)"">test</tbody>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len x) 51))
(assert (not (= (str.len y) 114)))
(assert (not (= (str.at x 38) "u")))
(assert (or (not (str.prefixof "<image " y)) (not (<= (str.len z) 9))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) ".{1,64}@[a-zA-Z]{1,255}[.][a-zA-Z]{2,5}"))) (= (str.at y 49) "o")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([wW]{3}[\.][a-zA-Z0-9\.\-]+\.[a-zA-Z]+)*$"))) (str.contains (str.replace y "pti" "javascript:") "/ojavascript:on")))
(assert (not (str.contains x "e=""alert")))
(assert (or (= (str.at y 55) "e") (str.prefixof "io" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "19[0-9]{2}$|20[0-9]{2}$")))))
(assert (= (str.indexof x "emo" 0) 14))
(check-sat)
