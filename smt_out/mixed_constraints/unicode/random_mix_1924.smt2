; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<basefont draggable=""true"" ondragenter=""alert(1)"">test</basefont>") (= x "<picture onmousedown=""alert(1)"">test</picture>")))
(assert (or (= z "nu=""alert(1)"">test</mark>") (= z "ls>") (= z "redeactivate=alert(1)></i><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= " >" (str.replace z "ls" " ")) (= (str.at z 0) "l") (not (str.suffixof "iv>" z))))
(assert (str.contains z "ls"))
(assert (= (str.len x) 65))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\s,@]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$")) (not (str.suffixof "mark>" y)) (not (str.contains z "test</mar"))))
(assert (or (= "<pictu onmousedown=""alert(1)"">test</picture>" (str.replace x "re" "")) (not (str.suffixof "e>" x))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[_\s\w\d]{3,}$"))) (not (= (str.at z 39) "c")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[ A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]+$")))))
(check-sat)
