; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc oncontextmenu=""alert(1)"">test</rtc>") (= x "<div draggable=""true"" contenteditable>drag me</div><label ondrop=alert(1) contenteditable>drop here</label>")))
(assert (or (= z "ure>") (= z "est</caption>") (= z "t(1)"">test</table>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "test</rtc>" x) (str.prefixof "o" z)))
(assert (or (not (= "le>" (str.substr y 55 3))) (str.contains (str.replace y "ap" " ") "/c tion")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{c0}-\u{ff} ,.'-]+$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$"))))
(assert (not (str.contains x "ale")))
(assert (not (str.prefixof "e" z)))
(assert (str.prefixof "<rtc " x))
(assert (or (= "=x></c" (str.substr x 42 6)) (= (str.at x 22) "(") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9\-\(\) ]*)$")))))
(check-sat)
