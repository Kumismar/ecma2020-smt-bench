; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article id=x tabindex=1 onbeforeactivate=alert(1)></article>") (= x "<style>\u{1d400}@keyframes x{}</style><pre style=""animation-name:x"" onanimationstart=""al\u{10348}ert(1)""></pre>") (= x "<small ondblclick=""\u{20000}alert(1)"">test</small>")))
(assert (or (= z "/samp>") (= z ">test</dir>") (= z "pt:alert(1)""></img>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "t" 0) 3)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?![ ])(?!.*[ ]{2})((?:e|da|do|das|dos|de|d'|D'|la|las|el|los)\s*?|(?:[A-Z\u{e0}\u{e1}\u{e2}\u{e4}\u{e3}\u{e5}\u{105}\u{10d}\u{107}\u{119}\u{e8}\u{e9}\u{ea}\u{eb}\u{117}\u{12f}\u{ec}\u{ed}\u{ee}\u{ef}\u{142}\u{144}\u{f2}\u{f3}\u{f4}\u{f6}\u{f5}\u{f8}\u{f9}\u{fa}\u{fb}\u{fc}\u{173}\u{16b}\u{ff}\u{fd}\u{17c}\u{17a}\u{f1}\u{e7}\u{10d}\u{161}\u{17e}\u{c0}\u{c1}\u{c2}\u{c4}\u{c3}\u{c5}\u{104}\u{106}\u{10c}\u{116}\u{118}\u{c8}\u{c9}\u{ca}\u{cb}\u{cc}\u{cd}\u{ce}\u{cf}\u{12e}\u{141}\u{143}\u{d2}\u{d3}\u{d4}\u{d6}\u{d5}\u{d8}\u{d9}\u{da}\u{db}\u{dc}\u{172}\u{16a}\u{178}\u{dd}\u{17b}\u{179}\u{d1}\u{df}\u{c7}\u{152}\u{c6}\u{10c}\u{160}\u{17d}\u{2202}\u{f0}'][^\s]*\s*?)(?!.*[ ]$))+$"))) (>= (str.len x) 33) (str.prefixof "<article i" x)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{1,}$"))))
(assert (or (= (str.at x 16) "e") (not (= ">tdir>" (str.replace z "est</" ""))) (str.contains z "</i")))
(assert (or (not (str.prefixof "<ar" x)) (not (= "(1" (str.substr z 8 2)))))
(assert (not (= (str.indexof y "ticle" 0) 3)))
(assert (str.suffixof ">/samp>" y))
(assert (not (str.suffixof "st</dir>" z)))
(check-sat)
