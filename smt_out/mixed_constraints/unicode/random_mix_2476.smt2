; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed onmousemove=""alert(1)"">test</noembed>") (= x "<var oncontextmenu=""alert(1)"">test</var>")))
(assert (or (= z "STYLE=""background-image: url(&#1;javascript:document.vulnerable=true;)"">") (= z "ript /*%00*/>/*%00*/alert(1)/*%00*/</script /*%00*/") (= z "ink>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) ".*[!#-9A-~]+@+[a-z0-9]+.+[^.]$.*"))))
(assert (or (not (<= (str.len y) 45)) (= (str.len y) 50) (str.contains z "ink")))
(assert (= (str.at y 15) "e"))
(assert (or (= (str.at y 35) "t") (not (str.contains z "t(1)/*%")) (not (str.prefixof "<var o" y))))
(assert (or (not (str.suffixof ">" z)) (not (= "<noe<b>ed onmousemove=""alert(1)"">test</noembed>ript /*%00*/>/*%00*/alert(1)/*%00*/</script /*%00*/" (str.replace y "mb" "<b>"))) (not (= (str.indexof z "rl(&#" 0) 26))))
(assert (or (= (str.indexof z "ns" 0) 11) (not (str.suffixof "test</del>" y))))
(check-sat)
