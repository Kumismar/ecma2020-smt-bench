; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo onblur=alert(1) tabindex=1 id=x></bdo><input autofocus>") (= x "<a href=""\x02javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "text>") (= z "t:alert('XSS')>") (= z "vascript:alert(A)>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "m " 0) 25)))
(assert (or (not (str.suffixof "ting>" z)) (str.contains (str.replace x "id=" " ") ")""  ""fuz") (= (str.at y 50) "u")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\+[0-9]{7,17}$"))) (not (= "tex" (str.substr z 0 3)))))
(assert (= (str.at x 26) "v"))
(assert (or (str.contains y "ontr") (not (str.suffixof "/dt>" x)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z. ]+$")))))
(assert (or (not (<= (str.len z) 18)) (not (str.suffixof "t('XSS')>" y)) (not (= "t1"">test<" (str.substr y 59 9)))))
(check-sat)
