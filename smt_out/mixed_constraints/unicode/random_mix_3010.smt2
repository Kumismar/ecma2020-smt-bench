; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details onpaste=""alert(1)"" contenteditable>test</details>") (= x "<object draggable=""true"" ondragend=""alert(1)"">test</object>")))
(assert (or (= z " id=x tabindex=1 onactivate=alert(1)></frame>") (= z ")"">test</embed>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(0[1-9]|1[012])[\/](0[1-9]|[12][0-9]|3[01])$"))) (str.contains y "</de")))
(assert (or (not (str.prefixof ")"">test</e" z)) (not (str.contains x "object"))))
(assert (= "e"" ondr" (str.substr y 22 7)))
(assert (str.contains (str.replace z "mand" "") "m>"))
(assert (or (not (= "<detjavascript:ils onpaste=""alert(1)"" contenteditable>test</details> id=x tabindex=1 onactivate=alert(1)></frame>" (str.replace y "a" "javascript:"))) (str.suffixof "etails>" x)))
(assert (not (= (str.indexof y " i" 0) 58)))
(assert (or (str.contains (str.replace z " id" "") "=x ") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\S.*\S")))))
(assert (not (= (str.len x) 58)))
(check-sat)
