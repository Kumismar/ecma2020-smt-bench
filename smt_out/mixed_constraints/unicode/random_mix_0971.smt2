; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<big onkeydown=""alert(1)"" contenteditable>test</big>") (= x "<div id=""43""><?xml version=""1.0"" standalone=""no""?>") (= x "<video id=x tabindex=1 onactivate=alert(1)></video>")))
(assert (or (= z "cript:alert(1)>") (= z "alert(1)"">test</abbr>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^1[0-9]{10}$"))))
(assert (not (= ">" (str.substr y 70 1))))
(assert (or (str.contains z ":alert") (not (= (str.len z) 55))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\+[0-9]{2,3}|0+[0-9]{2,5}).+[\d\s\/\(\)-]"))) (str.contains y "t(1)></vi")))
(assert (or (not (= (str.indexof z "t<" 0) 10)) (not (str.suffixof "est</abbr>" z))))
(check-sat)
