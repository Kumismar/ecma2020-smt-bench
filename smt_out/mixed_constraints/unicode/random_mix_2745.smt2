; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><dir style=""animation-name:x"" onanimationend=""alert(1)""></dir>") (= x "<head draggable=""true"" ondragenter=""alert(1)"">test</head>") (= x """`'><script>\xE2\x80\x82javascript:alert(1)</script>")))
(assert (or (= z "dy onblur body onblur=""javascript:javascript:alert(1)""></body onblur>") (= z "dex=1 id=x></head><input autofocus>") (= z "er=""alert(1)"">test</samp>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 17) ">")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z_-]{3,}$")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]{1,9}")))))
(assert (str.contains z "javasc"))
(assert (or (not (str.contains (str.replace z "ut" "javascript:") "npjavascript: au")) (str.contains y "yframes")))
(assert (or (not (<= (str.len z) 17)) (= "dex=1 id=x></heaxinput autofocus>" (str.replace z "d><" "x"))))
(check-sat)
