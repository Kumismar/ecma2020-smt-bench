; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot id=x tabindex=1 ondeactivate=alert(1)></tfoot><input id=y autofocus>") (= x """><SCRIPT>alert(String.fromCharCode(88,83,83))</SCRIPT><img src="""" alt=""")))
(assert (or (= z "center>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "cente" z)) (not (str.contains z ">"))))
(assert (or (= "center>" (str.substr y 75 8)) (str.contains x "><img sr") (str.suffixof "pt 1=2" z)))
(assert (or (str.suffixof "tofocus>" x) (str.in_re x ((_ re.from_regex ecma2020 u) "\w*"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\w._%-]+@[\w.-]+\.[a-zA-Z]{2,4}$"))) (str.suffixof "us>" x)))
(assert (or (= "<tfoot id=x tabindex=1 onde<b>vate=alert(1)></tfoot><input id=y autofocus>>" (str.replace y "acti" "<b>")) (= "input id=" (str.substr y 54 9))))
(assert (or (not (= """><SCRIPT>alert(String.fromCharCode(88,83,83))</SCRIPT><rc="""" alt="">" (str.replace y "img s" ""))) (not (<= (str.len z) 6))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\-\+]{11,15}$"))))
(assert (not (str.contains z "center>")))
(check-sat)
