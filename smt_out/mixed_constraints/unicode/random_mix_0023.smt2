; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet draggable=""true"" ondragstart=""aler\u{1d400}t(\u{1f600}1)"">test</applet>") (= x "<section onmouseout=""alert(1)"">test</section>") (= x "&lt;BODY BACKGROUND=&quot;javascript:alert(&apos;XSS&apos;);&quot;&gt;")))
(assert (or (= z "adow>") (= z ">@keyframes x{}</style><command style=""animation-name:x"" onanimationstart=""alert(1)""></command>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "\S+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"))) (not (str.suffixof "w>" z)) (not (str.contains y "-><img "))))
(assert (not (str.contains y "table>")))
(assert (or (not (>= (str.len y) 136)) (not (str.suffixof "ow>" z))))
(assert (or (= "ad""" (str.replace z "ow>" """")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?!^\s+$)[A-z\u{c0}-\u{17e}0-9()\s\-\.]{1,30}")))))
(assert (not (str.contains x "r\u{1d400}t(\u{1f600}")))
(check-sat)
