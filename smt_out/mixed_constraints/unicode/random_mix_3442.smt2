; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<audio draggable=""true"" ondragleave=""alert(1)"">test</audio>") (= x "<optgroup onfocusout=alert(1) tabindex=1 id=x></optgroup><input au\u{10348}tofocus>") (= x "<video onloadstart=alert(1)><source>")))
(assert (or (= z "activate=alert(1)></basefont><input id=y autofocus>") (= z "</u>") (= z "-binding:url(&qu\u{10348}ot;http://ha.c\u{20000}kers.org/xssmoz.xml#xss&quot;)}&lt;/STYLE&gt;")))
(assert (= y (str.++ x z)))
(assert (= "eo onloadstart=alert(1)><source>" (str.replace x "<vid" "")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-Za-z]?[A-Za-z]?[0-9]{6,9}$"))))
(assert (or (str.contains x """>tes") (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*[0-9a-zA-Z@._\\/-]*\s*$"))))
(assert (not (str.prefixof "<s" x)))
(assert (not (= (str.at z 26) "n")))
(assert (= (str.indexof z "/u>" 0) 1))
(assert (or (not (str.contains y "t/1='aler")) (str.prefixof "<sty" x)))
(check-sat)
