; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><td style=""animation-name:x"" onanimationstart=""alert(1)""></td>") (= x "<s id=x tabindex=1 onfocusin=alert(1)></s>") (= x "<b onbeforecopy=""alert(1)"" contenteditable>test</b>")))
(assert (or (= z "style=""animation-name:x"" onanimationstart=""alert(1)""></textarea>") (= z "oninvalid=alert(1) required><input type=submit>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace x "nte" "javascript:") "cojavascript:nte")))
(assert (or (str.contains (str.replace z "req" "x") "t(1) xuired") (not (str.contains x " id=x "))))
(assert (or (not (= (str.indexof z "p" 0) 3)) (not (str.suffixof "/textarea>" z))))
(assert (or (not (= (str.indexof x "ck=""" 0) 15)) (not (= (str.at y 104) "a")) (str.suffixof "extarea>" y)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{5}-[0-9]{3}$"))) (= "=""ale" (str.substr y 15 5))))
(assert (or (not (str.contains z "rt=""aler")) (not (= (str.indexof y "e"" on" 0) 19))))
(assert (str.contains (str.replace x "1)" "") "rt(><"))
(check-sat)
