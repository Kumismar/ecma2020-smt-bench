; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table draggable=""true"" ondragenter=""alert(1)"">test</table>") (= x "</ foo=""><script>alert(1)</script>"">")))
(assert (or (= z "=""alert(1\u{20000})"">test</label>") (= z "ng.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9A-HJ-NPQRTUWXY]{2}\d{6}[0-9A-HJ-NPQRTUWXY]{10}|[1-9]\d{14})$"))))
(assert (or (not (str.contains y "t</table>")) (str.contains (str.replace x "=" "alert(1)") "gablealert(1)""")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9]+[0-9]*$"))) (str.suffixof ">" z) (not (= (str.at z 15) "s"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z]+(?:\s[A-Za-z]+)+$"))))
(assert (or (not (= (str.at z 24) ")")) (not (str.prefixof "ng.fromC" z))))
(assert (or (str.contains z "de(88,") (not (= (str.at y 36) "=")) (not (<= (str.len z) 29))))
(assert (not (= "r" (str.substr x 12 1))))
(check-sat)
