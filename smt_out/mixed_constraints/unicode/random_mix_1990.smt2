; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<progress onmouseenter=""alert(1)"">test</progress>") (= x "<body id=x tabindex=1 ondeactivate=alert(1)></body><input id=y autofocus>")))
(assert (or (= z "{}</style><nobr style=""animation-name:x"" onanimationstart=""alert(1)""></nobr>") (= z "gend=""alert(1)"">test</sub>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "t</su" 0) 33) (str.prefixof "ut=""aler" z) (not (= "r=""al" (str.substr x 21 5)))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{1,10}")) (= ">" (str.substr x 72 8))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{5}$|^\d{5}-\d{4}$"))) (= "ert" (str.substr z 61 3))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^\s*1\d{10}\s*$")))
(assert (= (str.at z 3) "/"))
(check-sat)
