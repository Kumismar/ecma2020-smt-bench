; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b draggable=""true"" ondragend=""alert(1)"">test</b>") (= x "<mark onmouseenter=""alert(1)"">test</mark>") (= x "<u onkeypress=""alert(1)"" contenteditable>test</u>")))
(assert (or (= z "test</col>") (= z "t</a>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof ">" z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{5}")) (= (str.at y 46) "/")))
(assert (= (str.at x 3) "d"))
(assert (or (str.suffixof "tofocus>" z) (not (= "g" (str.substr y 6 1)))))
(assert (or (not (str.suffixof "est</col>" z)) (= "t</a>" (str.substr z 0 5))))
(check-sat)
