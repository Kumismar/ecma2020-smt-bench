; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp onkeypress=""alert(1)"" contenteditable>test</rp>") (= x """`'><script>\x2Bjavascript:alert(1)</script>") (= x "<script ~~~>alert(0%0)</script ~~~>")))
(assert (or (= z " tabindex=1 onactivate=alert(1)></title>") (= z "c=""http://www.example.org/dropHere.html""></iframe>//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "~~>" x) (not (str.prefixof """`'><scri" y)) (= ">" (str.substr x 50 2))))
(assert (or (not (str.contains z "(1)><")) (>= (str.len y) 103)))
(assert (or (not (= "<rp onkeypress=""alert(1)"" contenteditable>test</rp>c=""http://www.example.org/dropHere.htmljavascript:/iframe>//[""'`-->]]>]</div>" (str.replace y """><" "javascript:"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9-_.,/ ]*$")))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*[0-9a-zA-Z@._\\/-]*\s*$")) (= (str.indexof x "ler" 0) 17) (not (= "cript:aler" (str.substr x 21 10)))))
(assert (= """`'javascript:cript>\x2Bjavascript:alert(1)</script>" (str.replace x "><s" "javascript:")))
(assert (or (not (>= (str.len x) 25)) (not (str.contains z "re.htm"))))
(check-sat)
