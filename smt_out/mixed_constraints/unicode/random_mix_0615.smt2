; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em draggable=""true"" ondragenter=""alert(1)"">test</em>") (= x "<style>:target {color:red;}</style><rt id=x style=""transition:color 1s"" ontransitionend=alert(1)></rt>")))
(assert (or (= z "ntenteditable>test</source>") (= z "onmousedown=""alert(1)"">test</col>") (= z "ent1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 21) " ")) (str.suffixof "st</a>" z)))
(assert (not (= ">" (str.substr z 13 9))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d{4}[\s-]?[a-zA-Z]{2}$"))))
(assert (or (not (str.contains z "est</a")) (not (str.prefixof "ent1"">tes" z))))
(assert (or (str.contains y "itionend=a") (= (str.at x 70) """") (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-z,A-Z]{1,30}")))))
(assert (not (= (str.indexof z "edi" 0) 5)))
(check-sat)
