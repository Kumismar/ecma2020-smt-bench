; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<label onmouseenter=""a\u{10348}lert(1)"">test</label>") (= x "<style>:target {color:red;}</style><shadow id=x style=""transition:color 1s"" ontransitionend=alert(1)></shadow>")))
(assert (or (= z "rt(1)"">test</tt>") (= z "st</xmp>") (= z "E=\""width&#58; expression(alert('XSS'));\""&gt;")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "t('XSS'))")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z .'-]+$")) (not (= "olor 1s""" (str.substr x 67 8))) (not (= "rt(1)"">tesalert(1)t>" (str.replace z "t</t" "alert(1)")))))
(assert (or (= (str.at x 39) "a") (= (str.len z) 8)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[^ ]+@[^ ]+\.[a-z]{2,6}$")))
(assert (or (= (str.at x 104) "h") (= (str.len y) 60)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]*[.,]?[0-9]*$"))))
(assert (or (not (= (str.at x 35) "t")) (not (str.contains y "<label"))))
(assert (or (str.prefixof "rt(1)"">te" z) (str.prefixof "<l" y)))
(check-sat)
