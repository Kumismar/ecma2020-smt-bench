; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image id=x tabindex=1 onactivate=alert(1)></image>") (= x "<spacer draggable=""true"" ondragstart=""alert(1)"">test</spacer>")))
(assert (or (= z "ble onbeforecut=""alert(1)"" contenteditable>test</table>") (= z "ect><input id=y autofocus>") (= z "x='")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^12$"))) (str.suffixof "x='" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9]{2}[:]{1}[0-9]{2}")))))
(assert (or (not (= (str.indexof z "x='" 0) 0)) (<= (str.len y) 125) (= (str.indexof z "ont" 0) 28)))
(assert (str.contains y "bl"))
(assert (or (str.suffixof "</table>" z) (str.contains x "nac") (not (= (str.at y 65) "y"))))
(assert (= (str.len y) 116))
(check-sat)
