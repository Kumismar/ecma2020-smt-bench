; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br onbeforecopy=""alert(1)"" contenteditable>test</br>") (= x "<svg><main onload=alert(1)></main>")))
(assert (or (= z "d=x tabindex=1 onactivate=alert(1)></svg>") (= z " onmousedown=""alert(1)"">test</multicol>") (= z "st</td>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 3) " ")) (str.prefixof "on" z)))
(assert (or (not (str.contains (str.replace z "td>" "") "</")) (= "</br>d=x t" (str.substr y 48 10))))
(assert (or (not (= "<sv" (str.substr x 0 3))) (not (str.contains z "te=ale")) (= (str.at y 63) "/")))
(assert (= (str.at z 25) ">"))
(assert (or (not (= (str.indexof z "</td>" 0) 2)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9_!#$%&'\x22*+/=?`{|}~^.-]+@[A-Za-z0-9[\]:.-]+\.[A-Za-z0-9[\]:-]{2,}$"))) (str.suffixof "icol>" y)))
(assert (= (str.indexof x "/spac" 0) 45))
(assert (or (not (>= (str.len x) 33)) (not (str.contains y "test</br> ")) (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{4,12}"))))
(check-sat)
