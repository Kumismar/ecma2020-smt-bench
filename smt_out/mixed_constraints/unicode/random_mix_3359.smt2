; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=x onerror=\x09""javascript:alert(1)"">") (= x "<style>:target {color: red;}</style><cite id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></cite>")))
(assert (or (= z "eout=""alert(1)"">test\u{1f600}</s>") (= z "onbeforecopy=""alert(1)"" contenteditable>test</datalist>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len y) 136)))
(assert (or (= (str.indexof y "r" 0) 10) (not (= "<img src=x onerror=\x09""javascriptalert(1)t(1)"">" (str.replace x ":aler" "alert(1)"))) (not (str.contains y "x onerror="))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9\-\.]{1,31}"))) (= "est\u{1f600}<" (str.substr z 17 5)) (str.prefixof "<styl" x)))
(assert (str.contains x "le=""trans"))
(assert (or (>= (str.len z) 9) (str.contains x "r=\")))
(check-sat)
