; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tr onkeyup=""alert(1)"" contenteditable>test</tr>") (= x "<style>@keyframes x{}</style><fieldset style=""animation-name:x"" onanimationstart=""alert(1)""></fieldset>")))
(assert (or (= z ")></nobr>") (= z "script:alert(&apos;XSS&apos;);&quot;&gt;") (= z "</strong>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<tr on" y)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9@.]+$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9]{5,}$")))))
(assert (or (not (= "n" (str.substr y 25 1))) (str.suffixof "de>" z) (str.suffixof "uot;&gt;" y)))
(assert (str.suffixof ">" x))
(assert (or (str.contains y "it") (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z]+[\w-]+@[\w\.-]+\.\w{2,}$"))))
(assert (not (= (str.at y 26) "l")))
(check-sat)
