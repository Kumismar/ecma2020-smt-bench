; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onfocusout=alert(1) tabindex=1 id=x></html><input autofocus>") (= x "<a href=""javas\x04cript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "1 onactivate=alert(1)></tt>") (= z """ contenteditable>test</samp>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len z) 21)) (not (= (str.indexof y "e" 0) 5))))
(assert (str.contains x "rt(1) tab"))
(assert (not (= (str.indexof z "1)"">" 0) 2)))
(assert (or (str.prefixof "<" y) (str.in_re x ((_ re.from_regex ecma2020 u) "^\S{4,20}$")) (not (= (str.indexof x "t:ja" 0) 22))))
(assert (or (str.suffixof "amp>" y) (not (= "l onfocuso" (str.substr y 4 10)))))
(assert (or (str.contains (str.replace x "t(1)" " ") "r  t") (not (str.prefixof """" z))))
(assert (not (str.prefixof """ c" z)))
(check-sat)
