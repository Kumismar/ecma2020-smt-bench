; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr id=x tabindex=1 ondeactivate=alert(1)></abbr><input id=y autofocus>") (= x "<applet onblur=alert(1) tabindex=1 id=x></applet><input autofocus>")))
(assert (or (= z "t(1)"">test</frame>") (= z "alert(1)"">test</samp>") (= z "=1 onbeforeactivate=alert(1)></script>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 43) "p") (= (str.at z 6) "t") (not (str.contains (str.replace x " id=y" "<b>") "ut<b> au"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\u{5c}u4e00-\u{5c}u9fa5]+$"))) (<= (str.len z) 28) (not (= "nb" (str.substr x 9 2)))))
(assert (or (str.contains (str.replace y " a" """") "=y""ut") (= ") " (str.substr y 22 2))))
(assert (not (>= (str.len y) 104)))
(assert (not (= (str.at z 9) "t")))
(assert (not (str.prefixof "<ab" y)))
(assert (not (= "x=" (str.substr y 31 2))))
(assert (str.contains x "acti"))
(assert (str.contains x "r><input "))
(check-sat)
