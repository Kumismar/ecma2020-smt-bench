; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><svg ondrop=alert(1) contenteditable>drop here</svg>") (= x "<label onkeydown=""alert(1)"" contenteditable>test</label>") (= x "<legend id=x tabindex=1 onfocus=alert(1)></legend>")))
(assert (or (= z "copy=""alert(1)"" contenteditable>test</br>") (= z "/div><i ondrag\u{1f4a9}over=alert(1) contenteditable>drop here</i>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "rop ")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-z0-9]{4,30}$"))) (not (= (str.at x 52) "s")) (not (>= (str.len y) 158))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9+\-]*"))) (not (= (str.at y 0) "<"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-za-z0-9.-]+\.[A-Za-z]{2,3}$"))))
(assert (or (not (str.suffixof "test</br>" z)) (not (str.suffixof "bel>" x)) (str.prefixof "copy=" z)))
(assert (or (>= (str.len x) 43) (not (str.contains z "rag\u{1f4a9}over"))))
(assert (or (str.suffixof "r>" z) (<= (str.len y) 86)))
(assert (= "rop" (str.substr x 59 3)))
(check-sat)
