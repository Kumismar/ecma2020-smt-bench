; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span onkeydown=""alert(1)"" contenteditable>test</span>") (= x "<meta id=x tabindex=1 onbeforedeactivate=alert(1)></meta><input autofocus>")))
(assert (or (= z "'))>") (= z """alert(1)"">test</legend>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ">" x) (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z \-]{2,50}"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{1}.{1,}[a-zA-Z0-9]$"))) (not (= "t" (str.substr x 32 1)))))
(assert (or (not (str.prefixof """" z)) (str.in_re x ((_ re.from_regex ecma2020 u) "([a-zA-Z\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{fd}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{dd}\u{e2}\u{ea}\u{ee}\u{f4}\u{fb}\u{c2}\u{ca}\u{ce}\u{d4}\u{db}\u{e3}\u{f1}\u{f5}\u{c3}\u{d1}\u{d5}\u{e4}\u{eb}\u{ef}\u{f6}\u{fc}\u{ff}\u{c4}\u{cb}\u{cf}\u{d6}\u{dc}\u{178}\u{e7}\u{c7}]{2,}(\s|$)){2,}")) (not (= (str.indexof y "ivate" 0) 35))))
(assert (or (not (str.prefixof "<met" x)) (not (str.prefixof "<" x)) (= (str.indexof x "key" 0) 8)))
(assert (= (str.indexof y "(1)" 0) 46))
(check-sat)
