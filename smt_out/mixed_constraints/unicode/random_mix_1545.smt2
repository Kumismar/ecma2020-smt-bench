; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<center oncontextmenu=""alert(1)"">test</center>") (= x "<article onmouseout=""alert(1)"">test</article>") (= x "&#34;&#62;<h1/onmouseover='\u{5c}u0061lert(1)'>%00")))
(assert (or (= z "onpaste=""alert(1)"" contenteditable>test</q>") (= z "g me</div>\u{10348}<keygen ondrop=alert(1) conten\u{10348}teditable>drop here</keygen>") (= z "x tabindex=1 onbeforeactivate=alert(1)></figure>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9\-_\.]+)@([a-zA-Z0-9\-_]+\.)+[a-zA-Z]{2,}$"))) (= "/figure>" (str.substr y 85 10)) (not (str.suffixof "igure>" y))))
(assert (= (str.indexof z " " 0) 1))
(assert (or (not (= " onbefore" (str.substr y 57 9))) (not (str.contains y "=1 on"))))
(assert (or (not (= "<article onmouseout=""javascript:t(1)"">test</article>g me</div>\u{10348}<keygen ondrop=alert(1) conten\u{10348}teditable>drop here</keygen>" (str.replace y "aler" "javascript:"))) (not (= "rt(1)"">DEF" (str.substr z 53 10)))))
(assert (or (not (<= (str.len x) 49)) (str.suffixof "est</q>" y) (str.prefixof "<c" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z0-9\u{e01}-\u{e5b}.,:\(\)@\-\/\s]{0,1000}$"))) (not (<= (str.len z) 13))))
(check-sat)
