; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup ondblclick=""alert(1)"">test</optgroup>") (= x """><script>alert(String.fromCharCode(66, 108, 65, 99, 75, 73, 99, 101))</script>")))
(assert (or (= z "dex=1 id=x></frame><input autofocus>") (= z "s.org/xss.css&gt;; REL=stylesheet&quot;&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "99, 75,")) (= (str.at x 59) ",") (not (= (str.at z 27) "e"))))
(assert (or (str.suffixof "s>" y) (str.contains (str.replace z "base>" "javascript:") "st</javascript:") (= (str.indexof y "=a" 0) 87)))
(assert (not (str.suffixof "focus>" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\s]{1,4}$"))) (not (= (str.indexof y "ipt" 0) 6)) (not (= (str.indexof x " 73," 0) 56))))
(assert (>= (str.len y) 82))
(check-sat)
