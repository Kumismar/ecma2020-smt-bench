; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><menuitem id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></menuitem>") (= x "<table on\u{1d400}mouseover=""alert(1)"">test</table>") (= x "<img\x11src=x onerror=""javascript:alert(1)"">")))
(assert (or (= z "keydown=""alert(1)"" contenteditable>t\u{1d400}est</title>") (= z "ert(63)""></embed> // O10.10\u{2193}, OM10.0\u{2193}, GC6\u{2193}, FF") (= z ">")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "keydo" z))
(assert (or (str.contains (str.replace y "t(1)""" " ") "r >tes") (not (= "e on\u{1d400}m" (str.substr x 5 6))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s0-9 ]*$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9-&()\[\],. ]{1,150}$"))) (not (>= (str.len x) 117)) (= "ert(63)""></embed> //<b>10.10\u{2193}, OM10.0\u{2193}, GC6\u{2193}, FF" (str.replace z " O" "<b>"))))
(assert (<= (str.len z) 51))
(assert (or (str.contains x "alert") (= (str.at x 67) "n")))
(assert (or (not (= "<strike draggable=""true"" ondrag=""alert(1)"">tes""rike>t;TABLE BACKGROUND=\""javascript&#058;alert('XSS')\""&gt;" (str.replace y "t</st" """"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((?!\s)[a-zA-Z-\s\u{104}\u{105}\u{106}\u{107}\u{118}\u{119}\u{141}\u{142}\u{d3}\u{f3}\u{143}\u{144}\u{15a}\u{15b}\u{179}\u{17a}\u{17b}\u{17c}]\s?){2,}$")))))
(assert (not (= ">" (str.substr z 0 8))))
(assert (= (str.indexof y "t" 0) 25))
(check-sat)
