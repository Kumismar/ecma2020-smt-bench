; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext onmouseover=""alert(1)"">test</plaintext>") (= x "<p oncopy=""alert(1)"" contenteditable>test</p>") (= x "<style>@keyframes x{}</style><dialog style=""animation-name:x"" onanimationend=""alert(1)""></dialog>")))
(assert (or (= z "onkeyup=""alert(1)"" contenteditable>test</h1>") (= z "cus>") (= z "listing>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof ">listing>" y)) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9() -]+$")) (not (= "<p oncopy=""a<b>ert(1)"" contenteditable>test</p>onkeyup=""alert(1)"" contenteditable>test</h1>" (str.replace y "l" "<b>")))))
(assert (or (not (= "useover=""a" (str.substr y 15 10))) (= (str.indexof y "ve" 0) 19) (= "ng>" (str.substr z 5 9))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{4,11}"))) (= (str.at x 41) "e") (>= (str.len x) 90)))
(assert (not (str.prefixof "<p oncop" x)))
(assert (not (str.suffixof "test</h1>" y)))
(check-sat)
