; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><option onload=alert(1)></option>") (= x "<div draggable=""true"" contenteditable>drag me</div><frameset ondrop=alert(1) contenteditable>drop here</frameset>") (= x "<pre onbeforecopy=""alert(1)"" contenteditable>test</pre>")))
(assert (or (= z "rt(1)"" contenteditable>test</mark>") (= z "eet href=data:,*%7bx:expression(javascript:alert(1))%7d")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y ">rt(")) (= (str.indexof y "a:,*" 0) 50) (not (str.suffixof "xxx:x />" y))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(http(s)?:)?(\/)?(\/)?(www\.)?(facebook|fb|linkedin)\.com\/.+$"))))
(assert (or (not (= (str.at y 70) "j")) (not (= """true" (str.substr y 15 5))) (= (str.indexof z "mark>" 0) 29)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))) (<= (str.len x) 114)))
(assert (or (not (str.suffixof "/keygen>" x)) (not (= (str.indexof z "cr" 0) 3))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*\d)(?=.*[A-Z])(?=.*[a-z])[0-9A-Za-z]{8,}$")))
(check-sat)
