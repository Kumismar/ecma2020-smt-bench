; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<big onkeyup\u{20000}=""alert(1)"" contenteditable>test</big>") (= x "<img src onerror /"" '""= alt=javascript:alert(1)//"">") (= x "<button onfocusout=alert(1) id=x></button><input autofocus>")))
(assert (or (= z "div id=x tabindex=1 onfocus=alert(1)></div>") (= z "onload=alert(1)></aside>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "></aside>" y)) (not (str.contains (str.replace z "id=x " "alert(1)") "iv alert(1)tabi")) (not (str.contains z "(1)></div"))))
(assert (or (= "<img src onerror /"" '""= alt=javascalert(1)alert(1)//"">" (str.replace x "ript:" "alert(1)")) (not (= "rt(" (str.substr y 82 3))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9_]{10,10}$")))))
(assert (not (= (str.indexof z "></a" 0) 15)))
(assert (str.prefixof "<img src o" x))
(check-sat)
