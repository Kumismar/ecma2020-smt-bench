; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext draggable=""true"" ondragstart=""alert(1)"">test</plaintext>") (= x "<keygen draggable=""true"" ondragleave=""alert(1)"">test</keygen>") (= x """`'><script>\xE2\x80\x81javascript:alert(1)</script>")))
(assert (or (= z " draggable=""true"" ondragstart=""alert(1)"">test</style>") (= z "dex=1 onbeforedeactivate=alert(1)></tt><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^05[0-9]{8}$"))))
(assert (not (str.suffixof ">" z)))
(assert (= "ragstar" (str.substr x 31 7)))
(assert (or (not (= "ofocus>" (str.substr y 110 9))) (not (= (str.at z 13) "e"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "@?[A-Za-z0-9]+"))) (not (= (str.indexof y "<ke" 0) 0)) (not (= "2\" (str.substr x 15 2)))))
(check-sat)
