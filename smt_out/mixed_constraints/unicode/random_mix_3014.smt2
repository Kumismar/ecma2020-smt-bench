; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta onkeydown=""alert(1)"" contenteditable>test</meta>") (= x "<img src=""javascript:alert(1)"">") (= x "<div draggable=""true"" contenteditable>drag me</div><sup ondragover=alert(1) contenteditable>drop here</sup>")))
(assert (or (= z "cript:alert(String.fromCharCode(88,83,83))&gt;") (= z "rt(1) value=xss>") (= z ";SCR)';")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "p ond")) (not (= (str.at x 23) "e")) (not (= (str.indexof x " c" 0) 26))))
(assert (or (= "<img<b>rc=""javascript:alert(1)"">" (str.replace x " s" "<b>")) (not (str.contains y "all oncut=")) (str.suffixof "t;" y)))
(assert (or (str.contains (str.replace y "ert" "x") "pt:alx(1)") (str.prefixof "<s" y) (not (str.contains y "ler"))))
(assert (or (str.suffixof "3,83))&gt;" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "\d{17}")))))
(check-sat)
