; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed oncontextmenu=""al\u{1f4a9}ert(1)"">\u{10348}test</noembed>") (= x "<element onpaste=""alert(1)"" contenteditable>test</element>") (= x "<OBJECT TYPE=""text/x-scriptlet"" DATA=""http://hacker.com/xss.html"">")))
(assert (or (= z "dss</h1>") (= z "#X3C") (= z "lert(1)"">test</rb>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<noe" y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{9,}$"))) (= "lert" (str.substr z 0 4))))
(assert (or (str.suffixof "bed>#X3C" y) (not (= (str.indexof z ">" 0) 8)) (= (str.indexof y "ent" 0) 5)))
(assert (not (= (str.at z 1) " ")))
(assert (or (not (= "com/xss.ht" (str.substr y 52 10))) (= (str.len x) 58)))
(assert (or (str.contains y "al\u{1f4a9}e") (str.in_re z ((_ re.from_regex ecma2020 u) "^\+(\d{1}\s?){8,20}$"))))
(check-sat)
