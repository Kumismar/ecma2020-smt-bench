; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG STYLE=""xss:expr/*XSS*/ession(alert('XSS'))"">") (= x "<time id=x tabindex=1 ondeactivate=alert(1)></time><input id=y autofocus>")))
(assert (or (= z "maction=""javascript:javascript:alert(1)"">X") (= z "test</summary>") (= z "t=alert(1) id=x><\u{1f600}/select><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 40) (not (= (str.indexof y "*/ess" 0) 25)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-\u{17e}0-9. _-]{5,}$")))))
(assert (or (not (str.prefixof "g" z)) (not (= "(1)" (str.substr x 40 3)))))
(assert (or (= (str.indexof x "ke" 0) 8) (not (str.suffixof ")"">" x)) (not (str.contains y "au"))))
(assert (or (not (str.suffixof "</s>" z)) (not (str.suffixof "ert(1)"">X" z)) (str.contains z "t</summar")))
(assert (not (= "s>" (str.substr z 41 3))))
(check-sat)
