; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select onbeforecopy=""alert(1)"" contenteditable>test</select>") (= x "<style>:t\u{10348}arget {color: red;}</style><head id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></head>") (= x "&lt;META HTTP-EQUIV=&qu\u{1f4a9}ot;refresh&quot; CONTENT=&quot;0;url=data:text/html;bas\u{1f4a9}e64,PHNjcmlwdD5hbGVydCgnWFNTJyk8L3NjcmlwdD4K&quot;&gt;")))
(assert (or (= z "FRAME>") (= z "id=x></nobr><input autofocus>") (= z " onmouseover=""alert(1)"">test</dl>")))
(assert (= y (str.++ x z)))
(assert (= "or: re" (str.substr y 20 6)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Za-z\u{f1}\u{d1} ]{1,100}"))) (<= (str.len x) 138)))
(assert (or (not (= (str.at y 118) "s")) (not (str.contains x "=""alert(1)")) (= (str.at y 93) "e")))
(assert (not (str.contains x "ition:colo")))
(assert (or (<= (str.len z) 37) (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,10}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Zs ]+$"))))
(check-sat)
