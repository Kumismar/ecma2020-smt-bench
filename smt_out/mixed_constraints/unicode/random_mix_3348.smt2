; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><em id=x style=""transition:color 1s"" ontransitionend=alert(1)></em>") (= x "<kbd onmousemove=""alert(1)"">test</kbd>") (= x "<shadow draggable=""true"" ondragstart=""alert(1)"">test</shadow>")))
(assert (or (= z "yup=""alert(1)"" contenteditable>test</li>") (= z "nteditable>test</u>") (= z "0")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x ")></em>") (not (= "<k<b>mousemove=""alert(1)"">test</kbd>" (str.replace x "bd on" "<b>")))))
(assert (or (not (>= (str.len x) 92)) (not (str.suffixof "0" z)) (= (str.len x) 38)))
(assert (or (str.prefixof "<s" x) (= "0" (str.substr z 0 8)) (str.prefixof "<sp" y)))
(assert (or (str.prefixof "yu" z) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[A-Za-z0-9]+([\-\.]{1}[A-Za-z0-9]+)*\.[a-z]{2,5}(:[0-9]{1,5})?(\/.*)?$")))))
(check-sat)
