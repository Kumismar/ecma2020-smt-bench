; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt onfocusout=alert(1) tabindex=1 id=x></dt><input autofocus>") (= x "<wbr id=x tabindex=1 ondeactivate=alert(1)></wbr><input id=y autofocus>")))
(assert (or (= z "e"" contenteditable>drag me</div><li ondrop=alert(1) contenteditable>drop here</li>") (= z "rt('xxs')"">")))
(assert (= y (str.++ x z)))
(assert (or (= "p=alert(1" (str.substr z 41 9)) (<= (str.len y) 157)))
(assert (or (str.prefixof "<" x) (= (str.indexof y "al" 0) 34)))
(assert (or (not (= (str.at z 7) "'")) (not (str.prefixof "<dt onfoc" x))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^1[345678][0-9]{9}$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "(.){2,}$")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,5}$")))))
(check-sat)
