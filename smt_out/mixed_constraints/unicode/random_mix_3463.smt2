; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre id=x tabindex=1 onactivate=alert(1)></pre>") (= x "\u{2018}; alert(1);")))
(assert (or (= z "itable>test</wbr>") (= z "ipt:alert(1)"">DEF") (= z "lert(1) open>test</details>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace y "abi" "") "d=x tn")))
(assert (or (not (str.suffixof "te>" x)) (not (= ">" (str.substr y 97 1)))))
(assert (or (not (= (str.indexof x "o" 0) 21)) (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{3}|[0-9]{1,3})(\]?)$"))))
(assert (or (str.prefixof "&quot;" z) (= "<element onkeyup=""javascript:lert(1)"" contenteditable>test</element>" (str.replace x "a" "javascript:")) (str.contains z "*""")))
(assert (str.suffixof "br>" z))
(assert (not (= (str.len z) 27)))
(check-sat)
