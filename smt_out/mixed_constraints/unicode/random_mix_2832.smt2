; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><cite style=""animation-name:x"" onanimationend=""alert(1)""></cite>") (= x "<div draggable=""true"" contenteditable>drag me</div><ins ondrop=alert(1) contenteditable>drop here</ins>")))
(assert (or (= z """alert(1)"">test</xmp>") (= z "alert(1)"">test</tt>") (= z "C")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "i" 0) 31))
(assert (or (str.prefixof "&l" y) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[0-9])(?=.*[a-z])(?=.*[A-Z]).{8,}")))))
(assert (not (= (str.indexof y "ert(" 0) 36)))
(assert (or (str.contains z "est</tt") (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9\.]")))))
(assert (or (not (= (str.indexof x "st" 0) 1)) (>= (str.len z) 13) (not (str.contains (str.replace x "n" "") """aima"))))
(assert (str.contains x "nt"))
(check-sat)
