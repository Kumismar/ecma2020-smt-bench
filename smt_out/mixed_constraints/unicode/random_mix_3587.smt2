; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><acronym style=""animation-name:x"" onanimationstart=""alert(1)""></acronym>") (= x "<u onkeypress=""alert(1)"" contenteditable>test</u>")))
(assert (or (= z "able>test</q>") (= z "extmenu=""alert(1)"">test</dd>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<s" x))
(assert (not (= (str.indexof x "nam" 0) 55)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\u{30a1}-\u{30f3}\u{30f4}\u{30fc}0-9|\u{3000}| ]+$"))))
(assert (= (str.at z 18) "e"))
(assert (or (= "able>te<b>q>" (str.replace z "st</" "<b>")) (= "<foreignObject xlink:href=""data:text/xml,%3Cscript xmlns='h<b>//www.w3.org/1999/xhtml'%3Ealert(88)%3C/script%3E""/>" (str.replace x "ttp:" "<b>"))))
(assert (or (str.prefixof "<style>" x) (not (str.prefixof "<u onke" y))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[1-9]{1}[0-9]{13}"))) (str.suffixof ">test</q>" z)))
(assert (or (= (str.at x 40) ">") (= "ony" (str.substr y 96 3)) (not (str.contains x "acron"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?[\d\/\s\-]{8,20}$")) (= (str.at x 26) "o")))
(check-sat)
