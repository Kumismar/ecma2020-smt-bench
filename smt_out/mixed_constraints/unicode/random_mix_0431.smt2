; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image onmousedown=""alert(1)"">test</image>") (= x """><iframe%20src=""http://google.com""%%203E") (= x "<time draggabl\u{1f600}e=""true"" ondragend=""alert(1)"">test</time>")))
(assert (or (= z "et>") (= z "script>") (= z "png onload=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (not (= "sedown=" (str.substr x 12 7))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[#$^+=!*()@%&]).{8,10}$")))
(assert (= "0" (str.substr x 38 1)))
(assert (<= (str.len z) 95))
(assert (or (not (str.prefixof "<image o" y)) (not (= "u" (str.substr x 11 1)))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^.{1,200}"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^1[3458]{1}[0-9]{9}$"))))
(check-sat)
