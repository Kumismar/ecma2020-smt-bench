; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onblur=alert(1) tabindex=1 id=x></cite><input autofocus>") (= x "<select onfocusout=alert(1) id=x><\u{1f600}/select><input autofocus>") (= x "ABC<div style=""x\x3Aexpression(javascript:alert(1)"">DEF")))
(assert (or (= z "bindex=1 onfocus=alert(1)></param>") (= z """alert(1)"">test</noscript>") (= z "teditable>test</element>")))
(assert (= y (str.++ x z)))
(assert (= "rt(1)"">t" (str.substr z 4 8)))
(assert (or (not (= (str.at x 9) "n")) (= (str.indexof z "</ele" 0) 14)))
(assert (or (str.prefixof """alert(1)" z) (= (str.at y 26) ")")))
(assert (or (str.suffixof "/noscript>" y) (not (str.contains z "=alert(1)>")) (str.contains x "Aexpre")))
(assert (or (not (= "(1) " (str.substr x 24 4))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[ \t\r\n\f\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}]*$"))) (= (str.at y 43) "e")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z0-9-_\.]{1,30}$"))))
(assert (not (str.suffixof "y>" y)))
(check-sat)
