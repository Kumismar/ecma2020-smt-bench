(assert (or (not (= (str.indexof z "ag" 0) 1)) (not (>= (str.len x) 47))))
(assert (or (not (= (str.at y 55) "e")) (not (= (str.indexof x "nym " 0) 5)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-9][0-9]{3}\s?([a-zA-Z]{2})?$"))))
