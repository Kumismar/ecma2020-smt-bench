; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=x\x12onerror=""javascript:alert(1)"">") (= x "<iframe o\u{1f4a9}ncut=""\u{1d400}alert(1)"" contenteditable>test</iframe>") (= x "</script><script>alert('XSS');</script>")))
(assert (or (= z "</blink>") (= z "T&gt;")))
(assert (= y (str.++ x z)))
(assert (or (= "/" (str.substr z 1 1)) (= (str.at z 3) "t") (not (str.contains x "vascript:"))))
(assert (or (not (str.contains (str.replace x "1" "alert(1)") "t(alert(1))>")) (= (str.at y 16) ">") (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9.]{6,9}([0-9A-Z]{0,3})$")))))
(assert (or (= (str.at z 0) "T") (not (str.suffixof "t;" y)) (not (<= (str.len y) 51))))
(assert (or (<= (str.len x) 46) (str.prefixof "<img src" x)))
(assert (or (not (str.prefixof "<" y)) (not (str.contains (str.replace z "nk>" "<b>") "</bli<b>"))))
(assert (or (str.contains z "gt") (str.prefixof "<i" y)))
(check-sat)
