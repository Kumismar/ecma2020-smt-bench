; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe src=javascript:alert(1)>") (= x "<meta onblur=alert(1) tabindex=1 id=x></meta><input autofocus>") (= x "<bdi draggable=""true"" ondragenter=""alert(1)"">test</bdi>")))
(assert (or (= z "do>") (= z "nt onkeydown=""alert(1)"" contenteditable>test</content>") (= z "</multicol>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\+91[\-\s]?)?[0]?(\+91.[\-\s]?)?[0]?(91)?[6789]\d{9}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(.+@)(?!online|alice|virgilio|tin|tim|aol|me|mac|icloud|arcor|bluewin|blueyonder|bbox|btinternet|comcast|email|facebook|free|aliceadsl|infonie|libertysurf|freesbee|alicepro|worldonline|freenet|gmx|caramail|gmail|googlemail|home|laposte|libero|blu|giallo|mail|bk|hotmail|live|msn|outlook|windowslive|dbmail|hotmail|live|msn|telefonica|movistar|numericable|noos|o2|orange|wanadoo|skynet|rambler|lenta|autorambler|myrambler|ro|r0|sfr|neuf|9online|9business|cegetel|club-internet|cario|guideo|mageos|fnac|waika9|sky|telenet|tiscali|t-online|verizon|ono|voila|web|wp|yahoo|ymail|rocketmail|yandex|talktalk)(.+\.).+$"))) (not (= "autofo" (str.substr x 52 6)))))
(assert (or (not (= (str.at z 6) "e")) (= (str.indexof x "vasc" 0) 14) (not (>= (str.len y) 69))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9]{4})-([0-9]{4})-([0-9]{4})$"))) (str.suffixof ">" z) (not (str.suffixof "/multicol>" z))))
(assert (not (= "rt(1) t" (str.substr x 16 7))))
(assert (or (= "true"" ondr" (str.substr x 16 10)) (not (= (str.at x 9) "d"))))
(assert (= (str.at y 29) "n"))
(check-sat)
