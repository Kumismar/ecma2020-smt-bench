; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onkeyup=""alert(1)"" contenteditable>test</input>") (= x "<style>@keyframes x{}</style><rb style=""animation-name:x"" onanimationend=""alert(1)""></rb>")))
(assert (or (= z "frames x{}</style><listing style=""animation-name:x"" onanimationstart=""alert(1)""></listing>") (= z "0\x8Bjavascript:alert(1)</script>") (= z "efont onmouseenter=""alert(1)"">test</basefont>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 85) "s")))
(assert (or (= "us" (str.substr y 64 2)) (= (str.at y 40) "l")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$")))
(assert (or (= "frams x{}</style><listing style=""animation-name:x"" onanimationstart=""alert(1)""></listing>" (str.replace z "e" "")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(?:(010-\d{4})|(01[1|6|7|8|9]-\d{3,4}))-(\d{4})$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([a-zA-Z\u{5c}u0080-\u{5c}u024F]+(?:. |-| |'))*[a-zA-Z\u{5c}u0080-\u{5c}u024F]*$")))))
(assert (or (= "yframes " (str.substr y 10 8)) (str.suffixof "b>" x) (not (= "efont onmouseenter=alert(1)rt(1)"">test</basefont>" (str.replace z """ale" "alert(1)")))))
(assert (or (not (str.contains y "ert(")) (= (str.at y 91) "o") (not (= "mes " (str.substr z 3 4)))))
(check-sat)
