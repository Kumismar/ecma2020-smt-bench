; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea onselect=alert(1) autofocus>XSS</textarea>") (= x "<figure draggable=""true"" ondragenter=""alert(1)"">test</figure>") (= x "<div draggable=""true"" contenteditable>drag me</div><del ondragover=alert(1) contenteditable>drop here</del>")))
(assert (or (= z " contenteditable>test</mark>") (= z "IMG SRC=x onabort=""alert(String.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "IM" z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9\u{5c}u4e00-\u{5c}u9fa5]+$"))))
(assert (or (not (str.contains x "test</fig")) (= "itable>dro" (str.substr y 85 10))))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^(?!.*gmail|.*outlook|.*yahoo|.*hotmail).*$")))
(assert (str.prefixof "<sub" y))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[\d\+\(\)\s\.\-/]+$")) (not (str.suffixof ">" x))))
(assert (str.contains y "exta"))
(check-sat)
