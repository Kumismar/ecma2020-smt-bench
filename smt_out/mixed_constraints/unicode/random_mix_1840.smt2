; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col id=x tabindex=1 onactivate=alert(1)></col>") (= x "<html onclick=""alert(1)"">test</html>")))
(assert (or (= z "itable>drag me</div><ins ondrop=alert(1) contenteditable>drop here</ins>") (= z "on-name:x"" onanimationstart=""alert(1)""></object>") (= z "on\u{1d400}mouseover=""alert(1)"">test</table>")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^IH.+")))
(assert (or (= "ler" (str.substr z 30 3)) (not (= (str.at x 4) " ")) (not (>= (str.len y) 107))))
(assert (or (not (= (str.indexof x "c" 0) 1)) (str.contains (str.replace x ")" "x") "ert(1x>") (= (str.indexof x "1)"">t" 0) 21)))
(assert (or (not (str.contains x "l>")) (str.in_re x ((_ re.from_regex ecma2020 u) "^[+]?([0-9]*[\.\s\-\(\)]|[0-9]+){7,24}$")) (not (>= (str.len x) 30))))
(assert (or (not (= (str.len x) 36)) (= (str.at x 13) "i")))
(assert (or (str.contains z "er=""alert(") (not (str.contains x "onactiv"))))
(check-sat)
