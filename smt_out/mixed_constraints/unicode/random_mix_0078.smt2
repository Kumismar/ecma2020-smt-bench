; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u onkeydown=""alert(1)"" contenteditable>test</u>") (= x "<basefont onmouseup=""alert(1)"">test</basefont>") (= x "<br draggable=""true"" ondragenter=""alert(1)"">test</br>")))
(assert (or (= z "3Ealert('XSS')%253C%252Fscript%253E") (= z "i onmouseover=""alert(1)"">test</i>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof ">" y))
(assert (= (str.indexof z "able=" 0) 7))
(assert (or (str.suffixof "253E" z) (not (= (str.at z 3) "*"))))
(assert (= "<xmp onbeforecut=""alert(1)"" contenteditabl<b>test</xmp>" (str.replace x "e>" "<b>")))
(assert (or (not (= (str.indexof x "1)"">" 0) 40)) (>= (str.len x) 44)))
(assert (or (= (str.len x) 46) (not (<= (str.len y) 72))))
(assert (or (= "er=""a" (str.substr x 36 5)) (str.suffixof "t%253E" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[\w\u{e4}\u{f6}\u{fc}._%+-]+@[\w-]+\.[A-Za-z]{2,20}$")))))
(assert (or (not (= "useo" (str.substr z 6 4))) (not (= (str.indexof x "cus>" 0) 39)) (not (= "<basefonx onmouseup=""alert(1)"">test</basefont>3Ealert('XSS')%253C%252Fscript%253E" (str.replace y "t" "x")))))
(check-sat)
