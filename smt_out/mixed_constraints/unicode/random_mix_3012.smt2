; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source onblur=alert(1) tabindex=1 id=x></source><input autofocus>") (= x "<form onreset=alert(1)><input type=reset>")))
(assert (or (= z "ert(1)""></tfoot>") (= z "/h1>") (= z ";}</STYLE><A CLASS=XSS></A>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_.-]*$"))) (not (str.suffixof "</A>" z)) (not (str.prefixof "<form" x))))
(assert (or (= (str.len y) 57) (= (str.at z 3) ">") (not (str.contains (str.replace x "eset" """") "nr""=al"))))
(assert (or (not (str.contains (str.replace z "E><A" " ") "YL  CLAS")) (= (str.at z 0) "e") (not (= (str.indexof x "x" 0) 31))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\(\)\/\+ \-]{9,100}$"))))
(check-sat)
