; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<data onmouseleave=""alert(1)"">test</data>") (= x "<!--[if gte IE 4]><SCRIPT>document.vulnerable=true;</SCRIPT><![endif]-->") (= x "<samp onbeforecopy=""ale\u{1f4a9}rt(1)"" contenteditable\u{10348}>test</samp>")))
(assert (or (= z "<!doctype html>") (= z "nimationend=""alert(1)""></frame>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<" x) (= "<!--[if gte IE 4]><SCRIPT>doxument.vulnerable=true;</SCRIPT><![endif]-->" (str.replace x "c" "x")) (str.contains (str.replace x "ata>" "alert(1)") "/dalert(1)")))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "^\s*(3[01]|[12][0-9]|0?[1-9])\.(1[012]|0?[1-9])\.((?:19|20)\d{2})\s*$")))
(assert (or (not (str.suffixof ">" z)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[ A-Za-z_./'#&+-]*$")))))
(assert (not (str.contains z "teditabl")))
(assert (= "nimationend=""alert(1alert(1)</frame>" (str.replace z ")"">" "alert(1)")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]{9}$"))) (not (str.suffixof "</samp>" x)) (str.prefixof "<!--[i" x)))
(assert (or (= (str.len x) 72) (not (= (str.indexof z "/fram" 0) 24)) (not (str.suffixof "</frame>" y))))
(assert (= "nend=" (str.substr z 7 5)))
(check-sat)
