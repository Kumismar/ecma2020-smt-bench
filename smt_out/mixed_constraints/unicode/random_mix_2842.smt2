; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rt draggable=""true"" ondragend=""alert(1)"">test</rt>") (= x "<input id=x onfocusin=alert(1)>") (= x "<li onpaste=""alert(1)"" contenteditable>test</li>")))
(assert (or (= z "ram>") (= z " draggable=""true"" ondragleave=""alert(1)"">test</rp>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "sin")) (not (= (str.at y 7) "i"))))
(assert (or (<= (str.len y) 56) (str.contains z "e=""t")))
(assert (or (not (str.prefixof " d" z)) (not (= (str.len x) 48)) (str.in_re y ((_ re.from_regex ecma2020 u) "^09[0-9]{8}"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[^\f\n\r\t\v]{2,44}$"))))
(assert (or (<= (str.len y) 133) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^@]+@[^@]+\.[^@]{2,}$"))) (not (str.contains y "rag"))))
(check-sat)
