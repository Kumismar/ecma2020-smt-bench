; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<header onmouseleave=""alert(1)"">test</header>") (= x "<tfoot onmouseenter=""alert(1)"">test</tfoot>")))
(assert (or (= z "est</s>") (= z " style=""animation-name:x"" onanimationend=""alert(1)""></center>") (= z "t onmouseout=""alert(1)"">test</output>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9A-Fa-f]+$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z\s\xA6\xA8\xAA\xB4\xB5\xB8\xBA\xBC-\xBE\xC0-\xD6\xD8-\xF6\xF8-\xFF\-/]{1,40}(\/[A-Za-z\s\xA6\xA8\xAA\xB4\xB5\xB8\xBA\xBC-\xBE\xC0-\xD6\xD8-\xF6\xF8-\xFF\-/]{0,40})?$")))))
(assert (or (= "/s>" (str.substr z 4 6)) (not (= (str.at z 19) "a"))))
(assert (not (str.suffixof "t>" y)))
(assert (or (not (= (str.indexof x "aler" 0) 21)) (= (str.indexof x "tf" 0) 1) (not (= (str.indexof x "onmo" 0) 7))))
(check-sat)
