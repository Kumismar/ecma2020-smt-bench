; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr onmousedown=""alert(1)"">test</hr>") (= x "<sub onmousemove=""alert(1)"">test</sub>")))
(assert (or (= z "n=alert(1)></title>") (= z "1)"">test</bdi>") (= z "1 onfocus=alert(1)></ins>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len z) 17)) (str.contains (str.replace y "focus" """") "n""=aler")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 './,]+$")) (str.prefixof """'`>ABC<di" x)))
(assert (or (str.prefixof "<hr on" x) (= (str.at y 48) "b") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z]{3}$")))))
(assert (or (not (str.contains y "scrip")) (= "</sub>1)" (str.substr y 32 8))))
(assert (or (= (str.indexof y "></ti" 0) 46) (not (= (str.at x 28) "t"))))
(assert (or (= "</ins>" (str.substr y 57 6)) (not (>= (str.len z) 16)) (not (<= (str.len x) 44))))
(check-sat)
