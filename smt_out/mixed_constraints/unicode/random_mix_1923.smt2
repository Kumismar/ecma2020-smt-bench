; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><base onload=alert(1)></base>") (= x "<style>:target {color: red;}</style><option id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></option>")))
(assert (or (= z "10alert(1)>") (= z "eleave=""alert(1)"">test</param>") (= z " onmousedown=""alert(1)"">test</noframes>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "option>" x)))
(assert (or (str.contains x "><input ") (not (<= (str.len y) 79)) (str.contains (str.replace x "r: re" "javascript:") "{colojavascript:d;")))
(assert (or (not (= "se>" (str.substr x 31 6))) (not (str.contains z "ert(1)"">t"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(13[0-9]|14[5|7]|15[0|1|2|3|5|6|7|8|9]|18[0|1|2|3|5|6|7|8|9])\d{8}"))) (not (str.suffixof "rt(1)>" y))))
(assert (or (not (= (str.at x 6) "b")) (not (= (str.at x 24) " ")) (str.suffixof ">" y)))
(check-sat)
