; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><abbr onload=alert(1)></abbr>") (= x "<meter onclick=""alert(1)"">test</meter>") (= x "<figure id=x tabindex=1 onbeforeactivate=alert(1)></figure>")))
(assert (or (= z "/frame>") (= z "</details>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 66) "l")) (not (= (str.at x 16) "a")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((8|\+375)[\- ]?)?(\(?\d{2}\)?[\- ]?)?[\d\- ]{7,10}$")))))
(assert (not (str.suffixof "ame>" z)))
(assert (not (str.contains (str.replace z "il" "<b>") "/deta<b>s")))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9a-zA-Z\u{11f}\u{fc}\u{15f}\u{f6}\u{131}\u{e7}\u{130}\u{11e}\u{dc}\u{15e}\u{d6}\u{c7}. ,-]*$")))
(assert (not (= (str.len y) 48)))
(assert (or (str.contains y "st</me") (= (str.at x 8) "i")))
(check-sat)
