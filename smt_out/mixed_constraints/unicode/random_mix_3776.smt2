; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<BODY ONLO\u{1f600}AD=javas\u{20000}cript:alert(1)>") (= x "<svg><ul onload=alert(1)></ul>")))
(assert (or (= z "e"" ondrag=""alert(1)"">test</b>") (= z "-name:x"" onanimationstart=""alert(1)""></body>")))
(assert (= y (str.++ x z)))
(assert (= "1)" (str.substr z 17 2)))
(assert (or (not (str.suffixof "y>" y)) (<= (str.len y) 63) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]+$")))))
(assert (or (not (str.prefixof "<BO" y)) (str.suffixof ">003c;" y)))
(assert (not (<= (str.len x) 39)))
(assert (or (not (str.prefixof "<t" y)) (not (>= (str.len y) 78)) (= (str.indexof z "r" 0) 6)))
(assert (= "name" (str.substr z 1 4)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "city-validator"))))
(check-sat)
