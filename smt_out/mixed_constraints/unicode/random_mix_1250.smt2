; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dir onmousedown=""alert(1)"">test</dir>") (= x "<picture id=x tabindex=1 onbeforeactivate=alert(1)></picture>")))
(assert (or (= z "plate>") (= z "ipt:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\d\+\- ]{9,15}$"))))
(assert (or (not (<= (str.len z) 54)) (= (str.at z 0) " ") (= "l" (str.substr y 43 1))))
(assert (or (= (str.at y 17) "s") (not (str.prefixof "i" z)) (str.prefixof "<di" y)))
(assert (or (= "<dir onmoualert(1)edown=""alert(1)"">test</dir>ipt:javascript:alert(1)"" id=""fuzzelement1"">test</a>" (str.replace y "s" "alert(1)")) (str.prefixof "pl" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9][a-zA-Z0-9\- ]{0,10}?[a-zA-Z0-9]$"))))
(check-sat)
