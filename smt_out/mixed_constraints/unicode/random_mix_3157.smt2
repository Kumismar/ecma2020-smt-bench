; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "</a>//[""'`-->]]>]</div>") (= x "&lt;A HREF=\""http&#58;//www&#46;gohttp&#58;//www&#46;google&#46;com/ogle&#46;com/\""&gt;XSS&lt;/A&gt;") (= x "<IMG SRC=x onshow=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "ert()>") (= z "head oncut=""alert(1)"" contenteditable>test</thead>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "83)" 0) 51)) (not (= (str.indexof x "/d" 0) 18)) (not (= (str.at z 5) ">"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-\u{17e}- ()]{2,}$")) (str.contains x "46;g")))
(assert (or (not (str.prefixof "div>" z)) (not (= (str.at x 20) "i"))))
(assert (or (not (= (str.indexof y "/a>//" 0) 1)) (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-z0-9._-]+@[a-z0-9._-]{2,}\.[a-z]{2,4}$")) (not (>= (str.len x) 95))))
(assert (not (str.prefixof "head oncut" z)))
(assert (or (not (str.prefixof "</a>//" y)) (str.contains x "op=alert(1")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z\s\u{c3}\u{a3}\u{c3}\u{a2}\u{c3}\u{a1}\u{c3}\u{a9}\u{c3}\u{ad}\u{c3}\u{b3}\u{c3}\u{ba}\u{c3}\u{192}\u{c3}\u{201a}\u{c3}\u{81}\u{c3}\u{2030}\u{c3}\u{8d}\u{c3}\u{201c}\u{c3}\u{161}\u{c3}\u{b4}\u{c3}\u{201d}\.]+"))))
(check-sat)
