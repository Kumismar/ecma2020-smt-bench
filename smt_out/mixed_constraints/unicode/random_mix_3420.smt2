; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><svg ondrop=alert(1) contenteditable>drop here</svg>") (= x "<picture id=x tabindex=1 ondeactivate=alert(1)></picture><input id=y autofocus>") (= x "<command onkeyup=""alert(1)"" contenteditable>test</command>")))
(assert (or (= z " onclick=""alert(1)"">test</rp>") (= z "utofocus onfocusin=alert(1)>test</button>")))
(assert (= y (str.++ x z)))
(assert (or (= "cture" (str.substr x 3 5)) (str.in_re y ((_ re.from_regex ecma2020 u) "^[\+]?[(]?[0-9]{3}[)]?[-\s\.]?[0-9]{3}[-\s\.]?[0-9]{4,6}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) ".{0,13}"))))
(assert (not (<= (str.len x) 52)))
(assert (or (str.prefixof "<div" x) (str.suffixof "and>" x) (not (= (str.at x 85) "l"))))
(assert (not (= (str.indexof y ">d" 0) 37)))
(assert (or (not (= (str.at z 5) "i")) (str.in_re z ((_ re.from_regex ecma2020 u) "[_a-z0-9-]+(\.[_a-z0-9-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,4})$"))))
(check-sat)
