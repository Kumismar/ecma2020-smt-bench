; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onbeforecopy=""alert(1)"" contenteditable>test</iframe>") (= x "<fieldset onkeypress=""alert(1)"" contenteditable>test</fieldset>") (= x "<article id=x tabindex=1 onfocusin=alert(1)></article>")))
(assert (or (= z "t draggable=""true"" ondragstart=""\u{1f4a9}alert(1)"">test</datalist>") (= z "e=""animation-name:x"" onanimationstart=""alert(1)""></multicol>") (= z "=1 id=x></main><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9a-zA-Z]([\+\-_\.][0-9a-zA-Z]+)*)+@(([0-9a-zA-Z][-\w]*[0-9a-zA-Z]*\.)+[a-zA-Z0-9]{2,4})$")))
(assert (or (not (str.contains z "oad")) (str.contains (str.replace y "x=1" " ") "nde  ") (str.prefixof "e=""animat" z)))
(assert (or (not (str.suffixof "lticol>" z)) (not (= (str.indexof y "x tab" 0) 12))))
(assert (not (str.suffixof "alist>" y)))
(assert (= (str.indexof y "tru" 0) 76))
(assert (not (= "<title onkeyup=""alert(1)"" contenteditable>test</title>ivate=alert(1)></pre><input id=y au<b>cus>" (str.replace y "tofo" "<b>"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[ \t\r\n\f0-9-]*$"))) (not (= "(1)"">te" (str.substr z 38 7))) (not (= "n=al" (str.substr y 33 4)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(([^<>()[\]\\.,;:\s@\u{5c}u0022]+(\.[^<>()[\]\\.,;:\s@\u{5c}u0022]+)*)|(\u{5c}u0022.+\u{5c}u0022))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$"))) (str.prefixof "<fie" y)))
(assert (not (str.prefixof "<fields" x)))
(check-sat)
