; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option onblur=alert(1) tabindex=1 id=x></option><input autofocus>") (= x "<li onkeydown=""alert(1)"" contenteditable>test</li>") (= x "<style>:target {transform: rotate(180deg);}</style><sup id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></sup>")))
(assert (or (= z "ert(1) autofocus>") (= z "onbeforepaste=""alert(1)"" contenteditable>test</figure>") (= z "lot>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z'][\sa-zA-Z-']*[a-zA-Z']'?")) (not (= "te" (str.substr y 107 2))) (<= (str.len x) 64)))
(assert (not (= (str.len x) 55)))
(assert (= (str.at x 32) "e"))
(assert (not (str.contains y "autofoc")))
(assert (or (<= (str.len z) 26) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\s]{0,18}$")))))
(assert (or (str.prefixof "ert" z) (not (str.contains (str.replace y "li o" "x") "<xn"))))
(check-sat)
