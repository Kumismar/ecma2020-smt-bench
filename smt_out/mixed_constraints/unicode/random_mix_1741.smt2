; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr oncontextmenu=""alert(1)"">test</abbr>") (= x "<bgsound onmousedown=""alert(1)"">test</bgsound>") (= x "<script onbeforepaste=""alert(1)"" contenteditable>test</script>")))
(assert (or (= z "ml>") (= z "t(1)></title>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "(1)></bdi>" y)) (str.in_re x ((_ re.from_regex ecma2020 u) "^\S{6,32}$")) (= (str.indexof y " on" 0) 6)))
(assert (str.prefixof "<scr" x))
(assert (or (str.contains (str.replace z "itle>" """") ")></t""") (str.prefixof "<scri" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?:19|20)[0-9]{2}-(?:(?:0[1-9]|1[0-2])/(?:0[1-9]|1[0-9]|2[0-9])|(?:(?!02)(?:0[1-9]|1[0-2])/(?:30))|(?:(?:0[13578]|1[02])-31))"))))
(assert (str.prefixof "<sub onfo" x))
(check-sat)
