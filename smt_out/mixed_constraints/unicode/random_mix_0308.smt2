; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><img src=1 onerr\u{1f600}or=alert(1)>.gif") (= x "<script>alert(1337)</script><marquee><h1>XSS by xss</h1></marquee>")))
(assert (or (= z "{}</style><legend style=""animation-name:x"" onanimationstart=""alert(1)""></legend>") (= z "=x></blockquote><input autofocus>") (= z "wn=""alert(1)"">test</spacer>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "wn=""alert(" z)) (<= (str.len z) 35) (not (= "ble" (str.substr z 0 3)))))
(assert (or (not (str.contains z "x></bloc")) (str.in_re z ((_ re.from_regex ecma2020 u) "^([0-9]{4}-[0-1][0-9]|[0-9][0-9])-(3[01]|[12][0-9]|0[1-9])$")) (not (str.contains z "er"))))
(assert (or (str.suffixof "tofocus>" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\w\-]+$"))) (not (str.suffixof "br>" y))))
(assert (or (str.contains z "lert(1)") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((?!test@altoromutual.com).)*$")))))
(assert (or (str.contains (str.replace z "l" "alert(1)") "</balert(1)ockqu") (= "nimation" (str.substr z 46 8)) (not (>= (str.len y) 92))))
(assert (not (str.contains (str.replace z "ert" "x") "lx(1")))
(check-sat)
