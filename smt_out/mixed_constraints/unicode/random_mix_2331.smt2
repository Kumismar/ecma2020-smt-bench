; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<A HREF=""http://%77%77%77%2E%67%6F%6F%67%6C%65%2E%63%6F%6D"">XSS</A>") (= x "<video><track default onload=alert(1) src=""data:text/vtt,WEBVTT""></video>")))
(assert (or (= z "here</colgroup>") (= z "lert(1)></s>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "t(1)></s")) (not (str.contains (str.replace x "olo" "alert(1)") "{calert(1)r:re"))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^\s*[0-9a-zA-Z@._\\/-]*\s*$")))
(assert (= (str.at z 11) "o"))
(assert (not (= (str.at y 38) "s")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[+][7] [(][\d]{3}[)] \d{3}-\d{2}-\d{2}\d{0,1}$"))) (not (= (str.len x) 67))))
(assert (not (= "E%63%6F%" (str.substr x 48 8))))
(assert (or (not (str.prefixof "<A HREF=""" y)) (str.contains (str.replace z "ro" """") "g""up>")))
(assert (or (not (= (str.indexof y "olgro" 0) 80)) (not (= (str.at y 46) "a")) (str.in_re y ((_ re.from_regex ecma2020 u) "[a-z0-9A-Z]{6,16}$"))))
(check-sat)
