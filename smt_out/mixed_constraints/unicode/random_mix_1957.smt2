; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe src=""http://example.com/"" style=""width:800px; height:350px; border:none; mask: url(#maskForClickjacking);""/>") (= x "<! foo=""[[[Inception]]""><x foo=""]foo><script>alert(1)</script>"">")))
(assert (or (= z "/em>") (= z ");") (= z "lor 1s"" ontransitionend=alert(1)></caption>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "alert(1)<")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^((?!hotmail|gmail|icloud|yahoo|outlook|live|yopmail|neuf).)*$"))) (not (= (str.len z) 43))))
(assert (str.prefixof "<! fo" x))
(assert (not (= (str.indexof y "load=" 0) 42)))
(assert (or (not (str.prefixof "<ifra" x)) (= (str.at y 8) "g")))
(assert (or (str.suffixof "/em>" y) (not (= ";" (str.substr z 1 3))) (>= (str.len x) 63)))
(check-sat)
