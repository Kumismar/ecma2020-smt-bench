; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><meter style=""animation-name:x"" onanimationend=""alert(1)""></meter>") (= x "<legend id=x tabindex=1 onfocusin=alert(1)></legend>") (= x "<ins id=x tabindex=1 onbeforeactivate=a\u{20000}lert(1)></in\u{1f4a9}s>")))
(assert (or (= z "t</li>") (= z "(1)"">test</strike>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "bef" "alert(1)") "=1 onalert(1)orea")) (= "ert(St" (str.substr x 28 6)) (not (<= (str.len x) 51))))
(assert (or (<= (str.len y) 71) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-z\u{e4}\u{f6}\u{fc}A-Z\u{c4}\u{d6}\u{dc}\u{df}0-9\-\.]{0,70})$"))) (not (= (str.indexof y "o" 0) 9))))
(assert (str.contains z "1)"">te"))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9]*[1-9][0-9]*$")) (not (str.suffixof "legend>" z))))
(assert (or (not (str.suffixof "/li>" z)) (not (= "yle=""ani" (str.substr y 38 8)))))
(check-sat)
