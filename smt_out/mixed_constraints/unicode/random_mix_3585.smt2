; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<label dataformatas=""html"" datasrc=""#xss"" datafld=""payload""></label>//[""'`-->]]>]</div>") (= x "<datalist draggable=""true"" ondragend=""alert(1)"">test</datalist>")))
(assert (or (= z "\""&gt;") (= z "uee><h1>XSS</h1></marquee>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "es" (str.substr z 21 2))) (str.prefixof "<label" x) (not (= "t(1)"">t" (str.substr y 42 7)))))
(assert (or (str.contains z "\""&gt;") (not (str.contains x """tr")) (= (str.indexof x "itab" 0) 31)))
(assert (or (= (str.indexof z "XSS<" 0) 8) (>= (str.len z) 23)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{6,25}$"))) (>= (str.len y) 64)))
(assert (= (str.indexof x "abel" 0) 2))
(check-sat)
