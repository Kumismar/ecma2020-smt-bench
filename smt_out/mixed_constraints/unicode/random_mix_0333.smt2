; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure onkeyup=""alert(1)"" contenteditable>test</figure>") (= x "<svg/onload=%26%23097lert%26lpar;1337)>") (= x "<IMG SRC=x onseeked=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "s>") (= z "/input>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "ad=al" 0) 19)) (>= (str.len z) 1)))
(assert (or (not (str.contains z "nend")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(.){4,}$")))))
(assert (or (not (= "3097" (str.substr y 17 4))) (str.in_re z ((_ re.from_regex ecma2020 u) "^[1][3,4,5,6,7,8,9][0-9]{9}$"))))
(assert (or (= (str.indexof x """" 0) 16) (str.suffixof "t>" y) (not (= "oad=%26%23" (str.substr x 8 10)))))
(check-sat)
