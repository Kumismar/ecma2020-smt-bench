; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;XSS STYLE="";xss:expression(alert(';XSS';))"";>;") (= x "<datalist draggable=""true"" ondragenter=""alert(1)"">test</datalist>")))
(assert (or (= z "tion:transform 2s"" ontransitionrun=alert(1)></frameset>") (= z ")</script\u{10348}>") (= z "bindex=1 id=x></abbr><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{5}$")) (str.suffixof "\u{10348}>" y) (= "t d" (str.substr x 8 3))))
(assert (= ")</scrjavascript:t\u{10348}>" (str.replace z "ip" "javascript:")))
(assert (str.contains y "t</"))
(assert (or (not (= (str.at x 21) "r")) (= (str.at z 2) "/") (not (= (str.indexof y "ata" 0) 2))))
(check-sat)
