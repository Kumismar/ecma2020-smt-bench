; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<center onmouseenter=""alert(1)"">te\u{1d400}st<\u{20000}/center>") (= x "<noscript onmousemove=""alert(1)"">test</noscript>") (= x "<textarea onmouseenter=""alert(1)"">test</textarea>")))
(assert (or (= z "</menuitem>") (= z "</div><footer ondrop=alert(1) contenteditable>drop here</footer>") (= z "itable>test</rt>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "><foo" 0) 5) (<= (str.len z) 70)))
(assert (not (= (str.at x 43) "r")))
(assert (not (str.contains z "est</rt>")))
(assert (or (str.contains z "e>tes") (= (str.indexof z "h" 0) 51)))
(assert (= "<rtc  forepaste=""alert(\u{1f600}1)"" contenteditable>test</rtc>" (str.replace x "onbe\u{10348}" " ")))
(assert (or (not (str.contains (str.replace z "tem" " ") "ui >")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{7,8}-[0-9Kk]{1}$"))) (not (= "<nos t onmousemove=""alert(1)"">test</noscript>" (str.replace x "crip" " ")))))
(assert (or (not (= "rt(1) co" (str.substr z 24 8))) (= (str.indexof x "anim" 0) 43)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "\.(pdf|doc|docx)$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([\w\+-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$")))))
(assert (= "ter>" (str.substr x 43 7)))
(check-sat)
