; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s draggable=""true"" ondragleave=""alert(1)"">test</s>") (= x "<output onbeforepaste=""alert(1)"" contenteditable>test</output>") (= x "<;? echo(';<;SCR)';;")))
(assert (or (= z "gress>") (= z "><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "<outx onbeforepaste=""alert(1)"" contenteditable>test</output>" (str.replace x "put" "x")) (= (str.at y 13) "S") (str.suffixof "s>" z)))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "[\d\-( )]+$")))
(assert (= "<ou""put onbeforepaste=""alert(1)"" contenteditable>test</output>><input autofocus>" (str.replace y "t" """")))
(assert (or (not (= (str.len x) 20)) (not (str.prefixof "<;? echo(" y)) (= "></textare" (str.substr y 89 10))))
(assert (= (str.at y 8) "("))
(assert (or (not (str.contains (str.replace x "t=""a" "javascript:") " oncujavascript:ler")) (not (str.contains z "put autof")) (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{8}|[0-9]{10}|(?=(([0-9]+[^0-9]+)|([a-zA-Z]+[^a-zA-Z]+)|([@._\-]+[^@._\-]+)))[a-zA-Z0-9.@_\-]{8,50}"))))
(assert (not (= (str.indexof y "put o" 0) 4)))
(check-sat)
