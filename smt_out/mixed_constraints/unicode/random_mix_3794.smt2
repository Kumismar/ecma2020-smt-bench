; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><em style=""animation-name:x"" onanimationstart=""alert(1)""></em>") (= x "<base onmouseup=""alert(1)"">test</base>")))
(assert (or (= z "alert(1)"">test</a>") (= z "dy>") (= z "<div style=""x:expression\x00(javascript:alert(1)"">DEF")))
(assert (= y (str.++ x z)))
(assert (or (not (= "e=""anima" (str.substr y 37 8))) (not (str.contains x "s x{"))))
(assert (or (not (= (str.at y 81) "r")) (str.suffixof "gt;" z)))
(assert (or (not (= "le=" (str.substr z 8 3))) (not (str.suffixof ">" z))))
(assert (or (= "dyx" (str.replace z ">" "x")) (= (str.len z) 29)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z0-9-_\.]{1,50}$")) (not (str.contains (str.replace y "i" "javascript:") "=""anjavascript:matio"))))
(assert (not (str.suffixof ">" y)))
(assert (str.prefixof "<" y))
(assert (or (not (= (str.indexof y "e o" 0) 4)) (not (<= (str.len y) 119))))
(check-sat)
