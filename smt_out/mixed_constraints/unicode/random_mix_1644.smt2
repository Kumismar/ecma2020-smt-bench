; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby onmouseover=""alert(1)"">test</ruby>") (= x "<applet onkeydown=""alert(1)"" cont\u{10348}enteditable>\u{10348}test</applet>")))
(assert (or (= z "rt(1) tabindex=1 id=x></hr><input autofocus>") (= z " ondrag=""alert(1)"">test</code>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "t" " ") "pple  onke") (not (= (str.indexof x "yd" 0) 12))))
(assert (or (str.prefixof " ondra" z) (= "<applet onkeydown=""alert(1)""alert(1)ont\u{10348}enteditable>\u{10348}test</applet>" (str.replace x " c" "alert(1)"))))
(assert (or (= (str.at x 21) "e") (str.suffixof "autofocus>" z) (not (str.prefixof " ondr" z))))
(assert (or (str.prefixof "<" y) (str.contains z "id=x></h") (= (str.at y 0) "<")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^((?=.*\d)(?=.*[a-zA-Z]).{8,})$"))) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-6]{2,5}$")))))
(assert (str.contains (str.replace x "ler" """") "a""t(1)"))
(assert (or (= (str.indexof z "=x>" 0) 19) (str.suffixof "/applet>" x)))
(check-sat)
