; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<button ondblclick=""alert(1)"">test</button>") (= x "&lt;IMG SRC=javascript:alert(&amp;quot;XSS&amp;quot;)&gt;")))
(assert (or (= z "SS</textarea>") (= z "e>drop here</noembed>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "(2018|2019|2020|2021|2022)"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{2}-\d{3}$"))))
(assert (or (= (str.indexof y "SRC=j" 0) 8) (= (str.at x 9) "R")))
(assert (= (str.indexof z "</tex" 0) 2))
(assert (or (not (str.suffixof """>" z)) (= (str.at z 4) "o")))
(assert (not (str.prefixof "<button o" x)))
(assert (or (not (str.contains y "e>drop h")) (not (str.prefixof "<bu" y))))
(assert (or (= (str.at x 31) "m") (not (str.prefixof "&lt;IMG " x))))
(assert (or (>= (str.len x) 55) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z\u{e4}\u{f6}\u{fc} .'-]+$")))))
(check-sat)
