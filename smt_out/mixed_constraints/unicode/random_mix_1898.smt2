; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><inpu\u{1d400}t id=x style=""transition:transform 2s"" ont\u{1d400}ransitionrun=alert(1)></input>") (= x "<div onmouseover='alert&lpar;1&rpar;'>DIV</div>") (= x "<title onmousemove=""alert(1)"">test</title>")))
(assert (or (= z "=""alert(1)"" contenteditable>test</meta>") (= z "ditable>drop here</source>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^Full name$")))
(assert (or (= "alert(1)" (str.replace z ">" "alert(1)")) (= "ble>d" (str.substr y 46 5))))
(assert (not (= "<dimouseover='alert&lpar;1&rpar;'>DIV</div>" (str.replace x "v on" ""))))
(assert (or (>= (str.len y) 72) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{e2}\u{20ac}\u{2122}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+\.[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")) (not (= "yle" (str.substr x 66 3)))))
(assert (= "ver='alert" (str.substr y 13 10)))
(check-sat)
