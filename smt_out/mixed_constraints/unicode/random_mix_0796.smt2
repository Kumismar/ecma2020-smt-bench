; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg id=x tabindex=1 onbeforedeactivate=alert(1)></svg><input autofocus>") (= x "<script onLoad script onLoad=""javascript:javascript:alert(1)""></script onLoad>")))
(assert (or (= z "ut id=y autofocus>") (= z "dio src=1 onerror=alert(1)>") (= z "play onplaying=alert(1)><source src=""validaudio.wav"" type=""audio/wav""></audio>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<dir on" x)) (not (>= (str.len z) 72)) (not (= (str.indexof x "oad>" 0) 74))))
(assert (or (not (str.contains y "><source")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9A-Za-z_\-]+$"))) (not (str.prefixof "dio" z))))
(assert (or (= (str.indexof z "r" 0) 5) (str.prefixof "<script " x)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^http[s]{0,1}://[^/].*"))) (str.suffixof "alert(1)>" z)))
(check-sat)
