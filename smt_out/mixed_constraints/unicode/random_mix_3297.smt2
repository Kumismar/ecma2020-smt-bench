; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer ondblclick=""alert(1)"">test</footer>") (= x "&lt;SCRIPT SRC=http://ha.ckers.org/xss.js")))
(assert (or (= z "gable=""true"" ondrag=""alert(1)"">test</ol>") (= z "/STYLE>") (= z "access=always>?")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace x "ss.js" "") "x")))
(assert (= "ter on" (str.substr x 4 6)))
(assert (or (not (str.prefixof "&lt;S" x)) (not (str.prefixof "/S" z))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[\+\d\d\d\d\d\d\d\d\d\d\d]+"))))
(assert (or (= "access=<b>s>?" (str.replace z "alway" "<b>")) (= (str.len y) 50)))
(assert (not (str.prefixof "<foote" y)))
(assert (not (str.contains z "=alway")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9]{6})-([0-9]{2})-([0-9]{4})$"))))
(assert (or (<= (str.len y) 59) (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9()+-\/ ]*$"))))
(check-sat)
