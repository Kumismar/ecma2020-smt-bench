; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "`""'><img src=x\u{10348}xx:x onerror\x09=javascript:alert(1)>") (= x "<div onblur=alert(1) tabindex=1 id=x></div><input autofocus>") (= x "XSS/*-*/STYLE=xss:e/**/xpression(alert('XSS'))>")))
(assert (or (= z "><input autofocus>") (= z "0`&NewLine; onerror=alert(1)&NewLine;")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "di" 0) 1)) (= (str.indexof y "main " 0) 1) (not (str.contains y "vascrip"))))
(assert (= (str.at z 8) "a"))
(assert (str.suffixof "focus>" y))
(assert (str.prefixof "<" y))
(assert (= "1)" (str.substr x 18 2)))
(assert (not (= (str.at x 53) "o")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9-]{4}"))))
(assert (or (str.prefixof "<styl" y) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^1[3|5|7|8][0-9]{9}$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z\u{e1}-\u{fa} ]+")))))
(assert (= (str.indexof z "ocus>" 0) 13))
(assert (str.prefixof "0`&" z))
(check-sat)
