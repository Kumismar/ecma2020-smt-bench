; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nobr id=x tabindex=1 onbeforedeactivate=alert(1)></nobr><input autofocus>") (= x "<keygen onmousedown=""alert(1)"">test</keygen>")))
(assert (or (= z "rror=javascript:alert(1)>") (= z "e"" contenteditable>drag me</div><button ondrop=alert(1) contenteditable>drop here</button>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 14) "a") (not (= "=javascri" (str.substr z 4 9)))))
(assert (not (>= (str.len y) 67)))
(assert (= "op h" (str.substr z 74 4)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]{1,64}@[a-zA-Z0-9-]{1,64}[\.][a-zA-z]{2,}[\.]{0,1}[a-zA-z]{0,}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[^,<>?+=@!#$%^&*()0-9\s]{2,30}"))))
(assert (or (not (= "rrovascript:alert(1)>" (str.replace z "r=ja" ""))) (str.prefixof "<map o" x)))
(assert (or (= (str.indexof x """al" 0) 20) (str.contains y "1)></comma")))
(assert (not (str.prefixof "<keyg" x)))
(assert (not (= (str.len x) 36)))
(check-sat)
