; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption ondblclick=""alert(1)"">test</caption>") (= x "<style>@keyframes x{}</style><kbd style=""animation-name:x"" onanimationend=""alert(1)""></kbd>")))
(assert (or (= z "ert(1)"">'onload=""`<svg\u{1f600}/1='") (= z "true"" ondrag=""alert(1)"">test</noscript>") (= z "tenteditable>test</image>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([+ 0-9]){3,}$"))) (str.contains x "al")))
(assert (not (str.prefixof "r>" z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]{7}$"))))
(assert (or (not (= (str.at x 13) "e")) (= "lick" (str.substr x 15 4))))
(assert (= (str.indexof z ">te" 0) 22))
(assert (or (not (str.suffixof "`<svg\u{1f600}/1='" y)) (not (= (str.indexof y "odi" 0) 25)) (not (= "nd=" (str.substr x 71 3)))))
(check-sat)
