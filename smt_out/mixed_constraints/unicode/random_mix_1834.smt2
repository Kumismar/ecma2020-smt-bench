; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title oncontextmenu=""alert(1)"">test</title>") (= x "<bdo onbeforecut=""alert(1)"" contenteditable>test</bdo>")))
(assert (or (= z """alert(1)"">test</span>") (= z "table>test</frame>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x """" "<b>") "=<b>aler") (not (= "o onbefor" (str.substr x 3 9)))))
(assert (= "pa" (str.substr z 18 2)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(\s*)?(\+)?([- _():=+\/]?\d[- _():=+]?){4,20}(\s*)?$"))) (not (<= (str.len y) 72))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}"))) (not (str.contains x "tmenu=""a"))))
(assert (str.prefixof "seup=""ale" z))
(assert (or (str.contains (str.replace z "e" "javascript:") "ljavascript:r") (str.contains x "test<") (not (= "table>testalert(1)/frame>" (str.replace z "<" "alert(1)")))))
(assert (not (str.contains y "ditable>t")))
(check-sat)
