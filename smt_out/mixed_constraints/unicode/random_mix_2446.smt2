; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid onclick=""alert(1)"">test</nextid>") (= x "'><SCRIPT>alert(String.fromCharCode(88,83,83))</SCRIPT><img src="""" alt='")))
(assert (or (= z "sition:color 1s"" ontransitionend=alert(1)></basefont>") (= z "ditable>test</form>") (= z "9javascript:alert(1)\x09src=xxx:x />")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "ansi" 0) 93)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.{6,}).*"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^<>\\/]+$"))) (str.contains y " ontrans")))
(assert (or (not (str.suffixof ">" z)) (not (str.contains x "x style=""t"))))
(assert (or (not (<= (str.len y) 115)) (not (= (str.len x) 40))))
(assert (not (str.suffixof " alt='" x)))
(assert (not (<= (str.len x) 59)))
(assert (str.suffixof "=xxx:x />" y))
(assert (or (not (= (str.at x 10) "c")) (str.contains x "ommand")))
(check-sat)
