; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex onmouseup=""alert(1)"">test</isindex>") (= x "<picture onblur=alert(1) tabindex=1 id=x></picture><input autofocus>")))
(assert (or (= z "r:red;}</style><strong id=x style=""transition:color 1s"" ontransitionend=alert(1)></strong>") (= z "nstart=""alert(1)""></datalist>") (= z "draggable=""true"" ondragenter=""alert(1)"">test</time>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "rue"" " "x") "le=""txon")) (not (= "lert(1" (str.substr y 75 6))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z0-9@-_\.]{5,320}$")))))
(assert (= (str.at z 21) "a"))
(assert (not (<= (str.len x) 44)))
(assert (or (= " id>" (str.replace z "t" " ")) (not (str.suffixof "</strong>" z)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,7}$")))))
(assert (not (str.prefixof "<isindex" y)))
(check-sat)
