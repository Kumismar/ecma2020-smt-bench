; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<<script>document.vulnerable=true;</script>") (= x "<style>@keyframes x{}</style><title style=""animation-name:x"" onanimationstart=""alert(1)""></title>") (= x "<div draggable=""true"" contenteditable>drag me</div><hgroup ondragover=alert(1) contenteditable>drop here</hgroup>")))
(assert (or (= z "x"" onanimationend=""alert(1)""></meta>") (= z "le>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "l" z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "\d\d\/\d\d\/\d\d\d\d \d\d:\d\d")) (not (>= (str.len y) 92)) (= "aler" (str.substr x 22 4))))
(assert (not (= (str.indexof y "g onl" 0) 24)))
(assert (or (not (str.suffixof "e>" z)) (not (= (str.indexof x " onpa" 0) 3)) (not (= "y" (str.substr x 3 1)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]2-?[0-9]3$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^[A-Za-z]{2}[0-9]{2}\s?[A-Za-z]{3}$)|(^[A-Za-z][0-9]{1,3}[A-Za-z]{3}$)|(^[A-Za-z]{3}[0-9]{1,3}[A-Za-z]$)|(^[0-9]{1,4}[A-Za-z]{1,2}$)|(^[0-9]{1,3}[A-Z]{1,3}$)|(^[A-Z]{1,2}[0-9]{1,4}$)|(^[A-Za-z]{1,3}[0-9]{1,3}$)|(^[A-Za-z]{1,3}[0-9]{1,4}$)|(^[0-9]{3}[DX]{1}[0-9]{3}$)")))))
(check-sat)
