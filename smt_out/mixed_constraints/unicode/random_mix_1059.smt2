; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><b ondragover=alert(1) contenteditable>drop here</b>") (= x "<element draggable=""true"" ondragleave=""alert(1)"">test</element>") (= x "<i id=x tabindex=1 onbeforeactivate=alert(1)></i>")))
(assert (or (= z "g src=x onerror=javascript:alert(""1"")>") (= z "x"">x</div>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "te=" 0) 13)) (not (str.prefixof "<i id=" y)) (str.contains (str.replace x "conte" "") "ue"" ntedi")))
(assert (or (not (= (str.at z 28) "l")) (not (= """>x<" (str.substr z 1 4))) (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z .]+$"))))
(assert (or (not (str.suffixof "</i>" x)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d).{2}/(?=.*\d).{2}")))))
(assert (= ">" (str.substr z 3 10)))
(check-sat)
