; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><br id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></br>") (= x "<bdi onkeydown=""alert(1)"" contenteditable>test</bdi>")))
(assert (or (= z "tid>") (= z "ondragleave=""alert(1)"">test</script>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "fo" "x") "nsxr") (str.prefixof "ondragleav" z)))
(assert (or (= (str.indexof z "d" 0) 2) (not (= (str.at z 26) "t")) (not (>= (str.len y) 121))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{1,3}$"))) (not (str.prefixof "ondr" z)) (not (= "<bdi onke<b>down=""alert(1)"" contenteditable>test</bdi>" (str.replace x "y" "<b>")))))
(assert (or (str.contains z "ragleave=") (= "ave" (str.substr z 8 3))))
(assert (or (not (<= (str.len y) 85)) (not (= (str.at y 43) "e"))))
(assert (or (not (= "a" (str.substr x 33 1))) (not (= """" (str.substr x 66 1))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([_A-z0-9]){2,}$")))))
(check-sat)
