; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onmouseleave=""alert(1)"">test</rtc>") (= x "<body onbeforepaste=""alert(1)"" contenteditable>test</body>")))
(assert (or (= z "=""javascript:alert(1)"">") (= z "gt;XSS&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (str.contains z "&lt;/A"))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Z0-9]{0,12}$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{1,4}$"))) (not (str.contains (str.replace y "e" "<b>") "lab<b>l o"))))
(assert (or (str.suffixof ">" x) (not (str.in_re x ((_ re.from_regex ecma2020 u) "(?=.*[a-z])[a-z0-9].{8,255}")))))
(assert (or (= (str.at z 7) "c") (str.contains z "SS&")))
(assert (or (= (str.indexof z "ri" 0) 8) (str.suffixof "lert(1)"">" z) (= (str.indexof x "te" 0) 17)))
(check-sat)
