; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG SRC=&quot;jav&amp;#x0D;ascript:alert(&apos;XSS&apos;);&quot;&gt;") (= x "<listing draggable=""true"" ondragleave=""alert(1)"">test</listing>") (= x "<html onkeypress=""alert(1)"" contenteditable>test</html>")))
(assert (or (= z "pt* */alert(1)</script") (= z "(1) tabindex=1 id=x></pre><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "cript" (str.substr y 72 6)) (not (= (str.len x) 63)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z]+(?:[\s-][a-zA-Z]+)*$")))))
(assert (or (str.contains x ";as") (not (= "<source onblur<b>alert(1) tabindex=1 id=x></source><input autofocus>" (str.replace x "=" "<b>")))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^(1?(-?\d{3})-?)?(\d{3})(-?\d{4})$")))
(assert (not (= (str.indexof z "x></p" 0) 18)))
(assert (or (not (= (str.indexof x "c" 0) 28)) (= "<listing draggablx=""true"" ondragleave=""alert(1)"">test</listing>pt* */alert(1)</script" (str.replace y "e" "x")) (not (str.contains (str.replace y "><dfn" "x") "stylex styl"))))
(assert (not (= "t(1)""><" (str.substr y 81 7))))
(check-sat)
