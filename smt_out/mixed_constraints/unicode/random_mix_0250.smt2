; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blink id=x tabindex=1 onbeforedeactivate=alert(1)></blink><input autofocus>") (= x "<canvas onbeforecut=""alert(1)"" contenteditable>test</canvas>") (= x "<optgroup id=x tabindex=1 onbeforeactivate=alert(1)></optgroup>")))
(assert (or (= z "arquee oncontextmenu=""alert(1)"">test</marquee>") (= z "quot;&gt;&lt;/SCRIPT&gt;") (= z "avascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 87) (str.contains (str.replace y "al" "alert(1)") "in=alert(1)ert")))
(assert (not (= "avascript:javascript:alert(1)"" id=""fuzzelement1""st</a>" (str.replace z """>te" """"))))
(assert (= "ndex=1" (str.substr x 16 6)))
(assert (not (= (str.len x) 60)))
(assert (or (not (str.contains x "focus")) (= (str.indexof z "t" 0) 3) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^1[3456789][0-9]{9}$")))))
(assert (or (not (= (str.at z 8) "t")) (not (str.contains (str.replace z "o" "<b>") "uee <b>nc"))))
(assert (or (= (str.indexof z "t:al" 0) 19) (str.in_re y ((_ re.from_regex ecma2020 u) "^(10)$"))))
(check-sat)
