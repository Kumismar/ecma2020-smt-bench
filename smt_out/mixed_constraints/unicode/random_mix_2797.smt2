; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onkeypress=""alert(1)"" contenteditable>test</iframe>") (= x "<thead id=x tabindex=1 onfocusin=alert(1)></thead>")))
(assert (or (= z "039; &gt; out") (= z "ontenteditable>test</figure>") (= z "ggable=""true"" ondrag=""alert(1)"">test</iframe>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 53) "f")) (= (str.len z) 13) (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z. ']*$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\+?\d{10,12}$"))) (not (str.prefixof "<thead " y)) (= (str.at y 63) " ")))
(assert (or (not (str.suffixof "frame>" x)) (not (>= (str.len z) 33)) (= (str.len y) 63)))
(assert (or (not (= (str.at y 36) "<")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{5c}u00C0-\u{5c}u00FF- ]*$")))))
(assert (or (not (str.contains y "nten")) (str.prefixof "gga" z)))
(check-sat)
