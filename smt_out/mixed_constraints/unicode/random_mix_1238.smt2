; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input oninput=alert(1) value=xss>") (= x "<aside oncopy=""alert(1)"" contenteditable>test</aside>")))
(assert (or (= z "caption>") (= z "ter>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "ter>" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\d+(?:\.\d{0,2})$"))) (= (str.at y 42) ")")))
(assert (or (= (str.indexof x "ale" 0) 15) (str.contains (str.replace y "<dd o" "javascript:") "/div>javascript:ndrop") (str.contains x " content")))
(assert (or (= "<div draggable=""true"" contenteditxdrag me</div><bdo ondrop=alert(1) contenteditable>drop here</bdo>" (str.replace x "able>" "x")) (str.prefixof "<" x) (not (str.contains (str.replace z "n>" "javascript:") "aptiojavascript:"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[-+.\w]{1,64}@[-.\w]{1,64}\.[-.\w]{2,6}$"))) (str.in_re x ((_ re.from_regex ecma2020 u) "^[\x00-\x7f]+@[\x00-\x7f]+$")) (not (str.prefixof "<input oni" x))))
(assert (not (= (str.indexof x "ten" 0) 28)))
(check-sat)
