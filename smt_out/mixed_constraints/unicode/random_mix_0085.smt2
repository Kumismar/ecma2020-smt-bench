; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "exp/*<A STYLE='no\xss:noxss(""*//*"");xss:&#101;x&#x2F;*XSS*//*/*/pr\u{1f4a9}ession(alert(""XSS""))'>") (= x "<summary oncopy=""alert(1)"" contenteditable>test</summary>") (= x "<noframes onblur=alert(1) tabindex=1 id=x></noframes><input autofocus>")))
(assert (or (= z "itionend=alert(1)></dd>") (= z "et onbeforecopy=""alert(1)"" contenteditable>test</applet>")))
(assert (= y (str.++ x z)))
(assert (or (= "<summary oncopy=""alerx(1)"" contenteditable>test</summary>et onbeforecopy=""alert(1)"" contenteditable>test</applet>" (str.replace y "t" "x")) (str.contains (str.replace y "s(""*/" "<b>") "xs<b>/*"");")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9][A-Z]{3}"))) (str.suffixof ")></dd>" z)))
(assert (or (str.prefixof "<summary" y) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^.{5}$"))) (str.suffixof "t</applet>" y)))
(assert (or (str.contains (str.replace z "t(1)" "<b>") """aler<b>"" c") (not (str.suffixof "XSS""))'>" x))))
(assert (= (str.len x) 89))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[_a-zA-Z0-9-\+]+(\.[_a-zA-Z0-9-]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9]+)*(\.[a-zA-Z]{2,})$")) (= (str.at z 4) "o")))
(check-sat)
