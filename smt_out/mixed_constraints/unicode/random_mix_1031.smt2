; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg onbeforecut=""alert(1)"" contenteditable>test</svg>") (= x "<listing ondblclick=""alert(1)"">test</listing>")))
(assert (or (= z "o controls autoplay onended=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= z "er=""alert(1)"">test</rtc>") (= z "r=""alert(1)"">test</input>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "eo.m")))
(assert (or (= (str.indexof y "8,83" 0) 50) (not (= "d=a" (str.substr z 26 3)))))
(assert (or (= (str.len x) 45) (= (str.at y 26) """") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[(A-Za-z  \u{e1}\u{e9}\u{ed}\u{f3}\u{fa}A\u{c9}\u{cd}\u{d3}\u{da}\u{d1}\u{f1})]{3,50}$")))))
(assert (or (not (= (str.indexof y "ente" 0) 32)) (not (= " ondblcl" (str.substr y 8 8)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(6[1-9])?[0-9]{6}$"))) (= (str.len x) 70)))
(assert (str.prefixof "%25" x))
(check-sat)
