; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=`%00`&NewLine; onerror=alert(1)&NewLine;") (= x "<cite id=x tabindex=1 onbeforeactivate=alert(1)></cite>") (= x "&lt;SCRIPT \""a='&gt;'\"" SRC=\""http&#58;//ha&#46;ckers&#46;org/xss&#46;js\""&gt;&lt;/SCRIPT&gt;")))
(assert (or (= z "onMouseWheel>") (= z "ground-image&#58;url(\""javascript&#058;alert('XSS')\"");}&lt;/STYLE&gt;&lt;A CLASS=XSS&gt;&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "onMouseWhe" z)) (not (= "=x></addrealert(1)nput autofocus>" (str.replace z "ss><i" "alert(1)"))) (not (= (str.at y 31) "t"))))
(assert (or (not (str.suffixof "SCRIPT&gt;" x)) (<= (str.len y) 160)))
(assert (not (= "ground-image58;url(\""javascript&#058;alert('XSS')\"");}&lt;/STYLE&gt;&lt;A CLASS=XSS&gt;&lt;/A&gt;" (str.replace z "&#" ""))))
(assert (or (not (str.suffixof "heel>" y)) (= (str.len x) 55) (not (str.contains x "C=\""http&"))))
(assert (not (str.prefixof "&lt;SCR" y)))
(assert (or (= (str.at z 12) ">") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\s*)?(\+)?([- _():=+]?\d[- _():=+]?){6,14}(\s*)?$"))) (str.contains z "}&lt;/")))
(check-sat)
