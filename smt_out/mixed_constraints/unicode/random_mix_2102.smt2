; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><hr ondrop=alert(1) contenteditable>drop here</hr>") (= x "<noembed id=x tabindex=1 onfocusin=alert(1)></noembed>") (= x "<svg><animate onbegin=alert(1) attributeName=x dur=1s>")))
(assert (or (= z "PT&gt;a=/XSS/") (= z "/data>") (= z "=""alert(1)"">test</thead>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&\u{2019}*+\/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")))
(assert (not (= (str.at x 45) "x")))
(assert (or (str.prefixof "<no" y) (not (= (str.at z 0) "/"))))
(assert (or (>= (str.len y) 76) (not (str.prefixof "PT&gt;" z))))
(assert (or (not (str.contains z ">tes")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9]*$"))) (= "ribute" (str.substr x 34 6))))
(assert (not (str.prefixof "<div d" y)))
(assert (or (= (str.len y) 78) (= (str.at y 2) "o")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[A-Za-z ]{5,60}"))))
(assert (or (not (str.contains x "in=")) (str.suffixof "data>" y)))
(check-sat)
