; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<!--#exec cmd=""/bin/echo '<SCR'""--><!--#exec cmd=""/bin/echo 'IPT SRC=http://www.securitycompass.com/xss.js></SCRIPT>'""-->") (= x "<bdi onmouseup=""alert(1)"">test</bdi>") (= x "<acronym id=x tabindex=1 onfocus=alert(1)></acronym>")))
(assert (or (= z "pt:alert(1)"">") (= z "form><input formaction=javascript:alert(1) type=image src=SOURCE>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len z) 21)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((?!nhs.uk)(?!nhs.org)(?!nhs.net).)*$"))) (not (str.contains (str.replace y """ja" "alert(1)") "r=alert(1)vas"))))
(assert (or (str.contains y "1)></b") (not (= (str.indexof x "/b" 0) 31))))
(assert (not (= (str.at x 2) "c")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\s]+"))))
(assert (= "pt<b>lert(1)"">" (str.replace z ":a" "<b>")))
(assert (not (= "!--#exec " (str.substr y 1 9))))
(assert (= (str.indexof y "bdi" 0) 1))
(check-sat)
