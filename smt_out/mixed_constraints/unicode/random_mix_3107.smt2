; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onblur=alert(1) tabind\u{1f4a9}ex=1 id=x></dfn><i\u{1f600}nput autofocus>") (= x "<span ondblclick=""alert(1)"">test</span>") (= x "<a href=""\xE2\x80\x81javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "yle><listing style=""animation-name:x"" onanimationstart=""alert(1)""></listing>") (= z "\x20onerror=javascript:alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 81) (= (str.indexof x "ja" 0) 21) (= (str.at z 12) "j")))
(assert (str.suffixof "test</dd>" x))
(assert (not (= "yle><listing style=""a tion-name:x"" onanimationstart=""alert(1)""></listing>" (str.replace z "nima" " "))))
(assert (str.suffixof "us>" x))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*[a-z]).{1,}")) (not (str.suffixof "1)>" y))))
(assert (or (not (str.contains z "tart")) (str.contains (str.replace y "80" "") "x\")))
(assert (or (str.contains z "\x20onerr") (str.contains (str.replace z "er" """") ":al""t")))
(assert (= (str.indexof x "nb" 0) 20))
(assert (not (str.contains z "lert(1")))
(assert (= (str.indexof z "s" 0) 18))
(check-sat)
