; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""javascript\x0D:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<frameset onpageshow=alert(1)>") (= x "<animation xlink:href=""data:text/xml,%3Csvg xmlns='http://www.w3.org/2000/svg' onload='alert(88)'%3E%3C/svg%3E""/>")))
(assert (or (= z "<input id=y autofocus>") (= z "t</frame>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<IMG SRC=" y)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]{8,}$"))) (not (str.prefixof "<" x))))
(assert (or (not (= (str.indexof z "ame>" 0) 5)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-\u{139}\u{13e}0-9. _-]{5,}$"))) (not (= (str.at x 4) "m"))))
(assert (or (>= (str.len z) 6) (not (= "me>" (str.substr y 36 9)))))
(assert (or (= (str.at y 22) "D") (= (str.indexof x "np" 0) 11)))
(assert (or (not (str.contains x "fuzzelem")) (= "t /frame>" (str.replace z "<" " ")) (not (= (str.at z 0) "t"))))
(check-sat)
