; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot oncontextmenu=""alert(1)"">test</tfoot>") (= x "<time onpaste=""alert(1)"" contenteditable>test</time>") (= x "<thead onbeforecut=""alert(1)"" contenteditable>test</thead>")))
(assert (or (= z "lticol ondragover=alert(1) contenteditable>drop here</multicol>") (= z "test</style>") (= z "03c;")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "ticol>" y))
(assert (or (not (= (str.indexof x "ut" 0) 16)) (not (<= (str.len x) 62)) (not (= "/t" (str.substr y 73 2)))))
(assert (or (not (str.contains x "ert(1)""")) (not (str.suffixof "col>" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(([gG][iI][rR]{0,}0[aA]{2})|((([a-pr-uwyzA-PR-UWYZ][a-hk-yA-HK-Y]?[0-9][0-9]?)|(([a-pr-uwyzA-PR-UWYZ][0-9][a-hjkstuwA-HJKSTUW])|([a-pr-uwyzA-PR-UWYZ][a-hk-yA-HK-Y][0-9][abehmnprv-yABEHMNPRV-Y]))) {0,}[0-9][abd-hjlnp-uw-zABD-HJLNP-UW-Z]{2}))$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\d{1,5})?$"))) (not (= (str.indexof y "</t" 0) 36))))
(assert (or (str.contains y """>test</tf") (not (= " onpa" (str.substr x 5 5))) (not (= (str.indexof z "<" 0) 4))))
(assert (or (<= (str.len y) 67) (str.prefixof "test</s" z)))
(check-sat)
