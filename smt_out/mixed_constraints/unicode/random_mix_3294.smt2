; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var onmouseup=""alert(1)"">test</var>") (= x "<link onkeyup=""alert(1)"" contenteditable>test</link>") (= x "<input onkeypress=""alert(1)"" contenteditable>test</input>")))
(assert (or (= z ")>") (= z "['al\x65rt'](1)")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<v" y) (str.suffixof "</link>)>" y) (not (= "<link onkeyup=""alert(1)"" cont<b>teditable>test</link>" (str.replace x "en" "<b>")))))
(assert (or (= (str.at z 1) ">") (not (= (str.len y) 59))))
(assert (or (= "(1)" (str.substr z 12 5)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([0-9]{5}|\s*)$")))))
(assert (= (str.at y 25) "c"))
(check-sat)
