; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas onclick=""alert(1)"">test</canvas>") (= x "<datalist draggable=""true"" ondragend=""alert(1)"">test</datalist>")))
(assert (or (= z "ert(1)"">test</bdo>") (= z "ript:javascript:alert(1)""><source>") (= z "ate=alert(1)></r\u{1d400}t><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "a" 0) 1)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[A-Z])(?=.*[0-9])(?=.*[a-z]).{8,40}$"))) (= "ag" (str.substr y 31 2))))
(assert (or (not (= "<canvas onclick=""alert(1)"">tesxnvas>" (str.replace x "t</ca" "x"))) (= "st<" (str.substr y 33 3))))
(assert (not (str.contains y "ofocu")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^([ \u{5c}u00c0-\u{5c}u01ffa-zA-Z'\-]){5,50}$")))
(assert (or (= (str.at x 26) ">") (not (str.prefixof "<source on" y)) (str.contains (str.replace x "=""" """") "lick""al")))
(assert (or (str.prefixof "<" x) (not (str.suffixof "ption>" x))))
(check-sat)
