; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><applet onload=alert(1)></applet>") (= x "<div draggable=""true"" contenteditable>drag me</div><svg ondragover=alert(1) contenteditable>drop here</svg>")))
(assert (or (= z ">") (= z "test</wbr>") (= z "ript>\x0Djavascript:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=^.{8,20}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$"))))
(assert (or (str.contains x "vg><") (not (= "test</wbr" (str.substr z 0 9)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(([^<>()[\]\\.,;:\s@\u{5c}u0022]+(\.[^<>()[\]\\.,;:\s@\u{5c}u0022]+)*)|(\u{5c}u0022.+\u{5c}u0022))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$"))) (= "rt(1)></ap" (str.substr x 23 10)) (<= (str.len x) 115)))
(assert (= (str.at y 57) "1"))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^11$")) (not (str.prefixof "<div d" x)) (= " htm" (str.substr z 10 4))))
(check-sat)
