; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture onkeydown=""alert(1)"" contenteditable>test</picture>") (= x "<div/style=""width:expression(confirm(1))"">X</div> {IE7}") (= x "<noembed onbeforecut=""alert(1)"" contenteditable>test</noembed>")))
(assert (or (= z "le>test</caption>") (= z "utput id=x tabindex=1 onactivate=alert(1)></output>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<div/styl" y) (= "(conf" (str.substr x 28 5))))
(assert (or (not (= (str.indexof x "e" 0) 7)) (not (= (str.indexof x "lert(" 0) 21))))
(assert (or (not (= "div" (str.substr y 1 3))) (not (= "capti" (str.substr z 9 5)))))
(assert (or (not (>= (str.len z) 15)) (not (str.contains (str.replace y "tur" "javascript:") "<picjavascript:e onk"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[$@!%*#?&^()]).{6,20}"))))
(check-sat)
