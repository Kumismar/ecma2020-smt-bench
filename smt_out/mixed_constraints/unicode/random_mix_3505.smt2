; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option onkeyup=""alert(1)"" contenteditable>test</option>") (= x "<rtc draggable=""true"" ondrag=""alert(1)"">test</rtc>") (= x "&lt;IMG SRC=`javascript:alert(&quot;RSnake says, &apos;XSS&apos;&quot;)`&gt;")))
(assert (or (= z "/www.thesiteyouareon.com/somecommand.php?somevariables=maliciouscode&quot;&gt;") (= z " to=""//example.com/?c"" />")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "tc " 0) 2) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}\u{104}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b} ]*$"))) (str.in_re x ((_ re.from_regex ecma2020 u) "^(([X-Z]{1})(\d{7})([A-Z]{1}))|((\d{8})([A-Z]{1}))|(([A-Z]{1})(\d{8}))$"))))
(assert (or (str.suffixof "uot;&gt;" z) (not (str.contains (str.replace y "l" """") "up=""a""e"))))
(assert (or (not (= ")></i" (str.substr y 56 5))) (not (<= (str.len y) 74))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\-]{10,20}$"))) (>= (str.len y) 123)))
(assert (not (= (str.at y 69) "a")))
(assert (or (not (= (str.len x) 50)) (= "<rtc draggable=""true"" ondrag=""alert(1)""javascript:test</rtc> to=""//example.com/?c"" />" (str.replace y ">" "javascript:"))))
(check-sat)
