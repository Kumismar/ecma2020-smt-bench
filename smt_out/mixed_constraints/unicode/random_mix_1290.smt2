; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><spacer id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></spacer>") (= x "<bgsound onmouseup=""alert(1)"">test</bgsound>")))
(assert (or (= z "=x></a><input autofocus>") (= z ">test</head>")))
(assert (= y (str.++ x z)))
(assert (not (= "et {" (str.substr x 12 4))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9A-Za-z\u{c0}-\u{d6}\u{d8}-\u{f6}\u{f8}-\u{ff}\s/-/./_']{1,}"))))
(assert (or (>= (str.len z) 14) (not (str.contains y "sound "))))
(assert (or (= "<bgsound onmouseup=""alert(1)"">test</bgsound>=x></a><input a""cus>" (str.replace y "utofo" """")) (not (str.prefixof ">" z)) (str.contains (str.replace x "o" """") "s""u")))
(assert (or (not (= "v draggab" (str.substr x 3 9))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?:\+?1\s*(?:[.-]\s*)?)?(?:\(\s*([2-9]1[02-9]|[2-9][02-8]1|[2-9][02-8][02-9])\s*\)|([2-9]1[02-9]|[2-9][02-8]1|[2-9][02-8][02-9]))\s*(?:[.-]\s*)?([2-9]1[02-9]|[2-9][02-9]1|[2-9][02-9]{2})\s*(?:[.-]\s*)?([0-9]{4})(?:\s*(?:#|x\.?|ext\.?|extension)\s*(\d+))?$")))))
(assert (or (not (= (str.len x) 44)) (str.contains x "=x style=")))
(check-sat)
