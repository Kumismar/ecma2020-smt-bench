; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp onpaste=""alert(1)"" contenteditable>test</samp>") (= x "<multicol onbeforecopy=""alert(1)"" contenteditable>test</multicol>") (= x "<menu onmouseout=""alert(1)"">test</menu>")))
(assert (or (= z " id=x></xmp><input autofocus>") (= z "ert(1)"">test</svg>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "1)"">" "x") "rt(xt")) (not (= (str.indexof x "alert" 0) 15))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "\d{4}[\-]\d{7}")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{c0}-\u{ff}' \-]+$"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "\(\d\d\d\) \d\d\d-\d\d\d\d$")))))
(assert (or (str.contains z "x></xmp>") (not (= "eo>" (str.substr y 142 8)))))
(assert (<= (str.len x) 68))
(check-sat)
