; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;iframe src=http&#58;//ha&#46;ckers&#46;org/scriptlet&#46;html&gt;") (= x "<optgroup oncut=""alert(1)"" contenteditable>test</optgroup>") (= x "<object draggable=""true"" ondragstart=""alert(1)"">test</object>")))
(assert (or (= z "ave=""alert(1)"">test</colgroup>") (= z "t(1)"">test</center>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "test<" 0) 48))
(assert (not (= """>tes" (str.substr z 4 5))))
(assert (or (= "ert" (str.substr z 7 3)) (not (= "<IMG""=x ondragenter=""alert(String.fromCharCode(88,83,83))"">" (str.replace x " SRC" """")))))
(assert (or (str.suffixof "object>" x) (not (= (str.len z) 30))))
(assert (or (= (str.len y) 88) (not (str.in_re y ((_ re.from_regex ecma2020 u) "[\u{5c}u30A1-\u{5c}u30F6\s]*"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^!@#$^&%*()+=[\]\/{}|:<>?,.\t]+$")))))
(assert (not (= (str.at y 33) "a")))
(check-sat)
