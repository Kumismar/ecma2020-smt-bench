; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><hr id=x style=""transition:color 1s"" ontransitionend=ale\u{10348}rt(1)></hr>") (= x "<ins onclick=""alert(1)"">test</ins>")))
(assert (or (= z "ove=""alert(1)"">test</embed>") (= z "alert(1)"" contenteditable>test</blink>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")) (str.in_re y ((_ re.from_regex ecma2020 u) "^[_A-z0-9@$_.#*]{1,}$")) (str.suffixof "s>" x)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Z|a-z|\s-]{1,20}"))))
(assert (not (= (str.at x 32) "s")))
(assert (= (str.at y 32) "l"))
(assert (not (= (str.indexof y "ve=""a" 0) 104)))
(assert (= "src=""v" (str.substr y 34 6)))
(assert (or (= ">test</bl" (str.substr z 25 9)) (str.contains (str.replace y "cli" "javascript:") "njavascript:ck=")))
(assert (or (not (= "sition:col" (str.substr x 55 10))) (not (str.prefixof "<" x))))
(assert (str.contains (str.replace y ">t" "<b>") ")""<b>e"))
(check-sat)
