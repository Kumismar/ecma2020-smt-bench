; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onmouseout=""alert(1)"">test</iframe>") (= x "<marquee onkeypress=""alert(1)"" contenteditable>test</marquee>")))
(assert (or (= z "editable>drop here</u>") (= z "table>test</rp>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "for" 0) 143)))
(assert (or (str.prefixof "<marquee o" y) (str.suffixof "/video>" z)))
(assert (or (= (str.at x 11) "k") (str.prefixof "<iframe " x) (str.contains x "ouseo")))
(assert (not (= (str.indexof y "/u" 0) 80)))
(assert (or (not (= "<ifralert(1)me onmouseout=""alert(1)"">test</iframe>editable>drop here</u>" (str.replace y "a" "alert(1)"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9]+((-|\.|\s)*[_A-z]*(\.)*)*$")))))
(check-sat)
