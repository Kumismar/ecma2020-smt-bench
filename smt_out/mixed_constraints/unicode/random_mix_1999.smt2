; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><dl \u{10348}style=""animation-name:x"" onanimationstart=""alert(\u{1f4a9}1)""></dl>") (= x "<ul draggable=""true"" ondrag=""alert(1)"">test</ul>")))
(assert (or (= z "rm: rotate(180deg);}</style><time id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></time>") (= z " oncut=""alert(1)"" contenteditable>test</noembed>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?:(?:https?|ftp)://)?(?:(?:(?:[A-Za-z\u{5c}u00a1-\u{5c}uffff0-9]-*)*[a-z\u{5c}u00a1-\u{5c}uffff0-9]+)(?:\.(?:[A-Za-z\u{5c}u00a1-\u{5c}uffff0-9]-*)*[a-z\u{5c}u00a1-\u{5c}uffff0-9]+)*(?:\.(?:[A-Za-z\u{5c}u00a1-\u{5c}uffff]{2,})))(?::\d{2,5})?(?:/?\S*)?"))))
(assert (str.contains y "ul draggab"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d*[.]?\d*$"))) (<= (str.len x) 98)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9._-]+$")) (str.contains z "oncut=""")))
(assert (or (= (str.indexof x "st" 0) 41) (not (= (str.indexof z "tr" 0) 46)) (str.contains z ">")))
(assert (or (not (= "<style>@keyframes x{} tyle><dl \u{10348}style=""animation-name:x"" onanimationstart=""alert(\u{1f4a9}1)""></dl>>" (str.replace y "</s" " "))) (not (= (str.at z 0) ">"))))
(check-sat)
