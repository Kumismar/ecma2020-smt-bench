; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image oncopy=""alert(1)"" contenteditable>test</image>") (= x "<bgsound onkeypress=""alert(1)"" contenteditable>test</bgsound>") (= x "<option draggable=""true"" ondragstart=""alert(1)"">test</option>")))
(assert (or (= z "ancel=alert(1)></title>") (= z "put draggable=""true"" ondragend=""alert(1)"">test</output>") (= z "rt(1)"" contenteditable>test</em>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<button onpast""=""alert(1)"" contenteditable>test</button>rt(1)"">test</cite>" (str.replace y "e" """"))) (= (str.indexof z "rue" 0) 16)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^[^\s]+.*$")) (= "t(" (str.substr y 25 2))))
(assert (or (str.contains (str.replace y "gabl" "") "age") (<= (str.len x) 61)))
(assert (= " draggab" (str.substr z 3 8)))
(assert (or (not (str.contains z "st</co")) (not (str.contains z "></ti"))))
(assert (not (= (str.indexof z "dit" 0) 15)))
(assert (or (not (str.suffixof "tle>" y)) (str.suffixof "t</em>" y) (not (= "e>test</em" (str.substr z 21 10)))))
(check-sat)
