; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<set attributeName=""xlink:href"" begin=""accessKey(a)"" to=""//example.com/?a"" />") (= x "<mark id=x tabindex=1 ondeactivate=alert(1)></mark><input id=y autofocus>")))
(assert (or (= z "=""alert(1)"" contenteditable>test</picture>") (= z "script:alert('XSS')"">")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "SS')"">" y))
(assert (not (= (str.at z 19) """")))
(assert (or (not (<= (str.len x) 86)) (>= (str.len z) 13)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"))))
(assert (or (str.contains x "com/?a""") (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z][a-zA-Z0-9-_\.\s]{1,40}$"))) (= "abindex" (str.substr x 12 7))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\d{6,8}[-|(\s)]{0,1}\d{4}$"))) (not (str.prefixof "script:ale" z))))
(check-sat)
