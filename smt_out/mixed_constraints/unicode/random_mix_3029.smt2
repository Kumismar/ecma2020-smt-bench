; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas onmouseenter=""alert(1)"">test</canvas>") (= x "<textarea oninput=alert(1)>XSS</textarea>") (= x "<col onbeforecut=""alert(1)"" contenteditable>test</col>")))
(assert (or (= z "enteditable>test</small>") (= z "alert(1)"">test</noembed>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "aler" z) (not (= "l>" (str.substr z 22 6))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "([a-zA-Z]+)$")))))
(assert (or (= (str.indexof z "mbed" 0) 19) (not (str.contains z "ion:co")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[\d\s]+")))))
(assert (or (not (str.prefixof "ented" z)) (not (= ">test" (str.substr z 9 5))) (not (str.contains (str.replace y "test" """") "able>""</s"))))
(assert (or (not (= "enteditable>test<b>mall>" (str.replace z "</s" "<b>"))) (not (str.contains (str.replace z "t</sm" "javascript:") "sjavascript:all"))))
(assert (or (not (= (str.indexof z "edi" 0) 3)) (not (= "mall>" (str.substr z 19 10)))))
(assert (or (not (= (str.at y 55) "<")) (= (str.at x 18) "a")))
(check-sat)
