; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta onbeforecut=""alert(1)"" contenteditable>test</meta>") (= x "<ma\u{20000}p ondblclick=""alert(1)"">test</map>")))
(assert (or (= z "mousedown=""alert(1)"">test</input>") (= z "div id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></div>") (= z "ocation='javascript:alert(1)'"">")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<m" x) (= "ascript:" (str.substr z 12 8)) (not (= (str.at x 5) " "))))
(assert (or (not (= (str.indexof y "u" 0) 55)) (not (= "entedita" (str.substr x 33 8)))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "[a-zA-z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,4}$"))))
(assert (or (not (str.prefixof "moused" z)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\+33|0|0033)[12345679][1-9]\d{7}$")))))
(assert (or (= "s" (str.substr z 3 1)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")))))
(assert (or (not (= (str.at z 24) "t")) (>= (str.len z) 31)))
(assert (or (= (str.at x 31) "n") (str.contains z "t:aler")))
(check-sat)
