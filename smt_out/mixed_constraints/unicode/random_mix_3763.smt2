; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onbeforecut=""alert(1)"" contenteditable>test</rtc>") (= x "<param id=x tabindex=1 onbeforeactivate=alert(1)></param>") (= x "XSS STYLE=xss:e/**/xpression(alert('XSS'))>")))
(assert (or (= z " rotate(180deg);}</style><td id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></td>") (= z "vate=alert(1)></kbd><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "as>" y) (not (str.prefixof "<x%0C" x)) (not (= (str.at z 0) "("))))
(assert (or (str.contains x "SS STYL") (>= (str.len y) 135) (str.suffixof ">" x)))
(assert (or (str.contains (str.replace x "1)>" "<b>") "ert(<b></par") (not (str.suffixof "></td>" z)) (= (str.at x 4) " ")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^.{1,8}$")))
(assert (<= (str.len y) 67))
(check-sat)
