; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link onfocus=alert(1) id=x tabindex=1 style=display:block>") (= x "<slot onmousedown=""alert(1)"">test</slot>")))
(assert (or (= z "rt(';XSS';)}"";>;") (= z ">test</rt>") (= z "=1 ondeactivate=alert(1)></ruby><input id\u{1f600}=y\u{20000} autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<link o" x))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[\w]{6,32}$"))))
(assert (or (not (str.prefixof "<iframe " x)) (str.contains (str.replace x ")" """") "1"""">te")))
(assert (str.prefixof "rt(';XS" z))
(assert (or (not (= (str.indexof x "mouse" 0) 8)) (= "=1 ondeactivate=alealert(1)(1)></ruby><input id\u{1f600}=y\u{20000} autofocus>" (str.replace z "rt" "alert(1)"))))
(assert (= ";" (str.substr z 15 6)))
(assert (str.contains (str.replace x ") " "alert(1)") "rt(1alert(1)id=x "))
(assert (not (= "';XSS';" (str.substr z 3 7))))
(assert (or (not (>= (str.len y) 96)) (not (= (str.indexof x "ays," 0) 36))))
(check-sat)
