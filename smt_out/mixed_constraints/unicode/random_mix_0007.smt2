; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb onmouseout=""alert(1)"">test</rb>") (= x "<! foo=""><script>alert(1)</script>"">") (= x "<hr onbeforecut=""alert(1)"" contenteditable>test</hr>")))
(assert (or (= z "rt(1)"" contenteditable>test</sup>") (= z "est</menuitem>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 20) "r")))
(assert (or (= (str.at z 4) "/") (str.suffixof "cript>" y) (str.suffixof "di>" x)))
(assert (not (= (str.len z) 14)))
(assert (not (= (str.at y 0) "<")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9]{10,12}$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[#$@!%&*?])[A-Za-z\d#$@!%&*?]{8,50}$"))))
(assert (or (str.suffixof "m>" y) (not (= (str.indexof y "s" 0) 10)) (not (= (str.indexof y "vasc" 0) 16))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[0]{1}[1-9]{1}[0-9]{7,10}")) (str.prefixof "rt(1" z)))
(assert (not (<= (str.len x) 53)))
(check-sat)
