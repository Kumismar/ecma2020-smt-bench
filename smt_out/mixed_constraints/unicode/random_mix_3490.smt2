; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section onfocusout=alert(1) tabindex=1 id=x></section><input autofocus>") (= x "<var id=x tabindex=1 onactivate=alert(1)></var>")))
(assert (or (= z ">lose focus!") (= z "nend=""alert(1)""></main>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len x) 72) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[^\s@]+@[^\s@]+\.[^\s@]+$")))))
(assert (or (str.contains y ">>lose f") (not (str.contains z """></ma"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^CS\d{3,7}|AI\d{3,7}$"))) (not (str.contains (str.replace x "var>" "javascript:") "></javascript:")) (= (str.at x 25) "(")))
(assert (not (= "se" (str.substr x 1 2))))
(assert (str.contains (str.replace z "os" " ") ">l e foc"))
(check-sat)
