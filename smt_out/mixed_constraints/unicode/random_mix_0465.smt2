; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr oncut=""alert(1)"" contenteditable>test</hr>") (= x "<;LINK REL="";stylesheet""; HREF="";javascript:alert(';XSS';);"";>;") (= x "<object onbeforeload object onbeforeload=""javascript:javascript:alert(1)""></object onbeforeload>")))
(assert (or (= z "x>") (= z "id=x tabindex=1 onactivate=alert(1)></link>") (= z "t</ul>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "</obj" 0) 74)) (= "t</hr>" (str.substr x 40 9))))
(assert (or (str.contains (str.replace z "x>" "x") "x") (not (str.suffixof "link>" y))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^ -~\u{ff61}-\u{ff9f}]+$"))) (not (str.contains y "ble>")) (str.prefixof "<;L" x)))
(assert (or (str.suffixof ">" z) (str.contains (str.replace x "XSS" "") "';'")))
(assert (or (not (= (str.indexof y "ndex=" 0) 55)) (not (str.contains x ")"" ")) (= "t(1)"" cont" (str.substr y 15 10))))
(assert (or (not (str.prefixof "<;LI" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\w.%+-]+@[a-zA-Z0-9-]+\.[a-zA-Z0-9-.]+$")))))
(check-sat)
