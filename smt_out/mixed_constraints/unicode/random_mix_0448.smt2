; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style onmouseover=""alert(1)"">test<\u{1f4a9}/style>") (= x "<textarea draggable=""true"" ondragstart=""alert(1)"">test</textarea>")))
(assert (or (= z "ecopy=""alert(1)"" contenteditable>test</noembed>") (= z "(1)"" contenteditable>test</font>") (= z "rror=alert(/xssed/) />")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "rror=ale" z)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[^\s*]([a-zA-Z\u{f1}\u{d1}\u{c0}-\u{ff}/\s]+){0,100}$"))))
(assert (or (not (= (str.indexof x "t(" 0) 24)) (= "(1)""xontenteditable>test</font>" (str.replace z " c" "x")) (not (= "alert(" (str.substr x 20 6)))))
(assert (not (str.contains (str.replace x "mou" "") "onseove")))
(assert (or (str.contains x "text") (= (str.indexof x "r" 0) 20)))
(check-sat)
