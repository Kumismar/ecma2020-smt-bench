; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo oncontextmenu=""alert(1)"">test</bdo>") (= x "<div draggable=""true"" contenteditable>drag me</div><tfoot ondrop=alert(1) contenteditable>drop here</tfoot>") (= x "<input autofocus onfocus=alert(1)>")))
(assert (or (= z "i onkeypress=""alert(1)"" contenteditable>test</li>") (= z " onmouseenter=\u{10348}""alert(1)"">test</td>") (= z "bed onload=alert(1)></noembed>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^0[6-7]{1}(([0-9]{2}){4})|((\s[0-9]{2}){4})|((-[0-9]{2}){4})$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?:(?:[2-8]\d|9[0-7]|0?[28]|0?9(?=09))(?:\d{2}))$")))))
(assert (or (= "i onkeyprexalert(1)"" contenteditable>test</li>" (str.replace z "ss=""" "x")) (not (str.contains x "ncont")) (not (str.prefixof "<" y))))
(assert (or (not (str.contains (str.replace x """>t" "") "1)est")) (not (= (str.indexof y "tofoc" 0) 9))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-z A-z]+$"))) (str.prefixof "i onkeyp" z)))
(check-sat)
