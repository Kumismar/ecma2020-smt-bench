; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menu onmouseover=""alert(1)"">test</menu>") (= x "<address onfocusout=alert(1) tabindex=1 id=x></address><input autofocus>")))
(assert (or (= z "ea onchange=alert(1)>XSS</textarea>") (= z " onmouseup=""alert(1)"">test</noembed>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 52) (not (str.prefixof " onm" z)) (not (>= (str.len y) 74))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^...*"))) (str.in_re z ((_ re.from_regex ecma2020 u) "[5,7]{1}[7,0]{1}[0-9]{8}")) (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9/]*"))))
(assert (or (>= (str.len x) 32) (= "change=a" (str.substr z 5 8))))
(assert (or (str.contains z "(1)"">") (str.suffixof ">test</rt>" z)))
(assert (or (not (= (str.at x 43) "m")) (not (= (str.at x 54) ">"))))
(check-sat)
