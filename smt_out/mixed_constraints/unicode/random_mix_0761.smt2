; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<button onmouseleave=""alert(1)"">test</button>") (= x "<li onblur=alert(1) tabindex=1 id=x></li><input autofocus>") (= x "<bdi draggable=""true"" ondragend=""alert(1)"">test</bdi>")))
(assert (or (= z "cite>") (= z ";XSS>;=&;{()}") (= z "option></select>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 16)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[0-9]{1,8}"))) (>= (str.len x) 42)))
(assert (not (>= (str.len z) 2)))
(assert (= (str.at x 8) "o"))
(assert (str.suffixof ">" z))
(assert (not (= (str.at z 8) ";")))
(assert (= "b>" (str.substr x 35 5)))
(check-sat)
