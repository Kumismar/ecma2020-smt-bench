; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee draggable=""true"" ondragend=""alert(1)"">test</marquee>") (= x "<script>alert(document.head.childNodes[3].text)</script>")))
(assert (or (= z "80\x81expression(javascri\u{1f600}pt:alert(1)"">DEF") (= z "contenteditable>test</ins>") (= z "nsform: rotate(180deg);}</style><plaintext id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></plaintext>")))
(assert (= y (str.++ x z)))
(assert (or (= "<scriptert(document.head.childNodes[3].text)</script>" (str.replace x ">al" "")) (not (str.contains (str.replace z "le>t" "<b>") "tab<b>es"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^[6-9][0-9]{9}$")) (not (str.contains z "le><pla"))))
(assert (or (not (= (str.len x) 61)) (>= (str.len z) 16) (not (str.suffixof "e>" x))))
(assert (or (not (= (str.indexof x """true" 0) 19)) (not (str.suffixof "ext>" z))))
(assert (or (not (= "lert" (str.substr z 30 4))) (str.suffixof "t</ins>" z)))
(assert (= " id=x tabi" (str.substr x 4 10)))
(assert (not (= (str.at y 67) "a")))
(check-sat)
