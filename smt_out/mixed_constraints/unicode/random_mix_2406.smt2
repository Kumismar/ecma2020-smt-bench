; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav onfocusout=alert(1) tabindex=1 id=x></nav><input autofocus>") (= x "<marquee onkeydown=""alert(1)"" contenteditable>test</marquee>")))
(assert (or (= z "/ onload=alert(1)>") (= z "group draggable=""true"" ondrag=""alert(1)"">test</optgroup>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<marquee o" x)) (not (= (str.indexof y "a" 0) 2))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[-a-zA-Z0-9@:%_\+.~#?&//=]{2,256}\.[a-z]{2,4}\b(\/[-a-zA-Z0-9@:%_\+.~#?&//=]*)?"))) (= (str.at y 78) "(") (not (= (str.at x 41) "e"))))
(assert (or (not (= (str.indexof y "cusou" 0) 9)) (not (str.contains (str.replace x "e>" "x") "lx:targ")) (= "/" (str.substr z 0 1))))
(assert (or (not (str.prefixof "<object" x)) (str.contains z " onload")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^([ \u{5c}u00c0-\u{5c}u01ffa-zA-Z'\-])+$")) (not (= "/ onl<b>d=alert(1)>" (str.replace z "oa" "<b>")))))
(assert (or (not (str.contains (str.replace y "ble" "<b>") "a<b>>te")) (>= (str.len y) 113) (not (= (str.at z 1) ")"))))
(check-sat)
