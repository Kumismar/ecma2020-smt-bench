; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong id=x tabindex=1 onfocus=alert(1)></strong>") (= x "<style>@keyframes x{}</style><svg style=""animation-name:x"" onanimationend=""alert(1)""></svg>") (= x "<rp oncopy=""alert(1)"" contenteditable>test</rp>")))
(assert (or (= z "r onkeyup=""alert(1)"" contenteditable>test</footer>") (= z "\x8Aexpression(javascript:alert(1)"">DEF") (= z "t</appl\u{1f600}et>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<style>@keyframes x{}</style><svg style=""animation-name:x nimationend=""alert(1)""></svg>t</appl\u{1f600}et>" (str.replace y """ ona" " "))) (not (str.prefixof "<r" y)) (str.contains x "1)"" co")))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[- 0-9A-Za-z|\u{2122} ]+$")))
(assert (str.suffixof "ooter>" z))
(assert (= (str.at y 20) """"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[A-z\u{410}-\u{44f} ,.'-]+$"))))
(assert (not (= (str.at z 8) "e")))
(assert (or (str.prefixof "t</appl" z) (not (str.contains x "trong id=x"))))
(assert (or (= (str.at z 11) "i") (str.prefixof "<str" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\S+@(([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,6})$"))) (str.contains y "nen")))
(check-sat)
