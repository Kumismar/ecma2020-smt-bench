; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><source style=""animation-name:x"" onanimationend=""alert(1)""></source>") (= x "<style>:target {color:red;}</style><plaintext id=x style=""transition:color 1s"" ontransitionend=alert(1)></plaintext>")))
(assert (or (= z "ion-name:x"" onanimationend=""alert(1)""></rb>") (= z "ofocus>") (= z "</rt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "/rt>" "javascript:") "<javascript:")) (not (= (str.indexof x "ur" 0) 32)) (str.prefixof "</rt" z)))
(assert (or (not (= (str.indexof z "ofoc" 0) 0)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9\u{ff10}-\u{ff19}]+$"))))
(assert (not (= " " (str.substr x 14 1))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-zA-z\s]+"))) (not (str.suffixof "/rt>" z))))
(assert (or (not (str.contains (str.replace x "n" "alert(1)") "e=""aalert(1)ima")) (str.prefixof "bl" z)))
(check-sat)
