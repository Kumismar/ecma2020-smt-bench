; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<command onmouseout=""alert(1)"">test</command>") (= x "<a href=""\x0Fjavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z """>test</bdi>") (= z "aggable=""true"" ondra\u{1d400}g=""alert(1)"">test</tbody>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:(?:https?|HTTPS?|ftp|FTP):\/\/)(?:\S+(?::\S*)?@)?(?:(?!(?:10|127)(?:\.\d{1,3}){3})(?!(?:169\.254|192\.168)(?:\.\d{1,3}){2})(?!172\.(?:1[6-9]|2\d|3[0-1])(?:\.\d{1,3}){2})(?:[1-9]\d?|1\d\d|2[01]\d|22[0-3])(?:\.(?:1?\d{1,2}|2[0-4]\d|25[0-5])){2}(?:\.(?:[1-9]\d?|1\d\d|2[0-4]\d|25[0-4]))|(?:(?:[a-zA-Z\u{5c}u00a1-\u{5c}uffff0-9]-*)*[a-zA-Z\u{5c}u00a1-\u{5c}uffff0-9]+)(?:\.(?:[a-zA-Z\u{5c}u00a1-\u{5c}uffff0-9]-*)*[a-zA-Z\u{5c}u00a1-\u{5c}uffff0-9]+)*)(?::\d{2,})?(?:[\/?#]\S*)?$"))))
(assert (not (= (str.indexof x "eu" 0) 13)))
(assert (or (not (= (str.indexof x "em" 0) 55)) (= "aggable=""true"" ondra\u{1d400}g=""alert(1)"">test</ >" (str.replace z "tbody" " "))))
(assert (= """>test<alert(1)bdi>" (str.replace z "/" "alert(1)")))
(assert (or (not (= (str.indexof z ">" 0) 1)) (= " ontrans" (str.substr x 77 8))))
(assert (str.contains y "pt"))
(assert (or (not (= (str.at x 20) """")) (not (= "ody>" (str.substr z 42 9))) (str.contains z "est</")))
(check-sat)
