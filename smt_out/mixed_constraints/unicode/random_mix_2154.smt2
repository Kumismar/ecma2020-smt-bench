; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>alert(1)//") (= x "<template onbeforepaste=""alert(1)"" contenteditable>test</template>") (= x "<i onclick=""alert(1)"">test</i>")))
(assert (or (= z "p id=x tabindex=1 onactivate=alert(1)></optgroup>") (= z ">@keyframes x{}</style><param style=""animation-name:x"" onanimationstart=""alert(1)""></param>") (= z "t(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "nim" 0) 38)))
(assert (or (= (str.len x) 30) (>= (str.len y) 113)))
(assert (or (str.contains (str.replace x "nclic" "<b>") "<i o<b>k=""a") (not (= "repaste=" (str.substr x 16 8)))))
(assert (or (= (str.indexof z "x " 0) 5) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((?!\blose weight\b|\bfuck\b|\bsex\b|\bsexy\b|\bpersedia2022\b).)*$"))) (str.in_re y ((_ re.from_regex ecma2020 u) "^\w*$"))))
(assert (or (not (= "ro" (str.substr y 3 2))) (= "t autofoc" (str.substr z 3 9))))
(assert (or (str.suffixof """></param>" y) (>= (str.len y) 19)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-Z][0-9][A-Z] [0-9][A-Z][0-9]"))) (= (str.indexof x "t" 0) 16)))
(check-sat)
