; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onMouseMove html onMouseMove=""javascript:javascript:alert(1)""></html onMouseMove>") (= x "<style onfocusout=alert(1) tabindex=1 id=x></style><input autofocus>")))
(assert (or (= z "ivate=alert(1)></h1>") (= z ">test</head>") (= z "ert(1)"" contenteditable>test</s>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 26) (= (str.len y) 74) (not (= "t(1" (str.substr y 97 3)))))
(assert (not (str.suffixof "</dl>" y)))
(assert (or (str.prefixof "ert(1)"" " z) (not (= (str.indexof z "jav" 0) 22)) (= (str.indexof x "us>" 0) 65)))
(assert (or (= (str.at x 34) "x") (str.in_re y ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_ ]*$"))))
(assert (= "avascr" (str.substr y 37 6)))
(check-sat)
