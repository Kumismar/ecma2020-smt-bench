; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style></style\x3E<img src=""about:blank"" onerror=javascript:alert(1)//></style>") (= x "<style>:target {color: red;}</style><address id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></address>") (= x "<option onbeforecut=""alert(1)"" contenteditable>test</option>")))
(assert (or (= z "(1)"">test</progress>") (= z "obr onmouseleave=""alert(1)"">test</nobr>") (= z "script src=""data:\xCB\x8F,javascript:alert(1)""></script>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "ipt>" y) (= "option" (str.substr x 53 6)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-zA-Z-.\u{f3}]|[\u{e0}-\u{fa}]|[\u{c0}-\u{da}]|[-z0-9-\s])+$")))))
(assert (str.contains (str.replace z "st" "x") "ex</n"))
(assert (or (= (str.len y) 99) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[^#\(\)\/<=>]*$")))))
(assert (not (str.prefixof "<s" x)))
(assert (or (not (str.contains x ")"" ")) (= ")""" (str.substr z 2 2))))
(assert (or (str.contains z "br onmous") (str.prefixof "obr on" z) (not (= (str.at z 17) """"))))
(assert (not (str.contains z "/a")))
(assert (or (not (= "<addres" (str.substr x 36 7))) (not (= (str.at x 58) "t"))))
(check-sat)
