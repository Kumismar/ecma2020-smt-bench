; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<fieldset onmouseover=""alert(1)"">test</fieldset>") (= x "<style>:target {color:red;}</style><menuitem id=x style=""transition:color 1s"" on\u{1f600}transiti\u{1f4a9}onend=alert(1)></menuitem>") (= x "<spacer onbeforecopy=""alert(1)"" contenteditable>test</spacer>")))
(assert (or (= z "rt(1)></em>") (= z "nload=alert(1)></mark>") (= z "lclick=""alert(1)"">test</figcaption>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "^[\u{30a2}-\u{30f3}\u{309b}\u{309c}\u{30a1}-\u{30a9}\u{30e3}-\u{30e7}\u{30fc}\u{300c}\u{300d}\u{3001}]+$")) (not (str.suffixof "igcaption>" z)) (str.contains (str.replace z "oad=" " ") "nl al")))
(assert (str.prefixof "nlo" z))
(assert (not (str.suffixof "IPT&gt;" z)))
(assert (or (not (= "est" (str.substr y 49 3))) (not (= (str.indexof z "t" 0) 12)) (str.contains x ">:ta")))
(assert (or (= (str.indexof y "an" 0) 59) (= (str.at z 4) ")")))
(check-sat)
