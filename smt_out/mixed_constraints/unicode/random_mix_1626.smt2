; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var id=x tabindex=1 onfocus=alert(1)></var>") (= x "Redirect 302 /a.jpg http://victimsite.com/admin.asp&deleteuser") (= x "<nobr onkeyup=""alert(1)"" contenteditable>test</nobr>")))
(assert (or (= z "(String.fromCharCode(88,83,83))"">") (= z "alert(1)"">test</li>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "alert(1)""" z))
(assert (or (str.prefixof "Redire" y) (= (str.indexof x " on" 0) 5) (= "(String.fromCharCode(88 83,83))"">" (str.replace z "," " "))))
(assert (or (= (str.at y 49) "t") (not (str.prefixof "Red" y)) (not (str.suffixof "nobr>" x))))
(assert (or (= "eteuser" (str.substr x 55 7)) (not (= (str.at y 57) "h"))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[1][3,4,5,7,8][0-9]{9}$")))
(assert (not (str.contains y "(String.fr")))
(check-sat)
