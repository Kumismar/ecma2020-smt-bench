; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onprogress=""alert(String.fromCharCode(88,83,83))"">") (= x "<style>:target {color:red;}</style><map id=x style=""transition:color 1s"" ontransitionend=alert(1)></map>")))
(assert (or (= z "ditable>drop here</p>") (= z "m id=x tabindex=1 onactivate=alert(1)></param>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z " id" 0) 1)))
(assert (or (not (str.prefixof "<" x)) (not (str.contains (str.replace z "b" " ") "ita le>dr")) (not (= (str.at x 43) "x"))))
(assert (= "e(88,83" (str.substr x 47 7)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[1-9]\d{4,10}$"))) (not (= (str.at y 61) "d")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?=.*[a-zA-Z])(?=.*[0-9])[A-Za-z0-9\./\s-]+$")))))
(assert (or (not (= "<style>:target {""olor:red;}</style><map id=x style=""transition:color 1s"" ontransitionend=alert(1)></map>" (str.replace x "c" """"))) (not (= (str.indexof z "tabl" 0) 2))))
(assert (not (str.suffixof "</p>" z)))
(assert (not (= (str.at x 22) """")))
(assert (or (= (str.indexof x "le>:" 0) 4) (not (str.suffixof "here</p>" z))))
(check-sat)
