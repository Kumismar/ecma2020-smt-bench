; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onblur=alert(1) tabindex=1 id=x></cite><input autofocus>") (= x "<style>@keyframes x{}</style><var style=""animation-name:x"" onanimationstart=""alert(1)""></var>") (= x "<body onResize body onResize=""javascript:javascript:alert(1)""></body onResize>")))
(assert (or (= z "cript\u{10348}:alert(""XSS"")>") (= z "er=""0%EF%BB%BF")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<st>@keyframes x{}</style><var style=""animation-name:x"" onanimationstart=""alert(1)""></var>" (str.replace x "yle" ""))) (= (str.at x 43) "v")))
(assert (str.prefixof "<ci" y))
(assert (not (str.suffixof "rt(""XSS"")>" y)))
(assert (or (str.contains y "t(""XSS") (not (= "0%EF%BB%" (str.substr z 4 8)))))
(assert (or (not (str.prefixof "<" x)) (str.prefixof "<cite" x) (str.in_re y ((_ re.from_regex ecma2020 u) "^((0[1-9])|([1-8][0-9])|(9[0-8])|(2A)|(2B))[0-9]{3}$"))))
(assert (or (not (str.suffixof "%BF" y)) (str.contains z "/asid") (not (= "<cjavascript: onblur=alert(1) tabindex=1 id=x></cite><input autofocus>" (str.replace x "ite" "javascript:")))))
(assert (or (= (str.at z 23) "t") (str.contains (str.replace y "nRe" "x") "ody oxs") (>= (str.len y) 55)))
(check-sat)
