; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark id=x tabindex=1 onbeforedeactivate=alert(1)></mark><input autofocus>") (= x "<frame onmouseout=""alert(1)"">test</frame>")))
(assert (or (= z """></marquee onStart>") (= z "t</textarea>") (= z "</aside>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<mark" y)) (not (str.prefixof """></mar" z)) (str.prefixof "<frame " x)))
(assert (or (str.contains x "ydown=""a") (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9a-zA-Z]{3,4}$"))))
(assert (or (not (= (str.indexof x "u" 0) 9)) (= "<mark id=x tndex=1 onbeforedeactivate=alert(1)></mark><input autofocus>t</textarea>" (str.replace y "abi" "")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^1[3|4|5|7|8][0-9]{9}$")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z\u{c0}-\u{fa}]{2,30}$"))) (= (str.at y 46) "d")))
(assert (not (= (str.at z 86) "g")))
(check-sat)
