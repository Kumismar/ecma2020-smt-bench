; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<small onpaste=""alert(1)"" contenteditable>test</small>") (= x "<IMG SRC=x onerror=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "aption onbeforecut=""alert(1)"" contenteditable>test</figcaption>") (= z """alert(1)"">test</head\u{1f600}>") (= z "frame onbefore\u{20000}load=""javascript:javascript:alert(1)""></iframe onbeforeload>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 81) (not (= (str.at x 5) "S"))))
(assert (or (not (str.prefixof "aption on" z)) (not (str.contains (str.replace z "=""" " ") "ecut a"))))
(assert (or (str.suffixof ">" y) (not (= (str.at y 102) "e")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[7-9][0-9]{9}$")))))
(assert (or (str.prefixof "<small on" y) (str.contains x "t(1)"" con") (str.suffixof "ll>" x)))
(check-sat)
