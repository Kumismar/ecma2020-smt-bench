; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "'`""><\x3Cscript>javascript:alert(1)</script>") (= x "<link draggable=""true"" ondragenter=""alert(1)"">test</link>")))
(assert (or (= z "t id=x tabindex=1 onactivate=alert(1)></frameset>") (= z "ing=""alert(String.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^.{1,50}$")) (= (str.at x 75) """") (not (= (str.at x 18) "r"))))
(assert (or (not (= "<link draggable=""true"" ondragenter=""alert(1)"">test<""k>t id=x tabindex=1 onactivate=alert(1)></frameset>" (str.replace y "/lin" """"))) (str.in_re x ((_ re.from_regex ecma2020 u) "^[_a-zA-Z0-9-]+(.[_a-zA-Z0-9-]+)@[a-zA-Z0-9-]+(.[a-zA-Z0-9-]+)(.[a-zA-Z]{2,3})$")) (>= (str.len z) 42)))
(assert (= (str.at z 22) "C"))
(assert (str.contains y "ac"))
(check-sat)
