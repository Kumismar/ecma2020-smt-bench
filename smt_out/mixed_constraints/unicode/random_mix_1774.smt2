; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onseeked=""alert(String.fromCharCode(88,83,83))"">") (= x "<script onReadyStateChange script onReadyStateChange=""javascript:javascript:alert(1)""></script onReadyStateChange>")))
(assert (or (= z "nteditable>test</hr>") (= z "ert(1)></meter>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{13}$"))) (not (= (str.indexof y "k" 0) 16))))
(assert (not (str.prefixof "<IMG SRC=x" y)))
(assert (= "l" (str.substr z 8 1)))
(assert (or (not (str.contains x "nsi")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[\w'\-,.][^_!\u{c2}\u{a1}?\u{c3}\u{b7}?\u{c2}\u{bf}/\\+=@#$%\u{cb}\u{2020}&*(){}|~<>;:[\]]{2,}$"))) (not (str.prefixof "</fig" z))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d\d\d\d\d(-\d\d\d\d)?$"))))
(check-sat)
