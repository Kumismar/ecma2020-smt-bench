; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame draggable=""true"" ondrag=""alert(1)"">test</frame>") (= x "<embed id=x tabindex=1 onbeforeactivate=alert(1)></embed>") (= x "<ol draggable=""true"" ondragend=""alert(1)"">test</ol>")))
(assert (or (= z "ousedown=""alert(1)"">test</meter>") (= z ")"" contenteditable>test</track>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "1 o" 0) 21)) (= "<keygen onpaste=""alert(1)"" contenteditale>test</keygen> tabindex=1 onfocus=alert(1)></a>" (str.replace y "b" ""))))
(assert (= (str.at y 40) "e"))
(assert (or (>= (str.len x) 51) (str.in_re y ((_ re.from_regex ecma2020 u) "^[0-9.]+$")) (not (= (str.indexof z ")"" c" 0) 0))))
(assert (or (= (str.at z 10) "e") (str.prefixof ")"" conten" z)))
(assert (or (not (<= (str.len x) 61)) (not (= "<form draggable=""true"" ondragleave=""alert(1)"">test<""rm>" (str.replace x "/fo" """")))))
(assert (str.contains (str.replace z "tedi" "alert(1)") "nalert(1)tab"))
(check-sat)
