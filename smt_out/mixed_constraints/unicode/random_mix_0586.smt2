(assert (or (not (str.suffixof "label>" x)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "accessoire"))) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{3}-\d{3}-\d{4}$|^\d{3}.\d{3}.\d{4}$")))))
