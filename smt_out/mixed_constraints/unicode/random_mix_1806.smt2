; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figcaption draggable=""true"" ondrag=""alert(1)"">test</figcaption>") (= x "<kbd draggable=""true"" ondragleave=""alert(1)"">test</kbd>") (= x "<html id=x tabindex=1 ondeactivate=alert(1)></html><input id=y autofocus>")))
(assert (or (= z "ate=alert(1)></samp>") (= z "r>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "/progress>") (not (= (str.indexof y "id=" 0) 6))))
(assert (or (= (str.at x 53) "d") (not (= (str.len y) 84)) (not (str.suffixof ">" z))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9-()]*$"))) (>= (str.len x) 70) (= (str.indexof y "0ip" 0) 6)))
(assert (not (= (str.indexof y ")""" 0) 42)))
(check-sat)
