(assert (or (= x "<aside onpaste=""alert(1)"" contenteditable>test</aside>") (= x "<;IMG "";"";"";>;<;SCRIPT>;alert("";XSS"";)<;/SCRIPT>;"";>;") (= x "<style>:target {color:red;}</style><body id=x style=""transition:color 1s"" ontransitionend=alert(1)></body>")))
