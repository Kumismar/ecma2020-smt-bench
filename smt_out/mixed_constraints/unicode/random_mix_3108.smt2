(assert (or (= (str.len x) 106) (= (str.at z 39) ">") (= "<;IMG "";"";""; <;SCRIPT>;alert("";XSS"";)<;/SCRIPT>;"";>;46;js\""&gt;&lt;/SCRIPT&gt;" (str.replace y ">;" " "))))
