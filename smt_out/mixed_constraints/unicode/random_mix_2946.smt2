; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<wbr onmouseenter=""alert(1)"">test</wbr>") (= x "&lt;SCRIPT &quot;a=&apos;&gt;&apos;&quot; SRC=&quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;")))
(assert (or (= z "start=""alert(1)"">test</shadow>") (= z "XSS/")))
(assert (= y (str.++ x z)))
(assert (str.contains x "onmou"))
(assert (or (not (= (str.at z 6) """")) (str.in_re y ((_ re.from_regex ecma2020 u) "^\d{2}-\d{2}-\d{4}$"))))
(assert (str.prefixof "<wbr " x))
(assert (or (not (= """>te" (str.substr z 15 4))) (not (= (str.len x) 103))))
(assert (or (= (str.indexof x "gt;" 0) 26) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^\(?[\d]{3}\)?[\s-]?[\d]{3}[\s-]?[\d]{4}$"))) (str.contains y "t</wbr>")))
(assert (not (str.contains z "enteditab")))
(check-sat)
