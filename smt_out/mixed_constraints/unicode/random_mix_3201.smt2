; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><picture id=x style=""transition:color 1s"" ontransitionend=alert(1)></picture>") (= x "<strong onmousemove=""alert(1)"">test</strong>") (= x "<style>:target {transform: rotate(180deg);}</style><xmp id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></xmp>")))
(assert (or (= z ">") (= z "=1 onfocus=alert(1)></noembed>") (= z "er onmousemove=""alert(1)"">test</center>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len z) 30)))
(assert (or (not (str.suffixof ">" z)) (not (= (str.at z 26) "t")) (not (str.contains (str.replace z "</" "<b>") "t<b>cen"))))
(assert (or (str.contains y "alert(1)") (str.in_re x ((_ re.from_regex ecma2020 u) "\d+(-\d+)*$")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[1-9]{2}")))))
(assert (= "semove" (str.substr x 13 6)))
(assert (or (<= (str.len y) 134) (str.suffixof "enter>" y) (= "<strong onmousemove ""alert(1)"">test</strong>er onmousemove=""alert(1)"">test</center>" (str.replace y "=" " "))))
(assert (not (str.contains x "repas")))
(assert (or (not (<= (str.len x) 113)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(13[0-9]|14[5|7]|15[0|1|2|3|5|6|7|8|9]|18[0|1|2|3|5|6|7|8|9])[0-9]{8}$")))))
(check-sat)
