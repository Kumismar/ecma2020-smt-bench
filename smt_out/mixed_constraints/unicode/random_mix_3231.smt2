; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<template onfocusout=alert(1) tabindex=1 id=x></template><input autofocus>") (= x "<label onfocusout=alert(1) tabindex=1 id=x></label><input autofocus>") (= x "<rb onmouseover=""alert(1)"">test</rb>")))
(assert (or (= z "rt(1)></script>") (= z "1)"">test</menu>") (= z "></dir>")))
(assert (= y (str.++ x z)))
(assert (or (= "1)"">tes""enu>" (str.replace z "t</m" """")) (not (= (str.at x 31) "a")) (not (str.contains x "=""ja"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9_]{1,64}$"))))
(assert (or (= (str.at z 0) ">") (not (str.contains (str.replace x "np" """") "<i""ut "))))
(assert (str.prefixof "<details" x))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{1,2}\/[0-9]{1,2}\/[0-9]{2,4}$"))) (not (= "/me" (str.substr y 45 3))) (not (str.contains z "></dir>"))))
(assert (str.prefixof "<rb on" x))
(assert (not (str.prefixof "=x tab" z)))
(assert (= (str.at x 19) "e"))
(check-sat)
