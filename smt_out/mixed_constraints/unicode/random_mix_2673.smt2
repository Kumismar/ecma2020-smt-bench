; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em onkeypress=""alert(1)"" contenteditable>test</em>") (= x "<big onkeypress=""alert(1)"" contenteditable>test</big>") (= x "<blockquote onkeyup=""alert(1)"" contenteditable>test</blockquote>")))
(assert (or (= z "tenteditable>drop here</applet>") (= z "true"" ondragend=""alert(1)"">test</var>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[1-9]\d*|0$"))) (not (= "pplet>" (str.substr z 25 9)))))
(assert (or (not (str.prefixof "<" x)) (= "<em onkeypress=""alert(1x"" contenteditable>test</em>tenteditable>drop here</applet>" (str.replace y ")" "x")) (not (= (str.at z 30) "t"))))
(assert (not (str.prefixof "<p " x)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^(?:(?:31(-|\/)(?:0?[13578]|1[02]))\1|(?:(?:29|30)(-|\/)(?:0?[1,3-9]|1[0-2])\2))(?:(?:1[6-9]|[2-9]\d)?\d{2})$|^(?:29(-|\/)0?2\3(?:(?:(?:1[6-9]|[2-9]\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))$|^(?:0?[1-9]|1\d|2[0-8])(-|\/)(?:(?:0?[1-9])|(?:1[0-2]))\4(?:(?:1[6-9]|[2-9]\d)?\d{2})$")) (not (str.prefixof "<bl" y)) (= (str.len x) 53)))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) ".{0}|.{2,}")))
(check-sat)
