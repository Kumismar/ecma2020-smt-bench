; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody onkeyup=""\u{1f600}alert(1)"" conten\u{10348}teditable>test</tbody>") (= x "<style>:target {color:red;}</style><summary id=x style=""transition:color 1s"" ontransitionend=alert(1)></summary>") (= x "<strong onpaste=""alert(1)"" contenteditable>test</strong>")))
(assert (or (= z """alert(1)"">test</svg>") (= z """);</SCRIPT>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "y onk" 0) 5)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9 A-Z.-]{2,}$"))) (str.contains (str.replace x "ont" """") "c""ente")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_.-]+$"))) (not (str.contains (str.replace z "er" """") "al""t(1"))))
(assert (= (str.len y) 68))
(assert (= "rac" (str.substr y 39 3)))
(assert (not (= "le><" (str.substr y 32 4))))
(assert (not (str.contains z ");</SCRIPT")))
(assert (= "//" (str.substr z 10 4)))
(check-sat)
