; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid onkeyup=""alert(1)"" contenteditable>test</nextid>") (= x "<frame draggable=""true"" ondrag=""alert(1)"">test</frame>") (= x "<wbr draggable=""true"" ondragstart=""alert(1)"">test</wbr>")))
(assert (or (= z "g><nextid onload=alert(1)></nextid>") (= z "agenter=""alert(1)"">test</nobr>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y """ o" """") "true""ndra")) (str.in_re z ((_ re.from_regex ecma2020 u) "^([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,})$")) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(\([0-9]{3}\)|[0-9]{3}-?)[0-9]{3}-?[0-9]{4}$")))))
(assert (or (str.contains x """ ") (str.in_re y ((_ re.from_regex ecma2020 u) "^[^\s]+$")) (= "<n""xtid onkeyup=""alert(1)"" contenteditable>test</nextid>" (str.replace x "e" """"))))
(assert (or (not (str.contains z """>test")) (str.contains (str.replace y "</wbr" "<b>") "t<b>>a") (= (str.at x 49) "r")))
(assert (= (str.at y 45) "s"))
(check-sat)
