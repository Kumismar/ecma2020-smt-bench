; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "perl -e 'print \""<SCR\0IPT>alert(\""XSS\"")</SCR\0IPT>\"";' > out") (= x "<body onresize=""alert(1)"">") (= x "<input type=""image"" dynsrc=""javascript:document.vulnerable=true;"">")))
(assert (or (= z "ne of the following strings to the drop box:</b>") (= z "press=""alert(1)"" contenteditable>test</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 11) "S") (str.prefixof "aste=""a" z) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{1,15}$")))))
(assert (or (not (str.suffixof "test</dfn>" y)) (not (= "nresize=""a" (str.substr y 7 10)))))
(assert (not (= (str.at y 7) "n")))
(assert (or (not (str.prefixof "<next" y)) (not (= (str.len y) 69)) (not (= (str.indexof y "g" 0) 80))))
(assert (or (= (str.indexof z "ess=" 0) 2) (not (= (str.indexof z "st<" 0) 35))))
(assert (not (<= (str.len z) 48)))
(assert (= "body onre" (str.substr y 1 9)))
(check-sat)
