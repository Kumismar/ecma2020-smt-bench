; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset onBlur frameset onBlur=""javascript:javascript:alert(1)""></frameset onBlur>") (= x "<t:set attributeName=""innerHTML"" targetElement=""x"" to=""&lt;img&#11;src=x:x&#11;onerror&#11;=alert(116)&gt;"">//[""'`-->]]>]</div>")))
(assert (or (= z "de(88,83,83))"">") (= z "x style=""transition:transform 2s""\u{10348} ontransitionr\u{1f4a9}un=alert(1)></marquee>") (= z """ autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof """" z)) (str.contains z "tio") (not (= "<fjavascript:ameset onBlur frameset onBlur=""javascript:javascript:alert(1)""></frameset onBlur>" (str.replace x "r" "javascript:")))))
(assert (or (str.contains (str.replace x "am" "") "freset") (not (>= (str.len x) 83)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(?=.*[A-Za-z])(?=.*\d)(?=.*[@$!%.,:;-_^\u{b0}+*#?&])[A-Za-z\d@$!%.,:;-_^\u{b0}+*#?&]{8,}$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[0-9\+\-\s]+$"))) (= (str.at z 6) "f")))
(assert (or (= (str.indexof z "ofoc" 0) 5) (not (= "onBl" (str.substr x 77 4))) (str.prefixof "<fr" y)))
(assert (or (not (str.contains (str.replace x "HTML""" """") "er"" ")) (= (str.len z) 9)))
(assert (str.suffixof ",83,83))"">" z))
(check-sat)
