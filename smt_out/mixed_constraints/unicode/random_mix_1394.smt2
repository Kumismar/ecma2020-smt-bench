; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<center onmousemove=""alert(1)"">test</center>") (= x "<caption onmouseover=""alert(1)"">test</caption>")))
(assert (or (= z "rm ondragover=alert(1) contenteditable>drop here</form>") (= z ")"" contenteditable>test</footer>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof ")"" " z) (not (str.in_re z ((_ re.from_regex ecma2020 u) ".*^\d{2,4}-?\d{2,4}-?\d{4}$.*"))) (not (str.contains x "r>"))))
(assert (or (not (= (str.at z 43) " ")) (= (str.at z 19) "t") (not (str.in_re y ((_ re.from_regex ecma2020 u) "([0-9]{13}$)")))))
(assert (not (str.suffixof ">" x)))
(assert (or (str.contains z "rop her") (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[\w\W]{6,20}$"))) (not (= "<caption onmouseover=""alert test</caption>" (str.replace x "(1)"">" " ")))))
(check-sat)
