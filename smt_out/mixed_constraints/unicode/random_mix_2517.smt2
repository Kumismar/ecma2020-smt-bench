; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><legend id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></legend>") (= x "<audio autoplay onloadedmetadata=alert(1)> <source src=""validaudio.wav"" type=""audio/wav""></audio>")))
(assert (or (= z "ditable>test</button>") (= z "ntext>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "&#3" x))
(assert (= (str.len y) 103))
(assert (str.contains z "e>test<"))
(assert (or (= (str.indexof x "on:tr" 0) 79) (str.suffixof "e>" y) (= "alert(1)le>test</button>" (str.replace z "ditab" "alert(1)"))))
(assert (= (str.indexof z """>" 0) 8))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "^((\d{3}[- ]\d{3}[- ]\d{2}[- ]\d{2})|(\d{3}[- ]\d{2}[- ]\d{2}[- ]\d{3})|(\d{10}))$")) (str.contains x "dio au") (= "eg);}</sty" (str.substr y 38 10))))
(assert (or (str.suffixof """></audio>" x) (= "rce src=""" (str.substr x 47 9)) (not (= (str.len z) 23))))
(assert (or (not (= (str.indexof x "e=" 0) 15)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Z\u{c4}\u{d6}\u{dc}][\w\u{e4}\u{c4}\u{f6}\u{d6}\u{fc}\u{dc}\u{df}/ \.\-]*$")))))
(check-sat)
