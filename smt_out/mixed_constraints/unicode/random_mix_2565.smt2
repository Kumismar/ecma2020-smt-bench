; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><script id=x style=""transition:color 1s"" ontransitionend=alert(1)></script>") (= x "<b onmouseup=""alert(1)"">test</b>") (= x "<///style///><span %2F onmousemove='alert&lpar;1&rpar;'>SPAN")))
(assert (or (= z ")"">test</li>") (= z """ contenteditable>tes\u{1d400}t</col>\u{1f600}")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "ulticol>" x)))
(assert (or (>= (str.len y) 139) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[_A-z0-9]{2,2}[\-]{1,1}[_A-z0-9]{3,3}$"))) (= (str.indexof y "a" 0) 9)))
(assert (or (= "tion" (str.substr y 61 4)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(0|\+33)[1-9]([-.\u{a0}]?[0-9]{2}){4}$")))))
(assert (or (= (str.len y) 146) (not (>= (str.len y) 71)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "STOP HAIR LOSS")))))
(assert (or (not (= (str.at z 2) "1")) (= "co" (str.substr y 34 2))))
(assert (= "b onmouseup=""alert(1)"">test</b>"" contenteditable>tes\u{1d400}t</col>\u{1f600}" (str.replace y "<" "")))
(assert (or (not (str.contains z "=true;""")) (not (= (str.indexof x "//st" 0) 2))))
(assert (not (= "sc" (str.substr y 36 2))))
(check-sat)
