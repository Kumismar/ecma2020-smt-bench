; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onpageshow=""alert(String.fromCharCode(88,83,83))"">") (= x "<p onfocusout=alert(1) tabindex=1 id=x></p><input autofocus>") (= x "<isindex draggable=""true"" ondragenter=""alert(1)"">test</isindex>")))
(assert (or (= z "/strong><input autofocus>") (= z " onfocus=alert(1)></em>") (= z "=1 id=x></audio><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "wbr>" y) (= (str.at z 15) "a") (not (str.suffixof ")></em>" y))))
(assert (or (= "t(1" (str.substr x 18 3)) (not (= (str.len z) 33)) (not (= (str.indexof z "><inp" 0) 7))))
(assert (or (str.suffixof "utofocus>" z) (= (str.indexof z "o" 0) 4) (= (str.at z 18) "<")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(1[3-9]\d{9})$"))) (not (= (str.at x 44) "("))))
(check-sat)
