; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist onpaste=""alert(1)"" contenteditable>test</datalist>") (= x "<iframe draggable=""true"" ondragenter=""alert(1)"">test</iframe>")))
(assert (or (= z "nsform: rotate(180deg);}</style><summary id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></summary>") (= z "ofocus>") (= z ")>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len x) 69) (str.suffixof ")>" z)))
(assert (or (= "e" (str.substr y 36 1)) (str.suffixof "s>" z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9]{6,15}"))) (not (= (str.indexof x "dit" 0) 37))))
(assert (or (not (= "<datalist onpaste=""alert(1)"" contenteditablealert(1)</datalist>)>" (str.replace y ">test" "alert(1)"))) (not (= "x>" (str.replace z ")" "x")))))
(assert (not (= (str.indexof y " " 0) 9)))
(assert (str.suffixof "y>" y))
(assert (not (str.contains (str.replace z ")>" "x") "x")))
(assert (= (str.at z 0) ")"))
(check-sat)
