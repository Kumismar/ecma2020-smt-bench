; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col onmouseover=""alert\u{1d400}(1)"">test</col>") (= x "<video onmouseenter=""alert\u{1f600}(1)"">test</video>")))
(assert (or (= z "on((window.r==1)?'':eval('r=1;") (= z "emove=""alert(1)"">test</center>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 94) (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([\w!#$%&'*+\-\/=?\^`{|}~]+\.)*[\w!#$%&'*+\-\/=?\^`{|}~]+@((((([a-zA-Z0-9]{1}[a-zA-Z0-9\-]{0,62}[a-zA-Z0-9]{1})|[a-zA-Z])\.)+[a-zA-Z]{2,62})|(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?)$"))) (= "est" (str.substr x 30 3))))
(assert (not (str.suffixof "l>" x)))
(assert (= (str.at x 8) "o"))
(assert (or (= "e=""a" (str.substr z 4 4)) (= "<col onmouseover=""aleralert(1)1)"">test</col>emove=""alert(1)"">test</center>" (str.replace y "t\u{1d400}(" "alert(1)")) (not (str.suffixof "center>" z))))
(assert (or (not (= (str.indexof x ">test" 0) 28)) (= (str.indexof x "nmous" 0) 6)))
(assert (str.contains x "ert\u{1f600}(1)"))
(assert (or (str.contains z " id=x st") (not (= (str.indexof y "ert" 0) 20)) (not (= "<video onmouseenter=""alert(1)lert\u{1f600}(1)"">test</video>emove=""alert(1)"">test</center>" (str.replace y "a" "alert(1)")))))
(assert (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%+-]{3,}@[a-zA-Z.-]{3,}([.]{1}[a-zA-Z]{2,}|[.]{1}[a-zA-Z]{2,}[.]{1}[a-zA-Z]{2,})")))
(check-sat)
