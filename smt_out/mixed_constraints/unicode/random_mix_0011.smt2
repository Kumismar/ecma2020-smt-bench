; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1d400}x \u{10348}oncut=alert(1)>copy this!") (= x """><img src=x onerror=prompt(1);>") (= x "<DIV STYLE=""background-image: url(&#1;javascript:alert('XSS'))"">")))
(assert (or (= z "ipt>") (= z "eg);}</style><table id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></table>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y "e" "alert(1)") " onalert(1)rror=") (not (= (str.indexof z """" 0) 0))))
(assert (or (<= (str.len z) 92) (not (str.in_re x ((_ re.from_regex ecma2020 u) ".{10,11}"))) (not (= (str.indexof x "IV " 0) 2))))
(assert (str.suffixof "))"">ipt>" y))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "[\u{ff71}-\u{ff9d}|\u{30a1}-\u{30f3}|\u{3000}| ]+$"))))
(assert (or (>= (str.len z) 89) (str.in_re x ((_ re.from_regex ecma2020 u) "(?!(^[.-].*|[^@]*[.-]@|.*\.{2,}.*)|^.{254}.)([a-zA-Z0-9_.-]+@)(?!-.*|.*-\.)([a-zA-Z0-9-]{1,63}\.)+[a-zA-Z]{2,15}"))))
(assert (not (str.contains x "script")))
(check-sat)
