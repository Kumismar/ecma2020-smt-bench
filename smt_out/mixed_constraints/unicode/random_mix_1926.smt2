; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img draggable=""true"" ondrag=""alert(1)"">test</img>") (= x "<style id=x tabindex=1 ondeactivate=alert(1)></style><input id=y autofocus>")))
(assert (or (= z "ert(1)"">test</textarea>") (= z "ert(1)></font><input autofocus>") (= z "ter=""a\u{10348}lert(1)"">test</ins>")))
(assert (= y (str.++ x z)))
(assert (or (= "<style id=x tabindex=1 ondeactivate=alt(1)></style><input id=y autofocus>" (str.replace x "er" "")) (not (>= (str.len z) 26)) (= (str.indexof x "1)" 0) 36)))
(assert (= (str.len y) 106))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]{1,}@[a-zA-Z0-9-]{2,}[.]{1}[a-zA-Z.]{2,}")))
(assert (str.in_re y ((_ re.from_regex ecma2020 u) "[a-zA-Z0-9 './,]+$")))
(assert (or (str.suffixof "cus>" x) (not (str.suffixof "autofocus>" y))))
(check-sat)
