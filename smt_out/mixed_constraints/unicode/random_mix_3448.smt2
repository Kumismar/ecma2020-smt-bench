; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr id=x tabindex=1 onactivate=alert(1)></hr>") (= x "<shadow onbeforecut=""alert(1)"" contenteditable>test</shadow>")))
(assert (or (= z "d=x tabindex=1 onfocusin=alert(1)></center>") (= z "t(1)"">test</time>") (= z "ck=""alert(1)"">test</kbd>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "<" 0) 0) (not (= " tabindex" (str.substr z 3 9)))))
(assert (or (not (= (str.indexof x "di" 0) 39)) (not (str.contains (str.replace y "1 " "alert(1)") "x=alert(1)ona")) (= (str.indexof x "/vi" 0) 26)))
(assert (not (= "ck=""al""t(1)"">test</kbd>" (str.replace z "er" """"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020 u) "^1[3|4|5|7|8][0-9]\d{8}$"))))
(assert (or (>= (str.len z) 12) (not (str.suffixof ">" y))))
(check-sat)
