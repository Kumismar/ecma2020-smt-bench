; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onmousemove=""alert(1)"">test</sup>") (= x "<rp dragga\u{10348}ble=""true"" ondragenter=""alert(1)"">test</rp>")))
(assert (or (= z "py=""alert(1)"" contenteditable>test</iframe>") (= z "able>test</dd>") (= z "re\u{10348}paste=""alert(1)"" contenteditable>te\u{10348}st</font>")))
(assert (= y (str.++ x z)))
(assert (= "i>" (str.substr z 22 6)))
(assert (or (= "table" (str.substr z 24 5)) (not (= (str.indexof x ">te" 0) 27))))
(assert (= (str.at x 23) "("))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,6}$"))) (not (= (str.at z 30) "t"))))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[+]?([0-9]*[\.\s\-\(\)]|[0-9]+){7,24}$")))
(assert (or (str.suffixof "est</dd>" y) (<= (str.len z) 51)))
(assert (= "<" (str.substr z 9 1)))
(check-sat)
