; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo ondblclick=""alert(1)"">test</bdo>") (= x "<figure onkeypress=""alert(1)"" contenteditable>test</figure>")))
(assert (or (= z "`'><script>\xEF\xBF\xBEjavascript:alert(1)</script>") (= z "e onpaste=""alert(1)"" contenteditable>test</aside>") (= z ";&#93;""&#00; onmouseover=prompt&#40;1&#41;&#47;&#47;"">XYZ</a")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020 u) "^[@_\u{f6}\u{e4}\u{fc}\u{f6}\u{c4}\u{dc}\u{df}\w\s\.]{3,30}$")))
(assert (str.contains y "vascrip"))
(assert (not (= (str.at z 27) "t")))
(assert (or (not (= (str.at z 17) "B")) (not (= (str.at z 3) "o")) (not (= (str.indexof x "<" 0) 0))))
(assert (not (str.suffixof "YZ</a" z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(https?:\/\/)?\w[\w\d\.-]+\.[a-z]{2,}(?:\/.*)?$"))) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([\w-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$")))))
(check-sat)
