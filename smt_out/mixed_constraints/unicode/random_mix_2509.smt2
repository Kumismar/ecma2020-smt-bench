; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer draggable=""true"" ondrag=""alert(1)"">test</footer>") (= x "<input id=x onfocus=alert(1)>") (= x "<article onmouseleave=""alert(1)"">test</article>")))
(assert (or (= z "over=""alert(1)"">test</br>") (= z "nput oncontextmenu=""alert(1)"">test</input>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "(1)>" x)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "[0-9]{3}")))))
(assert (or (= (str.indexof x "(1" 0) 25) (= (str.len y) 71) (str.prefixof "<footer d" y)))
(assert (or (= (str.indexof x "alert" 0) 20) (not (str.suffixof ">" z)) (str.in_re x ((_ re.from_regex ecma2020 u) "[a-z0-9._%+-]+@[a-z0-9.-]+.[a-z]+$"))))
(assert (or (not (= "<article o" (str.substr x 0 10))) (not (= "over=""alert(1)"">te""</br>" (str.replace z "st" """")))))
(assert (or (str.prefixof "nput" z) (not (= "<f<b> draggable=""true"" ondrag=""alert(1)"">test</footer>" (str.replace x "ooter" "<b>")))))
(check-sat)
