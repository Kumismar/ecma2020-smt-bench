(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""97""><!-- IE 5-9 -->") (= x "<style>:target {color: red;}</style><em id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></em>") (= x "<form id=test onforminput=javascript:alert(1)><input></form><button form=test onformchange=javascript:alert(1)>X")))
(assert (or (= z ">") (= z "\x87javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (= "m id=" (str.substr x 4 5)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "[0-9 ]{10,12}")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9-]+$"))) (str.contains x " IE 5-9")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "(?=.*([\w]).*)[ \w]*"))))
