; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link onmousedown=""alert(1)"">test</link>") (= x "<noembed draggable=""true"" ondragstart=""alert(1)"">test</noembed>")))
(assert (or (= z "sefont>") (= z "tofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^[^\s*]([a-zA-Z\u{f1}\u{d1}\u{c0}-\u{ff}0-9.,\s]+){0,500}$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^(\d\d\d|\d\d\d\d)$"))) (= (str.indexof z "o" 0) 1)))
(assert (str.prefixof "<link onmo" x))
(assert (or (not (str.contains z """>test")) (str.contains z "\x00/s")))
(assert (or (not (= (str.len x) 34)) (not (= (str.indexof y "m" 0) 4)) (= "<link onmousedown=""t(1)"">test</link>" (str.replace x """aler" """"))))
(assert (not (str.contains y """>test</")))
(check-sat)
