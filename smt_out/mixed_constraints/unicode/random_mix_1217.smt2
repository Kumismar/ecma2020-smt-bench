; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col draggable=""true"" ondragend=""alert(1)"">test</col>") (= x "<noembed oncut=""alert(1)"" contenteditable>test</noembed>")))
(assert (or (= z "eup=""alert(1)"">test</nobr>") (= z "mmary onclick=""alert(1)"">test</summary>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "eu" z)) (not (str.prefixof "<noemb" x))))
(assert (or (= "ary " (str.substr y 55 4)) (str.in_re y ((_ re.from_regex ecma2020 u) ".{2,64}"))))
(assert (not (str.contains (str.replace y "r" "<b>") "col d<b>agg")))
(assert (not (= "<noembed oncut=""alert(1)"" contalert(1)itable>test</noembed>eup=""alert(1)"">test</nobr>" (str.replace y "ented" "alert(1)"))))
(assert (or (not (str.contains (str.replace z "di" " ") "e tabl")) (not (= (str.at z 10) "(")) (str.contains z "t(1)"">test")))
(assert (not (str.contains z "t(")))
(assert (not (= (str.len x) 53)))
(check-sat)
