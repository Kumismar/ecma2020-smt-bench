; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot oncontextmenu=""alert(1)"">test</tfoot>") (= x "<listing onpaste=""alert(1)"" contenteditable>test</listing>") (= x "<div draggable=""true"" contenteditable>drag me</div><noframes ondragover=alert(1) contenteditable>drop here</noframes>")))
(assert (or (= z " ondrag=""alert(1)"">test</template>") (= z "t(1)"">test</progress>") (= z "46.0007.00000223/"";>;XSS<;/A>;")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len y) 79)) (= (str.at x 17) "o")))
(assert (or (= (str.at y 12) "t") (not (= "ble" (str.substr x 40 3))) (str.contains x "</")))
(assert (or (str.suffixof ";" z) (= (str.at z 1) "o") (not (= "alert(1)tfoot oncontextmenu=""alert(1)"">test</tfoot>" (str.replace x "<" "alert(1)")))))
(assert (or (>= (str.len x) 51) (not (str.in_re x ((_ re.from_regex ecma2020 u) "Zangles")))))
(assert (not (str.suffixof "sting>" x)))
(check-sat)
