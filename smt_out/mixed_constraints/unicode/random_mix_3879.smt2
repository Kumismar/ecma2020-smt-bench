; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 onmouseenter=""alert(1)"">test</h1>") (= x "<bdo onmouseout=""alert(1)"">test</bdo>")))
(assert (or (= z "ut=""alert(1)"" contenteditable>test</dir>") (= z "document.vulnerable=true;</script>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len y) 71)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?=[-_a-zA-Z0-9]*?[A-Z])(?=[-_a-zA-Z0-9]*?[a-z])(?=[-_a-zA-Z0-9]*?[0-9])[-_a-zA-Z0-9]{6,}"))) (= (str.at x 3) "o")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(?:(A[KLRZ]|C[AOT]|D[CE]|FL|GA|HI|I[ADLN]|K[SY]|LA|M[ADEINOST]|N[CDEHJMVY]|O[HKR]|P[AR]|RI|S[CD]|T[NX]|UT|V[AIT]|W[AIVY]))$"))))
(assert (not (= (str.len y) 50)))
(assert (or (= (str.at z 15) "a") (= (str.indexof z "pt>" 0) 31) (not (= (str.indexof z "es" 0) 31))))
(check-sat)
