; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><article onload=alert(1)></article>") (= x "<style>#x{font-famil\u{1f600}y:foo[bar;color:green;}#y];color\u{10348}:red;{}</style>//[""'`-->]]>]</div>") (= x "<thead onfocusout=alert(1) tabindex=1 id=x></thead><input autofocus>")))
(assert (or (= z "foot draggable=""true"" ondragleave=""alert(1)"">test</tfoot>") (= z "nbeforecopy=""alert(1)"" contenteditable>test</rtc>") (= z "able=""true"" ondragend=""alert(1)"">test</legend>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "ocus>" x)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[0-9][0-9AB][0-9]+$")) (str.suffixof "rtc>" z)))
(assert (str.prefixof "<styl" x))
(assert (or (not (str.prefixof "<ar" y)) (not (str.suffixof "ticle>" x)) (str.contains (str.replace x "onfoc" "javascript:") " javascript:uso")))
(assert (not (= (str.at z 9) "p")))
(assert (or (not (str.contains z "t(1)"">t")) (str.contains y "rue"" ondra")))
(check-sat)
