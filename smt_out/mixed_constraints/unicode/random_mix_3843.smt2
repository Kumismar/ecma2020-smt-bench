; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img draggable=""true"" ondragstart=""alert(1)"">test</img>") (= x "<label onfocusout=alert(1) tabindex=1 id=x></label><input autofocus>") (= x "<base onmouseout=""alert(1)"">test</base>")))
(assert (or (= z "nanimationend=""alert(1)""></link>") (= z "editable>test</dl>") (= z "SS by \nxss"")</script><marquee><h1>XSS by xss</h1></marquee>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020 u) "[\u{3041}-\u{3093}\s\u{3000}]+"))) (str.contains z "d=""ale") (str.suffixof "test</dl>" y)))
(assert (or (str.prefixof "nanim" z) (str.suffixof "k>" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "\d{1,5}-\d{1,4}-\d{3,5}"))) (not (str.contains x "nmouseou")) (= "nanimatione<b>alert(1)""></link>" (str.replace z "nd=""" "<b>"))))
(assert (or (= (str.indexof x "ggab" 0) 8) (not (str.in_re z ((_ re.from_regex ecma2020 u) "[A-z0-9._%+-]{1,127}@[A-z0-9.-]+\.[A-z]{2,3}$"))) (str.prefixof "<bas" y)))
(assert (str.prefixof "<label on" x))
(check-sat)
