; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track draggable=""true"" ondragenter=""alert(1)"">test</track>") (= x "<data onmouseout=""alert(1)"">test</data>")))
(assert (or (= z "r=""alert(1)"">test</rtc>") (= z "test</tr>") (= z "form>")))
(assert (= y (str.++ x z)))
(assert (or (= "st</data>" (str.substr x 30 10)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^\D{1,15}$"))) (= (str.indexof z "form" 0) 0)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020 u) "^([a-z][0-9a-z_.]*[a-z0-9])$"))) (= "form>" (str.substr z 0 5)) (= (str.indexof z "</" 0) 12)))
(assert (not (str.contains y "ata onmo")))
(assert (or (= "er=""alert(" (str.substr x 33 10)) (not (str.prefixof "<data " y))))
(assert (or (not (str.prefixof "test</t" z)) (str.suffixof "k>" x) (not (= (str.at x 39) "e"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "^([\w\.\-]+)@([\w\-]+)((\.(\w){2,6})+)$"))) (= "orm>" (str.replace z "f" ""))))
(check-sat)
