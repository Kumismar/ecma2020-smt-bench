; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;EMBED SRC=&quot;http://ha.ckers.org/xss.swf&quot; AllowScriptAccess=&quot;always&quot;&gt;&lt;/EMBED&gt;") (= x "<strike onmouseup=""alert(1)"">test</strike>") (= x "<svg draggable=""true"" ondrag=""alert(1)"">test</svg>")))
(assert (or (= z "yframes x{}</style><xmp style=""animation-name:x"" onanimationend=""alert(1)""></xmp>") (= z "ndex=1 onfocusin=alert(1)></xmp>") (= z "listing>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "abl" 0) 10)) (str.contains y "ue"" o") (not (= "&lt;EM<b>SRC=&quot;http://ha.ckers.org/xss.swf&quot; AllowScriptAccess=&quot;always&quot;&gt;&lt;/EMBED&gt;" (str.replace x "BED " "<b>")))))
(assert (or (= (str.indexof y "XS" 0) 70) (not (= "<style>:target {transform: rotate(180deg);}</style><applet id=x style=""txtion:transform 2s"" ontransitionrun=alert(1)></applet>" (str.replace x "ransi" "x")))))
(assert (or (not (str.prefixof "<s" x)) (not (str.in_re y ((_ re.from_regex ecma2020 u) "((?=.*\d)(?=.*[a-zA-Z]).{8,20})")))))
(assert (or (not (str.contains x "lwa")) (>= (str.len y) 121) (not (>= (str.len z) 31))))
(assert (or (<= (str.len x) 111) (= "lisxng>" (str.replace z "ti" "x")) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^(\+0?1\s)?\(?[2-9]{1}[0-9]{2}\)?[\s.-]?\d{3}[\s.-]?\d{4}$")))))
(assert (= (str.indexof z "<" 0) 26))
(check-sat)
