; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section draggable=""true"" ondragstart=""alert(1)"">test</section>") (= x "<spacer onmouseleave=""alert(1)"">test</spacer>") (= x "<rp onpaste=""alert(1)"" contenteditable>test</rp>")))
(assert (or (= z "mp>") (= z """ contenteditable>test</noscript>") (= z "table>test</code>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "st</"))
(assert (or (not (= (str.at y 66) "l")) (= "t</space" (str.substr x 35 8)) (not (= (str.at x 14) "="))))
(assert (or (str.prefixof "<spacer on" y) (str.contains y "editable>") (str.suffixof "/section>" x)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020 u) "([a-zA-Z\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{f1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}]{3,}[\s]*)+")) (not (str.prefixof "<rp onpa" x)) (not (str.in_re z ((_ re.from_regex ecma2020 u) "a.*z")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "^(0[0-9]|1[0-9]|2[0-3]):([0-5][0-9])$"))))
(assert (not (str.prefixof "<secti" y)))
(check-sat)
