; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><tfoot id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tfoot>") (= x "<dt onfocusout=alert(1) tabindex=1 id=x></dt><input autofocus>") (= x "ABC<div style=""x:\xEF\xBB\xBFexpress\u{1f600}ion(javascript:alert(1)"">DEF")))
(assert (or (= z "ggable=""true"" contenteditable>drag me</div><content ondragover=alert(1) contenteditable>drop here</content>") (= z "ggable=""true"" ondrag=""alert(1)"">test</ruby>")))
(assert (= y (str.++ x z)))
(assert (or (= "ag=""aler" (str.substr z 18 8)) (= (str.indexof z "a" 0) 2) (str.contains x "usout")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "[A-z0-9._%+-]+@[A-z0-9-]+\.[A-z]{2,6}$"))) (not (= "ansform 2s" (str.substr x 83 10)))))
(assert (or (not (str.prefixof "ABC" x)) (str.prefixof "ABC<d" y) (not (= (str.indexof z "ble>" 0) 26))))
(assert (or (not (= (str.indexof y "/tfo" 0) 121)) (not (= "<style>:target {color:red;}</style><base id=x style=""transitx:color 1s"" ontransitionend=alert(1)></base> id=y autofocus>" (str.replace y "ion" "x")))))
(assert (or (str.contains x "\xBB\xBF") (str.contains y "lert") (str.prefixof "gga" z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020 u) "^.*?([A-Za-z0-9_-]+\.myshopify\.com).*$")) (<= (str.len y) 173)))
(check-sat)
