; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=JaVaScRiPt:alert('XSS')>") (= x "<style>:target {color: red;}</style><ruby id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></ruby>")))
(assert (or (= z "alert(1)></colgroup>") (= z """>test</cit\u{1f4a9}e>") (= z "e=alert(1)>hover this!")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "e=" 0) 0) (str.suffixof "('XSS')>" x) (= (str.at y 4) "l")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020 u) "[A-Z,a-z,0-9,\- ]*")) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[a-zA-Z0-9_+\-%]+[a-zA-Z0-9_.+\-%]+[a-zA-Z0-9_+\-%]+@(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}$")))))
(assert (or (not (str.suffixof ")>" x)) (not (= "<IMG SRC=JaVa Pt:alert('XSS')>" (str.replace x "ScRi" " ")))))
(assert (not (= "v" (str.substr z 13 1))))
(check-sat)
