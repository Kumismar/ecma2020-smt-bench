; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog id=x tabindex=1 onbeforeactivate=alert(1)></dialog>") (= x "<div draggable=""true"" contenteditable>drag me</div><style ondrop=alert(1) contenteditable>drop here</style>")))
(assert (or (= z "art=""alert(1)"">test</template>") (= z "log>") (= z "\u{20000}eforecut=""alert(1)"" contented\u{20000}itable>test</audio>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 134) (not (str.suffixof "/dialog>" x)) (str.contains x "nd")))
(assert (or (= "e=""tr" (str.substr x 13 5)) (str.in_re z ((_ re.from_regex ecma2020 u) "^[A-Za-z0-9]{4,20}$"))))
(assert (not (= (str.indexof y "ty" 0) 53)))
(assert (or (str.prefixof "<div " y) (str.suffixof "style>log>" y)))
(check-sat)
