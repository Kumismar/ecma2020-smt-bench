; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a onclick=""alert(1)"">test</a>") (= x "<ScRi\u{20000}Pt>alert\u{1d400}(1)</sCriPt>")))
(assert (or (= z "nteditable>drop here</bdo>") (= z "/marquee>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "t>al" 0) 7)) (str.contains y "/li>")))
(assert (or (str.contains x "\u{20000}Pt>al") (not (= (str.at z 1) "m"))))
(assert (or (not (= (str.indexof z "/mar" 0) 0)) (str.suffixof ">" x) (not (str.in_re z ((_ re.from_regex ecma2020 u) "^[a-zA-Z ]+$")))))
(assert (or (not (str.prefixof "ntedi" z)) (not (str.prefixof "/marque" z))))
(assert (or (= "t>alert\u{1d400}(" (str.substr x 7 9)) (str.prefixof "<ScRi\u{20000}" x) (str.contains (str.replace y ")<" """") "rt\u{1d400}(1""/s")))
(assert (= "arCo" (str.substr z 2 4)))
(assert (= (str.at y 45) "r"))
(check-sat)
