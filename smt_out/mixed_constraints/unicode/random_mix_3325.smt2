; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span onblur=alert(1) tabindex=1 id=x></span><input autofocus>") (= x "<style>:target {transform: rotate(180deg);}</style><form id=x style=""transiti\u{20000}on:transform 2s"" ontrans\u{1f600}itionrun=alert(1)></form>") (= x "<dt id=x tabindex=1 ondeactivate=alert(1)></dt><input id=y autofocus>")))
(assert (or (= z "table>") (= z "r=""alert(1)""\u{20000}>test</textarea>") (= z "1)"">test</h1>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 45) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^[Bb]\d{8}")))))
(assert (or (str.prefixof "1)"">tes" z) (str.suffixof ">table>" y) (str.contains y "}</styl")))
(assert (or (not (str.prefixof "1)"">" z)) (str.prefixof "<s" x) (str.contains x "=x></span")))
(assert (or (= "<dt id=x tabindex=1 ondeactivate=alert(1)></dt><input id=y au ocus>1)"">test</h1>" (str.replace y "tof" " ")) (not (>= (str.len z) 25))))
(assert (or (<= (str.len z) 37) (= "1)"">tealert(1)/h1>" (str.replace z "st<" "alert(1)")) (str.in_re y ((_ re.from_regex ecma2020 u) "^((\+92)|(0092)|(0)|(92))\d{10}$"))))
(assert (or (not (= (str.at y 50) "t")) (not (= (str.at x 87) "o"))))
(check-sat)
