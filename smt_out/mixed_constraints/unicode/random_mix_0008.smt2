; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address ondblclick=""alert(1)"">test</address>") (= x "<body onPropertyChange body onPropertyChange=""javascript:javascript:alert(1)""></body onPropertyChange>") (= x "<style>:target {color:red;}</style><b id=x style=""transition:color 1s"" ontransitionend=alert(1)></b>")))
(assert (or (= z "dragstart=""alert(1)"">test</h1>") (= z "ex=1 onactivate=alert(1)></dialog>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "</") (not (str.in_re z ((_ re.from_regex ecma2020 u) "(?!^\s+$)[A-z\u{c0}-\u{17e}\s\-\.]{1,40}")))))
(assert (or (= "/body onPr" (str.substr x 79 10)) (not (str.contains y "</h")) (str.prefixof "<b" y)))
(assert (or (= (str.indexof z "d" 0) 27) (= (str.len y) 132)))
(assert (not (str.suffixof "h1>" y)))
(assert (= (str.indexof z "al" 0) 11))
(check-sat)
