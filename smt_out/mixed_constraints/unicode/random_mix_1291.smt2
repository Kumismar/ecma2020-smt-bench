; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rt onblur=alert(1) tabindex=1 id=x></rt><input autofocus>") (= x "<spacer onmousemove=""alert(1)"">test</spacer>")))
(assert (or (= z ">test</input>") (= z ")""></rp>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020 u) "(^((0\d{2,3})-)(\d{7,8})(-(\d{3,}))?$)|(^1((3|5|8){1}\d{1}|70)\d{8}$)"))))
(assert (or (not (str.suffixof "p>" y)) (not (= (str.at z 0) ">"))))
(assert (or (not (str.suffixof ")""></rp>" z)) (not (str.contains z "/rp>"))))
(assert (or (not (str.suffixof "put>" z)) (not (str.in_re x ((_ re.from_regex ecma2020 u) "^((\+?32)?(4)\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d)|((04)\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d\s?\d)$")))))
(assert (= "</s" (str.substr y 35 3)))
(check-sat)
