; random_mix, Unicode mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onemptied=""alert(String.fromCharCode(88,83,83))"">") (= x "<applet onmouseenter=""alert(1)"">test</applet>")))
(assert (or (= z "id=x></select><input autofocus>") (= z "style>@keyframes x{}</style><svg style=""animation-name:x"" onanimationend=""alert(1)""></svg>") (= z """>test</input>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 19) "d") (= """ contenteditable>te<b>/small>" (str.replace z "st<" "<b>"))))
(assert (= "<applet onmouseenter=""alert(1)""t</applet>" (str.replace x """>tes" """")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020 u) "(^$|[0-9]+)"))) (not (str.contains x "nemptied"))))
(assert (or (not (= (str.indexof x "</app" 0) 36)) (not (str.suffixof ")""></svg>" z)) (not (= (str.at z 27) ">"))))
(assert (or (not (str.prefixof "style>@" z)) (str.contains x "romCharC") (str.contains x "/html")))
(check-sat)
