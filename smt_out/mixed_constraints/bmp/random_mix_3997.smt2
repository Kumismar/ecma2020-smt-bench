; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<code id=x tabindex=1 onbeforeactivate=alert(1)></code>") (= x "<form onmousemove=""al\u{1f600}ert(1)"">te\u{1d400}st</form>")))
(assert (or (= z "te body onPopState=""javascript:javascript:alert(1)""></body\u{1f4a9} onPopState>") (= z "onblur=alert(1) tabindex=1 id=x></aside><input autofocus>") (= z "avascript:javascript:alert(1)></frameset>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-f0-9]*$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "(^\d{5}(-\d{4})?$)|(^[abceghjklmnprstvxyABCEGHJKLMNPRSTVXY]{1}\d{1}[A-Za-z]{1} *\d{1}[A-Za-z]{1}\d{1}$)"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "(?=.*?[\u{5c}u3041-\u{5c}u309F\u{5c}u30FC])[\u{5c}u3041-\u{5c}u309F\u{5c}u30FC\s]*"))) (not (= (str.indexof x ")""" 0) 27))))
(assert (not (<= (str.len y) 132)))
(assert (not (= (str.at z 4) "c")))
(assert (or (not (= "\u{1d400}s" (str.substr x 32 2))) (= (str.at z 14) "t") (not (= (str.len y) 96))))
(assert (or (str.contains z """java") (= "set>" (str.substr y 92 9)) (str.prefixof "<code id=x" y)))
(assert (str.suffixof "meset>" y))
(assert (not (str.contains z "tes")))
(check-sat)
