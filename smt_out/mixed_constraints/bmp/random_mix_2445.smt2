; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img srcset=1 onerror=alert(1)>") (= x "<datalist onkeypress=""alert(1)"" contenteditable>test</datalist>")))
(assert (or (= z " onbounce=alert(1)>XSS</marquee>") (= z "Error>")))
(assert (= y (str.++ x z)))
(assert (or (= "XSS</marqu" (str.substr z 19 10)) (= (str.at y 28) "1") (not (str.in_re x ((_ re.from_regex ecma2020) ".*^[2-9]\d{2}-\d{3}-\d{4}$.*")))))
(assert (<= (str.len x) 68))
(assert (or (= ";/" (str.substr x 75 2)) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9]{10}"))) (str.in_re x ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{44f}a-zA-z,\s]+$"))))
(assert (or (= (str.indexof z "htm" 0) 3) (= "rt(1)"" c" (str.substr x 25 8))))
(assert (str.suffixof "marquee>" z))
(check-sat)
