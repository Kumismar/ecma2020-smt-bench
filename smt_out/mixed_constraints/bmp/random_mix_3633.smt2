; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend onmousedown=""alert(1)"">test</legend>") (= x "<svg><noscript onload=alert(1)></noscript>")))
(assert (or (= z "lert(1)"">test</video>") (= z ">") (= z "st</param>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 18) "n") (not (= (str.len y) 147)) (not (str.in_re x ((_ re.from_regex ecma2020) "^^[a-zA-Z]+[- a-zA-Z]*")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^\d+(,\d+$)?"))))
(assert (= (str.indexof z "/ifr" 0) 9))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9\u{e01}-\u{e5b}.,:\(\)@\-\/\s]{0,1000}$"))) (= "<leend onmousedown=""alert(1)"">test</legend>" (str.replace x "g" ""))))
(assert (= (str.indexof x "wn=" 0) 17))
(check-sat)
