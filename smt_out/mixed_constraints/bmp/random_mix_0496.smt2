; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<OBJECT TYPE=""tex\u{1f600}t/x-scriptlet""\u{1f4a9} DATA=""http://ha.ckers.org/scriptlet.html""></OBJECT>") (= x "<em id=x tabindex=1 onbeforedeactivate=alert(1)></em><input autofocus>")))
(assert (or (= z "ipt>alert(document.head.childNodes[3].text)</script>") (= z "v\u{1f600} ondblclick=""alert(1)"">test</nav>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^([\w\+-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$")) (= (str.at x 18) "1")))
(assert (or (not (= (str.at x 52) ">")) (not (= """60" (str.replace z "#" """"))) (= (str.at y 4) "i")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[^\s]+.*$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\u{e4}\u{c4}\u{eb}\u{cb}\u{ef}\u{cf}\u{f6}\u{d6}\u{fc}\u{dc}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{c2}\u{ca}\u{ce}\u{d4}\u{db}\u{e2}\u{ea}\u{ee}\u{f4}\u{fb}\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9} _-]{3,30}$"))))
(assert (str.prefixof "v\u{1f600} ondblc" z))
(check-sat)
