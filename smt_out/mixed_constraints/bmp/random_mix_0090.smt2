; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<obj\u{20000}ect data=data:text/html;base64,PHN2Zy9vbmxvYWQ9YWxlcnQoMik+></object>") (= x "<select onfocusout=alert(1) id=x><\u{1f600}/select><input autofocus>") (= x "<strong draggable=""true"" ondrag=""alert(1)"">test</s\u{1d400}trong>")))
(assert (or (= z "foot onkeypress=""alert(1)"" contenteditable>test</tfoot>") (= z ")"">test</ul>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 42) "9") (= (str.len y) 83)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "(https?:\/\/(?:www\.|(?!www))[a-zA-Z0-9][a-zA-Z0-9-]+[a-zA-Z0-9]\.[^\s]{2,}|www\.[a-zA-Z0-9][a-zA-Z0-9-]+[a-zA-Z0-9]\.[^\s]{2,}|https?:\/\/(?:www\.|(?!www))[a-zA-Z0-9]+\.[^\s]{2,}|www\.[a-zA-Z0-9]+\.[^\s]{2,})"))) (not (str.contains (str.replace x "64,P" "<b>") ";base<b>HN2Zy")) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+.[a-z]{2,4}$")))))
(assert (or (not (= "<obj\u{20000}ect data=data:text/html;basexHN2Zy9vbmxvYWQ9YWxlcnQoMik+></object>foot onkeypress=""alert(1)"" contenteditable>test</tfoot>" (str.replace y "64,P" "x"))) (str.contains y "/selec")))
(assert (or (str.contains y "=""a") (= "</p>" (str.replace z "r" ""))))
(check-sat)
