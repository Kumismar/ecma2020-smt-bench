; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<BODY ONLOAD=alert('XSS')>") (= x "<param onpaste=""alert(1)"" contenteditable>test</param>")))
(assert (or (= z "rt(1)><option>1<option>2") (= z " on\u{10348}\u{10348}pageshow=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "t(1)>" y)) (str.contains x "x3C")))
(assert (or (not (str.prefixof "1)"" c" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{4,20}$")))))
(assert (not (= "D=alert" (str.substr y 11 7))))
(assert (= (str.indexof x "Y ONL" 0) 4))
(assert (not (str.prefixof "e=alert(1" z)))
(assert (not (str.contains z "1<option")))
(check-sat)
