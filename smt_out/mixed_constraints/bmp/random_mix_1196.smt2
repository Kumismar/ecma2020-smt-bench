; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><s\u{1f4a9}cript src=//brutelogi\u{1d400}c.com.br&sol;1.js&num;") (= x "&lt;LINK REL=\""stylesheet\"" HREF=\""javascript&#058;alert('XSS');\""&gt;")))
(assert (or (= z "ck=""alert(1)"">test</frame>") (= z "est</menu>\u{20000}")))
(assert (= y (str.++ x z)))
(assert (<= (str.len x) 70))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^(13[0-9]|15[0-9]|18[0-9])d{8}$")))
(assert (or (not (= "m" (str.substr z 26 1))) (str.prefixof "<div d" x) (str.suffixof ";1.js&num;" x)))
(assert (or (not (str.suffixof "st</frame>" z)) (= "est</m" (str.substr z 0 6))))
(assert (not (= (str.indexof z "u>\u{20000}" 0) 8)))
(assert (= (str.indexof z "t</me" 0) 2))
(assert (not (str.contains (str.replace y "heet\" """") "yles""""")))
(assert (or (= "er oncx""alert(1)"" contenteditable>test</footer>" (str.replace z "opy=" "x")) (not (str.suffixof "index>" y))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[\d+]{12}$"))))
(check-sat)
