; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<font onmouseup=""alert(1)"">test</font>") (= x "<video autoplay controls onseeked=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= x "&#X003C")))
(assert (or (= z "ert(1)"">test</big>") (= z "ange>") (= z "ink oncontextmenu=""alert(1)"">test</link>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "t>" 0) 36) (not (str.in_re x ((_ re.from_regex ecma2020) "^(13[0-9]|14[5|7]|15[0|1|2|3|5|6|7|8|9]|18[0|1|2|3|5|6|7|8|9])[0-9]{8}$")))))
(assert (not (= (str.indexof y """ o" 0) 59)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{5c}u4e00-\u{5c}u9fa5]+$"))) (not (= (str.at x 18) "e"))))
(assert (or (not (= "control" (str.substr x 16 7))) (str.contains y "test</font")))
(assert (not (str.suffixof "nge>" z)))
(assert (or (str.suffixof "/link>" z) (not (str.contains z "ng"))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[a-z0-9]+([\-\.]{1}[a-z0-9]+)*\.[a-z]{2,20}(:[0-9]{1,5})?(\/.*)?$")))
(check-sat)
