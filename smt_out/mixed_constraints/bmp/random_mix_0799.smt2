; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp oncut=""alert(1)"" contenteditable>test</xmp>") (= x "<D3/OnpOinTeReENter=confirm``>click here") (= x "<div draggable=""true"" contenteditable>drag me</div><noframes ondragover=alert(1) contenteditable>drop here</noframes>")))
(assert (or (= z "</script>") (= z """alert(1)"">test</keygen>") (= z "keyup=""alert(1)"" contenteditable>test</tr>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof ">" y))
(assert (not (= (str.at z 9) "e")))
(assert (or (= ">" (str.substr z 23 5)) (not (= (str.indexof y "ditab" 0) 30))))
(assert (or (str.suffixof "ick here" x) (not (str.contains x "=""al")) (= (str.indexof z "d" 0) 25)))
(assert (or (not (str.contains (str.replace z "ript>" " ") "</sc ")) (not (str.suffixof "ere" x)) (not (str.prefixof "<div dr" y))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,})$"))) (= (str.at z 19) "t")))
(check-sat)
