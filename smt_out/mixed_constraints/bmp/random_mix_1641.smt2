; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link draggable=""true"" ondragleave=""alert(1)"">test</link>") (= x "<menu oncut=""alert(1)"" contenteditable>test</menu>")))
(assert (or (= z "svg><div onload=alert(1)></div>") (= z " id=x tabindex=1 onactivate=alert(1)></img>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (str.prefixof ">" z))
(assert (not (= (str.at z 0) ">")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z-\u{f1}\u{d1}\u{e1}\u{e9}\u{f3}\u{ed}\u{fa}\u{c1}\u{c9}\u{d3}\u{cd}\u{da} ]{1,60}$")) (not (= (str.indexof y "nten" 0) 25))))
(assert (or (not (str.contains (str.replace x "<d" "javascript:") "javascript:d")) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?!-)[a-zA-Z0-9-]+$"))) (= ")></img>" (str.substr y 92 9))))
(assert (or (not (= "teditable" (str.substr x 29 9))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[1-9][0-9]{7}$"))) (not (str.contains (str.replace z "></di" "alert(1)") "(1)alert(1)v>"))))
(check-sat)
