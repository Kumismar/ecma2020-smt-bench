; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<SCRIPT>a=/XSS/") (= x "<progress onpaste=""alert(1)"" contenteditable>test</progress>") (= x "<tt draggable=""true"" ondragend=""alert(1)"">test</tt>")))
(assert (or (= z """alert(1)"" contenteditable>test</embed>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 15) "t")) (not (str.in_re x ((_ re.from_regex ecma2020) "^Nom$"))) (str.in_re z ((_ re.from_regex ecma2020) "[1-2]{1}[0-9]{3}-[0-1]{1}[0-9]{1}-[0-3]{1}[0-9]{1}"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}]+$"))) (str.suffixof "ont>" y) (not (>= (str.len x) 13))))
(assert (str.prefixof "<div dra" x))
(assert (= (str.indexof x "rogr" 0) 2))
(assert (not (= "<SCRIPT>a=" (str.substr y 0 10))))
(check-sat)
