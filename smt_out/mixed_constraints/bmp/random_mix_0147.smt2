; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div style=""list-style:url(http://foo.f)\20url(javascript:javascript:alert(1));"">X") (= x "<datalist draggable=""true"" ondrag=""alert(1)"">test</datalist>") (= x "<main onblur=alert(1) tabindex=1 id=x></main><input autofocus>")))
(assert (or (= z "onb\u{20000}lur=alert(1) tabindex=1 id=x></sub><input autofocus>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (str.contains x """>test</d"))
(assert (= "ttp:" (str.substr x 28 4)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[0-9a-z._-]+@{1}[0-9a-z.-]{2,}[.]{1}[a-z]{2,5}$")) (not (= (str.at x 3) "i")) (= (str.indexof z "dex" 0) 22)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[+]?([0-9]*[\.\s\-\(\)]|[0-9]+){7,24}$"))) (str.suffixof "s>>" y) (str.prefixof "<main" y)))
(assert (or (str.prefixof ">" z) (>= (str.len x) 60)))
(assert (or (not (= (str.indexof x "list" 0) 12)) (not (<= (str.len y) 87)) (str.contains y "ain onb")))
(assert (or (not (str.contains (str.replace z "rm(" "javascript:") "javascript:)//")) (not (str.prefixof "<datalis" y))))
(check-sat)
