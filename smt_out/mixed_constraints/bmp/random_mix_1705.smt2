; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ins onpaste=""alert(1)"" contenteditable>test</ins>") (= x "&lt;SCRIPT a=\""&gt;\"" '' SRC=\""http&#58;//ha&#46;ckers&#46;org/xss&#46;js\""&gt;&lt;/SCRIPT&gt;")))
(assert (or (= z "id=x tabindex=1 onbeforeactivate=alert(1)></base>") (= z "*/alert(document.location)/**/</script &#32; :-(")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "nput id=y ")) (not (str.contains (str.replace x "t</" "x") "sxins")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[^\s*]([a-zA-Z\u{f1}\u{d1}\u{c0}-\u{ff}\s]+){0,150}$")))))
(assert (or (not (= "<javascript:s onpaste=""alert(1)"" contenteditable>test</ins>" (str.replace x "in" "javascript:"))) (= (str.indexof x "#46;" 0) 45)))
(assert (or (= "e>@key" (str.substr y 5 6)) (not (= (str.at z 11) "u")) (not (= (str.indexof z "atio" 0) 20))))
(assert (str.contains z "aler"))
(assert (or (str.prefixof "id=x" z) (not (= (str.indexof x "ted" 0) 30))))
(assert (str.contains x "CRIPT"))
(check-sat)
