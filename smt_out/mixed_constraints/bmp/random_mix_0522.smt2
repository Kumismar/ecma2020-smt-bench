; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link id=x tabindex=1 onbeforeactivate=alert(1)></link>") (= x "<spacer onmouseover=""alert(1)"">test</spacer>")))
(assert (or (= z "n>") (= z "log>") (= z "le>test</summary>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^(?:http(s)?:\/\/)?[\w.-]+(?:\.[\w\.-]+)+[\w\-\._~:/?#[\]@!\$&'\(\)\*\+,;=.]+$")) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{2}(\s?|[\.]?)\d{3})?$")))))
(assert (or (not (str.contains y "d=x ta")) (str.in_re x ((_ re.from_regex ecma2020) "^[2-4][0-9]{5}$")) (= "og>" (str.substr y 56 7))))
(assert (<= (str.len x) 50))
(assert (or (not (= (str.at z 0) "l")) (not (= (str.indexof y "nd" 0) 41))))
(check-sat)
