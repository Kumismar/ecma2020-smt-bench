; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><select onload=alert(1)></select>") (= x "<bdo id=x tabindex=1 ondeactivate=alert(1)></bdo><input id=y autofocus>") (= x "<style>:target {transform: rotate(180deg);}</style><shadow id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></shadow>")))
(assert (or (= z "f389><param name=url value=javascript:document.vulnerable=true></object>") (= z "dex=1 onactivate=alert(1)></progress>") (= z "eactivate=alert(1)></rp>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "s>" x)) (not (>= (str.len x) 128))))
(assert (or (str.contains y "lne") (= ")"">test</" (str.substr z 11 9))))
(assert (not (= "<svg><select onload=alert(1)></select>f 89><param name=url value=javascript:document.vulnerable=true></object>" (str.replace y "3" " "))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{f1}\u{d1} ]{1,50}"))))
(assert (or (str.contains (str.replace x "de" "x") "binxx=") (not (= (str.indexof y "t" 0) 11)) (str.prefixof "dex=1 on" z)))
(assert (or (str.contains z "er") (not (str.suffixof ">" z))))
(check-sat)
