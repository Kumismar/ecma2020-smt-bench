; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "0\""autofocus/onfocus=alert(1)--><video/poster/ error=prompt(2)>""-confirm(3)-""") (= x "<strong onkeydown=""alert(1)"" contenteditable>test</strong>")))
(assert (or (= z "nteditable>test</col>") (= z "useenter=""alert(1)"">test</canvas>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[1-9]{1}|(?:1)[0-9]{1}"))) (not (= (str.indexof y "/pos" 0) 38))))
(assert (not (<= (str.len x) 63)))
(assert (or (str.contains (str.replace y "</col" "x") ">testx>") (not (= "(1)-->" (str.substr y 26 6))) (str.suffixof "</canvas>" z)))
(assert (or (not (str.suffixof ">" y)) (not (= (str.at y 83) "e")) (not (= "<strong onkxydown=""alert(1)"" contenteditable>test</strong>useenter=""alert(1)"">test</canvas>" (str.replace y "e" "x")))))
(assert (or (str.contains z "lert(1)""") (not (str.in_re x ((_ re.from_regex ecma2020) "^\d*(\.\d{0,1})?$")))))
(assert (<= (str.len z) 33))
(check-sat)
