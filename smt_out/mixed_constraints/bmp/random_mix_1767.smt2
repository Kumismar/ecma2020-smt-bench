; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title onmouseout=""alert(1)"">test</title>") (= x "<keygen id=x \u{1f600}tabindex=1 onbeforeactivate=alert(1)></keygen>") (= x "<iframe id=x onfocusin=alert(1)>")))
(assert (or (= z "ntextmenu=""alert(1)"">test</plaintext>") (= z "#X003C;") (= z "nteditable>drop here</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 80) (not (= (str.indexof z "e" 0) 2))))
(assert (= (str.at z 25) "o"))
(assert (not (str.contains z "#X003")))
(assert (or (str.contains x "activa") (str.suffixof ">" x) (not (= (str.indexof x " " 0) 7))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}]+$"))))
(assert (= "c" (str.substr y 17 1)))
(check-sat)
