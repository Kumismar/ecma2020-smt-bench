; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><sup id=x style=""transition:color 1s"" ontransitionend=alert(1)></sup>") (= x "<\u{10348}element ondblclick=""alert(1)"">test</element>") (= x "<meta onmouseover=""alert(1)"">test</meta>")))
(assert (or (= z "id=x></del><input autofocus>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (= "id=x></del><input autofalert(1)" (str.replace z "ocus>" "alert(1)")))
(assert (or (= (str.at z 0) ">") (= (str.indexof y ">test" 0) 28)))
(assert (or (not (= (str.indexof z "utof" 0) 19)) (= "/" (str.substr z 6 1))))
(assert (or (= (str.len x) 40) (= (str.indexof z "ex" 0) 3)))
(assert (or (= "lor 1s"" " (str.substr x 65 8)) (not (str.in_re y ((_ re.from_regex ecma2020) "^(0[1-9]|1[012])[\/](0[1-9]|[12][0-9]|3[01])$")))))
(check-sat)
