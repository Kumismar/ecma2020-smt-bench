; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onmousemove=""alert(1)"">test</body>") (= x "<command oncontextmenu=""alert(1)"">test</command>") (= x "<IMG SRC=javascript:alert('XSS')>")))
(assert (or (= z "le=""true"" ondragend=""alert(1)"">test</big>") (= z "t(1)"">test</template>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "83))"">" y) (str.contains z "ondrag") (= "big>" (str.substr z 37 8))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(?!0\.00)[1-9]\d{0,7}(,\d{3})*(\.\d{0,4})?$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w\.+\-_]+@([\w\d-]+\.)+[\w]{2,12}$"))) (not (= "<IMG SRC=javascripalert(1)alert('XSS')>" (str.replace x "t:" "alert(1)")))))
(assert (or (str.contains x "</h") (not (str.contains (str.replace x "mouse" "<b>") " on<b>move="))))
(assert (= (str.indexof y "ig" 0) 71))
(assert (<= (str.len z) 43))
(assert (or (= (str.at x 18) "t") (not (= "l=""true"" ondragend=""alert(1)"">test</big>" (str.replace z "e" "")))))
(assert (= (str.at y 41) "("))
(check-sat)
