; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style draggable=""true"" ondragstart=""alert(1)"">test</style>") (= x "`""'><img src=xxx:x \x0Conerror=javascript:alert(1)>") (= x "<style>:target {color:red;}</style><body id=x style=""transition:color 1s"" ontransitionend=alert(1)></body>")))
(assert (or (= z "ipt a=\u{5c}u0061 & /=%2F") (= z "onbeforepaste=""alert(1)"" contenteditable>test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "plaintext>" z) (not (str.suffixof "test</svg>" z))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "(?!.*@.*).*"))) (str.prefixof "<style" y) (not (<= (str.len z) 30))))
(assert (or (str.contains y "src=x") (= "=\" (str.substr z 5 2)) (not (str.prefixof "<style dra" x))))
(assert (not (>= (str.len y) 122)))
(assert (or (str.prefixof "`""" y) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]{2,}\.[a-z]{2,}$")))))
(assert (not (= (str.at y 75) "=")))
(check-sat)
