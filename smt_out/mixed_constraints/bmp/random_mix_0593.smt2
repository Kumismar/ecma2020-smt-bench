; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike onmouseover=""alert(1)"">test</strike>") (= x "<dl onbeforecut=""alert(1)"" contenteditable>test</dl>")))
(assert (or (= z "=""\u{1f4a9}alert(1)""\u{1d400}></element>") (= z "ert(1)"" contenteditable>test</thead>") (= z "PT>;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<dl o" x)) (>= (str.len z) 7) (= ">;" (str.substr z 2 5))))
(assert (or (not (str.contains z "e>t")) (= (str.at z 7) " ") (= "sition:tra" (str.substr y 131 10))))
(assert (or (not (str.prefixof "ert(" z)) (= "<strike onseover=""alert(1)"">test</strike>PT>;" (str.replace y "mou" ""))))
(assert (or (not (= (str.at x 17) "e")) (= "edita" (str.substr y 34 5))))
(assert (not (= (str.at z 11) "t")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9+]+"))) (not (>= (str.len z) 3))))
(check-sat)
