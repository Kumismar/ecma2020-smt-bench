; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><tr id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tr>") (= x "<strong draggable=""true"" ondragleave=""alert(1)"">test</strong>")))
(assert (or (= z "76-0080c744f389><param name=url value=javascript:javascript:alert(1)></OBJECT>") (= z "id=x tabindex=1 ondeactivate=alert(1)></strong><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<style>:t" y)))
(assert (or (not (<= (str.len z) 71)) (str.suffixof "/strong>" x) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z ]+$")))))
(assert (str.prefixof "<s" x))
(assert (or (not (str.contains x "}</s")) (not (= (str.at y 92) " ")) (= (str.indexof z "am na" 0) 20)))
(assert (not (str.contains x "useleave")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z\u{c3}\u{a7}\u{e7}\u{c3}\u{2021}\u{c7}\u{c3}\u{a3}\u{e3}\u{c3}\u{192}\u{c3}\u{c3}\u{a9}\u{e9}\u{c3}\u{2030}\u{c9}\u{c3}\u{ad}\u{ed}\u{c3}\u{8d}\u{cd}\u{c3}\u{b3}\u{f3}\u{c3}\u{201c}\u{d3}\u{c3}\u{ba}\u{fa}\u{c3}\u{161}\u{da}\u{c3}\u{a1}\u{e1}\u{c3}\u{81}\u{c1}\u{c3}\u{a2}\u{e2}\u{c3}\u{201a}\u{c2}\u{c3}\u{aa}\u{ea}\u{c3}\u{160}\u{ca}\u{c3}\u{b4}\u{f4}\u{c3}\u{201d}\u{d4} ]+$"))))
(assert (or (str.prefixof "<style" y) (str.in_re x ((_ re.from_regex ecma2020) "^[\u{30a1}-\u{30f6}\u{30fc}]+$"))))
(assert (or (not (= "for" (str.substr x 83 3))) (not (= "<data onbeforecoxalert(1)"" contenteditable>test</data>" (str.replace x "py=""" "x")))))
(check-sat)
