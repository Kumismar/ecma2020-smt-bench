; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "`""'><img src=xxx:x \x00onerror=javascript:alert(1)>") (= x "<SCRIPT SRC=//ha.ckers.org/.j>") (= x "<meta id=x tabindex=1 onactivate=alert(1)></meta>")))
(assert (or (= z "ondrag=""alert(1)"">test</image>") (= z "lert(\u{2018}XSS\u{2019})>") (= z "keypress=""alert(1)"" contenteditable>test</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len z) 12) (not (str.contains y "g/")) (not (= (str.indexof x ">" 0) 41))))
(assert (or (not (= (str.at x 28) "o")) (not (= "enteditab" (str.substr z 20 9)))))
(assert (str.prefixof "`""'><im" y))
(assert (= (str.indexof z "rub" 0) 1))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([ \u{5c}u00c0-\u{5c}u01ffa-zA-Z'\-]){5,50}$"))))
(assert (or (= (str.at x 1) "S") (= (str.indexof y "ckers" 0) 17)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^([\w\.\-]+)@([\w\-]+)((\.(\w){2,3})+)")))
(assert (str.contains z "ed"))
(assert (str.contains (str.replace y "IPT" "x") "Rx SR"))
(assert (not (= "SRC=//h" (str.substr x 8 7))))
(check-sat)
