; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary onfocusout=alert(1) tabindex=1 id=x></summary><input autofocus>") (= x "<area onmouseup=""alert(1)"">test</area>")))
(assert (or (= z "utofocus>") (= z "nt onfocusout=alert(1) tabindex=1 id=x></font><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "u" 0) 2) (not (= (str.indexof x "ry>" 0) 52)) (= "<inpu" (str.substr y 118 5))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z][a-zA-Z0-9]{5,19}$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^([0-9]){3,}$"))) (str.prefixof "<" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[\d]{3}[-]{1}[\d]{2}[-]{1}[\d]{4}"))) (str.contains (str.replace z "tofo" "<b>") "u<b>c")))
(assert (or (not (str.suffixof ">" z)) (not (= "<area onmouseup=""alerjavascript:(1)"">test</area>" (str.replace x "t" "javascript:")))))
(assert (str.prefixof "<summary o" x))
(assert (= " " (str.substr z 52 1)))
(assert (str.prefixof "nt onfoc" z))
(assert (or (<= (str.len z) 46) (str.contains (str.replace z "t(1)" "alert(1)") "=aleralert(1) tab")))
(check-sat)
