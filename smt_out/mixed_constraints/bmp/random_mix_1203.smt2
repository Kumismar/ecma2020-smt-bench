(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "http://www.simpatie.ro/index.php?page=friends&member=781339&javafunctionname=Pageclick&javapgno=2 javapgno=2 ??XSS??") (= x "<svg><path><animateMotion onbegin=alert(1) dur=""1s"" repeatCount=""1"">")))
(assert (or (= z "dex=1 ondeactivate=alert(1)></rtc><input id=y autofocus>") (= z "t id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></script>") (= z "tmenu=""alert(1)"">test</code>")))
