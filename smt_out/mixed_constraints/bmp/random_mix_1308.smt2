; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#x003c;") (= x "<div draggable=""true"" contenteditable>drag me</div><h1 ondragover=alert(1) contenteditable>drop here</h1>") (= x "<caption oncopy=""alert(1)"" contenteditable>test</caption>")))
(assert (or (= z "ypress=""alert(1)"" contenteditable>test</blink>") (= z "&gt;") (= z "st</html>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "</htm")) (not (= "alert" (str.substr z 5 5)))))
(assert (str.suffixof "tml>" z))
(assert (or (not (str.contains x "true")) (= (str.indexof x "e>dr" 0) 36) (not (str.contains y "t(1)"" c"))))
(assert (str.suffixof "ion>&gt;" y))
(assert (or (str.prefixof "ypress" z) (= "<main onmouseleave""rt(1)"">test</main>=""alert(1)"">test</ruby>" (str.replace y "=""ale" """"))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z]{3}[0-9]{3}")))
(check-sat)
