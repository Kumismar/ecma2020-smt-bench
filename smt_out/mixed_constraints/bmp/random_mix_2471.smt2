; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onfocusout=alert(1) tabindex=1 id=x></sup><input autofocus>") (= x "<style>@keyframes x{}</style><center style=""animation-name:x"" onanimationstart=""alert(1)""></center>")))
(assert (or (= z "t.vulnerable=true;</script>") (= z "</tr>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "rue;</sc" (str.substr y 78 8))) (<= (str.len x) 73)))
(assert (or (not (= (str.indexof x "styl" 0) 1)) (not (>= (str.len y) 126)) (not (= (str.at x 14) "m"))))
(assert (or (not (= (str.len z) 9)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\w\-\s]+$")))))
(assert (not (= ">" (str.substr z 4 5))))
(assert (not (str.suffixof "enter>" x)))
(check-sat)
