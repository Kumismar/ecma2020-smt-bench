; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script\x20type=""text/javascript"">javascript:alert(1);</script>") (= x "<samp draggable=""true"" ondragleave=""alert(1)"">test</samp>") (= x "<legend id=x tabindex=1 onbeforedeactivate=alert(1)></legend><input autofocus>")))
(assert (or (= z "PUT TYPE=&quot;IMAGE&quot; SRC=&quot;javascript:alert(&apos;XSS&apos;);&quot;&gt;") (= z "ont>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "ex=1" 0) 19)) (not (= (str.at z 2) "t"))))
(assert (or (not (str.contains (str.replace y "g" "<b>") "&<b>t;` S")) (not (str.suffixof ";></slot>" y))))
(assert (or (not (= "javascript:nt>" (str.replace z "o" "javascript:"))) (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._-]+@[a-z0-9.-]+\.[a-z]{2,3}$")) (str.suffixof "gt;" y)))
(assert (or (not (= "TYPE" (str.substr y 61 4))) (= (str.len y) 138)))
(assert (or (str.prefixof "<script" x) (str.prefixof "PUT T" z)))
(assert (or (not (str.contains x "vascript"">")) (str.contains (str.replace x """ " "") "rueond")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{454}\u{404}\u{457}\u{407}\u{406}\u{456}Ii\u{490}\u{491}\u{2018}'\u{2019}?`\s]+$"))))
(check-sat)
