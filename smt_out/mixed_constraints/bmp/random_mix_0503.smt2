; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<shadow onmousemove=""alert(1)"">test</shadow>") (= x "<body onhelp=alert(1)>press F1! (MSIE)") (= x "<style>:target {transform: rotate(180deg);}</style><inpu\u{1d400}t id=x style=""transition:transform 2s"" ont\u{1d400}ransitionrun=alert(1)></input>")))
(assert (or (= z "\u{1f4a9}alert(1)"" co\u{20000}ntenteditable>test</dfn>") (= z "ce>")))
(assert (= y (str.++ x z)))
(assert (or (= "a" (str.substr y 36 1)) (= (str.at x 4) "d") (not (str.prefixof "<body onhe" y))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(\+86)?1\d{10}$"))))
(assert (or (not (= (str.indexof z "nten" 0) 14)) (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!#^\-%*?_&])[A-Za-z\d@$!#^\-%_*?&]{6,}")) (<= (str.len y) 170)))
(assert (= (str.at z 0) "c"))
(assert (not (= " F" (str.substr x 27 2))))
(check-sat)
