; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed onmouseout=""alert(1)"">test</noembed>") (= x "<IMG SRC=""javascript:alert('XSS');"">")))
(assert (or (= z "SS');</script>") (= z "style>@keyframes x{}</style><legend style=""animation-name:x"" onanimationend=""alert(1)""></legend>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<IM" x)) (not (str.contains y "name:x"" "))))
(assert (or (str.prefixof "SS');" z) (not (= "d onmo" (str.substr x 7 6)))))
(assert (or (not (str.contains z "io")) (not (= "dra" (str.substr x 6 3)))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^.*\S.*$"))))
(assert (or (not (<= (str.len z) 23)) (= (str.at x 4) " ") (>= (str.len y) 57)))
(assert (not (str.contains (str.replace x "(1)" """") "rt"""">te")))
(check-sat)
