; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onselect=alert(1) value=""XSS"" autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><blink ondrop=alert(1) contenteditable>drop here</blink>") (= x "<img id=x tabindex=1 onfocus=alert(1)></img>")))
(assert (or (= z "t(1)"">test</acronym>") (= z "{ javascr\u{1d400}ipt:alert(1);}</script>") (= z "(1)></p>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "1)></p>" z) (not (= (str.indexof z "t(\u{2018}" 0) 8))))
(assert (or (not (= (str.at x 7) "o")) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{10}|\d{10})$")))))
(assert (= "/script>" (str.substr z 25 9)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[_\s/,\-\w\d]{3,}$")) (>= (str.len x) 51)))
(assert (str.contains z "t(1);}</sc"))
(assert (or (not (str.prefixof "{ java" z)) (str.contains y """ ")))
(check-sat)
