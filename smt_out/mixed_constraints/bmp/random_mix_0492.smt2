; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script draggabl\u{20000}e=""tr\u{1f600}ue"" ondragleave=""alert(1)"">test</script>") (= x "<legend id=x tabindex=1 onactivate=alert(1)></legend>")))
(assert (or (= z "olor:red;}</style><html id=x style=""transition:color 1s"" ontransitionend=alert(1)></html>") (= z "id=x tabindex=1 onactivate=alert(1)></area>") (= z "cument.vulnerable=true;"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 38) "r")) (not (str.suffixof "1)></html>" z)) (not (= "<sjavascript: draggabl\u{20000}e=""tr\u{1f600}ue"" ondragleave=""alert(1)"">test</script>" (str.replace x "cript" "javascript:")))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,10}$")) (= (str.at y 11) "x") (str.prefixof "onmouseou" z)))
(assert (or (str.prefixof "<legend i" x) (str.contains (str.replace x "aglea" "") "rve=")))
(assert (str.suffixof "Load>" y))
(check-sat)
