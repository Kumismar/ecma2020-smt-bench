; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object oncli\u{20000}ck=""alert(1)"">test</object>") (= x "<iframe onLoad iframe onLoad=""javascript:javascript:alert(1)""></iframe onLoad>")))
(assert (or (= z "e=""alert(1)"">test</article>") (= z "dystatechange>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 57) "(") (str.suffixof ">" x)))
(assert (= "dy change>" (str.replace z "state" " ")))
(assert (or (not (= (str.at z 8) "h")) (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z '-]+)$"))) (= (str.indexof y "st<" 0) 30)))
(assert (or (>= (str.len z) 6) (not (= (str.indexof x "o" 0) 1)) (not (str.suffixof "t>" x))))
(assert (or (= (str.at z 12) "e") (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9A-Za-z]{10}"))) (not (= (str.indexof x "if" 0) 1))))
(assert (>= (str.len x) 70))
(assert (not (str.prefixof "dy" z)))
(check-sat)
