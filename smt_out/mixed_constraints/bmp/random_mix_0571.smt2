; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead onbeforepaste=""alert(1)"" contenteditable>test</thead>") (= x "<div draggable=""true"" contenteditable>drag me</div><option ondragover=alert(1) contenteditable>drop here</option>") (= x "<a href=""\x10javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z ">;") (= z "=%(jscript)s></embed>") (= z "</mark>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "focus>")) (str.suffixof "ion>" x) (not (= "d=""fuzzel" (str.substr y 46 9)))))
(assert (or (not (= ";" (str.substr z 1 3))) (str.contains z "</em")))
(assert (not (str.contains (str.replace x "nten" "<b>") "co<b>te")))
(assert (or (not (str.suffixof "></embed>" y)) (not (str.in_re z ((_ re.from_regex ecma2020) "([0-9]{3}([-][0-9]{3}) ([-][0-9]{3}) ([-][0-9]{1})$)")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]+ [a-zA-Z\.]+$"))) (str.in_re y ((_ re.from_regex ecma2020) "^[0-9a-zA-Z\u{e4}\u{c4}\u{f6}\u{d6}\u{fc}\u{dc}\-]*\.[0-9A-Za-z]*$")) (= (str.at x 15) "v")))
(check-sat)
