; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><area ondrop=alert(1) contenteditable>drop here</area>") (= x "'></select><script>alert(123)</script>")))
(assert (or (= z "lert(1)"">test</slot>") (= z "ctivate=alert(1)></noframes><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "t>" y)) (not (= "on" (str.substr x 23 2))) (str.suffixof ">" z)))
(assert (not (= "<div draggable=""true"" contenteditable>drag me</div><area rop=alert(1) contenteditable>drop here</area>" (str.replace x " ond" " "))))
(assert (= (str.indexof z "t" 0) 3))
(assert (str.contains y "ript>ct"))
(assert (or (not (str.suffixof "focus>" z)) (not (= "ctxvate=alert(1)></noframes><input autofocus>" (str.replace z "i" "x")))))
(assert (or (= (str.indexof x "dit" 0) 30) (not (str.contains z "rames><in")) (= (str.indexof z "l" 0) 0)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[^0-9][a-zA-Z0-9_]+([.][a-zA-Z0-9_]+)*[@][a-zA-Z0-9_-]+([.][a-zA-Z0-9_-]+)*[.][a-zA-Z]{2,4}$")) (not (= "tofocus>" (str.substr z 37 8)))))
(check-sat)
