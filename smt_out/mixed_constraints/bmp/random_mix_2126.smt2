; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><noframes id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></noframes>") (= x "<html onblur=alert(1) tabindex=1 id=x></html><input autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><aside ondrop=alert(1) contenteditable>drop here</aside>")))
(assert (or (= z "editable>test</video>") (= z "le><font style=""animation-name:x"" onanimationend=""alert(1)""></font>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\d]{4}")))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^\+(\d{1}\s?){8,20}$")))
(assert (or (<= (str.len x) 69) (= (str.indexof x "er" 0) 67) (not (= (str.indexof y "(1" 0) 104))))
(assert (not (= (str.at y 125) "o")))
(assert (or (not (= (str.at z 12) "t")) (not (= (str.indexof y "le" 0) 4)) (= (str.at x 87) "l")))
(assert (not (str.prefixof "<style><" y)))
(assert (or (str.suffixof "rames>" x) (not (str.contains (str.replace x "x><" " ") "d= /")) (not (str.prefixof "<" x))))
(assert (str.prefixof "<div d" x))
(check-sat)
