; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main ondblclick=""alert(1)"">test</main>") (= x "<b draggable=""true"" ondragleave=""alert(1)"">test</b>") (= x "<style>:target {color: red;}</style><select id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></select>")))
(assert (or (= z "PT>;alert("";XSS"";)<;/SCRIPT>;"";>;") (= z ":alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 9) "a") (not (<= (str.len z) 17)) (not (str.suffixof ";>;" z))))
(assert (or (not (= (str.at z 0) ":")) (not (str.contains y "cusin=")) (not (= "<b drxgable=""true"" ondragleave=""alert(1)"">test</b>:alert(1)"">" (str.replace y "ag" "x")))))
(assert (or (not (= ":al""1)"">" (str.replace z "ert(" """"))) (str.in_re y ((_ re.from_regex ecma2020) "^[1-9]{2}$")) (str.suffixof """;>;" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^0\d{1,3}-?\d{2,4}-?\d{4}$"))))
(check-sat)
