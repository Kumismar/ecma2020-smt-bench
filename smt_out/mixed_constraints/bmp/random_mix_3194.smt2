(assert (or (not (str.prefixof "<" y)) (= "est<" (str.substr z 33 4)) (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$"))))
(check-sat)
