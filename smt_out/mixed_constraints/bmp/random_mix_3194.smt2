(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<LAYER SRC=""http://ha.ckers.org/scriptlet.html""></LAYER>") (= x "<mark onmouseleave=""alert(1)"">test</mark>") (= x "<style>:target {color:red;}</style><blink id=x style=""transition:color 1s"" ontransitionend=alert(1)></blink>")))
(assert (or (= z "ert('XSS');&lt;/SCRIPT&gt;") (= z "eyup=""alert(1)"" contenteditable>test</rtc>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len z) 9)) (= (str.at x 4) "l") (not (str.contains (str.replace z "am" "javascript:") "rjavascript:es>"))))
(assert (or (not (str.prefixof "<mark o" x)) (str.contains (str.replace x "ragga" "<b>") "o d<b>b")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "\u{60a8}\u{7684}\u{59d3}\u{540d}"))))
