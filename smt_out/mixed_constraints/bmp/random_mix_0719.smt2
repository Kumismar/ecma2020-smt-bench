; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onmouseleave=""aler\u{1f600}t(1)"">test\u{1f4a9}</body>") (= x "<tr onmousedown=""alert(1)"">test</tr>") (= x "<wbr oncontextmenu=""alert(1)"">test</wbr>")))
(assert (or (= z "noembed>") (= z "e:x"" onanimationend=""alert(1)""></frameset>") (= z "tart=""alert(1)""></keygen>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "/wbr>" 0) 35) (not (= "e:x"" o<b>nimationend=""alert(1)""></frameset>" (str.replace z "na" "<b>"))) (= (str.len z) 25)))
(assert (or (not (= "nbefor" (str.substr y 10 6))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[-\u{6f5f}\u{773c}|| ]+$"))) (not (>= (str.len y) 60))))
(assert (not (str.contains (str.replace y "usedo" "alert(1)") "nmoalert(1)wn=""")))
(assert (not (str.suffixof ">" y)))
(assert (str.prefixof "n" z))
(assert (= (str.at x 3) " "))
(check-sat)
