; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet draggable=""true"" ondragenter=""alert(1)"">test</applet>") (= x "<style onmouseover=""alert(1)"">test<\u{1f4a9}/style>")))
(assert (or (= z "and>") (= z "1)></rtc>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<a" x)))
(assert (not (= (str.at x 17) "r")))
(assert (or (not (str.suffixof "tyle>and>" y)) (str.in_re y ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]{3,}")) (not (str.contains (str.replace z "=a" "<b>") "or<b>l"))))
(assert (not (= (str.indexof z ">" 0) 2)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%*+/=?^_`{2,}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")))
(assert (or (= (str.indexof y "er" 0) 34) (not (str.contains y """true"" "))))
(assert (str.contains (str.replace x "/styl" """") "est<\u{1f4a9}""e>"))
(assert (or (= (str.at z 0) "1") (not (<= (str.len x) 66)) (not (= "ale" (str.substr x 20 3)))))
(check-sat)
