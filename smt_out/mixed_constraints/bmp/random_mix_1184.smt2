; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg onunload svg onunload=""javascript:javascript:alert(1)""></svg onunload>") (= x "<image onbeforecut=""alert(1)"" contenteditable>test</image>")))
(assert (or (= z " style=""transition:color 1s"" ontransitionend=alert(1)></rtc>\u{1f4a9}") (= z " onfocusout=alert(1) tabindex=1 id=x></mark><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 104) ">"))
(assert (not (= "</mark" (str.substr z 37 6))))
(assert (or (str.contains (str.replace x " " "x") "gexonb") (str.in_re z ((_ re.from_regex ecma2020) "[0-9+]*$")) (= "tyle=""binding: u [link to code]);"">" (str.replace z "rl(" " "))))
(assert (or (= (str.len z) 61) (not (str.in_re y ((_ re.from_regex ecma2020) "^04[56789]\d{7}$"))) (= " style=""transition:""olor 1s"" ontransitionend=alert(1)></rtc>\u{1f4a9}" (str.replace z "c" """"))))
(assert (or (not (str.prefixof "<s" x)) (str.in_re y ((_ re.from_regex ecma2020) "^.{6,}$"))))
(assert (not (>= (str.len x) 56)))
(check-sat)
