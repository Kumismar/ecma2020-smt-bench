; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form><textarea &#13; onkeyup='\u{5c}u0061\u{5c}u006C\u{5c}u0065\u{5c}u0072\u{5c}u0074&#x28;1&#x29;'>") (= x "<div draggable=""true"" contenteditable>drag me</div><tt ondragover=alert(1) contenteditable>drop here</tt>")))
(assert (or (= z "</LAYER>") (= z """alert(1)"">test</svg>") (= z "template id=x tabindex=1 onfocusin=alert(1)></template>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "=x")))
(assert (or (str.prefixof "</L" z) (str.suffixof "T>" z)))
(assert (not (str.suffixof "here</tt>" x)))
(assert (str.contains (str.replace y "unc" """") " f""tion"))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{406}\u{456}\u{407}\u{457}\u{404}\u{454}\s]+$")))
(assert (or (not (str.suffixof "tt>" x)) (= (str.indexof y "<" 0) 0)))
(check-sat)
