; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em draggable=""true"" ondragend=""alert(1)"">test</em>") (= x "<bdo onfocusout=alert(1) tabindex=1 id=x></bdo><input autofocus>")))
(assert (or (= z "alert(1)"" contenteditable>test</datalist>") (= z ")"" contenteditable>test</i>") (= z "(1)"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "t<" 0) 22) (not (= (str.len z) 41)) (not (str.in_re y ((_ re.from_regex ecma2020) "\d{1,5}-\d{1,4}-\d{3,5}")))))
(assert (or (str.suffixof "est</a>" z) (not (= "l" (str.substr z 23 1)))))
(assert (or (str.suffixof "m>" x) (not (= (str.len z) 27))))
(assert (or (str.contains z "/a") (not (= (str.at x 39) ")")) (not (>= (str.len y) 87))))
(assert (or (str.suffixof ">test</i>" z) (str.in_re z ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}a-zA-Z-]+$")) (not (str.prefixof "<fram" y))))
(check-sat)
