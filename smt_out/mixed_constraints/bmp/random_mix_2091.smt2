; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside onmouseout=""alert(1)"">test</aside>") (= x "<style>@keyframes x{}</style><iframe style=""animation-name:x"" onanimationend=""alert(1)""></iframe>")))
(assert (or (= z "ion:transform 2s"" ontransitionrun=alert(1)></canvas>") (= z "=""true"" ondragend\u{20000}=""alert(1)"">test</input>") (= z "id\u{1f4a9}=x></head><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([ \u{5c}u00c0-\u{5c}u01ffa-zA-Z'\-]){2,200}$"))) (not (= (str.at x 43) "N")) (not (= (str.at y 113) """"))))
(assert (or (not (= "onrun=" (str.substr z 28 6))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\s0-9]*$"))) (str.prefixof "<style" y)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[a-z\s]+$")))
(assert (= (str.at y 61) "y"))
(check-sat)
