; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=""javascript:alert('XSS')"">") (= x "<svg><video onload=alert(1)></video>")))
(assert (or (= z "`'><script>\x3Bjavascript:alert(1)</script>") (= z "PgA8-script+AD4-alert(document.location)+ADw-/scri\u{1d400}pt+AD4A\u{1f600}PAAi-")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[_A-Za-z0-9\u{621}-\u{64a}]{3,}$")) (str.contains (str.replace z "<" "javascript:") "`'>javascript:scri") (not (str.in_re y ((_ re.from_regex ecma2020) "^([1-9]|[1-4]\d|50)$")))))
(assert (or (not (str.suffixof "ipt>" y)) (not (str.suffixof "cript>" y))))
(assert (= "`'><script>\x3Bjavascript:alert(1)<<b>ipt>" (str.replace z "/scr" "<b>")))
(assert (not (= "(1)" (str.substr x 24 3))))
(assert (not (= "=\u{201d}jav&#" (str.substr y 8 7))))
(check-sat)
