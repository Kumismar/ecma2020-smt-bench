; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed onfocusout=alert(1) tabindex=1 id=x></embed><input autofocus>") (= x "<style>:target {transform: rotate(180deg);}</style><hgroup id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></hgroup>") (= x "<q onmouseup=""alert(1)"">test</q>")))
(assert (or (= z "ipt:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "lert(1)"" contenteditable>test</noframes>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 133) ":")))
(assert (= (str.indexof y "sout=" 0) 13))
(assert (not (str.contains y "mouseup=""")))
(assert (or (not (= (str.len z) 40)) (not (str.prefixof "ipt" z))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "(?=^.{8,}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*")))
(assert (or (not (str.suffixof ">" y)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\u{c0}-\u{ff} ,.'-]+$"))) (str.suffixof "est</q>" x)))
(assert (or (= (str.indexof y ">pt:" 0) 45) (not (= (str.indexof x "/emb" 0) 44)) (<= (str.len y) 173)))
(check-sat)
