; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;INPUT TYPE=\""IMAGE\"" SRC=\""javascript&#058;alert('XSS');\""&gt;") (= x "<scr<script>ipt>alert(1)</scr</script>ipt><scr<script>ipt>alert(1)</scr</script>ipt>")))
(assert (or (= z "est</nobr>") (= z """&lt;XSS&gt;=&{()}")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "vat") (not (str.contains x "t>ipt>")) (str.suffixof ")}" z)))
(assert (or (str.prefixof " " z) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9 aA-zZ '-]*$"))) (>= (str.len z) 14)))
(assert (not (= "br>" (str.substr z 7 7))))
(assert (not (<= (str.len x) 92)))
(check-sat)
