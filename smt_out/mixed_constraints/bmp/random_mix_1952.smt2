; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby onmousedown=""alert(1)"">test</ruby>") (= x "</xmp>") (= x "<style>:target {transform: rotate(180deg);}</style><xss id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></xss>")))
(assert (or (= z "le>test</main>") (= z "ascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "x=1 onbeforedeactivate=alert(1)></progress><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "le>t" z))
(assert (or (str.prefixof "<style" x) (not (str.in_re z ((_ re.from_regex ecma2020) ".{1,99}")))))
(assert (or (str.contains x "nsf") (= (str.at y 90) "t") (not (str.contains x "n=""alert("))))
(assert (or (str.suffixof "d>" y) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9.]{6,9}([0-9A-Z]{0,3})$"))) (str.prefixof "ascript:" z)))
(assert (not (= (str.indexof z "outpu" 0) 35)))
(check-sat)
