; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody onmouseleave=""alert(1)"">test</tbody>") (= x "<head onmouseout=""alert(1)"">test</head>")))
(assert (or (= z "d=x tabindex=1 ondeactivate=alert(1)></rtc><input id=y autofocus>") (= z "eenter=""alert(1)"">test</p>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\w([\w .]*[\w.])?$"))))
(assert (or (not (<= (str.len y) 184)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{30a1}-\u{30f6}\u{30fc}]+$")))))
(assert (or (not (str.contains y "eleave")) (not (= (str.indexof z "st</p" 0) 20)) (not (str.contains (str.replace x "lert(" "javascript:") "=""ajavascript:1)"""))))
(assert (or (= "<""dy onmouseleave=""alert(1)"">test</tbody>" (str.replace x "tbo" """")) (not (= "1)" (str.substr x 27 2))) (>= (str.len y) 103)))
(assert (>= (str.len x) 38))
(assert (= (str.indexof z "nerro" 0) 9))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\s]{1,4}$"))) (str.contains z "test</sh")))
(check-sat)
