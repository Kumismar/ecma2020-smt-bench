; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th id=x tabindex=1 onbeforeactivate=alert(1)></th>") (= x "<xss id=x tabindex=1 onactivate=alert(1)></xss>") (= x "<! foo=""><scrip\u{10348}t>alert(91)</script>\u{20000}"">")))
(assert (or (= z "</wbr>") (= z "=alert(1)><svg/1='")))
(assert (= y (str.++ x z)))
(assert (>= (str.len y) 67))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[\s]*[^0-9\s]{3,}")) (not (= (str.at z 1) "/"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[^@]+@[^\.]+\..{2,}$"))) (str.suffixof "(1)></th>" x)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) ".{6,72}")) (str.contains x "(9") (= "1)><svg/" (str.substr z 7 8))))
(assert (or (not (str.suffixof "r>" z)) (not (= (str.indexof z "e" 0) 3)) (str.suffixof "/1='" y)))
(assert (or (= (str.at y 44) ")") (not (= (str.at x 8) " "))))
(assert (not (= (str.indexof x "<t" 0) 0)))
(assert (= "<video javascript:able=""true"" ondragstart=""alert(1)"">test</video>le>test</em>" (str.replace y "dragg" "javascript:")))
(check-sat)
