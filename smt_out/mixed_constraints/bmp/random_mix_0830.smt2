; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select onfocusout=alert(1) id=x><\u{1f600}/select><input autofocus>") (= x "<dd onmouseup=""alert(1)"">test</dd>") (= x "<nextid onmouseup=""alert(1)"">t\u{1d400}est</nextid\u{1d400}>")))
(assert (or (= z "lt;/A&gt;") (= z "br>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "br" z))
(assert (or (= (str.indexof z "');\" 0) 13) (= "br>" (str.substr z 0 4)) (not (str.suffixof "xtid\u{1d400}>br>" y))))
(assert (or (str.prefixof "<sel" y) (not (str.contains z "&gt"))))
(assert (or (= "<nex onmouseup=""alert(1)"">t\u{1d400}est</nextid\u{1d400}>" (str.replace x "tid" "")) (not (<= (str.len x) 64)) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\s\-+()]+$"))))
(assert (or (not (str.suffixof "></ol>" x)) (not (str.contains z "br>")) (= (str.len x) 34)))
(assert (or (= "ab;pr" (str.substr z 0 5)) (str.contains x ">test</d")))
(assert (str.prefixof "<dd" y))
(check-sat)
