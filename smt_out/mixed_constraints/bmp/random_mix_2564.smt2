; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre onmousemove=""alert(1)"">test</pre>") (= x "<style>:target {color: red;}</style><template id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></template>") (= x "<head draggable=""true"" ondragenter=""alert(1)"">test</head>")))
(assert (or (= z "ndex=1 onactivate=alert(1)></hr>") (= z "ript>\x20javascript:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "</hr" 0) 27) (not (= (str.at y 29) "e")) (not (str.contains y "adyStateC"))))
(assert (str.contains (str.replace x "t" "javascript:") "<sjavascript:y"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]+$|^[0-9]{4}[a-zA-Z]{3}$|^(([a-zA-Z]{1,2}[0-9]{4}[a-zA-Z]{1,2})|([a-zA-Z]{1,2}[1-9]?[1-9][0-9]{4}))$|^C[a-zA-Z]{3}$|[S|P|H|T|s|p|h|t]{1}[0-9]{4}[a-zA-Z]{3}$"))) (not (= (str.at y 1) "h")) (not (= "<head draggable=""true"" ondragenter=""alert(1)"">testalert(1)ad>" (str.replace x "</he" "alert(1)")))))
(assert (= (str.at x 10) "s"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{17}[0-9xX]$"))) (not (str.prefixof "<head " x)) (>= (str.len y) 65)))
(assert (or (str.prefixof "<" y) (not (str.contains z "x=1"))))
(assert (str.suffixof "</head>" x))
(assert (= "</hea" (str.substr x 50 5)))
(check-sat)
