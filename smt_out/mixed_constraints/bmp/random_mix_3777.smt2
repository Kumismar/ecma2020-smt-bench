; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\'><SCRIPT>alert(String.fromCharCode(88,83,83))</SCRIPT><img src="""" alt=\'") (= x "<mark id=x tabindex=1 ondeactivate=alert(1)></mark><input id=y autofocus>")))
(assert (or (= z "ary>") (= z "lor:red;}</style><br id=x style=""transition:color 1s"" ontransitionend=alert(1)></br>") (= z "ert(1)""></body onload>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "\'>" x))
(assert (or (not (str.suffixof "s>ary>" y)) (= "/body onlo" (str.substr z 9 10))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z'\u{e0}\u{e2}\u{e9}\u{e8}\u{ea}\u{f4}\u{f9}\u{fb}\u{e7}\u{c0}\u{c2}\u{c9}\u{c8}\u{d4}\u{d9}\u{db}\u{c7}\s-]{1,30})$"))))
(assert (or (str.contains z "color 1s") (not (= (str.indexof z " id=" 0) 20))))
(assert (or (str.prefixof """>t" z) (= "ert(1)""" (str.substr z 0 7)) (not (>= (str.len y) 77))))
(assert (or (not (= "javascript:" (str.replace z "ary>" "javascript:"))) (= (str.at z 0) "a") (not (str.in_re z ((_ re.from_regex ecma2020) "([0-9]|[aA-zZ])+")))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[+]?([0-9]*[\.\s\-\(\)]|[0-9]+){10,24}$")) (not (str.prefixof "<listi" y))))
(check-sat)
