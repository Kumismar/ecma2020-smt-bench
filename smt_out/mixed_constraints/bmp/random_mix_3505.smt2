; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area id=x tabindex=1 onbeforeactivate=alert(1)></area>") (= x "<thead onkeypress=""alert(1)"" contenteditable>test</thead>")))
(assert (or (= z "up=""alert(1)"" contenteditable>test</meter>") (= z "1)""></param>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{e9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{c9}'\s]+$"))))
(assert (not (= "up=""alert(1)"" contenteditablealert(1)est</meter>" (str.replace z ">t" "alert(1)"))))
(assert (or (not (= "1)""></par>" (str.replace z "am" ""))) (not (= (str.len x) 57)) (str.in_re x ((_ re.from_regex ecma2020) "(3|drei)"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(14)$"))) (not (= "alert(" (str.substr z 4 6)))))
(assert (or (>= (str.len y) 61) (not (= "up=""alert(1)"" contented""ble>test</meter>" (str.replace z "ita" """")))))
(assert (or (= " tabin" (str.substr y 10 6)) (not (= (str.indexof y "ble>" 0) 41))))
(assert (or (not (= "forep" (str.substr y 11 5))) (= (str.at x 44) ">")))
(assert (or (>= (str.len z) 11) (not (= (str.at z 1) ")"))))
(check-sat)
