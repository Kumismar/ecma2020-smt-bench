; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><tt ondrop=al\u{10348}ert(1) contenteditable>drop here</tt>") (= x "<style>:target {color:red;}</style><progress id=x style=""transition:color 1s"" ontransitionend=alert(1)></progress>") (= x "<style>:target {transform: rotate(180deg);}</style><i id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></i>")))
(assert (or (= z "t</video>") (= z "mage onmouseleave=""alert(1)"">test</image>") (= z "tenteditable>test</col>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z\u{c0}-\u{fa}]{2,30}$"))))
(assert (or (str.contains (str.replace x "rop=" "javascript:") "t ondjavascript:al\u{10348}") (str.contains (str.replace z "lert(" "alert(1)") "ve=""aalert(1)1)") (not (= (str.indexof y "p he" 0) 91))))
(assert (or (str.contains (str.replace y ";}</" "x") "r:redxstyl") (not (= (str.at x 58) " "))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[-\w.]+@([A-z0-9][-A-z0-9]+\.)+[A-z]{2,4}$"))))
(assert (or (= (str.at y 17) "r") (not (>= (str.len y) 64))))
(assert (or (not (str.contains y "l>")) (not (str.prefixof "<d" y))))
(check-sat)
