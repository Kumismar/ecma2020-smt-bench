; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><![CDATA[><image xlink:href=""]]><img src=xx:x onerror=alert(2)//""></svg>//[""'`-->]]>]</div>") (= x "foo\\u{2019}; alert(document.cookie);//\u{2019};")))
(assert (or (= z "le>test</var>") (= z "r onload=alert(1)></tr>")))
(assert (= y (str.++ x z)))
(assert (not (= "e>test<" (str.substr z 1 7))))
(assert (or (= "<svg><![CDATA[><image xlink:href=""]]><img src=xx:x onerror=alert(2)//""></svg>//[""'`-->]]>javascript:/div>" (str.replace x "]<" "javascript:")) (str.prefixof "foo\\u{2019}; " x)))
(assert (or (= "nt.cookie" (str.substr y 19 9)) (not (= "input id=y" (str.substr y 64 10)))))
(assert (or (str.contains y ">]") (not (str.suffixof "kie);//\u{2019};" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^ *[^ 0-9]+ [^ 0-9]+.*$")))))
(assert (not (= (str.indexof z "</tr>" 0) 18)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]"))) (str.suffixof "SCRIPT>" y)))
(check-sat)
