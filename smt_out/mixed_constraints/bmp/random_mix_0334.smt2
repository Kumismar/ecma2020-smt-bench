; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ul draggable=""true"" ondragstart=""alert(1)"">test</ul>") (= x "<script src=javascript:alert(1)>") (= x "<sup draggable=""true"" ondragenter=""alert(1)"">test</sup>")))
(assert (or (= z "ronym>") (= z " onbeforedeactivate=alert(1)></textarea><input autofocus>") (= z "nteditable>test</tr>")))
(assert (= y (str.++ x z)))
(assert (or (= "<script src=ja""ipt:alert(1)>" (str.replace x "vascr" """")) (str.prefixof "<ul" x) (not (= (str.indexof y "gen" 0) 27))))
(assert (or (= (str.indexof z "t " 0) 45) (not (str.prefixof "nteditabl" z))))
(assert (or (not (str.contains x " dr")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9A-Za-z ]{1,10}$")))))
(assert (or (not (= " sty" (str.substr z 22 4))) (not (= (str.len y) 73))))
(assert (or (= "able>tes" (str.substr z 6 8)) (= (str.at z 4) "<")))
(check-sat)
