; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onhashchange=alert(1)><a href=#x>click this!#x") (= x "<meta charset= ""x-imap4-modified-utf7""&&>&&<script&&>javascript:alert(1)&&;&&<&&/script&&>") (= x "perl -e &#039;print \"";<;SCR\0IPT>;alert(\"";XSS\"";)<;/SCR\0IPT>;\"";;&#039; >; out")))
(assert (or (= z "tofocus>") (= z "frame%20src=""http://google.com""%%203E") (= z "`>ABC<div style=""font-family:'foo'\x7Dx:expression(javascript:alert(1);/*';"">DEF")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "pt&&") (= "-modifie" (str.substr y 23 8)) (not (str.contains y "ocument.c"))))
(assert (not (str.contains (str.replace y "cu" "javascript:") "fojavascript:s>")))
(assert (= ">" (str.substr x 31 1)))
(assert (= (str.at x 28) "n"))
(assert (or (not (= (str.at z 7) "o")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\w.+-]+@(?!xn--)[\w.-]+(\.[A-Za-z]{2,})$"))) (str.suffixof "3E" y)))
(assert (or (not (= "perl -e &#039;print \"";<;\0IPT>;alert(\"";XSS\"";)<;/SCR\0IPT>;\"";;&#039; >; out" (str.replace x "SCR" ""))) (str.in_re z ((_ re.from_regex ecma2020) "^(05)[0-9]{8}$")) (<= (str.len x) 62)))
(assert (or (str.prefixof "per" y) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0]{1}[1-9]{1}[0-9]{7,10}"))) (not (str.contains (str.replace y "ex=1" "<b>") "abind<b> id="))))
(check-sat)
