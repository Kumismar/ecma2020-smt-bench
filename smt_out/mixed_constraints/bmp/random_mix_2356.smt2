; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><cite onload=alert(1)></cite>") (= x "<noscript onmouseenter=""alert(1)"">test</noscript>")))
(assert (or (= z "//3334957647/1>") (= z "gt;&lt;SCRIPT&gt;alert(\""XSS\"");&lt;/SCRIPT&gt;") (= z "/body>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "IPT&" 0) 10) (>= (str.len x) 30)))
(assert (or (not (<= (str.len x) 54)) (= (str.indexof z "957" 0) 6) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{3}-?\d{3}-?\d{4}|XXX-XXX-XXXX)$")))))
(assert (or (str.contains z "ody") (str.suffixof "></cite>" x)))
(assert (or (str.prefixof "<" y) (not (<= (str.len z) 20)) (not (= "CR" (str.substr z 38 2)))))
(assert (str.prefixof "<nosc" x))
(assert (or (= "<s<b>ite onload=alert(1)></cite>" (str.replace x "vg><c" "<b>")) (= "t>" (str.substr x 47 10))))
(check-sat)
