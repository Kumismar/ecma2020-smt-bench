; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp oncontextmenu=""alert(1)"">test</samp>") (= x "<style>@keyframes x{}</style><article style=""animation-name:x"" onanimationstart=""alert(1)""></article>") (= x "<acronym id=x tabindex=1 onfocus=alert(1)></acronym>")))
(assert (or (= z "nanimationend=""alert(1)""></dl>") (= z "t>") (= z "vg><bdi onload=alert(1)></bdi>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 20) "(") (not (= (str.at x 25) "o")) (not (= (str.indexof z "t" 0) 0))))
(assert (or (= (str.at y 16) "e") (str.prefixof "<track on" x)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z ]+$"))))
(assert (or (not (str.contains y "</samp")) (not (str.suffixof ")""></dl>" z))))
(check-sat)
