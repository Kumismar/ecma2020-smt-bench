; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div style=""binding: url(http://www.securitycompass.com/xss.js);""> [Mozilla]") (= x "<div id=""131""><b>drag and drop one of the following strings to the drop box:</b>")))
(assert (or (= z "n>") (= z "drag me</div><data ondrop=alert(1) contenteditable>drop here</data>") (= z "me</div><pre ondrop=alert(1) contenteditable>drop here</pre>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "div s") (not (str.in_re y ((_ re.from_regex ecma2020) "\+?[0-9\s\-\(\)]+")))))
(assert (not (str.contains x "ue"" on")))
(assert (= (str.indexof y "op " 0) 28))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[\\.0-9]+$"))))
(assert (or (not (= "p here<" (str.substr z 54 7))) (str.contains (str.replace y "nd" """") "g a"" ") (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*\d).{6,20}")))))
(assert (or (not (str.suffixof "]" x)) (= (str.len x) 57) (str.suffixof "re</data>" z)))
(assert (= ">n>" (str.substr y 79 4)))
(assert (or (= (str.indexof y "le>" 0) 42) (= "<div id=""131""><b>drag and drop one of the following strings to the drop x:</b>" (str.replace x "bo" ""))))
(check-sat)
