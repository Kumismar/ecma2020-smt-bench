; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object onmousedown=""alert(1)"">test</object>") (= x "//<form/action=javascript&#x3A;alert&lpar;document&period;cookie&rpar;><input/type='submit'>//") (= x "<canvas id=x tabindex=1 onbeforeactivate=alert(1)></canvas>")))
(assert (or (= z "data:text/html,<svg &#111;&#110;load=alert(1)>"">") (= z ">test</header>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "rt(1" "<b>") "=""ale<b>)""") (str.prefixof "<canvas " y) (str.contains x "bindex=")))
(assert (or (not (>= (str.len y) 135)) (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z][A-Za-z0-9]*$"))))
(assert (str.prefixof ">test<" z))
(assert (or (not (= "<q draggable=""t<b> ondrag=""alert(1)"">test</q>efont>" (str.replace y "rue""" "<b>"))) (str.suffixof ">" z)))
(assert (not (= ">" (str.substr y 147 7))))
(check-sat)
