; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x onxxx=1 \u{20000}onxxx=1") (= x "<script draggab\u{1d400}le=""true"" ondrag=""alert(1)"">te\u{10348}st</script>")))
(assert (or (= z "ert(1)"">test</strong>") (= z "ate>") (= z "(1)"" contenteditable>test</time>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 17) "=") (not (= (str.indexof y "x=" 0) 7)) (= (str.len z) 47)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[0-9\.]{1,5}")) (not (str.suffixof ">" y))))
(assert (not (= (str.at z 4) "e")))
(assert (or (not (= (str.indexof y "ime" 0) 47)) (not (str.contains x "te\u{10348}st</sc")) (not (str.contains x """true"" on"))))
(check-sat)
