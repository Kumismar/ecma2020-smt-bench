; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "perl -e ';print "";<;IM SRC=java\0script:alert("";XSS"";)>"";;';>; out") (= x "<style>:target {color:red;}</style><header id=x style=""transition:color 1s"" ontransitionend=alert(1)></header>") (= x "<a id=x tabindex=1 onbeforedeactivate=alert(1)></a><input autofocus>")))
(assert (or (= z "d=x></th><input autofocus>") (= z ">test</\u{1f600}thead>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "cus>" x)) (not (str.suffixof ";>; out" x))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,15}$"))) (= (str.indexof z "np" 0) 11)))
(assert (or (not (= "><input" (str.substr z 8 7))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[^-\s][a-zA-Z\u{c0}-\u{fa} ]*"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{1,3}$")))))
(assert (not (str.contains y "ndex=1 ")))
(check-sat)
