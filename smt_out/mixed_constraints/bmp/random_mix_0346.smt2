; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br draggable=""true"" ondragend=""alert(1)"">test</br>") (= x "<style>:target {color: red;}</style><plaintext id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></plaintext>")))
(assert (or (= z "cript>") (= z "le>")))
(assert (= y (str.++ x z)))
(assert (or (not (= ">" (str.substr z 5 7))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\/][a-zA-Z\s]+[\/]$")))))
(assert (= (str.len y) 57))
(assert (or (not (= ">" (str.substr z 2 10))) (not (= (str.at y 4) "d"))))
(assert (= (str.indexof z ">" 0) 2))
(assert (or (not (str.contains (str.replace y "x" "") "aintet id")) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}'][a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}-' ]+[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}']?$"))))
(assert (str.contains z "ript>"))
(check-sat)
