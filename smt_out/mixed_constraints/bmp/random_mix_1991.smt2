; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet onfocusout=alert(1) tabindex=1 id=x></applet><input autofocus>") (= x "<style>@keyframes x{}</style><body style=""animation-name:x"" onanimationstart=""alert(1)""></body>") (= x "<script\x0A>javascript:alert(1)</script>")))
(assert (or (= z "ert(1)"">test</li>") (= z "t</a>") (= z "ndex=1 ondeactivate=alert(1)></iframe><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<salert(1)>@keyframes x{}</style><body style=""animation-name:x"" onanimationstart=""alert(1)""></body>ert(1)"">test</li>" (str.replace y "tyle" "alert(1)"))) (<= (str.len x) 50) (= """script\x0A>javascript:alert(1)</script>" (str.replace x "<" """"))))
(assert (or (= ">t" (str.substr y 40 2)) (str.contains (str.replace x "t" "<b>") "<s<b>y")))
(assert (or (= "cript:aler" (str.substr x 17 10)) (not (= """a" (str.substr y 77 2))) (not (str.suffixof "cript>" x))))
(assert (str.contains x "nanimatio"))
(assert (or (= (str.at x 11) "o") (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z\u{154}\u{c1}\u{c2}\u{102}\u{c4}\u{139}\u{106}\u{c7}\u{10c}\u{c9}\u{118}\u{cb}\u{11a}\u{cd}\u{ce}\u{10e}\u{110}\u{143}\u{147}\u{d3}\u{d4}\u{150}\u{d6}\u{158}\u{16e}\u{da}\u{170}\u{dc}\u{dd}\u{162}\u{df}\u{155}\u{e1}\u{e2}\u{103}\u{e4}\u{13a}\u{107}\u{e7}\u{10d}\u{e9}\u{119}\u{eb}\u{11b}\u{ed}\u{ee}\u{10f}\u{111}\u{144}\u{148}\u{f3}\u{f4}\u{151}\u{f6}\u{159}\u{16f}\u{fa}\u{171}\u{fc}\u{fd}\u{163}\u{2d9} \t\r\n\f]*$"))))
(check-sat)
