; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd onkeypress=""alert(1)"" contenteditable>test</dd>") (= x "<thead id=x tabindex=1 onbeforeactivate=alert(1)></the\u{1d400}ad>\u{1f4a9}") (= x "<a\u{10348}cronym draggable=""tr\u{1d400}ue"" ondrag=""alert(1)"">test</acronym>")))
(assert (or (= z "cript>\x3Bjavascript:alert(1)</script>") (= z " SRC=&quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "alert(1")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[^0-9_!\u{a1}?\u{f7}?\u{bf}/\\+=@#$%\u{2c6}*(){}|~<>;:[\]]{2,}$")))))
(assert (or (not (= "test<" (str.substr x 46 5))) (not (= (str.indexof y ">\x" 0) 56)) (not (str.in_re x ((_ re.from_regex ecma2020) "^\+?(\d|-|\.| ){3,}$")))))
(assert (or (not (str.prefixof "cript>\x3" z)) (not (str.contains z "sitionca"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}A-Za-z\s]{2,50}$"))) (= (str.at z 22) "k") (str.contains y "x"" o")))
(check-sat)
