(assert (or (= z "ge draggable=""true"" ondragleave=""alert(1)"">test</image>") (= z "r: url(http://ha.ckers.org/xss.htc);"";>;")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<head onbeforecut=""alerx)"" contenteditable>test</head>r: url(http://ha.ckers.org/xss.htc);"";>;" (str.replace y "t(1" "x"))) (str.suffixof "</head>" x) (not (str.in_re x ((_ re.from_regex ecma2020) "1[34578]\d{9}$")))))
