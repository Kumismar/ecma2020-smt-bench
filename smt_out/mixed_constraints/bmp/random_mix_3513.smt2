; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<td ondblclick=""alert(1)"">test</td>") (= x "<main draggable=""true"" ondragend=""alert(1)"">test</main>") (= x "<!--<img src=""--><img src=x onerror=javascript:alert(1)//"">")))
(assert (or (= z "t</option>") (= z "t</nextid>") (= z "eleave=""alert(1)"">test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 37) "a"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(http(s)?:)?(\/)?(\/)?(www\.)?(facebook|fb|linkedin)\.com\/.+$"))) (not (str.suffixof "tid>" z)) (not (= (str.at x 38) "t"))))
(assert (or (not (>= (str.len y) 88)) (str.contains z "/nexti") (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{f1}\u{d1}\u{fc}\u{dc}\s]+")))))
(assert (or (not (<= (str.len z) 12)) (not (= "ndblcl" (str.substr x 5 6)))))
(assert (str.prefixof "t<" z))
(assert (or (not (= (str.at x 48) "<")) (not (= (str.len y) 114))))
(check-sat)
