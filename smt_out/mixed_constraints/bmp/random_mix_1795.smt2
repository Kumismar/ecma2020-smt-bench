; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>if(""x\\xEE\xA9\x93"".length==2) { javascript:alert(1);}</script>") (= x "<div draggable=""true"" contenteditable>drag me</div><tbody ondrop=alert(1) contenteditable>drop here</tbody>")))
(assert (or (= z """true"" contenteditable>drag me</div><script ondragover=alert(1) contenteditable>drop here</script>") (= z "/0102.0146.0007.00000223/"";>;XSS<;/A>;")))
(assert (= y (str.++ x z)))
(assert (str.contains z "6.00"))
(assert (= (str.at z 5) "."))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[\sA-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]{2,}$")) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9 ]*"))) (= "gable" (str.substr y 9 5))))
(assert (or (not (str.contains y "14")) (not (str.prefixof """true""" z)) (not (<= (str.len z) 48))))
(assert (not (str.suffixof "}</script>" x)))
(check-sat)
