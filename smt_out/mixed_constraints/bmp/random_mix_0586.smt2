; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<INPUT TYPE=""IMAGE"" SRC=""javascript:javascript:alert(1);"">") (= x "%27%22--%3E%3C%2Fstyle%3E%3C%2Fscript%3E%3Cscript%3ERWAR%280x00010E%29%3C%2Fscript%3E") (= x "<script>ReferenceError.prototype.__defineGetter__('name', function(){alert(123)}),x</script>")))
(assert (or (= z " draggable=""true"" ondragleave=""alert(1)"">test</xmp>") (= z "nu=""alert(1)"">test</h1>") (= z "id=x tabindex=1 onactivate=alert(1)></canvas>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "test</h1>" y) (not (str.suffixof "canvas>" z)) (not (str.in_re z ((_ re.from_regex ecma2020) "^\(?([+]31|0031|0)-?6(\s?|-)([0-9]\s{0,3}){8}$")))))
(assert (or (= (str.indexof x "e" 0) 9) (not (= (str.at x 79) "}")) (not (= "est</" (str.substr y 73 5)))))
(assert (or (not (str.suffixof "mp>" y)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{5d0}-\u{5ea}_-].{2,50}$"))) (= (str.indexof x "or.p" 0) 20)))
(assert (or (= (str.indexof x "et" 0) 42) (str.prefixof " tabind" z) (= (str.len x) 85)))
(check-sat)
