; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer id=x tabindex=1 ondeactivate=alert(1)></footer><input id=y autofocus>") (= x "<menu onmouseout=""alert(1)"">test</menu>")))
(assert (or (= z "1)></area><input autofocus>") (= z "7lert%26lpar;1337)>") (= z "el>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[\/][a-zA-Z\s]+[\/]$"))) (not (= (str.at z 16) " "))))
(assert (or (not (str.contains z "grou")) (= "cus>" (str.substr z 23 10)) (= "l>" (str.substr z 1 2))))
(assert (or (not (= "=" (str.substr y 10 1))) (str.in_re x ((_ re.from_regex ecma2020) "[A-Z0-9a-z_%+-]+[A-Z0-9a-z._%+-]*@[A-Za-z0-9]+[A-Za-z0-9.-]*\.[A-Za-z]{2,64}")) (not (= (str.at z 12) "n"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[0-9-+s()]*$")) (= (str.indexof x "></f" 0) 45)))
(assert (= (str.indexof y "u" 0) 4))
(assert (or (not (= (str.indexof x "us" 0) 10)) (= (str.at x 72) "o")))
(assert (not (= "7lert%26lpar;1337""" (str.replace z ")>" """"))))
(check-sat)
