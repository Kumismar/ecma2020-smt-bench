; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title onPropertyChange title onPropertyChange=""javascript:javascript:alert(1)""></title onPropertyChange>") (= x "<center draggable=""true"" ondragstart=""alert(1)"">test</center>") (= x "<marquee draggable=""true"" ondragleave=""alert(1)"">test</marquee>")))
(assert (or (= z "igure><input autofocus>") (= z "alert((A))>") (= z " oncopy=""alert(1)"" contenteditable>test</em>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "en")) (= (str.len x) 70)))
(assert (or (not (str.contains y "rt(1")) (str.contains z "rt(")))
(assert (or (str.prefixof "<marque" y) (not (= (str.indexof y "er" 0) 5)) (not (str.suffixof "1)"">DEF" y))))
(assert (or (= (str.indexof y "8,83" 0) 50) (not (str.suffixof "rt(1)"">" z)) (= "ale" (str.substr y 20 3))))
(assert (or (= (str.at y 26) "n") (str.prefixof "%25" x) (str.in_re y ((_ re.from_regex ecma2020) "^\+\d{1}\s\d{3}\s\d{7}$"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z'. -]{2,80}")) (not (= (str.indexof y "crip" 0) 53))))
(check-sat)
