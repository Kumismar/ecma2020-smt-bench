; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<import namespace=""t"" implementation=""#default#time2"">") (= x "<ul draggable=""true"" ondragend=""alert(1)"">test</ul>") (= x "<script/src=data&colon;text/j\u{5c}u0061v\u{5c}u0061&#115&#99&#114&#105&#112&#116,\u{5c}u0061%6C%65%72%74(/XSS/)></script")))
(assert (or (= z "onfocusout=alert(1) tabindex=1 id=x></title><input autofocus>") (= z "activate=alert(1)></dl><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 58) "u")) (not (= "ocus>" (str.substr z 40 9)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "\d+(.\d{2})?"))) (not (str.prefixof "=x tab" z))))
(assert (or (str.prefixof "<imp" x) (not (= (str.indexof z "/tit" 0) 37)) (not (str.contains z " aut"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "\([0-9]{2}\) [0-9]{4,6}-[0-9]{3,5}$")) (= (str.at y 146) "t") (str.prefixof "<scrip" x)))
(assert (not (str.contains y "co")))
(assert (or (str.contains x "ort ") (not (= (str.indexof x ">t" 0) 41))))
(assert (not (= (str.indexof x "ef" 0) 9)))
(check-sat)
