; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x1Ajavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<code onclick=""alert(1)"">test</code>") (= x "<style>:target {color: red;}</style><dd id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></dd>")))
(assert (or (= z "d=alert(1)></ruby>") (= z "le><input id=x style=""transition:color 1s"" ontransitionend=alert(1)></input>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 17) "s") (not (str.in_re y ((_ re.from_regex ecma2020) "\(?([0-9]{3})\)?([ .-]?)([0-9]{3})\2([0-9]{4})")))))
(assert (not (= (str.indexof y "scri" 0) 1)))
(assert (or (= "n" (str.substr x 7 1)) (not (str.contains (str.replace z "one" "alert(1)") "tialert(1)n"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^.{0,50}$"))))
(assert (not (= (str.indexof y "np" 0) 112)))
(assert (not (<= (str.len y) 59)))
(assert (= ")"">test</" (str.substr x 40 9)))
(assert (or (not (str.contains (str.replace y ")" "alert(1)") "ert(1alert(1)"">t")) (str.suffixof ">" y)))
(check-sat)
