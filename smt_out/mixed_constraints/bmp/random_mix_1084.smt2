; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q oncopy=""alert(1)"" contenteditable>test</q>") (= x "<style>:target {transform: rotate(180deg);}</style><details id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></details>")))
(assert (or (= z "</output>") (= z "<col ondrop=alert(1) contenteditable>drop here</col>") (= z "rames x{}</style><h1 style=""animation-name:x"" onanimationend=""alert(1)""></h1>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof ">" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "[^a-zA-Z ]")))))
(assert (or (not (= (str.at x 7) "p")) (not (= "</""t>" (str.replace z "outpu" """")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Z\sa-z]{3,20}"))) (= (str.indexof x "tra" 0) 16)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "not_only_whitespace")))
(assert (or (not (>= (str.len z) 44)) (not (str.prefixof "<style" x))))
(assert (not (= "rames x{}xyle><h1 style=""animation-name:x"" onanimationend=""alert(1)""></h1>" (str.replace z "</st" "x"))))
(check-sat)
