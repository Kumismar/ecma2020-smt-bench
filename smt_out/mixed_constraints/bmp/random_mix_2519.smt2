; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onwheel=alert(1)>") (= x "<th onkeyup=""alert(1)"" contenteditable>test</th>") (= x "<b draggable=""true"" ondragenter=""alert(1)"">test</b>")))
(assert (or (= z "\u{1f600}AD=javas\u{20000}cript:alert(1)>") (= z "er=""alert(1)"">test</track>") (= z "(180deg);}</style><pre id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></pre>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "</th>" x))
(assert (or (str.suffixof "ack>" y) (not (str.in_re y ((_ re.from_regex ecma2020) ".*09.*"))) (str.prefixof "<body" x)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^([0-9]{5})$")) (not (str.contains x "e=""tru")) (= (str.at y 35) "b")))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[\w._-]+$")))
(check-sat)
