; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary onmouseover=""alert(1)"">test</summary>") (= x "<html onblur=alert(1) tabindex=1 id=x></html><input autofocus>") (= x "<colgroup onmousemove=""alert(1)"">test</colgroup>")))
(assert (or (= z "est</meta>") (= z "ert(String.fromCharCode(88,83,83))"">") (= z "able=""true"" contenteditable>drag me</div><i ondrag\u{1f4a9}over=alert(1) contenteditable>drop here</i>")))
(assert (= y (str.++ x z)))
(assert (not (= "<html onblur=alert(1) tabindex=1 id=x></html><input autofocus>able=""true"" contenteditable>drag me</div><i ondrag\u{1f4a9}over=alert(1) contenteditable>drop xe</i>" (str.replace y "her" "x"))))
(assert (or (not (<= (str.len z) 96)) (>= (str.len y) 78) (str.prefixof "ert(Str" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Z0-9]{1,65}"))) (not (str.suffixof "mand>" x)) (not (str.contains (str.replace y "t(" "javascript:") "alerjavascript:do"))))
(assert (= "<colgroup onmousemove=""alert(1)"">test</colgroup>able=""true""tenteditable>drag me</div><i ondrag\u{1f4a9}over=alert(1) contenteditable>drop here</i>" (str.replace y " con" "")))
(assert (or (not (str.suffixof "ion>" y)) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*[a-zA-Z])(?=.*\d)[\s\S]{6,16}$")))))
(assert (= (str.at x 14) "u"))
(assert (not (str.contains z "r>")))
(check-sat)
