; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><summary ondrop=alert(1) contenteditable>drop here</summary>") (= x "<cite oncopy=""alert(1)"" conte\u{10348}nteditable>test\u{1d400}</cite>") (= x "<div onmousemove=""alert(1)"">test</div>")))
(assert (or (= z "lert(1)"" contenteditable>\u{1d400}test</ins>") (= z """alert(1)"">test</optgroup>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "t(1" "<b>") "aler<b>)"">") (not (= "t=""a" (str.substr z 6 4))) (not (= (str.at z 1) "e"))))
(assert (not (= (str.len z) 36)))
(assert (or (not (str.contains (str.replace x "cite" "") "< on")) (not (= (str.indexof x "(" 0) 23)) (= (str.len y) 130)))
(assert (or (= (str.at y 87) "p") (not (str.in_re y ((_ re.from_regex ecma2020) "\d+(\.\d+)?$"))) (not (= (str.at x 4) " "))))
(check-sat)
