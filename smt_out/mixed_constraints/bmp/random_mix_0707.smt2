; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""126""><object id=""x"" classid=""clsid:CB927D12-4FF7-4a9e-A169-56E4B8A75598""></object>") (= x "<IMG SRC=x onkeypress=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "><base href=""javascript://""></head><body><a href=""/. /,javascript:alert(1)//#"">XXX</a></body>") (= z "st</map>") (= z "editable>test</big>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof ">" y))
(assert (not (= (str.indexof z "m" 0) 4)))
(assert (or (not (= "p>" (str.substr z 6 8))) (= (str.indexof x "4" 0) 53)))
(assert (or (not (<= (str.len z) 100)) (= "7-4a9e-" (str.substr y 56 7))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Z][A-Za-z.-]+"))))
(assert (or (not (str.prefixof "<IM" y)) (= "div id=""12" (str.substr x 1 10))))
(assert (or (str.contains z "st</map>") (not (str.suffixof "3,83))"">" x))))
(assert (str.contains x "tring.fro"))
(assert (or (not (str.suffixof "/object>" x)) (str.prefixof "<" x)))
(check-sat)
