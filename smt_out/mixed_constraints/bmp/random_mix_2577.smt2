; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<p onmouseup=""alert(1)"">te\u{1d400}st</p>") (= x "<meta onkeyup=""alert(1)"" contenteditable>test</meta>") (= x "<body onMouseMove body onMouseMove=""javascript:javascript:alert(1)""></body \u{1f4a9}onMouseMove>")))
(assert (or (= z "index=1 id=x></head><input autofocus>") (= z "cript>alert('XSS')</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 37)) (= (str.len z) 38) (not (str.suffixof "t>" z))))
(assert (or (= (str.indexof y "\u{1f600}" 0) 25) (str.suffixof "focus>" x) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{c5}\u{c4}\u{d6}\u{e5}\u{e4}\u{f6} \-]{2,25}$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "(?<!\w)(\(?(\+|00)?48\)?)?[ -]?\d{3}[ -]?\d{3}[ -]?\d{3}(?!\w)"))))
(assert (not (= (str.indexof y "(1)"" " 0) 20)))
(check-sat)
