; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b id=x tabindex=1 onactivate=alert(1)></b>") (= x "<element onmousedown=""alert(1)"">test</element>") (= x "<font id=x tabindex=1 onfocus=alert(1)></font>")))
(assert (or (= z "re style=""animation-name:x"" onanimationstart=""al\u{10348}ert(1)""></pre>") (= z "ble>drop here</ins>") (= z "ntenteditable>drop here</frame>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "index=1 o")) (not (str.suffixof "frame>" y)) (not (= "t" (str.substr z 4 1)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-z0-9]+(\.[_a-z0-9]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,15})$"))) (not (str.contains z "t(1)""></"))))
(assert (= (str.indexof y "=1" 0) 16))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) ".*^\d{2,4}-?\d{2,4}-?\d{4}$.*")) (not (= (str.at x 8) "="))))
(check-sat)
