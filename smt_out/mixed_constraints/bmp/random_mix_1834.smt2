; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title onkeyup=""alert(1)"" contenteditable>test</title>") (= x "<nobr ondblclick=""alert(1)"">test</nobr>") (= x "<del onmouseenter=""alert(1)"">test</del>")))
(assert (or (= z "ex=1 id=x></kbd><input autofocus>") (= z "editable>test</code>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<nobr " x)) (not (= (str.at x 25) "j")) (str.suffixof "tle>" x)))
(assert (or (= (str.indexof x "</" 0) 46) (not (str.in_re z ((_ re.from_regex ecma2020) "^([\u{410}-\u{42f}0-9]([\u{430}-\u{44f}0-9]){0,}(.)?){1,}$")))))
(assert (or (not (>= (str.len y) 69)) (not (= (str.at x 0) "<"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}]+[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}\- \/]{1,29}$")) (not (<= (str.len z) 41))))
(assert (or (not (= "/em>" (str.substr x 41 4))) (not (= (str.at y 12) "u")) (= "<alert(1)r ondblclick=""alert(1)"">test</nobr>editable>test</code>" (str.replace y "nob" "alert(1)"))))
(assert (= (str.indexof x "seent" 0) 10))
(check-sat)
