; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onkeydown=""alert(1)"" contenteditable>test</iframe>") (= x "<embed oncopy=""alert(1)"" contenteditable>test</embed>") (= x "<style>:target {color: red;}</style><frameset id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></frameset>")))
(assert (or (= z "able>test</thead>") (= z "=""animation-name:x"" onanimationend=""alert(1)""></abbr>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-zA-z]{2,4}$"))))
(assert (or (not (>= (str.len y) 98)) (not (str.contains (str.replace y ">able" "x") "etx>")) (not (= (str.indexof z "u" 0) 3))))
(assert (or (= (str.indexof x "</i" 0) 49) (not (str.contains (str.replace y "st<" "<b>") "e<b>/"))))
(assert (or (= (str.len x) 58) (not (= (str.indexof y "at" 0) 76))))
(check-sat)
