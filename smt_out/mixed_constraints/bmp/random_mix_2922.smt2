; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame id=x tabindex=1 onactivate=alert(1)></frame>") (= x "&lt;br size=\&quot;&amp;{alert(&#039;XSS&#039;)}\&quot;&gt;") (= x "<fieldset onmouseenter=""alert(1)"">test</fieldset>")))
(assert (or (= z "alert(1)></input>") (= z ")"">test</base>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "e>"))
(assert (= (str.indexof x "r" 0) 5))
(assert (or (= "t</col" (str.substr z 24 6)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\x00-\x7F]+$"))) (not (str.suffixof ">" y))))
(assert (or (not (= (str.at x 72) "e")) (str.contains (str.replace y ">t" "alert(1)") """alert(1)e")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{6,22}"))) (str.contains x "frame>") (not (= "op" (str.substr z 18 2)))))
(assert (str.prefixof "<style>:" x))
(assert (= "ex=1 ona" (str.substr x 18 8)))
(check-sat)
