; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br onmousedown=""alert(1)"">test</br>") (= x "<style>:target {color:red;}</style><applet id=x style=""transition:color 1s"" ontransitionend=alert(1)></applet>")))
(assert (or (= z "summary>") (= z "lert(1)"">")))
(assert (= y (str.++ x z)))
(assert (= "mouse" (str.substr y 6 5)))
(assert (not (= "r:red;}</s" (str.substr x 20 10))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(?:0|\(?\+33\)?\s?|0033\s?)[1-79](?:[\.\-\s]?\d\d){4}$"))) (not (str.prefixof "<s" x)) (str.suffixof """>" z)))
(assert (or (= (str.at y 39) "t") (not (= (str.at y 94) "e")) (= (str.len z) 8)))
(assert (not (= "le=""tr" (str.substr y 51 6))))
(check-sat)
