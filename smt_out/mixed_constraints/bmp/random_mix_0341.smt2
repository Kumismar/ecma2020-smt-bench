; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video src=1 href=1 onerror=""javascript:alert(1)""></video>") (= x "<fieldset onbeforecopy=""alert(1)"" contenteditable>test</fieldset>") (= x "&#x3c\u{1d400}")))
(assert (or (= z "lert(1)"">test</wbr>") (= z "://corkami.googlecode.com/svn/!svn/bc/480/trunk/misc/pdf/helloworld_js_X.pdf"">?")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "lert(1)""" z)) (= "&#x3c\u{1d400}alert(1)(1)"">test</wbr>" (str.replace y "lert" "alert(1)"))))
(assert (= "<br onbeforepaste=""alert(1)"" contenteditable>test</br>out=""alert(1)xtest</tr>" (str.replace y """>" "x")))
(assert (or (not (= "1)""" (str.substr x 30 3))) (not (str.suffixof "br>" y))))
(assert (or (not (str.suffixof "ption>" y)) (not (<= (str.len x) 39)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]+")))))
(assert (str.contains x "CRIPT>aler"))
(check-sat)
