; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist onbeforecut=""alert(1)"" contenteditable>test</datalist>") (= x "<dl onmouseenter=""alert(1)"">test</dl>") (= x "<center draggable=""true"" ondrag=""alert(1)"">test</center>")))
(assert (or (= z "us=alert(1)></rt>") (= z "id=x></fieldset><input autofocus>") (= z "/XSS/")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "test" 0) 28) (str.suffixof "st>" x)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^\b[\w ]{1,50}\b$")) (str.contains (str.replace z "/XSS/" "javascript:") "javascript:")))
(assert (or (= "S/" (str.substr z 3 7)) (str.in_re x ((_ re.from_regex ecma2020) "^\s*(\w|\W)+\s*"))))
(assert (or (not (= ">/X" (str.substr y 63 3))) (not (= (str.indexof x "r" 0) 16)) (not (str.contains z "/XSS"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[1-9][0-9]{0,9}"))))
(assert (str.contains (str.replace y "u" "") "ect="))
(assert (not (= "=""ale" (str.substr x 16 5))))
(assert (or (not (str.contains (str.replace x "beha" "alert(1)") "E=""alert(1)vior:")) (str.prefixof "id=x>" z)))
(check-sat)
