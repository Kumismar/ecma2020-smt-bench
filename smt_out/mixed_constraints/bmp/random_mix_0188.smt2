; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;A HREF="";http://www.google.com./"";>;XSS<;/A>;") (= x "<style>:target {transform: rotate(180deg);}</style><table id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></table>") (= x "<sub id=x tabindex=1 onactivate=alert(1)></sub>")))
(assert (or (= z "ng.fromCharCode(88,83,83))"">") (= z "t(1);></embed>") (= z "put autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(\d?){11}$"))))
(assert (or (not (= (str.at z 11) "C")) (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\s]{3,30}$")) (not (= (str.indexof x " t" 0) 9))))
(assert (not (= (str.at z 22) "8")))
(assert (or (= "SS<;/" (str.substr y 39 5)) (str.suffixof ",83,83))"">" y) (not (= (str.len x) 128))))
(assert (or (= "8,83,8" (str.substr z 17 6)) (not (str.contains (str.replace x "n" "") "a omous"))))
(check-sat)
