; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex onmousedown=""alert(1)"">test</isindex>") (= x "<hgroup onbeforepaste=""alert(1)"" contenteditable>test</hgroup>") (= x "ABC<div style=""x:\xE2\x80\x80expression(javascript:alert(1)"">DEF")))
(assert (or (= z "ationend=""alert(1)""></abbr>") (= z "ue"" ondragleave=""alert(1)"">test</em>")))
(assert (= y (str.++ x z)))
(assert (= (str.at z 17) ")"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[^\s].+[^\s]$"))))
(assert (or (not (str.contains (str.replace z "lert" "") """a(1)"">")) (>= (str.len y) 95) (not (str.in_re x ((_ re.from_regex ecma2020) "^(13[0-9]|14[579]|15[0-3,5-9]|16[6]|17[0135678]|18[0-9]|19[89])\\d{8}$")))))
(assert (or (not (= "1 on" (str.substr x 17 4))) (not (str.suffixof ">" z)) (not (= "<isindex onmousedown=""alert(1)"">test</isindex>ation alert(1)""></abbr>" (str.replace y "end=""" " ")))))
(assert (or (not (str.suffixof "l>" z)) (not (str.suffixof "/hgroup>" x)) (= (str.len y) 73)))
(assert (or (= "alert(" (str.substr z 10 6)) (not (= "ss=""alert" (str.substr x 18 9))) (= "ABC<div style=""x:\xE2\x80\x80expression(javascr lert(1)"">DEF" (str.replace x "ipt:a" " "))))
(assert (= (str.at z 20) "<"))
(check-sat)
