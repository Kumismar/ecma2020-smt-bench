; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sVg><scRipt %00>alert&lpar;1&rpar; {Opera}") (= x "<IMG SRC=""jav ascript:javascript:alert(1);"">")))
(assert (or (= z "!-- Up to Opera 10.63 -->") (= z "alert(1)"">test</ul>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ">" y) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,7}$"))) (str.contains (str.replace y "a" "alert(1)") "00>alert(1)lert")))
(assert (str.suffixof "ert(1);"">" x))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(www.)+([a-zA-Z0-9-_]+)+[.]+(?:[a-zA-Z0-9-]+)"))))
(assert (or (str.prefixof "a" z) (not (= (str.at x 34) ";")) (str.suffixof "; {Opera}" x)))
(assert (or (not (<= (str.len z) 26)) (str.in_re x ((_ re.from_regex ecma2020) "^[1-9]([0-9]?)(,[0-9]{1,2})?$")) (not (str.prefixof "<sVg><sc" x))))
(assert (not (>= (str.len x) 36)))
(check-sat)
