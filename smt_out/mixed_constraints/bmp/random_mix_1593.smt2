; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nobr draggable=""true"" ondragleave=""alert(1)"">test</nobr>") (= x "&lt;A HREF=\""htt p&#58;//6 6&#46;000146&#46;0x7&#46;147/\""&gt;XSS&lt;/A&gt;")))
(assert (or (= z "ipt:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "x tabindex=1 onactivate=alert(1)></tbody>") (= z "ert(1)"">test</dl>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 14) "w") (not (= "<nobr draggable=""true"" ondragleave=""alert(1)"">test</nobr(1)"">test</dl>" (str.replace y ">ert" "")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9A-Za-z_]{1,8}$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[^!@#\$%\^&\*\(\)?<>;""]+"))) (str.suffixof "/A&gt;" x) (not (str.contains x "ve=""a"))))
(assert (= (str.len x) 75))
(assert (not (str.contains z " ta")))
(assert (= "<nobr draggable=""true"" ondragleave=""alert(1)"">test</nobrt(1)"">test</dl>" (str.replace y ">er" "")))
(check-sat)
