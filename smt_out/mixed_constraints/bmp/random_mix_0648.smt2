; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onmousedown=""alert(String.fromCharCode(88,83,83))"">") (= x "<blockquote id=x tabindex=1 onfocus=alert(1)></b\u{1f600}lockquote>") (= x "<rp onfocusout=alert(1) tabindex=1 id=x></rp><input autofocus>")))
(assert (or (= z "PT>;alert(';XSS';)<;/SCRIPT>;") (= z "nk below -->") (= z "/head>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<rp on" y) (not (= (str.at y 88) "T")) (str.prefixof "nk belo" z)))
(assert (or (not (= (str.at y 29) "d")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z\u{105}\u{104}\u{107}\u{107}\u{119}\u{119}\u{142}\u{141}\u{144}\u{143}\u{f3}\u{d3}\u{15b}\u{15a}\u{17c}\u{17b}\u{179}\u{179} ]{4,60}$")))))
(assert (or (str.contains z "IPT>") (= (str.indexof z ")>" 0) 0)))
(assert (not (= "S" (str.substr z 21 1))))
(assert (or (not (= (str.indexof x "lert(" 0) 16)) (= (str.len y) 91) (not (str.prefixof "n" z))))
(assert (str.suffixof "ckquote>" x))
(check-sat)
