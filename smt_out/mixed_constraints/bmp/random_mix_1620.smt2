; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><canvas onload=alert(1)></canvas>") (= x "<html draggable=""true"" ondragstart=""alert(1)"">test</html>")))
(assert (or (= z "ondragend=""alert(1)"">test</area>") (= z "onblur=alert(1) tabindex=1 id=x></tt><input autofocus>") (= z "g me</div><dfn ondrop=alert(1) contenteditable>drop here</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "</del>" z) (= " onload" (str.substr x 12 7)) (not (>= (str.len z) 44))))
(assert (or (not (= (str.at x 17) "a")) (not (str.in_re x ((_ re.from_regex ecma2020) "^LC\d{3,7}|lc\d{3,7}$")))))
(assert (or (= "onblux=alert(1) tabindex=1 id=x></tt><input autofocus>" (str.replace z "r" "x")) (= (str.indexof y "end" 0) 63) (str.contains z "ditabl")))
(assert (or (not (str.contains z "contente")) (not (str.prefixof "onb" z))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9\+][0-9 ()\-]{0,29}$"))))
(check-sat)
