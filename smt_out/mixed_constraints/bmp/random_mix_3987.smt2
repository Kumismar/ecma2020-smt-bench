; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture><source srcset=""validimage.png""><image onloadstart=alert(1)></picture>") (= x "<style>:target {color:red;}</style><samp id=x style=""transition:color 1s"" ontransitionend=alert(1)></samp>") (= x "<video id=x tabindex=1 onbeforeactivate=alert(1)></video>")))
(assert (or (= z "tenteditable>test</applet>") (= z """ ondragend=""alert(1)"">test</rb>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "test</" (str.substr y 81 6))) (= (str.len z) 32) (not (str.prefixof "te" z))))
(assert (str.contains z "ondragend="))
(assert (or (not (= "1s"" ont" (str.substr z 22 7))) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d\d|\d\d\d)$")))))
(assert (not (= (str.indexof y "e" 0) 5)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{5}"))) (>= (str.len y) 138) (>= (str.len y) 79)))
(assert (str.prefixof "<vid" x))
(check-sat)
