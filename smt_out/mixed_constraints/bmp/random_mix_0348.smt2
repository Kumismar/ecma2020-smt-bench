; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd draggable=""true"" ondragleave=""alert(1)"">test</dd>") (= x "<dt id=x tabindex=1 onbeforeactivate=alert(1)></dt>")))
(assert (or (= z "rt(1)></big>") (= z "ntextmenu=""alert(1)"">test</s>") (= z ">test</article>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "1)""" 0) 40)) (not (= (str.indexof y "activ" 0) 28)) (str.in_re z ((_ re.from_regex ecma2020) "^([0-2]?[0-9]|3[01])$"))))
(assert (or (not (str.contains z "ntext")) (= "t" (str.substr y 9 1)) (not (= (str.at x 26) "g"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!#^\-%*_?&])[A-Za-z\d@$!#^\-%_*?&]{6,}"))))
(assert (>= (str.len x) 42))
(check-sat)
