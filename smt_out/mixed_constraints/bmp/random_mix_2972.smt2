; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<BODY ONLOAD=alert(\u{2018}XSS\u{2019})>") (= x "<form><input formaction=javascript:alert(1) type=image src=SOURCE>") (= x "<u onbeforecopy=""alert(1)"" contenteditable>test</u>")))
(assert (or (= z "ouseenter=""alert(1)"">test</nextid>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<u o" x) (str.contains x "np")))
(assert (or (>= (str.len x) 51) (str.contains (str.replace x "rec" " ") "nbefo opy") (= (str.indexof x "inpu" 0) 7)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{7}-[0-9]{7}$")) (= (str.len x) 44) (str.contains x " onbeforec")))
(assert (or (not (str.suffixof ">" z)) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z\u{e1}\u{e9}\u{ed}\u{142}\u{f3}\u{fa}\u{fc}\u{173}\u{16b}\u{f1}\u{e7}\u{dc}\u{d1}\u{c7}\u{f0} ,.'-]{2,40}")))))
(assert (str.prefixof "<form><inp" y))
(assert (or (= (str.at y 59) "y") (= (str.at x 42) ">") (str.suffixof "u>" x)))
(check-sat)
