; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure id=x tabindex=1 onfocus=alert(1)></figure>") (= x "<div id=""136""><form action="""" method=""post"">")))
(assert (or (= z """>test</rb>") (= z "TA[<IMG SRC=""javas<![CDATA[cript:alert('XSS')\u{1f4a9};"">")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "((\d{5}))")))
(assert (or (= (str.len z) 11) (str.contains z "')") (str.prefixof """>" z)))
(assert (not (= (str.indexof x "d=" 0) 6)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9]{13,13}$")))
(assert (not (str.contains x "tyle=""tran")))
(assert (not (str.contains (str.replace y "d=" "") "e ix tab")))
(check-sat)
