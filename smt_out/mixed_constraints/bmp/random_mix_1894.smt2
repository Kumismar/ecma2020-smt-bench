; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<code onbeforecopy=""alert(1)"" contenteditable>test</code>") (= x "<style>@keyframes x{}</style><dir style=""animation-name:x"" onanimationend=""alert(1)""></dir>") (= x """><img src=x onerror=javascript:alert('1')>")))
(assert (or (= z "(1)"" contenteditable>test</img>") (= z "x\u{10348}003C;")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "x\u{10348}003C" z))
(assert (str.contains (str.replace z "(1)"">" "alert(1)") "talert(1)te"))
(assert (or (not (= (str.at y 54) "d")) (not (= (str.at z 0) "x")) (str.in_re x ((_ re.from_regex ecma2020) "^\d{5}$"))))
(assert (or (not (= "00" (str.substr z 2 2))) (<= (str.len x) 49) (= (str.indexof y "es x{" 0) 15)))
(assert (not (str.contains y "@keyfr")))
(check-sat)
