(assert (str.in_re z ((_ re.from_regex ecma2020) "^(?:\+?61|0)4(?:[01]\d{3}|(?:2[1-9]|3[0-57-9]|4[7-9]|5[0-15-9]|6[679]|7[3-8]|8[1478]|9[07-9])\d{2}|(?:20[2-9]|444|52[0-6]|68[3-9]|70[0-7]|79[01]|820|890|91[0-4])\d|(?:200[0-3]|201[01]|8984))\d{4}$")))
(assert (or (str.suffixof "mage>" y) (not (= (str.indexof z "age>" 0) 9))))
(assert (or (= "t</appl" (str.substr y 50 7)) (not (= "enter=""al" (str.substr z 12 9))) (str.suffixof "a>" z)))
