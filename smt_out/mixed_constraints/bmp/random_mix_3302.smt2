; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem onmouseup=""alert(1)"">test</menuitem>") (= x "<option draggable=""true"" ondragenter=""alert(1)"">test</option>") (= x "<wbr id=x tabindex=1 onbeforedeactivate=alert(1)></wbr><input autofocus>")))
(assert (or (= z "br>") (= z "p><input \u{1f600}autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[\w\s-]{10,}"))))
(assert (or (not (str.prefixof "br>" z)) (not (= (str.at x 15) "s")) (= "<option draggablalert(1)""true"" ondragenter=""alert(1)"">test</option>" (str.replace x "e=" "alert(1)"))))
(assert (or (not (= (str.indexof z ")<" 0) 4)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_\-\.\+]{1,}@([\da-zA-Z-]{1,}\.){1,}[\da-zA-Z-]{2,20}$")))))
(assert (or (not (str.suffixof "n>" x)) (str.contains x "true"" ondr") (not (str.contains x "ter="))))
(check-sat)
