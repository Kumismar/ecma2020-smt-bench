; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<data onbeforecut=""alert(1)"" contenteditable>test</data>") (= x "<aside draggable=""true"" ondragend=""alert(1)"">test</aside>") (= x "<ruby onpaste=""alert(1)"" contenteditable>test</ruby>")))
(assert (or (= z "vascript:javascript:alert(1);></embed>") (= z "up>") (= z "ble>test</rtc>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "<" "") "r") (not (= "ipt:al" (str.substr z 16 6))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\d\+\(\)\s\.\-/]+$")))))
(assert (not (= (str.at x 0) "<")))
(assert (not (= """ content" (str.substr y 27 9))))
(assert (or (not (>= (str.len z) 8)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z]{2}[0-9]{22}$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{5c}u4e00-\u{5c}u9fa5]{2,3}$")))))
(check-sat)
