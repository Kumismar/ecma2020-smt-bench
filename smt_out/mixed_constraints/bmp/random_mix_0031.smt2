; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onkeyup=""alert(String.fromCharCode(88,83,83))"">") (= x "<div draggable=""true"" contenteditable>drag me</div><dialog ondragover=alert(1) contenteditable>drop here</dialog>")))
(assert (or (= z "test\u{1f600}</object>") (= z "oncopy=alert(1) autofocus>XSS</textarea>") (= z "ogress sty\u{1d400}le\u{1f600}=""animation-name:x"" onanimationend=""alert(1)""></progress>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%-]+@[a-z0-9.-]+\.[a-z]{2,4}$"))) (not (= (str.indexof y "v dr" 0) 3))))
(assert (or (not (= (str.indexof z "/obje" 0) 6)) (not (= (str.at z 38) "a")) (not (str.in_re y ((_ re.from_regex ecma2020) "^.{2,30}")))))
(assert (or (= "test\u{1f600}<bject>" (str.replace z "/o" "")) (<= (str.len x) 65)))
(assert (str.prefixof "<" x))
(assert (or (= (str.at x 98) "p") (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df} -_]+$"))) (= "e(88,83,8" (str.substr x 44 9))))
(check-sat)
