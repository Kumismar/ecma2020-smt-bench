; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;DIV STYLE="";width: expression(alert(';XSS';));"";>;") (= x "<strike oncopy=""alert(1)"" contenteditable>test</strike>") (= x "<style>@keyframes x{}</style><blink style=""animation-name:x"" onanimationstart=""alert(1)""></blink>")))
(assert (or (= z "t(String.fromCharCode(88,83,83))"">") (= z "t</a>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace x "nt" "x") """ coxe"))
(assert (or (= "de(88,8" (str.substr z 19 7)) (not (= (str.indexof z "t</a>" 0) 0)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]{3}[0-9]{3}")))))
(assert (or (str.suffixof "/blink>" x) (str.in_re z ((_ re.from_regex ecma2020) "^\d{2}/\d{2}/\d{4}$"))))
(assert (or (str.contains (str.replace z "Code" "alert(1)") "haralert(1)(") (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9a-zA-Z]{1,15}$"))) (not (= (str.at x 15) "l"))))
(assert (or (= (str.at y 1) "s") (not (str.suffixof "</spacer>" y)) (= (str.at z 12) "m")))
(check-sat)
