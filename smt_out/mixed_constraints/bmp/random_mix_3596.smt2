; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dl onmousedown=""alert(1)"">test</dl>") (= x "<section onmouseover=""alert(1)"">test</section>") (= x "<abbr id=x tabindex=1 onbeforedeactivate=alert(1)></abbr><input autofocus>")))
(assert (or (= z "//www.w3.org/1999/xhtml""") (= z "n=""alert(1)"" contenteditable>test</element>") (= z "ctivate=alert(1)></canvas><input \u{1f4a9}autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y "(1)"" " "javascript:") "ertjavascript:con") (not (= "osc" (str.substr z 9 3))) (not (= (str.at z 6) ")"))))
(assert (not (str.contains z "autofocus>")))
(assert (= (str.indexof x "a" 0) 22))
(assert (not (str.prefixof "<section o" y)))
(assert (not (str.prefixof "<d" x)))
(assert (or (= (str.at z 2) "b") (= (str.len y) 88) (str.contains z "tentedita")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[9|8|7]\d{9}$"))) (str.prefixof "<dl on" x)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^([A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3})$"))))
(check-sat)
