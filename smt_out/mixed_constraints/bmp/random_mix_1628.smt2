; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript oncut=""alert(1)"" contenteditable>test</noscript>") (= x "<kbd oncut=""alert(1)"" contenteditable>test</kbd>")))
(assert (or (= z "script:alert('XSS');""></FRAMESET>") (= z "nmousemove=""alert(1)"">test</svg>") (= z "r 10s"" ontransitioncancel=alert(1)></listing>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "(1)"">" 0) 14)))
(assert (not (= (str.indexof y "t" 0) 9)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\S.*([\s]).*\S$"))) (not (= "<kbd xut=""alert(1)"" contenteditable>test</kbd>script:alert('XSS');""></FRAMESET>" (str.replace y "onc" "x")))))
(assert (or (str.suffixof "st</svg>" y) (= "ve=""alert(" (str.substr y 18 10))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{5}|\d{5})$"))) (= (str.indexof y "nosc" 0) 1)))
(check-sat)
