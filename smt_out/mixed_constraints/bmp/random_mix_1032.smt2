; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dl onmousedown=""alert(1)"">test</dl>") (= x "<noembed onclick=""alert(1)"">test</noembed>") (= x "<svg><th onload=alert(1)\u{1d400}></th>")))
(assert (or (= z "ut=""alert(1)"" contenteditable>test</isindex>") (= z "editable>test</basefont>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 9) "t") (not (str.contains (str.replace x "t" " ") "<s yle")) (= (str.indexof z "sind" 0) 37)))
(assert (or (not (str.suffixof "*//sub>" y)) (str.in_re y ((_ re.from_regex ecma2020) "me douche")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9 +][0-9 ()-]+")))))
(assert (not (>= (str.len z) 40)))
(assert (or (not (str.prefixof "<noembed o" y)) (str.suffixof "ex>" y)))
(assert (or (not (str.suffixof "font>" z)) (= (str.at y 21) "r") (= "<dl on" (str.substr x 0 6))))
(check-sat)
