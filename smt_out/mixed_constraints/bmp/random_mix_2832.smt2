; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<code id=x tabindex=1 onfocusin=alert(1)></code>") (= x "<marquee onblur=alert(1) tabindex=1 id=x></marquee><input autofocus>") (= x "<style>@keyframes x{}</style><optgroup style=""animation-name:x"" onanimationstart=""alert(1)""></optgroup>")))
(assert (or (= z "semove=""alert(1)"">test</fi\u{1f4a9}eldset>") (= z " onkeydown=""alert(1)"" contenteditable>test</tfoot>") (= z "dragleave=""alert(1)"">test</kbd>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[-a-zA-Z0-9~!$%^&*_=+}{'?]+(\.[-a-zA-Z0-9~!$%^&*_=+}{'?]+)*@([a-zA-Z0-9_][-a-z0-9_]*(\.[-a-zA-Z0-9_]+)*\.([a-zA-Z]{1,20})|([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}))(:[0-9]{1,5})?$")))
(assert (or (= "<style>@keyframes x{}</style><optgroup style=""animation-name:x"" onanimationstart=""aler<b>></optgroup>" (str.replace x "t(1)""" "<b>")) (str.prefixof "<styl" y) (= (str.len x) 68)))
(assert (not (str.contains (str.replace x """>" "") "rt(1)tes")))
(assert (or (not (str.contains y "<cod")) (= (str.at y 28) ">")))
(assert (or (not (<= (str.len y) 86)) (str.contains x "oN") (str.prefixof "<st" y)))
(assert (not (<= (str.len z) 58)))
(check-sat)
