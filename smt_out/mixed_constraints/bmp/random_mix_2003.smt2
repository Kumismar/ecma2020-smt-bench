; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form onmousemove=""al\u{1f600}ert(1)"">te\u{1d400}st</form>") (= x "<time id=x tabindex=1 onactivate=alert(1)></time>") (= x "<iframe draggable=""true"" ondragstart=""alert(1)"">test</iframe>")))
(assert (or (= z "samp onbeforecut=""alert(1)"" contenteditable>test</samp>") (= z "ody onbeforeprint=alert(1)>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (= "nbef" (str.substr z 5 4)))
(assert (or (not (= (str.indexof y "/if" 0) 53)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_+&*-]+(?:\.[a-zA-Z0-9_+&*-]+)*@(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,7}$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{5}([\-]?\d{4})?$"))))
(assert (str.contains (str.replace z ">" "alert(1)") "alert(1)"))
(assert (or (= "<iframe draggable=""true"" ondragstart=""alert(1)"">tiframe>" (str.replace x "est</" "")) (= "<iframe draggable=""txondragstart=""alert(1)"">test</iframe>>" (str.replace y "rue"" " "x"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9]{6,}"))))
(assert (or (not (str.contains y "pr")) (str.contains y "me dragga") (str.prefixof "samp onb" z)))
(assert (or (not (str.suffixof "/strong>" z)) (str.suffixof "t</iframe>" x) (str.contains z ">")))
(check-sat)
