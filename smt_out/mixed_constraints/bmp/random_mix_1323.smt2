; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><em style=""animation-name:x"" onanimationend=""alert(1)""></em>") (= x "<colgroup id=x tabindex=1 onactivate=alert(1)></colgroup>") (= x "<;META HTTP-EQUIV="";Link""; Content="";<;http://ha.ckers.org/xss.css>;; REL=stylesheet"";>;")))
(assert (or (= z "est</colgroup>") (= z "vascript:alert(&apos;XSS&apos;);&quot;&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (= "/xrames>" (str.replace z "nof" "x"))) (not (str.prefixof "<style" y))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-z0-9]+\.?-?[a-z0-9]+@[a-z0-9]+-?[a-z0-9]+\.[a-z]{2,4}$"))))
(assert (or (= ";&gt;" (str.substr z 37 8)) (str.contains z ");&quot;&")))
(assert (or (not (= (str.at x 75) "t")) (str.contains (str.replace x "="";L" "x") "UIVxi")))
(assert (not (= (str.len x) 89)))
(check-sat)
