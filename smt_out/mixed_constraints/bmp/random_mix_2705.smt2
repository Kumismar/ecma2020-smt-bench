; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><col style=""animation-name:x"" onanimationstart=""alert(1)""></col>") (= x "<s draggable=""true"" ondragenter=""alert(1)"">test</s>") (= x "<dir onmouseover=""alert(1)"">test</dir>")))
(assert (or (= z "Pt>alert\u{1d400}(1)</sCriPt>") (= z "t(1)></blockquote><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^\D{1,20}$")))
(assert (str.prefixof "t(1)>" z))
(assert (= (str.at x 26) "e"))
(assert (or (= "<s dxaggable=""true"" ondragenter=""alert(1)"">test</s>Pt>alert\u{1d400}(1)</sCriPt>" (str.replace y "r" "x")) (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-9]{3}|[0-9]{7})$")))))
(assert (or (= "<s draggable=""true"" ondragenter=""aalert(1)(1)"">test</s>" (str.replace x "lert" "alert(1)")) (= (str.at z 30) "o")))
(assert (= (str.at x 27) "n"))
(check-sat)
