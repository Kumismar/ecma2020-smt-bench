; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<![><img src=""]><img src=x onerror=alert(XSS)//"">") (= x "&#34;&#62;<h1/onmouseover='\u{5c}u0061lert(1)'>") (= x "<template onmouseout=""alert(1)"">test</template>")))
(assert (or (= z " {color: red;}</style><time id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></time>") (= z "ehavior: url(%(htc)s);"">")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(?:0?[1-9]|1[012])([\/-])(?:0?[1-9]|[12]\d|3[01])\1(?:(?:19|20)?)\d\d$"))))
(assert (= (str.indexof y "%(htc" 0) 62))
(assert (or (not (= (str.at x 40) "m")) (not (= (str.indexof x "(XS" 0) 40))))
(assert (or (not (= (str.at z 23) ">")) (not (str.contains (str.replace x "/" "alert(1)") "est<alert(1)tem"))))
(assert (= (str.at y 26) "'"))
(assert (not (>= (str.len y) 129)))
(check-sat)
