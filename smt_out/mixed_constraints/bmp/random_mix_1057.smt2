; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><picture ondrop=alert(1) contenteditable>drop here</picture>") (= x "<del id=x tabindex=1 onfocus=alert(1)></del>")))
(assert (or (= z "(1)"" contenteditable>test</font>") (= z "lur=alert(1) id=x><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<del id=x tabindex=1 onfx=alert(1)></del>" (str.replace x "ocus" "x"))) (not (= "t" (str.substr x 33 1)))))
(assert (not (str.prefixof "<d" x)))
(assert (or (= (str.at y 60) " ") (str.prefixof "<del id=x" x) (not (= "ript:alx(1)"" >" (str.replace z "ert" "x")))))
(assert (str.suffixof "cture>" x))
(assert (or (not (= (str.at z 19) "v")) (str.in_re z ((_ re.from_regex ecma2020) "^[1-9][0-9]{4,14}$")) (str.contains (str.replace x "tente" " ") """ con dita")))
(assert (not (= ">" (str.substr x 91 1))))
(assert (or (str.suffixof "meter>" z) (str.suffixof "focus>" y)))
(check-sat)
