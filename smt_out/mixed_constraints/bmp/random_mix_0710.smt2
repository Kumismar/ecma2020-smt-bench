; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><time style=""animation-name:x"" onanimationstart=""alert(1)""></time>") (= x "<acronym oncut=""alert(1)"" contenteditable>test</acronym>") (= x "<div draggable=""true"" contenteditable>drag me</div><svg ondrop=alert(1) contenteditable>drop here</svg>")))
(assert (or (= z "e"" contenteditable>drag me</div><rp ondragover=alert(1) contenteditable>drop here</rp>") (= z "5sec.org/test.html!xss.html></iframe>") (= z "m>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "ronym onc" (str.substr y 3 9))) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{3}(0[1-9]|1[0-2]))|(\d{2}(0[1-9]|1[0-2]))$")))))
(assert (not (str.prefixof "<acronym " y)))
(assert (or (not (str.contains (str.replace y "l!" "") "t.htmxss.h")) (not (= (str.at z 1) ">"))))
(assert (or (str.contains y "test</a") (= (str.indexof x "ty" 0) 2) (= "m>" (str.substr z 0 6))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^.{4,}")) (not (str.contains (str.replace z "s." "x") "l!xsxhtml"))))
(check-sat)
