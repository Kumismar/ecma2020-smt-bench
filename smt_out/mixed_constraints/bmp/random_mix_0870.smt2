; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<map onmouseup=""alert(1)"">test</map>") (= x "<dialog onkeypress=""alert(1)"" contenteditable>test</dialog>") (= x "<marquee width=1 loop=1 onfinish=alert(1)>XSS</marquee>")))
(assert (or (= z "ion:color 10s"" ontransitioncancel=alert(1)></em>") (= z "le>:target {color: red;}</style><textarea id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></textarea>") (= z ")""></nextid>")))
(assert (= y (str.++ x z)))
(assert (or (= "g#a<b>" (str.replace z ")""/>" "<b>")) (str.prefixof "></" z) (not (str.suffixof "w>" z))))
(assert (= (str.len z) 43))
(assert (or (not (= ">/</st" (str.substr x 75 6))) (not (= (str.indexof x ")"">t" 0) 43))))
(assert (or (= "180deg);}" (str.substr z 0 9)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(\+[0-9]{2,}[0-9]{4,}[0-9]*)(x?[0-9]{1,})?$"))) (str.prefixof "<marquee w" x)))
(assert (not (str.prefixof "<map onmo" y)))
(check-sat)
