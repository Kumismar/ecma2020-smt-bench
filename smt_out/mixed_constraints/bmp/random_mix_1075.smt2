; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option onmouseup=""alert(1)"">test</option>") (= x "<rtc draggable=""true"" ondrag=""alert(1)"">test</rtc>") (= x "<picture onmouseover=""alert(1)"">test</picture>")))
(assert (or (= z "error=alert(1)>") (= z "rt(1)> -->")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "ert(1)>" z) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-zA-Z]{2,}$"))) (not (str.contains (str.replace y "gable" "<b>") " drag<b>=""tr"))))
(assert (or (str.contains y "ert") (str.contains y "ert(1)""")))
(assert (= "p://googl" (str.substr y 53 9)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9. ]{3,}$"))))
(assert (not (= (str.indexof x "v i" 0) 3)))
(assert (or (= (str.at y 30) "e") (not (str.suffixof "test</rtc>" x))))
(check-sat)
