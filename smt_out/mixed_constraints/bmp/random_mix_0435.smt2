; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details ontoggle=alert(1) open>test</details>") (= x "<caption onmouseup=""alert(1)"">test</caption>") (= x "<samp id=x tabindex=1 onactivate=alert(1)></samp>")))
(assert (or (= z "AN DATASRC=#I DATAFLD=C DATAFORMATAS=HTML&gt;&lt;/SPAN&gt;") (= z ")"">test</marquee>") (= z "tc>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "tc" 0) 0) (str.in_re z ((_ re.from_regex ecma2020) "^(?:0|\(?\+33\)?\s?|0033\s?)[1-9](?:[\.\-\s]?\d\d){4}$"))))
(assert (not (str.contains x "capt")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(^$)|(^.*(\S+).*$)"))) (not (str.contains (str.replace y "r" " ") "e t(")) (str.contains x "t(1)"">test")))
(assert (or (str.contains (str.replace z "o" " ") "e >") (not (str.prefixof "<" y))))
(assert (or (not (<= (str.len z) 58)) (<= (str.len z) 30) (str.prefixof "t" z)))
(check-sat)
