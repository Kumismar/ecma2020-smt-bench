; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menu onclick=""alert(1)"">test</menu>") (= x "<var onblur=alert(1) tabindex=1 id=x></var><input autofocus>")))
(assert (or (= z "ratechange=""alert(String.fromCharCode(88,83,83))"">") (= z "><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.]{1,50}$"))))
(assert (or (not (str.contains x "lick=""al")) (= "=" (str.substr x 29 1))))
(assert (str.suffixof "autofocus>" y))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^RB\d{3,7}|IA\d{3,7}$"))) (= (str.at z 15) "r") (not (= "<menu onclick=""alert(1)"">test</menu>><input aut""us>" (str.replace y "ofoc" """")))))
(assert (= "e>" (str.substr z 7 9)))
(assert (or (not (str.contains (str.replace x "t" "<b>") """aler<b>(1)""")) (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$"))) (= (str.indexof z ")" 0) 46)))
(assert (or (= "ratechange=""alert(String.from<b>Code(88,83,83))"">" (str.replace z "Char" "<b>")) (str.contains x "onblur=a")))
(assert (or (not (str.suffixof "83,83))"">" y)) (str.contains y "ur=")))
(check-sat)
