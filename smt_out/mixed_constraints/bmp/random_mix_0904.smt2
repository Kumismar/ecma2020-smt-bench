; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe id=x tabindex=1 onbeforeactivate=alert(1)></iframe>") (= x "<output draggable=""true"" ondragenter=""alert(1)"">test</output>") (= x "<var onkeyup=""alert(1)"" contenteditable>test</var>")))
(assert (or (= z "gover=alert(1) contenteditable>drop here</div>") (= z "0\u{10348}0003c;") (= z "autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[\d\.,]+$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9.]{0,12}$"))) (str.prefixof "<if" y)))
(assert (or (not (= (str.indexof x "ele" 0) 1)) (not (= (str.at x 18) "t"))))
(assert (not (str.contains (str.replace y "n" """") " tabi""dex")))
(assert (or (not (str.contains z "rt(1)"">t")) (not (<= (str.len y) 71)) (not (<= (str.len y) 74))))
(assert (or (<= (str.len y) 60) (= "<vjavascript: onkeyup=""alert(1)"" contenteditable>test</var>" (str.replace x "ar" "javascript:")) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-z]).{4,}")))))
(assert (not (str.contains z "t</base>")))
(check-sat)
