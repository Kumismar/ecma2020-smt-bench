; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dir onmousedown=""alert(1)"">test</dir>") (= x "<style>:target {color:red;}</style><bdo id=x style=""transition:color 1s"" ontransitionend=alert(1)></bdo>")))
(assert (or (= z ")"">test</multicol>") (= z "c")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "n=""a") (not (str.suffixof "ulticol>" z))))
(assert (or (not (str.contains y "olor:red")) (not (>= (str.len y) 73)) (not (= (str.at z 8) "/"))))
(assert (or (not (str.prefixof "<dir " y)) (= (str.at z 10) ">")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-\.\+]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,7}|[0-9]{1,3})(\]?)$")) (not (= (str.indexof z """>te" 0) 1)) (= (str.at x 12) "t")))
(assert (str.prefixof "<dir onmo" y))
(check-sat)
