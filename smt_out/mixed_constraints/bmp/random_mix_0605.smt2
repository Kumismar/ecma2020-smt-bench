; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<INPUT TYPE=""BUTTON"" action=""alert('XSS')""/>") (= x "<style>:target {color:red;}</style><picture id=x style=""transition:color 1s"" ontransitionend=alert(1)></picture>") (= x "<style>@keyframes x{}</style><keygen style=""animation-name:x"" onanimationstart=""alert(1)""></keygen>")))
(assert (or (= z ">@keyframes x{}</style><legend style=""animation-name:x"" onanimationstart=""alert(1)""></legend>") (= z ")"">test</progress>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x "ion=")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[+]{0,1}(\d){1,3}[ ]?([-]?((\d)|[ ]){1,12})+$"))) (str.in_re z ((_ re.from_regex ecma2020) "^(\+420|\+421|00420|00421)?[ ]*[0-9]{3}[ ]*[0-9]{3}[ ]*[0-9]{3}$")) (= (str.at x 83) "s")))
(assert (str.suffixof "</legend>" y))
(assert (not (= (str.len z) 93)))
(assert (or (not (str.contains z "t</prog")) (str.in_re z ((_ re.from_regex ecma2020) "^\s*\(?(020[0-9]{1}\)?[ ]?[1-9]{1}[0-9{2}[ ]?[0-9]{4})|(0[1-8]{1}[0-9]{3}\)?[ ]?[1-9]{1}[0-9]{2}[ ]?[0-9]{3})\s*$")) (= (str.indexof x " id=x" 0) 43)))
(assert (not (= (str.at z 91) "d")))
(check-sat)
