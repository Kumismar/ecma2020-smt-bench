; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;IMG SRC=javascript:alert(&;quot;XSS&;quot;)>;") (= x "<style>:target {transform: rotate(180deg);}</style><tr id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tr>") (= x "<label id=x tabindex=1 onfocus=alert(1)></label>")))
(assert (or (= z ">test</s>") (= z "&NewLine;base64&NewLine;,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==""&#09;&#10;&#11;>X</a")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 20) "=") (not (= (str.indexof z "wLin" 0) 3)) (not (str.in_re z ((_ re.from_regex ecma2020) ".{6,50}$")))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[^0-9]+$")))
(assert (= (str.indexof x "vas" 0) 12))
(assert (or (str.suffixof "</tr>" x) (not (str.suffixof "11;>X</a" z)) (not (= (str.at z 7) "s"))))
(assert (not (= (str.indexof z "lwdD5" 0) 31)))
(check-sat)
