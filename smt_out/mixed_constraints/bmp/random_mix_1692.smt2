; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<command onbeforepaste=""alert(1)"" contenteditable>test</command>") (= x "<style>@keyframes x{}</style><strike style=""animation-name:x"" onanimationend=""alert(1)""></strike>")))
(assert (or (= z "transition:color 10s"" ontransitioncancel=alert(1)></bdo>") (= z "test</tr>")))
(assert (= y (str.++ x z)))
(assert (or (= "<style>@keyframes x{}</style><strike style=""animation-name:x"" onanimationend=""alertalert(1)""></strike>transition:color 10s"" ontransitioncancel=alert(1)></bdo>" (str.replace y "(1)" "alert(1)")) (= "ransi" (str.substr y 89 5)) (not (str.suffixof "/bdo>" z))))
(assert (or (= "ke>" (str.substr x 94 5)) (str.contains z "test</t") (not (str.in_re z ((_ re.from_regex ecma2020) "[\d\-( )]+$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9])(?=.*?[#?!@$%^&*-]).{8,}$"))))
(assert (= "est</" (str.substr z 1 5)))
(check-sat)
