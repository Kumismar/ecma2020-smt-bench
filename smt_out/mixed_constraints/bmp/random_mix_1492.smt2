; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<spacer draggable=""true"" ondragstart=""alert(1)"">test</spacer>") (= x "<meter onpaste=""alert(1)"" contenteditable>test</meter>") (= x "<style>@keyframes x{}</style><rtc style=""animation-name:x"" onanimationend=""alert(1)""></rtc>")))
(assert (or (= z ")"" contenteditable>test</b>") (= z "=alert(1) tabindex=1 id=x></abbr><input autofocus>") (= z """alert(1)"">test</wbr>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "=""t" 0) 17)))
(assert (not (= "er>" (str.substr x 51 8))))
(assert (or (not (str.suffixof ">" x)) (not (= "<meter onpaste=""alert(1)"" contentedijavascript:le>test</meter>=alert(1) tabindex=1 id=x></abbr><input autofocus>" (str.replace y "tab" "javascript:"))) (str.contains (str.replace y "pac" "x") "<sxer")))
(assert (or (not (= "</s" (str.substr z 1 3))) (not (str.contains y "x></abb")) (not (str.in_re z ((_ re.from_regex ecma2020) "[7|6|2][0-9]{7}")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^.{0,31}$"))))
(check-sat)
