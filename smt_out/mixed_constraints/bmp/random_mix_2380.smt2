; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onMouseEnter html onMouseEnter=""javascript:parent.javascript:alert(1)""></html onMouseEnter>") (= x "<image id=x tabindex=1 onbeforeactivate=alert(1)></image>") (= x "<nobr id=x tabindex=1 onbeforeactivate=alert(1)></nobr>")))
(assert (or (= z "eyframes x{}</style><select style=""animation-name:x"" onanimationstart=""alert(1)""></select>") (= z "=alert(1) autofocus></textarea>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 14) "m")))
(assert (str.contains z " autofoc"))
(assert (or (not (= (str.at x 0) "<")) (not (str.contains z "imati")) (str.contains z "</text")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{8,9}$")) (not (str.contains (str.replace y "r h" """") "e""t"))))
(assert (or (= ")></nobr" (str.substr x 46 8)) (not (str.prefixof "<nobr id=x" x))))
(assert (or (str.prefixof "<html " x) (not (= (str.at x 43) "r"))))
(assert (or (not (<= (str.len x) 45)) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9a-zA-Z]{5,6}")))))
(assert (not (<= (str.len x) 59)))
(assert (not (= "<image id=x tabindex=1 onbeforeactivate=javascript:t(1)></image>" (str.replace x "aler" "javascript:"))))
(check-sat)
