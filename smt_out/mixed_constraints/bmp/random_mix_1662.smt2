; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><dfn id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></dfn>") (= x "<applet id=x tabindex=1 onbeforeactivate=alert(1)></applet>") (= x "<video onmouseleave=""alert(1)"">test</video>")))
(assert (or (= z "alert(1)"" contenteditable>test</figcaption>") (= z "zelement1"">test</a>") (= z "03C;")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "03" z) (not (= "alert(1)"" contenteditablt</figcaption>" (str.replace z "e>tes" ""))) (not (= "ent." (str.substr y 54 4)))))
(assert (not (= (str.at x 4) "p")))
(assert (or (= (str.indexof z "z" 0) 0) (not (= (str.at x 75) "o"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+$")) (str.in_re x ((_ re.from_regex ecma2020) "^[?!,.\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}0-9\s]+$"))))
(assert (= (str.len x) 59))
(check-sat)
