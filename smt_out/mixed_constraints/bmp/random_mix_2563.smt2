; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<!--<img src=""--><img src=x onerror=alert(XSS)//"">") (= x "<kbd onfocusout=alert(1) tabindex=1 id=x></kbd><input autofocus>") (= x "<math><a xlink:href=""//jsfiddle\u{1f600}.net/t846h/"">click")))
(assert (or (= z "03C;") (= z ")"">test</mark>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "le>test<") (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]+$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[1][3,4,5,6,7,8,9][0-9]{9}$")))))
(assert (or (not (str.contains (str.replace y "k:h" "") " xlinref=""")) (str.prefixof "<" x) (not (str.suffixof "us>03C;" y))))
(assert (or (= (str.at z 9) "m") (= (str.indexof z "d>" 0) 6) (not (= (str.len y) 50))))
(assert (or (str.suffixof "rk>" z) (not (= (str.len x) 50)) (not (str.in_re y ((_ re.from_regex ecma2020) "0[1-9][0-9]{3}|[1-4][0-9]{4}|5[0-2][0-9]{3}")))))
(check-sat)
