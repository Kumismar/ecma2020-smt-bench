; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><noframes style=""animation-name:x"" onanimationstart=""alert(1)""></noframes>") (= x "<dfn id=x tabindex=1 onfocus=alert(1)></dfn>")))
(assert (or (= z "s=""alert(1)"" contenteditable>test</output>") (= z "me2')"" end=""0"" onEnd=""javascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<style>@keyframes x{}</style><noframes style=""animation-name:x"" onanimationstart=""alert(1)""></noframes>s=""alert(1)""ntenteditable>test</output>" (str.replace y " co" ""))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._+-]+\x40[a-zA-Z0-9.-]+\.[a-zA-Z]{2,4}$")))))
(assert (or (not (str.suffixof "ames>" x)) (= (str.indexof z "d=" 0) 9) (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9._-]+@[A-Za-z0-9-]+\.[a-z]{2,5}$"))))
(assert (or (not (str.contains (str.replace y "s=""a" """") "fn>""lert")) (not (str.prefixof "me2')"" e" z))))
(assert (or (not (str.prefixof "<styl" y)) (not (str.prefixof "<" y)) (str.suffixof "utput>" y)))
(assert (or (str.contains (str.replace x "i" " ") """an mati") (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&'* /=?^_`{|}~-] @[a-zA-Z0-9-] (?:\.[a-zA-Z0-9-] )*$"))))
(assert (<= (str.len x) 107))
(assert (or (not (>= (str.len y) 136)) (= (str.indexof x "nani" 0) 65)))
(check-sat)
