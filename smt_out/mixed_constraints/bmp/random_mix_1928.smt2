; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blink onmousedown=""alert(1)"">test</blink>") (= x "<font onkeypress=""alert(1)"" contenteditable>test</font>") (= x "<div draggable=""true"" contenteditable>drag me</div><del ondrop=alert(1) contenteditable>drop here</del>")))
(assert (or (= z "><source src=""validaudio.wav"" type=""audio/wav""></audio>") (= z "onmousemove=""alert(1)"">test</li>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace x "edita" "") "entbl")))
(assert (or (not (str.suffixof "t</dialog>" y)) (str.contains (str.replace x "ed" "") "sown=""") (= "ov" (str.substr z 8 2))))
(assert (or (not (str.prefixof "<f" y)) (= "e=""aler" (str.substr z 10 7))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[\u{3041}-\u{3093}\u{30a1}-\u{30f6}\u{30fc}\s\u{5c}u3000]+$")) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9_-]+(.[a-zA-Z0-9_-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*(.[a-z]{2,})$"))) (= "<div draggable=""true"" contenteditable>drag me</div><del xop=alert(1) contenteditable>drop here</del>onmousemove=""alert(1)"">test</li>" (str.replace y "ondr" "x"))))
(assert (or (= (str.at z 37) "u") (<= (str.len x) 62) (not (str.suffixof "ange>" z))))
(check-sat)
