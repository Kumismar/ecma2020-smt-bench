; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<small draggable=""true"" ondragend=""alert(1)"">test</small>") (= x "<strong draggable=""true"" ondrag=""alert(1)"">test</s\u{1d400}trong>")))
(assert (or (= z "br onmouseover=""alert(1)"">test</br>") (= z "st</time>") (= z "/bdo>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "bli" "alert(1)") "<alert(1)nk") (= "<small draggable=""true"" ondragend=""alert(1)""""est</small>br onmouseover=""alert(1)"">test</br>" (str.replace y ">t" """")) (not (= "<b>>" (str.replace z "/bdo" "<b>")))))
(assert (not (= "<stro" (str.substr x 0 5))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[+\d](?:.*\d)?$")) (not (= (str.at y 50) "\u{1d400}"))))
(assert (or (not (str.contains y """ ondrag=""")) (not (str.contains z "o>"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{2}$"))))
(check-sat)
