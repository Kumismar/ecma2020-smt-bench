; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;META HTTP-EQUIV=\""Set-Cookie\"" Content=\""USERID=&lt;SC\u{10348}RIPT&gt;alert('XSS')\u{1f600}&lt;/SCRIPT&gt;\""&gt;") (= x "--><!--*{color:red}   /* all UA */") (= x "<data\u{1f4a9}list draggable=""true"" ondragstart=""\u{1f4a9}alert(1)"">test</datalist>")))
(assert (or (= z "te=alert(1)></picture><inpu\u{10348}t autofocus>") (= z "alert(1)"" contenteditable>test</xmp>") (= z "draggable=""true"" ondrag=""alert(1)"">test</keygen>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "e=a" "") "tler")) (= "--><!--*{color:red}  alert(1) all UA */" (str.replace x " /*" "alert(1)"))))
(assert (or (= "npu\u{10348}t auto" (str.substr z 24 10)) (not (= (str.at z 11) "t"))))
(assert (or (= "keygen" (str.substr z 41 6)) (= (str.indexof z "t</p" 0) 6)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-9a-zA-Z]([-.\w]*[0-9a-zA-Z])*@([0-9a-zA-Z][-\w]*[0-9a-zA-Z]\.)+[a-zA-Z]{2,4})$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "[\w]{8,16}")))))
(check-sat)
