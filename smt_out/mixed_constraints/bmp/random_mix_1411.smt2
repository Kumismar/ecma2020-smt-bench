; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt draggable=""true"" ondragenter=""alert(1)"">test</dt>") (= x "<big onmousedown=""alert(1)"">test</big>")))
(assert (or (= z "teditable>drag me</div>\u{10348}<keygen ondrop=alert(1) conten\u{10348}teditable>drop here</keygen>") (= z "n=alert(1)></bgsound>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-\u{139}\u{13e}0-9-\u{e2}\u{20ac}\u{17e}\u{e2}\u{20ac}\u{15b},#+!&.?\u{e2}\u{20ac}\u{2122}\u{e2}\u{20ac}\u{98}()' ]{10,}$"))) (= (str.at z 70) "h") (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z\u{5c}u0590-\u{5c}u05FF\s]+$")))))
(assert (not (= "own=" (str.substr y 13 4))))
(assert (not (<= (str.len x) 106)))
(assert (or (not (str.prefixof "n=alert(" z)) (not (= "lert(1) c" (str.substr z 40 9))) (not (= "ondrop" (str.substr z 32 6)))))
(assert (or (not (str.contains x "est")) (not (str.in_re y ((_ re.from_regex ecma2020) "^([- \w\d\u{5c}u00c0-\u{5c}u024f]+)$")))))
(check-sat)
