; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=""javascript:alert('XSS');"">") (= x "<!ATTLIST xsl:stylesheet id    ID    #REQUIRED>]>") (= x "<multicol draggable=""true"" ondragend=""alert(1)"">test</multicol>")))
(assert (or (= z "le=""true"" ondragenter=""alert(1)"">test</address>") (= z ";"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "ert")) (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z\u{e0}-\u{fa}\u{c0}-\u{da}]+\s*)+$"))))
(assert (or (not (= (str.at x 42) "e")) (= (str.at z 10) "o") (not (= (str.indexof y "</sp" 0) 47))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[1-9]{1}$")))
(assert (str.suffixof "s>" z))
(assert (not (= (str.indexof x "    " 0) 27)))
(assert (not (str.suffixof "address>" y)))
(check-sat)
