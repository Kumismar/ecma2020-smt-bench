; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea id=x tabindex=1 ondeactivate=alert(1)></textarea><input id=y autofocus>") (= x "<data id=x tabindex=1 onactivate=alert(1)></data>") (= x "<style>:target {color: red;}</style><command id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></command>")))
(assert (or (= z "t"";") (= z "pt:alert(1)"">DEF")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "ata>t"";" y)) (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{1}[0-9]{9}"))))
(assert (or (str.suffixof "t(1)"">DEF" y) (= (str.at x 71) "o")))
(assert (or (not (str.contains z "rt(1)")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[+]*[0-9]{1,4}[0-9]{11}$")))))
(assert (or (not (= "<style>:target {color: red;}</style><command id=x style=""tralert(1)tion:color 10s"" ontransitioncancel=alert(1)></command>pt:alert(1)"">DEF" (str.replace y "ansi" "alert(1)"))) (not (str.contains (str.replace y "</" "") "testnob"))))
(assert (or (not (= (str.at x 79) "s")) (not (str.prefixof "t"";" z))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^([_A-z0-9 ]){5,}$"))))
(check-sat)
