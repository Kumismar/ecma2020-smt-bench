; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pr\u{1d400}ogress oncopy=""alert(1)"" contenteditable>test</progress>") (= x "<caption onbeforecut=""alert(1)"" contenteditable>test</caption>")))
(assert (or (= z " autofocus>") (= z "t(1) contenteditable>drop here</option>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9 ]{1,30}$"))))
(assert (or (= (str.at x 41) "b") (not (= "lert(1)"" " (str.substr x 23 9)))))
(assert (not (str.suffixof "on>" y)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\d*(\.\d{0,7})?$"))) (not (= "ut=""aler" (str.substr x 18 8)))))
(assert (not (str.prefixof "x\u{201d}</title" x)))
(assert (or (not (= (str.len x) 60)) (>= (str.len x) 56) (str.suffixof "ion>" x)))
(check-sat)
