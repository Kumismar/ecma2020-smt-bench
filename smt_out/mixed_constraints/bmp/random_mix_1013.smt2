; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr draggable=""true"" ondragenter=""alert(1)"">test</abbr>") (= x "<marquee draggable=""true"" ondragstart=""alert(1)"">test</marquee>")))
(assert (or (= z "ue"" contenteditable>drag me</div><marquee ondragover=alert(1) contenteditable>drop here</marquee>") (= z "TENT="";0;url=javascript:alert(';XSS';);"";>;") (= z "lor 10s"" ontransitioncancel=alert(1)></button>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z """" "javascript:") "sjavascript: ont") (>= (str.len y) 106)))
(assert (or (= (str.indexof x " on" 0) 22) (not (= (str.indexof x "ag" 0) 8))))
(assert (= (str.at x 21) "r"))
(assert (or (not (str.contains (str.replace y "ler" "<b>") "a<b>t")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{454}\u{404}\u{457}\u{407}\u{406}\u{456}Ii\u{490}\u{491}\u{2018}'\u{2019}?`\s]+$")))))
(assert (or (not (str.suffixof "quee>" z)) (str.contains z "drag me</") (not (str.in_re x ((_ re.from_regex ecma2020) "^[\s]*[\s\S]*[\S]+[\s\S]*[\s]*$")))))
(assert (not (= (str.len x) 60)))
(check-sat)
