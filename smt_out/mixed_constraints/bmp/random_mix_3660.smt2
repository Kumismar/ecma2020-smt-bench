; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<code onmouseout=""alert(1)"">test</code>") (= x "<element onbeforecopy=""alert(1)"" contenteditable>test</element>")))
(assert (or (= z "(1)"">DEF") (= z " ondragover=alert(1) contenteditable>drop here</output>") (= z "></table>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 24) "t")) (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{4}\d{3}\d{4}$"))) (= (str.len x) 39)))
(assert (str.contains (str.replace z "</tab" """") ">""l"))
(assert (or (>= (str.len x) 56) (not (str.contains (str.replace z """" "javascript:") "seup=javascript:aler")) (str.contains x "de onmou")))
(assert (not (= (str.indexof y "alert" 0) 18)))
(check-sat)
