; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hgroup id=x tabindex=1 ondeactivate=alert(1)></hgroup><input id=y autofocus>") (= x "<canvas onmousemove=""alert(1)"">test</canvas>") (= x "<SCRIPT>String.fromCharCode(97, 108, 101, 114, 116, 40, 49, 41)</SCRIPT>")))
(assert (or (= z "=x tabindex=1 onbeforeactivate=alert(1)></button>") (= z "dblclick=""alert(1)"">test</head>") (= z "1)></head>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "db" z) (not (= (str.at y 75) "c")) (not (str.suffixof "t</object>" x))))
(assert (or (not (= "6, 40" (str.substr x 49 5))) (str.contains x "id=x t") (not (= (str.indexof y "ca" 0) 1))))
(assert (or (not (str.contains (str.replace y "l" "x") "axert")) (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,40}$"))))
(assert (or (str.contains (str.replace x "ndea" "") " octiv") (str.suffixof "vas>" x)))
(assert (or (= "/butto" (str.substr y 113 6)) (not (str.contains x "rCode"))))
(check-sat)
