; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onbeforecut=""alert(1)"" contenteditable>test</su\u{1f4a9}p>") (= x "<big draggable=""true"" ondragenter=""alert(1)"">test</big>") (= x "<svg onUnload svg onUnload=""javascript:javascript:alert(1)""></svg onUnload>")))
(assert (or (= z "samp>") (= z "genter=""alert(1)"">test</center>") (= z "l><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= """javascr" (str.substr x 27 8)) (not (str.contains (str.replace y "es" "<b>") ">t<b>t</bi")) (str.in_re x ((_ re.from_regex ecma2020) "^(https?:\/\/)?[\-A-Za-z0-9\.]*\.[A-Za-z]*[\-A-Za-z0-9+&@#\/%?=~_|!:,.;]*$"))))
(assert (str.contains (str.replace x "tes" "alert(1)") """>alert(1)t</bd"))
(assert (or (str.suffixof "d>" x) (= "<sup onbeforecut=""alert(1)"" contenteditable>test</su\u{1f4a9}p>genter=""alert(alert(1)test</center>" (str.replace y "1)"">" "alert(1)"))))
(assert (not (= (str.indexof y " on" 0) 4)))
(assert (or (<= (str.len y) 191) (= (str.indexof x " d" 0) 4)))
(assert (or (not (<= (str.len y) 66)) (not (str.prefixof "s" z))))
(assert (not (str.contains y "</shadow")))
(assert (not (str.prefixof "<svg o" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z,',\u{e0},\u{e8},\u{e9},\u{ec},\u{f2},\u{f9},\s]{2,30}"))) (not (= (str.indexof y "rt" 0) 38))))
(check-sat)
