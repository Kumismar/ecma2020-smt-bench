; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;BODY ONLOAD=alert('XSS')&gt;") (= x "<center onmouseover=""alert(1)"">test</center>")))
(assert (or (= z "ag me</div><frame ondragover=alert(1) contenteditable>drop here</frame>") (= z """ ondragleave=""alert(1)"">test</em>") (= z "deactivate=alert(1)></ol>\u{1f4a9}<input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (= "<center onmouseover=""alert(1)"">t<b>center>" (str.replace x "est</" "<b>"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[\w-]+$"))) (= (str.indexof y "t" 0) 2) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z][A-Za-z0-9]*$")))))
(assert (or (not (str.contains y "s x{}</st")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0]{1}[1-9]{1}[0-9]{7,10}"))) (str.prefixof "deact" z)))
(assert (= "<" (str.substr x 0 1)))
(check-sat)
