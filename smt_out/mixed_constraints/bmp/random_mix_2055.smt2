; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot onmouseleave=""alert(1)"">test</tfoot>") (= x "<ol onbeforecut=""alert(1)"" contenteditable>test</ol>")))
(assert (or (= z "ram draggable=""true"" ondragend=""alert(1)"">test</param>") (= z "<rb style=""animation-name:x"" onanimationstart=""alert(1)""></rb>") (= z "ticol>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "t<")))
(assert (not (str.suffixof ">" z)))
(assert (= "aram>" (str.substr z 49 8)))
(assert (or (= (str.len y) 106) (>= (str.len z) 1) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-zA-Z0-9]{2,}.[a-zA-Z0-9]{2,}$")))))
(assert (>= (str.len x) 50))
(assert (or (= "(1)"">test" (str.substr y 48 9)) (not (= (str.indexof y "(1)""" 0) 26))))
(assert (not (str.prefixof "ti" z)))
(check-sat)
