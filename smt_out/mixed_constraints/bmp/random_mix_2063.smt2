(assert (or (not (= (str.indexof y "46" 0) 36)) (not (= (str.at z 23) "e"))))
(assert (= "pt:al" (str.substr z 26 5)))
(assert (or (not (= "ect>" (str.substr z 34 5))) (not (str.suffixof "gt;" x))))
