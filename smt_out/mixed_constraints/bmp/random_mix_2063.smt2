(assert (or (= x "&lt;SCRIPT/XSS SRC=\""http&#58;//ha&#46;ckers&#46;org/xss&#46;js\""&gt;&lt;/SCRIPT&gt;") (= x "<nobr onmouseover=""alert(1)"">test</nobr>") (= x "<x onclick=alert(1)>click this!")))
(assert (or (= z "lert(1)"" contenteditable>test</select>") (= z "=""alert(1)"">test</rp>")))
