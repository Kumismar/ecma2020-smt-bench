; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp oncontextmenu=""alert(1)"">test</samp>") (= x "<bdi onmouseover=""a\u{1f600}lert(\u{1d400}1)"">test</bdi>") (= x "<dfn onmouseenter=""alert(1)"">test</dfn>")))
(assert (or (= z "itionend=alert(1)></track>") (= z "ame>")))
(assert (= y (str.++ x z)))
(assert (str.contains y "u=""aler"))
(assert (not (str.prefixof "<" y)))
(assert (str.contains x "ver=""a\u{1f600}le"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^RB\d{3,7}|IA\d{3,7}$"))) (not (= (str.at z 21) "r"))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[02-9][0-9]{9}$")))
(assert (or (str.contains (str.replace x "al" """") "u=""""ert(1") (not (= "1)"">te" (str.substr x 27 6)))))
(check-sat)
