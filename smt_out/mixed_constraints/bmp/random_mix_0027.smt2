; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\xE2\x80\x8Ajavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<script onpaste=""alert(1)"" contenteditable>test</script>") (= x "<style>:target {color: red;}</style><col id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></col>")))
(assert (or (= z "enteditable>test</listing>") (= z "&lt;/SCRIPT&gt;") (= z "opy=""alert(1)"" contenteditable>test</meter>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y "ip" "x") "<scrxt onp") (= (str.at x 42) "d") (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{3}$"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) ".{1,80}")) (str.suffixof "ocus>" z)))
(assert (or (str.contains x "ditable>t") (not (str.in_re z ((_ re.from_regex ecma2020) "\d{0,15}")))))
(assert (not (str.suffixof "ting>" z)))
(check-sat)
