; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#13;<blink/&#13; onmouseover=pr&#x6F;mp&#116;(1)>OnMouseOver {Firefox & Opera}") (= x "<div draggable=""true"" contenteditable>drag me</div><output ondragover=alert(1) contenteditable>drop here</output>") (= x "<style oncut=""alert(1)"" contenteditable>test</style>")))
(assert (or (= z "nk>") (= z "</form>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "st</" 0) 36) (not (= (str.at z 19) "t"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([A-z\u{119}\u{f3}\u{105}\u{15b}\u{142}\u{17c}\u{17a}\u{107}\u{144}\u{118}\u{d3}\u{104}\u{15a}\u{141}\u{17b}\u{179}\u{106}\u{143} /]){2,}$"))) (= (str.at z 1) "/") (= "nk>" (str.substr z 0 3))))
(assert (str.contains z "rm>"))
(assert (or (not (= "<sty oncut=""alert(1)"" contenteditable>test</style>nk>" (str.replace y "le" ""))) (str.contains y "am")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(\(?\+?[0-9]*\)?)?[0-9_\- \(\)]*$"))))
(assert (or (not (= (str.indexof z "for" 0) 2)) (str.contains (str.replace y "e" "") "tyl oncu")))
(assert (= "&#13;<blink/&#13; onmoualert(1)over=pr&#x6F;mp&#116;(1)>OnMouseOver {Firefox & Opera}" (str.replace x "se" "alert(1)")))
(assert (or (not (str.suffixof "nk>" y)) (= (str.at x 65) "r") (str.contains z "nk>")))
(check-sat)
