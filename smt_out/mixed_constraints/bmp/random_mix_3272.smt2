; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><isindex id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></isindex>") (= x "<img src\x12=x onerror=""javascript:alert(1)"">") (= x "<button oncut=""alert(1)"" contenteditable>test</button>")))
(assert (or (= z "t</a>") (= z "teditable>test</footer>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "a" 0) 15)) (str.in_re z ((_ re.from_regex ecma2020) "alpha_numeric_space"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9!-/:-@\u{2260}\[-`{-~]+$"))))
(assert (or (not (= (str.at z 3) "t")) (= (str.at x 57) "t")))
(assert (or (not (str.contains z "/a>")) (not (= "forep" (str.substr x 11 5))) (str.suffixof "er>" y)))
(assert (or (= (str.at y 177) "l") (= "<b>on oncut=""alert(1)"" contenteditable>test</button>" (str.replace x "<butt" "<b>")) (not (= (str.len x) 117))))
(assert (or (= (str.len z) 5) (not (str.suffixof "n>t</a>" y))))
(check-sat)
