; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<DIV STYLE=""background-image: url(javascript:alert('XSS'))"">") (= x "<isindex formaction=javascript:alert(1) type=submit value=click>")))
(assert (or (= z "recopy=""alert(1)"" contenteditable>test</nextid>") (= z "XSS\"")>\"";' > out") (= z ")></ruby>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<DIV STYLE=""background-image: url(<b>avascript:alert('XSS'))"">XSS\"")>\"";' > out" (str.replace y "j" "<b>"))) (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*[.]([a-z]{2,3})$")))))
(assert (or (not (= (str.indexof x "gro" 0) 16)) (str.contains y "S'))")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([0-9]){10,}$"))))
(assert (or (str.contains z ")></r") (= (str.at z 10) "'") (>= (str.len x) 57)))
(assert (not (str.suffixof "ue=click>" x)))
(assert (= "STYLE=""b" (str.substr y 5 8)))
(assert (>= (str.len z) 33))
(check-sat)
