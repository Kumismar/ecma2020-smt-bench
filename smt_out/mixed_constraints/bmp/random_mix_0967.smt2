; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area onfocusout=alert(1) tabindex=1 id=x></area><input autofocus>") (= x "<XML ID=I><X><C><![CDATA[<IMG SRC=""javas]]<![CDATA[cript:javascript:alert(1);"">]]</C><X></xml>")))
(assert (or (= z "ndragstart=""alert(1)"">test</rt>") (= z "cus>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]{2,}\.[a-z]{2,}$")) (not (>= (str.len y) 92)) (not (str.prefixof "<a" x))))
(assert (= ">test</r" (str.substr z 21 8)))
(assert (or (not (str.contains x "a o")) (not (= "ndra" (str.substr z 0 4))) (= (str.indexof x "><![C" 0) 15)))
(assert (= " onmouseleajavascript:lert(1)"">test</content>" (str.replace z "ve=""a" "javascript:")))
(check-sat)
