; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><marquee onload=alert(1)></marquee>") (= x "<footer id=x tabindex=1 ondeactivate=alert(1)></footer><input id=y autofocus>")))
(assert (or (= z "ouseenter=""alert(1)"">test</h1>") (= z "lert(1) tabindex=1 id=x></table><input autofocus>") (= z "oSuchMethod__ = Function,[{}][0].constructor._('alert(1)')()</script>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 67) (not (>= (str.len x) 73))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9-_\.]{6,20}$"))) (str.contains x "r id=x t")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[\u{5c}u4e00-\u{5c}u9fa5]{2,6}$")) (not (str.suffixof "cus>" x))))
(assert (or (not (= (str.len y) 80)) (str.suffixof "h1>" z) (not (str.suffixof "by>" x))))
(assert (str.contains (str.replace x "a" "x") "mxrque"))
(check-sat)
