; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element onkeyup=""alert(1)"" contenteditable>test</element>") (= x "<article onkeypress=""alert\u{1f4a9}(1)"" contenteditable>test</ar\u{20000}ticle>") (= x "<button autofocus onfocusin=alert(1)>test</button>")))
(assert (or (= z ">test</i>") (= z "rt(1)"">test</template>") (= z "nmouseenter=""alert(1)"">test</ul>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "</noembex" (str.replace z "d>" "x"))) (not (= "tton>" (str.substr x 45 5))) (= "<article onkeypre=""alert\u{1f4a9}(1)"" contenteditable>test</ar\u{20000}ticle>" (str.replace x "ss" ""))))
(assert (str.suffixof "est</i>" z))
(assert (str.prefixof "<" x))
(assert (= (str.len x) 50))
(assert (= (str.len z) 32))
(assert (or (not (= (str.indexof z "t</i" 0) 4)) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9 +]+"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[+\-()\s0-9]{7,}$")))))
(assert (= (str.indexof x "(1)>" 0) 33))
(assert (= (str.indexof y "onp" 0) 7))
(check-sat)
