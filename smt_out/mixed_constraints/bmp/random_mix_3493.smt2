; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><nav id=x style=""transition:color 1s"" ontransitionend=alert(1)></nav>") (= x "<option draggable=""true"" ondragleave=""alert(1)"">test</option>") (= x "<frameset onpaste=""alert(1)"" contenteditable>test</frameset>")))
(assert (or (= z "(1)&lt;/script&gt;") (= z "(1)"">test</cite>")))
(assert (= y (str.++ x z)))
(assert (= (str.len x) 60))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9, +]*"))) (not (str.in_re x ((_ re.from_regex ecma2020) "[+]?\d+"))) (str.contains y "ameset onp")))
(assert (or (= "<frameset onpaste=""alert(1)"" contenteditable>test</framese&lt;/script&gt;" (str.replace y "t>(1)" "")) (str.prefixof "<style" x) (str.contains y ">(1")))
(assert (or (not (str.suffixof "/frameset>" x)) (str.prefixof "<style>" x) (str.in_re x ((_ re.from_regex ecma2020) "^(([V]|[v]|\s){1})([0-9]{12})"))))
(assert (or (not (<= (str.len y) 124)) (= "<option draggable=""xe"" ondragleave=""alert(1)"">test</option>" (str.replace x "tru" "x"))))
(assert (or (str.suffixof "cite>" y) (= "(1)" (str.substr z 0 3))))
(assert (not (str.contains x "=""alert(1)")))
(check-sat)
