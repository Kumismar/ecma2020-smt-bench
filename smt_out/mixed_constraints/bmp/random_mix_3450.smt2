; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input type=image src=1 onerror=alert(1)>") (= x "<applet id=x tabindex=1 onactivate=alert(1)></applet>") (= x "<style>@keyframes x{}</style><menu style=""animation-name:x"" onanimationstart=""alert(1)""></menu>")))
(assert (or (= z """alert(1)"">test</section>") (= z "on(javascript:alert(1))"">") (= z """javascript:javascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "t" z) (= "<mark draggable=""true"" ondragenter=""alert(1)"">test</mar id=x tabindex=1 onfocusin=alert(1)></body>" (str.replace y "k>" " "))))
(assert (or (= "pt><input " (str.substr y 62 10)) (<= (str.len y) 76) (not (str.contains (str.replace x "fored" "x") " onbexea"))))
(assert (or (not (str.suffixof "s></mark>" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@+[A-Za-z0-9.-]+\.[A-Za-z]{2,}"))) (str.contains (str.replace x "ation" "x") "mx-")))
(assert (or (= "it" (str.substr z 2 2)) (not (= "t(1))" (str.substr y 59 5)))))
(assert (not (str.contains y "alert(")))
(check-sat)
