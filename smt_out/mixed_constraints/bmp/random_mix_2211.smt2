; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x onxxx=alert(1) 1='") (= x "<track onkeyup=""alert(1)"" contenteditable>test</track>") (= x "<menuitem ondblclick=""alert(1)"">test</menuitem>")))
(assert (or (= z "(1)"" contenteditable>test</img>") (= z ")\u{20000}"">test</td>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "dblclic" (str.substr y 12 7))) (not (str.suffixof "td>" y)) (str.contains (str.replace y "\u{10348}r>" "") "\u{1f600}<b')"">")))
(assert (= "(1)"" contenteditable>test >" (str.replace z "</img" " ")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(\d{3})$"))) (str.suffixof "st</td>" y) (not (= (str.at y 50) """"))))
(assert (not (str.suffixof "</td>" z)))
(assert (or (= "t" (str.substr y 89 1)) (= (str.at x 53) ">") (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]+[a-zA-Z -]*")))))
(assert (or (= (str.at y 49) """") (str.prefixof "<menuitem" y)))
(check-sat)
