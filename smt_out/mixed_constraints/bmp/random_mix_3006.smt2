; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset id=x tabindex=1\u{1f4a9} on\u{1f600}focusin=alert(1)></frameset>") (= x "<code draggable=""true"" ondragend=""alert(1)"">test</code>")))
(assert (or (= z "ditable>test</var>") (= z ")"">test</output>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 5) " ")) (not (= "dex=1\u{1f4a9} " (str.substr x 20 7)))))
(assert (or (not (str.prefixof "pt:al" z)) (str.contains (str.replace y "e" " ") "cod  d")))
(assert (or (= (str.at z 13) "u") (not (= (str.len y) 73)) (str.contains y "e"" ondr")))
(assert (or (not (= (str.at z 6) "e")) (not (>= (str.len z) 16))))
(assert (str.in_re y ((_ re.from_regex ecma2020) ".*[!#-9A-~]+@+[a-z0-9]+.+[^.]$.*")))
(assert (or (= "st</" (str.substr z 10 4)) (not (str.prefixof "<frameset" y))))
(assert (or (= "d le>test</var>" (str.replace z "itab" " ")) (not (= "01\u{2193}, O" (str.substr y 95 6)))))
(check-sat)
