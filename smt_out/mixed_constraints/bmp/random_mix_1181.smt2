; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div ondblclick=""alert(1)"">test</div>") (= x "<svg id=x tabindex=1 onactivate=alert(1)></svg>")))
(assert (or (= z """alert(1)"" contenteditable>test</br>") (= z "dex=1 onactivate=alert(1)></i>") (= z "ncontextmenu=""alert(1)"">test</blink>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof ";"";>;" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(?![\s])[^0-9]*$")) (= (str.indexof z "tr" 0) 1) (not (= (str.indexof x "x=1 o" 0) 17))))
(assert (str.suffixof "test</br>" y))
(assert (or (not (= "<;A H" (str.substr y 0 5))) (not (str.in_re x ((_ re.from_regex ecma2020) "[9|8|7|6|5|4|3|2|1|0]\d{9}$"))) (str.suffixof "</script>" x)))
(check-sat)
