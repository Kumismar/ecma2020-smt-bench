; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex onmousedown=""alert(1)"">test</isindex>") (= x "<body onpagehide body onpagehide=""javascript:javascript:alert(1)""></body onpagehide>") (= x "<style>@keyframes x{}</style><summary style=""animation-name:x"" onanimationend=""alert(1)""></summary>")))
(assert (or (= z "a href=""\x20javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (<= (str.len z) 70))
(assert (or (not (str.prefixof "a href=""" z)) (not (str.suffixof "st</a>" y)) (not (<= (str.len z) 8))))
(assert (or (not (str.suffixof "a>" y)) (= "vg)>" (str.substr z 3 4)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*\d)(?=.*[a-zA-Z]).{6,}$")))))
(assert (or (str.contains z ">") (not (= (str.at z 0) ">")) (str.in_re x ((_ re.from_regex ecma2020) "\d+[\w\s]*"))))
(assert (or (= (str.len x) 99) (str.suffixof "ehide>" x) (= " body onp" (str.substr y 16 9))))
(assert (or (not (str.prefixof "<body onpa" x)) (str.in_re x ((_ re.from_regex ecma2020) "^[\w.%+-]+@[^-]([\w-]+\.)+[\w-]{2,6}$"))))
(check-sat)
