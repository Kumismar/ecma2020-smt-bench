; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed code=%(scriptlet)s></embed>") (= x "<applet onkeypress=""alert(1)"" contenteditable>test</applet>")))
(assert (or (= z "iv id=""127""><svg xmlns=""http://www.w3.org/2000/svg"" id=""x"">") (= z "rb>") (= z "repaste=""alert(1)"" contenteditable>test</body>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 47) "s") (str.contains (str.replace z "tp" " ") "ht ://w") (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{1,20}")))))
(assert (or (= "aste=""a" (str.substr z 3 7)) (not (= (str.indexof x "tente" 0) 33)) (not (str.prefixof "<" y))))
(assert (or (str.suffixof "</audio>" x) (str.prefixof "<embed " y)))
(assert (not (= (str.at x 33) ">")))
(assert (str.suffixof "\\""\"";" z))
(assert (= "g/2000" (str.substr z 40 6)))
(check-sat)
