; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{10348}&#X03c") (= x "<colgroup id=x tabindex=1 onfocus=alert(1)></colgroup>")))
(assert (or (= z "</style><spacer id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></spacer>") (= z "mark onbeforecopy=""alert(1)"" contenteditable>test</mark>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<colgroup" x) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9_\- \u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}]{3,60}$")))))
(assert (str.contains (str.replace z ">" """") "le""t"))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) ".{6,50}")) (str.contains (str.replace x "ins i" "alert(1)") "<alert(1)d=x")))
(assert (or (= "onmouseup=""aler (1)"">test</a>" (str.replace z "t" " ")) (= "ition:co" (str.substr z 33 8)) (not (str.in_re y ((_ re.from_regex ecma2020) "[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*(.[a-z]{2,4})")))))
(check-sat)
