; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><address ondrop=alert(1) contenteditable>drop here</address>") (= x "<nav draggable=""true"" ondragstart=""alert(1)"">test</nav>")))
(assert (or (= z "raggable=""true"" ondrag=""alert(1)"">test</big>") (= z "ert(1) autofocus></textarea>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "alert(" (str.substr z 24 6))) (not (= "<nav draggablealert(1)rue"" ondragstart=""alert(1)"">test</nav>raggable=""true"" ondrag=""alert(1)"">test</big>" (str.replace y "=""t" "alert(1)")))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+\-]+@([a-zA-Z0-9-]{1,}\.)+[a-zA-Z]{2,}$")))
(assert (not (str.suffixof "/big>" z)))
(assert (str.contains y "=""true"" c"))
(assert (or (not (str.suffixof "est</big>" z)) (str.prefixof "<div " y)))
(assert (or (str.prefixof "ert(1) " z) (not (= "<div draggable=""true"" contenteditable>drag me</div><address ondrop=alert(1) contenteditablex here</address>" (str.replace x ">drop" "x")))))
(check-sat)
