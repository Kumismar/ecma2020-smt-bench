; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp onkeypress=""alert(1)"" contenteditable>test</rp>") (= x "<samp onkeyup=""alert(1)"" contenteditable>test</sa\u{1f600}mp>")))
(assert (or (= z "talist>") (= z "text onblur=alert(1) tabindex=1 id=x></plaintext><input autofocus>") (= z "teditable>test</div>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<rp on" x) (not (str.contains z "e>te"))))
(assert (or (not (= "teditable>tx</div>" (str.replace z "est" "x"))) (not (str.suffixof "test</div>" y))))
(assert (or (not (str.suffixof "/sa\u{1f600}mp>" x)) (not (= "<h1 onclick=""alert(1)"">test</ipt:alert(1)</script>"">" (str.replace y "h1>" ""))) (not (str.contains z "=1 id"))))
(assert (not (= (str.len y) 119)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9a-zA-Z\u{e4}\u{c4}\u{f6}\u{d6}\u{fc}\u{dc}\-]*\.[0-9A-Za-z]*$"))) (not (= (str.at z 6) "b")) (= (str.len y) 60)))
(assert (not (str.suffixof "est</b>" z)))
(check-sat)
