; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary onclick=""alert(1)"">test</summary>") (= x "<rp onclick=""alert(1)"">test</rp>") (= x "<;IFRAME SRC="";javascript:alert(';XSS';);"";>;<;/IFRAME>;")))
(assert (or (= z "ntextmenu=""alert(1)"">test</li>") (= z "ert('XSS');\""&gt;&lt;/FRAMESET&gt;") (= z "textmenu=""alert(1)"">test</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y " red" 0) 22) (not (= "<rp onclick=""alert(1)"">alert(1)st</rp>ntextmenu=""alert(1)"">test</li>" (str.replace y "te" "alert(1)"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-z\u{c0}-\u{ff}-.]*$")))))
(assert (or (= ">test</r" (str.substr y 22 8)) (str.contains z """aler") (not (str.contains (str.replace x "nclic" "") "<rp ok="""))))
(assert (not (str.contains z "est\u{20000}")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[^0-9][a-zA-Z0-9_]+([.][a-zA-Z0-9_]+)*[@][a-zA-Z0-9_-]+([.][a-zA-Z0-9_]+)*[.][a-zA-Z]{2,4}$"))) (= (str.len y) 76) (str.prefixof "<;IFRA" y)))
(assert (or (str.prefixof "<summary " y) (not (str.in_re y ((_ re.from_regex ecma2020) "[\w]{13}")))))
(assert (= (str.at x 25) "s"))
(check-sat)
