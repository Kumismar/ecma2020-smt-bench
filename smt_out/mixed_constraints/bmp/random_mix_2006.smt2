; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onreadystatechange=alert(1)></iframe>") (= x "<marquee onkeydown=""alert(1)"" contenteditable>test</marquee>")))
(assert (or (= z "pt>javascript:alert(1)</script>") (= z "tenteditable>test</element>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len z) 17))
(assert (or (= "ipt>" (str.substr z 27 6)) (str.in_re x ((_ re.from_regex ecma2020) "[^@(www)]+")) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*\d)(?=.*[a-zA-Z]).{8,}")))))
(assert (= ">test</el" (str.substr z 12 9)))
(assert (not (= (str.indexof z "t:" 0) 12)))
(assert (or (not (str.contains z "st</smal")) (= (str.at y 12) "a")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^00[0-9]{1,4}[-\s0-9]{6,15}$"))) (str.contains z "pt:")))
(assert (or (= (str.len x) 60) (not (= (str.len z) 31))))
(assert (or (= (str.at z 1) "t") (str.prefixof "<i" x)))
(check-sat)
