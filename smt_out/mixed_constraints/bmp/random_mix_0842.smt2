; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;A HREF=\""//google\""&gt;XSS&lt;/A&gt;") (= x "<script\x09>javascript:alert(1)</script>") (= x "<link onfocusin=alert(1) id=x tabindex=1 style=display:block>")))
(assert (or (= z "lert(1) tab\u{20000}index=1 id=x></base><input autofocus>") (= z "ref=j&#97v&#97script&#x3A;&#97lert(1)>ClickMe") (= z "bed onmouseover=""alert(1)"">test</embed>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "&lt;A " y))
(assert (or (= "bedjavascript:useover=""alert(1)"">test</embed>" (str.replace z " onmo" "javascript:")) (= "ascript:" (str.substr x 15 8))))
(assert (or (= (str.at z 8) "t") (not (str.prefixof "<l" y))))
(assert (or (not (str.prefixof "<link onfo" y)) (not (= "j" (str.substr z 4 1)))))
(assert (or (not (str.contains x "/script")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9-]*$"))) (= (str.indexof y "en" 0) 19)))
(assert (str.suffixof "st</ins>" y))
(check-sat)
