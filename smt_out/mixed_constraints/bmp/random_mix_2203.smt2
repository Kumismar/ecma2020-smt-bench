; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i onmousemove=""alert(1)"">test</i>") (= x "<map draggable=""true"" ondragstart=""aler\u{1d400}t(1)"">test</map\u{10348}>")))
(assert (or (= z "rt(1)"">test</iframe>") (= z "mouseenter=""alert(1)"">test</dd\u{10348}>") (= z "olor 1s"" ontransitionend=alert(1)></title>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9\-\.]+$"))) (= (str.indexof z "t" 0) 7)))
(assert (str.prefixof "mousee" z))
(assert (or (not (str.suffixof "ap\u{10348}>" x)) (= (str.indexof y "aler" 0) 16) (= (str.at x 13) "e")))
(assert (or (not (str.prefixof "<te" x)) (str.in_re z ((_ re.from_regex ecma2020) "[0-9\s-]{7,20}"))))
(assert (or (not (= (str.indexof z "1)"">" 0) 18)) (not (>= (str.len z) 42))))
(assert (or (not (str.contains y "t(1)")) (>= (str.len z) 12) (not (str.in_re x ((_ re.from_regex ecma2020) "^\+[1-9]{1}[0-9]{3,14}$")))))
(check-sat)
