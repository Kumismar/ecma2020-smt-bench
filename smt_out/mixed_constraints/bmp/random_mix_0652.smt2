; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article draggable=""true"" ondragstart=""alert(1)"">test</article>") (= x "<thead id=x tabindex=1 onfocus=\u{1f600}alert(1)></thead>")))
(assert (or (= z "rag=""alert(1)"">test</header>") (= z "d=x tabindex=1 onbeforeactivate=alert(1)></footer>") (= z "ansition:color 1s"" ontransitionend=alert(1)></dl>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len x) 48)) (str.suffixof "</header>" z) (not (str.prefixof "<the" y))))
(assert (or (str.contains x "inde") (>= (str.len z) 15)))
(assert (or (not (= (str.indexof y "end" 0) 80)) (not (str.in_re x ((_ re.from_regex ecma2020) "^((\+?)\d\s*\(?\d{3}\)?)+\s*\d{3}(-?\d{2}){2}$")))))
(assert (not (str.suffixof ">" z)))
(assert (or (not (>= (str.len y) 77)) (not (str.prefixof "d=x " z)) (str.suffixof "ofocus>" z)))
(assert (or (= (str.indexof y "ans" 0) 63) (str.contains x "able=""")))
(check-sat)
