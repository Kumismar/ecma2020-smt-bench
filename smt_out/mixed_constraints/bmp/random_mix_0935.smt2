; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup onmouseover=""alert(1)"">test</colgroup>") (= x "<style>:target {color:red;}</style><address id=x style=""transition:color 1s"" ontransitionend=alert(1)></address>") (= x "<img src=http://www.google.fr/images/srpr/logo3w.png onload=alert(this.ownerDocument.cookie) width=0 height= 0 /> #")))
(assert (or (= z "tenteditable>test</rt>") (= z ")></dialog><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "og>" 0) 8)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "\d{5,}"))))
(assert (= (str.at x 5) "r"))
(assert (or (not (= "rt>" (str.substr z 19 4))) (= (str.indexof y "ditab" 0) 53)))
(assert (not (>= (str.len z) 22)))
(assert (or (str.contains x "rt(1)"">te") (str.contains z "bl")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z-]{1,20}")) (not (str.contains y "styl")) (not (= (str.indexof z "<i" 0) 11))))
(check-sat)
