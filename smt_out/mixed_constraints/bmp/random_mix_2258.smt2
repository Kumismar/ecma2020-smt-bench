; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote oncut=""alert(1)"" contenteditable>test</blockquote>") (= x "<template onmouseout=""alert(1)"">test</template>") (= x "<svg><section onload=alert(1)></section>")))
(assert (or (= z "t\x00>javascript:alert(1)</script>") (= z "ipt:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "ipt:ale" z) (not (= "<tempxate onmouseout=""alert(1)"">test</template>" (str.replace x "l" "x")))))
(assert (or (= "base>" (str.substr z 3 7)) (= "quote oncu" (str.substr x 6 10))))
(assert (>= (str.len x) 36))
(assert (or (str.suffixof ")</script>" y) (not (= (str.indexof x "lert(" 0) 22)) (= "t=""a" (str.substr y 19 4))))
(assert (or (not (str.suffixof "e>" x)) (not (= "ipt:alert(1)</scjavascript:" (str.replace z "ript>" "javascript:")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9 ]{1,30}$"))) (not (= (str.indexof x "ecti" 0) 7))))
(assert (or (not (str.contains x "ckquote>")) (not (str.prefixof "<temp" x)) (= "ert( ontenteditable>test</hr>" (str.replace z "1)"" c" " "))))
(check-sat)
