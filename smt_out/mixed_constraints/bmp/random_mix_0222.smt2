; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link ondblclick=""alert(1)"">test</link>") (= x "<span onclick=""alert(1)"">test</span>")))
(assert (or (= z "start=""alert(1)""></noframes>") (= z """alert(1)"">test</title>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^1([38][0-9]|4[579]|5[0-3,5-9]|6[6]|7[0135678]|9[89])\d{8}$"))))
(assert (or (str.suffixof "le>" y) (not (= "?=""a" (str.substr y 70 4))) (= "<span ick=""alert(1)"">test</span>start=""alert(1)""></noframes>" (str.replace y " oncl" " "))))
(assert (or (= "start=""alert(1)""></nofx>" (str.replace z "rames" "x")) (not (str.in_re y ((_ re.from_regex ecma2020) "^.+@.+\.[a-z]+$"))) (str.suffixof "</title>" y)))
(assert (not (= (str.at x 12) "l")))
(check-sat)
