; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><a onload=alert(1)></a>") (= x "<map onmouseleave=""alert(1)"">test</map>")))
(assert (or (= z "eforecut=""alert(1)"" contenteditable>test</dir>") (= z "a\u{10348}ble=""true"" ondragend=""alert(1)"">test</listing>") (= z "click=""alert(1)"">test</datalist>")))
(assert (= y (str.++ x z)))
(assert (str.contains y "=alert(1)>"))
(assert (not (>= (str.len z) 24)))
(assert (not (= (str.indexof y "ert" 0) 17)))
(assert (or (not (str.suffixof "listing>" y)) (str.prefixof "efor" z)))
(assert (= (str.indexof y "test<" 0) 29))
(assert (or (= "lick=""aler" (str.substr z 1 10)) (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z][A-Za-z0-9 _,-.'!?]*$"))))
(assert (or (= (str.at y 8) "o") (not (= "rt(1)><" (str.substr x 18 7))) (not (>= (str.len y) 61))))
(assert (not (= (str.indexof x "t(1)" 0) 19)))
(assert (or (= "(1" (str.substr y 40 2)) (not (str.contains y "est<"))))
(assert (str.prefixof "<svg" x))
(check-sat)
