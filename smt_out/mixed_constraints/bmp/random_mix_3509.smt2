; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><audio onload=alert(1)></audio>") (= x "<div oncut=""alert(1)"" contenteditable>test</div>") (= x "<;IFRAME SRC=http://ha.ckers.org/scriptlet.html <;")))
(assert (or (= z "ert(1)"">test</main>") (= z "1) tabindex=1 id=x></span><input autofocus>") (= z "n=""alert(1)"" contenteditable>test</header>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "io>" (str.substr x 33 5))) (str.suffixof "in>" z) (str.in_re x ((_ re.from_regex ecma2020) "^(https?:\/\/)?[\-A-Za-z0-9\.]*\.[A-Za-z]*[\-A-Za-z0-9+&@#\/%?=~_|!:,.;]*$"))))
(assert (not (str.contains y "IV=""Set-C")))
(assert (or (str.suffixof "utofocus>" y) (not (= (str.indexof z "x" 0) 10)) (not (= (str.at z 1) "r"))))
(assert (str.contains x "><"))
(assert (or (>= (str.len x) 31) (>= (str.len x) 49) (not (<= (str.len y) 61))))
(check-sat)
