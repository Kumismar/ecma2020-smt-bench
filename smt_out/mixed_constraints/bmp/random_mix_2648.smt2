; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th onpaste=""alert(1)"" contenteditable>test</th>") (= x "<ol onblur=alert(1) tabindex=1 id=x></ol><input autofocus>") (= x "<kbd onfocusout=alert(1) tabindex=1 id=x></kbd><input autofocus>")))
(assert (or (= z " src=""validaudio.wav""></audio>") (= z "r=alert(1) tabindex=1 id=x></content><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "udio>" 0) 25) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}0-9-]+\.[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}]{2,}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]{3,4}(\d{6})((\D|\d){8})?$")))))
(assert (or (str.contains y "r=alert(1") (str.contains (str.replace y "ert(1" "x") "lx)""") (not (= (str.indexof z "</p>" 0) 30))))
(assert (>= (str.len x) 41))
(assert (or (= (str.at z 41) "u") (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_-])+@([a-zA-Z0-9_-])+(.[a-zA-Z0-9_-])+"))))
(assert (or (str.suffixof "s>" x) (str.contains x "itab")))
(assert (or (not (= (str.at y 53) """")) (not (str.suffixof "</audio>" y))))
(check-sat)
