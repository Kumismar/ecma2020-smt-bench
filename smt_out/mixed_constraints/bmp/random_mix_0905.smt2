; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside ondblclick=""alert(1)"">test</aside>") (= x "<style>:target {transform: rotate(180deg);}</style><var id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></var>") (= x "<div id=""104""><svg xmlns=""http://www.w\u{20000}3.org/2000/svg"" id=""foo"">")))
(assert (or (= z "&lt;/A&gt;") (= z "t(1)/*<script/1='") (= z "t</col>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(\d+((\s?|[\.]?)\d+)+)?"))) (not (str.prefixof "e" z))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^1[3,5,8]d{9}$")))
(assert (or (= "div id=""10" (str.substr x 1 10)) (<= (str.len z) 13) (= "'" (str.substr z 16 2))))
(assert (or (str.prefixof "<aside o" y) (not (= (str.indexof y "o" 0) 41)) (<= (str.len z) 20)))
(assert (= "ert(1)""" (str.substr y 21 7)))
(check-sat)
