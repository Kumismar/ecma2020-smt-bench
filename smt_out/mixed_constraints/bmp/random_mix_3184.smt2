; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup id=x tabindex=1 onbeforedeactivate=alert(1)></sup><input autofocus>") (= x "<menuitem draggable=""true"" ondragleave=""alert(1)"">test</menuitem>")))
(assert (or (= z "/ruby>") (= z "dl oncopy=""alert(1)"" contenteditable>test</dl>") (= z "vg><discard onbegin=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 21) "<")) (not (str.suffixof "(1)>" y)) (= "b" (str.substr z 3 1))))
(assert (or (not (str.contains z ">test<")) (= (str.at y 104) "a")))
(assert (or (str.suffixof "test</dl>" y) (not (str.prefixof "<menuite" x))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Z\u{5d0}-\u{5ea}a-z ]{1,50}$"))))
(check-sat)
