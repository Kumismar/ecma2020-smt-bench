; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:exp\x5Cression(javascript:alert(1)"">DEF") (= x "<plaintext onmouseleave=""alert(1)"">test</plaintext>")))
(assert (or (= z "rue"" ondragenter=""alert(1)"">test</i>") (= z "t(1)"">test</small>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<table onc" x)) (= "test</plai" (str.substr y 35 10))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[\u{3041}-\u{3093}\u{30fc}]*$")))
(assert (str.contains y "nter"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\+?[\d\s\.*]+$"))) (not (<= (str.len x) 54))))
(assert (or (= (str.indexof x "n" 0) 41) (not (str.contains (str.replace z "all>" "javascript:") "smjavascript:")) (str.contains z "t(1)"">te")))
(assert (or (= "t:ale" (str.substr x 41 5)) (= (str.at x 41) "t") (not (= (str.indexof z "ue" 0) 1))))
(assert (or (not (<= (str.len y) 100)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z'*-/s]+$"))) (not (= "on(jav" (str.substr y 29 6)))))
(check-sat)
