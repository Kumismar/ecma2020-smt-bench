; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><template style=""animation-name:x"" onanimationstart=""alert(1)""></template>") (= x "<svg><rp onload=alert(1)></rp>") (= x "<script draggable=""true"" ondragenter=""alert(1)"">test</script>")))
(assert (or (= z "sition:transform 2s"" ontransitionrun=alert(1)></p>") (= z " ondragenter=""alert(1)"">test</shadow>") (= z """ contenteditable>drag me</div><cite ond\u{1f4a9}ragover=alert(1) contenteditable>drop here</cite>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len x) 28)))
(assert (or (str.suffixof ">" z) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{10}$")))))
(assert (or (str.contains y "lert(") (not (str.contains z "r=""a")) (not (str.prefixof "sit" z))))
(assert (not (str.prefixof "<s" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z]+([.]*[_a-zA-Z0-9]*[a-zA-Z0-9])*@[-0-9a-zA-Z]+([.]{1}[a-zA-Z]+)"))))
(check-sat)
