; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div onbeforecopy=""alert(1)"" contenteditable>test</div>") (= x "<font oncontextmenu=""alert(1)"">test</font>")))
(assert (or (= z "mousedown=""alert(1)"">test</hgroup>") (= z "iv><col ondrop=alert(1) contenteditable>drop here</col>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "mouse" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z]+\s)*[a-zA-Z]+$"))) (not (str.suffixof "/col>" z))))
(assert (or (not (= (str.at y 0) "<")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[_A-z0-9 ]{1,}$"))) (= (str.indexof z "re</c" 0) 47)))
(assert (or (not (= "onco" (str.substr y 6 4))) (not (str.in_re y ((_ re.from_regex ecma2020) "\b[a-zA-Z0-9-_.]+@[a-zA-Z0-9-_]+\.?[a-zA-Z0-9a-zA-Z0-9-_]+?\.(com|us|org|me|net|info|edu)\b"))) (str.suffixof ">" z)))
(assert (not (<= (str.len y) 102)))
(assert (str.contains z "uto"))
(check-sat)
