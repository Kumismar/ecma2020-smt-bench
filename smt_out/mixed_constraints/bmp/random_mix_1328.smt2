; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark id=x tabindex=1 onfocusin=alert(1)></mark>") (= x "<BODY BACKGROUND=""javascript:alert('XSS')"">") (= x "<video onkeydown=""alert(\u{10348}1)"" conten\u{1f4a9}teditable>test</video>")))
(assert (or (= z "rt(1)"">test</isindex>") (= z "ick=""alert(1)"">test</strike>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9 ]+"))) (not (= (str.at y 68) "k")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\d|-]+$")))))
(assert (not (str.prefixof "<video onk" y)))
(assert (or (= (str.at z 8) "r") (not (str.prefixof "rt" z)) (= (str.indexof x "(\u{10348}1" 0) 23)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(?:((([^0-9_!\u{a1}?\u{f7}?\u{bf}/\\+=@#$%\u{2c6}&*(){}|~<>;:[\]'\u{2019},\-.\s])){1,}(['\u{2019},\-\.]){0,1}){2,}(([^0-9_!\u{a1}?\u{f7}?\u{bf}/\\+=@#$%\u{2c6}&*(){}|~<>;:[\]'\u{2019},\-. ]))*(([ ]+){0,1}(((([^0-9_!\u{a1}?\u{f7}?\u{bf}/\\+=@#$%\u{2c6}&*(){}|~<>;:[\]'\u{2019},\-\.\s])){1,})(['\u{2019}\-,\.]){0,1}){2,}((([^0-9_!\u{a1}?\u{f7}?\u{bf}/\\+=@#$%\u{2c6}&*(){}|~<>;:[\]'\u{2019},\-\.\s])){2,})?)*)$")) (= "javascript:1)"">test</isindex>" (str.replace z "rt(" "javascript:"))))
(assert (str.contains (str.replace x "deo" "x") "<vix o"))
(assert (or (str.contains (str.replace z "test<" "javascript:") ")"">javascript:/") (str.contains x "BODY BACKG") (= (str.indexof z "ike>" 0) 24)))
(check-sat)
