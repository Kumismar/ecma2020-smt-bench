; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x/onxxx=1") (= x "<noembed draggable=""true"" ondragend=""alert(1)"">\u{10348}tes\u{10348}t</noembed>") (= x "<html onkeyup=""alert(1)"" contenteditable>test</html>")))
(assert (or (= z "alert(1)"" contenteditable>test</nobr>") (= z "1999/xhtml'><html:script>javascript:alert(1);</html:script></html:html>") (= z "p draggable=""true"" ondragenter=""alert(1)"">test</xmp>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<" y)) (not (str.contains x "/onxxx=1"))))
(assert (or (not (str.suffixof "est</nobr>" y)) (not (str.prefixof "<x/onxxx" x))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(?!0{5})\d{7,12}$"))) (str.contains z "aggable=") (not (= "tml:" (str.substr z 62 4)))))
(assert (or (str.prefixof "<x/" x) (not (str.suffixof "x=1" x))))
(check-sat)
