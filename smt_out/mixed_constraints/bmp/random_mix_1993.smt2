; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdi onkeyup=""alert(1)"" contenteditable>test</bdi>") (= x "<nav oncut=""alert(1)"" contenteditable>test</nav>") (= x "<s draggable=""true"" ondragleave=""alert(1)"">test</s>")))
(assert (or (= z "ript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "age draggable=""true"" ondragenter=""alert(1)"">test</image>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(0|(\+64(\s|-)?)){1}(20|21|22|24|26|27|28|29){1}(\s|-)?\d{3}(\s|-)?\d{3,5}$"))) (= (str.indexof z "small" 0) 25)))
(assert (or (= (str.indexof y "t<" 0) 42) (not (str.in_re y ((_ re.from_regex ecma2020) "^[^@]+@[^@]+[.]{1}[^@]{2,}$"))) (not (= (str.indexof x ">t" 0) 37))))
(assert (not (= (str.len x) 51)))
(assert (or (>= (str.len y) 66) (str.contains z "ipt:alert")))
(assert (= (str.at z 26) "i"))
(check-sat)
