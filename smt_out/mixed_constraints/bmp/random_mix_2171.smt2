; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen onfocusout=alert(1) tabindex=1 id=x></keygen><input autofocus>") (= x "<main draggable=""true"" ondragenter=""alert(1)"">test</main>") (= x "<script>/* *\x00/javascript:alert(1)// */</script>")))
(assert (or (= z "arget {color: red;}</style><code id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></code>") (= z ":target {color:red;}</style><marquee id=x style=""transition:color 1s"" ontransitionend=alert(1)></marquee>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[^\s*]([a-zA-Z0-9\s]+){0,10}$"))) (not (= (str.indexof y "ran" 0) 120)) (not (str.contains x "n draggab"))))
(assert (>= (str.len y) 155))
(assert (or (str.prefixof "<" y) (not (str.in_re x ((_ re.from_regex ecma2020) "(?:((?:0[1-9]|1[0-9]|2[0-9])\/(?:0[1-9]|1[0-2])|(?:30)\/(?!02)(?:0[1-9]|1[0-2])|31\/(?:0[13578]|1[02]))\/(?:19|20)[0-9]{2})")))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]{2,30}@[a-z0-9.-]{3,20}\.[a-z]{2,4}$")))
(assert (str.suffixof "marquee>" z))
(check-sat)
