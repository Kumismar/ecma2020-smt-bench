; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noframes onfocusout=alert(1) tabindex=1 id=x></noframes><input autofocus>") (= x "<select autofocus onfocusin=alert(1)>") (= x "<A HREF=""htt\u{9}p://6\u{9}6.000146.0x7.147/"">XSS</A>")))
(assert (or (= z "k=""alert(1)"">test</shadow>") (= z "rt(1)"">test</canvas>") (= z "itable>drag me</div><spacer ondrop=alert(1) contenteditable>drop here</spacer>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "ym>" z))
(assert (or (str.prefixof "<A H" x) (str.suffixof "tofocus>" x)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.]{1,25}$"))) (not (= (str.at z 14) "a")) (str.contains y "ta")))
(assert (or (not (str.contains (str.replace y "t" """") "F=""h""t\u{9}p:")) (not (= "<s<b>ct autofocus onfocusin=alert(1)>itable>drag me</div><spacer ondrop=alert(1) contenteditable>drop here</spacer>" (str.replace y "ele" "<b>")))))
(assert (or (not (= (str.len y) 63)) (str.in_re x ((_ re.from_regex ecma2020) "^([1-9]|[12]\d|30)$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[_a-zA-Z0-9-]+(\.[_a-zA-Z0-9-]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*(\.[a-zA-Z]{2,3})$"))))
(assert (not (= "<A HREF=""htt\u{9}p://6<b>00146.0x7.147/"">XSS</A>k=""alert(1)"">test</shadow>" (str.replace y "\u{9}6.0" "<b>"))))
(check-sat)
