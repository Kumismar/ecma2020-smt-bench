; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onkeydown body onkeydown=""javascript:javascript:alert(1)""></body onkeydown>") (= x "<div draggable=""true"" contenteditable>drag me</div><embed ondrop=alert(1) contenteditable>drop here</embed>") (= x "<blockquote id=x tabindex=1 ondeactivate=alert(1)></blockquote><input id=y autofocus>")))
(assert (or (= z """ ondragenter=""alert(1)"">test</command>") (= z "alert(1)"" contenteditable>test</header>") (= z "/src=""worksinchrome&colon;prompt&#x28;1&#x29;""/%00*/onerror='eval(src)'>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 1) "d")) (str.in_re y ((_ re.from_regex ecma2020) "^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$"))))
(assert (not (str.prefixof "<a onm" y)))
(assert (str.contains (str.replace x "t:ale" "<b>") "ip<b>rt(1)"))
(assert (not (= (str.len z) 39)))
(assert (or (str.prefixof "yle><sub i" z) (= "<body onkeydown body onkeydown=""javascript:javascript:ale""""></body onkeydown>" (str.replace x "rt(1)" """"))))
(assert (or (not (= (str.at y 107) "t")) (not (str.in_re y ((_ re.from_regex ecma2020) "\+?\(?\d{2,4}\)?[\d\s-]{8,}"))) (str.prefixof "<blo" y)))
(assert (= (str.indexof z "orksi" 0) 7))
(assert (str.suffixof "rc)'>" z))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(.*\d.*){6,}$"))))
(assert (not (= (str.indexof x ":" 0) 42)))
(check-sat)
