; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><shadow id=x style=""transition:color 1s"" ontransitionend=alert(1)></shadow>") (= x "<nextid onkeypress=""alert(1)"" contenteditable>test</nextid>") (= x "<optgroup id=x tabindex=1 onfocusin=alert(1)></optgroup>")))
(assert (or (= z "style=""transition:color 1s"" ontransitionend=alert(1)></template>") (= z "ert(1)"">test</article>") (= z "onerror=alert(2)//]> -->//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<nextid o" x)) (not (= (str.at y 18) "x")) (not (str.contains z "alert(2"))))
(assert (= (str.len x) 59))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\u{41d}\u{43e}\u{43c}\u{435}\u{440} \u{442}\u{435}\u{43b}\u{435}\u{444}\u{43e}\u{43d}\u{443}$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z\u{c0}-\u{d6}\u{d8}-\u{f6}\u{f8}-\u{ff}-0-9$, ]{2,99}$"))) (str.in_re x ((_ re.from_regex ecma2020) "^[ a-zA-Z ]+$"))))
(assert (not (str.contains z "ns")))
(check-sat)
