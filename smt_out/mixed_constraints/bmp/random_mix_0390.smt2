; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<DIV STYLE=""width:expression(javascript:alert(1));"">") (= x "<rp onbeforecut=""alert(1)"" contenteditable>test</rp>")))
(assert (or (= z "></summary>") (= z "t(1)"">test</article>") (= z "sin=alert(1)></dd>")))
(assert (= y (str.++ x z)))
(assert (or (= "test" (str.substr y 43 4)) (not (= ";XS" (str.substr y 72 3)))))
(assert (or (not (= (str.indexof z "1" 0) 10)) (not (str.contains z "mmar"))))
(assert (or (str.prefixof "<DIV STY" x) (not (str.suffixof ">" x)) (not (= (str.len x) 52))))
(assert (or (>= (str.len z) 10) (not (<= (str.len z) 20)) (not (= (str.indexof x ">" 0) 31))))
(assert (or (not (str.contains (str.replace x "ript:" "alert(1)") "calert(1)alert")) (not (str.in_re y ((_ re.from_regex ecma2020) "(([x-zX-Z]{1})([-]?)(\d{7})([-]?)([a-zA-Z]{1}))|((\d{8})([-]?)([a-zA-Z]{1}))"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^(13[0-9]|14[5|7]|15[0|1|2|3|5|6|7|8|9]|18[0|1|2|3|5|6|7|8|9])[0-9]{8}$")))))
(assert (= "javascrip" (str.substr y 29 9)))
(assert (str.contains z "</summ"))
(check-sat)
