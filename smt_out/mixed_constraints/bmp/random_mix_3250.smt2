; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time onbeforepaste=""alert(1)"" contenteditable>test</time>") (= x "<a href=""\x02javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<div draggable=""true"" contenteditable>drag me</div><area ondrop=alert(1) contenteditable>drop here</area>")))
(assert (or (= z "ecut=""alert(1)"" contenteditable>test</listing>") (= z "t(1) required><input type=submit>") (= z " tabindex=1 ondeactivate=alert(1)></a><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "s>" (str.substr y 163 5)) (not (= " tabindex=1 ondeactivate=ale""(1)></a><input id=y autofocus>" (str.replace z "rt" """")))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]+$|^[0-9]+$")) (not (= (str.len y) 60))))
(assert (or (str.suffixof "isting>" z) (not (str.contains z "a><inpu")) (str.prefixof "<time " x)))
(assert (= (str.len x) 71))
(assert (or (= (str.at z 9) "r") (not (= (str.at x 20) "i")) (str.in_re x ((_ re.from_regex ecma2020) "^(?:\d{3}[\-]\d{3}[\-]\d{4})$"))))
(check-sat)
