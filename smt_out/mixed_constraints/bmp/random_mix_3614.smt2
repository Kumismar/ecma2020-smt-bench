; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd onmouseenter=""aler\u{10348}t(1)"">test</kbd>") (= x "<META HTTP-EQUIV=""refresh"" CONTENT=""0;url=data:text/html;base64,PHNjcmlwdD5hbGVydCgnWFNTJyk8L3NjcmlwdD4K"">") (= x "<div draggable=""true"" contenteditable>drag me</div><cite ondrop=alert(1) contenteditable>drop here</cite>")))
(assert (or (= z ")???") (= z "javascript:alert(&apos;XSS&apos;);&quot;&gt;&lt;/IFRAME&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<" y) (= (str.at y 8) "g") (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-z][A-z -]+$")))))
(assert (str.prefixof "<META" x))
(assert (or (= (str.at z 2) "?") (not (= ")""?" (str.replace z "??" """")))))
(assert (or (<= (str.len z) 59) (not (str.contains z "??")) (not (str.in_re y ((_ re.from_regex ecma2020) "[\u{410}-\u{44f}- ]+")))))
(check-sat)
