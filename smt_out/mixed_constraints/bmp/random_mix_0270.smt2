; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp onfocusout=alert(1) tabindex=1 id=x></samp><input autofocus>") (= x "<div id=""125""><?xml version=""1.0""?>") (= x "<hgroup onmousedown=""alert(1)"">test</hgroup>")))
(assert (or (= z "st</dir>") (= z "er>")))
(assert (= y (str.++ x z)))
(assert (= "own" (str.substr x 16 3)))
(assert (or (= "/dir>" (str.substr z 3 5)) (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9!@#$%^*()_]{6,30}$"))))
(assert (or (str.suffixof "s>" y) (str.in_re z ((_ re.from_regex ecma2020) "^(?!http).*$"))))
(assert (not (= (str.len x) 66)))
(assert (or (not (= (str.len z) 25)) (= "ert(1)""></" (str.substr y 60 10)) (= "xr>" (str.replace z "e" "x"))))
(check-sat)
