; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><bdo id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></bdo>") (= x "<var draggable=""true"" ondragenter=""alert(1)"">test</var>")))
(assert (or (= z "alert(1)"">test</em>") (= z "keypress=""al\u{10348}ert(1)"" contenteditable>test</template>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ")></bdo>" x) (not (<= (str.len z) 23))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{5,7}$")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"))) (str.prefixof "<style>:ta" y)))
(assert (or (= (str.at x 79) "a") (not (= (str.at x 19) "e")) (not (<= (str.len z) 25))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$")) (str.suffixof ">" x)))
(check-sat)
