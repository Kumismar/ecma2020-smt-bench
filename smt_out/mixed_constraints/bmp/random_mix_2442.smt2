; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<progress id=x tabindex=1 onbeforeactivate=alert(1)></progress>") (= x "<summary onmouseout=""alert(1)"">test</summary>")))
(assert (or (= z "g src=xxx:x onerror=javascript:alert(1)> -->") (= z "contenteditable>test</h1>") (= z "t>document.vulnerable=true;//--></script>")))
(assert (= y (str.++ x z)))
(assert (not (= "rt(1" (str.substr y 79 4))))
(assert (not (str.prefixof "<sum" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{f1}\u{d1} _]*[A-Za-z0-9\u{f1}\u{d1}][A-Za-z0-9\u{f1}\u{d1} _]*$"))))
(assert (or (str.prefixof "g src=xxx" z) (not (= (str.at y 64) " ")) (not (= "\u{10348}T TYPE" (str.substr y 5 7)))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[_A-z0-9]{1,}$")))
(assert (not (str.contains y ">g sr")))
(assert (or (= "se" (str.substr x 14 2)) (str.contains (str.replace x "m" "<b>") "u<b>ma") (not (str.prefixof "c" z))))
(check-sat)
