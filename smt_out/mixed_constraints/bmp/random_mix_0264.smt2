; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem onbeforecopy=""alert(1)"" contenteditable>test</menuitem>") (= x "<tfoot id=x tabindex=1 onbeforeactivate=alert(1)></tfoot>") (= x "<br onkeypress=""alert(1)"" contenteditable>test</br>")))
(assert (or (= z "(1)"">test</param>") (= z "{color:red}</style>//[\u{1f600}""'`-->]]\u{1d400}>]</div>") (= z "g src=x onerror=javascript:al\u{1f4a9}ert((`A`))>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9]{2,20}"))) (str.contains (str.replace x "efor" " ") "1 onb e") (not (str.contains (str.replace x "ble>" "x") "itaxt"))))
(assert (or (str.contains z "param") (not (= (str.indexof z "ed" 0) 8))))
(assert (not (= "1)"" co" (str.substr y 30 6))))
(assert (not (str.prefixof "<t" y)))
(assert (or (str.suffixof "83))"">uee>" y) (= (str.len z) 40) (str.contains x "1 onbefo")))
(check-sat)
