; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script onLoad script onLoad=""javascript:javascript:alert(1)""></script onLoad>") (= x "<strong onmouseleave=""alert(1)"">test</strong>") (= x "<kbd ondblclick=""alert(1)"">test</kbd>")))
(assert (or (= z "cation='javascript:alert(1)'"">") (= z "ntenteditable>test</content>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.]{6,20}$"))) (not (str.suffixof "pplet>" x)) (not (>= (str.len y) 65))))
(assert (or (>= (str.len x) 29) (<= (str.len x) 78)))
(assert (or (not (str.contains (str.replace y "ion" """") "at""='ja")) (str.contains z ")""") (= "bl" (str.substr z 10 2))))
(assert (or (str.contains y "ten") (not (str.in_re z ((_ re.from_regex ecma2020) "^(2)$"))) (= "ondb" (str.substr y 5 4))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) ".{6,27}"))) (not (str.prefixof "cation='" z))))
(assert (not (str.prefixof "<kbd ond" y)))
(check-sat)
