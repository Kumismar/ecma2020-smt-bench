; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture onkeydown=""alert(1)"" contenteditable>test</picture>") (= x "<output onbeforecopy=""alert(1)"" contenteditable>test</output>")))
(assert (or (= z "=alert(1)></select><input id=y autofocus>") (= z "nbeforecut=""alert(1)"" contenteditable>test</map>") (= z "onmouseout=""alert(1)"">test</nav>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{5,5}"))) (not (str.contains (str.replace y ">te" "javascript:") "tablejavascript:st</o"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\+7\(\d\d\d\) \d\d\d-\d\d\d\d$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.\+_-]+@[a-zA-Z0-9_-]+[\.][a-zA-Z0-9._-]+$")))))
(assert (not (= (str.indexof y "u" 0) 33)))
(assert (not (str.prefixof "nb" z)))
(assert (or (not (= (str.at y 31) " ")) (= (str.indexof x "co" 0) 30)))
(assert (= "<picture onkeydown=""alert(1)""javascript:ntenteditable>test</picture>" (str.replace x " co" "javascript:")))
(assert (or (str.suffixof "autofocus>" z) (not (str.suffixof "t</nav>" y))))
(check-sat)
