; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main id=x tabindex=1 onbeforeactivate=alert(1)></main>") (= x "<svg><i onload=alert(1)></i>")))
(assert (or (= z "s>") (= z "rror=""javascript:alert(1)""></object>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len x) 26)))
(assert (not (str.suffixof "/object>" y)))
(assert (or (str.contains z "alert(1") (str.suffixof "/i>" x)))
(assert (<= (str.len y) 93))
(assert (or (= "n" (str.substr y 9 1)) (not (str.contains (str.replace x "ad=al" "alert(1)") "onloalert(1)e"))))
(assert (or (str.prefixof ">" z) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9a-zA-Z]+$")))))
(assert (<= (str.len z) 11))
(check-sat)
