; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<button draggable=""true"" ondrag=""alert(1)"">test</button>") (= x "<table onmouseout=""alert(1)"">test</t\u{10348}able>")))
(assert (or (= z "e>@keyframes x{}</style><figcaption style=""animation-name:x"" onanimationstart=""alert(1)""></figcaption>") (= z "copy=""alert(1)"" contenteditable>test</xmp>") (= z " ondrop=alert(1) contenteditable>drop here</dir>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 20) "l")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z s]+$")) (not (str.prefixof "<tab" x))))
(assert (or (str.contains (str.replace z "e>" "") "bldro") (not (str.suffixof "re</dir>" z)) (not (= ">" (str.substr z 5 1)))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z\u{e5}\u{e4}\u{f6}\u{c5}\u{c4}\u{d6}]{2,}\s[a-zA-z\u{e5}\u{e4}\u{f6}\u{c5}\u{c4}\u{d6}]{1,}'?-?[a-zA-Z\u{e5}\u{e4}\u{f6}\u{c5}\u{c4}\u{d6}]{2,}\s?([a-zA-Z\u{e5}\u{e4}\u{f6}\u{c5}\u{c4}\u{d6}]{1,})?)"))))
(assert (or (str.contains y "tivate=a") (not (= "tion sty" (str.substr z 31 8))) (not (str.prefixof "e>@keyfr" z))))
(assert (= (str.at y 111) "i"))
(assert (str.suffixof "/xmp>" y))
(assert (or (str.suffixof "ption>" y) (not (= "<table onmous""t=""alert(1)"">test</t\u{10348}able>e>@keyframes x{}</style><figcaption style=""animation-name:x"" onanimationstart=""alert(1)""></figcaption>" (str.replace y "eou" """")))))
(assert (str.contains z "es x{}</st"))
(check-sat)
