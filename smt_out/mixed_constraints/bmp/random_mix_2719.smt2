; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span id=x tabindex=1 onbeforedeactivate=alert(1)></span><input autofocus>") (= x "<big id=x tabindex=1 onfocus=alert(1)></big>")))
(assert (or (= z "canvas>") (= z "table>drop here</summary>")))
(assert (= y (str.++ x z)))
(assert (not (= "ckquote>" (str.substr z 43 8))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^(0|[1-9][0-9]*)$")))
(assert (or (= "le>dro" (str.substr z 3 6)) (not (str.contains (str.replace z ">" " ") " ")) (not (= "nde" (str.substr x 14 3)))))
(assert (or (not (= (str.at y 67) "o")) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-za-z.\s]*"))) (not (str.contains z """ "))))
(assert (= (str.at x 72) "s"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}a-zA-Z\s]+$"))) (str.prefixof "<style>:" x)))
(check-sat)
