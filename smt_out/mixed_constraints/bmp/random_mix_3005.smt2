; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#0000060") (= x "<style>@keyframes x{}</style><button style=""animation-name:x"" onanimationend=""alert(1)""></button>")))
(assert (or (= z "teditable>test</applet>") (= z " ontransitionend=alert(1)></command>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z-\s]+$")) (= "0" (str.substr x 8 10))))
(assert (or (= "<style>@keyframes x{}</style><button style=""animation-name:x"" onanimationend=""alert(1)""></button> ontransitionend=alert(1)></comxd>" (str.replace y "man" "x")) (= (str.at z 28) "c") (= (str.indexof z "ble>t" 0) 6)))
(assert (not (str.prefixof "tedi" z)))
(assert (or (= "<meta onbeforecut=""alert(1)"" contteditable>test</meta> autofocus>" (str.replace y "en" "")) (not (= (str.at z 16) "a"))))
(assert (or (not (str.suffixof "/command>" z)) (str.suffixof "pplet>" z) (str.in_re y ((_ re.from_regex ecma2020) "^[789][0-9]{9}"))))
(check-sat)
