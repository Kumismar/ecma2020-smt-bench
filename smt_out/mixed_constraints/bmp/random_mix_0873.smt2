; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><acronym style=""animation-name:x"" onanimationstart=""alert(1)""></acronym>") (= x "&lt;BASE HREF=&quot;javascript:alert(&apos;XSS&apos;);//&quot;&gt;") (= x "<IMG SRC=x onbeforeprint=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "t:alert(1)"">") (= z "tenteditable>test</main>") (= z "te=""alert(1)"" contenteditable>test</strong>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "pt:alert(" (str.substr z 13 9))) (not (str.suffixof "ong>" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z]+$")))))
(assert (str.prefixof "<" y))
(assert (or (str.contains z "ditable") (str.contains (str.replace y "r" "") "foepr")))
(assert (= "tenteditable<b>st</main>" (str.replace z ">te" "<b>")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{6,14}"))))
(assert (not (str.contains (str.replace z "ed" "alert(1)") "ntalert(1)ita")))
(assert (or (str.prefixof "<style" x) (not (= (str.at y 21) "i")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z .]+")))))
(assert (not (str.contains z "t</m")))
(assert (not (= "rm: ro" (str.substr y 23 6))))
(check-sat)
