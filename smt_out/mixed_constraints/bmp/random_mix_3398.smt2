; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var onpaste=""alert(1)"" contenteditable>test</var>") (= x "<style>@keyframes x{}</style><xss style=""animation-name:x"" onanimationstart=""alert(1)""></xss>") (= x "<\u{1f4a9}svg><param onload=alert(1)></param>")))
(assert (or (= z "1)>") (= z "p=""alert(1)"">test</big>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "y" 0) 3)))
(assert (or (not (str.contains z ")>")) (not (str.in_re x ((_ re.from_regex ecma2020) "^\+?\d{6,16}"))) (str.contains (str.replace x """ale" """") "te=""rt")))
(assert (not (str.suffixof "</big>" z)))
(assert (or (not (str.contains (str.replace z "1)>" "x") "x")) (not (= "e>test<" (str.substr x 38 7))) (not (>= (str.len z) 1))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*[A-Za-z]{2})[A-Za-z\s]{2,25}"))))
(assert (or (str.suffixof "ig>" z) (str.prefixof "p=""aler" z)))
(assert (not (= (str.indexof y "p>" 0) 55)))
(check-sat)
