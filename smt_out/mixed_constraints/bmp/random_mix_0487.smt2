; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<TABLE BACKGROUND=""javascript:javascript:alert(1)"">") (= x "<small onmousemove=""alert(1)"">test</small>")))
(assert (or (= z " onbeforecopy=""alert(1)"" contenteditable>test</p>") (= z "d=x tabindex=1 ondeactivate=alert(1)></em><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)+$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9.*_+-]{4,30}$"))) (str.contains (str.replace y "ble>" "alert(1)") "taalert(1)t") (not (str.suffixof "</dfn>" y))))
(assert (or (= "1 " (str.substr y 55 2)) (= (str.at x 28) """") (not (str.prefixof "<small " x))))
(assert (= (str.indexof z "bin" 0) 6))
(assert (or (not (= "<small o emove=""alert(1)"">test</small>" (str.replace x "nmous" " "))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\+]+$"))) (not (str.contains (str.replace y """a" "") "=l"))))
(assert (str.prefixof "<small on" y))
(check-sat)
