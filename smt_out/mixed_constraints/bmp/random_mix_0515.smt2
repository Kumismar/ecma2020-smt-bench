; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<font onmouseout=""alert(1)"">test</font>") (= x "`""'><img src=xxx:x \x0Bonerror=javascript:alert(1)>") (= x "<caption oncontextmenu=""alert(1)"">test</caption>")))
(assert (or (= z "1)") (= z " onbeforecu\u{1f4a9}t=""alert(1)"" contenteditable>test</param>") (= z "itable>drop here</var>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "n oncontex")) (str.in_re z ((_ re.from_regex ecma2020) "^[^\f\n\r\t\v]{2,44}$")) (not (<= (str.len x) 49))))
(assert (or (not (str.suffixof "t(1)>" x)) (<= (str.len y) 155)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z,&]{3,4}[0-9]{2}[0-1][0-9][0-3][0-9][A-Za-z,0-9][A-Za-z,0-9][0-9,Aa]$")) (not (str.contains (str.replace x ">te" "javascript:") "1)""javascript:st</c"))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[\dA-Za-z]{0,14}")))
(assert (or (not (str.suffixof "/param>" y)) (not (str.contains (str.replace z "t" " ") "> est")) (not (= (str.len y) 86))))
(assert (str.prefixof "1" z))
(check-sat)
