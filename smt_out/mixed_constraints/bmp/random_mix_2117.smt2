; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input type=image onloadend=alert(1) src=validimage.png>") (= x "<header onmouseover=""alert(1)"">test</header>") (= x "<;IMG SRC=javascript:alert(String.fromCharCode(88,83,83))>;")))
(assert (or (= z "le>test</details>") (= z """>test</td>") (= z "ouseup=""alert(1)"">test</picture>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 27) "=")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[9|8|7|6]\d{8}$"))) (= (str.len z) 10)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[276][0-9]{7}"))))
(assert (or (str.contains (str.replace x "le" "") "r=""art(") (not (str.prefixof "<;IMG S" y)) (not (= "perl -e 'print \""<SCR\0IPT>alert(\""XSS\alert(1)CR\0IPT>\"";' > out" (str.replace x """)</S" "alert(1)")))))
(assert (or (str.prefixof "ouseup=""a" z) (<= (str.len x) 46)))
(assert (not (str.suffixof ";" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "\d{7,11}"))) (= "le>tejavascript:/details>" (str.replace z "st<" "javascript:"))))
(assert (or (not (= (str.at y 23) "e")) (not (= (str.indexof z "</td>" 0) 6))))
(check-sat)
