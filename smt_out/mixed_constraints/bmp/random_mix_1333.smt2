; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb onmouseleave=""alert(1)"">test</rb>") (= x "<script>document.vulnerable=true;</script>")))
(assert (or (= z ">") (= z "le=confirm()>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "n" 0) 1)) (str.contains x ")""")))
(assert (or (not (str.contains x "1)")) (str.in_re z ((_ re.from_regex ecma2020) "^[ 0-9]+$"))))
(assert (or (>= (str.len z) 1) (str.contains (str.replace z ">" "alert(1)") "alert(1)")))
(assert (or (not (str.prefixof "<" x)) (= (str.indexof x "aler" 0) 18) (str.contains y "ent.vuln")))
(assert (or (not (= "/" (str.substr y 34 1))) (str.in_re y ((_ re.from_regex ecma2020) "^[^\s]+$"))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*\d).{11,}$")))
(assert (str.contains (str.replace z "e=co" "alert(1)") "lalert(1)nf"))
(check-sat)
