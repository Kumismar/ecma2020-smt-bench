; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><h1 id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></h1>") (= x "<script>alert('XSS')</script>") (= x "<rb id=x tabindex=1 onfocus=alert(1)></rb>")))
(assert (or (= z "gable=""true"" ondrags\u{20000}tart=""alert(1)"">test</as\u{10348}ide>") (= z " here")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "e" y)) (= (str.len x) 122)))
(assert (or (not (<= (str.len z) 46)) (not (>= (str.len z) 48))))
(assert (or (not (str.suffixof "ript>" x)) (= (str.at y 26) "p") (not (str.in_re x ((_ re.from_regex ecma2020) "3$")))))
(assert (or (= "<rb id=x tabindejavascript:onfocus=alert(1)></rb>" (str.replace x "x=1 " "javascript:")) (not (= " id=x tabi" (str.substr x 3 10)))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9_ ]{1,64}$")))
(assert (not (= "alert(1)><" (str.substr y 28 10))))
(check-sat)
