; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "';';;!--"";<;XSS>;=&;{()}") (= x "<s ondblclick=""alert(1)"">test</s>") (= x "<style>@key\u{1f600}frames x{}</style><main style=""animation-\u{1d400}name:x"" onanimationend=""alert(1)""></main>")))
(assert (or (= z "/></a></><img src=1.gif onerror=alert(1)>") (= z "S')"";</STYLE>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 43) "a"))
(assert (not (= "<s ondbl ick=""alert(1)"">test</s>" (str.replace x "cl" " "))))
(assert (not (= (str.indexof y "t(1" 0) 19)))
(assert (or (not (str.prefixof "/></a><" z)) (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z0-9\u{b4}`\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{e4}\u{eb}\u{ef}\u{f6}\u{fc}\u{c4}\u{cb}\u{cf}\u{d6}\u{dc}\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{f1}\u{d1}\u{ba},.\s]{10,80})+$"))))
(assert (or (= "=x style=""" (str.substr y 63 10)) (not (= (str.indexof z ")"";</" 0) 2))))
(assert (not (str.contains z "STYLE>")))
(assert (or (not (= (str.at y 98) """")) (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,20})$"))) (= (str.indexof y ";" 0) 1)))
(assert (= (str.len y) 108))
(assert (or (not (str.contains z "E>")) (not (= "r" (str.substr y 18 1))) (not (str.prefixof "<styl" x))))
(check-sat)
