; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee id=x tabindex=1 onbeforedeactivate=alert(1)></marquee><input autofocus>") (= x "<footer ondblclick=""alert(1)"">test</footer>")))
(assert (or (= z "sound id=x style=""transition:color 1s"" ontransitionend=alert(1)></bgsound>") (= z "URL=javascript:alert('XSS');\"">")))
(assert (= y (str.++ x z)))
(assert (str.contains y "tyl"))
(assert (not (= (str.indexof x "npu" 0) 65)))
(assert (or (= "=" (str.substr z 16 1)) (not (>= (str.len y) 103))))
(assert (or (not (str.prefixof "<marquee " x)) (= "ck=""\u{20000}alert" (str.substr z 8 10)) (= (str.len y) 74)))
(assert (or (str.contains y "k=""a") (not (str.suffixof "us>" x))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^(1|2)[0-9]{3}$")))
(check-sat)
