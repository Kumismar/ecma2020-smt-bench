; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onmouseover=""alert(String.fromCharCode(88,83,83))"">") (= x "<svg\u{1f600}><s onload=alert(1)></s>")))
(assert (or (= z "t=""1000""/></a>") (= z "ction onmouseout=""alert(1)"">test</section>") (= z "ert(1)"">test</samp>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "ipt>" y) (not (str.contains x "arCode(")) (not (= (str.at z 5) "d"))))
(assert (= (str.at y 39) "s"))
(assert (not (str.prefixof "ption>" z)))
(assert (or (str.contains x "ad=a") (not (str.contains y "ad=al")) (not (= (str.at z 3) "1"))))
(assert (or (>= (str.len z) 3) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z\s]{2,}")))))
(check-sat)
