; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s draggable=""true"" ondragstart=""alert(1)"">test</s>") (= x "<STYLE>li {list-style-image: url(\""javascript:alert('XSS')\"");}</STYLE><UL><LI>XSS")))
(assert (or (= z "body onmessage=a\u{1f600}l\u{20000}ert(1)>") (= z "ype=""video/mp4""></video>")))
(assert (= y (str.++ x z)))
(assert (= "<STYLE>li {list-style-image: alert(1)(\""javascript:alert('XSS')\"");}</STYLE><UL><LI>XSSbody onmessage=a\u{1f600}l\u{20000}ert(1)>" (str.replace y "url" "alert(1)")))
(assert (= (str.indexof x ":" 0) 7))
(assert (= (str.at y 94) "p"))
(assert (not (str.suffixof "></video>" z)))
(assert (not (str.contains (str.replace z "cut" "alert(1)") "eforealert(1)=""al")))
(assert (or (not (str.contains y "=x tab")) (= "<div oncontextmenu=""alert"">test</div>" (str.replace x "(1)""" """"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "9698"))) (not (= (str.at x 21) "-")) (str.prefixof "<style" y)))
(assert (or (str.suffixof ">test</s>" x) (not (= (str.indexof y "nmo" 0) 13)) (not (= (str.at z 11) "m"))))
(assert (or (<= (str.len z) 25) (not (str.contains y "<STYLE>l"))))
(check-sat)
