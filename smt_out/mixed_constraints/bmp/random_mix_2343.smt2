; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture onkeypress=""alert(1)"" contenteditable>test</picture>") (= x "<listing onfocusout=alert(1) tabindex=1 id=x></listing><input autofocus>") (= x "&lt;META HTTP-EQUIV=&qu\u{1f4a9}ot;refresh&quot; CONTENT=&quot;0;url=data:text/html;bas\u{1f4a9}e64,PHNjcmlwdD5hbGVydCgnWFNTJyk8L3NjcmlwdD4K&quot;&gt;")))
(assert (or (= z "here</rb>") (= z "seover=""alert(1)"">test</hgroup>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 50) "t")))
(assert (str.contains z "here"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^2\d{9}|69\d{8}$"))) (str.in_re x ((_ re.from_regex ecma2020) "\([0-9]{2}\) [0-9]{4,6}-[0-9]{3,4}$")) (str.suffixof "ere</rb>" z)))
(assert (or (not (str.contains y "put aut")) (not (= (str.at z 25) "g")) (str.suffixof "cus>" x)))
(assert (or (not (= "<""icture onkeypress=""alert(1)"" contenteditable>test</picture>here</rb>" (str.replace y "p" """"))) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-z0-9]{6,20}")))))
(assert (or (not (str.contains (str.replace x " " """") "ion""o")) (not (= "cus" (str.substr y 13 3)))))
(assert (or (= (str.indexof x "</de" 0) 53) (>= (str.len z) 8)))
(check-sat)
