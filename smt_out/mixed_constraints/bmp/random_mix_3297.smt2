; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe draggable=""true"" ondragenter=""alert(1)"">test</iframe>") (= x "<plaintext ondblclick=""alert(1)"">test</plaintext>") (= x "<tfoot id=x tabindex=1 onbeforedeactivate=alert(1)></tfoot><input autofocus>")))
(assert (or (= z "lert(1)"">test</area>") (= z "ruby>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "lert(1)"">")) (= (str.indexof x "i" 0) 4)))
(assert (str.prefixof "<tfoo" x))
(assert (or (= "s" (str.substr z 44 1)) (str.contains (str.replace x "agent" "") "ndrer=""")))
(assert (or (not (= "<ifram  draggable=""true"" ondragenter=""alert(1)"">test</iframe>" (str.replace x "e" " "))) (= "ex" (str.substr x 18 2)) (not (str.suffixof "st</ol>" y))))
(assert (or (not (str.suffixof "t</area>" y)) (str.suffixof "y>" z) (>= (str.len z) 13)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}\-_\.]+@[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}0-9\-_\.]+\.[a-zA-Z\-_\.]{2,10}$"))))
(assert (= (str.at z 3) "y"))
(check-sat)
