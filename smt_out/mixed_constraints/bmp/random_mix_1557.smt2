; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area draggable=""true"" ondragend=""alert(1)"">test</area>") (= x "<progress id=x tabindex=1 onfocusin=alert(1)></progress>")))
(assert (or (= z "ert(1)</script>"">") (= z "ansition:color 10s"" ontransitioncancel=alert(1)></slot>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "1" (str.substr z 45 1))) (not (str.contains (str.replace z "i" "alert(1)") "ansalert(1)tio")) (not (str.contains (str.replace y "r 10" " ") "colo s"" on"))))
(assert (or (not (str.prefixof "<area dr" y)) (str.contains y "gable=""tr")))
(assert (or (not (str.suffixof "a>" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^1(3|4|5|6|7|8|9)\d{9}"))) (not (= (str.indexof x "x" 0) 13))))
(assert (or (str.contains x "gend=""a") (not (= (str.at y 6) ">"))))
(assert (or (= (str.len y) 111) (not (str.prefixof "<area dra" y))))
(assert (= "/area>" (str.substr x 49 7)))
(check-sat)
