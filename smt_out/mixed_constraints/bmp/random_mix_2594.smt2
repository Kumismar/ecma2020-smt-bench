; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@ke\u{20000}yframes x{}</style><q style=""animation-name:x"" onani\u{1f4a9}mationend=""alert(1)""></q>") (= x "<header onbeforepaste=""alert(1)"" contenteditable>test</header>")))
(assert (or (= z "rack>") (= z "script>alert(""XSS"")</script>&") (= z "onbeforeactivate=alert(1)></abbr>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "ame") (str.in_re z ((_ re.from_regex ecma2020) "\d\d\d-\d\d\d-\d\d\d\d$")) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*[a-zA-Z]\s[0-9])[\.\w\s/-]{3,64}")))))
(assert (not (= (str.indexof z "rack" 0) 0)))
(assert (or (not (= (str.indexof x "f" 0) 12)) (not (str.prefixof "r" z))))
(assert (or (not (str.contains x "bef")) (not (= "<style>@ke\u{20000}yframes x{}</style><q style=""animati -name:x"" onani\u{1f4a9}mationend=""alert(1)""></q>" (str.replace x "on" " ")))))
(check-sat)
