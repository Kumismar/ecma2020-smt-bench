; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote id=x tabindex=1 ondeactivate=alert(1)></blockquote><input id=y autofocus>") (= x "<style>@keyframes x{}</style><del style=""animation-name:x"" onanimationstart=""alert(1)""></del>")))
(assert (or (= z "textmenu=""alert(1)"">test</body>") (= z "t</map>") (= z "onfocusin=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "ert(1)>" z)))
(assert (not (= "<style>@keyframes x{}</style><del style=""animation-name:x"" onanimationstart=""""rt(1)""></del>textmenu=""alert(1)"">test</body>" (str.replace y "ale" """"))))
(assert (or (str.contains (str.replace z "xtme" "") "tenu=""") (str.contains x "x0Dcript:")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\S)+[ ]?(\S)+[ ]?(\S)+$"))) (>= (str.len y) 113)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\x20-\x7E]+$"))) (str.in_re x ((_ re.from_regex ecma2020) "^(13)$")) (not (str.suffixof ";\\"")\"";" x))))
(assert (or (= (str.at y 42) "l") (= "sin=ale" (str.substr z 6 7))))
(assert (not (str.prefixof "<style>@ke" x)))
(check-sat)
