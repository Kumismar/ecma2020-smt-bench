; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark draggable=""true"" ondragleave=""alert(1)"">test</mark>") (= x "&lt;A HREF=&quot;http://66.102.7.147/&quot;&gt;XSS&lt;/A&gt;") (= x "<style>:target {color: red;}</style><em id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></em>")))
(assert (or (= z "acking);""/>") (= z "progress onmouseup=""alert(1)"">test</progress>") (= z "/onerror=\x09javascript:alert(1)\x09src=xxx:x />")))
(assert (= y (str.++ x z)))
(assert (not (= "&lt;A HREF=&quot;http:/""102.7.147/&quot;&gt;XSS&lt;/A&gt;acking);""/>" (str.replace y "/66." """"))))
(assert (str.contains (str.replace y ";&" """") "uot""gt;X"))
(assert (>= (str.len z) 11))
(assert (= (str.len y) 68))
(assert (= (str.at x 25) "d"))
(assert (str.contains y "&quo"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*[a-zA-Z])[A-Za-z0-9]{4,64}$"))) (not (= "yle>:targe" (str.substr x 3 10)))))
(assert (or (not (= "S&lt;/A" (str.substr x 49 7))) (not (str.suffixof "ark>" x))))
(assert (or (not (= "HREF=&quo" (str.substr y 6 9))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9]{4,20}$")))))
(assert (= (str.at y 36) "a"))
(check-sat)
