; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter onkeypress=""alert(1)"" contenteditable>test</meter>") (= x "<select oncontextmenu=""alert(1)"">test</select>") (= x "&lt;IMG SRC=JaVaScRiPt&#058;alert('XSS')&gt;")))
(assert (or (= z "est</font>") (= z "lert(1)></bdo>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 20) "l") (not (str.suffixof "est</font>" z))))
(assert (or (str.contains y "edita") (not (str.prefixof "&lt;IMG" y)) (not (str.contains y "ct>est<"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-a-z]+@[a-z0-9.-]+\.[a-z]{2,9}$"))))
(assert (<= (str.len z) 12))
(assert (not (str.contains x "58;a")))
(check-sat)
