; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<obj\u{20000}ect data=data:text/html;base64,PHN2Zy9vbmxvYWQ9YWxlcnQoMik+></object>") (= x "<iframe src=j&Tab;a&Tab;v&Tab;a&Tab;s&Tab;c&Tab;r&Tab;i&Tab;p&Tab;t&Tab;:a&Tab;l&Tab;e&Tab;r&Tab;t&Tab;%28&Tab;1&Tab;%29></iframe>") (= x "<applet onfocusout=alert(1) tabindex=1 id=x></applet><input autofocus>")))
(assert (or (= z "ath><brute href=javascript:alert(1)>click") (= z "dragend=""alert(1)"">test</br>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "t(1)>click" y) (= (str.at x 87) "T") (not (str.in_re x ((_ re.from_regex ecma2020) "^[\x00-\x7f]+@[\x00-\x7f]+$")))))
(assert (or (str.contains z "vasc") (not (>= (str.len y) 170)) (= (str.at x 37) "1")))
(assert (or (not (= (str.indexof x "k+>" 0) 62)) (not (str.suffixof "rt(1)""/>?" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[_\.0-9a-z-]+@([0-9a-z][0-9a-z-]+\.)+[a-z]{1,20}$")))))
(assert (or (not (str.contains (str.replace z "t</b" "x") "sxr")) (not (str.in_re y ((_ re.from_regex ecma2020) "[\-0-9,()xX/ ]+")))))
(check-sat)
