; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<center onbeforecut=""alert(1)"" contenteditable>test</center>") (= x "<bdo oncontextmenu=""alert(1)"">test</bdo>")))
(assert (or (= z "ext/javascript"">javascript:alert(1);</STYLE>") (= z "n=""alert(1)"" contenteditable>test</output>") (= z "deactivate=alert(1)></slot><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z """" 0) 14) (not (str.contains y "ented"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9-_\.]{6,20}$"))) (= (str.indexof z "va" 0) 6)))
(assert (or (str.contains z "est</hgro") (not (str.suffixof "st</bdo>" x))))
(assert (str.suffixof ">" z))
(assert (= (str.at y 4) " "))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}"))))
(check-sat)
