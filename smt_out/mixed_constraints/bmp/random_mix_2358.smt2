; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc draggable=""true"" ondragenter=""alert(1)"">test</rtc>") (= x "<progress onkeypress=""alert(1)"" contenteditable>test</progress>") (= x "<image oncut=""alert(1)"" contenteditable>test</image>")))
(assert (or (= z "start=""alert(1)"">test</section>") (= z "t>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<prog" y)))
(assert (or (not (str.contains z "t>")) (= "/image>" (str.substr x 45 10))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z-\s]+$")))
(assert (or (= (str.len z) 2) (>= (str.len y) 77)))
(assert (or (not (<= (str.len y) 93)) (not (= "t>" (str.substr z 0 6)))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^([1-9][0-9]*)$"))))
(assert (or (= "<b>>" (str.replace z "t" "<b>")) (not (str.in_re y ((_ re.from_regex ecma2020) "((?=.*[a-zA-Z0-9]).{6,})")))))
(check-sat)
