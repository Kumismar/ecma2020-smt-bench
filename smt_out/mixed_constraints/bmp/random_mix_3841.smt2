; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><blink id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></blink>") (= x "<x o%6Exxx=1") (= x "';';;!--"";<;XSS>;=&;{()}")))
(assert (or (= z "down=""alert(1)"" contenteditable>test</h1>") (= z "nxxx=1")))
(assert (= y (str.++ x z)))
(assert (str.contains x "s"" ontrans"))
(assert (or (not (str.contains (str.replace y " " "alert(1)") "t(1)""alert(1)con")) (not (<= (str.len z) 49)) (>= (str.len z) 4)))
(assert (or (not (<= (str.len x) 20)) (str.contains (str.replace y "k>do" """") "in""w") (not (str.prefixof "<x o%6" x))))
(assert (= "{()}" (str.substr x 20 10)))
(assert (str.prefixof "d" z))
(assert (or (not (str.contains (str.replace x "ar" """") ">:t""g")) (not (= "/h1>" (str.substr z 37 7)))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "(0[1-9]|1[012])[- \/.](0[1-9]|[12][0-9]|3[01])[- \/.](19|20)\d\d")) (= "()}" (str.substr x 21 5)) (str.prefixof "<style" y)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^(0?[1-9]|1[012])[/-]?(0?[1-9]|[12][0-9]|3[01])$")))
(check-sat)
