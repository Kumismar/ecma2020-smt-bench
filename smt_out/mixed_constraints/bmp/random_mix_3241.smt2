; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><s id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></s>") (= x "<shadow draggable=""true"" ondragstart=""alert(1)"">test</shadow>")))
(assert (or (= z "aram onmousemove=""alert(1)"">test</param>") (= z "t(1)"">test</base>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<shadow dr" y)) (= (str.at y 83) "o") (= (str.at z 2) "a")))
(assert (or (not (= (str.at x 84) "n")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6,20}$"))) (= "<input id" (str.substr x 50 9))))
(assert (= (str.indexof z "t</b" 0) 9))
(assert (or (not (= "b" (str.substr x 14 1))) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=^.{8,}$)((?=.*\\d)|(?=.*\\W+))(?![.\\n])(?=.*[A-Z])(?=.*[a-z]).*$")))))
(check-sat)
