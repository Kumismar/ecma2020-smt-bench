; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div/style=""width:expression(confirm(1))"">X</div> {IE7}") (= x "<IMG SRC=x onerror=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "vascript:alert(1)</script>") (= z """true"" ondrag=""alert(1)"">test</noembed>") (= z "1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w\p{L}\p{N}\p{Pd}\s]*$"))) (not (str.contains x "</div> {IE"))))
(assert (not (= "/" (str.substr y 88 1))))
(assert (str.contains (str.replace y "har" """") "omC""Cod"))
(assert (= "eight=" (str.substr y 88 6)))
(assert (= "tyle=" (str.substr x 6 5)))
(assert (or (not (= (str.indexof z "</" 0) 7)) (str.contains (str.replace y "t</a>" "") "tes")))
(assert (or (not (>= (str.len y) 72)) (not (= (str.indexof z "<" 0) 7))))
(assert (str.suffixof ">" z))
(check-sat)
