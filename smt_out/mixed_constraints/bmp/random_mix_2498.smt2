; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table onkeyup=""alert(1)"" contenteditable>test</table>") (= x "<area ondblclick=""alert(1)"">test</area>")))
(assert (or (= z "mg src=x onerror=javascript:alert(('A'))>") (= z "/embed>") (= z "put onmouseup=""alert(1)"">test</input>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<" x) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z]{4,20}$")))))
(assert (or (= (str.indexof z "b" 0) 3) (not (= (str.indexof y "sta" 0) 30))))
(assert (or (not (= (str.indexof x "ndblc" 0) 9)) (str.in_re z ((_ re.from_regex ecma2020) "((^|$)(0[0-9]{5,9}|3[0-9]{8,9}))$"))))
(assert (or (not (= (str.at z 10) "n")) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{1,12}$")))))
(assert (or (= "<table onkeyup=""al )"" contenteditable>test</table>mg src=x onerror=javascript:alert(('A'))>" (str.replace y "ert(1" " ")) (not (= "test<" (str.substr z 25 5)))))
(assert (not (>= (str.len x) 48)))
(assert (or (not (str.contains (str.replace z "e" "javascript:") "/javascript:mbed>")) (not (str.contains y "k=""alert"))))
(check-sat)
