; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen id=x onfocus=alert(1)>") (= x "<object data=/ onload=alert(1)>")))
(assert (or (= z " tabindex=1 onfocus=alert(1)></colgroup>") (= z "ad=alert(1)></dl>") (= z ")"">test</command>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "di" (str.substr x 39 2))) (= (str.indexof x "oa" 0) 18)))
(assert (or (not (= (str.indexof y "lert(" 0) 23)) (not (str.contains x "cus=a"))))
(assert (not (= (str.indexof x "ect" 0) 4)))
(assert (or (= ")>" (str.substr x 29 9)) (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9]{6,})$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "20$")))))
(assert (or (not (str.prefixof "<ob" x)) (str.contains y "nfo")))
(assert (or (str.prefixof "<" y) (not (str.suffixof "</dir>" x))))
(check-sat)
