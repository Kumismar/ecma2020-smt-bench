; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><col ondragover=alert(1) contenteditable>drop here</col>") (= x "<embed onclick=""alert(1)"">test</embed>")))
(assert (or (= z "lclick=""alert(1)"">test</i>") (= z ")"">test</acronym>") (= z "index=1 onbeforedeactivate=alert(1)></tt><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<div " y)))
(assert (or (<= (str.len y) 122) (= "=""true"" " (str.substr x 14 8))))
(assert (or (str.contains x "<% ") (str.prefixof ")" z)))
(assert (str.suffixof ">test</i>" y))
(assert (or (not (= (str.at y 19) "e")) (= (str.at z 2) ">")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{1,7}$"))) (= (str.indexof x "(1)"">" 0) 21)))
(assert (or (str.suffixof "d>" x) (not (str.contains (str.replace z "tivat" "alert(1)") "edeacalert(1)e=a"))))
(check-sat)
