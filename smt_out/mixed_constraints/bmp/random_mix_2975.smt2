; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tt onmousedown=""alert(1)"">test</tt>") (= x "<script ="">"" SRC=""http://www.securitycompass.com/xss.js""></script>")))
(assert (or (= z "ntenteditable>test</slot>") (= z "CRIPT =&quot;blah&quot; SRC=&quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;") (= z "r/><hr/>jAvascript:alert('Top Page Location: '+document.location+' Host Page Cookies: '+document.cookie);//<br/><hr/>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]{1}[0-9a-zA-Z]+[\w\.-]+@[\w\.-]+\.\w{2,}$"))) (not (str.contains y "tes"))))
(assert (or (not (= "cript =""" (str.substr x 2 8))) (not (= "<script ="">"" SRC=""http://alert(1)w.securitycompass.com/xss.js""></script>" (str.replace x "ww" "alert(1)")))))
(assert (= "mouse" (str.substr x 6 5)))
(assert (not (= (str.at y 0) "<")))
(assert (or (not (= (str.len y) 121)) (= "kie);" (str.substr z 100 5))))
(check-sat)
