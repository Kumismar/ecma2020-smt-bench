; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onkeydown=""alert(1)"" contenteditable>test</cite>") (= x "<datalist o\u{1d400}n\u{1f4a9}mouseup=""alert(1)"">test</datalist>") (= x "<textarea draggable=""true"" ondragend=""alert(1)"">test</textarea>")))
(assert (or (= z " SRC=javascript:javascript:alert(1)>") (= z "ert(1)""></b>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*[a-z])(?=.*[A-Z]).{8,64}"))) (= (str.indexof y "t(1)""" 0) 27) (not (str.suffixof "/b>" y))))
(assert (or (= "<textarea draggable=""true"" ondragend=""alejavascript:)"">test</textarea>" (str.replace x "rt(1" "javascript:")) (>= (str.len y) 83)))
(assert (or (not (str.contains x "est</d")) (not (str.contains (str.replace z "g" "<b>") "9;&<b>t;")) (= (str.at y 13) "b")))
(assert (or (not (str.suffixof "t(1)""></b>" z)) (not (= (str.at x 37) """"))))
(assert (str.contains x "te onkeyd"))
(check-sat)
