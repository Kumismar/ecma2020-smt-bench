; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog oncopy=""alert(1)"" contenteditable>test</dialog>") (= x "<tbody draggable=""true"" ondragend=""alert(1)"">test</tbody>") (= x "<frameset><frame id=x onfocusin=alert(1)>")))
(assert (or (= z "log>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (= "<frames" (str.substr x 0 7)))
(assert (not (= (str.at z 3) ">")))
(assert (not (= (str.at y 7) " ")))
(assert (not (= (str.indexof y "d=x o" 0) 18)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-z0-9\+_\-]+)(\.[a-z0-9\+_\-]+)*@([a-z0-9\-]+\.)+[a-z]{2,6}$"))) (str.suffixof "lert(1)>" x) (str.suffixof ">" z)))
(assert (str.prefixof "<" y))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[_A-z0-9._%+-]+@[_A-z0-9.-]+\.[_A-z]{1,}$")))
(assert (or (str.prefixof ">" z) (not (str.suffixof "log>" z))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[+0-9]{1,}$")))
(check-sat)
