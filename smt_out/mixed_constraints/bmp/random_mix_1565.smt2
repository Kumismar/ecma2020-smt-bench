; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x onxxx%3D1") (= x "<svg>\u{1d400}<dir onload=\u{1f4a9}alert(1)></dir>")))
(assert (or (= z "><ins ondragover=alert(1) contenteditable>drop here</ins>") (= z "tabindex=1 id=x></q><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "onxxx" 0) 3))
(assert (= (str.indexof y "d" 0) 7))
(assert (not (str.prefixof "<svg>\u{1d400}" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(?!Last Name|last name|LAST NAME)[a-zA-Z][a-zA-Z ]+"))) (= (str.at x 5) " ") (= "<div draggable=""true"" contenteditable>drag me</div><tbody ondragover=alert(1) contenteditable>drop here</tbody>forecopy=""al\u{10348}ert(1 ntenteditable>tes\u{10348}t</form>" (str.replace y ")"" co" " "))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$"))))
(assert (= (str.at x 3) "g"))
(assert (or (not (str.suffixof "/dir>" x)) (not (= "ation-name:x"" onanimationstart=""alert(1javascript:col>" (str.replace z ")""></" "javascript:"))) (not (= (str.at z 29) "t"))))
(assert (or (>= (str.len z) 26) (not (= (str.indexof x "asef" 0) 2))))
(check-sat)
