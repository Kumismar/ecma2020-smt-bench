; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><samp ondrop=alert(1) contenteditable>drop here</samp>") (= x "<details onmousedown=""alert(1)"">test</details>") (= x "<select onmouseup=""alert(1)"">test</select>")))
(assert (or (= z "id=x tabindex=1 onactivate=alert(1)></xmp>") (= z """>test</rb>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "te") (str.suffixof "tails>" x) (= (str.at x 34) "s")))
(assert (or (= (str.len y) 84) (str.contains x "alert(1)"">")))
(assert (or (not (= "ouseup=""" (str.substr x 11 8))) (= (str.at y 30) "o")))
(assert (or (str.suffixof "st</rb>" z) (not (str.suffixof "rb>" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "\d\d\d \d\d\d-\d\d\d\d$")))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[+\-()\s0-9]{7,}$")))
(check-sat)
