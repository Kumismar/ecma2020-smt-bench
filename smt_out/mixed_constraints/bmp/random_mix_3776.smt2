; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><font id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></font>") (= x "<marquee onmouseenter=""alert(1)"">test</marquee>") (= x "<style>:target {color:red;}</style><xmp id=x style=""transition:color 1s"" ontransitionend=alert(1)></xmp>")))
(assert (or (= z "eenter=""alert(1)"">test</span>") (= z "G SRC=java\0script:alert(\""XSS\"")>\"";' > out")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "C" 0) 4)))
(assert (or (not (= (str.indexof y " i" 0) 39)) (not (= (str.at x 17) "n"))))
(assert (not (str.prefixof "eenter=""al" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[-A-Za-z0-9_]+[-A-Za-z0-9_.]*[@]{1}[-A-Za-z0-9_]+[-A-Za-z0-9_.]*[.]{1}[A-Za-z]{2,5}$"))))
(assert (str.contains (str.replace z "pacer" "x") "x>"))
(assert (or (= (str.at x 54) "n") (str.suffixof "out" y) (str.contains z ")"">test<")))
(assert (not (str.suffixof "n>" z)))
(assert (= (str.len x) 126))
(assert (or (not (str.prefixof "<base" y)) (= "ansition:" (str.substr x 71 9))))
(assert (or (not (= "eent" (str.substr z 0 4))) (not (str.in_re y ((_ re.from_regex ecma2020) "^.{4,64}$")))))
(check-sat)
