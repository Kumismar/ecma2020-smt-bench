; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame onkeypress=""alert(1)"" contenteditable>test</frame>") (= x "<code id=x tabindex=1 onbeforeactivate=alert(1)></code>")))
(assert (or (= z "e(true) alert('XSS');"">") (= z "able>drag me</div><object ondragover=alert(1) contenteditable>drop here</object>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "cus>" x) (not (str.in_re x ((_ re.from_regex ecma2020) "(?!\s+)\D{1,19}\S")))))
(assert (not (str.prefixof "able>" z)))
(assert (or (not (= (str.at y 13) "r")) (= (str.at y 41) "e")))
(assert (or (not (= "e(true) alert('XSS<b>>" (str.replace z "');""" "<b>"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9A-Za-z-_.,@+*;:#$%&/\\w]+$")))))
(assert (not (<= (str.len z) 25)))
(assert (or (not (= (str.at x 55) "e")) (>= (str.len x) 47) (str.contains (str.replace x """>te" "javascript:") "(1)javascript:s")))
(check-sat)
