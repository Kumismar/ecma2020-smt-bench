; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<audio draggable=""true"" ondragenter=""alert(1)"">test</audio>") (= x "<script src=""data:text/javascript,alert(1)""></script>")))
(assert (or (= z "tr>") (= z "e=""transition:color 10s"" ontransitioncancel=alert(1)></article>") (= z "te>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<scr" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z][a-zA-Z0-9]{5,19}$")))))
(assert (= "tr>" (str.substr z 0 3)))
(assert (or (= (str.indexof y "l" 0) 35) (= (str.indexof z "te" 0) 0) (str.suffixof "cle>" y)))
(assert (or (not (<= (str.len y) 123)) (str.contains (str.replace z "83" "") "e(88,,8") (not (= (str.indexof x " " 0) 6))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "(^\d{5}$)|(^\d{5}-\d{4}$)")) (= (str.at z 2) ">")))
(check-sat)
