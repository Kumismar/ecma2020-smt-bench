; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menu onbeforecopy=""alert(1)"" contenteditable>test</menu>") (= x "<body onunhandledrejection=alert(1)><script>fetch('//xyz')</script>") (= x "<ins id=x t\u{1f4a9}abindex=1 onfocusin=alert(1)></\u{1d400}ins>")))
(assert (or (= z ">") (= z "meter>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 23) "i")) (not (str.prefixof "<b" y)) (= (str.indexof x "(1)"" " 0) 25)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]\d{6}([a-zA-Z]|\d)$"))) (str.contains y "1 onfo") (not (= (str.at y 27) "u"))))
(assert (not (= (str.indexof x "i" 0) 1)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(05)[0-9][0-9][1-9]([0-9]){6}$"))) (str.contains z "t</") (= "1)"">t" (str.substr x 28 5))))
(assert (not (= "r>" (str.substr z 4 2))))
(check-sat)
