; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x ondragstart=""alert(String.from\u{20000}CharCode(88,83,83))"">") (= x "<div draggable=""true"" contenteditable>drag me</div><table ondragover=alert(1) contenteditable>drop here</table>") (= x "<SCRIPT>a=/XSS/")))
(assert (or (= z "tyle><output id=x style=""transition:color 10s"" ontransitioncancel=alert(1\u{1d400})></output>") (= z "le=""animation-name:x"" onanimationstart=""alert(1)""></footer>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "83))"">" x)))
(assert (or (str.contains x "gable=") (= (str.indexof y "i" 0) 21)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^18$"))) (not (str.contains (str.replace x "ing" "alert(1)") "ralert(1).f")) (<= (str.len z) 94)))
(assert (or (not (str.contains z """></foote")) (= (str.at x 23) """")))
(assert (or (not (= "rt(1\u{1d400})></o" (str.substr z 69 10))) (= (str.at y 4) "o")))
(check-sat)
