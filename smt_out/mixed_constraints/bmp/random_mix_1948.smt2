; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist oncopy=""alert(1)"" contenteditable>test</datalist>") (= x "<address id=x tabind\u{1f600}ex=1 ondeactivate=alert(1)\u{20000}></address><input id=y autofocus>")))
(assert (or (= z "r id=x tabindex=1 onfocusin=alert(1)></dir>") (= z "lert(1)"">test</head\u{1f600}>") (= z "mousemove=""alert(1)"">test</button>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^.{5,20}$"))) (not (= "ascript:j" (str.substr y 35 9)))))
(assert (or (not (str.prefixof "<da" x)) (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z]{1,11}"))))
(assert (or (not (str.suffixof "ton>" y)) (not (str.prefixof "<" x))))
(assert (not (str.contains (str.replace y "st>le" "alert(1)") "alialert(1)rt(")))
(assert (= (str.at z 6) " "))
(check-sat)
