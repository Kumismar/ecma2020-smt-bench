; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter onpaste=""alert(1)"" contenteditable>test</meter>") (= x "%253cscript%253ealert(document.cookie)%253c/script%253e") (= x "<div draggable=""true"" contenteditable>drag me</div><img ondragover=alert(1) contenteditable>drop here</img>")))
(assert (or (= z ";alert('XSS');//") (= z "ndex=1 onfocus=alert(1)></kbd>") (= z "1)></fieldset>")))
(assert (= y (str.++ x z)))
(assert (or (= "%253e" (str.substr x 50 9)) (not (str.contains (str.replace y " here" "<b>") "drop<b></im"))))
(assert (str.contains z "SS');//"))
(assert (or (str.contains y "te=""alert") (str.in_re x ((_ re.from_regex ecma2020) "(\+[0-9]{1,3}){0,1}[0-9]{1,14}")) (not (= "x=1 onfocu" (str.substr z 3 10)))))
(assert (= ";alert('X" (str.substr z 0 9)))
(assert (or (not (str.contains x "itable>dr")) (str.in_re z ((_ re.from_regex ecma2020) "^0\d{1,3}-\d{7,8}(#\d+)?"))))
(assert (or (not (str.suffixof "SS');//" z)) (>= (str.len z) 25) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]*$")))))
(assert (or (not (= "<image src validimage.png onloadend=alert(1)>" (str.replace x "=" " "))) (str.prefixof "1)></fi" z)))
(check-sat)
