; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base oncut=""alert(1)"" contenteditable>test</base>") (= x "<\u{10348}vid\u{1f4a9}eo autoplay onplay=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>")))
(assert (or (= z "RIPT>PT\u{10348} SRC=""http://www.securitycompass.com/xss.js""></script>") (= z " contenteditable>test</track>") (= z "seout=""alert(1)"">test</th>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "d" "x") "entexita")) (str.suffixof "script>" y) (not (<= (str.len y) 122))))
(assert (or (not (= (str.at z 5) "P")) (= "<\u{10348}vid\u{1f4a9}eo autoplay onplay=alert(1)><source src=""validvideo.xtype=""video/mp4""></video> contenteditable>test</track>" (str.replace y "mp4"" " "x")) (= "ontented" (str.substr y 90 8))))
(assert (or (<= (str.len x) 52) (not (= "st</ba" (str.substr y 41 6))) (not (= (str.at y 94) "T"))))
(assert (= (str.len y) 117))
(assert (or (not (= (str.at x 5) " ")) (not (= (str.indexof z "t" 0) 4))))
(assert (not (= "t</track>" (str.substr y 70 9))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{1})$"))))
(check-sat)
