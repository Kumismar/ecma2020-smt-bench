; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT&gt;alert(String.fromCharCode(88,83,83))&lt;/SCRIPT&gt;") (= x "<title onmousemove=""alert(1)"">test</title>")))
(assert (or (= z "tenteditable>drop here</dialog>") (= z "%0Conxxx=1")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x ")&lt;/") (not (str.suffixof "g>" y)) (str.suffixof "alog>" z)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{3,4}$")))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^\+[0-9]\s\([0-9]{3}\)\s[0-9]{3}[-][0-9]{2}[-][0-9]{2}$")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[0-9-/+s()]*$")) (= (str.len y) 73) (>= (str.len z) 51)))
(check-sat)
