; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src/onerror=alert(1)>") (= x "<div draggable=""true"" contenteditable>drag me</div><link ondrop=alert(1) content\u{1f4a9}editable>drop here</link>") (= x "<summary id=x tabindex=1 onbeforedeactivate=alert(1)></summary><input autofocus>")))
(assert (or (= z "sin=alert(1)>") (= z "pt>javascript:alert(1)</script>") (= z """ contenteditable>drag me</div><input ondragover=alert(1) contenteditable>drop here</input>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 2) ">") (not (str.suffixof "cript>" z)) (= (str.indexof y "table" 0) 32)))
(assert (or (not (str.contains z "er=")) (str.contains (str.replace x "src/o" "alert(1)") "mg alert(1)ner")))
(assert (or (str.contains y "k=") (str.prefixof "<div" x) (not (str.in_re y ((_ re.from_regex ecma2020) "^(06[0-9]{7,8})$")))))
(assert (or (str.contains y "iv drag") (= " aut" (str.substr x 69 4))))
(assert (= (str.indexof z "rt" 0) 7))
(check-sat)
