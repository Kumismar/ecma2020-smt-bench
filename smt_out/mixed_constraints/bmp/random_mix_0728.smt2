; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<template onblur=alert(1) tabindex=1 id=x></template><input autofocus>") (= x "<footer id=x tabindex=1 onfocusin=alert(1)></footer>") (= x "<IMG SRC=x onplay=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z " onmouseup=""alert(1)"">test</samp>") (= z "t</progress>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]+$"))) (= (str.len x) 52) (str.in_re z ((_ re.from_regex ecma2020) "^.{6}$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"))))
(assert (not (str.suffixof "focus>" x)))
(assert (or (= "<footer id=x tabi =1 onfocusin=alert(1)></footer> onmouseup=""alert(1)"">test</samp>" (str.replace y "ndex" " ")) (not (= "mCharC" (str.substr y 35 6))) (= "mp" (str.substr z 30 2))))
(assert (or (str.contains x "e><inpu") (= (str.indexof z "sa" 0) 28) (str.prefixof "<IMG " x)))
(assert (>= (str.len z) 30))
(check-sat)
