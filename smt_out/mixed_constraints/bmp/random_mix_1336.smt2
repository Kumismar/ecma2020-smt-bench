; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hgr\u{20000}oup onmouseenter=""alert(1\u{1f4a9})"">test</hgroup>") (= x "<del id=x tabindex=1 ondeacti\u{20000}vate=alert(1)></del><input id=y autofocus>")))
(assert (or (= z "lert(1) contenteditable>drop here</ol>") (= z "ad=alert(1)></acronym>") (= z ")>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z]+\s)*[a-zA-Z]+$"))) (not (= (str.at z 27) "p"))))
(assert (or (not (= (str.indexof x "rou" 0) 42)) (= "cus>" (str.substr x 68 10)) (not (= (str.len y) 110))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9-\s]+$")) (not (= "<txot id=x tabindex=1 onfocusin=alert(1)></tfoot>" (str.replace x "fo" "x"))) (not (= (str.indexof y "<del" 0) 0))))
(assert (or (str.contains y "ondea") (not (str.prefixof "<del id=" x))))
(assert (or (str.suffixof ")>" z) (= (str.indexof y "oup" 0) 5)))
(assert (not (str.contains z ")>")))
(assert (not (str.contains y "imatio")))
(assert (= (str.at z 0) ")"))
(check-sat)
