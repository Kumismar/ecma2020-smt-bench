; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article draggable=""true"" ondragend=""alert(1)"">test</article>") (= x "<b onmouseover=""alert(1)"">test</b>") (= x "<div draggable=""true"" contenteditable>drag me</div><big o\u{1f4a9}ndrop\u{20000}=alert(1) contenteditable>drop here</big>")))
(assert (or (= z "icture draggable=""true"" ondragstart=""alert(1)"">test</picture>") (= z "rack id=x tabindex=1 onbeforedeactivate=alert(1)></track><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 29) "t"))
(assert (or (not (str.contains (str.replace x "ocus" "javascript:") "fjavascript:out=a")) (= "\u{1f4a9}ndrop\u{20000}" (str.substr x 57 7))))
(assert (or (str.suffixof ">" y) (not (str.in_re y ((_ re.from_regex ecma2020) "[2]{1}"))) (not (str.suffixof "utofocus>" y))))
(assert (or (str.suffixof "></tfoot>" y) (not (>= (str.len z) 51))))
(assert (or (str.contains (str.replace x "iva" "alert(1)") "actalert(1)te=al") (= "<div draggable=""true"" contenteditable>drag me</div><big o\u{1f4a9}ndrop\u{20000}=aleralert(1) contenteditable>drop here</big>icture draggable=""true"" ondragstart=""alert(1)"">test</picture>" (str.replace y "t(1)" "alert(1)"))))
(check-sat)
