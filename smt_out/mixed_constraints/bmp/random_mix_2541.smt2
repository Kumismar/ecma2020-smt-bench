; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#X003c;") (= x "<scr<script>ipt>alert(document.cookie)</scr</script>ipt>") (= x "<tt onblur=alert(1) tabindex=1 id=x></tt><input autofocus>")))
(assert (or (= z ";p://6&amp;#09;6.000146.0x7.147/&quot;&gt;XSS&lt;/A&gt;") (= z "nmouseleave=""alert(1)"">test</\u{20000}br>\u{10348}")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{8,10}"))) (str.suffixof "\u{10348}" y) (= " id=x" (str.substr x 30 5))))
(assert (str.suffixof "st</\u{20000}br>\u{10348}" z))
(assert (not (= "aler" (str.substr x 82 4))))
(assert (not (= "<svg><summary  nload=alert(1)></summary>)"" contenteditable>test</blockquote>" (str.replace y "o" " "))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[\w\-\.]+@[\w\-\.]+(\.\w+)+$"))) (not (str.prefixof ";p://6&" z)) (>= (str.len z) 26)))
(assert (or (not (= (str.at y 81) "u")) (not (= (str.indexof z "ck>" 0) 19))))
(assert (= (str.at x 19) "r"))
(check-sat)
