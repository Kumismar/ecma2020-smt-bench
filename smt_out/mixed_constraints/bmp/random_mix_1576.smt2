; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea draggable=""true"" ondrag=""alert(1)"">test</textarea>") (= x "<rt id=x tabindex=1 \u{20000}onfocusi\u{10348}n=alert(1)></rt>") (= x "<nextid onkeydown=""alert(1)"" contenteditable>test</nextid>")))
(assert (or (= z "rag me</div><datalist ondrop=alert(1) contenteditable>drop here</datalist>") (= z "lert(1)"" contenteditable>test</data>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<t" x) (str.prefixof "rag" z)))
(assert (str.suffixof "t</data>" y))
(assert (or (= (str.at y 27) "e") (not (str.contains z "</div><d"))))
(assert (or (= "text" (str.substr x 51 4)) (str.in_re z ((_ re.from_regex ecma2020) "[aA-zZ]{2,12} [aA-zZ]{2,15}")) (= "t ondrop=" (str.substr z 20 9))))
(assert (or (str.contains y "rop") (not (str.in_re y ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[A-Za-z]).{6,}"))) (not (str.suffixof ")></rt>" x))))
(assert (or (not (= (str.indexof x "ags" 0) 26)) (not (str.in_re y ((_ re.from_regex ecma2020) "(?=^.{0,255}$)^\+?(\d[\d\-\.\s]+)?(\([\d\-\.\s]+\))?[\d\-\.\s]+\d$"))) (not (= (str.at z 33) "t"))))
(assert (not (str.prefixof "<texta" x)))
(check-sat)
