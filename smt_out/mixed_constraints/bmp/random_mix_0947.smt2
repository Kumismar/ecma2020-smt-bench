; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure id=x tabindex=1 ondeactivate=alert(1)></figure><input id=y autofocus>") (= x "<nextid onpaste=""alert(1)"" contenteditable>test</nextid>")))
(assert (or (= z "ert(1)></menuitem>") (= z "ntenteditable>test</image>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "item" 0) 13) (str.suffixof "autofocus>" x) (not (str.suffixof "nuitem>" z))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(0?[1-9]|[12][0-9]|3[01])[\/](0?[1-9]|1[012])[/\\/](19|20)\d{2}$"))))
(assert (= (str.at y 21) "="))
(assert (or (str.contains x "xtid onpas") (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z]([a-zA-Z0-9]|[- @_.&])*$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[^@s]+@[^@s]+.[^@s]+$"))))
(check-sat)
