; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG SRC=&quot;javascript:alert(&apos;XSS&apos;);&quot;&gt;") (= x "test")))
(assert (or (= z "/style><style id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></style>") (= z "id=x></template><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len y) 89)))
(assert (not (= "MG SR" (str.substr x 5 5))))
(assert (not (str.contains z "hr")))
(assert (= (str.len y) 120))
(assert (or (not (= "ntransi" (str.substr y 111 7))) (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{407}\u{457}\u{406}\u{456}\u{404}\u{454}\u{490}\u{491}0-9\-\s]{5,60}$"))))
(assert (or (<= (str.len y) 148) (not (= (str.at z 7) "<"))))
(assert (= (str.indexof y """ on" 0) 50))
(check-sat)
