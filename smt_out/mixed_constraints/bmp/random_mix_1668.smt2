; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside draggable=""true"" ondrag=""alert(1)"">test</aside>") (= x "<pre onbeforecopy=""alert(1)"" contenteditable>test</pre>")))
(assert (or (= z "pt:javascript:alert(1)';-o-link-source:current"">X") (= z """alert(1)"">test</listing>") (= z "target {color: red;}</style><bdo id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></bdo>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 20) "1") (not (= "ntedita" (str.substr x 34 7)))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^.*\..{2,}$")) (not (str.contains x "<del onbef"))))
(assert (not (= (str.indexof x "=""a" 0) 40)))
(assert (or (str.suffixof "1)></bdo>" y) (str.contains z "x"" ") (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9._ ]{2,40}")))))
(assert (or (not (>= (str.len z) 1)) (not (str.prefixof "<aside" y))))
(assert (or (str.suffixof "rrent"">X" z) (not (str.prefixof "<pre on" y))))
(check-sat)
