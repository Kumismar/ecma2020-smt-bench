; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onfocusout=alert(1) id=x><iframe id=x>") (= x "<hr onmousemove=""alert(1)"">test</hr>") (= x "<command oncontextmenu=""alert(1)"">test</command>")))
(assert (or (= z "ough=""alert(String.fromCharCode(88,83,83))"">") (= z "tabindex=1 ondeactivate=alert(1)></listing><input id=y autofocus>") (= z "roup>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "tabin" z)) (not (= "rt(1) id" (str.substr x 20 8))) (= "t""bindex=1 ondeactivate=alert(1)></listing><input id=y autofocus>" (str.replace z "a" """"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[\u{3041}-\u{3093}\u{30a1}-\u{30f6}\u{30fc}\s\u{5c}u3000]+$")) (not (str.contains (str.replace x "xt" "alert(1)") "ealert(1)men"))))
(assert (or (str.suffixof "pt>" x) (str.prefixof "<bo" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\u{5c}u4e00-\u{5c}u9eff]{1,40}(\/[A-Za-z\u{5c}u4e00-\u{5c}u9eff]{0,40})?$"))))
(assert (or (not (= (str.indexof x "r" 0) 2)) (not (= "foo<script>alert(1)</s\u{10348}cript>onmouseleave=""alert(1)"">test</f et>" (str.replace y "rames" " ")))))
(assert (not (<= (str.len y) 90)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) ".*^[A-Za-z0-9._]+@[A-Za-z0-9]+[.]+[A-Za-z]{2,5}$.*")) (not (= (str.at x 36) "s"))))
(assert (not (<= (str.len x) 54)))
(check-sat)
