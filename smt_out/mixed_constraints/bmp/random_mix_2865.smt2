; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form action=javascript:alert(1)><input type=submit>") (= x "<! foo=""><scrip\u{10348}t>alert(91)</script>\u{20000}"">")))
(assert (or (= z "onfocus=alert(1)>") (= z "t</datalist>") (= z "validvideo.mp4"" type=""video/mp4""></video>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "(91)" 0) 23))
(assert (str.prefixof "t</datali" z))
(assert (= "r" (str.substr y 21 1)))
(assert (or (not (= (str.len y) 51)) (= ">t</da" (str.substr y 38 6))))
(assert (or (= "=submit>" (str.substr x 44 9)) (not (= (str.at x 3) "r"))))
(assert (str.prefixof "or((i)" z))
(assert (= (str.at x 8) "t"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,40}$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(0|[1-9][0-9]*)$"))) (str.in_re z ((_ re.from_regex ecma2020) "^[\w\-_&.,'`#@!\s]+$")) (not (= (str.at y 24) "a"))))
(assert (str.prefixof "<! foo" y))
(check-sat)
