; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp id=x tabindex=1 onactivate=alert(1)></rp>") (= x "*/</script>'>alert(1)/*<script/1='") (= x "<h1 onclick=""alert(1)"">test</h1>")))
(assert (or (= z """animation-name:x"" onanimationstart=""alert(1)""></ol>") (= z " contenteditable>test</dt>") (= z "u=""alert(1)"">test</col>")))
(assert (= y (str.++ x z)))
(assert (str.contains y "ctivate="))
(assert (or (str.suffixof "tid>" y) (str.prefixof "<style on" x) (= "<h1 oncl" (str.substr x 0 8))))
(assert (not (<= (str.len x) 47)))
(assert (or (not (= (str.indexof x "k=""al" 0) 10)) (= (str.at x 22) "*") (= "</rp>" (str.substr x 40 5))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z][A-Za-z0-9 _,-.'!?]*$"))))
(assert (str.suffixof "st</h1>" x))
(assert (not (str.contains (str.replace z "ale" "x") """xrt(")))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{17}$")))
(assert (not (str.suffixof "</shadow>" x)))
(check-sat)
