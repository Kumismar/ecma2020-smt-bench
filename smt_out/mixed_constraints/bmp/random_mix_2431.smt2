; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form onbeforecut=""alert(1)"" contenteditable>test</form>") (= x "<div draggable=""true"" contenteditable>drag me</div><samp ondragover=alert(1) contenteditable>drop here</samp>")))
(assert (or (= z "ntenteditable>test</body>") (= z "hgroup>") (= z "tr onmouseleave=""alert(1)"">test</tr>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "alert(1) ") (not (= "<del onmousemove=""alert(1)"">xst</del>" (str.replace x "te" "x"))) (= (str.at x 7) "n")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9a-zA-Z]{5,5}"))) (= (str.at x 99) "e") (not (= (str.at x 85) "d"))))
(assert (not (str.contains z "t</b")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9_\u{5c}u00C0-\u{5c}u00D6\u{5c}u00D8-\u{5c}u00F6\u{5c}u00F8-\u{5c}u1FFF]+([-+.']*[A-Za-z0-9_\u{5c}u00C0-\u{5c}u00D6\u{5c}u00D8-\u{5c}u00F6\u{5c}u00F8-\u{5c}u1FFF]+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*$"))) (= (str.len x) 62)))
(assert (not (str.contains y "</")))
(assert (not (str.contains (str.replace y "t" "javascript:") "ble=""javascript:rue")))
(check-sat)
