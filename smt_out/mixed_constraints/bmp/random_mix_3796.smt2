; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onload=alert(1)>") (= x "<div draggable=""true"" contenteditable>drag me</div><xmp ondragover=alert(1) contenteditable>drop here</xmp>")))
(assert (or (= z "><sup onload=alert(1)></sup>") (= z """ ondrag=""alert(1)"">test</var>")))
(assert (= y (str.++ x z)))
(assert (= "<div draggable rue"" contenteditable>drag me</div><xmp ondragover=alert(1) contenteditable>drop here</xmp>" (str.replace x "=""t" " ")))
(assert (or (= "<body on""alert(1)>" (str.replace x "load=" """")) (= (str.indexof y "ert(1" 0) 69)))
(assert (or (not (str.contains z "(1")) (= (str.at y 114) "g")))
(assert (or (not (str.contains (str.replace z "ert" "") "al(1")) (not (str.suffixof "ert(1)>" x))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "$"))) (= (str.len x) 107)))
(assert (not (<= (str.len y) 59)))
(check-sat)
