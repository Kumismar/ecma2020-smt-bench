; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><canvas ondrop=alert(1) contenteditable>drop here</canvas>") (= x "<style>:target {color: red;}</style><frame id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></frame>")))
(assert (or (= z "ring.fromCharCode(88,83,83))"">") (= z "p=""alert(1)"">test</button>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<style>:ta" y)))
(assert (or (= "ring.fromCharCodalert(1),83,83))"">" (str.replace z "e(88" "alert(1)")) (str.prefixof "<style" y) (= (str.at y 67) "o")))
(assert (str.prefixof "<styl" x))
(assert (or (not (= " 10s" (str.substr y 71 4))) (not (= (str.at z 16) "e")) (not (<= (str.len z) 34))))
(assert (not (= (str.indexof z "t<" 0) 43)))
(assert (or (str.contains x "itable") (str.in_re y ((_ re.from_regex ecma2020) "^.+@.+\.[a-z]+$"))))
(assert (or (= (str.at x 45) "=") (str.in_re x ((_ re.from_regex ecma2020) "^[^\._%+-][a-zA-Z0-9._%+-]+[^\._%+-]@[^\._%+-]([a-zA-Z0-9]([.-]?))+[^\._%+-]\.[a-zA-Z]{2,4}$")) (not (= "ion:color " (str.substr y 62 10)))))
(check-sat)
