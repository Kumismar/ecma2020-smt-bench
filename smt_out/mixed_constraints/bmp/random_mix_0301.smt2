; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure draggable=""true"" ondrag=""alert(1)"">test</figure>") (= x "<ol oncontextmenu=""alert(1)"">test</ol>")))
(assert (or (= z "TML&gt;") (= z "1 onfocus=alert(1)></main>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof ">" y)) (not (str.prefixof "TML&gt" z)) (= (str.at z 17) "n")))
(assert (>= (str.len z) 1))
(assert (or (str.suffixof "></main>" y) (str.contains y "mai")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.{5,32}$)(?![_.])(?!.*[_.]{2})[a-zA-Z0-9._]+$"))) (not (= (str.indexof y "gu" 0) 3)) (not (= (str.indexof z "mai" 0) 21))))
(assert (or (str.prefixof "TML&g" z) (= (str.at y 32) """")))
(check-sat)
