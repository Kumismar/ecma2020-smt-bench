; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""125""><?xml version=""1.0""?>") (= x "<<SCRIPT>%(payload)s//<</SCRIPT>")))
(assert (or (= z "us>") (= z """50px"">")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "iv" 0) 2) (not (str.contains (str.replace z "x"">" "javascript:") "0pjavascript:"))))
(assert (= (str.at z 4) "x"))
(assert (or (not (str.contains y "SCRIPT>%(")) (= (str.len z) 7)))
(assert (or (str.prefixof "<div dra" x) (not (<= (str.len y) 46)) (not (= (str.at x 14) "<"))))
(assert (or (str.suffixof "50px"">" z) (not (= "ualert(1)>" (str.replace z "s" "alert(1)"))) (not (= (str.at z 8) "b"))))
(assert (or (not (= (str.indexof z "<in" 0) 2)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[^!@#$&%*+=]+$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z 0-9.,+-]*$")))))
(check-sat)
