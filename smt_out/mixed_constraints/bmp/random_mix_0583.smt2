; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext id=x tabindex=1 onactivate=alert(1)></plaintext>") (= x "<noframes onmouseleave=""alert(1)"">test</noframes>")))
(assert (or (= z "/a>") (= z "ascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "ert(1)></plaintext>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 13) "(") (= "ext>" (str.substr z 15 8)) (not (str.in_re y ((_ re.from_regex ecma2020) "^.*[^\s]+.*$")))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^(#[a-z]+\s*)*#[a-z]+\s*$")))
(assert (not (= (str.at x 43) "(")))
(assert (= (str.indexof x "I" 0) 7))
(assert (or (not (str.contains y "abindex")) (not (str.contains x "1)"">test</"))))
(assert (or (not (= (str.indexof x ")>" 0) 33)) (not (str.suffixof "</a>" z))))
(assert (= (str.at z 2) "t"))
(assert (or (= (str.indexof x "CDAT" 0) 51) (not (str.prefixof "<no" y))))
(check-sat)
