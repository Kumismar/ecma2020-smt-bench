; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<% foo><x foo=""%><script>alert(91)</script>"">//[""'`-->]]>]</div>") (= x "<address onkeydown=""alert(1)"" contenteditable>test</address>")))
(assert (or (= z "i\u{20000}frame onmouseleave=""a\u{1f600}lert(1)"">test</iframe>") (= z "ition:color 10s"" ontransitioncancel=alert(1)></frameset>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 34) "e")) (= "iframe>" (str.substr y 103 7)) (not (str.suffixof ">" y))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z\s]|[\u{e0}-\u{fa}]|[\u{c0}-\u{da}])+$"))))
(assert (or (not (>= (str.len z) 45)) (= " foo><x f" (str.substr x 2 9))))
(assert (or (= (str.at x 11) "k") (str.in_re y ((_ re.from_regex ecma2020) "[0-9. +()]{9,}$")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{1,7}$")))))
(assert (= (str.indexof x " con" 0) 29))
(assert (or (= ":aler" (str.substr y 27 5)) (not (str.contains (str.replace z "c" "x") "on:xolor"))))
(check-sat)
