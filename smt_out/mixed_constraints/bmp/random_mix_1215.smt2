; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""133""><!-- `<img/src=xx:xx onerror=alert(133)//--!>//[""'`-->]]>]</div>") (= x "<iframe/src=""data:text/html;&Tab;base64&Tab;,PGJvZHkgb25sb2FkPWFsZXJ0KDEpPg=="">")))
(assert (or (= z "ipt:alert(1)>") (= z "e>test</slot>") (= z "ransition:transform 2s"" ontransitionrun=alert(1)></hr>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "test</")))
(assert (or (not (str.prefixof "r" z)) (not (str.in_re z ((_ re.from_regex ecma2020) "|^[a-zA-Z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\u{fc}\u{dc}]{3,15}$|"))) (= " on" (str.substr y 34 3))))
(assert (or (= (str.indexof y "g=" 0) 74) (= "slot>" (str.substr z 8 6))))
(assert (or (not (= (str.at y 116) "n")) (str.in_re z ((_ re.from_regex ecma2020) "[0-9a-zA-Z\u{e01}-\u{e59}_-]{3,20}"))))
(check-sat)
