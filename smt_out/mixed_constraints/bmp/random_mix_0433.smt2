; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track oncopy=""alert(1)"" contenteditable>test</track>") (= x "<li onclick=""alert(1)"">test</li>")))
(assert (or (= z "agleave=""alert(1)"">test</base>") (= z "y=""alert(1)"" contenteditable>test</rb>") (= z "ouseout=""aler\u{1f4a9}t(1)"">test</figure>")))
(assert (= y (str.++ x z)))
(assert (or (= "y=""a" (str.substr z 0 4)) (str.contains (str.replace y "e"" on" "x") "ruxdra")))
(assert (not (= "lert(1)"">" (str.substr x 14 9))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9]{1}[0-9]{13}"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^1(3|5|7|8)\d{9}"))) (not (= (str.indexof x "ck>" 0) 50))))
(assert (or (not (= (str.len y) 91)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9 ]*$")))))
(assert (or (not (str.contains y "est</base")) (str.contains x "ert(1)"">te") (not (= (str.at z 2) """"))))
(check-sat)
