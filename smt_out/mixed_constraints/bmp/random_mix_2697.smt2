; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong onmouseup=""alert(1)"">test</strong>") (= x "<element onmouseenter=""alert(1)"">test</element>") (= x "<style>:target {color:red;}</style><content id=x style=""transition:color 1s"" ontransitionend=alert(1)></content>")))
(assert (or (= z "lert(1)"">test</q>") (= z "nd=""alert(1)""></applet>") (= z "e\"" Content=\""USERID=&lt;SC\u{10348}RIPT&gt;alert('XSS')\u{1f600}&lt;/SCRIPT&gt;\""&gt;")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 22) "x") (= (str.at x 48) " ")))
(assert (or (str.contains x "on") (not (str.suffixof "d>" z))))
(assert (or (not (= (str.len z) 23)) (not (= "rong>" (str.substr y 37 5)))))
(assert (or (not (= (str.indexof y "ousee" 0) 12)) (str.contains (str.replace y "'XSS'" """") "t("")\u{1f600}&") (= (str.indexof x "t(" 0) 43)))
(assert (not (str.contains y "\u{10348}RIPT&gt;")))
(assert (not (= "<dd onpaste=""alerjavascript:1)"" contenteditable>test</dd>" (str.replace x "t(" "javascript:"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z]{2,}\s[a-zA-Z]{1,})"))))
(assert (or (= (str.indexof z "ER" 0) 16) (not (= "e alert(1)></hr>" (str.replace z "=" " "))) (str.contains y "src=val")))
(check-sat)
