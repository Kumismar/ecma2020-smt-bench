; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li onbeforecut=""alert(1)"" contenteditable>test</li>") (= x "<video controls autoplay onended=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= x "<rtc ondblcl\u{1d400}ick=""alert(1)"">test</rtc>\u{1f4a9}")))
(assert (or (= z "up=""alert(1)"" contenteditable>test</del>") (= z "(1)"">test</dt>") (= z "a>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace x "dvi" "<b>") "vali<b>d")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[\.\-_A-Za-z0-9]+?@[\.\-A-Za-z0-9]+?[\.A-Za-z0-9]{2,}"))) (not (str.in_re z ((_ re.from_regex ecma2020) "cover"))) (not (= (str.indexof z ">" 0) 1))))
(assert (or (= (str.indexof x "t(1)" 0) 21) (<= (str.len x) 111) (str.contains x "cl\u{1d400}ick=""al")))
(assert (not (str.suffixof "est</li>" x)))
(check-sat)
