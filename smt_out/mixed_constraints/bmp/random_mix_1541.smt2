; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=validimage.png onloadstart=alert(1)>") (= x "<noscript onpaste=""alert(1)"" contenteditable>test</noscript>")))
(assert (or (= z "yle><shadow style=""animation-name:x"" onanimationend=""alert(1)""></shadow>") (= z "3.org/2001/xml-events"" ev:event=""load"">alert(94)</handler>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "andler" (str.substr y 111 6))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6}$")))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9\s]{1,32}$")) (= "lert(" (str.substr y 114 5)) (= "dima" (str.substr x 13 4))))
(assert (or (str.contains z "load""") (str.contains (str.replace z "/b" " ") "(1)>< r>") (str.prefixof "<s" y)))
(assert (str.contains (str.replace x "t=a" "javascript:") "starjavascript:lert("))
(check-sat)
