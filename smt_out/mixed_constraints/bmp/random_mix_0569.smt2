; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd onmouseout=""alert(1)"">test</kbd>") (= x "<figure onkeyup=""alert(1)"" contenteditable>test</figure>")))
(assert (or (= z "t</u>") (= z "ipt>alert(document.cookie)</script>") (= z "by draggable=""true"" ondragenter=""alert(1)"">test</ruby>")))
(assert (= y (str.++ x z)))
(assert (or (= "r=""alert(1" (str.substr y 67 10)) (= (str.indexof x "c" 0) 27) (not (= (str.indexof x "e=al" 0) 30))))
(assert (or (not (= (str.at y 18) "l")) (not (str.prefixof "by drag" z))))
(assert (or (str.prefixof "ey" z) (not (= "javascript:" (str.replace z "t</u>" "javascript:")))))
(assert (or (= (str.at x 33) "k") (= "<kbd onmouseout=""alert(1)"">test<xd>" (str.replace x "/kb" "x"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9-_\.]{6,}$"))) (str.contains z "/u") (str.prefixof "<" y)))
(check-sat)
