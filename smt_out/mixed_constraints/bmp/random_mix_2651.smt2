; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead onbeforecopy=""alert(1)"" contenteditable>test</thead>") (= x "&lt;BR SIZE=&quot;&amp;{alert(&apos;XSS&apos;)}&quot;&gt;")))
(assert (or (= z "o onmouseover=""alert(1)"">test</video>") (= z "')"">") (= z "e onblur=alert(1) tabindex=1 id=x></code><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "onblur=ale" (str.substr y 61 10)) (str.prefixof "1)"">test" z) (str.prefixof "&lt;B" y)))
(assert (or (not (= (str.at x 23) "e")) (str.contains x "quot")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z]{3,}(?: [a-zA-Z]+){0,2}$"))) (not (= ">test" (str.substr y 83 5)))))
(assert (or (not (>= (str.len y) 113)) (str.prefixof "<the" x)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(1|2)[0-9]{3}$"))))
(assert (str.contains y "=alert(1)"))
(check-sat)
