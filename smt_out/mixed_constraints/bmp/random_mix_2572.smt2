; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex oncopy=""alert(1)"" contenteditable>test</isindex>") (= x "<div draggable=""true"" contenteditable>drag me</div><title ondrop=alert(1) contenteditable>drop here</title>") (= x "&lt;DIV STYLE=&quot;background-image: url(javascript:alert(&apos;XSS&apos;))&quot;&gt;")))
(assert (or (= z "ouseout=""alert(1)"">test</svg>") (= z "1)"" contenteditable>test</listing>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(0[1-9]|1[012])[\/](0[1-9]|[12][0-9]|3[01])$"))) (str.prefixof "ndragente" z) (not (str.in_re x ((_ re.from_regex ecma2020) "(?=^.{8,}$)((?=.*\d))((?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$")))))
(assert (= (str.at x 54) "l"))
(assert (or (not (= "in" (str.substr y 3 2))) (= "ert" (str.substr z 24 3))))
(assert (or (= (str.indexof x "gt" 0) 83) (>= (str.len z) 22)))
(assert (or (str.contains z "st</lis") (not (= (str.indexof x "rt(" 0) 68))))
(assert (not (= (str.len x) 86)))
(assert (not (= "e>tes" (str.substr y 41 5))))
(check-sat)
