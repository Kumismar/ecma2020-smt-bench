; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta draggable=""true"" ondragenter=""alert(1)"">test</meta>") (= x "<body onerror=alert(1) onload=/>")))
(assert (or (= z "c=xxx:x \x22onerror=javascript:alert(1)>") (= z "ls onload=alert(1)></details>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9_-]{5,7}"))) (not (str.contains (str.replace z "o" "x") "2xn")) (not (str.contains x "le"))))
(assert (or (not (str.prefixof "<pi" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[789]\d{9,9}$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(?!.*WWW|.*www|.*http|.*HTTP|.*@).*$"))))
(assert (or (str.prefixof "<meta" y) (>= (str.len y) 76)))
(assert (or (str.contains z "nerror=jav") (>= (str.len x) 47) (not (= "e=""tru" (str.substr x 14 6)))))
(check-sat)
