; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src/onerror=alert(1)>") (= x "<marquee onstart='javascript:alert&#x28;1&#x29;'>^__^") (= x "<img src=x\x11onerror=""javascript:alert(1)"">")))
(assert (or (= z "nmouseup=""alert(1)"">test</nav>") (= z ")>XSS</textarea>") (= z "pt:document.vulnerable=true;"">")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{6,15}$")) (= "e" (str.substr z 26 1)) (= "<marquee onstart='javascript:alert&#x28;1javascript:;'>^__^" (str.replace x "&#x29" "javascript:"))))
(assert (or (= (str.indexof y "rames" 0) 12) (= (str.indexof y "javas" 0) 18) (>= (str.len y) 75)))
(assert (or (not (str.contains (str.replace x "vasc" "x") "jaxrip")) (not (= (str.at y 30) "r")) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*[0-9].*)(?=.*[A-Z].*)(?=.*[a-z].*).{8,}$")))))
(assert (or (str.suffixof "test</nav>" y) (= "<img src=x\x11one or=""javascript:alert(1)"">" (str.replace x "rr" " "))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"))))
(check-sat)
