; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog draggable=""true"" ondragstart=""alert(1)"">test</dialog>") (= x "<basefont onpaste=""alert(1)"" contenteditable>test</basefont>") (= x "<th id=x tabindex=1 onbeforeactivate=alert(1)></th>")))
(assert (or (= z "vate=alert(1)></xmp>") (= z "pt:alert(1)"">DEF")))
(assert (= y (str.++ x z)))
(assert (or (= " tabi" (str.substr y 8 5)) (not (= "<thid=x tabindex=1 onbeforeactivate=alert(1)></th>" (str.replace x " " ""))) (<= (str.len z) 16)))
(assert (or (str.prefixof "<th id=x t" y) (str.prefixof "<basefo" x) (not (str.contains y """ ondrags"))))
(assert (= "e=""true""" (str.substr y 16 8)))
(assert (or (not (str.prefixof "<d" x)) (str.contains z "e=al")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w-]+$"))) (not (= "pt:alert(1)""><b>" (str.replace z "DEF" "<b>")))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[_a-z0-9-]+(\.[_a-z0-9-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,3})$")) (not (= "colgrou" (str.substr y 33 7))) (= (str.at y 41) "b")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(\d{1,3})(,\d{3})*(\.\d{1,2})?$"))))
(check-sat)
