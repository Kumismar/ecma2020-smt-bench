; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><i ondrop=alert(1) contenteditable>drop here</i>") (= x "<param oncopy=""alert(1)"" contenteditable>test</param>")))
(assert (or (= z "ress>") (= z "ntenteditable>test</address>") (= z "ue"" ondrag=""alert(1)"">test</main>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<style>:target {transform: rotate(""80deg);}</style><details id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></details>(1)"" contenteditable>test</h1>" (str.replace y "1" """"))) (not (str.prefixof "<s" y)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9_]{1,100}$")))))
(assert (not (str.contains (str.replace x "co" "<b>") " on<b>py")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "\([0-9]{2}\) [0-9]{4,6}-[0-9]{3,4}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{6,14}"))) (not (str.contains y "itabl"))))
(assert (or (str.prefixof "r" z) (not (str.contains (str.replace z "ddre" "<b>") "st</a<b>s")) (not (= "ss>" (str.substr z 2 9)))))
(assert (or (not (= (str.at y 92) "e")) (not (str.prefixof "ue"" " z))))
(assert (not (>= (str.len y) 130)))
(check-sat)
