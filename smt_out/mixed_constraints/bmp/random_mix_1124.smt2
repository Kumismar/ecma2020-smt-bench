; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><section id=x style=""transition:color 1s"" ontransitionend=alert(1)></section>") (= x "<script src=""data:text/javascript,alert(1)""></script>") (= x "<samp onm\u{20000}ousemove=""alert(1)"">test</samp>")))
(assert (or (= z "lt;IMG SRC=javascript&#058;alert(&quot;XSS&quot;)&gt;") (= z "t</rb>") (= z ">test</section>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "t</rb>" z) (not (str.prefixof "<style>:t" y)) (= (str.len y) 120)))
(assert (or (not (= (str.at z 2) "/")) (= (str.indexof x "t(1" 0) 38)))
(assert (or (not (str.contains y "ert(")) (not (= (str.at z 3) "r")) (str.in_re z ((_ re.from_regex ecma2020) "[+]{1}[7]{1}\s[(]{1}[9]{1}[0-9]{2}[)]{1}\s[0-9]{3}\s[0-9]{2}[-]{1}[0-9]{2}"))))
(assert (not (str.prefixof "<samp" x)))
(assert (not (str.contains y "t</sect")))
(check-sat)
