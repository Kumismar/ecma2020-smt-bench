; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del oncopy=""alert(1)"" contenteditable>test</del>") (= x "<basefont oncopy=""alert(1)"" contenteditable>test</basefont>") (= x "<dfn draggable=""true"" ondragenter=""alert(1)"">test</dfn>")))
(assert (or (= z "nload=aler\u{20000}t(1)></label>") (= z "pt:alert(1)//]> -->") (= z "est</acronym>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\s\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$"))))
(assert (or (not (str.contains z "be")) (not (str.contains x "ntentedita")) (str.suffixof "abel>" z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(https?:\/\/)?((?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61})?)?[A-Za-z0-9]\\.)*[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z]{2,})?(\.[a-zA-Z]{2,})?\.[a-zA-Z]{2,}\/?(:[0-9]{1,5})?$")) (= "crony" (str.substr z 6 5)) (not (str.in_re z ((_ re.from_regex ecma2020) "^([\u{5c}u30A1-\u{5c}u30FC|\u{5c}u3000]+)$")))))
(assert (or (not (= (str.indexof x " dra" 0) 4)) (= (str.at z 26) "v") (not (= (str.len x) 55))))
(check-sat)
