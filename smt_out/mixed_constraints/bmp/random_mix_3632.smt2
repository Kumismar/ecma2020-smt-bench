; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u id=x tabindex=1 ondeactivate=alert(1)></u><input id=y autofocus>") (= x "<a\u{10348}cronym draggable=""tr\u{1d400}ue"" ondrag=""alert(1)"">test</acronym>") (= x "<listing oncopy=""alert(1)"" contenteditable>test</listing>")))
(assert (or (= z "ndex=1 onfocus=alert(1)></basefont>") (= z "p ondblclick=""alert(1)"">test</optgroup>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "ting>" x)))
(assert (or (= (str.at x 35) "r") (not (str.contains (str.replace x "ndex=" "<b>") "tabi<b>1 o"))))
(assert (or (>= (str.len x) 60) (= (str.at x 26) "i") (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\s]+$")))))
(assert (or (str.contains (str.replace x "ex" "<b>") "abind<b>=1 ") (not (= (str.indexof x " id=y" 0) 51)) (not (str.suffixof "font>" y))))
(assert (or (not (= (str.at z 0) "n")) (str.suffixof "g>" x)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(^0$|^[1-9]\d{1,5}$)"))) (not (<= (str.len y) 72))))
(check-sat)
