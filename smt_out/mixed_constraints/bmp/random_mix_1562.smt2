(assert (or (not (= (str.indexof z "i" 0) 21)) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*?[\u{5c}u30A1-\u{5c}u30FC])[\u{5c}u30A1-\u{5c}u30FC\s]*"))) (str.suffixof "ins>" z)))
