(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><form ondrop=alert(1) contenteditable>drop here</form>") (= x "<label id=x tabindex=1 ondeactivate=alert(1)></label><input id=y autofocus>") (= x "<ruby id=x tabindex=1 ondeactivate=alert(1)></ruby><input id\u{1f600}=y\u{20000} autofocus>")))
(assert (or (= z "document.write(""XSS"");</SCRIPT>") (= z "ml onMouseUp=""javascript:javascript:alert(1)""></html onMouseUp>") (= z "true"" contenteditable>drag me</div><ins ondragover=alert(1) contenteditable>drop here</ins>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "rue") (= "<div draggable=""true"" contenteditable>drag me</div><<b> ondrop=alert(1) contenteditable>drop here</form>" (str.replace x "form" "<b>")) (= "<div draggable=""true"" contenteditabl<b>drag me</div><form ondrop=alert(1) contenteditable>drop here</form>ml onMouseUp=""javascript:javascript:alert(1)""></html onMouseUp>" (str.replace y "e>" "<b>"))))
