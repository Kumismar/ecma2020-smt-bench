; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><dd onload=alert(1)></dd>") (= x "<html onMouseOut html onMouseOut=""javascript:javascript:alert(1)""></html onMouseOut>") (= x "<spacer oncopy=""alert(1)"" contenteditable>test</spacer>")))
(assert (or (= z "><input id=y autofocus>") (= z ">") (= z "rCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len y) 121)) (not (str.suffixof "s;)&quot;" x))))
(assert (or (not (str.contains x "nte")) (str.in_re z ((_ re.from_regex ecma2020) "[^a-zA-Z]+$"))))
(assert (or (not (str.contains x "ad=ale")) (= (str.at x 14) "=")))
(assert (not (str.contains (str.replace y "npu" "<b>") "i<b>t onc")))
(assert (or (= (str.at x 8) "k") (str.prefixof "rCode(88,8" z) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9A-Za-z \-']+$")))))
(check-sat)
