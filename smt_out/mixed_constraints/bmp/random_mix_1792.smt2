; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em id=x tabindex=1 ondeactivate=alert(1)></em><input id=y autofocus>") (= x "<source onmousemove=""alert(1)"">test</source>")))
(assert (or (= z "lert(1)"">test</source>") (= z "eldset onmouseenter=""alert(1)"">test</fieldset>") (= z "=alert(1)></bgsound>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "=""ale") (not (>= (str.len z) 13)) (not (= (str.len x) 44))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\+\d{1,4}|0+\d{1,5}|\(\d{1,5})[\d\s\/\(\)-]*\d+$"))) (= (str.indexof z "</pi" 0) 19) (not (= "<s urce onmousemove=""alert(1)"">test</source>=alert(1)></bgsound>" (str.replace y "o" " ")))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^((0?[13578]|10|12)(-|\/)(([1-9])|(0[1-9])|([12])([0-9]?)|(3[01]?))(-|\/)((19|20)([2-9])(\d{1})|(20)([01])(\d{1})|([8901])(\d{1}))|(0?[2469]|11)(-|\/)(([1-9])|(0[1-9])|([12])([0-9]?)|(3[0]?))(-|\/)((19|20)([2-9])(\d{1})|(20)([01])(\d{1})|([8901])(\d{1})))$")) (= (str.indexof y "ource" 0) 2)))
(assert (or (>= (str.len x) 38) (not (str.suffixof "/source>" y)) (not (str.prefixof "eldset " z))))
(assert (= (str.indexof x "alert" 0) 21))
(check-sat)
