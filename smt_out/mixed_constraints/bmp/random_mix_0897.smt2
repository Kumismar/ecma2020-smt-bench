; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onfocusout=alert(1) tabindex=1 id=x></cite><input autofocus>") (= x "<output onbeforepaste=""alert(1)"" contenteditable>test</output>") (= x "<style>@keyframes x{}</style><td style=""animation-name:x"" onanimationstart=""alert(1)""></td>")))
(assert (or (= z "bdi>") (= z "/STYLE&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<st" x) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z -]+$")))))
(assert (or (not (= (str.len x) 91)) (str.in_re x ((_ re.from_regex ecma2020) "^.{1,}$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.]{1,30}$"))))
(assert (or (= "SRC=""" (str.substr x 6 5)) (not (str.contains y "3E%3Cscri"))))
(assert (not (>= (str.len x) 85)))
(check-sat)
