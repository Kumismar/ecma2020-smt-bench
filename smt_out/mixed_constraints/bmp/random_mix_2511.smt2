; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><figcaption onload=alert(1)></figcaption>") (= x "<!--<img src=""--><img src=x onerror=alert(XSS)//"">") (= x "<bdo onmousemove=""alert(1)"">test</bdo>")))
(assert (or (= z "nmouseup=""alert(1)"">test</li>") (= z " draggable=""true"" ondragend=""alert(1)"">\u{1f4a9}test</body>") (= z "ationend=""alert(1)""></big>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len x) 46))
(assert (or (not (= (str.at x 14) "o")) (not (= (str.len z) 29)) (not (= "est</bdo>" (str.substr x 29 10)))))
(assert (or (str.contains z "(1)"">test") (str.contains z "ert(1)><")))
(assert (or (not (= "est</bdo" (str.substr y 29 8))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{c0}-\u{ff} ,.'-]+$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^((8|\+3)[\- ]?)?(\(?\d{3}\)?[\- ]?)?[\d\- ]{7,10}$")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "VXKRI2D4FR"))) (= (str.at y 55) " ")))
(assert (not (str.suffixof "</body>" z)))
(check-sat)
