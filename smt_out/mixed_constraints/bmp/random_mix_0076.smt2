; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dir onmouseleave=""alert(1)"">test</dir>") (= x "%3Cx onxxx=alert(1)") (= x "<col draggable=""true"" ondragleave=""alert(1)"">test</col>")))
(assert (or (= z ">test</hr>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^\s*1\d{10}\s*$")) (not (= "l dr" (str.substr x 3 4)))))
(assert (or (<= (str.len y) 21) (= (str.indexof x ")""" 0) 26)))
(assert (or (not (str.contains y "aggable")) (not (= (str.at z 2) "e"))))
(assert (or (not (str.suffixof ">" z)) (not (= (str.at x 22) "o"))))
(assert (or (not (str.suffixof "1)" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]+/[0-9]{4}")))))
(assert (or (str.suffixof "/article>" x) (str.in_re y ((_ re.from_regex ecma2020) "^[^<>\\/]+$")) (not (str.prefixof ">te" z))))
(check-sat)
