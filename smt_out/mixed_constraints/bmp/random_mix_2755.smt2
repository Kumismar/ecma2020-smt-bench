; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><audio onload=alert(1)></audio>") (= x "<isindex ondblclick=\u{1f600}""alert(1)"">t\u{20000}est</isindex>")))
(assert (or (= z "table>test</button>") (= z ">") (= z "t('XSS'))>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<isindex o" y))
(assert (not (str.contains y "dex>table>")))
(assert (or (str.contains (str.replace x "FR" " ") "&lt; AM") (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-z0-9_\+-]+(\.[a-z0-9_\+-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*\.([a-z]{2,4})$"))) (= (str.at z 3) "X")))
(assert (or (not (= (str.indexof x "on" 0) 26)) (= ">t" (str.substr z 5 2)) (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_%.-]{1,30})@([a-zA-Z0-9_.-]{1,30})\.([a-zA-Z]{1,15})$")))))
(assert (str.contains z "t('XSS'))"))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&\u{2019}*+\/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")) (not (str.suffixof "t(1)></s>" x))))
(check-sat)
