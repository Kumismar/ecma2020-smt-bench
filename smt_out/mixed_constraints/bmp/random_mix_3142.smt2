; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#000060") (= x "<code id=x tabindex=1 onfocusin=alert(1)></code>")))
(assert (or (= z "ggable=""true"" ondragleave=""alert(1)"">test</picture>") (= z "xtmenu=""alert(1)"">test</big>") (= z "mmary>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len z) 28)))
(assert (or (= (str.indexof y "00" 0) 2) (not (str.prefixof "<code onm" x))))
(assert (= (str.indexof x "000" 0) 2))
(assert (or (not (= "xtmenu=""alert<b>"">test</big>" (str.replace z "(1)" "<b>"))) (not (<= (str.len x) 12)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{a0}]+")))))
(assert (or (not (str.suffixof "st</big>" y)) (= (str.at y 28) "l") (not (= (str.indexof z "ave=""" 0) 22))))
(assert (or (str.prefixof "&#0000" y) (str.prefixof "<c" y)))
(assert (or (str.contains (str.replace y " onfo" "alert(1)") "dex=1alert(1)cus") (not (= "sin=ale" (str.substr x 28 7))) (not (str.suffixof "></code>" x))))
(check-sat)
