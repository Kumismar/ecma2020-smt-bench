; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{10348}vid\u{1f4a9}eo autoplay onplay=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= x "getURL(""javascript:alert('XSS')"")")))
(assert (or (= z "test\u{20000}</option>") (= z "mationend=""alert(1)""></body>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 87) ">"))
(assert (or (not (= "(\"";XSS\"";)<;xR\0IPT>;\"";;&#039; >; out" (str.replace z "/SC" "x"))) (not (= (str.indexof x "l" 0) 4)) (= (str.indexof z "nd" 0) 7)))
(assert (= "alert(1)"">" (str.substr z 11 10)))
(assert (or (= (str.at x 3) "U") (not (str.in_re z ((_ re.from_regex ecma2020) "^(?:(A[KLRZ]|C[AOT]|D[CE]|FL|GA|HI|I[ADLN]|K[SY]|LA|M[ADEINOST]|N[CDEHJMVY]|O[HKR]|P[AR]|RI|S[CD]|T[NX]|UT|V[AIT]|W[AIVY]))$")))))
(assert (not (<= (str.len y) 118)))
(assert (or (not (= (str.at z 0) "t")) (not (str.contains x """>"))))
(assert (or (str.contains (str.replace x "cus=" """") "onfo""a") (not (str.in_re z ((_ re.from_regex ecma2020) "^1[0-9]{10}$")))))
(check-sat)
