; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#x0003C") (= x "<script>alert(""hellox worldss"")</script>&safe=high&cx=006665157904466893121:su_tzknyxug&cof=FORID:9#510")))
(assert (or (= z "1)"" contenteditable>test</menuitem>") (= z "forepaste=""alert(1)"" contenteditable>test</embed>") (= z "ndragover=alert(1) contenteditable>drop here</acronym>")))
(assert (= y (str.++ x z)))
(assert (or (not (= """x0003C1)"" contenteditable>test</menuitem>" (str.replace y "&#" """"))) (not (str.prefixof "&#x0003C" x)) (not (<= (str.len z) 56))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(3[01]|[12][0-9]|0?[1-9])$"))))
(assert (or (not (= (str.at x 87) "&")) (= "121:su_tz" (str.substr x 72 9))))
(assert (or (not (= "su_tzknyxu" (str.substr y 76 10))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[^@]+@[^@]+\.[^@]+$")))))
(check-sat)
