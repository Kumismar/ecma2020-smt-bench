; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li onkeypress=""alert(1)"" contenteditable>test</li>") (= x "<bdi id=x tabindex=1 onactivate=alert(1)></bdi>")))
(assert (or (= z "address draggable=""true"" ondragstart=""\u{10348}alert(1)"">test\u{1f4a9}</address>") (= z "(1)></script>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "</scr" " ") "> ip")) (not (= (str.at z 54) "<")) (= (str.indexof z "sc" 0) 6)))
(assert (or (not (str.suffixof ";" z)) (<= (str.len x) 54)))
(assert (or (= "l" (str.substr y 87 1)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9_!#$%&'\x22*+/=?`{|}~^.-]+@[A-Za-z0-9[\]:.-]+\.[A-Za-z0-9[\]:-]{2,}$")))))
(assert (or (not (str.contains y "dra")) (str.in_re z ((_ re.from_regex ecma2020) "\([0-9]{2}\) [0-9]{5}-[0-9]{4}$"))))
(assert (not (= (str.at z 3) ">")))
(check-sat)
