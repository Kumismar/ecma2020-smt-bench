; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre onpaste=""alert(1)"" contenteditable>test</pre>") (= x "<data id=x tabindex=1 ondeactivate=alert(1)></data><input id=y autofocus>")))
(assert (or (= z "DATA&#91;&lt;IMG SRC=\""javas&#93;&#93;&gt;&lt;!&#91;CDATA&\u{1f4a9}#91;cript&#58;a\u{1f4a9}lert('XSS');\""&gt;&#93;&#93;&gt;") (= z "rce onbeforepaste=""alert(1)"" contenteditable>test</source>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof " dragg" z)))
(assert (= (str.indexof z "9" 0) 6))
(assert (or (str.suffixof "ocus>" x) (not (str.prefixof "DATA&#9" z)) (not (str.contains y "d=x"))))
(assert (not (= (str.at y 66) "o")))
(assert (= (str.at y 132) "S"))
(assert (= (str.at z 32) "t"))
(assert (or (str.suffixof "source>" z) (= ";alert(/XS" (str.substr y 13 10))))
(assert (or (str.prefixof "<data i" x) (not (= "data id" (str.substr y 1 7)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[6-9]\d{9}"))) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\s+-]{10,16}")) (str.in_re y ((_ re.from_regex ecma2020) "^(?:[a-fA-F0-9]{8}|[a-fA-F0-9]{11}|[a-fA-F0-9]{14}|[a-fA-F0-9]{15,16}|[a-fA-F0-9]{18})$"))))
(check-sat)
