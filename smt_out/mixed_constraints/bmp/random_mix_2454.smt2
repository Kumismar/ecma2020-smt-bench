; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img/src=`%00` onerror=this.onerror=confirm(1)") (= x "<tfoot onkeyup=""alert(1)"" contenteditable>test</tfoot>")))
(assert (or (= z """>test</style>") (= z "script>") (= z " injection --><svg height=""50px"">")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "/sty" 0) 7)))
(assert (or (not (str.suffixof "pt>" z)) (not (>= (str.len y) 85)) (str.contains y "px""")))
(assert (or (= (str.indexof z "st<" 0) 4) (= (str.at z 2) "r")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(([0-8][0-9])|(9[0-5]))[0-9]{3}$"))) (not (str.contains y "load=a"))))
(assert (or (not (= (str.at y 0) "<")) (str.suffixof "1)" x) (= "<data xcut=""alert(1)"" contenteditable>test</data>" (str.replace x "on" "x"))))
(assert (or (not (= (str.indexof z "lot" 0) 0)) (str.prefixof """>test</" z)))
(check-sat)
