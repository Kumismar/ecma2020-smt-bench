; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;A HREF=&quot;http://google.com/&quot;&gt;XSS&lt;/A&gt;") (= x "<a draggable=""true"" ondragstart=""alert(1)"">test</a>")))
(assert (or (= z " tabindex=1 ondeactivate=alert(1)></spacer><input id=y autofocus>") (= z "1)></s>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len x) 50)) (not (>= (str.len y) 82))))
(assert (not (= "ragst" (str.substr x 23 5))))
(assert (= (str.at z 0) "1"))
(assert (not (= " tabindex=1 ondeactivate=alert(1 </spacer><input id=y autofocus>" (str.replace z ")>" " "))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{5,11}"))) (str.contains y "editable>t") (= "://goog" (str.substr x 21 7))))
(check-sat)
