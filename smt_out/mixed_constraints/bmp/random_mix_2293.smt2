; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><iframe%20src=""http://google.com""%%203E") (= x "<thead onbeforecut=""alert(1)"" contenteditable>test</thead>")))
(assert (or (= z "p>") (= z "test</dd>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "e>test</a") (not (= "<small id=x tabindxx=1 onbeforeactivate=alert(1)></small>" (str.replace x "e" "x"))) (not (str.suffixof ">" y))))
(assert (or (= (str.indexof z "t</dd" 0) 3) (str.in_re x ((_ re.from_regex ecma2020) "^[0-9_]{7,15}$")) (str.in_re y ((_ re.from_regex ecma2020) "^\+?\d[\d\- ]+$"))))
(assert (or (= "</" (str.substr x 118 2)) (not (str.suffixof "/dd>" z))))
(assert (not (str.prefixof "tes" z)))
(assert (not (str.prefixof """><iframe%" x)))
(assert (= "03Ete" (str.substr y 38 5)))
(assert (or (not (>= (str.len z) 1)) (= (str.indexof z "p" 0) 0) (<= (str.len y) 60)))
(assert (str.prefixof "t" z))
(check-sat)
