; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image ondblclick=""alert(1)"">test</image>") (= x "<cite ondblclick=""alert(1)"">t\u{1d400}est</cite>")))
(assert (or (= z "1) contenteditable>drop here</bgsound>") (= z "ert(1)"">test</textarea>") (= z "draggable=""true"" ondrag=""alert(1)"">test</figcaption>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "able>dro")))
(assert (str.prefixof "draggable" z))
(assert (not (str.prefixof "<cite ondb" y)))
(assert (or (= "dr" (str.substr y 59 2)) (str.prefixof "ert(1)"">t" z)))
(assert (or (str.contains y "e>") (= "<cite ondblclick=""alert(1 >t\u{1d400}est</cite>ert(1)"">test</textarea>" (str.replace y ")""" " "))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(\([2-9][0-9][0-9]\) |[0-9]{3}-)[0-9]{3}-[0-9]{4}$"))) (str.suffixof ">" z)))
(assert (or (not (<= (str.len y) 71)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[1-4][a-zA-Z]$")))))
(check-sat)
