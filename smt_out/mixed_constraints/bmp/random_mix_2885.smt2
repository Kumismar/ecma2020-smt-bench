; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script draggable=""true"" ondragend=""alert(1)"">test</script>") (= x "<optgroup onbeforecut=""alert(1)"" contenteditable>test</optgroup>") (= x "<div draggable=""true"" contenteditable>drag me</div><multicol ondrop=alert(1) contenteditable>\u{1f4a9}drop here</multicol>")))
(assert (or (= z "avas<!-- -->cript:document.vulnerable=true""></B></I></XML><SPAN DATASRC=""#xss"" DATAFLD=""B"" DATAFORMATAS=""HTML""></span>") (= z "dragover=alert(1) contenteditable>drop here</u>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "t>" x)))
(assert (= """" (str.substr z 4 1)))
(assert (or (not (= (str.at y 103) "/")) (not (str.in_re x ((_ re.from_regex ecma2020) "^((\d{1,2}|1\d\d|2[0-4]\d|25[0-5])\.){3}(\d{1,2}|1\d\d|2[0-4]\d|25[0-5])$")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) ".{3,30}$"))) (str.suffixof "oup>" x) (= "r=ale" (str.substr z 7 5))))
(assert (or (<= (str.len x) 69) (not (= (str.at z 103) "=")) (str.contains z "gt")))
(assert (or (not (= " DATA" (str.substr y 154 5))) (not (= (str.at z 9) "-"))))
(check-sat)
