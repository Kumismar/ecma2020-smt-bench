; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd onmousemove=""alert(1)"">test</dd>") (= x "<head draggable=""true"" ondragleave=""alert(1)"">test</head>") (= x "<style>li {list-style-image: url(""javascript:document.vulnerable=true;"");</STYLE><UL><LI>XSS")))
(assert (or (= z "utofocus>") (= z "y=""alert(1)"" contenteditable>test</blink>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof ">" z))
(assert (not (= (str.len x) 36)))
(assert (not (str.contains y "draggab")))
(assert (or (= (str.indexof x " onm" 0) 3) (str.in_re z ((_ re.from_regex ecma2020) "^(\d{10})$"))))
(assert (or (not (= "1 onfocus=alert(1)javascript:mp>" (str.replace z "></sa" "javascript:"))) (str.prefixof "y=""alert(" z) (not (>= (str.len y) 43))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "([A-Z]{1})([a-z]{2,20})((\s{1,2}|-{1})([A-Z]{1})([a-z]{2,20}))?$"))))
(assert (str.contains y "pt:docu"))
(check-sat)
