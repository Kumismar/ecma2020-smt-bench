; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;/TITLE>;<;SCRIPT>;alert(\u{10348}""XSS"");<;/SCRIPT>;") (= x "<caption id=x tabindex=1 onactivate=alert(1)></caption>")))
(assert (or (= z "ue;"">") (= z "0003C")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 45) (str.contains y "/xmp>")))
(assert (or (not (str.contains y "(1)""")) (= ">/m" (str.substr y 37 3)) (= (str.at z 4) ">")))
(assert (or (not (= ">" (str.substr x 22 1))) (not (str.suffixof "ue;"">" y))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{2,3})$"))) (= (str.len z) 5) (not (str.in_re y ((_ re.from_regex ecma2020) "/(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,}/")))))
(assert (= (str.indexof z "0003C" 0) 0))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[A-z]{1,}"))) (= (str.indexof z "ue;"">" 0) 0) (str.contains (str.replace y "pe=s" "javascript:") "ut tyjavascript:ubm")))
(assert (not (str.suffixof "ue;"">" z)))
(check-sat)
