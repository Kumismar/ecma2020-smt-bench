; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist onbeforepaste=""alert(1)"" contenteditable>test</datalist>") (= x "<table id=x t\u{1f4a9}abindex=1 onfocus=alert(1)></table>")))
(assert (or (= z "dt ondblclick=""alert(1)"">test</dt>") (= z "le>drop here</thead>") (= z "lert(1) value=xss>")))
(assert (= y (str.++ x z)))
(assert (or (= "alert" (str.substr x 32 5)) (str.contains z "cus>")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._-]{5,30}$")) (str.in_re y ((_ re.from_regex ecma2020) "([1][2-9]|[2-9]\d)")) (str.contains (str.replace x ">" "") "blet")))
(assert (str.contains (str.replace z "ert(1" "<b>") "l<b>)"))
(assert (or (not (str.suffixof ">" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(\d{1,3})(,\d{3})*(\.\d{1,2})?$")))))
(assert (or (not (= "t(1) value" (str.substr z 3 10))) (= "dt ondblclick=""alert(1)""xt</dt>" (str.replace z ">tes" "x"))))
(assert (not (str.suffixof "></del>" z)))
(assert (or (not (>= (str.len x) 52)) (not (str.contains x "rt(1)"))))
(check-sat)
