; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """></iframe><script>alert(123)</script>") (= x "<svg><hgroup onload=alert(1)></hgroup>") (= x "//<form/action=javascript&#x3A;alert&lpar;document&period;cookie&rpar;><input/type='submit'>//")))
(assert (or (= z "ript></svg>") (= z "t(1)"">test</summary>") (= z "editable>test</command>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len y) 113))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "\s*[a-zA-Z0-9-_]{6,16}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^((((\+31|0|0031)[1-9]{2}[0-9][-]?[0-9]{6}[0-9]*)|((\+31|0|0031)[1-9][0-9][-]?[1-9][0-9]{6}))|(((\+31|0|0031)[\s]?[-]?6){1}[-]?[1-9]{1}[0-9]{7}))"))) (not (str.prefixof "<xmp onk" x))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(1\s*[-\/\.]?)?(\((\d{3})\)|(\d{3}))\s*[-\/\.]?\s*(\d{3})\s*[-\/\.]?\s*(\d{4})\s*(([xX]|[eE][xX][tT])\.?\s*(\d+))*$"))))
(assert (or (str.contains (str.replace x "></" " ") """ if") (= (str.at z 24) ">")))
(assert (or (str.prefixof "//<form" x) (not (str.contains x "<form")) (= (str.at z 18) "y")))
(check-sat)
