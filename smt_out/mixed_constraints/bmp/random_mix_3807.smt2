; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound onPropertyChange bgsound onPropertyChange=""javascript:javascript:alert(1)""></bgsound onPropertyChange>") (= x "<svg><plaintext onload=alert(1)></plaintext>") (= x "<aside draggabl\u{1f4a9}e=""true"" ondragen\u{10348}ter=""alert(1)"">test</aside>")))
(assert (or (= z "<small id=x style=""transition:color 1s"" ontransitionend=alert(1)></small>") (= z "</abbr>") (= z "alert(1)>paste here!")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9 ]+$"))) (str.contains z " 1s"" on") (not (str.in_re y ((_ re.from_regex ecma2020) "^[^-\s][\w\s\W]{1,40}$")))))
(assert (or (str.suffixof "l>" y) (str.contains (str.replace x ">" "javascript:") "t(1)""javascript:t") (not (<= (str.len z) 73))))
(assert (or (= (str.indexof z "</" 0) 0) (not (= "<samp id=x tabindex=1 onbeforeactivate=alert(1)></s""" (str.replace x "amp>" """"))) (str.in_re y ((_ re.from_regex ecma2020) "^([A-Z0-9]{5}-){6}[A-Z0-9]{5}$"))))
(assert (or (<= (str.len y) 87) (str.contains x """ on") (not (= (str.len x) 61))))
(assert (or (not (= (str.indexof y "d" 0) 4)) (not (= (str.indexof z ">" 0) 9))))
(check-sat)
