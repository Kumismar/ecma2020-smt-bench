; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<? foo=""><script>alert(91)</script>"">") (= x "<nobr onbeforecut=""alert(1)"" contenteditable>test</nobr>") (= x "<font oncopy=""alert(1)"" contenteditable>test</font>")))
(assert (or (= z "center onbeforecopy=""alert(1)"" contenteditable>test</center>") (= z "y autofocus>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 46) "f")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0 ]{1}[0-9 ]{6,15}"))) (= (str.indexof z "ead" 0) 9)))
(assert (not (= "nobr>" (str.substr x 51 5))))
(assert (or (not (str.prefixof "<no" y)) (not (= (str.indexof x "st</" 0) 47))))
(assert (or (not (= (str.indexof x "conte" 0) 29)) (str.suffixof "center>" y) (str.prefixof "<" x)))
(assert (not (str.suffixof "</script>" x)))
(assert (or (= (str.len z) 12) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z-\s]+$")))))
(assert (or (= (str.at z 9) "c") (not (= (str.len y) 111))))
(check-sat)
