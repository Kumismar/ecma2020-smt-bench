; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<content onkeyup=""alert(1)"" contenteditable>test</content>") (= x "<style>:target {color:red;}</style><h1 id=x style=""transition:color 1s"" ontransitionend=alert(1)></h1>") (= x "<output id=x tabindex=1 onbeforeactivate=alert(1)></output>")))
(assert (or (= z "lert(1)//") (= z "ditable>drag me</div><article ondrop=alert(1) contenteditable>drop here</article>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%*+/=?^_`{2,}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[9|6|7][0-9]{8}$"))) (not (str.suffixof "t>" x)) (not (str.contains y "here</art"))))
(assert (= "<content onkeyup=""alert("")"" contenteditable>test</content>" (str.replace x "1" """")))
(assert (not (str.prefixof "<c" x)))
(assert (or (not (str.contains x "rt(1)>")) (= "<output i tabindex=1 onbeforeactivate=alert(1)></output>" (str.replace x "d=x " " "))))
(check-sat)
