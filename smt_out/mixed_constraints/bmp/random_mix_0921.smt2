; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i onkeyup=""alert(1)"" contenteditable>test</i>") (= x "<b draggable=""true"" ondragstart=""alert(1)"">test</b>") (= x "<element draggable=""true"" ondragstart=""al\u{20000}ert(1)"">test</element>")))
(assert (or (= z "1)></rtc>") (= z " Location: '+document.location+' Host Page Cookies: '+document.cookie);//<br/><hr/>") (= z "e>@keyframes x{}</style><element style=""animation-name:x"" onanimationend=""alert(1)""></element>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\(?([+]31|0031|0)-?6(\s?|-)([0-9]\s{0,3}){8}$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9,\.]+$")))))
(assert (= (str.len x) 51))
(assert (or (= (str.at z 4) "/") (str.prefixof "<element " x)))
(assert (or (not (= (str.len z) 9)) (not (= (str.len z) 94))))
(assert (not (= "><" (str.substr z 2 2))))
(check-sat)
