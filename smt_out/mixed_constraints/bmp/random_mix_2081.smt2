; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody onmouseout=""alert(1)"">test</tbody>") (= x "<h1 oncopy=""alert(1)"" contenteditable>test</h1>")))
(assert (or (= z "est</span>") (= z "ext/html;base64_,<svg/onload=\u{5c}u0061&#x6C;&#101%72t(1)>"">X</a")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 22) "o")) (not (= "<tbody onmouseout=""alert(1)"">test</tbodjavascript:st</span>" (str.replace y "y>e" "javascript:"))) (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]{6,30}$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]+\.?[0-9]*"))) (not (str.contains (str.replace x "test" " ") """> </t"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[7-9][0-9]{9}"))))
(assert (or (not (str.suffixof "mplate>" z)) (not (str.contains z "st</span")) (= (str.indexof z "/" 0) 4)))
(assert (or (= (str.at z 10) ";") (str.prefixof "ext/ht" z)))
(check-sat)
