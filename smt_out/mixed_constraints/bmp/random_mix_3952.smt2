; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite id=x tabindex=1 onactivate=alert(1)></cite>") (= x "<;IMG SRC=javascript:alert(';XSS';)>;") (= x "<br draggable=""true"" ondragleave=""alert(1)"">test</br>")))
(assert (or (= z " me</div><isindex ondrop=alert(1) cont\u{1f4a9}enteditable>drop here</isindex>") (= z " contenteditable>drop here</s>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "</isindex>" z) (str.contains y "ondragl")))
(assert (or (str.suffixof "test</br>" x) (not (<= (str.len x) 51)) (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{5,8}$")))))
(assert (= (str.at z 47) "e"))
(assert (or (not (str.contains x "(1)></c")) (str.in_re x ((_ re.from_regex ecma2020) "\S+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"))))
(assert (or (>= (str.len y) 119) (not (str.contains z "nteditable")) (not (= (str.at z 0) " "))))
(assert (or (not (str.suffixof "/s>" y)) (str.contains (str.replace x "a" "") "d=x tbinde") (not (str.in_re z ((_ re.from_regex ecma2020) "^[+]?([(][0-9]{1,3}[)][-]?)?([0-9][-]?){3,16}[0-9]$")))))
(check-sat)
