; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><big ondragover=alert(1) contenteditable>drop here</big>") (= x "<ul draggable=""true"" ondragleave=""alert(1)"">test</ul>") (= x "<style>:target {transform: rotate(180deg);}</style><meter id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></meter>")))
(assert (or (= z "t(1)"">test</tt>") (= z "s.htc);"">")))
(assert (= y (str.++ x z)))
(assert (not (= "d" (str.substr x 23 1))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z_]+$"))))
(assert (str.contains z ".htc"))
(assert (or (str.prefixof "t(1)"">te" z) (= "ert(1)"">te" (str.substr y 36 10)) (= (str.indexof x "svg>" 0) 1)))
(assert (not (= (str.at y 42) " ")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[A-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df} | \b | -]{2,25}")) (not (= (str.at x 91) ">")) (not (str.prefixof "t" z))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(\s*)(([A-Za-z]{1,2}[ ]?[0-9]{1,4})|([A-Za-z]{3}[ ]?[0-9]{1,3})|([0-9]{1,3}[ ]?[A-Za-z]{3})|([0-9]{1,4}[ ]?[A-Za-z]{1,2})|([A-Za-z]{3}[ ]?[0-9]{1,3}[ ]?[A-Za-z])|([A-Za-z][ ]?[0-9]{1,3}[ ]?[A-Za-z]{3})|([A-Za-z]{2}[ ]?[0-9]{2}[ ]?[A-Za-z]{3})|([A-Za-z]{3}[ ]?[0-9]{4}))(\s*)$"))) (not (str.suffixof "/menuitem>" z))))
(assert (or (= (str.at x 4) "d") (str.contains y "st</ul>")))
(check-sat)
