; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<acronym onkeyup=""alert(1)"" contenteditable>test</acronym>") (= x "<element onbeforecopy=""alert(1)"" contenteditable>test</element>") (= x "&lt;XSS STYLE=\""behavior&#58; url(xss&#46;htc);\""&gt;")))
(assert (or (= z "onfocusout=alert(1) tabindex=1 id=x></form><input autofocus>") (= z "cus>") (= z "set>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) ".{0,40}"))) (= (str.indexof x "eyup" 0) 12)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^(|[0-9][0-9]*)$")) (= (str.indexof z "us" 0) 1)))
(assert (or (not (= (str.at x 24) "1")) (not (str.prefixof "&l" y))))
(assert (or (= "<element onbefore opy=""alert(1)"" contenteditable>test</element>onfocusout=alert(1) tabindex=1 id=x></form><input autofocus>" (str.replace y "c" " ")) (not (str.suffixof "</acronym>" x))))
(check-sat)
