; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blink onmousedown=""alert(1)"">test</blink>") (= x "<font draggable=""true"" ondragstart=""alert(1)"">test</font>") (= x "<output id=x tabindex=1 onbeforeactivate=alert(1)></output>")))
(assert (or (= z "big>") (= z "t%253e") (= z "teditable>test</big>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y "46;c" "<b>") "&#<b>kers&") (not (str.suffixof "est</big>" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]{7,12}$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Z]{1,2}\d[A-Z\d]? \d[ABD-HJLNP-UW-Z]{2}$"))))
(assert (str.contains (str.replace x "d=x t" "javascript:") "put ijavascript:abind"))
(assert (or (not (>= (str.len y) 69)) (str.suffixof "3e" z)))
(assert (or (not (str.prefixof "<b" x)) (not (= (str.indexof z "est<" 0) 11)) (not (= "g>" (str.substr z 2 3)))))
(assert (not (= (str.at y 4) "t")))
(assert (or (not (<= (str.len y) 82)) (not (str.in_re x ((_ re.from_regex ecma2020) "study_accession")))))
(check-sat)
