; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG DYNSRC=\""javascript&#058;alert('XSS')\""&gt;") (= x "<style>:target {transform: rotate(180deg);}</style><br id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></br>") (= x "<track onmouseover=""alert(1)"">test</track>")))
(assert (or (= z "</bdi>") (= z "st</small>") (= z "ert(&quot;XSS&quot;)>&quot;;&apos;&gt; out")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "RC=" 0) 12)) (not (str.contains z "</bdi"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[a-z0-9A-Z]{6,16}$"))) (str.prefixof "&lt;A HR" y) (not (= (str.at y 67) "o"))))
(assert (or (= (str.at x 33) "t") (not (str.contains x "\""javascri")) (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{5}$|^\d{5}-\d{4}$")))))
(assert (or (not (str.prefixof "<t" y)) (= (str.indexof x "u" 0) 11) (not (= "<style>:target {transform: rotate(180deg);}</style><br id=x style=""transition:transform 2s"" onsitionrun=alert(1)></br>" (str.replace x "ntra" "")))))
(assert (or (>= (str.len y) 51) (not (= (str.indexof y "vasc" 0) 19)) (str.in_re z ((_ re.from_regex ecma2020) "[\w\.\-]+@[\w\.\-]+"))))
(assert (not (str.contains y "</trac")))
(check-sat)
