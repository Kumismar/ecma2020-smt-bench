; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""javas\x0Dcript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<ruby onmouseout=""alert(1)"">test</ruby>") (= x "<noframes onkeypress=""alert(1)"" contenteditable>test</noframes>")))
(assert (or (= z "ggable=""true"" ondragstart=""alert(1)"">test</bgsound>") (= z "ument.vulnerable=true;)"">")))
(assert (= y (str.++ x z)))
(assert (or (= "<r onmouseout=""alert(1)"">test</ruby>" (str.replace x "uby" "")) (not (str.contains z "le=")) (<= (str.len x) 40)))
(assert (or (= "<ruby onmouseout=""a""ert(1)"">test</ruby>ument.vulnerable=true;)"">" (str.replace y "l" """")) (not (= (str.at y 63) " "))))
(assert (or (str.contains (str.replace x "va" "<b>") """ja<b>s\x") (str.prefixof "<a href=""" x)))
(assert (not (str.prefixof "ument." z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9!#$%&'*+\/=?^_`{|}~-]+(?:\.[a-zA-Z0-9!#$%&'*+\/=?^_`{|}~-]+)*@(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$"))))
(assert (or (not (= (str.at x 38) "n")) (= (str.indexof z "gstar" 0) 19) (str.suffixof ">" z)))
(assert (or (str.contains y "ment.vuln") (not (= (str.indexof y "cri" 0) 18)) (not (str.in_re z ((_ re.from_regex ecma2020) "[ \t\r\n\f0-9-()+-]*$")))))
(check-sat)
