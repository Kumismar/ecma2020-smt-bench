; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sub id=x tabindex=1 onbeforeactivate=alert(1)></sub>") (= x "<img onkeypress=""alert(1)"" contenteditable>test</img>")))
(assert (or (= z "et {color:red;}</style><map id=x style=""transition:color 1s"" ontransitionend=alert(1)></map>") (= z "e"" ondragenter=""alert(1)"">test</tr>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{456}'\u{454}\u{439}\u{404}\s]+$")) (str.suffixof "1)></sub>" x)))
(assert (or (not (= (str.len x) 53)) (not (str.prefixof "<div drag" y))))
(assert (>= (str.len x) 51))
(assert (or (not (= "et {color:red;}</style><map id=x style=""transition:color 1s"" ontransit<b>nd=alert(1)></map>" (str.replace z "ione" "<b>"))) (not (= (str.at x 38) "a")) (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-zA-z]{2,4}$")))))
(assert (or (str.contains (str.replace z "k>" "<b>") "c<b>") (not (str.prefixof "<i" x))))
(check-sat)
