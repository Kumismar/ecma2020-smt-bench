; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><bdi id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></bdi>") (= x "<nobr ondblclick=""alert(1)"">test</nobr>") (= x "<form><input oninvalid=alert(1) required><input type=submit>")))
(assert (or (= z "yle><isindex style=""animation-name:x"" onanimationend=""alert(1)""></isindex>") (= z "default#time2)` onbegin=`javascript:alert(1)` >")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "ascript:a")))
(assert (str.prefixof "<fo" x))
(assert (or (str.suffixof "/nobr>" x) (not (str.in_re z ((_ re.from_regex ecma2020) "[Pp]articulier|[Pp]rofessionnel")))))
(assert (or (= "cri" (str.substr z 3 3)) (not (str.prefixof "<" y))))
(assert (or (not (str.suffixof "br>" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "[\u{30a1}-\u{30f4}][\u{30a1}-\u{30f4}\u{30fc}]*(\u{30fb}[\u{30a1}-\u{30f4}][\u{30a1}-\u{30f4}\u{30fc}]*)*"))) (str.contains (str.replace y "input" """") "m><"" onin")))
(assert (or (not (str.suffixof " >" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(\d\d\d\d)|([\u{ff10}-\u{ff19}][\u{ff10}-\u{ff19}][\u{ff10}-\u{ff19}][\u{ff10}-\u{ff19}])$")))))
(check-sat)
