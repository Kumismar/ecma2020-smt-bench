; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li draggable=""true"" ondragenter=""alert(1)"">test</li>") (= x "<var onmouseover=""prompt(1)"">On Mouse Over</var>") (= x "<?xml version=""1.0"" encoding=""ISO-8859-1""?><!DOCTYPE foo [<!ELEMENT foo ANY><!ENTITY xxe SYSTEM ""file://c:/boot.ini"">]><foo>&xee;</foo>")))
(assert (or (= z "eypress=""alert(1)"" contenteditable>test</b>") (= z "nbeforedeactivate=alert(1)></col><input autofocus>") (= z "t(1)></dialog>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 89) "p")))
(assert (or (= (str.indexof y "tent>" 0) 60) (= (str.at z 19) "c")))
(assert (or (not (= (str.len x) 53)) (str.contains x "/te")))
(assert (str.prefixof "n" z))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[ \t\r\n\f0-9-+]*$"))) (not (= "espt" (str.substr z 10 7))) (str.suffixof "ialog>" z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[A-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df} a-z0-9\-]{1,40}"))))
(check-sat)
