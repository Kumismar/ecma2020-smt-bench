; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><xmp id=x style=""transition:color 1s"" ontransitionend=alert(1)></xmp>") (= x "<label dataformatas=""html"" datasrc=""#xss"" datafld=""payload""></label>//[""'`-->]]>]</div>")))
(assert (or (= z "ex=1 ondeactivate=alert(1)></noscript><input id=y autofocus>") (= z "lert(1)"">test</track>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^\s*[0-9a-zA-Z@._\\/-]*\s*$"))))
(assert (str.prefixof "<l" x))
(assert (not (= (str.at x 20) "r")))
(assert (or (not (= (str.at z 55) "o")) (str.contains x "=""trans") (not (= (str.len y) 108))))
(assert (or (not (str.contains y " st")) (= "ocus>" (str.substr z 55 5))))
(assert (= (str.indexof y ">" 0) 59))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*(.[a-z]{2,4})")))
(check-sat)
