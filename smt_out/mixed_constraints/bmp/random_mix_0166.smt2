; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><section ondrop=alert(1) contente\u{1f4a9}ditable>drop here</section>") (= x "<rb onmouseenter=""alert(1)"">test</rb>") (= x "<summary draggable=""true"" ondrag=""alert(1)"">test</summary>")))
(assert (or (= z "true"" ondragend=""alert(1)"">test</s>") (= z "tart=""alert(1)"">test</dl>") (= z "t(1)<\x00/script>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(\+36)([0-9]{8,9})$")) (not (str.contains (str.replace z ">" "alert(1)") ")""alert(1)tes")) (not (str.in_re z ((_ re.from_regex ecma2020) "\S+@\S+\.\S*$")))))
(assert (or (not (= "tart=""alert(1)"">testx>" (str.replace z "</dl" "x"))) (not (str.contains z "t(1)<\x00/")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[6-9]\d{9}")))))
(assert (not (= (str.indexof y "g" 0) 8)))
(assert (not (str.contains (str.replace x "ee" "<b>") "nmous<b>n")))
(check-sat)
