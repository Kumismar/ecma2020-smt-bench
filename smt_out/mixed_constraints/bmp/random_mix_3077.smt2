; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><details id=x style=""transition:color 1s"" ontransitionend=alert(1)></details>") (= x "<object onError object onError=""javascript:javascript:alert(1)""></object onError>") (= x "<IMG SRC=""jav ascript:javascript:alert(1);"">")))
(assert (or (= z "yle=""animation-name:x"" onanimationstart=""alert(1)""></s>") (= z "table>test</colgroup>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<object on" y) (str.in_re z ((_ re.from_regex ecma2020) "^(\+?1-?)?(\([2-9]([02-9]\d|1[02-9])\)|[2-9]([02-9]\d|1[02-9]))-?[2-9]([02-9]\d|1[02-9])-?\d{4}$"))))
(assert (or (not (str.prefixof "<I" y)) (not (str.contains z "ion:co")) (not (<= (str.len x) 81))))
(assert (or (not (= (str.indexof y "t" 0) 20)) (= (str.indexof x "ject " 0) 3)))
(assert (or (not (str.suffixof ">" y)) (not (= "</s>" (str.substr z 51 10)))))
(check-sat)
