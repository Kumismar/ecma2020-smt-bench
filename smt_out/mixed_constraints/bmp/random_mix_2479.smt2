; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<![CDATA[<script>var n=0;while(true){n++;}</script>]]>") (= x "<style>:target {color: red;}</style><option id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></option>")))
(assert (or (= z "nxxx=1") (= z "=""transition:color 1s"" ontransitionend=alert(1)></a>")))
(assert (= y (str.++ x z)))
(assert (= "nxx""1" (str.replace z "x=" """")))
(assert (str.suffixof "est</area>" y))
(assert (or (not (= (str.at x 66) "s")) (not (= (str.indexof x "auto" 0) 62)) (= "=1" (str.substr z 4 5))))
(assert (str.contains y "ile("))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\u{c3}\u{2013}\u{c3}\u{b6}\u{c3}\u{bc}\u{c3}\u{153}\u{c3}\u{201e}\u{c3}\u{a4}\u{c3}\u{178}\s\-]*)$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{6,11}$"))) (str.in_re x ((_ re.from_regex ecma2020) "^(.+)@(.+)\.(.+)$"))))
(check-sat)
