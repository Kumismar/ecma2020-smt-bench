; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section id=x tabindex=1 onbeforeactivate=alert(1)></section>") (= x "<a href=javascript:alert(1)>click")))
(assert (or (= z "est</title>") (= z "t(1)"">test</svg>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "ert" 0) 44) (not (= (str.len z) 16))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{19}"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]{3} ?(?!sa|sd|ss|SA|SD|SS)[A-Za-z]{2}$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*(.[a-z]{2,})$"))))
(assert (<= (str.len y) 76))
(assert (or (not (= "x ta" (str.substr y 12 4))) (not (= "1)"">test" (str.substr y 35 8)))))
(check-sat)
