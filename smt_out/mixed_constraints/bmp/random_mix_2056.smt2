; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x onxxx=alert(1) 1='") (= x "<abbr onblur=alert(1) tabindex=1 id=x></abbr><input autofocus>") (= x "<audio src/onerror=alert(1)>")))
(assert (or (= z "y=""alert(1)"" contenteditable>test</map>") (= z "mouseleave=""alert(1)"">test</menu>") (= z ")"" contenteditable>test</meter>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "rt" 0) 15)))
(assert (not (str.suffixof "1='" x)))
(assert (or (not (str.suffixof "</meter>" y)) (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{9}")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9 () + -]{1,20}$")))))
(assert (or (not (str.contains y "y=""alert")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{1,2}[-][0-9]{1,2}[-][0-9]{4}$"))) (not (str.prefixof "<n" x))))
(assert (or (str.prefixof "<x onxxx=" x) (not (= "/blockqu" (str.substr z 30 8))) (not (str.suffixof "menu>" y))))
(assert (or (= (str.len x) 28) (= ">" (str.substr y 53 10))))
(check-sat)
