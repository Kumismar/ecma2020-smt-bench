; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>*[{}@import'%(css)s?]</style>X") (= x "<time onpaste=""alert(1)"" contenteditable>test</time>")))
(assert (or (= z "ascript:alert(1)</script>"">") (= z " contenteditable>test</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "([A-Z]{1})([a-z]{2,20})((\s{1,2}|-{1})([A-Z]{1})([a-z]{2,20}))?$"))) (= (str.at y 4) "e") (not (str.contains z "ble"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,})$"))) (not (str.contains (str.replace x "le>X" "") "y"))))
(assert (or (>= (str.len z) 27) (str.prefixof "<style" y)))
(assert (str.suffixof "i>" y))
(check-sat)
