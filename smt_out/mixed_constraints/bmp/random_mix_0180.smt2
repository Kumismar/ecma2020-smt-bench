; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen draggable=""true"" ondragenter=""alert(1)"">test</keygen>") (= x "&lt;SCRIPT a=`&gt;` SRC=&quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;") (= x "<svg><kbd onload=alert(1)></kbd>")))
(assert (or (= z "d=x tabindex=1 onbeforeactivate=alert(1)></section>") (= z " draggable=""true"" ondragend=""alert(1)"">test</h1>") (= z "}</style><hgroup id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></hgroup>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([7]{1})([5]{1})([6]{1})(.)([0-9]{4})(.)([0-9]{4})(.)([0-9]{2})$"))) (= (str.indexof y "=""tru" 0) 17) (= (str.at x 12) "l")))
(assert (or (= (str.indexof x ">test" 0) 26) (not (= (str.at y 1) "s"))))
(assert (or (not (= " onl" (str.substr x 9 4))) (= (str.indexof x "abl" 0) 13) (not (str.in_re z ((_ re.from_regex ecma2020) "^((\+48)[0-9]{9})$")))))
(assert (or (str.contains (str.replace x ";" " ") "t SCRIP") (not (str.in_re y ((_ re.from_regex ecma2020) "^(1[3-9]/d{9})$"))) (str.suffixof "</del>" y)))
(assert (str.prefixof "br><br><b" z))
(assert (or (= "ame:x"" on" (str.substr x 51 9)) (str.prefixof "<keyg" x)))
(assert (not (= (str.at z 46) "1")))
(check-sat)
