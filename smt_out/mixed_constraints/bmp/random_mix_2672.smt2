; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "%2BACIAPgA8-script%2BAD4-alert%28document.location%29%2BADw-%2Fscript%2BAD4APAAi-") (= x "<script\x2F>javascript:alert(1)</script>") (= x "http://www.<script>\u{1f600}alert(1)</script .\u{10348}com")))
(assert (or (= z "load=alert(1)></footer>") (= z "ofocus>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 1) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?:(?:31(\/|-|\.)(?:0?[13578]|1[02]))\1|(?:(?:29|30)(\/|-|\.)(?:0?[1,3-9]|1[0-2])\2))(?:(?:1[6-9]|[2-9]\d)?\d{2})$|^(?:29(\/|-|\.)0?2\3(?:(?:(?:1[6-9]|[2-9]\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))$|^(?:0?[1-9]|1\d|2[0-8])(\/|-|\.)(?:(?:0?[1-9])|(?:1[0-2]))\4(?:(?:1[6-9]|[2-9]\d)?\d{2})$"))) (str.suffixof "-" x)))
(assert (not (= (str.indexof z "u" 0) 4)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\+]?[0-9]{1,3}[\s]?[\(]?[0-9]{0,2}[\)]?[\s]?[0-9\s]{10,14}"))) (not (str.contains z "=alert(1)")) (not (<= (str.len y) 104))))
(assert (not (= (str.at y 9) "w")))
(assert (or (str.contains x "avasc") (str.suffixof "ooter>" y)))
(assert (not (str.suffixof "footer>" y)))
(check-sat)
