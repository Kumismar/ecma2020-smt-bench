; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<code id=x tabindex=1 onfocusin=alert(1)></code>") (= x "<ul ondblclick=""alert(1)"">test</ul>")))
(assert (or (= z "t%2Fj\u{5c}u0061v\u{5c}u0061script,\u{5c}u0061lert('\u{5c}u0061')""></script a=\u{5c}u0061 & /=%2F") (= z "enuitem draggable=""true"" ondragend=""alert(1)"">test</menuitem>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "t%2\u{5c}u0061v\u{5c}u0061script,\u{5c}u0061lert('\u{5c}u0061')""></script a=\u{5c}u0061 & /=%2F" (str.replace z "Fj" ""))) (str.prefixof "<code id" x)))
(assert (= (str.at z 53) "e"))
(assert (not (= (str.at y 14) "=")))
(assert (or (= "<audio" (str.substr y 0 6)) (<= (str.len y) 112)))
(assert (not (str.prefixof "<tr " x)))
(assert (or (not (= "input a" (str.substr y 123 7))) (str.contains x "t</if")))
(assert (= (str.at x 15) """"))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._-]+([a-zA-Z0-9])_?@(([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})|(([a-zA-Z\-0-9]+\.){1,4}[a-zA-Z]{2,}))$"))))
(assert (not (str.contains x "<f")))
(check-sat)
