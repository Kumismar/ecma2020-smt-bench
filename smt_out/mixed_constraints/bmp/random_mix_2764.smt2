; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address onmousedown=""alert(1)"">test</address>") (= x "<caption onbeforepaste=""alert(1)"" contenteditable>test</caption>") (= x "<bgs\u{1f600}ound id=x tabindex=1 onbeforeactivate=alert(1)></bgsound>")))
(assert (or (= z "aste=""alert(1)"" contenteditable>test</xmp>") (= z "le>test</iframe>") (= z """>test</ul>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]*$"))))
(assert (str.suffixof ">" x))
(assert (= "test</if" (str.substr z 3 8)))
(assert (or (not (= (str.at z 27) "a")) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$"))) (= (str.len z) 42)))
(assert (not (= "<bgs\u{1f600}ound alert(1)d=x tabindex=1 onbeforeactivate=alert(1)></bgsound>" (str.replace x "i" "alert(1)"))))
(assert (or (= (str.indexof z "<" 0) 0) (not (= (str.len y) 136))))
(check-sat)
