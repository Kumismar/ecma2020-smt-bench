; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><nav id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></nav>") (= x "<blink id=x tabindex=1 onbeforedeactivate=alert(1)></blink><input autofocus>")))
(assert (or (= z ")></nav>") (= z "x74&#x28&<WBR>#x27&#x58&#x53&#x53&#x27&#x29>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y ": ro")))
(assert (or (<= (str.len y) 98) (not (str.contains (str.replace y "abind" "alert(1)") "x talert(1)ex=1 ")) (str.in_re x ((_ re.from_regex ecma2020) "^[_a-zA-Z0-9-]+(\.[_a-zA-Z0-9-]+)*(\+[a-zA-Z0-9-]+)?@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*$"))))
(assert (or (not (str.suffixof "</col>" y)) (str.in_re y ((_ re.from_regex ecma2020) "^[+]?[()/0-9. -]{9,}$"))))
(assert (or (not (= "mation-name:x"" onanimationend=lert(1)""></cite>" (str.replace z """a" ""))) (str.contains (str.replace x "efo" "x") "nbxrede") (str.suffixof ")></nav>" z)))
(assert (or (not (str.prefixof ")>" z)) (not (str.contains x "te")) (not (= (str.indexof z "#x58" 0) 19))))
(assert (not (= (str.at z 6) "v")))
(check-sat)
