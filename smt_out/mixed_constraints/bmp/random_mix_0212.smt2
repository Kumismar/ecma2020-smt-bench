; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid onpaste=""alert(1)"" contenteditable>test</nextid>") (= x "<param onmousemove=""alert(1)"">test</param>") (= x "<template draggable=""true"" ondragenter=""alert(1)"">test</template>")))
(assert (or (= z ":color 1s"" ontransitionend=alert(1)></col>") (= z "ad=alert(1)></html>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 28) "l") (str.prefixof "<nextid on" y)))
(assert (or (<= (str.len z) 48) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Z][a-z]* [A-Z][a-z]*$")))))
(assert (or (= (str.indexof y "=" 0) 13) (= (str.at x 16) """")))
(assert (not (= (str.indexof z ">" 0) 0)))
(assert (or (str.contains (str.replace y "ion" "x") "sitxe") (not (str.contains (str.replace y "a onm" "javascript:") "<javascript:o")) (str.contains z "/smal")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9()#,\/\. -]*$"))) (not (<= (str.len y) 66)) (not (str.prefixof "<par" y))))
(check-sat)
