; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col id=x tabindex=1 ondeactivate=alert(1)></col><input id=y autofocus>") (= x "<tt onmousedown=""alert(1)"">test</tt>") (= x "<style>:target {color: red;}</style><tbody id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tbody>")))
(assert (or (= z "nter=""alert(1)"">test</c\u{1f4a9}ode>") (= z ">test</mark>") (= z "></script><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "></sc""t><input id=y autofocus>" (str.replace z "rip" """"))) (= "/embed> o" (str.substr y 106 9)) (= (str.at y 24) ")")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9 ]{0,6}$"))))
(assert (or (not (= (str.len z) 12)) (str.suffixof "%00" z) (str.contains z "</mark>")))
(assert (or (str.prefixof "<tt onmous" y) (= (str.at x 12) "b")))
(assert (str.contains y "re on"))
(assert (or (not (str.contains x "extmen")) (str.suffixof "k>" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(.+)$"))))
(check-sat)
