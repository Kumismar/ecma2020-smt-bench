; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;META HTTP-EQUIV=\""Set-Cookie\"" Content=\""USERID=&lt;SC\u{10348}RIPT&gt;alert('XSS')\u{1f600}&lt;/SCRIPT&gt;\""&gt;") (= x "<strong id=x tabindex=1 onfocus=alert(1)></strong>") (= x "<big ondblclick=""alert(1)"">test</big>")))
(assert (or (= z "tionstart=""alert(1)""></rp>") (= z "t(1)>") (= z "abindex=1 onbeforeactivate=alert(1)></content>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "st</" 0) 29) (str.suffixof ";\""&gt;" x)))
(assert (or (= (str.indexof z "ar" 0) 6) (str.suffixof ">" z) (= ">" (str.substr z 25 1))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "(^\([0-9][1-9]\)[ ]?[0-9]{4,5}[ -][0-9]{4}$)|(^\+[0-9]{9,}$)|(^0[1-9]00[ ]?[0-9]{2,3}[ ]?[0-9]{4}$)"))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^([0-2]?[0-9]|3[01])$")))
(assert (or (= "ut autojavascript:cus>" (str.replace z "fo" "javascript:")) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\([0-9]{3}\)|[0-9]{3}-?)[0-9]{3}-?[0-9]{4}$"))) (not (= "></au" (str.substr z 43 5)))))
(assert (or (not (= "oad>" (str.substr z 17 7))) (not (= (str.len x) 50)) (= (str.at z 7) "&")))
(assert (not (= (str.len y) 55)))
(check-sat)
