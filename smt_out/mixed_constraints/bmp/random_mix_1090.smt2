; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<fieldset draggable=""true"" ondragend=""alert(1)"">test</fieldset>") (= x "<div draggable=""true"" contenteditable>drag me</div><hr ondragover=alert(1) contenteditable>drop here</hr>") (= x "<mark draggable=""true"" ondragend=""alert(1)"">test</mark>")))
(assert (or (= z "yframes x{}</style><code style=""animation-name:x"" onanimationend=""alert(1)""></code>") (= z "e=""alert(1)"">test</li>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "</li>" y) (not (= (str.at y 184) "o"))))
(assert (or (not (= "on" (str.substr x 27 2))) (not (= "<mark draggabl<b>=""true"" ondragend=""alert(1)"">test</mark>" (str.replace x "e" "<b>"))) (not (= (str.at x 12) "a"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^.{0,24}$"))) (not (= "ati" (str.substr z 56 3)))))
(assert (or (not (= (str.at z 32) "a")) (str.in_re y ((_ re.from_regex ecma2020) "(?=^.{8,20}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z]+[,.]?[ ]?|[a-z]+['-]?)+$"))) (str.suffixof "ere</hr>" x)))
(assert (or (not (= "ggable=""t" (str.substr x 9 9))) (not (str.prefixof "<" x))))
(check-sat)
