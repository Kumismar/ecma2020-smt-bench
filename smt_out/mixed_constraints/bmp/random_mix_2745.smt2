; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead id=x tabindex=1 onfocusin=alert(1)></thead>") (= x "<input oninput=alert(1) value=xss>") (= x "<STYLE>@import'http://ha.ckers.org/xss.css';</STYLE>")))
(assert (or (= z "footer>") (= z "test</area>") (= z "d=""alert(1)""></em>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "put=a" 0) 11)) (= (str.indexof y "i" 0) 1) (not (str.prefixof "<STYL" y))))
(assert (or (not (= "ni" (str.substr y 8 2))) (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9]).{8,128}$"))))
(assert (str.suffixof "er>" y))
(assert (not (str.contains (str.replace y "(1)" "") "ert ")))
(assert (or (not (str.contains (str.replace y "xss" """") "lue="">d=")) (str.suffixof "m>" y) (not (= (str.at z 17) ">"))))
(assert (= "<thalert(1)ad id=x tabindex=1 onfocusin=alert(1)></thead>footer>" (str.replace y "e" "alert(1)")))
(check-sat)
