; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><rtc ondrop=alert(1) contenteditable>drop here</rtc>") (= x "<script id=x tabindex=1 onbeforedeactivate=alert(1)></script><input autofocus>")))
(assert (or (= z "ing draggable=""true"" ondragstart=""alert(1)"">test</listing>") (= z """ ondragend=""alert(1)"">test</optgroup>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "ing>" z)) (str.in_re y ((_ re.from_regex ecma2020) "^([0-9]{4})\s?([A-Za-z]{2})$"))))
(assert (or (str.contains (str.replace x "d" " ") "ea  id=x") (not (= """alert" (str.substr z 33 6))) (str.contains (str.replace y "m" "<b>") " <b>e")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[\u{30a1}-\u{30f3}]+$"))) (= (str.at y 87) "a") (not (= (str.at z 26) "t"))))
(assert (or (not (= (str.indexof y "m" 0) 43)) (str.prefixof "<div drag" x)))
(assert (not (= (str.at z 55) "n")))
(check-sat)
