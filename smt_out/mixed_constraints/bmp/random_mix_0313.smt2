; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;XSS STYLE="";xss:expression(alert(';XSS';))"";>;") (= x "<rtc onmouseup=""alert(1)"">test</rtc>")))
(assert (or (= z ">DEF") (= z "=true;);"">") (= z "ion:color 10s"" ontransitioncancel=alert(1)></article>")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "..{1,}\s..+")))
(assert (not (= "<r" (str.substr y 0 2))))
(assert (or (not (str.suffixof "rue;);"">" y)) (= (str.indexof x "a" 0) 16) (not (str.in_re x ((_ re.from_regex ecma2020) "[-+]?(180(\.0+)?|((1[0-7]\d)|([1-9]?\d))(\.\d+)?)")))))
(assert (or (str.contains x "d=alert(1)") (>= (str.len z) 1) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&#])[A-Za-z\d@$!%*?&#]{8,}$")))))
(assert (or (not (= (str.indexof z "em>" 0) 23)) (= (str.at y 18) "o")))
(check-sat)
