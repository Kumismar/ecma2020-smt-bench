; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onpaste=""alert(1)"" contenteditable>test</dfn>") (= x "<option onbeforepaste=""alert(1)"" contenteditable>test</option>")))
(assert (or (= z "ntransitionrun=alert(1)></spacer>") (= z "</ins>") (= z "ndex=1 onbeforeactivate=alert(1)></del>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!#^\-%*?_&])[A-Za-z\d@$!#^\-%_*?&]{6,}"))) (str.contains x "ditable>") (not (str.contains (str.replace y "est" "x") "tx<"))))
(assert (or (str.contains x "onten") (not (= (str.indexof z "e=a" 0) 22)) (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{10,15}"))))
(assert (not (str.contains x "ert(")))
(assert (= (str.at y 48) "n"))
(assert (or (not (<= (str.len z) 14)) (str.prefixof "</ins" z) (>= (str.len z) 73)))
(assert (not (str.contains (str.replace x " onbe" "alert(1)") "nalert(1)forep")))
(assert (or (not (= (str.len z) 39)) (str.suffixof ">" y)))
(check-sat)
