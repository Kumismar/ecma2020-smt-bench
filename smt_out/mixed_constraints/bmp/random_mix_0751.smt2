; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script\x09type=""text/javascript"">javascript:alert(1);</script>") (= x "<META HTTP-EQUIV=""Link"" Content=""<%(css)s>; REL=stylesheet"">")))
(assert (or (= z "alert(1)"">test</body>") (= z "rror=aler\u{1f4a9}t(3)//"">//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[^\d]{3,}")) (str.prefixof "<script\x0" x) (str.suffixof "div>" y)))
(assert (or (not (= (str.at y 41) "i")) (not (str.contains x "REL=style"))))
(assert (or (not (str.prefixof "<script" x)) (not (= (str.at z 26) ">"))))
(assert (or (= "t" (str.substr x 30 1)) (not (= "ipt\x09ty" (str.substr y 4 9))) (str.contains x "img src")))
(assert (= (str.indexof y "]" 0) 90))
(assert (or (not (= (str.indexof z """" 0) 7)) (str.contains z "alert") (= (str.len z) 37)))
(assert (not (= (str.indexof y "s" 0) 37)))
(check-sat)
