; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside onmouseenter=""alert(1)"">test</aside>") (= x "<aside onkeydown=""alert(1)"" contenteditable>test</aside>")))
(assert (or (= z "(1) value=""XSS"" autofocus>") (= z "py=""alert(1)"" contenteditable>test</slot>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 34) "/")) (= (str.at x 18) "r")))
(assert (= ")" (str.substr y 45 1)))
(assert (or (not (= "<aside onmouseenter=""alerjavascript:1)"">test</aside>" (str.replace x "t(" "javascript:"))) (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-\.\+]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9,.'\- ]*$")) (not (str.contains y "est</asi")) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*\d)(?=.*[A-Z])(?=.*[a-z])[0-9A-Za-z]{8,}$")))))
(assert (not (str.prefixof "(1)" z)))
(check-sat)
