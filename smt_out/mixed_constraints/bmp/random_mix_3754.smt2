; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp onmouseup=""alert(1)"">test</xmp>") (= x "<style>:target {color: red;}</style><menuitem id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></menuitem>") (= x "<img draggable=""true"" ondragenter=""alert(1)"">test</img>")))
(assert (or (= z "nd oncontextmenu=""alert(1)"">test</bgsound>") (= z "onerror=\x09javascript:alert(1)\x09src=xxx:x />")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "g>" x)) (str.prefixof "<ul dr" y) (not (= (str.at y 11) "g"))))
(assert (str.contains y "nd onco"))
(assert (or (str.contains (str.replace x "r: re" "x") "oloxd;}</") (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z]{5})(\d{4})([a-zA-Z]{1})|([a-zA-Z]{1})(\d{5})([a-zA-Z]{2})(\d{4})([a-zA-Z]{3})(\d{6})$")))))
(assert (or (str.prefixof "o" z) (= (str.at z 12) "h")))
(assert (or (not (= (str.indexof x """ale" 0) 15)) (not (= (str.indexof z "ert" 0) 25))))
(assert (not (= "er" (str.substr y 18 2))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^12$"))))
(assert (or (= "plate " (str.substr y 4 6)) (not (str.suffixof "e src>" x))))
(check-sat)
