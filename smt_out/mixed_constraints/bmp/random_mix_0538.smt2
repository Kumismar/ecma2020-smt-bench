; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside onbeforecopy=""alert(1)"" contenteditable>test</aside>") (= x """></iframe><script>alert(`TEXT YOU WANT TO BE DISPLAYED`);</script><iframe frameborder=""0%EF%BB%BF")))
(assert (or (= z "\x00>javascript:alert(1)</script>") (= z "eo onmousemove=""alert(1)"">test</video>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "</br>" "") ">") (not (str.in_re x ((_ re.from_regex ecma2020) "^\d+(\.\d+)?"))) (str.suffixof "</SCRIPT>" z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-9]{16}|\*{12}[0-9]{4})$"))) (not (str.suffixof ">" y)) (= (str.at z 21) "(")))
(assert (not (str.contains (str.replace y "der=""" "javascript:") "orjavascript:0%E")))
(assert (or (= (str.at x 17) "t") (str.prefixof "\x00>" z) (= """></iframe><script>alert(`TEXT YOU WANjavascript:BE DISPLAYED`);</script><iframe frameborder=""0%EF%BB%BF\x00>javascript:alert(1)</script>" (str.replace y "T TO " "javascript:"))))
(assert (or (not (str.contains y "le")) (not (str.suffixof "rm>" y))))
(check-sat)
