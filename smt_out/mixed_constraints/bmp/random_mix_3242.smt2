; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd ondblclick\u{1f4a9}=""alert(1)"">test</d\u{1d400}d>") (= x "<sub onmousemove=""alert(1)"">test</sub>")))
(assert (or (= z "te>") (= z "utofocus>") (= z "t:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "id=""fu" (str.substr y 61 6))) (not (= (str.indexof x "dd o" 0) 1)) (not (str.contains x "<dd o"))))
(assert (or (not (= (str.at x 17) """")) (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{9,13}$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[+]?[0-9-\s()]*$")))))
(assert (or (= (str.indexof z "t</a" 0) 44) (not (= """>test" (str.substr y 26 6)))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(?:0|(?:\+|00) ?[0-9]{1,2} ?)(?:(?:[1-9] ?(?:[0-9] ?){8})|(?:6 ?-? ?[1-9] ?(?:[0-9] ?){7})|(?:[1,2,3,4,5,7,8,9]\d ?-? ?[1-9] ?(?:[0-9] ?){6,8})|(?:[1,2,3,4,5,7,8,9]\d{2} ?-? ?[1-9] ?(?:[0-9] ?){5}))$"))))
(assert (= "ualert(1)ofocus>" (str.replace z "t" "alert(1)")))
(assert (or (not (str.prefixof "<sub" x)) (str.contains z "te>")))
(assert (= ">" (str.substr x 37 4)))
(check-sat)
