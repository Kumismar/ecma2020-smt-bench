; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x contenteditable onkeypress=alert(1)>press any key!") (= x "<script>javascript:alert(1)</script>")))
(assert (or (= z "enteditable>drop here</th>") (= z "onjour !"");") (= z "e"" ondrag=""alert(1)"">test</big>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len x) 36)))
(assert (or (not (= (str.indexof y "er" 0) 21)) (not (= "dex=1" (str.substr x 14 5))) (str.contains y "itable")))
(assert (str.in_re x ((_ re.from_regex ecma2020) "\d [0-9]")))
(assert (= "entedi" (str.substr x 7 6)))
(assert (not (str.suffixof "</script>" x)))
(assert (or (not (>= (str.len z) 22)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(https?:\/\/)?[-a-z0-9]+(\.[-a-z0-9]+)+(\/[-a-z0-9@:%_+.,~#?&=]+)*\/?$"))) (not (= ">javasc" (str.substr y 7 7)))))
(assert (or (<= (str.len y) 70) (str.prefixof "<x " y)))
(check-sat)
