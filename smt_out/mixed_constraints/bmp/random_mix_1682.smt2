; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><progress id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></progress>") (= x "<li draggable=""true"" ondragstart=""alert(1)"">test</li>")))
(assert (or (= z "er>") (= z ")"" contenteditable>test</td>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "t(1)"))
(assert (or (str.prefixof ")"" content" z) (not (= ")"" contenteditable>tjavascript:</td>" (str.replace z "est" "javascript:")))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[a-z]{2,4}$")))
(assert (or (not (str.contains y "agstart=")) (not (>= (str.len y) 48)) (= (str.indexof z "r>" 0) 1)))
(assert (or (str.prefixof "<li d" x) (str.prefixof "<" y)))
(assert (= "ncancel=al" (str.substr y 91 10)))
(check-sat)
