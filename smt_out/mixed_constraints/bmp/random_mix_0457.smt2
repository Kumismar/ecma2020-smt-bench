; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time draggabl\u{1f600}e=""true"" ondragend=""alert(1)"">test</time>") (= x "<;SCRIPT>;a=/XSS/") (= x "<strike onpaste=""alert(1)"" contenteditable>test</strike>")))
(assert (or (= z "ss:expression(alert(';XSS';))"";>;") (= z "e onmouseup=""alert(1)"">test</article>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 17) "a") (= (str.indexof z "t" 0) 17) (str.in_re z ((_ re.from_regex ecma2020) "^(?:0|(?:\+|00) ?31 ?)(?:(?:[1-9] ?(?:[0-9] ?){8})|(?:6 ?-? ?[1-9] ?(?:[0-9] ?){7})|(?:[1,2,3,4,5,7,8,9]\d ?-? ?[1-9] ?(?:[0-9] ?){6})|(?:[1,2,3,4,5,7,8,9]\d{2} ?-? ?[1-9] ?(?:[0-9] ?){5}))$"))))
(assert (or (not (= (str.len z) 27)) (not (>= (str.len z) 27))))
(assert (or (str.suffixof "/XSS/" x) (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z][a-zA-Z\\s]+$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{1,3}$"))) (str.contains y "ue"" on")))
(check-sat)
