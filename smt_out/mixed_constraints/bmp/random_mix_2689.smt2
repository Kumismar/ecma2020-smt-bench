; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><div onload=alert(1)></div>") (= x "<hr draggable=""true"" ondragenter=""alert(1)"">test</hr>") (= x "&lt;A HREF=&quot;javascript:document.location=&apos;http://www.google.com/&apos;&quot;&gt;XSS&lt;/A&gt;")))
(assert (or (= z "contenteditable>test</figure>") (= z "<input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z-0-9]+$")) (not (= "<d" (str.substr x 5 2)))))
(assert (str.contains (str.replace z "put a" " ") "<in ut"))
(assert (not (str.prefixof "<hr dra" y)))
(assert (or (not (str.prefixof "<svg><div " x)) (= (str.at x 77) "o")))
(assert (= "1)"">te" (str.substr x 24 6)))
(assert (not (= (str.at x 5) "<")))
(assert (or (not (= (str.at y 80) "&")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-\u{17e}0-9-:&.'_ ]{2,}$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[\d]{4}"))))
(check-sat)
