(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input type=image src=validimage.png onload=alert(1)>") (= x "<style>@keyframes x{}</style><head style=""animation-name:x"" onanimationstart=""alert(1)""></head>")))
(assert (or (= z "&quot;stylesheet&quot; HREF=&quot;http://ha.ckers.org/xss.css&quot;&gt;") (= z "r:red;}</style><figure id=x style=""transition:color 1s"" ontransitionend=alert(1)></figure>") (= z " draggable=""true"" ondragstart=""alert(1)"">test</ol>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 43) "=") (not (str.contains x "c=valid"))))
(assert (or (not (= (str.at z 10) "t")) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]{4,15}$")) (not (str.in_re z ((_ re.from_regex ecma2020) ".{3,35}")))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}]+$")) (str.suffixof "uot;&gt;" z)))
