; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><time id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></time>") (= x "<th onkeypress=""alert(1)"" contenteditable>test</th>") (= x "<small onkeypress=""alert(1)"" contenteditable>test</small>")))
(assert (or (= z ">test</q>") (= z ">drop here</shadow>") (= z "type=submit>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "est</q>" y))
(assert (or (= "s" (str.substr x 16 1)) (str.contains (str.replace x "ss" "") "re=""al") (not (= (str.indexof x """al" 0) 18))))
(assert (or (<= (str.len z) 25) (not (= (str.at y 89) " "))))
(assert (= "sma" (str.substr y 1 3)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[+]?[\s./0-9]*[(]?[0-9]{1,4}[)]?[-\s./0-9]*$")) (str.in_re x ((_ re.from_regex ecma2020) "(?=^[A-Za-z0-9]{6,12}$)((?=.*[A-Z])(?=.*[a-z])(?=.*[0-9]))^.*$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^([\+]\d{11,13})$")) (= ">" (str.substr z 18 9)) (not (str.contains (str.replace x "e>:t" "x") "lxa"))))
(assert (str.prefixof "<svg>" y))
(check-sat)
