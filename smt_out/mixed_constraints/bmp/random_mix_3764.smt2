; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onmouseenter=""alert(1)"">test</rtc>") (= x "<STYLE>BODY{-moz-binding:url(""http://ha.ckers.org/xssmo\u{1f600}z.xml#xss"")}</STYLE>")))
(assert (or (= z "on>") (= z "activate=alert(1)></menuitem><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<rtc onmouseenter=""alert(1)"">test</rtc>acalert(1)vate=alert(1)></menuitem><input id=y autofocus>" (str.replace y "ti" "alert(1)"))) (str.prefixof "<rtc onmo" y)))
(assert (or (= (str.at x 41) "k") (= (str.len y) 42) (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-z\u{119}\u{f3}\u{105}\u{15b}\u{142}\u{17c}\u{17a}\u{107}\u{144}\u{118}\u{d3}\u{104}\u{15a}\u{141}\u{17b}\u{179}\u{106}\u{143}0-9 -/]){5,}$")))))
(assert (or (str.contains x "xml#xss") (= (str.at z 25) "t")))
(assert (or (not (= (str.at y 21) "e")) (not (str.prefixof "<STYLE>BO" x))))
(check-sat)
