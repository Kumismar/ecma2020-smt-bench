; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option onkeyup=""alert(1)"" contenteditable>test</option>") (= x "<form><isindex formaction=""javascript&colon;confirm(1)""")))
(assert (or (= z "frameset><frame id=x onfocus=alert(1)>") (= z "ex>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "#0006") (= "onfirm(" (str.substr y 45 7))))
(assert (or (str.suffixof "alert(1)>" y) (not (= " id=x onfo" (str.substr z 15 10)))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-9 ]){4,4}$"))))
(assert (or (str.contains x "edi") (not (= (str.indexof z "x" 0) 1)) (str.contains z "eset><f")))
(assert (str.prefixof "<form><i" x))
(assert (not (str.prefixof "<form><is" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^((https?|ftp)://)?[^\s/$.?#]*\.[^\s]*$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[\u{5c}u4E00-\u{5c}u9FA5\u{5c}uf900-\u{5c}ufa2d\u{b7}s]{2,20}$"))))
(check-sat)
