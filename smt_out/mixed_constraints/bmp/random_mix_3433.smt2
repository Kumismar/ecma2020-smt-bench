; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><object style=""animation-name:x"" onanimationend=""alert(1)""></object>") (= x "<isindex onbeforecopy=""alert(1)"" contenteditable>test</isin\u{1f600}dex>") (= x "<base onmouseover=""alert(1)"">test</base>")))
(assert (or (= z "/") (= z ">") (= z "tabindex=1 onactivate=alert(1)></th>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 1) "s") (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{5}(?:[\s-]\d{4})?$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\d\s]+$"))))
(assert (not (str.contains z "/")))
(assert (or (not (= (str.indexof y "=""al" 0) 17)) (not (str.contains y "isi"))))
(assert (or (not (= (str.len x) 40)) (not (= (str.at x 15) "e")) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z\u{c9}\u{e9}\u{c1}\u{e1}\u{f3}\u{d3}\u{ed}\u{cd}\u{fa}\u{da}]{2}[a-zA-Z\u{c9}\u{e9}\u{c1}\u{e1}\u{f3}\u{d3}\u{ed}\u{cd}\u{fa}\u{da}]+(([',. -][a-zA-Z\u{c9}\u{e9}\u{c1}\u{e1}\u{f3}\u{d3}\u{ed}\u{cd}\u{fa}\u{da} ])?[a-zA-Z\u{c9}\u{e9}\u{c1}\u{e1}\u{f3}\u{d3}\u{ed}\u{cd}\u{fa}\u{da}]*)*$")))))
(assert (or (not (>= (str.len x) 92)) (str.suffixof "/base>" x) (= (str.indexof y ">tabi" 0) 96)))
(assert (str.prefixof "<isindex" y))
(check-sat)
