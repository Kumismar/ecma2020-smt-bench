; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><svg id=x style=""transition:color 1s"" ontransitionend=alert(1)></svg\u{1f4a9}>") (= x "<menuitem oncopy=""alert(1)"" contenteditable>test</menuitem>")))
(assert (or (= z "frame>") (= z "e>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "/deta" z))
(assert (or (>= (str.len x) 96) (str.suffixof ">aside>" y)))
(assert (or (= "<style>:target {color:red;}</style><svg id=x style=""transition:color 1s"" ansitionend=alert(1)></svg\u{1f4a9}>" (str.replace x "ontr" "")) (str.contains y "py=""al") (not (str.contains x " oncop"))))
(assert (or (= "t(1)" (str.substr x 40 4)) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z\u{fc}\u{f6}\u{e4}\u{dc}\u{d6}\u{c4}\u{df} ]+")))))
(check-sat)
