; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<label draggable=""true"" ondrag=""alert(1)"">test</label>") (= x "<button onbeforepaste=""alert(1)"" contenteditable>test</button>") (= x "<s onmouseleave=""alert(1)"">test</s>")))
(assert (or (= z " id=y autofocus>") (= z "ame src=http&#58;//ha&#46;ckers&#46;org/scriptlet&#46;html&gt;") (= z "ave=""alert(1)"">test</colgroup>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "es" 0) 28))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9]\d*$"))))
(assert (or (not (= (str.at y 51) "s")) (not (str.suffixof "p>" y))))
(assert (or (not (= "l"" da" (str.substr z 15 5))) (= (str.at x 79) "e")))
(assert (or (not (<= (str.len x) 69)) (<= (str.len y) 87) (str.prefixof "<label dra" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\s]+(?:[a-zA-Z0-9-\s])+(?:[a-zA-Z0-9\s])$"))) (str.suffixof "est</s>" x)))
(check-sat)
