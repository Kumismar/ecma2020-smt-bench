; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script src=""//brutelogic.com.br&so\u{1d400}l;1.js&num;") (= x "<i id=x tabindex=1 ondeactivate=alert(1)></i><input id=y autofocus>")))
(assert (or (= z " onbeforedeactivate=alert(1)></samp><input autofocus>") (= z "et {color:red;}</style><svg id=x style=""transition:color 1s"" ontransitionend=alert(1)></svg\u{1f4a9}>") (= z "onmouseout=""alert(1)"">test</ul>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof " onbe" z))
(assert (or (not (= (str.indexof x "ndex" 0) 12)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[a-zA-Z0-9]+([\-\.]{1}[a-zA-Z0-9]+)*\.[a-z]{2,5}(:[0-9]{1,5})?(\/.*)?$")))))
(assert (or (not (str.contains (str.replace y "t {" """") ">e""col")) (not (str.in_re z ((_ re.from_regex ecma2020) "^([0-9]{5})(?:[-s]*([0-9]{4}))?$"))) (not (str.contains x "js&nu"))))
(assert (not (= "o" (str.substr y 7 1))))
(assert (not (str.contains (str.replace z "e=al" """") "vat""er")))
(check-sat)
