; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav onblur=alert(1) tabindex=1 id=x></nav><input autofocus>") (= x "&lt;XSS STYLE=\""xss&#58;expression(alert('XSS'))\""&gt;") (= x "<strong onmouseleave=""alert(1)"">test</strong>")))
(assert (or (= z "ndrop=alert(1) contenteditable>drop here</i>") (= z "onload=alert(1)></base>") (= z "tbody>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "></base>" z) (not (= (str.indexof y "t au" 0) 48)) (= "<nav onblur=alert(1) tabiex=1 id=x></nav><input autofocus>ndrop=alert(1) contenteditable>drop here</i>" (str.replace y "nd" ""))))
(assert (str.contains x "selea"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z'* ]+"))) (= (str.len x) 45) (not (str.in_re y ((_ re.from_regex ecma2020) "[A-za-z\u{e9}\u{10d}\u{148}\u{155}\u{11b}\u{16f}0-9]{0,}")))))
(assert (or (str.contains z "tbody>") (str.in_re z ((_ re.from_regex ecma2020) "^1[3456789]\d{9}$")) (not (str.suffixof "))\""&gt;" x))))
(assert (str.suffixof ">" z))
(check-sat)
