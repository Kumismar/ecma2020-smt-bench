; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{10348}&#X03c") (= x "<embed type=""image"" src=%(scriptlet)s></embed>")))
(assert (or (= z "=""alert(1)"">test</spacer>") (= z "script:alert(<WBR>'XSS');"">")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 31) (not (= "pt:" (str.substr y 11 3)))))
(assert (str.contains y "#X03cscri"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9\s-]{10,10}"))))
(assert (or (str.contains (str.replace x "3c" "x") "&#X0x") (str.suffixof "X03c" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "([2]([7]([2]([3]([2])|[4]([5689])|[5]([124579]))|[3]([0]([5])|[1]([8])|[2]([47])|[3]([036])))|[9]([6]([9]([03]))))|[3]([0]([8]([2]([367])|[5]([135])|[9]([0]))|[9]([0]([0])|[2]([6])|[8]([9])))|[1]([5]([1]([5])|[3]([5])|[4]([27])|[5]([59])|[8]([28])|[9]([25]))|[6]([0]([034689])|[1]([389])|[2]([1236789])|[3]([234678])))|[2]([4]([6]([9]))))|[4]([9]([4]([1]([9])|[5]([3])))))"))) (not (str.prefixof "=""a" z)) (not (str.contains z "sc"))))
(assert (or (= (str.indexof z "rt(" 0) 12) (not (= "scr" (str.substr x 26 3)))))
(assert (not (str.suffixof ");"">" y)))
(check-sat)
