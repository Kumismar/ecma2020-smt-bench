; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee/onstart=alert()>") (= x "<bdi onfocusout=alert(1) tabindex=1 id=x></bdi><input autofocus>")))
(assert (or (= z "ition:color 1s"" ontransitionend=alert(1)></noembed>") (= z "0.1\u{2193}//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "]]>]</div>" y) (not (= (str.at z 13) "s")) (not (= (str.len y) 115))))
(assert (or (not (str.prefixof "<bd" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(((0?[1-9]|1[012])/(0?[1-9]|1\d|2[0-8])|(0?[13456789]|1[012])/(29|30)|(0?[13578]|1[02])/31)/(19|[2-9]\d)\d{2}|0?2/29/((19|[2-9]\d)(0[48]|[2468][048]|[13579][26])|(([2468][048]|[3579][26])00)))$")))))
(assert (or (str.contains x "rt=aler") (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z]+(?:\s[A-Za-z]+)+$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(14)$"))))
(check-sat)
