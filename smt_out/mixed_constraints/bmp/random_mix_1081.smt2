; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x0Cjavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<noframes onbeforecopy=""alert(1)"" contenteditable>test</noframes>") (= x "<th ondblclick=""alert(1)"">tes\u{1d400}t</th>")))
(assert (or (= z "enteditable>test</html>") (= z "est</figcaption>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z -]+$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "(^[1][3578][0-9]{9}$)|(^0\d{2,3}\d{7,8}$)")))))
(assert (or (str.suffixof "tion>" z) (not (= (str.at z 8) "b")) (not (str.contains x "db"))))
(assert (or (= (str.at x 24) "j") (not (= (str.at x 21) "y"))))
(assert (not (= (str.indexof z "t</f" 0) 2)))
(check-sat)
