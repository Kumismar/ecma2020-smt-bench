; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;STYLE TYPE=\""text/javascript\""&gt;alert('XSS');&lt;/STYLE&gt;") (= x "<ol draggable=""true"" ondrag=""alert(1)"">test</ol>")))
(assert (or (= z "ym id=x tabindex=1 onfocus=alert(1)></acronym>") (= z "nd onmouseup=""alert(1)"">test</command>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 27) "c") (= (str.at z 0) "s")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{8,10}$"))) (not (>= (str.len x) 55)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(13[0-9]|14[5|7]|15[0|1|2|3|5|6|7|8|9]|18[0|1|2|3|5|6|7|8|9])\d{8}$")))))
(assert (or (not (str.contains z "lert(1)""")) (str.contains (str.replace z "cus" "") "o=")))
(assert (not (= "t/ja" (str.substr x 20 4))))
(assert (or (= (str.indexof x "g" 0) 35) (not (= (str.indexof x "&lt" 0) 0))))
(assert (or (str.suffixof "l>" x) (not (= (str.at y 84) "d")) (str.contains x """>")))
(check-sat)
