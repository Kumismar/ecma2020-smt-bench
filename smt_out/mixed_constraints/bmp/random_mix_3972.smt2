; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><content id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></content>") (= x "<style>:target {color: red;}</style><form id=x style=""transition\u{1d400}:color 10s"" ontransitioncancel=alert(1)></form>")))
(assert (or (= z ">") (= z ";")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451} ]{1,15}"))) (= (str.indexof x "x s" 0) 47) (not (= (str.at z 0) ">"))))
(assert (= """tra" (str.substr x 53 4)))
(assert (or (not (= "e=""tran" (str.substr y 51 7))) (not (<= (str.len y) 187))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^0[0-9]{8,9}"))) (not (= (str.indexof y "fo" 0) 37)) (str.contains y "et {tran")))
(assert (or (= "r 10s"" ont" (str.substr x 70 10)) (not (str.suffixof "tent>;" y)) (not (<= (str.len y) 152))))
(assert (= (str.at x 8) "t"))
(check-sat)
