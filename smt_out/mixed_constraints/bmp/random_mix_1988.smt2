; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext id=x tabindex=1 onactivate=alert(1)></plaintext>") (= x "</XSS/*-*/STYLE=xss:e/**/xpression(alert('XSS'))>") (= x "<th onblur=alert(1) tabindex=1 id=x></th><input autofocus>")))
(assert (or (= z "gt;=&amp;{()}") (= z "ror=alert(XSS)//"">")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^\d+.*$"))))
(assert (not (<= (str.len x) 62)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) ".{6,7}"))) (str.contains z "t;=&amp;{(")))
(assert (or (= (str.len y) 77) (= "xt id=" (str.substr x 8 6))))
(assert (or (not (= (str.at x 28) ")")) (not (str.in_re x ((_ re.from_regex ecma2020) "[a-z0-9._+-]+@[a-z0-9.-]+\.[a-z]{2,4}$")))))
(assert (= (str.at x 43) "("))
(check-sat)
