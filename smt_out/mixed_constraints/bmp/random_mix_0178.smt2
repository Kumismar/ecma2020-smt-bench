; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext onkeydown=""alert(1)"" contenteditable>test</plaintext>") (= x "<style>:target {transform: rotate(180deg);}</style><code id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></code>") (= x "<th draggable=""true"" ondragleave=""alert(1)"">test</th>")))
(assert (or (= z "ough=""alert(String.fromCharCode(88,83,83))"">") (= z "useleave=""alert(1)"">test</small>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 14) "s") (not (str.prefixof "<plaintext" y)) (= (str.at z 24) "h")))
(assert (or (not (= (str.indexof x "h dra" 0) 2)) (str.in_re x ((_ re.from_regex ecma2020) "^[A-Z0-9 _]*$")) (str.suffixof "est</th>" x)))
(assert (or (= "e" (str.substr z 10 1)) (not (= (str.indexof z "3" 0) 36))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-z]+([\s][a-zA-Z]+)*$"))))
(assert (or (not (str.contains (str.replace x "l" "javascript:") "gabjavascript:e=""tr")) (not (= (str.at y 2) "h")) (= "us leave=""alert(1)"">test</small>" (str.replace z "e" " "))))
(assert (= (str.indexof z "Ch" 0) 23))
(check-sat)
