; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onfocus=javascript:alert(1) autofocus>") (= x "<template onkeydown=""alert(1)"" contenteditable>test</temp\u{20000}lat\u{1f4a9}e>")))
(assert (or (= z "teditable>drop here</caption>") (= z "pre id=x tabindex=1 onbeforedeactivate=alert(1)></pre><input autofocus>") (= z "><script>alert(/xss/)</script>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len x) 45)))
(assert (or (not (= (str.at z 17) "r")) (not (str.contains y "s=javascri")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]+[a-z A-Z]*$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{17}$"))))
(assert (or (str.suffixof "autofocus>" x) (not (= (str.indexof x "b" 0) 7)) (not (= (str.at x 57) "\u{20000}"))))
(assert (not (>= (str.len z) 28)))
(assert (or (not (str.contains x """alert(")) (= "d onbefor" (str.substr y 7 9)) (= (str.indexof y "vasc" 0) 17)))
(assert (or (not (str.contains y "t auto")) (= (str.at z 20) "o")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z.]*"))))
(check-sat)
