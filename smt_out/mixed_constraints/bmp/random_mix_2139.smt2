(assert (or (= "<button  x tabindex=1 onbeforeactivate=alert(1)></button>rt(1);</script>" (str.replace y "id=" " ")) (str.prefixof "rt(1" z)))
(assert (or (= "=""xlink:href"" bejavascript:accessKey(b)"" to=""//example.com/?b"" />" (str.replace z "gin=""" "javascript:")) (= (str.indexof x "c" 0) 3)))
(check-sat)
