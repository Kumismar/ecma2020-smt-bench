; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script oncut=""alert(1)"" contente\u{10348}dita\u{20000}ble>test</script>") (= x "<\u{1d400}script>alert(String.fromCharCode(88,83,83))</script>") (= x "<button id=x tabindex=1 onbeforeactivate=alert(1)></button>")))
(assert (or (= z "nter=""alert(1)"">test</div>") (= z "=""xlink:href"" begin=""accessKey(b)"" to=""//example.com/?b"" />") (= z "rt(1);</script>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[0-9\() ]{9,}")) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z-\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd}\u{fffd} ]{1,20}$"))))
