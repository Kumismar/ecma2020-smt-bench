; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet onmousemove=""alert(1)"">test</applet>") (= x "<option onblur=alert(1) tabindex=1 id=x></option><input autofocus>")))
(assert (or (= z "ion>") (= z "lert(1)></input>") (= z "down=""alert(1)"">test</map>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{9,}$"))) (<= (str.len x) 50) (= "down=""alert(xtest</map>" (str.replace z "1)"">" "x"))))
(assert (or (= (str.at x 40) "l") (not (str.suffixof "ne;" y))))
(assert (or (not (= (str.indexof z ")></i" 0) 6)) (not (str.prefixof "<appl" y)) (not (= "pplet on" (str.substr y 2 8)))))
(assert (= "<applt onmousemove=""alert(1)"">test</applet>down=""alert(1)"">test</map>" (str.replace y "e" "")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{3}|[0-9]{1,3})(\]?)$"))))
(check-sat)
