; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element id=x tabindex=1 ondeactivate=alert(1)></element><input id=y autofocus>") (= x "<progress onmousele\u{10348}ave=""alert(1)"">test</p\u{1d400}rogress>")))
(assert (or (= z " style=""x:\xE2\x80\x85expression(javascript:alert(1)"">DEF") (= z " onkeypress=""alert(1)"" contenteditable>test</menuitem>") (= z "#X0\u{10348}0003c;")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "<pro")))
(assert (or (not (str.contains z "1)""")) (not (= (str.at y 40) "/"))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[1-9]\d{7,9}$")))
(assert (or (= (str.len y) 136) (str.contains (str.replace z "ita" "x") "entedxble>") (not (str.contains x "ress>"))))
(assert (not (= "ansiti" (str.substr z 11 6))))
(assert (str.prefixof "<eleme" x))
(check-sat)
