; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea oncontextmenu=""alert(1)"">test</textarea>") (= x "<header oncontextmenu=""alert(1)"">test</header>") (= x "<SCRIPT> alert(\u{201c}XSS\u{201d}); </SCRIPT>")))
(assert (or (= z "nrun=alert(1)></audio>") (= z "=1 ondeactivate=alert(1)></rb><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "t</header>" x)) (not (= "ert(" (str.substr z 7 4))) (not (= (str.len y) 102))))
(assert (or (not (= "<javascript:RIPT> alert(\u{201c}XSS\u{201d}); </SCRIPT>" (str.replace x "SC" "javascript:"))) (= (str.indexof z "i" 0) 10) (not (str.contains y "ar"))))
(assert (= "ext" (str.substr y 14 3)))
(assert (not (<= (str.len y) 68)))
(assert (or (= (str.indexof y " </" 0) 22) (not (str.in_re x ((_ re.from_regex ecma2020) "^[-a-z0-9!#$%&'*+\/=?^_`{|}~]+(\.[-a-z0-9!#$%&'*+\/=?^_`{|}~]+)*@(([a-z0-9]([-a-z0-9]*[a-z0-9]+)?){1,63}\.)+([a-z0-9]([-a-z0-9]*[a-z0-9]+)?){2,63}$")))))
(assert (= (str.indexof y "autof" 0) 88))
(check-sat)
