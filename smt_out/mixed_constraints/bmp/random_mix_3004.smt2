; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=# onmouseover=""alert('xxs')"">") (= x "<script a="">"" SRC=""http://www.securitycompass.com/xss.js""></script>") (= x "<i onpaste=""alert(1)"" contenteditable>test</i>")))
(assert (or (= z "t</blockquote>") (= z "binding: url([link to code]);"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/script>" x)) (= "<script a="">"" SRC=""http://""securitycompass.com/xss.js""></script>" (str.replace x "www." """"))))
(assert (= (str.at z 5) "n"))
(assert (or (not (= "</blockq" (str.substr z 1 8))) (not (str.suffixof ");"">" z))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{6,}$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][0-9\u{142}\u{15b}\u{17c}\u{f3}\u{105}\u{119}\u{144}\u{107}a-zA-Z-._\- ]*$")))))
(assert (or (str.prefixof "<IMG SRC=#" y) (str.suffixof "t('xxs')"">" x)))
(check-sat)
