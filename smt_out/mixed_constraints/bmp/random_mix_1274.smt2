; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><set onend=alert(1) attributename=x dur=1s>") (= x "<script ondblclick=""alert(1)"">test</script>")))
(assert (or (= z "ter=""alert(1)"">test</tbody>") (= z "id=x tabindex=1 onbeforeactivate=alert(1)></plaintext>") (= z "ick=""alert(1)"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (= ")"">test</" (str.substr y 27 9))) (not (str.suffixof "cript>" x))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z\s]{3,})$"))) (not (str.prefixof "<s" y))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[0]*[1-9][0-9]{0,5}$")) (not (str.suffixof "wbr>" z)) (not (str.prefixof "<svg><s" x))))
(assert (or (not (= (str.indexof x "ion" 0) 63)) (str.contains (str.replace x "ag" "javascript:") "mjavascript:e ") (not (str.in_re z ((_ re.from_regex ecma2020) "^.+@.+.[a-zA-Z]{2,63}$")))))
(check-sat)
