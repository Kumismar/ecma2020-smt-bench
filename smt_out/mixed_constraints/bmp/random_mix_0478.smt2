; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datali\u{1f600}st onmouseenter=""aler\u{1f600}t(1)"">test</datalist>") (= x "<aside onmouseover=""alert(1)"">test</aside>") (= x "<html onmouseenter=""alert(1)"">test</html>")))
(assert (or (= z "(1)"">test</em>") (= z "gen id=x onfocus=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<a" y)) (= "<aside onjavascript:seover=""alert(1)"">test</aside>gen id=x onfocus=alert(1)>" (str.replace y "mou" "javascript:"))))
(assert (or (str.contains y "de>(") (not (str.contains x "ver="))))
(assert (or (not (= "gen id=x onfoxlert(1)>" (str.replace z "cus=a" "x"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z ]{2,50}$"))) (= (str.indexof z "test" 0) 10)))
(assert (or (= "<ht" (str.substr y 0 3)) (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@(?!gmail.com)(?!yahoo.com)(?!hotmail.com)(?!hotmail.co.il)(?!walla.co.il)(?!mail.ru)(?!outlook.com)(?!email.com)(?!icloud.com)(?!me.com)[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$")) (= "t(1" (str.substr y 30 3))))
(check-sat)
