; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x16javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<noframes onpaste=""alert(1)"" contenteditable>test</noframes>")))
(assert (or (= z "oncut=""alert(1)"" contenteditable>test</i>") (= z "onbeforedeactivate=alert(1)></output><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "beforedea" (str.substr z 2 9))) (= "<noframes onpaste=""alert(1)"" contenteditable>tes oframes>" (str.replace x "t</n" " "))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(\s)*([0-9]{3})(\s)*([0-9])(\s)*([0-9])(\s)*([0-9]{2})(\s)*([0-9]{1})(\s)*([0-9]{3})(\s)*$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[-+]?(180(\.0+)?|((1[0-7]\d)|([1-9]?\d))(\.\d+)?)"))) (str.contains y "=alert(1)>") (not (str.suffixof "t</i>" z))))
(assert (or (not (str.suffixof "ocus>" z)) (not (= (str.at y 28) " ")) (= (str.indexof x "aler" 0) 35)))
(assert (or (= (str.at z 2) "b") (not (str.contains (str.replace y "onten" """") " c""tedit"))))
(assert (or (= (str.indexof y "1)></" 0) 85) (>= (str.len z) 38)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) ".*^[A-Za-z0-9._]+@[A-Za-z0-9]+[.]+[A-Za-z]{2,5}$.*"))) (not (>= (str.len y) 45))))
(check-sat)
