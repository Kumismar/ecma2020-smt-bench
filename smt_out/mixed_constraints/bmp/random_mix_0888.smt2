; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article onbeforecut=""alert(1)"" contenteditable>test</article>") (= x "<del onkeydown=""alert(1)"" contenteditable>test</del>")))
(assert (or (= z "CharCode(88,83,83))"">") (= z " onclick=""alert(1)"">test</element>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "wn=""ale")) (str.contains z "8,83,") (not (= "rec" (str.substr y 15 3)))))
(assert (or (str.prefixof "<del " y) (str.in_re z ((_ re.from_regex ecma2020) "(?=.*[a-zA-Z])(?=.*[0-9]).*")) (not (str.prefixof "<del " x))))
(assert (or (not (str.contains (str.replace z "Cod" "alert(1)") "Charalert(1)e(88")) (not (str.suffixof "83))"">" y)) (not (= "<% foo><x foo=""%><script>alert(91)</script>"">//[""'`-->]]>]"">(1)"">test</dir>" (str.replace y "</div" """")))))
(assert (or (str.prefixof "<arti" x) (not (str.in_re z ((_ re.from_regex ecma2020) "^.{2,}$")))))
(assert (or (str.contains x "(1)"" cont") (not (= (str.indexof y "C" 0) 52))))
(check-sat)
