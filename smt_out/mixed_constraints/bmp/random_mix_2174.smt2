; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike id=x tabindex=1 onbeforedeactivate=alert(1)></strike><input autofocus>") (= x "<a href=""\xE2\x80\xA9javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<main onmouseover=""alert(1)"">test</main>")))
(assert (or (= z "lclick=""alert(1)"">test</output>") (= z "tabindex=1 onfocusin=alert(1)></applet>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z """X" 0) 12)) (not (str.prefixof "lclic" z))))
(assert (or (str.contains (str.replace z "</s" "<b>") "=eval<b>cript") (= "te=""ale" (str.substr x 15 7))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z,*\s]{1,50}$")) (= (str.indexof z "al" 0) 8) (not (= (str.len x) 40))))
(assert (or (str.suffixof "rt(1)>" z) (str.contains z "1)"">tes")))
(assert (or (= (str.indexof z "tes" 0) 5) (= (str.at x 11) "E")))
(check-sat)
