; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup id=x tabindex=1 onfocus=alert(1)></sup>") (= x "<tbody onkeypress=""alert(1)"" contenteditable>test</tbody>") (= x "<style>:target {transform: rotate(180deg);}</sty\u{10348}le><noscript id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></noscript>")))
(assert (or (= z "80deg);}</style><fieldset id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></fieldset>") (= z "progress onblur=alert(1) tabindex=1 id=x></progress><input autofocus>") (= z "(1) tabindex=1 id=x></bdo><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "et>" y)) (not (= "<style>@keyframes x{}</style><tfoot style=""animation-najavascript:x"" onanimationstart=""alert(1)""></tfoot>lert(1)></map>" (str.replace y "me:" "javascript:")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}"))) (str.prefixof "8" z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[^<>()!%]*$")) (= (str.len x) 57) (not (str.in_re y ((_ re.from_regex ecma2020) "^.* .*$")))))
(assert (str.contains x "ody"))
(assert (not (= (str.at z 18) "x")))
(check-sat)
