; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onmouseenter=""alert(1)"">test</sup>") (= x "<marquee draggable=""true"" ondragend=""alert(1)"">test</marquee>")))
(assert (or (= z "MG SRC=x onload=""alert(String.fromCharCode(88,83,83))"">") (= z " onload=alert(1)></rp>")))
(assert (= y (str.++ x z)))
(assert (or (= "<marquee draggable=""true"" ondragend=""alert(1)"">xt</marquee> onload=alert(1)></rp>" (str.replace y "tes" "x")) (str.in_re x ((_ re.from_regex ecma2020) "1[34578]\d{9}$")) (not (= "<maralert(1)ee draggable=""true"" ondragend=""alert(1)"">test</marquee>" (str.replace x "qu" "alert(1)")))))
(assert (or (not (str.contains (str.replace y "<sup " " ") " on")) (not (>= (str.len y) 53)) (not (= (str.indexof z "est</" 0) 26))))
(assert (not (str.prefixof "<" y)))
(assert (not (= "nmouse" (str.substr y 6 6))))
(check-sat)
