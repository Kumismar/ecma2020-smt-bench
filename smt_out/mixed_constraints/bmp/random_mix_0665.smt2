; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><dialog ondrop=alert(1) contenteditable>drop here</dialog>") (= x "<listing id=x tabindex=1 onfocus=alert(1)></listing>")))
(assert (or (= z "t(1)""></output>") (= z "ef=1 onerror=""javascript:alert(1)""></image>") (= z "aintext oncut=""alert(1)"" contenteditable>test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len y) 166)))
(assert (str.suffixof "3)-""" y))
(assert (str.suffixof "ment>" z))
(assert (or (not (= "t(1)""><""tput>" (str.replace z "/ou" """"))) (str.suffixof "listing>" x) (= (str.indexof x "d" 0) 1)))
(assert (or (= (str.indexof z "=1 on" 0) 2) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-zA-Z])[A-Za-z0-9].{7,20}"))) (not (str.prefixof "<listing " x))))
(assert (or (not (str.prefixof "ef=1 one" z)) (not (= (str.at x 1) "d")) (= (str.at x 47) "t")))
(assert (not (str.prefixof "<dfn " x)))
(check-sat)
