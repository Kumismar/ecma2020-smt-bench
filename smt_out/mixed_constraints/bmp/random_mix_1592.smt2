; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<SCRIPT a=`>` SRC=""http://ha.ckers.org/xss.js""></SCRIPT>") (= x "<select onmouseenter=""alert(1)"">test</select>")))
(assert (or (= z "1)></kbd>") (= z ">test</strike>") (= z "ontenteditable>test</table>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 34) "t")) (= "t</strike>" (str.substr z 4 10)) (= (str.indexof y "</sel" 0) 36)))
(assert (or (>= (str.len z) 17) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z A-Z 0-9 \u{df}]$")))))
(assert (or (not (= "<select onmouseent=""alert(1)"">test</select>" (str.replace x "er" ""))) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z]+.*\S.*"))) (not (str.suffixof "ll>" z))))
(assert (or (= (str.at x 25) "/") (str.contains y "ler")))
(assert (str.contains z ">test</s"))
(check-sat)
