; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead id=x tabindex=1 onbeforeactivate=alert(1)></the\u{1d400}ad>\u{1f4a9}") (= x "<style>@keyframes x{}</style><blink style=""animation-name:x"" onanimationend=""alert(1)""></blink>") (= x "<command onmouseenter=""alert(1)"">test</command>")))
(assert (or (= z "amp draggable=""true"" ondragstart=""alert(1)"">test</samp>") (= z "</mark>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\(?\d{3}\)?[- ]?\d{3}[- ]?\d{4}$"))) (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[A-Za-z]{2,16}$")) (= (str.indexof z "/mar" 0) 1)))
(assert (or (= "r" (str.substr y 43 1)) (= "rt(1)>" (str.substr x 43 6))))
(assert (or (>= (str.len x) 52) (not (= (str.indexof z "art=""" 0) 29))))
(assert (or (str.suffixof "\u{1f4a9}" x) (>= (str.len x) 59)))
(assert (str.prefixof "<i onmo" y))
(assert (= (str.at x 9) " "))
(check-sat)
