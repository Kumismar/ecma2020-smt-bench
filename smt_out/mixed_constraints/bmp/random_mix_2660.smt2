; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside onblur=alert(1) tabindex=1 id=x></aside><input autofocus>") (= x "<img onblur=alert(1) tabindex=1 id=x></img><input autofocus>") (= x "<script\x0Ctype=""text/javascript"">javascript:alert(1);</script>")))
(assert (or (= z ">") (= z "1)></body>")))
(assert (= y (str.++ x z)))
(assert (or (= ">" (str.substr z 0 8)) (not (= ">" (str.substr z 9 6))) (not (str.suffixof "s>" x))))
(assert (or (not (= (str.indexof y "=aler" 0) 11)) (<= (str.len z) 11)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[0-9\-\+\s]+")))
(assert (not (= "<  onblur=alert(1) tabindex=1 id=x></img><input autofocus>" (str.replace x "img" " "))))
(assert (or (str.contains x "onbl") (= (str.at z 8) "y") (<= (str.len y) 61)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z])\w\S{6,}"))) (not (= (str.indexof x "nde" 0) 25)) (= (str.at z 0) "1")))
(assert (or (not (= "<img onblur=alert(1) tabindex=1 id""img><input autofocus>" (str.replace x "=x></" """"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.-_+]{1,}@[a-zA-Z.-]{2,}[.]{1}[a-zA-Z]{2,}")))))
(check-sat)
