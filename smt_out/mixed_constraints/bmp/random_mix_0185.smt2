; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<center onmouseleave=""alert(1)"">test</center>") (= x "<center onpaste=""alert(1)"" contenteditable>test</center>") (= x "<style>@keyframes x{}</style><ruby style=""animation-name:x"" onanimationend=""alert(1)""></ruby>")))
(assert (or (= z "1)></pre><input id=y autofocus>") (= z "put autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^((13[0-9])|(14[5|7])|(15([0-3]|[5-9]))|(18[0,5-9]))\d{8}$|^((13[0-9])|(14[5|7])|(15([0-3]|[5-9]))|(18[0,5-9]))\d{8}$"))) (str.in_re z ((_ re.from_regex ecma2020) "^(\d\d\d\d)|([\u{ff10}-\u{ff19}][\u{ff10}-\u{ff19}][\u{ff10}-\u{ff19}][\u{ff10}-\u{ff19}])$"))))
(assert (or (str.contains z "utofo") (not (str.contains (str.replace x "i" "alert(1)") "ntedalert(1)t")) (not (str.contains x " onp"))))
(assert (or (not (= (str.at y 60) "o")) (not (= """ on" (str.substr z 53 4)))))
(assert (= "put au<b>ocus>" (str.replace z "tof" "<b>")))
(assert (or (= (str.at z 11) "n") (not (<= (str.len z) 13))))
(assert (str.prefixof "<c" x))
(assert (or (str.contains y " onpas") (not (= "y autofoc" (str.substr z 19 9)))))
(assert (not (str.suffixof "autofocus>" y)))
(assert (= (str.indexof z "s>" 0) 12))
(check-sat)
