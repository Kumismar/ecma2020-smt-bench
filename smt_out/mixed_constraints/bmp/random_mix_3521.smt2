; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ins onfocusout=alert(1) tabindex=1 id=x></ins><input autofocus>") (= x "<audio id=x tabindex=1 onbeforeactivate=alert(1)></audio>") (= x "<section draggable=""true"" ondragstart=""alert(1)"">test</section>")))
(assert (or (= z "down=""\u{20000}alert(1)"">tes\u{10348}t</rb>") (= z "lert(1)"">test</var>") (= z "ransitionrun=alert(1)></small>")))
(assert (= y (str.++ x z)))
(assert (not (= "t(1)></nob" (str.substr x 22 10))))
(assert (or (str.prefixof "<ins onfo" x) (>= (str.len z) 3)))
(assert (not (= "teditable" (str.substr y 34 9))))
(assert (or (not (str.contains x "udio")) (not (= (str.at x 8) " "))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[\D]{2,40}"))) (not (str.contains x "nd"))))
(assert (= (str.at z 9) "r"))
(assert (or (= "io " (str.substr y 4 3)) (not (str.contains (str.replace x "ctiv" "alert(1)") "foreaalert(1)at"))))
(check-sat)
