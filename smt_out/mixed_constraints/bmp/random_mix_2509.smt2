; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem onclick=""alert(1)"">test</menuitem>") (= x "\u{10348}<style>@keyframes x{}</style><meta style=""animation-name:x"" onanimationend=""alert(1)""></meta>")))
(assert (or (= z "=x></hgroup><input autofocus>") (= z "lect onmousemove=""alert(1)"">test</select>") (= z "n>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "</s" 0) 35)) (not (str.contains y "t(1) ")) (not (str.in_re x ((_ re.from_regex ecma2020) "^0\d([\d]{0,1})([-]{0,1})\d{7}$")))))
(assert (or (str.contains (str.replace x "item>" """") "/menu""") (str.contains z "script> ")))
(assert (or (str.prefixof "=x" z) (not (= (str.indexof y "tyl" 0) 3)) (= (str.indexof x ">tes" 0) 28)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[\p{L}/gu0-9.!#$%&+'^_`{}~-]+@[\p{L}/gu0-9-]+[.]+(?:.[\p{L}/gu0-9-]+)*$"))))
(check-sat)
