; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onbeforecut=""alert(1)"" contenteditable>test</dfn>") (= x "<samp id=x tabindex=1 onfocus=alert(1)></samp>")))
(assert (or (= z "1)"">test</nobr>") (= z "us>") (= z "ert(1)></image>")))
(assert (= y (str.++ x z)))
(assert (= "able>test" (str.substr x 39 9)))
(assert (or (not (str.contains y "rt(1)></s")) (str.prefixof "<samp id=x" x)))
(assert (or (not (str.suffixof ">" y)) (= ">" (str.substr z 2 9))))
(assert (str.contains x "dex="))
(assert (not (= "s>" (str.substr z 1 2))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[0-9\s-]{5,17}")) (not (str.in_re z ((_ re.from_regex ecma2020) "(?!000|666)[0-8][0-9]{2}-(?!00)[0-9]{2}-(?!0000)[0-9]{4}"))) (= (str.len y) 69)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[1-9][0-9]{1,5}"))) (= (str.indexof x "/samp" 0) 40)))
(assert (not (= (str.at y 37) ")")))
(check-sat)
