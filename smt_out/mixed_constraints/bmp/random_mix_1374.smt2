; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><b style=""animation-name:x"" onanimationstart=""alert(1)""></b>") (= x "<style>:target {color: red;}</\u{1f4a9}style><dir id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></dir>")))
(assert (or (= z "nmouseout=""alert(1)"">test</footer>") (= z "x></strike><input autofocus>") (= z "t</u>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<styl" y))
(assert (or (not (= """>" (str.replace z "t</u" """"))) (not (str.suffixof ")></dir>" x)) (not (str.prefixof "x></strik" z))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.,_ \-]+$")) (not (str.prefixof "<style>:" x)) (not (str.contains (str.replace y "(1)" "alert(1)") "talert(1)></f"))))
(assert (or (str.contains z "t</") (= "<style>@keyframes x{}</style><b styl ""animation-name:x"" onanimationstart=""alert(1)""></b>x></strike><input autofocus>" (str.replace y "e=" " "))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9].{11,13}"))))
(check-sat)
