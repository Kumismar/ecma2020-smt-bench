; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><main id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></main>") (= x "</math>//[""'`-->]]>]</div>") (= x "<span onmouseleave=""alert(1)"">test</span>")))
(assert (or (= z "=""true"" ondragenter=""alert(1)"">test</noscript>") (= z "id=x style=""transition:color 1s"" ontransitionend=alert(1)></article>") (= z "style=""animation-name:x"" onanimationend=""alert(1)""></frameset>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 64) (not (str.contains z "s""")) (not (= (str.at x 4) "t"))))
(assert (= (str.indexof x "]" 0) 16))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(1|2)[0-9]{3}$"))) (not (>= (str.len y) 183))))
(assert (str.contains (str.replace x "fu" "alert(1)") " id=""alert(1)zze"))
(assert (or (str.prefixof "=""tr" z) (str.prefixof "<em id=x t" x) (not (str.contains y "tr"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([7]{1})([5]{1})([6]{1})(.)([0-9]{4})(.)([0-9]{4})(.)([0-9]{2})$"))) (= (str.at z 18) "r")))
(assert (not (<= (str.len z) 33)))
(check-sat)
