; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><xss style=""animation-name:x"" onanimationstart=""alert(1)""></xss>") (= x "<dt id=x tabindex=1 onactivate=alert(1)></dt>") (= x "<style>:target {transform: rotate(180deg);}</style><body id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></body>")))
(assert (or (= z "est</hr>") (= z "=""alert(1)"" contenteditable>test</legend>") (= z "r>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x " o" 0) 58)) (not (str.contains z "r>"))))
(assert (= (str.at y 22) "a"))
(assert (or (not (str.suffixof "e</i>" y)) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Z,a-z0-9\-,. ]*"))) (not (str.contains (str.replace z "o" "javascript:") " cjavascript:nt"))))
(assert (or (str.suffixof "CRIPT>" y) (not (str.prefixof "<dt id=x t" x))))
(assert (or (not (= (str.indexof x "m" 0) 14)) (str.in_re y ((_ re.from_regex ecma2020) "^\d{2}\.?\d{2}\.?\d{2}\.?\d{2}\.?\d{2}$$")) (<= (str.len x) 47)))
(assert (= "ota" (str.substr x 28 3)))
(assert (or (not (= "e" (str.substr y 44 1))) (<= (str.len x) 132)))
(check-sat)
