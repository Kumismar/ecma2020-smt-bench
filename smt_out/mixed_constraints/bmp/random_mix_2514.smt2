; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:\x0Bexpression(javascript:alert(1)"">DEF") (= x "<dd onmousedown=""alert(1)"">test</dd>") (= x "<tt onmouseenter=""alert(1)"">test</tt>")))
(assert (or (= z " onpaste=""alert(1)"" contenteditable>test</dt>") (= z "alert(1)"">test</blink>")))
(assert (= y (str.++ x z)))
(assert (not (= "ert(1)"">te" (str.substr z 6 10))))
(assert (or (= (str.indexof z "te" 0) 6) (str.contains y "F on") (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z])+([a-zA-Z0-9- \s])+$")))))
(assert (or (not (= "abl" (str.substr y 67 3))) (= (str.indexof x "usedo" 0) 8)))
(assert (or (>= (str.len x) 39) (str.in_re y ((_ re.from_regex ecma2020) "^[9|8|7|6|5|4|3|2|1|0]\d{8}$"))))
(assert (not (str.prefixof " onp" z)))
(assert (not (= "v><b" (str.substr z 14 4))))
(check-sat)
