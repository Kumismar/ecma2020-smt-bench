; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<? echo('<SCR)';") (= x "<image onmouseup=""alert(1)"">test</image>")))
(assert (or (= z "></dialog>") (= z " rotate(180deg);}</style><time id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></time>") (= z "t</u>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*[A-Za-z])(?=.*\d).{8,}$")) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0A-Z-9._%+-]+@[a-z0-9.-]+\.[a-zA-Z]{2,5}$")))))
(assert (or (str.suffixof "t</image>" x) (= (str.at z 6) "l") (not (= "orm 2s"" o" (str.substr y 100 9)))))
(assert (not (<= (str.len x) 22)))
(assert (or (not (= (str.len x) 16)) (str.contains z "t</u>") (not (str.prefixof "<imag" y))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^(\s*)(([A-Za-z]{1,2}[ ]?[0-9]{1,4})|([A-Za-z]{3}[ ]?[0-9]{1,3})|([0-9]{1,3}[ ]?[A-Za-z]{3})|([0-9]{1,4}[ ]?[A-Za-z]{1,2})|([A-Za-z]{3}[ ]?[0-9]{1,3}[ ]?[A-Za-z])|([A-Za-z][ ]?[0-9]{1,3}[ ]?[A-Za-z]{3})|([A-Za-z]{2}[ ]?[0-9]{2}[ ]?[A-Za-z]{3})|([A-Za-z]{3}[ ]?[0-9]{4}))(\s*)$")))
(assert (not (= "g>" (str.substr y 48 9))))
(check-sat)
