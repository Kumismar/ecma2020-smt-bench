; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<button autofocus onfocusin=alert(1)>test</button>") (= x "<applet onbeforecut=""alert(1)"" contenteditable>test</applet>")))
(assert (or (= z "C=""javascript:alert('XSS');"">") (= z "ex id=x tabindex=1 onfocus=alert(1)></isindex>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "foc")) (>= (str.len z) 29)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z]?[A-Za-z]?[0-9]{6,9}$"))))
(assert (or (not (= "itable>tes" (str.substr z 3 10))) (not (= (str.at z 8) "c")) (not (str.suffixof "sindex>" z))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-z\u{119}\u{f3}\u{105}\u{15b}\u{142}\u{17c}\u{17a}\u{107}\u{144}\u{118}\u{d3}\u{104}\u{15a}\u{141}\u{17b}\u{179}\u{106}\u{143} /]){2,}$"))))
(assert (not (= (str.len x) 60)))
(assert (not (= (str.at y 93) "1")))
(assert (str.prefixof "o" z))
(assert (not (str.prefixof "-e 'pr" z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-z0-9._%+-]+@[A-z0-9.-]+\.[A-z]{2,4}$"))))
(check-sat)
