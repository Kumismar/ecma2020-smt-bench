; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist id=x tabindex=1 onbeforedeactivate=alert(1)></datalist><input autofocus>") (= x "<base onmouseleave=""a\u{1d400}lert(1)"">test</base>")))
(assert (or (= z "alert(1) tabindex=1 id=x><\u{10348}/embed><input autofocus>") (= z "t</dir>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "a" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "(^(1300|1800|1900|1902)(|)[0-9]{3}(|)[0-9]{3}$)|(((^[\+]*61[2|3|4|7|8]{1})|^0[2|3|7|8]{1})(|)[0-9]{4}(|)[0-9]{4}$)|(^014(|)([0-9]{5}|[0-9]{6}|[0-9]{7})$)|(^13(|)[0-9]{4}$)|(^04[0-9]{2}(|)[0-9]{3}(|)[0-9]{3}$)"))) (str.suffixof "us>" z)))
(assert (or (not (= "<base o" (str.substr x 0 7))) (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,15}$")) (str.suffixof "`1`" z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{1,}$")) (= (str.indexof y """a" 0) 19) (<= (str.len y) 95)))
(assert (or (not (= (str.at x 36) "/")) (not (= "dir>" (str.substr z 3 10)))))
(check-sat)
