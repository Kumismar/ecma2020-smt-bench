; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee onStart marquee onStart=""javascript:j\u{20000}avascript:alert(1)""></marquee onStart>") (= x "<frame oncut=""alert(1)"" contenteditable>test</frame>") (= x "foo<script>alert(document.cookie)</script>")))
(assert (or (= z """alert(1)"" contenteditable>test</applet>") (= z "ntenteditable>test</script>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "d" 0) 6) (not (str.prefixof "<ma" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}]+$")))))
(assert (or (not (str.prefixof "<sup onm" y)) (not (= "<frame" (str.substr x 0 6))) (not (str.contains x "fram"))))
(assert (str.prefixof "<marquee o" y))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^.{0,40}$"))))
(assert (not (>= (str.len y) 89)))
(assert (or (not (= (str.indexof x "foo<" 0) 0)) (= "<marquee " (str.substr x 0 9)) (str.suffixof "plet>" z)))
(assert (not (str.suffixof ">" x)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^@[A-Za-z0-9_]{1,15}$"))))
(check-sat)
