; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q onclick=""alert(1)"">test</q>") (= x "<source draggable=""true"" ondragstart=""alert(1)"">test</source>") (= x "<textarea onselect=alert(1) autofocus>XSS</textarea>")))
(assert (or (= z "ut=""alert(1)"" contenteditable>test</section>") (= z "hgroup id=x tabindex=1 onbeforedeactivate=alert(1)></hgroup><input \u{1f600}autofocus>") (= z "dex draggable=""true"" ondragstart=""alert(1)"">test</isindex>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "></keygen>") (str.contains (str.replace z "ert" "x") "t=""alx(")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-zA-Z]{2,5}$"))))
(assert (not (str.suffixof "x>" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{8,}$"))))
(assert (or (not (str.contains z "ert(1)>")) (not (<= (str.len z) 49)) (not (= "ut=""alert(1)"" contentedi<b>e>test</section>" (str.replace z "tabl" "<b>")))))
(assert (or (= (str.at x 1) "t") (= " \u{1f600}auto" (str.substr z 66 6)) (not (str.prefixof "<source d" x))))
(check-sat)
