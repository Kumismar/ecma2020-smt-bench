; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;IMG LOWSRC="";javascript:alert(';XSS';);"";>;") (= x "<br draggable=""true"" ondrag=""alert(1)"">test</br>")))
(assert (or (= z "dset><input autofocus>") (= z "/"";>;XSS<;/A>;") (= z "!")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*[0-9].*)(?=.*[A-Z].*)(?=.*[a-z].*).{8,}$"))) (str.prefixof "<br d" x) (= "<;IMG LOWSRC="";javascript:alert(';XSS';javascript:;"";>;" (str.replace x ")" "javascript:"))))
(assert (str.suffixof ">" x))
(assert (or (not (= "<"">@keyframes x{}</style><cite style=""animation-name:x"" onanimationend=""alert(1)""></cite>" (str.replace x "style" """"))) (not (str.contains (str.replace x "e=""tr" "") "gablue"" "))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]+([\.\,]{1}[0-9]{1,2})?$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^([0-9\(\)\/\+ \-]*)$"))) (str.prefixof "<br d" y)))
(assert (str.prefixof " widt" z))
(assert (not (>= (str.len x) 48)))
(check-sat)
