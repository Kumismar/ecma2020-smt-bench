; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var onbeforepaste=""alert(1)"" contenteditable>test</var>") (= x "<col ondblclick=""alert(1)"">test</col>")))
(assert (or (= z """true"" ondrag=""alert(1)"">test</colgroup>") (= z "rt(1)"">test</h1>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(\+)?\d{5,}$"))) (str.contains (str.replace y "ta" "javascript:") "tionsjavascript:rt=""") (str.contains z "=""alert")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z]{4,25}")) (not (= "<col o""blclick=""alert(1)"">test</col>" (str.replace x "nd" """"))) (not (str.prefixof "<var on" y))))
(assert (or (not (>= (str.len z) 34)) (not (= "st</" (str.substr y 83 4))) (str.contains x "dblclick=""")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[_A-Za-z0-9-\+]+(\.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(\.[A-Za-z0-9]+)*(\.[A-Za-z]{2,})$"))) (= "<col ondblcli<b>=""alert(1)"">test</col>" (str.replace x "ck" "<b>"))))
(assert (str.suffixof "(1)"">DEF" x))
(check-sat)
