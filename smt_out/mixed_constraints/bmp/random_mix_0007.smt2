; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onmouseenter=""alert(1)"">test</cite>") (= x "<slot onmouseup=""alert(1)"">test</slot>")))
(assert (or (= z "1 onbeforeactivate=alert(1)></code>") (= z "mes onmouseup=""alert(1)"">test</noframes>") (= z "IMG SRC=x onkeypress=""alert(String.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(0[1-9]|1[012])$"))) (not (= (str.indexof x "lert(" 0) 21))))
(assert (or (str.suffixof "3,83))"">" y) (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9-._%+]+@[A-Za-z0-9.]+\.[A-Za-z]{1,63}$"))))
(assert (or (str.prefixof "<cite on" x) (not (= (str.len y) 76))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]*(\.[0-9]+)?$"))) (str.suffixof "/code>" y) (= "focusin" (str.substr z 9 7))))
(assert (or (not (= (str.indexof y "mou" 0) 8)) (= (str.indexof y "1" 0) 23) (= "1)"">test<" (str.substr y 62 9))))
(assert (= (str.at x 23) "o"))
(check-sat)
