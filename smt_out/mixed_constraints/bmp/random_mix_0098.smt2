(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onscroll=alert(1)><br><br><br><br>") (= x "<body onerror=alert(1) onload=/>") (= x "<video onkeypress=""alert(1)"" con\u{1d400}tenteditable\u{1d400}>test</video>")))
(assert (or (= z "R\0IPT>;"";;'; >; out") (= z """true"" ondragend=""alert(1)"">test</keygen>") (= z "ript>//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 11) "o")))
(assert (= (str.at z 2) " "))
(assert (or (not (= "itable\u{1d400}>" (str.substr x 39 8))) (= (str.indexof x "l" 0) 20) (= (str.at x 16) "s")))
(assert (str.prefixof "<bo" x))
(assert (= "]>]</div>" (str.substr z 15 9)))
(assert (str.contains x "onerro"))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9_ +-,.?]{3,}$")) (not (str.prefixof "<hgroup " y))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) ".{3,19}")) (not (= "1)"" con\u{1d400}t" (str.substr y 25 9)))))
(check-sat)
