; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img \x11src=x onerror=""javascript:alert(1)"">") (= x "<;A HREF="";//google"";>;XSS<;/A>;")))
(assert (or (= z "dragstart=""alert(1)"">test</tit\u{1f600}le>") (= z "C")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 59) (str.contains z "art=""")))
(assert (not (str.suffixof "nav>" z)))
(assert (= (str.indexof x "gl" 0) 16))
(assert (or (not (str.suffixof ")"">" x)) (= "ragstar" (str.substr z 1 7))))
(assert (or (= (str.at z 25) "<") (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{9,13}$")))))
(assert (not (= "<script for=document evalert(1)onreadystatechange>getElementById('safe123').click()</script>" (str.replace x "ent=" "alert(1)"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "1[3456789]\d{9}$"))) (>= (str.len x) 22)))
(assert (or (str.prefixof "dragstart=" z) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9\-\+]+")))))
(check-sat)
