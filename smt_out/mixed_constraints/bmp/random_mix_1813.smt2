; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<wbr onbeforepaste=""alert(1)"" contenteditable>test</wbr>") (= x "<iframe s\u{1f4a9}rcdoc=<sv\u{10348}g/o&#x6Eload&equals;alert&lpar;1)&gt;>") (= x "%253cscript%253ealert(document.cookie)%253c/script%253e")))
(assert (or (= z "ss.js&gt;&lt;/SCRIPT&gt;") (= z "nd>") (= z "rt(1)"" contenteditable>test</var>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ";" y) (str.in_re x ((_ re.from_regex ecma2020) "GZE82A")) (= (str.indexof y "rt(" 0) 25)))
(assert (or (str.prefixof "<style>@i" y) (not (str.prefixof "<i" x))))
(assert (or (= (str.indexof z "ese" 0) 4) (not (str.suffixof "nd>" z))))
(assert (or (= (str.len x) 58) (= ">" (str.substr z 2 4))))
(assert (or (str.suffixof "r>" y) (not (= (str.at x 55) "t"))))
(check-sat)
