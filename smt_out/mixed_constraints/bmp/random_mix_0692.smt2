; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><td style=""animation-name:x"" onanimationend=""alert(1)""></td>") (= x "<command id=x tabindex=1 onfocus=alert(1)></command>") (= x "<a id=x tabindex=1 ondeactivate=alert(1)></a><input id=y autofocus>")))
(assert (or (= z "ble>test</ol>") (= z "able>test</img>") (= z " onblur=alert(1) tabindex=1 id=x></template><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "ble>" z) (not (= "=" (str.substr x 32 1)))))
(assert (not (= " onbr=alert(1) tabindex=1 id=x></template><input autofocus>" (str.replace z "lu" ""))))
(assert (or (not (str.contains z "test</ol>")) (= (str.indexof z "/img>" 0) 10)))
(assert (or (not (= (str.at x 20) "r")) (str.prefixof "<" x) (str.suffixof "ol>" z)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]{3} ?(?!sa|sd|ss)[a-zA-Z]{2}$")))
(check-sat)
