; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><img src=x onerror=javascript:alert(""A"")>") (= x "<hr onmousemove=""alert(1)"">test</hr>")))
(assert (or (= z "vate=alert(1)></input><input id=y autofocus>") (= z "ert(1)"">test</var>") (= z " draggable=""true"" ondragleave=""alert(1)"">test</thead>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "e=""")))
(assert (not (= "n" (str.substr y 55 1))))
(assert (str.contains z "(1"))
(assert (or (str.contains x "%"" onmo") (not (= (str.indexof y "ip" 0) 28))))
(assert (or (not (= (str.at y 57) "r")) (not (str.contains (str.replace y "onm" "x") "<hr xo")) (not (str.contains (str.replace x "ou" """") "onm""semo"))))
(assert (or (str.suffixof "/hr>" x) (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{12}$")))))
(assert (or (not (= (str.indexof y "(""A"")" 0) 37)) (= (str.len x) 43)))
(assert (or (not (= "><input id" (str.substr z 21 10))) (str.contains (str.replace y "ner" "alert(1)") "c=x oalert(1)ror")))
(assert (not (= "/" (str.substr y 49 1))))
(check-sat)
