; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta draggable=""true"" ondragstart=""alert(1)"">test</meta>") (= x "<style draggable=""true"" ondragstart=""alert(1)"">test</style>") (= x "<del oncontextmenu=""alert(1)"">test</d\u{1f4a9}el>")))
(assert (or (= z ">]</div>") (= z "d=x tabindex=1 onfocusin=alert(1)></del>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "meta>" x)) (str.prefixof "<meta dra" x)))
(assert (or (str.suffixof "1)></del>" y) (not (str.suffixof ">]</div>" z)) (str.contains (str.replace x "d" """") " ""rag")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{3}-[0-9]{4}$")) (not (= (str.at x 56) "l"))))
(assert (or (not (= "x=1 onfo" (str.substr z 11 8))) (not (= "on" (str.substr x 24 2))) (str.contains (str.replace y "ert(" """") "al""1")))
(assert (or (str.prefixof "<de" x) (not (str.contains (str.replace z "1)></" "x") "ert(xd"))))
(check-sat)
