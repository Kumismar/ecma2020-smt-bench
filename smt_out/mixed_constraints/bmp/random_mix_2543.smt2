; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "x\u{201d}</title><img src%3dx onerror%3dalert(1)>") (= x "<tt onmous\u{1d400}eleave=""alert(1)"">test</t\u{1f600}t>")))
(assert (or (= z "e:x"" onanimationstart=""alert(1)""></rb>") (= z "/ul>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x "%3")))
(assert (or (= (str.at y 29) "r") (str.prefixof "/ul" z)))
(assert (or (not (str.suffixof ">" z)) (not (str.prefixof "<image dra" y)) (= (str.indexof y "<" 0) 2)))
(assert (not (= "<tt onmous\u{1d400}javascript:leave=""alert(1)"">test</t\u{1f600}t>" (str.replace x "e" "javascript:"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "([0-9]{13}$)"))))
(check-sat)
