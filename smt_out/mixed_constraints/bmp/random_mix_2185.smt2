; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table id=x tabindex=1 onactivate=alert(1)></table>") (= x "&#X000003c") (= x "<ins draggable=""true"" ondragleave=""alert(1)"">test</ins>")))
(assert (or (= z "ntenteditable>test</object>") (= z "put autofocus>") (= z "or 1s"" ontransitionend=alert(1)></embed>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "ocus>" x) (not (= "&#00001" (str.substr y 72 7)))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_\.\-]+?@[A-Za-z0-9_\.\-]+$")) (not (str.contains x "000003"))))
(assert (str.contains x "rue"" ondr"))
(assert (or (not (>= (str.len x) 29)) (= "putalert(1)ofocus>" (str.replace z " aut" "alert(1)")) (= "or 1s"" ontransitionend=alert></embed>" (str.replace z "(1)" ""))))
(assert (str.contains (str.replace x ">" "javascript:") ")javascript:</"))
(assert (not (str.prefixof "&#X000" x)))
(assert (or (not (= (str.indexof x "dex=1" 0) 17)) (not (str.prefixof "&#X0000" x))))
(assert (str.contains x "true"))
(assert (not (= "&#X0000" (str.substr x 0 7))))
(check-sat)
