(assert (or (not (>= (str.len z) 58)) (str.in_re z ((_ re.from_regex ecma2020) "^(?!s).*$")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[ a-zA-Z ]+$")))))
(assert (not (= "t</fra" (str.substr z 5 6))))
(assert (or (not (str.suffixof ">" y)) (not (str.in_re z ((_ re.from_regex ecma2020) "^(?!.*(icloud.com|me.com|docomo.ne.jp|ezweb.ne.jp|softbank.ne.jp|i.softbank.jp|hotmail.co.jp|hotmail.com|msn.com|outlook.jp|outlook.com|live.jp)).+$"))) (not (= (str.at x 19) "u"))))
(assert (or (str.suffixof "script>" y) (not (= (str.indexof x "t(1)""" 0) 38))))
(check-sat)
