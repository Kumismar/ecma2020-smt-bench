; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr ondblclick=""alert(1)"">test</hr>") (= x "<dir onkeydown=""alert(1)"" contenteditable>test</dir>")))
(assert (or (= z "('XSS');"">") (= z " contenteditable>test</form>") (= z "te=alert(1)></del>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9a-zA-Z_ -]{1,20}"))) (not (str.suffixof "(1)></del>" z)) (str.in_re z ((_ re.from_regex ecma2020) "^\d{9,}$"))))
(assert (str.contains z "('XSS');"))
(assert (or (not (= (str.indexof y "<" 0) 0)) (not (str.contains y "keyd")) (<= (str.len y) 66)))
(assert (not (str.suffixof ">n>" y)))
(assert (not (= (str.len z) 10)))
(check-sat)
