; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead onbeforecopy=""alert(1)"" contenteditable>test</thead>") (= x "<dir onclick=""alert(1)"">test</dir>") (= x "<div draggable=""true"" contenteditable>drag me</div><ins ondragover=alert(1) contenteditable>drop here</ins>")))
(assert (or (= z "eter>") (= z "onfocusout=alert(1) tabinde\u{1d400}x=1 id=x></acronym><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\s\.\-\+x\(\)\[\]]*$"))) (not (= (str.at x 10) "a"))))
(assert (or (not (= (str.at x 16) "o")) (str.contains z "er") (str.suffixof "/dir>eter>" y)))
(assert (str.suffixof "ofocus>" z))
(assert (not (str.contains x """alert")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\\s\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\\s]+$"))) (not (str.contains (str.replace x "ydo" "") "ewn=""a")) (not (= (str.len x) 107))))
(assert (or (<= (str.len z) 7) (= (str.indexof z "ac" 0) 39)))
(assert (str.prefixof "et" z))
(check-sat)
