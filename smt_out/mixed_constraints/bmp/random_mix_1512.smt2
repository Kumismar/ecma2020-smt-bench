; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgro\u{10348}up onmouseup=""alert(\u{1d400}1)"">test</optgroup>") (= x "<html onMouseMove html onMouseMove=""javascript:javascript:alert(1)""></html onMouseMove>") (= x "<X onxxx=1")))
(assert (or (= z "rike>") (= z "nmouseover=""alert('xxs')"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "t" 0) 2)) (not (= (str.indexof y "over" 0) 93)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[^@]{1,64}@[^@]{1,256}\.[^@]{1,32}$")))))
(assert (not (<= (str.len x) 97)))
(assert (or (not (= (str.len x) 36)) (not (= (str.indexof x "ow " 0) 5))))
(assert (or (not (>= (str.len y) 90)) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{0,2}\d")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]{1,64}@[a-zA-Z0-9-]{1,64}[\.][a-zA-z]{2,}[\.]{0,1}[a-zA-z]{0,}$")))))
(check-sat)
