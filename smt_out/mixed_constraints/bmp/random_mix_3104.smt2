; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre draggable=""true"" ondragend=""alert(1)"">test</pre>") (= x "<img src=validimage.png onloadstart=alert(1)>") (= x "<spacer id=x tabindex=1 onbeforedeactivate=alert(1)></spacer><input autofocus>")))
(assert (or (= z "up=""alert(1)"" contenteditable>test</address>") (= z "n>") (= z "contenteditable>test</code>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len x) 41))
(assert (or (str.prefixof "con" z) (not (= (str.at x 39) "\u{20000}"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z]([a-zA-Z0-9_-]{0,29})$"))) (not (<= (str.len z) 71)) (not (str.contains (str.replace y "pu" "<b>") "><in<b>t au"))))
(assert (not (= (str.indexof z "ert(" 0) 6)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9_-]{9,9}$"))) (= "<mjavascript:ol id=x tabindex=1 onactivate=alert(1)></multicol>" (str.replace x "ultic" "javascript:")) (str.prefixof "<img src=v" y)))
(assert (not (str.contains x "g src=va")))
(check-sat)
