; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onfocusout=alert(1) tabindex=1 id=x></dfn><input autofocus>") (= x "<br oncontext\u{10348}menu\u{1f600}=""alert(1)"">test</br>")))
(assert (or (= z "raggable=""true"" ondragleave=""alert(1)"">test</dialog>") (= z "t id=x tabindex=1 onbeforeactivate=alert(1)></element>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<shadow" x) (not (str.contains (str.replace y "ex=" """") "abind""1 i")) (not (>= (str.len y) 64))))
(assert (or (= (str.at z 36) ")") (not (= "r" (str.substr x 2 1)))))
(assert (or (= "<dfn onfocusout=alert(1) tabindex=d=x></dfn><input autofocus>raggable=""true"" ondragleave=""alert(1)"">test</dialog>" (str.replace y "1 i" "")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[^\s@]+@[^\s@]+\.[^\s@]{2,}$")))))
(assert (<= (str.len x) 42))
(assert (or (not (= (str.indexof y "r " 0) 2)) (not (= "<br oncontext\u{10348}menu\u{1f600}=""alert(1)"">test</br>raggable="" ondragleave=""alert(1)"">test</dialog>" (str.replace y "true""" "")))))
(assert (>= (str.len y) 111))
(assert (or (not (str.suffixof "abel>" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^yes$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{3,4}")))))
(check-sat)
