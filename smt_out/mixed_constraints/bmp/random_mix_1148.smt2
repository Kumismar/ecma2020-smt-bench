; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<p onfocusout=alert(1) tabindex=1 id=x></p><input autofocus>") (= x "<form id=x tabindex=1 ondeactivate=alert(1)></form><input id=y autofocus>")))
(assert (or (= z "t autofocus>") (= z "onmouseover=""alert(1)"">test</a>") (= z "k=""alert(1)"">test</strike>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "(1)"" c" (str.substr x 21 6))) (str.prefixof "k=" z) (str.contains x "ut=alert(1")))
(assert (or (= (str.indexof z "r=" 0) 10) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*([\w]).*)[ \w]*"))) (not (str.contains y "ler"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z]{2,50}")) (not (str.suffixof "ocus>" z))))
(assert (or (str.suffixof "cus>" x) (<= (str.len y) 92) (= (str.len z) 26)))
(assert (or (not (= (str.at y 32) "t")) (= (str.at y 52) "i")))
(assert (= (str.indexof z "to" 0) 4))
(check-sat)
