; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "</ foo=""><script>alert(1)</script>"">") (= x "<option id=x tabindex=1 onbeforeactivate=alert(1)></option>")))
(assert (or (= z "alert(1)"">test</u>") (= z ">") (= z ";{()}")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "{()}" z)) (>= (str.len z) 9)))
(assert (or (>= (str.len y) 52) (not (= "<script>" (str.substr y 9 8))) (not (= "<option id=x  bindex=1 onbeforeactivate=alert(1)></option>;{()}" (str.replace y "ta" " ")))))
(assert (or (= (str.indexof z "a" 0) 0) (not (str.contains x "pt"))))
(assert (or (not (str.contains y "ipt>alert(")) (not (str.in_re x ((_ re.from_regex ecma2020) "^\s*?\d{5}(?:[-\s]\d{4})?\s*?$")))))
(assert (or (not (str.contains y "tiv")) (not (= "ctiv" (str.substr y 33 4))) (str.prefixof "<" x)))
(check-sat)
