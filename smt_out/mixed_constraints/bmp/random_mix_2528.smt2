; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u id=x tabindex=1 onfocusin=alert(1)></u>") (= x "<style>@keyframes x{}</style><title style=""animation-name:x"" onanimationend=""alert(1)""></title>") (= x "<details onmouseout=""alert(1)"">test</details>")))
(assert (or (= z ")></span>") (= z "optgroup id=x tabindex=1 ondeactivate=alert(1)></optgroup><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x ">" 0) 6) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-za-z]{2,4}$")))))
(assert (or (not (= ")>xan>" (str.replace z "</sp" "x"))) (= (str.indexof y "in" 0) 11) (not (str.suffixof "pan>" z))))
(assert (or (not (str.contains (str.replace y "ail" "") "<dets o")) (str.prefixof "<style>@ke" x) (not (str.suffixof "tofocus>" z))))
(assert (or (not (str.prefixof "<sty" x)) (not (str.prefixof "optgrou" z)) (= (str.at z 5) "p")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([A-Z0-9]{5}-){6}[A-Z0-9]{5}$"))))
(check-sat)
