; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dir onmousedown=""alert(1)"">test</dir>") (= x "<a href=""\x1Djavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "=alert(1)></center>") (= z "ave=""alert(1)"">test</time>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<a h" x) (str.contains z "></cent")))
(assert (or (<= (str.len z) 12) (not (= (str.indexof z "ert(" 0) 3))))
(assert (or (not (>= (str.len z) 18)) (not (str.in_re z ((_ re.from_regex ecma2020) "^(0?[1-9]|[12][0-9]|3[01])[\/\-](0?[1-9]|1[012])[\/\-]\d{4}$"))) (not (= (str.at z 16) "a"))))
(assert (or (not (str.contains (str.replace y " h" """") "<a""ref=")) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[A-Za-z]{2,4}$"))))
(assert (or (not (= (str.indexof x "=""a" 0) 16)) (str.contains z "e=""a")))
(assert (or (str.suffixof "ime>" y) (str.prefixof "<pr" y)))
(check-sat)
