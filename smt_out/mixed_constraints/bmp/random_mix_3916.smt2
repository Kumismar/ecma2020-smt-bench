; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup oncut=""alert(1)"" contenteditable>test</colgroup>") (= x "<div id=d><x xmlns=""><iframe onload=alert(97)""></div>")))
(assert (or (= z "forecut=""alert(1)"" contenteditable>test</label>") (= z "uby oncopy=""alert(1)"" contenteditable>test</ruby>")))
(assert (= y (str.++ x z)))
(assert (= "<colgroup oncut=""alert(1)"" contentedita<b>e>test</colgroup>" (str.replace x "bl" "<b>")))
(assert (not (= (str.at y 16) """")))
(assert (or (not (str.suffixof ">" x)) (str.contains x " co") (not (str.suffixof "AYE\u{20000}R&gt;" x))))
(assert (or (str.suffixof "ow>" x) (not (= (str.indexof y "ert(1" 0) 19))))
(assert (or (str.contains y "S')<") (not (>= (str.len y) 100))))
(assert (<= (str.len z) 53))
(assert (or (not (= (str.indexof x "lert(" 0) 18)) (str.prefixof "<di" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "\d+$")) (not (str.contains y "ble>t"))))
(check-sat)
