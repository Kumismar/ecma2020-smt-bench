; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd id=x tabindex=1 onbeforeactivate=alert(1)></kbd>") (= x "<menu oncontextmenu=""alert(1)"">test</menu>") (= x "<style>:target {transform: rotate(180deg);}</style><td id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></td>")))
(assert (or (= z "<script>\xE1\xA0\x8Ejavascript:alert(1)</script>") (= z "form><input autofo\u{1f600}cus>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "form><inp" z))
(assert (str.prefixof "<kbd id" x))
(assert (not (= " {transfo" (str.substr x 14 9))))
(assert (not (str.contains y " onbefo")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(\+|00)?[0-9\s]+$"))))
(assert (not (= "ind" (str.substr x 13 3))))
(assert (= (str.indexof x "al" 0) 38))
(assert (or (str.suffixof "cript>" z) (not (str.contains y "\u{1f600}cu")) (not (= (str.len y) 101))))
(assert (not (<= (str.len y) 71)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^([A-Za-z\u{5c}u00C0-\u{5c}u00FF]\s?)*$")))
(assert (not (str.contains y "rt(")))
(check-sat)
