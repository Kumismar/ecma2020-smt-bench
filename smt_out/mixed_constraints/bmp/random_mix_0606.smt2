; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{1f4a9}<menu draggable=""true"" ondrag=""alert(1)"">test</menu>") (= x "<rtc onblur=alert(1) tabindex=1 id=x></rtc><input autofocus>") (= x "<colgroup onblur=alert(1) tabindex=1 id=x></colgroup><input autofocus>")))
(assert (or (= z "s=alert(1)></main>") (= z "id=x tabindex=1 ondeactivate=alert(1)></style><input id=y autofocus>") (= z "ntenteditable>drag me</div><kbd ondrop=alert(1) contenteditable>drop here</kbd>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<rtc onbl" x))
(assert (or (not (= (str.len y) 149)) (not (= (str.indexof y "/fo" 0) 51)) (not (= (str.at y 126) "o"))))
(assert (or (not (= (str.at x 7) "b")) (not (str.contains y "index=1 on")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9a-zA-Z_ -]{1,20}")))))
(assert (or (not (= "\u{1f4a9}<menu draggable=""true"" ondrag=""alert(1)"">test</menu>ntenteditable>drag me</div><kbjavascript:rop=alert(1) contenteditable>drop here</kbd>" (str.replace y "d ond" "javascript:"))) (not (str.prefixof "<co" x)) (not (str.prefixof "\u{1f4a9}<menu dr" y))))
(assert (or (str.contains y ")""") (not (str.in_re z ((_ re.from_regex ecma2020) "\+?(?:\d+| )+"))) (not (= (str.at x 1) "<"))))
(check-sat)
