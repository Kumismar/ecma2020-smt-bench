; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input oncut=alert(1) value=""XSS"" autofocus>") (= x "<style>:target {color:red;}</style><embed id=x style=""transition:color 1s"" ontransitionend=alert(1)></embed>")))
(assert (or (= z "</blink>") (= z "x></ins><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "<map id=x ta ex=1 onfocus=alert(1)></map>" (str.replace x "bind" " ")) (str.prefixof "<input" y) (not (<= (str.len x) 86))))
(assert (str.contains (str.replace y "<i" " ") " np"))
(assert (or (not (= "C;" (str.substr x 5 2))) (str.in_re z ((_ re.from_regex ecma2020) "^(\d{5}|\d{8})$"))))
(assert (= "s>" (str.substr z 23 6)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.{1,}).*"))) (not (= (str.at y 2) "3"))))
(assert (str.contains (str.replace y """ au" "javascript:") "SSjavascript:t"))
(assert (or (= (str.indexof y "a" 0) 13) (not (= (str.at y 87) "e")) (str.prefixof "<st" x)))
(assert (= (str.at z 1) ">"))
(check-sat)
