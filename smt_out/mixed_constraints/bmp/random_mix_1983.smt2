; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x00javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<table draggable=""true"" ondrag\u{20000}start=""alert(1)"">test</t\u{1f600}able>") (= x "<frameset><frame id=x onfocusin=alert(1)>")))
(assert (or (= z """alert(1)"">test</video>") (= z "alert(1)"">test</iframe>") (= z "ondragover=alert(1) contenteditable>drop here</video>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z ,.'-]+$")) (str.contains (str.replace z "t" """") "aler""(1")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^1(3|5|7|8)\d{9}"))) (str.contains (str.replace x "art=" "<b>") "ag\u{20000}st<b>""a")))
(assert (not (str.suffixof "</video>" z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\s*?\d{5}(?:[-\s]\d{4})?\s*?$"))))
(assert (or (not (= (str.len x) 73)) (not (= "sta""=""alert(1)"">test</param>" (str.replace z "rt" """"))) (str.suffixof "alert(1)>" x)))
(assert (or (not (str.prefixof "a" z)) (= "ut=""" (str.substr z 8 4))))
(check-sat)
