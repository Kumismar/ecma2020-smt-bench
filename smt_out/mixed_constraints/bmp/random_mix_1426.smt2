; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><li id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></li>") (= x "<content onkeypress=""alert(1)"" contenteditable>test</content>") (= x "<XML ID=I><X><C><![CDATA[<IMG SRC=""javas]]<![CDATA[cript:javascript:alert(1);"">]]</C><X></xml>")))
(assert (or (= z "aggable=\u{1f4a9}""true"" ondr\u{20000}agenter=""alert(1)"">test</u>") (= z " id=x></dd><input autofocus>") (= z "est</li\u{10348}nk>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "((?=.*\w)(?=.*[0-9]).{8,})"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[^,;:\s\/]+@[^,;:\s/]{2,}\.[^,;:\s/]{2,}$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,5}$"))))
(assert (or (= (str.indexof z "</" 0) 3) (not (= "<style>:target {color: red;}</style><li id=x style=""transix:color 10s"" ontransitioncancel=alert(1)></li>est</li\u{10348}nk>" (str.replace y "tion" "x"))) (= (str.indexof z "s" 0) 26)))
(assert (or (not (= (str.at z 19) "u")) (not (<= (str.len y) 136)) (not (= (str.indexof z "=""al" 0) 8))))
(check-sat)
