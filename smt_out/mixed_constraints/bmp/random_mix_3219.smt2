; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside id=x tabindex=1 onbe\u{1f4a9}foreactivate=alert(1)></aside>") (= x "<applet draggable=""true"" ondragstart=""aler\u{1d400}t(\u{1f600}1)"">test</applet>")))
(assert (or (= z "n>") (= z "ess onmouseleave=""alert(1)"">test</address>") (= z "ndrag=""alert(1)"">test</canvas>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "n>"))
(assert (str.contains x "pplet "))
(assert (or (= "us>" (str.substr z 4 8)) (not (= (str.indexof y "n>" 0) 63))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^05[0-9]{2}\s{1}[0-9]{3}\s{1}[0-9]{2}\s{1}[0-9]{2}$")) (str.in_re y ((_ re.from_regex ecma2020) "^(\+)?(?:[0-9-] ?){6,15}[0-9]$"))))
(assert (= (str.indexof z "t<" 0) 4))
(assert (not (str.contains z "g=""")))
(check-sat)
