; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address oncopy=""alert(1)"" contenteditable>test</address>") (= x ">>> vectors()")))
(assert (or (= z "ndex=1 onbeforeactivate=alert(1)></noscript>") (= z "CharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace z "1)" " ") "t( ></no"))
(assert (not (str.contains (str.replace x "ad" "") "<dress")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9 \u{5c}u00D1\u{5c}u00F1]+$"))) (not (= (str.indexof x "ctor" 0) 6)) (not (<= (str.len x) 17))))
(assert (= "<address oncopy=xrt(1)"" contenteditable>test</address>" (str.replace x """ale" "x")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^\d{1,2}\/\d{1,2}\/\d{4}$")) (not (str.prefixof ">>> vec" y))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$")))
(assert (= "ectors()" (str.substr x 5 10)))
(check-sat)
