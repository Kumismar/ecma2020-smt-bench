; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<head onmouseleave=""alert(1)"">test</head>") (= x "<option onbeforecopy=""alert(1)"" contenteditable>test</option>")))
(assert (or (= z "}</style><var style=""animation-name:x"" onanimationend=""alert(1)""></var>") (= z "icture id=x \u{1d400}tabindex=1 onbeforedeactivate=alert(1)></picture><inpu\u{10348}t autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[+\-()\s0-9]{7,}$"))))
(assert (str.prefixof "<opt" x))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "(^((0\d{2,3})-)(\d{7,8})(-(\d{3,}))?$)|(^1((3|5|8){1}\d{1}|70)\d{8}$)"))))
(assert (not (= (str.at x 12) "e")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9\u{5c}u0374-\u{5c}u03FF\u{9}]{0,}"))))
(assert (or (= "icture id=x \u{1d400}tabindex=1 onbeforedeactivat""rt(1)></picture><inpu\u{10348}t autofocus>" (str.replace z "e=ale" """")) (not (str.suffixof "ofocus>" y))))
(assert (or (str.contains (str.replace y "ni" "") """ama") (not (str.prefixof "icture id=" z)) (not (str.prefixof "<di" x))))
(check-sat)
