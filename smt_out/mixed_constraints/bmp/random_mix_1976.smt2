; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image ondblclick=""alert(1)"">test</image>") (= x "<video onerror=""javascript:javascript:alert(1)""><source>") (= x "<footer onmousedown=""alert(1)"">test</footer>")))
(assert (or (= z "out=""alert(1)"">test</pre>") (= z "gleave=""alert(1)"">test</ins>")))
(assert (= y (str.++ x z)))
(assert (not (= """a" (str.substr y 20 2))))
(assert (or (not (= (str.indexof x ")"">t" 0) 28)) (str.in_re y ((_ re.from_regex ecma2020) "^[0-9A-Z]{8}$"))))
(assert (or (= (str.len y) 159) (str.contains z "ert(1")))
(assert (or (str.suffixof ">" z) (not (str.contains (str.replace x "t</f" "x") "esxo")) (>= (str.len y) 73)))
(assert (not (= (str.indexof y "/" 0) 76)))
(assert (not (= (str.indexof z "t=""a" 0) 2)))
(check-sat)
