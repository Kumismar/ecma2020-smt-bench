(assert (or (not (<= (str.len y) 125)) (not (= "a" (str.substr z 5 1)))))
(assert (or (not (str.contains y " onmoused")) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]+(?:[\s-][a-zA-Z]+)*$")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]{3} ?(?!sa|SA|sd|SD|ss|SS)[a-zA-Z]{2}$")))))
