(assert (or (= x "<dir onmousedown=""alert(1)"">test</dir>") (= x "<ScRipT 5-0*3+9\u{10348}/3=>prompt(1)</ScRipT giveanswerhere=?") (= x "<BR SIZE=""&{javascript:alert(1)}"">")))
(assert (or (= z "ript:alert(130)"">CLICKME</math>") (= z "ditable>test</a>")))
(assert (= y (str.++ x z)))
