; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video draggable=""true"" ondragleave=""alert(1)"">test</video>") (= x "<optgroup id=x tabindex=1 onactivate=alert(1)></optgroup>")))
(assert (or (= z "vg><sub onload=alert(1)></sub>") (= z ">") (= z "ble=""true"" ondragenter=""alert(1)"">test</dfn>")))
(assert (= y (str.++ x z)))
(assert (not (= "vg><sub onalert(1)=alert(1)></sub>" (str.replace z "load" "alert(1)"))))
(assert (or (str.contains (str.replace z ">" """") """") (= (str.len y) 109)))
(assert (not (= (str.at y 57) "o")))
(assert (= (str.indexof z "dra" 0) 13))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^\d{5}(-\d{4})?$")) (= (str.len x) 59)))
(assert (or (not (str.contains (str.replace x """tru" " ") "le= e")) (str.prefixof "b" z) (= (str.at x 55) "p")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "([_a-zA-Z0-9-\.]+)@([a-zA-Z0-9-\.]+)\.([a-zA-Z0-9]{2,6})"))))
(assert (or (= (str.at z 0) ">") (str.contains x "=""")))
(check-sat)
