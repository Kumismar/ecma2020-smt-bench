; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link onmouseover=""alert(1)"">test</link>") (= x "<optgroup draggable=""true"" ondragstart=""alert(1)"">test</optgroup>") (= x "<hgroup onbeforecut=""alert(1)"" contenteditable>test</hgroup>")))
(assert (or (= z "tofocus>") (= z ";/SCRIPT>;")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "star" 0) 33)) (not (= (str.indexof y "t(1)""" 0) 23))))
(assert (not (str.suffixof "group>" x)))
(assert (not (= (str.at z 0) ";")))
(assert (or (not (= "<link o" (str.substr y 0 7))) (= "tart=""aler" (str.substr x 34 10)) (not (>= (str.len z) 25))))
(assert (or (str.contains (str.replace y "tab" "javascript:") "dijavascript:le>te") (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9-+s()]*$"))) (= (str.indexof x "rt" 0) 21)))
(assert (or (not (str.prefixof "<header " x)) (str.suffixof "ofocus>" z)))
(check-sat)
