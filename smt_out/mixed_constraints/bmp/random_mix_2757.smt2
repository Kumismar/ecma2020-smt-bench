; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp draggable=""true"" ondragleave=""alert(1)"">test</rp>") (= x "<svg><xmp onload=alert(1)></xmp>")))
(assert (or (= z "=alert(1)></h1>") (= z "sindex onbeforecut=""alert(1)"" contenteditable>test</isindex>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{2,12}$")) (= (str.at y 50) "r") (not (= (str.indexof y "est" 0) 45))))
(assert (or (not (str.contains y "be")) (not (str.contains x "(1) typ"))))
(assert (or (str.prefixof "<rp " x) (not (str.in_re z ((_ re.from_regex ecma2020) "^[_A-Za-z0-9-]+(\.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*(\.[A-Za-z]{2,4})$")))))
(assert (or (not (str.contains x "rt(")) (not (str.contains (str.replace z """al" "javascript:") "t=javascript:ert(1"))))
(assert (str.contains (str.replace x "e"" on" "x") """truxdr"))
(assert (or (not (str.prefixof "<svg" y)) (not (str.contains (str.replace x "</xmp" """") "1)>"">"))))
(check-sat)
