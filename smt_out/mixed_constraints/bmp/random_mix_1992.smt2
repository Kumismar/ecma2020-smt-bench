; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><font ondrop=alert(1) contenteditable>drop here</font>") (= x "<caption onbeforecopy=""alert(1)"" contenteditable>test</caption>") (= x "<form id=x tabindex=1 onactivate=alert(1)></form>")))
(assert (or (= z "ticol>") (= z "span onkeyup=""alert(1)"" contenteditable>test</span>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "ticol>" z))
(assert (or (str.contains z "/spa") (not (= "st" (str.substr y 51 2)))))
(assert (or (not (= (str.at z 29) "n")) (not (str.contains z "onkey"))))
(assert (= (str.indexof x "lert(" 0) 65))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^([A-Z\u{104}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b}a-z\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}]+[,.]?[ ]?|[A-Z\u{104}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b}a-z\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}]+['-]?)+")) (not (= (str.indexof y "n:" 0) 71))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[ +()0-9]*"))))
(check-sat)
