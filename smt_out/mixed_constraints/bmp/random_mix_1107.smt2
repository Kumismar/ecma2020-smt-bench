; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param onmouseout=""a\u{1d400}lert(1)"">test</param>") (= x "<tbody id=x tabindex=1 onfocusin=alert(1)></tbody>") (= x "<input draggable=""true"" ondragenter=""alert(1)"">test</input>")))
(assert (or (= z "e=""alert(1)"">te\u{1f4a9}st</t\u{1f4a9}itle>") (= z "1)</ScRipT giveanswerhere=?")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace z "t\u{1f4a9}" "alert(1)") "t</alert(1)itle>")))
(assert (or (not (>= (str.len x) 49)) (= (str.at z 7) "1")))
(assert (not (str.prefixof "<param" y)))
(assert (or (str.contains z "1)"">te\u{1f4a9}st<") (not (str.suffixof "ody>" x))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "(?=^.{6,}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$"))) (not (str.prefixof "e=""alert(" z))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d *?){11}$"))) (not (= "1)</SpT giveanswerhere=?" (str.replace z "cRi" "")))))
(assert (or (str.prefixof "<param" x) (not (= (str.indexof x "58;//" 0) 19))))
(assert (= """ o" (str.substr y 22 3)))
(check-sat)
