; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><video style=""animation-name:x"" onanimationstart=""alert(1)""></video>") (= x "<multicol onmouseleave=""alert(1)"">test</multicol>") (= x "<LINK REL=""stylesheet"" HREF=""javascript:javascript:alert(1);"">")))
(assert (or (= z "able=""true"" ondragenter=""alert(1)"">test</colgroup>") (= z "frames x{}</style><hr style=""animation-name:x"" onanimationstart=""alert(1)""></hr>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "le=""" 0) 74)))
(assert (or (<= (str.len z) 34) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{4}[-][0-9]{4}[-][0-9]{4}[-][0-9]{4}"))) (not (= (str.indexof z "f" 0) 0))))
(assert (= (str.indexof y "col" 0) 6))
(assert (or (= (str.len z) 80) (= (str.at z 77) "h")))
(assert (or (= (str.len x) 90) (not (str.suffixof "colgroup>" z))))
(assert (or (str.contains z "</") (not (= (str.at z 24) "y")) (str.contains x "1)"">t\u{1f4a9}")))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^\w+([-+.']\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*$")))
(check-sat)
