; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th onkeypress=""alert(1)"" contenteditable>test</th>") (= x "<i draggable=""true"" ondrag=""alert(1)"">test</i>")))
(assert (or (= z "v><frameset ondragover=alert(1) contenteditable>drop here</frameset>") (= z "re ondrop=alert(1) contenteditable>drop here</picture>") (= z "\x00>javascript:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<s" x)) (not (= "re ondrop=alert(1) contentedjavascript:table>drop here</picture>" (str.replace z "i" "javascript:")))))
(assert (not (>= (str.len y) 104)))
(assert (str.contains (str.replace z "e" "javascript:") "rjavascript: "))
(assert (= """aggable=""true"" ondrag=""alert(1)"">test</i>" (str.replace x "<i dr" """")))
(assert (not (str.suffixof "focus>" z)))
(assert (= (str.at z 64) "s"))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{f1}\u{d1} _]*[A-Za-z0-9\u{f1}\u{d1}][A-Za-z0-9\u{f1}\u{d1} _]*$")) (not (= "ntentedit" (str.substr z 21 9)))))
(assert (not (= (str.indexof y ">\x00" 0) 45)))
(check-sat)
