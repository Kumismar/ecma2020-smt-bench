; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""94""><svg xmlns=""http://www.w3.org/2000/svg"">") (= x "<bgsound onmousemove=""alert(1)"">test</bgsound>") (= x "<style>:target {transform: rotate(180deg);}</style><dir id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dir>")))
(assert (or (= z "e=""alert(1)"">test</iframe>") (= z "1) contenteditable>drop here</body>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "00/svg"">" (str.substr x 45 9))) (not (= "script:a" (str.substr z 11 8)))))
(assert (or (not (= (str.indexof z "(1)"">" 0) 8)) (not (str.prefixof "<style>" y))))
(assert (str.contains (str.replace y "`-" """") "\u{1f600}""'""-"))
(assert (or (= "<div id=""94""><svg xmlns=""http://www.w3.org/2000/svg"">1) ""tenteditable>drop here</body>" (str.replace y "con" """")) (not (str.suffixof "t</iframe>" y))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[1-9]{1}$")))
(assert (not (= "alert(1" (str.substr y 127 7))))
(assert (not (= (str.len x) 53)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^((0?[1-9])|([1-2][0-9])|(3[0-1]))$"))) (= (str.indexof z "e=""tr" 0) 5)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9_-]+@[a-zA-Z0-9-]{2,}[.][a-zA-Z]{2,3}$"))))
(assert (not (str.prefixof "<div id" x)))
(assert (= (str.indexof x "abl" 0) 14))
(check-sat)
