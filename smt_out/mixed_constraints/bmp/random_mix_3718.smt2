; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param onfocusout=alert(1) tabindex=1 id=x></param><input autofocus>") (= x "<tt id=x tabindex=1 onbeforeactivate=alert(1)></tt>")))
(assert (or (= z "transform 2s"" ontransitionrun=alert(1)></div>") (= z "');"">") (= z "ex=1 onactivate=alert(1)></figcaption>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 20) "t") (= (str.indexof z "1)>" 0) 22)))
(assert (not (= "x>" (str.replace z "');""" "x"))))
(assert (or (not (>= (str.len y) 84)) (str.prefixof "<tt id=x" x) (not (str.suffixof "caption>" z))))
(assert (or (= (str.indexof y "aler" 0) 37) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{e4}\u{f6}\u{fc}\u{df}\u{c4}\u{d6}\u{dc}.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9\u{e4}\u{f6}\u{fc}\u{df}\u{c4}\u{d6}\u{dc}.-]+\.[a-zA-Z]+$")))))
(assert (or (not (str.prefixof "<" x)) (not (str.suffixof "</tt>" x))))
(assert (or (not (= (str.at x 27) "t")) (not (str.prefixof "<param o" x))))
(assert (not (str.suffixof "on>" y)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[*+!.&#$|'\\%0-9a-z^_`{}=?~:-]+@([a-z0-9_-]+\.)+[A-Za-z]{2,}$")))
(check-sat)
