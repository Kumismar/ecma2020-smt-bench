; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style oncut=""alert(1)"" contenteditable>test</style>") (= x "<style>:target {color: red;}</style><acronym id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></acronym>")))
(assert (or (= z "x></object><input autofocus>") (= z "ter>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "([A-z0-9_.-]{1,})@([A-z0-9_.-]{1,}).([A-z]{2,8})"))))
(assert (or (not (= (str.indexof x "t(1)""" 0) 18)) (not (str.prefixof "te" z))))
(assert (or (not (str.suffixof ">" z)) (= (str.at y 115) "m")))
(assert (or (= (str.indexof z " auto" 0) 17) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9()\-+Xx\s,]+$"))))
(assert (or (= (str.indexof x "=""t" 0) 55) (not (str.in_re x ((_ re.from_regex ecma2020) "(\d{11})|^((\d{7,8})|(\d{4}|\d{3})-(\d{7,8})|(\d{4}|\d{3})-(\d{7,8})-(\d{4}|\d{3}|\d{2}|\d{1})|(\d{7,8})-(\d{4}|\d{3}|\d{2}|\d{1}))$"))) (not (= "<style>:target {color: red;javascript:/style><acronym id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></acronym>ter>" (str.replace y "}<" "javascript:")))))
(assert (str.prefixof "<st" x))
(check-sat)
