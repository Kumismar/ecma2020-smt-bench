; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q draggable=""true"" ondragleave=""alert(1)"">test</q>") (= x "<nextid draggable=""true"" ondragenter=""alert(1)"">test</nextid>")))
(assert (or (= z "k=""alert(1)"">test</mark>") (= z "yle><dir id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dir>")))
(assert (= y (str.++ x z)))
(assert (not (= "<q draggable=""true"" ondragleave=""alert(1)alert(1)est</q>yle><dir id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dir>" (str.replace y """>t" "alert(1)"))))
(assert (str.suffixof "></a>" y))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{5}(?:-\d{4})?$"))) (= "m" (str.substr z 1 1)) (not (str.suffixof "></dir>" z))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9\+\-\(\)\s]+.$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9\/\-\+\s\(\)]*$")))))
(assert (= (str.at z 5) "e"))
(assert (str.prefixof "yle>" z))
(assert (or (<= (str.len z) 17) (str.suffixof "rm>" x)))
(assert (or (= "k=""a" (str.substr z 0 4)) (str.contains (str.replace x "st</n" """") ")"">te""extid")))
(check-sat)
