; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><iframe id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></iframe>") (= x "<keygen oncut=""alert(1)"" contenteditable>test</keygen>")))
(assert (or (= z " ontransitioncancel=alert(1)></wbr>") (= z "=alert(1) contenteditable>drop here</track>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "nteditabl" (str.substr z 15 9))) (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9\-.'\s]{0,39}$")) (not (= (str.at x 33) "t"))))
(assert (or (not (= (str.at y 93) "c")) (= "=alert(1) conten""able>drop here</track>" (str.replace z "tedit" """"))))
(assert (or (not (str.suffixof "br>" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_-]+@[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+)+$"))) (not (= "sition:col" (str.substr y 60 10)))))
(assert (or (str.suffixof "r>" y) (not (= (str.indexof x "n" 0) 6)) (str.suffixof "(1)></wbr>" y)))
(assert (not (= (str.at x 48) "e")))
(check-sat)
