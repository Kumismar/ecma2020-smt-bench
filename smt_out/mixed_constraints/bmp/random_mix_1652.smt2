; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s onmouseup=""alert(1)"">test</s>") (= x "<nav draggable=""true"" ondrag=""alert(1)"">test</nav>")))
(assert (or (= z "ref=""\xE2\x80\x89javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "tenteditable>test</link>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(\w+[-.+&%])*\w+@([-0-9a-zA-Z]+[.])+[a-zA-Z]{2,6}$"))))
(assert (<= (str.len z) 75))
(assert (not (= "ble>" (str.substr z 9 4))))
(assert (or (not (str.contains z "rt(")) (not (= (str.at x 26) "/")) (not (str.suffixof "</link>" y))))
(assert (or (not (str.contains z "entedit")) (>= (str.len y) 107) (not (= "itable>" (str.substr z 6 7)))))
(assert (not (str.contains y ":jav")))
(assert (not (= (str.at x 43) "t")))
(assert (= "t</lin" (str.substr z 16 6)))
(check-sat)
