; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><rtc id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></rtc>") (= x "<small\u{1f600} id=x tabindex=1 onfocus=alert(\u{1f4a9}1)></small>") (= x "<section onmousedown=""alert(1)"">test</section>")))
(assert (or (= z "cus>") (= z "b>") (= z "index=1 onfocus=alert(1)></html>")))
(assert (= y (str.++ x z)))
(assert (= "/sect" (str.substr x 37 5)))
(assert (or (not (= (str.indexof z ">" 0) 1)) (not (str.in_re y ((_ re.from_regex ecma2020) "(?=.*\d).{1,20}")))))
(assert (or (= """>t" (str.substr x 30 3)) (str.suffixof ")></html>" y) (not (str.suffixof "b>" z))))
(assert (= (str.at x 25) """"))
(assert (or (= (str.indexof y "l" 0) 23) (str.suffixof ">cus>" y)))
(assert (= (str.indexof y "on>b" 0) 43))
(assert (= (str.at x 13) "t"))
(check-sat)
