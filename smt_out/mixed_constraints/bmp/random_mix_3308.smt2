; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt draggable=""true"" ondragend=""alert(1)"">test</dt>") (= x "<svg><bdi onload=alert(1)></bdi>")))
(assert (or (= z "x tabindex=1 ondeactivate=alert(1)></li><input id=y autofocus>") (= z ">test</hgroup>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "cript" z)))
(assert (or (str.suffixof "p>" y) (= "lert(1)>" (str.substr x 18 8))))
(assert (or (not (= (str.len y) 94)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(SM[0-9]{5}|(IS|CH)[0-9]{6}|(ATU|DK|FI|LU|MT|SI|HU)[0-9]{8}|(BE0|DE|EE|EL|GR|PT|\u{423}\u{41d}\u{41f}|IL|RS|UZ)[0-9]{9}|(PL|SK|TR|UA)[0-9]{10}|(AU|IT|LV|HR)[0-9]{11}|(SE|PH)[0-9]{12}|(CA|ID)[0-9]{15}|BG[0-9]{9,10}|CY[0-9]{8}L|CZ[0-9]{8,10}|ES[0-9A-Z][0-9]{7}[0-9A-Z]|FR[0-9A-Z]{2}[0-9]{9}|GB([0-9]{9}([0-9]{3})?|[A-Z]{2}[0-9]{3})|IE[0-9]S[0-9]{5}L|LT([0-9]{9,12}|[0-9]{12})|NL[0-9]{9}B[0-9]{2}|RO[0-9]{2,10}|(ALK|ALJ)[0-9]{8}L|IN[0-9]{11}(V|C)|NO[0-9]{9}MVA|RU[0-9]{10,12}|CHE[0-9]{9}(TVA|MWST|IVA))$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]+(([',. -][a-zA-Z0-9 ])?[a-zA-Z0-9]*)*$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9 a-z A-Z]$"))) (= (str.indexof y "r" 0) 20)))
(assert (not (<= (str.len x) 34)))
(check-sat)
