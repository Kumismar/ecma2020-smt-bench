; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video draggable=""true"" ondragstart=""alert(1)"">test</video>") (= x "<;DIV STYLE="";background-image: url(&;#1;javascript:alert(';XSS';))"";>;")))
(assert (or (= z "rt(1)"" contenteditable>test</source>") (= z "alert(1)"">test</style>") (= z "ert(1)"">test</meta>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "beha" z)) (not (str.suffixof "ource>" y))))
(assert (or (= " 1)"">test</meta>" (str.replace z "ert(" " ")) (= (str.at x 26) "m") (= (str.indexof y "lert" 0) 38)))
(assert (or (not (str.contains y "/sourc")) (not (str.contains (str.replace y "=""ale" " ") "start rt(")) (str.prefixof "<video d" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{1,3}(,\d{3})*(\.\d+|)?$"))) (not (= (str.indexof y "d-ima" 0) 23))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\D{1,20}$"))))
(assert (or (str.contains (str.replace y "3""><s" "javascript:") "2javascript:pan c") (not (str.suffixof "style>" y))))
(check-sat)
