; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp oncontextmenu=""alert(1)"">test</samp>") (= x "<style>@keyframes x{}</style><template style=""animation-name:x"" onanimationend=""alert(1)""></template>")))
(assert (or (= z "us=alert(1)></hgroup>") (= z "menu=""alert(1)"">test</p>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 7) "l")) (not (= (str.indexof z "a" 0) 8)) (str.in_re y ((_ re.from_regex ecma2020) "^\+?(?=(?:.*\d){10})[\d \-.\(\)\[\]/]{10,20}$"))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^(\+)?[\(\)\.\-\d\s]+$")))
(assert (not (str.contains y "ented")))
(assert (or (str.suffixof ">\u{20000}" z) (not (str.in_re x ((_ re.from_regex ecma2020) "^(\d){3}(-)(\d){8}$")))))
(assert (= (str.len y) 63))
(assert (or (not (>= (str.len x) 39)) (not (= (str.len x) 42))))
(check-sat)
