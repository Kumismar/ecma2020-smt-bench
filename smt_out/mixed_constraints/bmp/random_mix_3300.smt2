; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i oncopy=""alert(1)"" contenteditable>test</i>") (= x "<blink oncut=""alert(1)"" contenteditable>test</b\u{1f4a9}link>") (= x "&lt;&lt;SCRIPT&gt;alert(&quot;XSS&quot;);//&lt;&lt;/SCRIPT&gt;")))
(assert (or (= z "test</head\u{1f600}>") (= z "r:red;}</style><ol id=x style=""transition:color 1s"" ontransitionend=alert(1)></ol>") (= z "mouseup=""alert(1)"">test</output>")))
(assert (= y (str.++ x z)))
(assert (= "gt;aler" (str.substr x 15 7)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d@$!%*#?&\.,\| ]{8,16}$"))) (not (= "tent" (str.substr x 24 4)))))
(assert (= "tedit" (str.substr y 27 5)))
(assert (or (= (str.indexof z " onm" 0) 1) (= (str.len y) 94)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(\s*|[A-Za-z \-]){1,1}$"))))
(assert (or (not (= (str.at x 48) "l")) (not (str.prefixof "<b" y)) (str.contains z "st</head")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(?:\(?\+?48)?(?:[-\.\(\)\s]*(\d)){9}\)?$"))))
(assert (or (not (str.contains y "blink onc")) (str.contains y "ead\u{1f600}")))
(check-sat)
