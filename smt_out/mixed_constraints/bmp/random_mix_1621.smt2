(assert (= (str.indexof x "d=x><" 0) 41))
(assert (or (str.contains (str.replace x " a" "alert(1)") "inputalert(1)utof") (= "></d" (str.substr y 44 4))))
(assert (<= (str.len x) 43))
(assert (= "R" (str.substr z 39 1)))
(check-sat)
