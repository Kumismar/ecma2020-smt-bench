; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter id=x tabindex=1 onbeforeactivate=alert(1)></meter>") (= x "<element draggable=""true"" ondrag=""alert(1)"">test</element>")))
(assert (or (= z "ndblclick=""alert(1)"">test</bdo>") (= z "ction,[{}][0].constructor._('javascript:alert(1)')()</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 16) "n")) (str.contains y " dr") (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9-/\s]*")))))
(assert (or (str.suffixof "oframes>" x) (not (= """ ondra" (str.substr y 24 7)))))
(assert (not (= (str.at y 106) "'")))
(assert (or (not (= (str.indexof x "id=" 0) 7)) (not (= (str.at z 52) "<"))))
(check-sat)
