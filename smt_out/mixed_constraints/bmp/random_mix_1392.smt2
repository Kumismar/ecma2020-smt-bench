; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark ondblclick=""alert(1)"">test</mark>") (= x "<summary onpaste=""alert(1)"" contenteditable>test</summary>") (= x "<thead onmouseout=""alert(1)"">test</thead>")))
(assert (or (= z "e=""true"" ondragleave=""alert(1)"">test</meta>") (= z "t;SCRIPT/XSS SRC=&quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;") (= z "fn onmouseout=""alert(1)"">test</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z """" 0) 14) (not (str.prefixof "<su" x)) (not (str.contains x "mma"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{7}$"))) (not (= (str.len y) 132))))
(assert (not (= (str.indexof x "ou" 0) 10)))
(assert (not (str.suffixof "/meta>" z)))
(assert (not (str.prefixof "t;" z)))
(assert (or (= "e=""true"" onjavascript:leave=""alert(1)"">test</meta>" (str.replace z "drag" "javascript:")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z\u{105}\u{104}\u{107}\u{107}\u{119}\u{119}\u{142}\u{141}\u{144}\u{143}\u{f3}\u{d3}\u{15b}\u{15a}\u{17c}\u{17b}\u{179}\u{179} ]{4,30}$"))) (= (str.at y 16) "=")))
(check-sat)
