; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u draggable=""true"" ondragstart=""alert(1)"">test</u>") (= x "<blink id=x tabindex=1 onbeforeactivate=alert(1)></blink>") (= x "<figure onpaste=""alert(1)"" contenteditable>test</figure>")))
(assert (or (= z "ragstart=""alert(1)"">test</dl>") (= z "ditable>drag me</div><meta ondragover=alert(1) contenteditable>drop here</meta>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "xtid>" y))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(\+420)? ?[1-9][0-9]{2} ?[0-9]{3} ?[0-9]{3}$"))) (str.contains (str.replace x "</bli" "alert(1)") ")>alert(1)n")))
(assert (not (str.suffixof "re</meta>" y)))
(assert (or (not (str.contains (str.replace x """" "") "te=alert")) (str.contains x "dex=1") (<= (str.len z) 46)))
(assert (or (= "onblur=a" (str.substr y 3 8)) (str.suffixof "/dl>" z) (<= (str.len x) 67)))
(assert (or (not (<= (str.len y) 90)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[2-9]{1}\d{2}[- ]?\d{3}[- ]?\d{4}$"))) (str.contains (str.replace x "ragga" "x") " dxble")))
(check-sat)
