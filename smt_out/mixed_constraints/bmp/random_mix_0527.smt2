; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta http-equiv=""refresh"" content=""0;url=javascript:document.vulnerable=true;"">") (= x "<link onmouseout=""alert(1)"">test</li\u{10348}nk>")))
(assert (or (= z "ml5sec.org/test.html!xss.html></iframe>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[\u{30a1}-\u{30f3}\u{30f4}\u{30fc}0-9|\u{3000}| ]+$"))) (= "est</li\u{10348}n" (str.substr x 29 9)) (not (= (str.len y) 41))))
(assert (or (= "/li\u{10348}nk" (str.substr x 33 6)) (= (str.len x) 80)))
(assert (or (<= (str.len z) 10) (= (str.at z 21) "/")))
(assert (not (str.contains (str.replace y "=java" """") "l""scri")))
(assert (or (not (str.prefixof "<lin" x)) (not (str.contains z "est"))))
(check-sat)
