; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area onkeydown=""alert(1)"" contenteditable>test</area>") (= x "<noscript onmo\u{1f4a9}useup=""alert(1)"">test</noscript>")))
(assert (or (= z "sitioncancel=alert(1)></basefont>") (= z "tle>") (= z "ondragenter=""alert(1)"">test</tfoot>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^0([1-7]|9)$"))) (str.suffixof "se>" x)))
(assert (or (>= (str.len x) 47) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\s,.'-]{3,}$"))) (not (str.prefixof "<dt" x))))
(assert (or (not (= "name\u{20000}=""password"" type=""password"" v""ue=""secret"" />" (str.replace z "al" """"))) (= (str.at x 29) "n")))
(assert (or (not (<= (str.len x) 55)) (str.contains (str.replace y "i" "javascript:") "tedjavascript:t") (str.contains z "t</tfoo")))
(check-sat)
