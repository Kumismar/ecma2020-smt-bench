; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main id=x tabindex=1 onbeforedeactivate=alert(1)></main><input autofocus>") (= x "<svg id=x onfocusin=alert(1)>")))
(assert (or (= z "G SRC=x onpopstate=""alert(String.fromCharCode(88,83,83))"">") (= z "onbeforedeactivate=alert(1)></slot><input autofocus>") (= z " id=x style=""transition:color 1s"" ontransitionend=alert(1)></ins>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "npu" 0) 66)) (not (str.suffixof "/link>" z)) (str.in_re z ((_ re.from_regex ecma2020) "\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}\b"))))
(assert (or (= "<svg id=x onfocuxn=alert(1)>" (str.replace x "si" "x")) (= (str.at x 21) " ")))
(assert (or (not (= (str.len z) 58)) (not (= "blockquo" (str.substr y 28 8))) (= " id=x style=""transition:coljavascript:1s"" ontransitionend=alert(1)></ins>" (str.replace z "or " "javascript:"))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{7,}$")))
(assert (or (str.prefixof "<s" x) (not (= (str.at x 44) "r")) (not (str.suffixof ")" z))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{f1}']{2,}([\s][A-Za-z\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{f1}']{2,})+$"))) (not (= (str.at x 4) " "))))
(assert (= (str.indexof x "u" 0) 15))
(check-sat)
