; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tt draggable=""true"" ondragstart=""alert(1)"">test</tt>") (= x "<noscript draggable=""true"" ondrag=""alert(1)"">test</noscript>") (= x "<t\u{1d400}extarea onmouseover=""alert(1)""\u{20000}>test</textarea>")))
(assert (or (= z "lick=""alert(1)"">test</section>") (= z "onclick=""alert(1)"">test</li>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "ale" (str.substr z 9 3))) (str.prefixof "onclick=" z) (not (= (str.indexof x "nos" 0) 1))))
(assert (or (str.suffixof "st</html>" z) (= "=""" (str.substr z 7 2))))
(assert (not (= (str.indexof y "ag" 0) 6)))
(assert (not (= (str.at z 3) "a")))
(assert (not (str.contains x "tr")))
(assert (or (not (str.suffixof "a>" x)) (str.prefixof "<ol oncon" y)))
(assert (or (not (= (str.at x 0) "<")) (not (= "ript dr" (str.substr y 5 7)))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "(\+?\d[-() .]*){7,13}"))))
(check-sat)
