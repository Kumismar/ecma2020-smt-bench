; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend onbeforepaste=""alert(1)"" contenteditable>test</legend>") (= x "<iframe id=x tabindex=1 ondeactivate=alert(1)></iframe><input id=y autofocus>")))
(assert (or (= z """ ondragstart=""alert(1)"">test</li>") (= z "t\u{1f4a9}alist onload=alert(1)></datalist>") (= z "TJyk8L3NjcmlwdD4K"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= "v" (str.substr x 32 1))) (not (str.contains z "/l")) (= (str.at z 2) "a")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^0\d{1,3}-?\d{2,4}-?\d{4}"))) (not (str.contains (str.replace x "t" "alert(1)") "<alert(1)im"))))
(assert (or (not (str.prefixof "<legend " x)) (not (= (str.indexof y "e" 0) 6)) (= (str.indexof z "li" 0) 31)))
(assert (= (str.at y 95) "r"))
(assert (or (>= (str.len z) 31) (not (= (str.indexof y "er" 0) 39)) (str.contains z "Jyk8L")))
(assert (or (= "<legend onbeforepaste=""a t(1)"" contenteditable>test</legend>" (str.replace x "ler" " ")) (= (str.at z 7) "<") (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9]{6,200}"))))
(check-sat)
