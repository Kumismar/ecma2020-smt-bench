; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><body ondragover=alert(1) contenteditable>drop here</body>") (= x "<tr oncopy=""alert(1)"" contenteditable>test</tr>") (= x "<div draggable=""true"" contenteditable>drag me</div><time ondrop=alert(1) contenteditable>drop here</time>")))
(assert (or (= z "t</big>") (= z "ert(1)></a>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<" x) (str.in_re x ((_ re.from_regex ecma2020) "^\d[0-9]{9,11}$")) (<= (str.len x) 116)))
(assert (or (not (str.contains (str.replace x "\u{10348}00" "<b>") "\u{10348}&#x<b>3C;")) (= (str.indexof x "dr" 0) 5)))
(assert (str.suffixof ">" x))
(assert (or (>= (str.len y) 48) (= "java" (str.substr y 39 4)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[\u{3041}-\u{3093}\u{3094}\u{30fc}\u{3000} ]*$")))))
(assert (or (= "<alert(1)r oncopy=""alert(1)"" contenteditable>test</tr>ert(1)></a>" (str.replace y "t" "alert(1)")) (not (= "(1)></a" (str.substr y 112 7)))))
(check-sat)
