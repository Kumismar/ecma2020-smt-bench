; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo onfocusout=alert(1) tabindex=1 id=x></bdo><input autofocus>") (= x "<i onmouseup=""alert(1)"">test</i>")))
(assert (or (= z "le\u{1d400}rt(\u{1f600}1)"">test</ins>") (= z """ contenteditable>test</u>") (= z "ert(1)"" contenteditable>test</element>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<bdo onfocusout=alert(1) tabindex=1 id=xx/bdo><input autofocus>" (str.replace x "><" "x"))) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Z]{5}[0-9]{4}[A-Z]{1}"))) (not (str.prefixof "ert" z))))
(assert (not (= (str.at y 11) "s")))
(assert (or (not (str.contains x "dra")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9_\+-]+(\.[A-Za-z0-9_\+-]+)*@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.([a-z]{2,4})$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9+\s/-]{5,}"))))
(assert (or (not (>= (str.len z) 25)) (not (str.suffixof "gend>" y))))
(assert (= "<i " (str.substr x 0 3)))
(check-sat)
