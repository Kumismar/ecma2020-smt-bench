; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><noframes ondragover=alert(1) contenteditable>drop here</noframes>") (= x "<nextid onmouseout=""alert(1)"">test</nextid>")))
(assert (or (= z "er onmouseup=""alert(1)"">test</meter>") (= z "</time>") (= z ">test</hr>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "/time>" y))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}\u{104}\u{106}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b}\-. ]{1,100}$"))))
(assert (= "/met" (str.substr y 146 4)))
(assert (= "nten" (str.substr x 24 4)))
(assert (not (<= (str.len z) 16)))
(assert (= (str.indexof y ">t" 0) 27))
(assert (or (= (str.indexof z "tim" 0) 2) (= (str.indexof y "u" 0) 18)))
(assert (<= (str.len z) 27))
(assert (or (>= (str.len y) 151) (not (str.contains (str.replace x "ne" """") "<""xti")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[_a-zA-Z0-9-]+(\.[_a-zA-Z0-9-]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*(\.[a-zA-Z]{2,3})$")))))
(assert (or (not (str.prefixof "<ne" x)) (str.prefixof "<div " x)))
(check-sat)
