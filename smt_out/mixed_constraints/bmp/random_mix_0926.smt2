; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form onkeydown=""alert(1)"" contenteditable>test</form>") (= x "<map id=x tabindex=1 onb\u{20000}eforedeactivate=alert(1)></map><inp\u{1f4a9}ut autofocus>") (= x "<bdo onmouseenter=""alert(1)"">test</bdo>")))
(assert (or (= z "utofocus>") (= z "opy=""alert(1)"" contenteditable>test</option>") (= z """true"" ondragend=""alert(1)"">test</style>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<map id=x tabindex=1 onb\u{20000}eforedeactivate=alert(1)<b>/map><inp\u{1f4a9}ut autofocus>utofocus>" (str.replace y "><" "<b>"))) (str.suffixof "x03c;" x) (str.in_re z ((_ re.from_regex ecma2020) "(13[0-9]|14[5|7]|15[0|1|2|3|5|6|7|8|9]|18[0|1|2|3|5|6|7|8|9]|17[0|1|2|3|5|6|7|8|9]|19[0|1|2|3|5|6|7|8|9])\d{8}$"))))
(assert (= (str.at x 9) "e"))
(assert (not (= (str.indexof y "m>uto" 0) 52)))
(assert (or (= "lert(1)"">" (str.substr y 73 9)) (str.in_re x ((_ re.from_regex ecma2020) "[0-9Antrag]+")) (not (str.in_re x ((_ re.from_regex ecma2020) "^\S.{6,}\S$")))))
(assert (or (not (>= (str.len z) 40)) (not (str.contains z "tofoc"))))
(assert (not (str.suffixof "ocus>" z)))
(assert (or (not (= (str.indexof y "to" 0) 40)) (str.contains z "scrip")))
(assert (or (str.contains x "ydown=""a") (not (str.prefixof "<t" y))))
(check-sat)
