; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb onclick=""alert(1)"">test</rb>") (= x "<br onkeypress=""alert(1)"" contenteditable>test</br>")))
(assert (or (= z ">") (= z "=""alert(1)"">test</menuitem>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_-]([a-zA-Z0-9_-]|\.[a-zA-Z0-9_-])*@[a-zA-Z0-9_-]+\.[a-zA-Z0-9_-]([a-zA-Z0-9_-]|\.[a-zA-Z0-9_-])*$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9\() ]{9,}")))))
(assert (or (= "<rb onclick=""alert(1)"">testrb>>" (str.replace y "</" "")) (= ">" (str.substr x 50 5))))
(assert (or (not (>= (str.len x) 16)) (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9 ]{1,}")) (str.prefixof "<rb onclic" y)))
(assert (or (= "keyp" (str.substr x 6 4)) (not (str.prefixof "<scr<scr" y))))
(assert (or (str.contains (str.replace z ">" "<b>") "<b>") (= "<rb onclick=""alert(1)"">t rb>=""alert(1)"">test</menuitem>" (str.replace y "est</" " "))))
(check-sat)
