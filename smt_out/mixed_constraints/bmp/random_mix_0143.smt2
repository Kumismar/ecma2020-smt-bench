; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "SRC=&#10<IMG 6;&#97;&#118;&#97;&#115;&#99;&#114;&#105;&#112;&#116;\u{1f4a9}&#58;&#97;&#108;&#\u{1f600}101;&#114;&#116;&#40;&#39;&#88;&#83;&#83;&#39;&#41;>") (= x "<div draggable=""true"" contenteditable>drag me</div><samp ondragover=alert(1) contenteditable>drop here</samp>") (= x "<rb onmouseleave=""alert(1)"">test</rb>")))
(assert (or (= z "autofocus>") (= z " onmouseout=""alert(1)"">test</area>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^\w{5,10}$")) (str.prefixof "SR" y) (not (str.in_re y ((_ re.from_regex ecma2020) "^([\d\+\-\(\)\s]{3,})+[0-9]{4,}$")))))
(assert (or (>= (str.len y) 45) (= (str.indexof z ">test" 0) 22) (= (str.len z) 3)))
(assert (= (str.indexof x "1)"">" 0) 24))
(assert (not (= (str.at x 5) "k")))
(assert (or (str.contains y "ve=""alert") (str.contains (str.replace z "a" " ") " uto")))
(assert (or (str.contains x "b onmous") (not (str.suffixof "utofocus>" y)) (= (str.at y 60) "t")))
(assert (= "<rb onmouseleave=""alert(1)alert(1)t</rb>" (str.replace x """>tes" "alert(1)")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "([\w\d]){6,12}"))))
(check-sat)
