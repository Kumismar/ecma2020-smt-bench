; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video autoplay onplaying=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= x "<div draggable=""true"" contenteditable>drag me</div><option ondrop=alert(1) contenteditable>drop here</option>") (= x "<style>:target {color:red;}</style><wbr id=x style=""transition:col\u{1f600}or 1s"" ontransitionend=alert(1)></wbr>")))
(assert (or (= z "tyle><hgroup style=""animation-name:x"" onanimationstart=""alert(1)""></hgroup>") (= z "basefont onmouseover=""alert(1)"">test</basefont>") (= z """></element>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "p>" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{2}.[0-9]{3}.[0-9]{3}/[0-9]{4}-[0-9]{2}$"))) (= "nt o" (str.substr z 6 4)) (= (str.indexof y "m" 0) 59)))
(assert (or (str.prefixof """><" z) (= """><" (str.substr z 0 3)) (not (str.contains z "foreact"))))
(assert (or (str.suffixof "/hgroup>" z) (str.suffixof "(1)></wbr>" x) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9_!#$%&'\x22*+/=?`{|}~^.-]+@[A-Za-z0-9[\]:.-]+\.[A-Za-z0-9[\]:-]{2,}$")))))
(assert (str.contains (str.replace y "a" "") "v drggab"))
(check-sat)
