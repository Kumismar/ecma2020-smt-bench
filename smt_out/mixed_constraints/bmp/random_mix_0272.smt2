; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><br id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></br>") (= x """`'><script>\xE2\x80\x8Ajavascript:alert(1)</script>")))
(assert (or (= z "id=x></rb><input autofocus>") (= z "t(1)></map>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "pu" "<b>") "><in<b>t aut")) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9\s\-_]+"))) (not (str.contains (str.replace x " s" "javascript:") "d=xjavascript:t"))))
(assert (or (not (<= (str.len y) 66)) (= (str.at z 21) "f")))
(assert (or (= """`'><script>\xE2\x80\x8Ajavascript:alert(1)</script>id=x></rb><injavascript:utofocus>" (str.replace y "put a" "javascript:")) (not (str.contains z "est</b"))))
(assert (not (str.suffixof "/map>" y)))
(check-sat)
