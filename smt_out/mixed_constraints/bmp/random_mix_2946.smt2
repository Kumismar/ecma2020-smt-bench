; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<big onbeforecut=""alert(1)"" contenteditable>test</big>") (= x "<body onhelp=alert(1)>press F1! (MSIE)") (= x "<frame onmousedown=""alert(1)"">test</frame>")))
(assert (or (= z "2 p=2 ??XSS??") (= z "lert('XSS');//") (= z "oframes>")))
(assert (= y (str.++ x z)))
(assert (or (not (= ")"">" (str.substr y 27 3))) (str.suffixof "?" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}$"))))
(assert (or (= " onbefo" (str.substr x 4 7)) (not (str.contains x "wn=""al"))))
(assert (str.suffixof ">" z))
(assert (not (= "?XSS??" (str.substr z 7 6))))
(assert (or (not (= (str.indexof y "nmous" 0) 8)) (not (str.contains y "nmousedown")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-z0-9!#$%\x26'*+/=?^_`{|}~-]+(?:\.[a-z0-9!#$%\x26'*+/=?^_`{|}~-]+)*@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$")))))
(assert (not (str.contains z "lert('XSS'")))
(check-sat)
