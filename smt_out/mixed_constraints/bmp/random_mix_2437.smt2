; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound onkeypress=""alert(1)"" contenteditable>test</bgsound>") (= x "<frameset draggable=""true"" ondragleave=""alert(1)"">test</frameset>")))
(assert (or (= z "ate=alert(1)></ol>") (= z "onkeydown=""alert(1)"" contenteditable>test</s>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "ntedi")) (not (>= (str.len z) 37)) (not (str.contains x "="""))))
(assert (or (not (= (str.indexof y "=""" 0) 19)) (not (str.prefixof "<framese" y))))
(assert (= "javascript:eset draggable=""true"" ondragleave=""alert(1)"">test</frameset>ate=alert(1)></ol>" (str.replace y "<fram" "javascript:")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) ".*?\."))))
(assert (or (= (str.indexof y "ke" 0) 67) (str.suffixof "ound>" x)))
(check-sat)
