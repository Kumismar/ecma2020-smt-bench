; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed src=1 onerror=alert(1) type=image/gif>") (= x "<form onsubmit=alert(1)><input type=submit>")))
(assert (or (= z "e.png""><image onload=alert(1)></picture>") (= z "(1)"">test</figcaption>") (= z "table>drop here</rtc>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{4}[\-\/\s]?((((0[13578])|(1[02]))[\-\/\s]?(([0-2][0-9])|(3[01])))|(((0[469])|(11))[\-\/\s]?(([0-2][0-9])|(30)))|(02[\-\/\s]?[0-2][0-9]))$"))) (str.contains (str.replace x "dex" "") "abin=1 ") (<= (str.len x) 48)))
(assert (or (str.prefixof "<e" y) (not (= "1)" (str.substr x 32 2)))))
(assert (or (str.prefixof "<embed " y) (not (>= (str.len x) 43)) (not (str.prefixof "<em" x))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[0-99]*")) (not (>= (str.len y) 80))))
(assert (or (= (str.indexof y "t" 0) 25) (not (str.contains (str.replace y "ror" "javascript:") "onerjavascript:=aler"))))
(assert (or (not (str.contains (str.replace x "t=a" "alert(1)") "ubmialert(1)lert(")) (not (str.in_re x ((_ re.from_regex ecma2020) "^([\u{5c}u30A1-\u{5c}u30FC|\u{5c}u3000]+)$")))))
(check-sat)
