; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th id=x tabindex=1 onactivate=alert(1)></th>") (= x "<keygen id=x tabindex=1 onactivate=alert(1)></keygen>")))
(assert (or (= z """ ondrag=""alert(1)"">test</nobr>") (= z "table>test</wbr>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof """" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-z0-9](?:[a-z0-9]|[-_](?=[a-z0-9])){0,38}$"))) (not (str.suffixof "r>" y))))
(assert (or (= (str.indexof x "<k" 0) 0) (= (str.at z 3) "n") (= (str.at y 33) "e")))
(assert (not (str.contains y "eygen id=x")))
(assert (or (= (str.indexof x "e=al" 0) 33) (not (str.prefixof "le>test<" z))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]{3,}(?: [a-zA-Z]+){0,2}$"))))
(check-sat)
