; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed id=x tabindex=1 onbeforeactivate=alert(1)></noembed>") (= x "\u{1f600}<style>@keyframes x{}</style><wbr style=""animation-name:x"" onanimationstart=""alert(1)""></wbr>")))
(assert (or (= z "ondragover=alert(1) contenteditable>drop here</option>") (= z "roup>") (= z "&apos;XSS&apos;);&lt;/STYLE&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len y) 99)) (str.contains (str.replace y "&gt;" "x") "STYLEx") (= "<noembed id=x tabindex=1 onbeforeactivate=alert(1)></noembed>ondrago<b>=alert(1) contenteditable>drop here</option>" (str.replace y "ver" "<b>"))))
(assert (not (str.suffixof "r>" x)))
(assert (or (not (= "ion-n" (str.substr y 48 5))) (not (= "d=x tabind" (str.substr x 10 10))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[\+]?[0-9]{1,3}[\s]?[\(]?[0-9]{0,2}[\)]?[\s]?[0-9\s]{10,14}")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[\d-]+$"))))
(check-sat)
