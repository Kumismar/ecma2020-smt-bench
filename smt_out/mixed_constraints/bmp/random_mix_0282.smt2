; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><sub style=""animation-name:x"" onanimationend=""alert(1)""></sub>") (= x "<style>@keyframes x{}</style><label style=""animation-name:x"" onanimationstart=""alert(1)""></label>")))
(assert (or (= z "nteditable>test</rb>") (= z "rror=\x0Bjavascript:alert(1)\x0Bsrc=xxx:x />")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(?:[A-\u{d6}]|[a-\u{f6}]|[\s])*$"))) (not (= (str.at x 17) " "))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "(^$)|(^[a-zA-Z0-9\u{5c}u00C0-\u{5c}u00D6\u{5c}u00D8-\u{5c}u00F6\u{5c}u00F8-\u{5c}u00FF][-a-zA-Z0-9.'& \u{5c}u00C0-\u{5c}u00D6\u{5c}u00D8-\u{5c}u00F6\u{5c}u00F8-\u{5c}u00FF]{1,}$)"))))
(assert (not (<= (str.len z) 52)))
(assert (not (str.contains x "ti")))
(assert (str.contains x ".rs>"))
(assert (not (str.prefixof "<" y)))
(assert (not (str.prefixof "nt" z)))
(check-sat)
