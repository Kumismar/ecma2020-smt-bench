; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bod\u{1f600}y onhashchange=""alert\u{1f4a9}(1)"">") (= x "<META HTTP-EQUIV=""refresh"" CONTENT=""0; URL=http://;URL=javascript:alert('XSS');"">") (= x "<? echo('<SCR)';echo('IPT>alert(""XSS"")</SCRIPT>'); ?>")))
(assert (or (= z "er onbeforecopy=""alert(1)"" contenteditable>test</center>") (= z " ondrag=""alert(1)"">test</option>") (= z "cus=alert(1)></hgroup>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9\.]{3,8}"))))
(assert (not (= (str.indexof x "e=" 0) 18)))
(assert (or (not (str.contains z "xxx=")) (not (= (str.indexof y "');" 0) 47))))
(assert (str.prefixof "<M" x))
(assert (or (not (>= (str.len x) 25)) (= (str.indexof y "rag=""" 0) 36)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[\u{5c}u30A1-\u{5c}u30F6\s\u{30fc}]*")) (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9\s\w\._ -]{2,30}")) (not (= "o(" (str.substr y 19 2)))))
(assert (str.suffixof "/div>" x))
(assert (or (str.prefixof "<? echo('<" x) (not (str.contains y "ec"))))
(check-sat)
