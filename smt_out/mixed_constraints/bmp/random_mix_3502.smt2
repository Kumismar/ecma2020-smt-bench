; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp onbeforepaste=""alert(1)"" contenteditable>test</samp>") (= x "<body onblur=alert(1) id=x><iframe id=x>")))
(assert (or (= z " id=\u{1f600}x tabindex=1 onfocusin=alert(1)></col>") (= z "avascript:alert(&;quot;XSS&;quot;)>;")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "(^[A-Za-z]{2}[0-9]{2}\s?[A-Za-z]{3}$)|(^[A-Za-z][0-9]{1,3}[A-Za-z]{3}$)|(^[A-Za-z]{3}[0-9]{1,3}[A-Za-z]$)|(^[0-9]{1,4}[A-Za-z]{1,2}$)|(^[0-9]{1,3}[A-Z]{1,3}$)|(^[A-Z]{1,2}[0-9]{1,4}$)|(^[A-Za-z]{1,3}[0-9]{1,3}$)|(^[A-Za-z]{1,3}[0-9]{1,4}$)|(^[0-9]{3}[DX]{1}[0-9]{3}$)"))))
(assert (= (str.at z 19) "n"))
(assert (or (not (= (str.indexof y "</s" 0) 51)) (= """ conte" (str.substr x 29 7))))
(assert (or (not (str.contains x "test</s")) (str.contains z "t(")))
(assert (or (= (str.at z 24) "s") (not (= (str.indexof y "bod" 0) 1))))
(assert (or (not (str.contains (str.replace y "C=""h" " ") "'"" SR ttp")) (not (= (str.indexof z "tab" 0) 7)) (str.suffixof "ol>" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9+]{8,}$"))))
(assert (or (not (str.prefixof "<samp " x)) (str.suffixof "l>" z)))
(check-sat)
