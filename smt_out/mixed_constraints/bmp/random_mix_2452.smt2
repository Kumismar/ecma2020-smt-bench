; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i id=x tabindex=1 onfocus=alert(1)></i>") (= x "<script id=x tabindex=1 onfocus=alert(1)></script>")))
(assert (or (= z "opy=""alert(1)"" contenteditable>test</s>") (= z "o('<SCR)';") (= z "nd>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "(^\d{15}$)|(^\d{18}$)|(^\d{17}(\d|X|x)$)"))))
(assert (not (str.contains z "e><inpu")))
(assert (or (str.prefixof "<script " y) (= (str.at z 5) "a")))
(assert (or (not (str.prefixof "nd" z)) (not (str.suffixof "cript>" x))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\s()+-]*([0-9][\s()+-]*){6,20}$"))) (not (>= (str.len y) 169))))
(assert (or (= " " (str.substr x 7 1)) (not (str.in_re x ((_ re.from_regex ecma2020) "^([A-Za-z0-9_\-\.])+\@([A-Za-z0-9_\-\.])+\.([A-Za-z]{2,4})$")))))
(check-sat)
