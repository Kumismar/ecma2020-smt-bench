; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a id=x tabindex=1 onbeforeactivate=alert(1)></a>") (= x "<map id=x tabindex=1 onactivate=alert(1)></map>") (= x "<div draggable=""true"" contenteditable>drag me</div><q ondragover=alert(1) contenteditable>drop here</q>")))
(assert (or (= z "contenteditable>test</var>") (= z """ contenteditable>test</area>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z A-Z 0-9 \u{df}]$"))) (not (= (str.at x 94) " ")) (str.prefixof "<" y)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "(?=.*[a-zA-Z])[\w\s]{1,64}")))
(assert (or (not (= "i" (str.substr y 26 1))) (= "p id=x " (str.substr x 3 7))))
(assert (or (not (str.suffixof "</address>" z)) (str.suffixof "(1)></a>" x) (not (= (str.at x 2) "r"))))
(assert (or (not (str.prefixof "nmouseo" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9, ]*$"))) (not (str.prefixof "<d" x))))
(assert (or (not (= (str.indexof x "conte" 0) 22)) (str.suffixof "ea>" y)))
(check-sat)
