; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """><img src=x onerror=javascript:alert((""1""))>") (= x "<footer onmousedown=""alert(1)"">test</footer>") (= x "<style>@keyframes x{}</style><strike style=""animation-name:x"" onanimationend=""alert(1)""></strike>")))
(assert (or (= z " contenteditable>test</track>") (= z "cript&colon;\u{5c}u0061&#x6C;&#101%72t(1)>") (= z "ert(1)"">test</element>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-za-z0-9.-]+\.[A-Za-z]{2,3}$"))))
(assert (or (not (= "ooter " (str.substr x 2 6))) (not (= (str.indexof x "er>" 0) 41)) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{6,14}")))))
(assert (= "&colon;\u{5c}u" (str.substr y 50 9)))
(assert (or (not (str.suffixof "</dialog>" z)) (= (str.len z) 48)))
(assert (or (str.suffixof "ement>" z) (not (>= (str.len x) 111)) (not (str.contains (str.replace z "st<" "javascript:") ")"">tejavascript:/elem"))))
(assert (not (= (str.at x 95) "e")))
(check-sat)
