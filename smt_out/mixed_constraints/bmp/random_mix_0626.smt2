; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg onbeforecut=""alert(1)"" contenteditable>test</svg>") (= x "<font id=x tabindex=1 onactivate=alert(1)></font>")))
(assert (or (= z "t id=y autofocus>") (= z "(1)"">test</form>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "est</form>" y) (str.contains (str.replace z "autof" "<b>") "id=y <b>oc") (not (= (str.indexof z "=y au" 0) 4))))
(assert (or (= (str.indexof y "><" 0) 41) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z]\d{6}([a-zA-Z]|\d)$")) (not (= (str.at z 8) "u"))))
(assert (or (str.prefixof "<" y) (not (= "tatec" (str.substr x 16 5)))))
(assert (or (str.contains (str.replace z "1)"">" " ") "( te") (str.contains x "1 on")))
(assert (or (not (>= (str.len z) 11)) (= (str.at x 105) "e") (= (str.at y 57) """")))
(check-sat)
