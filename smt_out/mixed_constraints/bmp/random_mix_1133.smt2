; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid draggable=""true"" ondragstart=""alert(1)"">test</nextid>") (= x "<video src=1 onerror=alert(1)>") (= x "<div draggable=""true"" contenteditable>drag me</div><ul ondrop=alert(1)\u{10348} contenteditable>drop here</ul>")))
(assert (or (= z "st o\u{1d400}n\u{1f4a9}mouseup=""alert(1)"">test</datalist>") (= z "ta on\u{20000}mouseenter=""alert(1)"">test</data>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "o " (str.substr x 5 2))) (not (str.contains (str.replace z "st" " ") ">te </")) (= "p://www.w3" (str.substr y 69 10))))
(assert (not (str.suffixof "datalist>" z)))
(assert (not (str.contains z "useent")))
(assert (str.suffixof "data>" z))
(assert (or (= "<nextid draggable=""true"" ondragstart=""alert(1)"">t</nextid>st o\u{1d400}n\u{1f4a9}mouseup=""alert(1)"">test</datalist>" (str.replace y "est" "")) (not (= (str.indexof x "able>" 0) 33))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-zA-Z]{2,5}$"))) (= (str.indexof x "c=1 o" 0) 9)))
(assert (or (= (str.at z 40) ">") (str.suffixof "ist>" z)))
(assert (or (not (= "r=alert(" (str.substr x 19 8))) (str.contains x " src=1 o")))
(check-sat)
