; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time id=x tabindex=1 onbeforeactivate=alert(1)></time>") (= x "<img draggable=""true"" ondragenter=""alert(1)"">test</img>")))
(assert (or (= z "tion>") (= z "ble>drag me</div><multicol ondrop=alert(1) contenteditable>\u{1f4a9}drop here</multicol>") (= z "nextid>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof ">" y)) (<= (str.len y) 66)))
(assert (or (str.suffixof "asefont>" y) (not (= "n>" (str.substr z 3 4)))))
(assert (or (= (str.indexof z "ti" 0) 3) (= (str.len y) 62)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(13[0-9]|15[0-9]|18[0-9])d{8}$"))) (= "nextid>" (str.substr z 0 10))))
(assert (or (not (>= (str.len y) 54)) (str.in_re x ((_ re.from_regex ecma2020) ".{2,5}")) (not (= "mm" (str.substr y 3 2)))))
(check-sat)
