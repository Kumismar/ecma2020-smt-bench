; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source ondblclick=""alert(1)"">test</source>") (= x "<source onbeforepaste=""alert(1)"" contenteditable>test</source>") (= x "<del oncut=""alert(1)"" contenteditable>test</del>")))
(assert (or (= z "onbeforecopy=""alert(1)"" contenteditable>test</center>") (= z "py this!")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "t" "x") "epasxe=""")) (not (= (str.at z 47) "e"))))
(assert (or (not (= (str.indexof y "edi" 0) 29)) (not (str.contains (str.replace y "ble>t" "<b>") "dita<b>est</"))))
(assert (str.contains z " th"))
(assert (or (= (str.indexof z "is!" 0) 5) (str.prefixof "onbe" z)))
(assert (or (= (str.indexof y "</me" 0) 40) (not (str.prefixof "<s" y))))
(assert (or (not (= (str.at z 13) "h")) (not (str.in_re y ((_ re.from_regex ecma2020) "^\+?[\d\s\.*]+$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.#\s]+$"))) (= "efor" (str.substr y 65 4))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-1]?[0-9]"))))
(assert (not (str.prefixof "<d" y)))
(check-sat)
