; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<map onbeforecopy=""alert(1)"" contenteditable>test</map>") (= x "&#X003c") (= x "<style>:target {color:red;}</style><marquee id=x style=""transition:color 1s"" ontransitionend=alert(1)></marquee>")))
(assert (or (= z ".fromCharCode(88\u{1d400},83,83))"">") (= z "nteditable>test</table>") (= z "1)"">test</nextid>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "." z))
(assert (or (= (str.indexof x "</st" 0) 27) (= (str.len y) 75) (str.contains (str.replace x "00" "<b>") "X<b>3c")))
(assert (not (str.suffixof "t</map>" x)))
(assert (not (= (str.at x 18) "l")))
(assert (not (str.suffixof "</marquee>" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[1-9\(]{1}[0-9\-\s\.\(\)]+$")) (<= (str.len y) 82) (str.contains (str.replace x "foc" "alert(1)") "toalert(1)us>")))
(check-sat)
