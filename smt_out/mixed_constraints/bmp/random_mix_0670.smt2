; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><blockquote ondragover=alert(1) contenteditable>drop here</blockquote>") (= x "<bdi onblur=alert(1) tabindex=1 id=x></bdi><input autofocus>")))
(assert (or (= z "rue;</script>") (= z "=1 id=x></area><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<" y) (str.prefixof "=1 id=x></" z) (= "ipt>" (str.substr z 0 4))))
(assert (or (= "able" (str.substr x 10 4)) (= (str.indexof y " id=x" 0) 31)))
(assert (or (not (= "rue;</<b>ript>" (str.replace z "sc" "<b>"))) (not (str.prefixof "<di" x))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[^\s]+[-a-zA-Z\s]+([-a-zA-Z]+)*$")))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^\d*(\.\d{4}$)?")))
(check-sat)
