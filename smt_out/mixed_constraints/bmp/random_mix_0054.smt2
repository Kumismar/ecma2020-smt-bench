; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#X003c;") (= x "</br style=a:expression(alert())>")))
(assert (or (= z "=""alert(1)"">test</audio>") (= z " onmousedown=""alert(1)"">test</acronym>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 8) "d")) (not (str.prefixof ">" z))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[^0-9][a-zA-Z0-9_]+([.][a-zA-Z0-9_]+)*[@][a-zA-Z0-9_-]+([.][a-zA-Z0-9_-]+)*[.][a-zA-Z]{2,4}$"))) (= " onmouse" (str.substr y 33 8))))
(assert (or (= (str.indexof x "ssion" 0) 18) (str.suffixof "/script>" x) (str.suffixof "lert())>" x)))
(assert (or (= (str.at y 6) "n") (not (= "X00" (str.substr x 2 3)))))
(assert (or (str.prefixof "&#X003" y) (= (str.len z) 24)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9A-Za-z]{2}[\-0-9A-Za-z]{0,27}[0-9A-Za-z]{2}"))))
(assert (str.suffixof "rt())>" x))
(assert (not (= "nmousedown" (str.substr z 2 10))))
(check-sat)
