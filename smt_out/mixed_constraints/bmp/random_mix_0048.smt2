; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem onpaste=\u{1f4a9}""alert(1\u{1d400})"" contenteditable>test</menuitem>") (= x "<script>alert(1337)</script><marquee><h1>XSS by xss</h1></marquee>")))
(assert (or (= z "index=1 onfocus=alert(1)></output>") (= z "me:x"" onanimationstart=""alert(1)""></del>") (= z "ate=alert(1)></title>")))
(assert (= y (str.++ x z)))
(assert (= (str.len y) 83))
(assert (= (str.at y 48) "x"))
(assert (or (not (str.suffixof "></output>" y)) (str.contains y "t(")))
(assert (or (not (= "ut>" (str.substr y 97 8))) (not (str.in_re z ((_ re.from_regex ecma2020) "^09[0-9]{8}$")))))
(assert (or (not (str.contains x "st")) (str.contains x "marq")))
(check-sat)
