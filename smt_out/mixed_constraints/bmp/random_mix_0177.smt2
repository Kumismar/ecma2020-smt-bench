; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><tt style=""animation-name:x"" onanimationstart=""alert(1)""></tt>") (= x "<IFRAME SRC=\u{201d}http://hacker-site.com/xss.html\u{201d}>") (= x "<div id=""39""><!-- up to Opera 11.52, FF 3.6.28 -->")))
(assert (or (= z "ED&gt;") (= z "test</main>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "est</main>" z) (str.suffixof "/main>" y)))
(assert (or (= (str.indexof y "F" 0) 37) (= (str.indexof x "e.co" 0) 30) (str.in_re x ((_ re.from_regex ecma2020) "^([0-9]{13,16})$"))))
(assert (or (not (>= (str.len x) 61)) (= "<tbody oncut=""alealert(1))"" contenteditable>test</tbody>" (str.replace x "rt(1" "alert(1)"))))
(assert (not (str.contains (str.replace x "cted" "<b>") "nje<b>"" v")))
(check-sat)
