; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed src=""data:text/html;base64,%(base64)s"">") (= x "<script>ReferenceError.prototype.__defineGetter__('name', function(){javascript:alert(1)}),x</script>")))
(assert (or (= z "</html>") (= z "ecut=""alert(1)"" contenteditable>test</strike>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9-\s]+$"))))
(assert (or (not (= ",x<" (str.substr y 90 3))) (= (str.len x) 40) (= "ecut=""alert(1)"" alert(1)tenteditable>test</strike>" (str.replace z "con" "alert(1)"))))
(assert (not (str.contains y "base6")))
(assert (not (= "<script>ReferenceError.prototype.__defineGetter__<b>e', function(){javascript:alert(1)}),x</script>" (str.replace x "('nam" "<b>"))))
(assert (not (str.contains y "t=""aler")))
(assert (or (= (str.indexof y "/html" 0) 21) (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,20})$"))) (= "t<" (str.substr x 44 2))))
(assert (not (= "<script>ReferError.prototype.__defineGetter__('name', function(){javascript:alert(1)}),x</script>" (str.replace x "ence" ""))))
(check-sat)
