; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style onreadystatechange=alert(1)></style>") (= x "<summary id=x tabindex=1 onfocusin=alert(1)></summary>")))
(assert (or (= z "ert(1)"">test</applet>") (= z "058;alert('XSS')\""")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z ]{1,40}"))) (not (str.prefixof "ert(1)"">t" z)) (str.suffixof "d>nxxx=1" y)))
(assert (not (= (str.indexof y "nr" 0) 8)))
(assert (or (not (= "058;alert('XSS')" (str.replace z "\""" ""))) (= (str.len x) 54)))
(assert (or (not (str.contains y "mmary i")) (not (str.suffixof "ry>" x)) (not (<= (str.len x) 52))))
(check-sat)
