; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet draggable=""true"" ondrag=""alert(1)"">test</applet>") (= x "<textarea onselect=alert(1) autofocus>XSS</textarea>")))
(assert (or (= z "se onpaste=""alert(1)"" contenteditable>test</base>") (= z "down=""alert(1)"" contenteditable>test</track>") (= z """>test</head>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "t</track>" y)) (= "<applet xraggable=""true"" ondrag=""alert(1)"">test</applet>se onpaste=""alert(1)"" contenteditable>test</base>" (str.replace y "d" "x")) (str.suffixof "/track>" y)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(.*\d.*){6,}$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[-_0-9A-Za-z]+$")))))
(assert (or (not (= (str.at z 9) "e")) (= (str.at y 31) "i")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(20|21)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])")) (not (= (str.at x 16) "c")) (= "edit" (str.substr z 23 4))))
(assert (str.suffixof "t</applet>" x))
(assert (not (= "plet" (str.substr y 3 4))))
(check-sat)
