; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter draggable=""true"" ondragstart=""alert(1)"">test</meter>") (= x "<figure id=x tabindex=1 ondeactivate=alert(1)></figure><input id=y autofocus>") (= x "<legend onbeforecut=""alert(1)"" contenteditable>test</legend>")))
(assert (or (= z "wbr>") (= z "&apos;);&quot;&gt;") (= z "t</title>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 76) (not (= (str.indexof x "vate=" 0) 32)) (= (str.at z 3) ">")))
(assert (or (= (str.at x 2) "i") (= "br>" (str.substr z 1 5)) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\s*|[A-Za-z \-]){1,1}$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-1][0-9]/[0-3][0-9]/[0-9][0-9]"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^.{10,11}$"))))
(assert (or (not (str.prefixof "<figure i" x)) (str.contains x "le=""tru") (not (= (str.at y 34) """"))))
(check-sat)
