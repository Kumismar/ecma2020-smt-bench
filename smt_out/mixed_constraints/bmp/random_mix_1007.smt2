; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<output onmouseover=""alert(1)"">test</output>") (= x "<map oncopy=""alert(1)"" contenteditable>test</map>") (= x "&#x00003c")))
(assert (or (= z "ecut=""alert(1)"" contenteditable>test</dt>") (= z "meset onmousemove=""alert(1)"">test</frameset>") (= z "tenteditable>test</th>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) ".+\.[a-zA-Z]+$"))) (str.suffixof "/th>" y)))
(assert (or (not (str.contains (str.replace x "<ma" " ") " p o")) (not (= (str.at x 5) "u")) (not (str.contains (str.replace z "c" "") "eut="))))
(assert (= (str.indexof y "ue" 0) 5))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^([0-2]?[0-9]|3[01])$")) (str.prefixof "&#x" y)))
(assert (or (= (str.indexof x "0" 0) 3) (= (str.indexof z "onten" 0) 17)))
(assert (or (not (= (str.at z 4) " ")) (str.contains (str.replace y "1)""" "javascript:") "rt(javascript:>tes") (= "/" (str.substr x 36 1))))
(check-sat)
