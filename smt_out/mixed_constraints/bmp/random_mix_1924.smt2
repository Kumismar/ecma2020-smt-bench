; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=""jav    ascript:javascript:alert(1);"">") (= x "<code draggable=""true"" ondragend=""alert(1)"">test</code>")))
(assert (or (= z "itable>test</embed>") (= z "up>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[0-9-]*")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\-\.\(\)\s]+$")))))
(assert (or (str.contains (str.replace z "p" "javascript:") "ujavascript:>") (not (str.suffixof "p>" z)) (str.in_re x ((_ re.from_regex ecma2020) "^[\w\u{5c}u4e00-\u{5c}u9fa5\-]{1,20}$"))))
(assert (or (= (str.indexof x "st</" 0) 46) (not (= (str.at x 42) """")) (= (str.indexof y "a" 0) 7)))
(assert (or (not (str.prefixof "<code d" y)) (= (str.indexof y ";"">up" 0) 44) (not (str.contains x "cript:"))))
(assert (or (not (str.contains z "p>")) (str.suffixof ");"">" x) (str.suffixof "st</embed>" y)))
(check-sat)
