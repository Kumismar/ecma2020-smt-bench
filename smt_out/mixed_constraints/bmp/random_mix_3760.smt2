; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead draggable=""true"" ondragend=""alert(1)"">test</thead>") (= x "<img usemap=#x><map name=""x""><area href onfocus=alert(1) id=x>") (= x "<div draggable=""true"" contenteditable>drag me</div><details ondragover=alert(1) contenteditable>drop here</details>")))
(assert (or (= z "ondragleave=""alert(1)"">test</ins>") (= z """>test</applet>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "est<" 0) 3)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$"))) (= (str.indexof z "(""XSS" 0) 5)))
(assert (or (not (= (str.indexof x "ame=" 0) 21)) (str.in_re y ((_ re.from_regex ecma2020) "^\(*\+*[1-9]{0,3}\)*-*[1-9]{0,3}[-. /]*\(*[2-9]\d{2}\)*[-. /]*\d{3}[-. /]*\d{4} *\.* *\d{0,4}$")) (<= (str.len x) 121)))
(assert (or (= (str.at x 22) "m") (= "dr" (str.substr y 7 2)) (not (= "ondragleavexalert(1)"">test</ins>" (str.replace z "=""" "x")))))
(assert (or (not (= (str.at z 11) "=")) (str.prefixof "<d" x) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]+[0-9]$")))))
(check-sat)
