; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><a style=""animation-name:x"" onanimationend=""alert(1)""></a>") (= x "<style>:target {color: red;}</style><picture id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></picture>") (= x "<output onmousedown=""alert(1)"">test</output>")))
(assert (or (= z "move=""alert(1)"">test</big>") (= z "draggable=""true"" ondragend=""alert(1)"">test</ruby>") (= z "listing>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{6}$")) (str.prefixof "dragga" z)))
(assert (or (not (str.suffixof "uby>" y)) (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{3}|[0-9]{1,3})(\]?)$"))))
(assert (str.prefixof "move=""a" z))
(assert (or (= (str.indexof y "(1" 0) 78) (not (str.contains y "ert(1\u{10348})"" c"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\S.{6,}\S$"))))
(assert (not (= (str.at z 26) "=")))
(assert (or (not (<= (str.len y) 133)) (not (= "0" (str.substr x 75 1))) (= (str.indexof x "focus" 0) 68)))
(check-sat)
