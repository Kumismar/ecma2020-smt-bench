; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><ul ondrop=alert(1)\u{10348} contenteditable>drop here</ul>") (= x "<SCRIPT/SRC=""http://ha.ckers.org/xss.js""></SCRIPT>") (= x "<style>:target {color:red;}</style><strike id=x style=""transition:color 1s"" ontransitionend=alert(1)></strike>")))
(assert (or (= z """true"" ondragstart=""alert(1)"">test</del>") (= z "ody oncopy=""alert(1)"" contenteditable>test</tbody>") (= z "t type&#61;""date"" onfocus=""alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len x) 69)))
(assert (or (= "<div draggable=""true"" contenteditable>drag me</div><ul ondxalert(1)\u{10348} contenteditable>drop here</ul>" (str.replace x "rop=" "x")) (= (str.len z) 37)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z][a-zA-Z0-9_\.\-]*")) (not (= "e</ul>" (str.substr x 96 8))) (not (str.contains (str.replace x "C=" "") "SR""ht"))))
(assert (or (str.suffixof "del>" z) (not (= (str.at x 2) "i")) (not (str.in_re y ((_ re.from_regex ecma2020) "^LC\d{3,7}$")))))
(assert (or (not (= (str.indexof x "ed" 0) 23)) (str.prefixof "<style" y)))
(check-sat)
