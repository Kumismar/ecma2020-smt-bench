; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><tfoot onload=alert(1)></tfoot>") (= x "<div onbeforecopy=""alert(1)"" contenteditable>test</div>")))
(assert (or (= z " contenteditable>test</source>") (= z ">") (= z "eactivate=alert(1)></center\u{1f600}><input id=y au\u{1f4a9}tofocus>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "ert(1)>" y))
(assert (or (= "<legen<b> id=x tabindex=1 onfocusin=alert(1)></legend>s\u{1d400}trong>" (str.replace y "d" "<b>")) (= (str.indexof y "t> c" 0) 34)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6,}$"))))
(assert (or (not (= (str.indexof x "oot>" 0) 32)) (not (= (str.len y) 56)) (str.contains (str.replace z "nt" " ") " co ent")))
(assert (or (not (<= (str.len x) 64)) (str.contains z ">")))
(check-sat)
