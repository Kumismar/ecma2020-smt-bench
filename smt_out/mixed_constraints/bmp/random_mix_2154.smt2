; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex ondblclick=\u{1f600}""alert(1)"">t\u{20000}est</isindex>") (= x "<dfn onbeforepaste=""alert(1)"" contenteditable>test</dfn>")))
(assert (or (= z "ert(1)"" contenteditable>test</img>") (= z "group>") (= z "1)></dt>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 41) "i"))
(assert (or (= "Count=2 /" (str.substr y 102 9)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{2,4}[0-9]{4,10}"))) (str.suffixof "00060" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(^[1][358][0-9]{9}$)|(^[9][1235678][0-9]{7}$)"))) (<= (str.len x) 63)))
(assert (or (= "ble>" (str.substr x 42 4)) (= "dt>" (str.substr z 5 3))))
(check-sat)
