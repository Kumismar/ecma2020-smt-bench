; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<slot onkeypress=""alert(1)"" contenteditable>test</slot>") (= x "<nextid onkeydown=""alert(1)"" contenteditable>test</nextid>")))
(assert (or (= z "</div>") (= z "stest.xml""; ID=I>;<;/XML>;")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "/XML>;" z) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\u{3041}-\u{3093}\u{30fc}]*$"))) (= "ss:noxss(""" (str.substr z 12 10))))
(assert (or (not (<= (str.len x) 67)) (= (str.indexof x "t</s" 0) 47) (not (= "nt" (str.substr y 33 2)))))
(assert (or (not (str.contains y "=I>;")) (not (= (str.indexof x "=" 0) 16))))
(assert (not (str.prefixof "<frame" x)))
(assert (or (= (str.at x 44) ">") (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9])+([a-zA-Z0-9._-])*@([a-zA-Z0-9_-])+([a-zA-Z0-9._-]+)+$")))))
(check-sat)
