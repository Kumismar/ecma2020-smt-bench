; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=\u{201d}jav ascript:alert(\u{2018}XSS\u{2019});\u{201d}>") (= x "<input onblur=alert(1) id=x><input autofocus>") (= x "<caption onmouseover=""alert(1)"">test</caption>")))
(assert (or (= z "><input autofocus>") (= z "ulnerable=true;//--></script>") (= z "color 10s"" ontransitioncancel=alert(1)></menu>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{6,15}"))))
(assert (not (str.prefixof "<caption o" y)))
(assert (or (not (= "n" (str.substr y 98 1))) (not (= "<IMG SRC=\u{201d}jav ascript:alert(\u{2018}XSS\u{2019});\u{201d}>><inpjavascript:t autofocus>" (str.replace y "u" "javascript:"))) (str.suffixof "pt>" z)))
(assert (or (= "ble=tr" (str.substr y 52 6)) (= "<captioalert(1) onmouseover=""alert(1)"">test</caption>color 10s"" ontransitioncancel=alert(1)></menu>" (str.replace y "n" "alert(1)")) (str.suffixof "ofocus>" z)))
(assert (or (= (str.indexof y "ip" 0) 18) (not (= (str.at y 45) "e"))))
(assert (or (not (str.prefixof "<I" x)) (= "<caption onmouseover=""alertalert(1))"">test</caption>color 10s"" ontransitioncancel=alert(1)></menu>" (str.replace y "(1" "alert(1)"))))
(check-sat)
