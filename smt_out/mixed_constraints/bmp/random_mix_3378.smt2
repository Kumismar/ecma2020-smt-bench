; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element onblur=alert(1) tabindex=1 id=x></element><input autofocus>") (= x "<svg><thead onload=alert(1)></thead>")))
(assert (or (= z "ar onmouseleave=""alert(1)"">test</var>") (= z "ame:x"" onanimationend=""alert(1)""></dt>") (= z "r=alert(1) type=image/gif>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 46) (str.prefixof "<e" x) (= (str.at z 10) "a")))
(assert (= (str.indexof x "mou" 0) 11))
(assert (= (str.at z 3) ":"))
(assert (str.contains (str.replace z "r" """") "a"" onm"))
(assert (or (<= (str.len z) 39) (str.contains y "(1) tab") (str.suffixof "</var>" z)))
(assert (str.prefixof "r=alert" z))
(assert (or (str.contains x "=x></span") (= (str.indexof x "ex=" 0) 31)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{1,10}"))) (not (str.suffixof ">" y))))
(check-sat)
