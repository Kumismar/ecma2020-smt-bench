; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt draggable=""true"" ondragstart=""alert(1)"">test</dt>") (= x "<head id=x tabindex=1 onbeforedeactivate=alert(1)></head><input autofocus>") (= x "<style>:target {color: red;}</style><progress id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></progress>")))
(assert (or (= z "te=alert(1)></progress>") (= z "onbeforedeactivate=alert(1)></bgsound><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^12345$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z-Za ]{1,32}")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9\-\.\s\(\)]*$"))))
(assert (or (not (str.prefixof "<head " x)) (>= (str.len z) 48)))
(assert (or (str.prefixof "1" z) (= "</progre" (str.substr x 108 8))))
(assert (not (= (str.indexof x "hea" 0) 1)))
(assert (str.contains z "t(1)><"))
(check-sat)
