; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;META HTTP-EQUIV=\""refresh\"" CONTENT=\""0;url=javascript&#058;alert('XSS');\""&gt;") (= x "<style draggable=""true"" ondragleave=""alert(1)"">test</style>")))
(assert (or (= z "am id=x tabindex=1 onactivate=alert(1)></param>") (= z "map>") (= z "bindex=1 onfocus=alert(1)></tbody>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "m " (str.substr y 60 2))) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9-&()\[\],. ]{1,150}$"))))
(assert (>= (str.len z) 45))
(assert (or (str.contains y "dex=1 on") (str.suffixof "aram>" z) (str.contains (str.replace x "ONTE" """") "C""NT")))
(assert (or (not (str.suffixof ");\""&gt;" x)) (= (str.indexof z "u" 0) 14)))
(assert (or (= "p>" (str.substr z 2 5)) (not (str.contains y "aggable"))))
(check-sat)
