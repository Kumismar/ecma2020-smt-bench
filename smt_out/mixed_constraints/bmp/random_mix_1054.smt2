; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT&gt;alert(String.fromCharCode(88,83,83))&lt;/SCRIPT&gt;") (= x "<h1 id=x tabindex=1 onfocusin=alert(1)></h1>")))
(assert (or (= z "&safe=high&cx=006665157904466893121:su_tzknyxug&cof=FORID:9#510") (= z "</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "FORI" "javascript:") "of=javascript:D")) (not (str.contains x "3,")) (not (<= (str.len z) 7))))
(assert (or (not (= "i" (str.substr z 7 1))) (not (str.prefixof "</bdi>" z)) (str.prefixof "<" y)))
(assert (or (not (str.contains z "</bdi>")) (str.in_re y ((_ re.from_regex ecma2020) "^([0-9]{13,16})$"))))
(assert (or (str.suffixof "#510" z) (not (= "<h1 id=x tabindex=1 onfocualert(1)></h1></bdi>" (str.replace y "sin=" "")))))
(assert (or (str.contains (str.replace x " " "x") "<h1xid=x") (<= (str.len y) 136) (not (str.suffixof "di>" y))))
(assert (str.suffixof ">" y))
(check-sat)
