; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup draggable=""true"" ondragend=""alert(1)"">test</sup>") (= x "<rp oncopy=""alert(1)"" contenteditable>test</rp>") (= x "<rp onmouseout=""alert(1)"">test</rp>")))
(assert (or (= z "ditable>test</kbd>") (= z "est</tt>") (= z "ge id=x tabindex=1 ondeactivate=alert(1)></image><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace x ">te" "") "(1)""s"))
(assert (or (= (str.indexof x "s" 0) 9) (str.suffixof "t</sup>" x) (not (= (str.indexof x """>t" 0) 41))))
(assert (or (str.contains y "ate=alert") (not (str.in_re x ((_ re.from_regex ecma2020) "^(?:(\d{3})|\d{3})[- ]?\d{3}[- ]?\d{4}$"))) (not (str.contains x "able>te"))))
(assert (or (= (str.indexof y "1)></" 0) 91) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9_]{2,10}")))))
(assert (not (str.suffixof "p>" x)))
(check-sat)
