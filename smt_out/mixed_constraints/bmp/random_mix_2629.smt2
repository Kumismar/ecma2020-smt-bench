; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img\x10src=x onerror=""javascript:alert(1)"">") (= x "<caption onmouseleave=""alert(1)"">test</caption>") (= x "<META HTTP-EQUIV=""refresh"" CONTENT=""0;url=javascript:alert('XSS');"">")))
(assert (or (= z ";") (= z "1)></tr>") (= z "b>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "');"">" x) (not (str.suffixof ")></tr>" z))))
(assert (= "<caption onmou ve=""alert(1)"">test</caption>" (str.replace x "selea" " ")))
(assert (or (>= (str.len z) 1) (not (>= (str.len y) 75)) (= (str.indexof z ";" 0) 0)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[\w\W]{1,4}$"))) (not (str.suffixof ">" z)) (not (= "i" (str.substr x 5 1)))))
(assert (or (not (= "<img\x10src=x oner =""javascript:alert(1)"">;" (str.replace y "ror" " "))) (not (str.contains x "r="""))))
(check-sat)
