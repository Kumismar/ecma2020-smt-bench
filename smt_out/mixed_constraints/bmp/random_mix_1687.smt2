; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr id=x tabindex=1 onbeforeactivate=alert(1)></hr>") (= x "<style>:target {transform: rotate(180deg);}</style><center id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></center>")))
(assert (or (= z "alert(\""XSS\"")>"";' > out") (= z "mage.png onload=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.]{2,20}$"))))
(assert (or (not (str.contains x "mp id=x")) (str.prefixof "alert(\" z) (not (str.prefixof "<hr id=x" y))))
(assert (str.contains (str.replace z "=a" "") "loadler"))
(assert (or (not (= "<alert(1)d=x tabindex=1 onbeforeactivate=alert(1)></hr>mage.png onload=alert(1)>" (str.replace y "hr i" "alert(1)"))) (not (= (str.at x 37) "t")) (= "mage.png o d=alert(1)>" (str.replace z "nloa" " "))))
(check-sat)
