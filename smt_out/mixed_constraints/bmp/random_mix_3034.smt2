; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section onmouseout=""alert(1)"">test</section>") (= x "<meta draggable=""true"" ondrag=""alert(1)"">test</meta>") (= x "<div draggable=""true"" contenteditable>\u{1d400}drag me</div><mark ondragover=alert(1) contenteditable>drop here</mark>")))
(assert (or (= z "svg><button onload=alert(1)></button>") (= z "><br><br><br><br><br><br>\u{20000}<br><br>") (= z "able=""true"" ondragenter=""alert(1)"">test</hgroup>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<meta drag<b>le=""true"" ondrag=""alert(1)"">test</meta>" (str.replace x "gab" "<b>"))) (not (= "<div draggable""""true"" contenteditable>\u{1d400}drag me</div><mark ondragover=alert(1) contenteditable>drop here</mark>><br><br><br><br><br><br>\u{20000}<br><br>" (str.replace y "=" """"))) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z \-]+")))))
(assert (or (not (= (str.at x 86) "d")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9A-Za-z-]+$"))) (str.contains x "edita")))
(assert (not (= "n " (str.substr x 7 2))))
(assert (str.suffixof "ption>" y))
(assert (or (not (str.prefixof "<s" x)) (= (str.indexof x "s>" 0) 42)))
(assert (or (not (= (str.at x 17) "t")) (str.contains y "but")))
(assert (or (str.contains (str.replace x "t" "<b>") "c<b>ion ") (not (= (str.indexof x "lert(" 0) 22))))
(assert (str.suffixof "></button>" y))
(check-sat)
