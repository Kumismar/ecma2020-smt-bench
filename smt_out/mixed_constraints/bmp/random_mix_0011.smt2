; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image draggable=""true"" ondragstart=""alert(1)"">test</image>") (= x "<rp draggable=""true"" ondragstart=""alert(1)"">test</rp>") (= x "<svg ondblclick=""alert(1)"">test</svg>")))
(assert (or (= z "alert(1)"" contenteditable>test</ruby>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "ntent" 0) 12) (= (str.at y 47) "t") (not (str.prefixof "a" z))))
(assert (or (not (str.suffixof ">" z)) (not (str.suffixof ">" x)) (= (str.at y 70) "e")))
(assert (or (<= (str.len x) 61) (not (str.prefixof "<listing" x))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "last-name-validator")))
(assert (or (not (= "<rp draggable=""true"" ondragstart=""xt(1)"">test</rp>" (str.replace x "aler" "x"))) (not (= (str.len y) 38))))
(assert (or (= (str.indexof x "ondra" 0) 21) (= (str.at x 28) "a") (str.prefixof "ert(1)" z)))
(check-sat)
