; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem onbeforecopy=""alert(1)"" contenteditable>test</menuitem>") (= x "<tr onkeyup=""alert(1)"" contenteditable>test</tr>") (= x "<slot onmouseup=""alert(1)"">test</slot>")))
(assert (or (= z """alert(1)""\u{1f600} contenteditable>test</wbr>") (= z "(1)"">test</blockquote>") (= z "keyframes x{}</style><code style=""animation-name:x"" onanimationstart=""alert(1)""></code>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "x style=" (str.substr z 6 8))) (= "i" (str.substr z 21 1)) (= (str.at z 37) ">")))
(assert (= (str.at z 3) "1"))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^([0-9a-zA-Z]+[-._+&])*[0-9a-zA-Z]+@([-0-9a-zA-Z]+[.])+[a-zA-Z]{2,6}$")) (not (str.contains x """alert(1)"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9-]+\.)+[A-Za-z]{2,10}$"))) (= (str.at z 52) "o")))
(check-sat)
