(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "i" 0) 37)) (not (str.prefixof "(1)"">test" z))))
(assert (= (str.indexof y "er" 0) 20))
(assert (or (= (str.at z 17) "t") (= "=aler" (str.substr y 93 5)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-999999999999]*$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9\s]+"))))
(assert (or (not (str.prefixof "<tbod" y)) (not (>= (str.len x) 45)) (not (= (str.indexof z "ent1""" 0) 26))))
(assert (or (not (= "nfocusalert(1)rt()>" (str.replace z "=ale" "alert(1)"))) (not (str.suffixof "tle>" z)) (str.contains x "tioncanc")))
