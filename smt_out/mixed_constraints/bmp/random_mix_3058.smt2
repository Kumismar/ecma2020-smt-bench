; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """/><img/onerror=\x22javascript:alert(1)\x22src=xxx:x />") (= x "<thead onkeydown=""alert(1)"" contenteditable>test</thead>")))
(assert (or (= z "><script>\x0Bjavascript:alert(1)</script>") (= z "rt(1)"">test</dir>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,5}$"))))
(assert (or (str.contains (str.replace y "n" "<b>") "o<b>keyd") (str.prefixof "<heade" y) (not (str.prefixof "rt(1)"">" z))))
(assert (not (= (str.at z 28) "t")))
(assert (or (not (<= (str.len x) 41)) (str.in_re x ((_ re.from_regex ecma2020) "^[^_./<>]{1,}$")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_.-]*$")))))
(assert (or (not (= "/><img/one" (str.substr x 1 10))) (>= (str.len y) 95)))
(assert (or (= (str.at z 0) "}") (not (str.suffixof "c=xxx:x />" x))))
(assert (= (str.indexof z "est" 0) 8))
(assert (not (= (str.at x 24) "s")))
(check-sat)
