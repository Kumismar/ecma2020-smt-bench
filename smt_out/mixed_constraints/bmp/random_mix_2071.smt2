; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption id=x tabindex=1 onfocus=alert(1)></caption>") (= x "<a id=x tabindex=1 onfocusin=alert(1)></a>")))
(assert (or (= z ">") (= z "tenteditable>test</thead>") (= z "seover=""alert(1)"">test</nav>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*[0-9])[- +()0-9]+$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{5,14}$")))))
(assert (or (= "<a id=x tabindex  onfocusin=alert(1)></a>>" (str.replace y "=1" " ")) (= "av>" (str.substr z 25 6)) (not (= (str.indexof x "ue"" " 0) 19))))
(assert (or (str.contains y "dex=1 onfo") (not (= (str.at x 41) ">"))))
(assert (str.contains z ">"))
(check-sat)
