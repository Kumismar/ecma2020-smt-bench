; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html oncut=""alert(1)"" contenteditable>test</html>") (= x "<style>@keyframes x{}</style><noscript style=""animation-name:x"" onanimationstart=""alert(1)""></noscript>") (= x "<isindex type=image src=1 onerror=alert(1)>")))
(assert (or (= z "ation: '+document.location+' Host Page Cookies: '+document.cookie);//<br/><hr/>") (= z "ntextmenu=""alert(1)"">test</d\u{1f4a9}el>") (= z "r id=x tabindex=1 onfocusin=alert(1)></meter>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len z) 32) (str.prefixof "<is" y)))
(assert (or (= (str.indexof x "es" 0) 15) (str.suffixof "er>" z)))
(assert (or (str.prefixof "<styl" y) (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9]+[0-9]*$")))))
(assert (= (str.at y 68) "l"))
(assert (or (not (str.suffixof "<hr/>" y)) (not (str.in_re z ((_ re.from_regex ecma2020) "\d{5}-?\d{3}"))) (= (str.at x 27) "e")))
(assert (not (= "bind" (str.substr z 12 4))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-9A-HJ-NPQRTUWXY]{2}\d{6}[0-9A-HJ-NPQRTUWXY]{10}|[1-9]\d{14})$"))))
(assert (or (not (= (str.at x 19) "1")) (str.suffixof "/html>" x) (str.prefixof "<html onc" y)))
(check-sat)
