; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option id=x tabindex=1 onbeforeactivate=alert(1)></option>") (= x "<sup id=x tabindex=1 onbeforedeactivate=alert(1)></sup><input autofocus>") (= x "<ul onmouseover=""al\u{1d400}ert(1)"">test<\u{20000}/ul>")))
(assert (or (= z "><![endif]-->") (= z "le><del id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></del>") (= z " style=""animation-name:x"" onanimationend=""alert(1)""></thead>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len x) 38)) (not (str.contains (str.replace z "ss" "alert(1)") "rogrealert(1)>"))))
(assert (or (not (str.prefixof "<! foo=" y)) (str.contains y "ivate")))
(assert (or (<= (str.len y) 89) (not (= (str.at y 31) "e"))))
(assert (or (not (= (str.indexof x "eta" 0) 2)) (str.prefixof " c" z)))
(assert (= "!" (str.substr z 2 1)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Z]{1}[a-z]{5,}[0-9]{1,}"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(\+33|0|0033)[12345679][1-9]\d{7}$"))))
(check-sat)
