; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i draggable=""true"" ondragstart=""alert(1)"">test</i>") (= x "<samp onkeypress=""alert(1)"" contenteditable>test</samp>")))
(assert (or (= z "all onload=alert(1)></small>") (= z "table>test</rtc>") (= z "javas\x03cript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "</a>" z)) (str.suffixof "t</a>" z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[$@$^!%*?#&()-=_+])[A-Za-z\d$@$^!%*?#&()-=_+]{8,}"))))
(assert (or (not (= (str.len x) 53)) (= "t</samp>" (str.substr x 47 10)) (= "all onxd=alert(1)></small>" (str.replace z "loa" "x"))))
(assert (or (<= (str.len y) 116) (not (str.contains x "t(1) ")) (= "rag" (str.substr y 23 3))))
(assert (or (= "/s" (str.substr x 49 2)) (not (str.suffixof "st</a>" y))))
(assert (or (not (str.prefixof "<samp onk" y)) (not (= (str.indexof z "></sm" 0) 19)) (not (str.contains z "/sma"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^3$"))))
(check-sat)
