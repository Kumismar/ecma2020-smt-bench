; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr onkeydown=""alert(1)"" contenteditable>test</hr>") (= x "<colgroup id=x tabindex=1 ondeactivate=alert(1)></colgroup><input id=y autofocus>") (= x "<iframe onload iframe onload=""javascript:javascript:alert(1)""></iframe onload>")))
(assert (or (= z ">") (= z "le>test</frameset>") (= z " ondragleave=""alert(1)"">test</slot>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[0]{1}[0-9]{2,3}"))))
(assert (or (not (str.prefixof "s" z)) (= (str.len x) 50) (= (str.len y) 113)))
(assert (str.suffixof ">" z))
(assert (not (str.prefixof " ondrag" z)))
(assert (or (= (str.at x 62) "<") (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@(?!gmail.com)(?!yahoo.com)(?!hotmail.com)(?!hotmail.co.il)(?!walla.co.il)(?!mail.ru)(?!outlook.com)(?!email.com)(?!icloud.com)(?!me.com)[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$")))))
(check-sat)
