; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb id=x tabindex=1 onfocusin=alert(1)></rb>") (= x "<param draggable=""true"" ondragstart=""alert(1)"">test</param>")))
(assert (or (= z "put id=y autofocus>") (= z ":alert(1)"">X") (= z "est</object>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "></r" (str.substr y 38 4))) (not (str.prefixof "<rb" y)) (= "t</p" (str.substr y 50 4))))
(assert (or (not (str.contains z ":alert(1)""")) (not (str.prefixof "/" z)) (not (str.prefixof "<r" x))))
(assert (or (not (str.suffixof "r>" z)) (not (>= (str.len y) 78)) (= "in=alert" (str.substr y 27 8))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^(\d{10})$")))
(check-sat)
