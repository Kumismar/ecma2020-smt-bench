; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onmouseenter=""alert(1)"">test</sup>") (= x "<ruby onpaste=""alert(1)"" contenteditable>test</ruby>") (= x "<nextid draggable=""true"" ondragend=""alert(1)"">test</nextid>")))
(assert (or (= z "e=click>") (= z "table>test</time>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "m" 0) 14) (not (= "<ruby onpajavascript:e=""alert(1)"" contenteditable>test</ruby>" (str.replace x "st" "javascript:")))))
(assert (or (not (= (str.at x 21) "e")) (not (str.prefixof "<ru" y))))
(assert (str.prefixof "<sup on" y))
(assert (= "st</ruby>" (str.substr y 43 9)))
(assert (or (not (>= (str.len y) 40)) (not (= "<nextid draggable=""true"" ondragend""ert(1)"">test</nextid>" (str.replace x "=""al" """"))) (not (= (str.len z) 17))))
(assert (not (= (str.indexof x "e""" 0) 22)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-\u{44f}|\s]*$"))))
(check-sat)
