; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del onmouseup=""alert(1)"">test</del>") (= x "<del oncontextmenu=""alert(1)"">test</d\u{1f4a9}el>") (= x "<style>@keyframes x{}</style><p style=""animation-name:x"" onanimationstart=""alert(1)""></p>")))
(assert (or (= z "et {color:red;}</style><fieldset id=x style=""transition:color 1s"" ontransitionend=alert(1)></fieldset>") (= z "pt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y ">t;p" "") "usg(""")) (= "mouseup" (str.substr x 7 7)) (= "x{}" (str.substr x 18 3))))
(assert (str.contains x "eente"))
(assert (or (= (str.indexof y "</sty" 0) 21) (str.suffixof "/p>pt>" y)))
(assert (or (<= (str.len x) 95) (str.in_re z ((_ re.from_regex ecma2020) "^[\u{5c}u4e00-\u{5c}u9fa5]+$")) (not (str.contains (str.replace y "yfra" """") ">@ke""me"))))
(assert (or (not (>= (str.len y) 35)) (str.in_re y ((_ re.from_regex ecma2020) "^[+][7] [(][\d]{3}[)] \d{3}-\d{2}-\d{2}$")) (str.in_re y ((_ re.from_regex ecma2020) "\d{8}-\d{1}-\d{2}"))))
(assert (not (= """ " (str.substr z 25 2))))
(check-sat)
