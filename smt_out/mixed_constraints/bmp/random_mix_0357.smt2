; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea onmouseup=""alert(1)"">test</textarea>") (= x "<center ondblclick=""alert(1)"">test</center>") (= x "<strong id=x tabindex=1 onfocus=alert(1)></strong>")))
(assert (or (= z ">test</slot>") (= z """alert(1)"">test</var>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "tes" 0) 30)) (not (str.contains y "xtarea o"))))
(assert (or (not (= (str.at x 20) "1")) (not (= "t(1)"">test" (str.substr y 25 10))) (not (str.prefixof """ale" z))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[a-z,A-Z,0-9,!,#,$,%,^,&,*,-,_,+]@[a-z,A-Z].com")) (not (= "al" (str.substr z 27 2))) (str.prefixof "<strong " y)))
(assert (= "cus=ale" (str.substr x 28 7)))
(assert (not (= (str.at y 58) ")")))
(assert (= (str.indexof x "cus=a" 0) 28))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[-\w.]+@{1}[-a-z0-9]+[.]{1}[a-z]{2,5}$"))))
(check-sat)
