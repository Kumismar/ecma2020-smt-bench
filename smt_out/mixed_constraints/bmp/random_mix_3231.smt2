; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd onmouseout=""alert(1)"">test</dd>") (= x "<span id=x tabindex=1 onbeforeactivate=alert(1)></span>")))
(assert (or (= z "olor 10s"" ontransitioncancel=alert(1)></article>") (= z "htt\u{9}p://6\u{9}6.000146.0x7.147/"">XSS</A>") (= z "YER>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^.{6,}$"))))
(assert (str.contains z "0x7.147"))
(assert (or (not (str.contains z "el=a")) (str.prefixof "<" x)))
(assert (or (>= (str.len z) 1) (= (str.indexof x "out" 0) 11) (not (= "1)"">test<" (str.substr x 22 9)))))
(assert (or (not (str.suffixof "ER>" z)) (not (= "<dd onmouseout=""ale"")"">test</dd>" (str.replace x "rt(1" """"))) (not (str.contains (str.replace y "b" "x") "x taxin"))))
(assert (or (= "tabinde" (str.substr x 11 7)) (str.contains y "7.147/""")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9!-/:-@\u{2260}\[-`{-~]+$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z]{1}[0-9]{5,6}"))) (= "ivate=aler" (str.substr x 33 10))))
(check-sat)
