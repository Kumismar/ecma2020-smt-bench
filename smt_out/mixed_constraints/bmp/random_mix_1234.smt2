; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist draggable=""true"" ondragenter=""alert(1)"">test</datalist>") (= x "<q id=x tabindex=1 onfocus=alert(1)></q>")))
(assert (or (= z "deactivate=alert(1)></xss><input autofocus>") (= z "est</details>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/ol>" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?:(?:\+|00)33|0)\s*[1-9](?:[\s.-]*\d{2}){4}$")))))
(assert (or (= (str.at z 28) "n") (= (str.at y 60) "l") (not (>= (str.len z) 13))))
(assert (or (not (str.contains (str.replace x ";" """") "<""A H")) (str.contains (str.replace y "is" "x") "atalxt") (not (= (str.indexof x " dr" 0) 9))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "([0-9]).*$"))) (not (= (str.at z 0) "e"))))
(check-sat)
