; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen onkeydown=""alert(1)"" contenteditable>test</keygen>") (= x "<SCRIPT FOR\u{20000}=document EVENT=onreadystatechange>javascript:alert(1)</SCRIPT>")))
(assert (or (= z "e>test</table>") (= z "c=xx:x onerror=alert(108)></a>"">") (= z "de oncopy=""alert(1)"" contenteditable>test</code>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len x) 72)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[9-9]{1}[0-9]{8}")) (str.prefixof "<SCRIP" y)))
(assert (or (str.prefixof "<key" y) (not (str.suffixof "T>" x))))
(assert (= (str.indexof y "rt(1" 0) 22))
(assert (or (not (str.contains z "st</ta")) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*[A-Za-z])[A-Za-z\s\.]*"))) (str.in_re y ((_ re.from_regex ecma2020) "^[a-z A-Z 0-9 \- ' / . &]{2,80}$"))))
(assert (str.contains z " 2s"" o"))
(assert (not (= (str.indexof y "nge>j" 0) 43)))
(assert (= (str.at y 54) "i"))
(assert (or (= "e>test</ta<b>" (str.replace z "ble>" "<b>")) (str.contains y "entedi") (str.suffixof "e>" y)))
(check-sat)
