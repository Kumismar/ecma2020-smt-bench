; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem onmouseup=""alert(1)"">test</menuitem>") (= x "<style>@keyframes x{}</style><rt style=""animation-name:x"" onanimationstart=""alert(1)""></rt>")))
(assert (or (= z ">test</slot>") (= z "><input id=y autofocus>") (= z "</cite>")))
(assert (= y (str.++ x z)))
(assert (= "<<b> draggable=""true"" contenteditable>drag me</div><time ondrop=alert(1) contenteditable>drop here</time>oup>" (str.replace y "div" "<b>")))
(assert (or (not (= "><alert(1) id=y autofocus>" (str.replace z "input" "alert(1)"))) (str.contains z "id=y") (not (str.suffixof "ark>" z))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\\s\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\\s]+$"))) (not (str.contains y "me:x"" ona")) (= (str.at z 0) ">")))
(assert (or (= (str.at z 2) "c") (= "t=""alert" (str.substr y 73 8)) (not (str.suffixof "(1)""></rt>" x))))
(check-sat)
