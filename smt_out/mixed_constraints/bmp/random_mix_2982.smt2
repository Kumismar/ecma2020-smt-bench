; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><canvas id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></canvas>") (= x "<div draggable=""true"" contenteditable>drag me</div><em ondrop=alert(1) contenteditable>drop here</em>")))
(assert (or (= z "ue"" ondragenter=""alert(1)"">test</address>") (= z "ondrag=""alert(1)"">test</kbd>") (= z "d;location&rpar;>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "r" "x") "\u{10348}x>")) (str.prefixof "d;" z) (str.in_re y ((_ re.from_regex ecma2020) "^([0-9]{8,12})+$"))))
(assert (str.prefixof "<styl" x))
(assert (or (= "t(1)""" (str.substr y 136 5)) (str.contains x "id=x ")))
(assert (or (str.contains x "=""true""") (str.contains z "te") (not (str.in_re y ((_ re.from_regex ecma2020) "^[0 ]{1}[0-9 ]{6,15}")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([^0-9]*)$"))) (not (= (str.at x 95) "e"))))
(check-sat)
