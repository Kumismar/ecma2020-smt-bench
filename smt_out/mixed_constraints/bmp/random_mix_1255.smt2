; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<small onmousemove=""alert(1)"">test</small>") (= x "<style>:target {color: red;}</style><del id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></del>")))
(assert (or (= z " onmousemove=""alert(1)"">test</source>") (= z "></p>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len x) 109)) (not (= (str.at x 46) "i")) (not (str.suffixof "rce>" z))))
(assert (or (not (str.suffixof "p>" y)) (not (str.prefixof "<style>" x))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$"))))
(assert (= (str.at x 38) "a"))
(assert (or (>= (str.len z) 34) (not (str.contains z "alert")) (str.contains y "move=""aler")))
(assert (str.suffixof "st</small>" x))
(assert (or (= ">" (str.substr z 0 1)) (not (<= (str.len y) 148))))
(check-sat)
