; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area id=x tabindex=1 onbeforedeactivate=alert(1)></area><input autofocus>") (= x "<body onUnload body onUnload=""javascript:javascript:alert(1)""></body onUnload>") (= x "<h1 id=x tabindex=1 onfocus=alert(1)></h1>")))
(assert (or (= z "cusout=alert(1) tabindex=1 id=x></dfn><input autofocus>") (= z "ndards mode -->")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 23) "o")))
(assert (or (not (str.contains (str.replace x "at" "<b>") "iv<b>e=al")) (>= (str.len z) 15) (not (str.in_re x ((_ re.from_regex ecma2020) "|^[a-zA-Z \u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{fc}\u{e7}]*$|")))))
(assert (or (str.suffixof "cus>" y) (not (str.in_re z ((_ re.from_regex ecma2020) "^([0-9]){10,}$"))) (= (str.indexof y "ofo" 0) 67)))
(assert (str.contains y "rt(S"))
(assert (or (not (str.contains (str.replace x "nput" " ") "<i  aut")) (str.contains x "ert(1)"" ")))
(assert (or (not (str.suffixof "nt>" y)) (not (= (str.at y 81) "r"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{2}[0-9]{4,6}[0-9]{3,4}$")) (= "<h1 alert(1) tabindex=1 onfocus=alert(1)></h1>" (str.replace x "id=x" "alert(1)"))))
(check-sat)
