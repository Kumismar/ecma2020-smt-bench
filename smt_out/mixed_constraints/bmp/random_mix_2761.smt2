; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figcaption onbeforecut=""alert(1)"" contenteditable>test</figcaption>") (= x "<nav onmousedown=""alert(1)"">test</nav>") (= x "<script>+-+-1-+-+alert(1)</script>")))
(assert (or (= z "sition:transform 2s"" ontransitionrun=alert(1)></mark>") (= z "p ondblclick=""alert(1)"">test</samp>")))
(assert (= y (str.++ x z)))
(assert (= "t>+-+-" (str.substr x 6 6)))
(assert (or (str.contains (str.replace x "edita" "alert(1)") "tentalert(1)bl") (str.contains z "1)></ma") (>= (str.len x) 27)))
(assert (= (str.at z 29) "t"))
(assert (not (= "=alert(1)>" (str.substr y 74 10))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([^\x00-\x20\x22\x28\x29\x2c\x2e\x3a-\x3c\x3e\x40\x5b-\x5d\x7f-\xff]+|\x22([^\x0d\x22\x5c\x80-\xff]|\x5c[\x00-\x7f])*\x22)(\x2e([^\x00-\x20\x22\x28\x29\x2c\x2e\x3a-\x3c\x3e\x40\x5b-\x5d\x7f-\xff]+|\x22([^\x0d\x22\x5c\x80-\xff]|\x5c[\x00-\x7f])*\x22))*\x40([^\x00-\x20\x22\x28\x29\x2c\x2e\x3a-\x3c\x3e\x40\x5b-\x5d\x7f-\xff]+|\x5b([^\x0d\x5b-\x5d\x80-\xff]|\x5c[\x00-\x7f])*\x5d)(\x2e([^\x00-\x20\x22\x28\x29\x2c\x2e\x3a-\x3c\x3e\x40\x5b-\x5d\x7f-\xff]+|\x5b([^\x0d\x5b-\x5d\x80-\xff]|\x5c[\x00-\x7f])*\x5d))*$"))))
(assert (not (= "<mainjavascript:id=x tabindex=1 onbeforedeactivate=alert(1)></main><input autofocus>" (str.replace x " " "javascript:"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^CS\d{3,7}|AI\d{3,7}$"))))
(check-sat)
