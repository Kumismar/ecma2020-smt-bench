; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<td onkeyup=""alert(1)"" contenteditable>test</td>") (= x "<object oncut=""alert(1)"" contenteditable>test</object>")))
(assert (or (= z "style=""width:400px;height:180px""></iframe>") (= z "ontenteditable>test</dd>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[?!,.\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}0-9\s]+$"))))
(assert (or (not (>= (str.len y) 69)) (not (= (str.at x 46) "/")) (str.suffixof "/iframe>" y)))
(assert (or (str.suffixof "frame>" z) (str.suffixof "iframe>" y) (>= (str.len x) 54)))
(assert (or (not (= "<object oncut=""alert(1)"" contentedi e>test</object>ontenteditable>test</dd>" (str.replace y "tabl" " "))) (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{4}-\d{2}$")))))
(assert (or (not (= (str.at x 7) " ")) (not (str.prefixof "<td onkeyu" x)) (not (<= (str.len y) 97))))
(check-sat)
