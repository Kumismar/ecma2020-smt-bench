; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blink onfocusout=alert(1) tabindex=1 id=x></blink><input autofocus>") (= x "<var oncopy=""alert(1)"" contenteditable>test</var>")))
(assert (or (= z "test</menu>") (= z "tabindex=1 onfocusin=alert(1)></details>") (= z " onsubmit=""alert(String.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x ")" 0) 20))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "d{0,1}e{0,1}[ ]{0,1}[A-Z\u{c4}\u{d6}\u{dc}]{1}[a-z\u{e4}\u{f6}\u{fc}\u{df}-]{1,35}[ ]{0,1}d{0,1}e{0,1}[ ]{0,1}[-A-Z\u{c4}\u{d6}\u{dc}]{0,1}[a-z\u{e4}\u{f6}\u{fc}\u{df}-]{0,35}[ ]{0,5}")) (str.prefixof "<b" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@(?!(me|gmail|protonmail|aol|outlook|live|prodigy|yahoo|mail|icloud|msn|wanadoo|yandex|zohomail|tutanota|tutamail|tuta|keepmail|hotmail|)\.)[a-z0-9.-]+\.[a-z.]{2,}$"))) (str.contains z "rames")))
(assert (or (str.prefixof "tabin" z) (not (= (str.len z) 40))))
(assert (str.suffixof "se>" y))
(assert (not (= (str.indexof y "o" 0) 7)))
(check-sat)
