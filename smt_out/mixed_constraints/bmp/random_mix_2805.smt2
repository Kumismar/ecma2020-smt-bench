; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=`xx:xx`onerror=alert(1)>") (= x "<frame id=x tabindex=1 ondeactivate=alert(1)></frame><input id=y autofocus>")))
(assert (or (= z "CRIPT+AD4-") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<" x)) (= (str.at x 68) "o")))
(assert (not (= (str.indexof y "img s" 0) 1)))
(assert (or (not (str.contains (str.replace y "t" "x") "id=x xab")) (= (str.at z 5) "+") (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9A-Za-z-]+$")))))
(assert (or (not (= "CRIPT""-" (str.replace z "+AD4" """"))) (str.suffixof "D4-" z) (= (str.at z 7) "D")))
(assert (str.prefixof "<kbd dr" y))
(assert (or (str.suffixof ">" z) (str.prefixof "c" z) (not (str.contains (str.replace y "ro" "javascript:") "nerjavascript:r=a"))))
(check-sat)
