; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onmouseup=""alert(1)"">test</input>") (= x "<wbr onmousemove=""alert(1)"">test</wbr>") (= x "<applet draggable=""true"" ondragend=""alert(1)"">test</applet>")))
(assert (or (= z "alert(1)"" contenteditable>test</bdo>") (= z ")</script>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "le=""" 0) 15) (str.prefixof "<l" y) (str.contains (str.replace z "ript>" """") "sc""")))
(assert (or (not (= (str.at x 4) "l")) (not (str.contains (str.replace y "let>)" "") "app</")) (not (= (str.indexof y " onmo" 0) 6))))
(assert (or (not (= (str.indexof z "ript" 0) 9)) (str.suffixof "pt>" z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Z]{1}[AEIOU]{1}[A-Z]{2}[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|1[0-9]|2[0-9]|3[0-1])[HM]{1}(AS|BC|BS|CC|CS|CH|CL|CM|DF|DG|GT|GR|HG|JC|MC|MN|MS|NT|NL|OC|PL|QT|QR|SP|SL|SR|TC|TS|TL|VZ|YN|ZS|NE)[B-DF-HJ-NP-TV-Z]{3}[0-9A-Z]{1}[0-9]{1}$"))))
(check-sat)
