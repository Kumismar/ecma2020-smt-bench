; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title id=x tabindex=1 ondeactivate=alert(1)></title><input id=y autofocus>") (= x "<style>:target {transform: rotate(180deg);}</sty\u{10348}le><noscript id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></noscript>")))
(assert (or (= z "table>test</head>") (= z "r=alert(1) tabindex=1 id=x></basefont><input a\u{1d400}utofocus>") (= z "s""></SCRIPT>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "tes")))
(assert (or (not (= (str.at z 6) "r")) (str.contains (str.replace y "ty\u{10348}l" "") ";}</se") (>= (str.len y) 152)))
(assert (or (not (<= (str.len z) 22)) (not (str.contains z "ead>")) (not (str.contains x "d=x tabind"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z\u{c0}-\u{fa}0-9 ]{5,}"))))
(assert (or (not (= "trans" (str.substr x 101 5))) (str.prefixof "<style>:t" y) (str.contains (str.replace z "ofo" " ") "a\u{1d400}ut c")))
(check-sat)
