; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onseeked=""alert(String.fromCharCode(88,83,83))"">") (= x "<menu i\u{10348}d=x contextmenu=x onshow=alert(1)>right click me!") (= x "<sub onbeforecut=""alert(1)"" contenteditable>test</sub>")))
(assert (or (= z "activate=alert(1)></base>") (= z "ondblclick=""alert(1)"">test</font>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<IM" x)) (not (= "rea>lert" (str.substr y 48 8))) (not (= (str.at y 87) ">"))))
(assert (or (not (str.contains x " con")) (>= (str.len y) 89) (<= (str.len y) 73)))
(assert (or (= """" (str.substr z 11 1)) (= (str.at y 68) "e") (= (str.at x 5) " ")))
(assert (str.prefixof "<objec" x))
(assert (or (not (str.suffixof "</var>" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "^.*[,].*$"))) (str.contains z "=alert(1)>")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[+]*[0-9]{1,4}[0-9]{11}$"))) (not (= (str.len z) 33))))
(check-sat)
