; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script oncontextmenu=""alert(1)"">test</script>") (= x "<picture onbeforecopy=""alert(1)"" contenteditable>test</picture>")))
(assert (or (= z "onbeforeactivate=alert(1)></colgroup>") (= z "ntenteditable>test</time>") (= z "e"" ondragstart=""alert(1)"">test</p>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 29) "1"))
(assert (or (= "<script oncontextmenu=""alert(1)"">t</script>" (str.replace x "tes" "")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}\s]+$")))))
(assert (or (= "onbeforeactivatlert(1)></colgroup>" (str.replace z "e=a" "")) (not (str.suffixof "</picture>" x))))
(assert (or (not (= (str.indexof z "nbef" 0) 1)) (= "script>" (str.substr x 39 7))))
(assert (or (str.prefixof "<pict" y) (not (str.prefixof "<pi" x))))
(assert (or (= (str.indexof y "rip" 0) 37) (= (str.indexof x "bel" 0) 3)))
(check-sat)
