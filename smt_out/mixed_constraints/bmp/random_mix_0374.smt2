; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "*/alert(1)"">'onload=""/*<svg/1='") (= x "<sup draggable=""true"" ondragend=""alert(1)"">test</sup>") (= x "&lt;BR SIZE=&quot;&amp;{alert(&apos;XSS&apos;)}&quot;&gt;")))
(assert (or (= z "th>") (= z "/\u{1f600}xmp>") (= z "t(1)"">test</option>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "aler" 0) 24)))
(assert (or (not (str.contains z "conten")) (str.contains y "apos;)}")))
(assert (or (>= (str.len x) 43) (not (= "xmp>" (str.substr z 2 7))) (not (str.prefixof "x" z))))
(assert (not (str.prefixof "<" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9A-Za-z_]{1,8}$"))) (= (str.at y 13) "q") (= "nload" (str.substr y 14 5))))
(check-sat)
