; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><plaintext id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></plaintext>") (= x "<SCRIPT a="">'>"" SRC=""http://ha.ckers.org/xss.js""></SCRIPT>") (= x "<IMG SRC=x oncut=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "lert(1)""></th>") (= z "</iframe>") (= z ":target {color:red;}</style><tfoot id=x style=""transition:color 1s"" ontransitionend=alert(1)></tfoot>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[1-9][\d]{0,}$")) (= "<style>:target {color: red;}</style><embed id=x style=""traon:color 10s"" ontransitioncancel=alert(1)></embed>" (str.replace x "nsiti" ""))))
(assert (or (= (str.indexof x "on" 0) 67) (not (= (str.at z 5) "1"))))
(assert (or (= "<IMG SRx oncut=""alert(String.fromCharCode(88,83,83))"">" (str.replace x "C=x" "x")) (str.contains x "://ha") (not (str.prefixof "<style" x))))
(assert (or (not (= (str.at y 11) "o")) (str.prefixof "<styl" y) (>= (str.len z) 43)))
(check-sat)
