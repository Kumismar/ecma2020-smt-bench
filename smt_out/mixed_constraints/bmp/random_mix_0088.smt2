; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script ondblclick=""alert(1)"">test</script>") (= x "<small onmouseenter=""alert(1)"">test</small>") (= x "<style>@keyframes x{}</style><li style=""animation-name:x"" onanimationend=""alert(1)""></li>")))
(assert (or (= z "est</hgroup>") (= z "ve=""alert(1)"">test</ins>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(?!s).*$"))))
(assert (or (not (= (str.at x 32) "v")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]{3} ?(?!sa|sd|ss)[a-zA-Z]{2}$"))) (= "e:x""" (str.substr y 53 4))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z\u{c0}\u{c1}\u{c2}\u{c3}\u{c4}\u{c5}\u{c6}\u{c7}\u{c8}\u{c9}\u{ca}\u{cb}\u{cc}\u{cd}\u{ce}\u{cf}\u{d0}\u{d1}\u{d2}\u{d3}\u{d4}\u{d5}\u{d6}\u{d8}\u{d9}\u{da}\u{db}\u{dc}\u{dd}\u{de}\u{df}\u{e0}\u{e1}\u{e2}\u{e3}\u{e4}\u{e5}\u{e6}\u{e7}\u{e8}\u{e9}\u{ea}\u{eb}\u{ec}\u{ed}\u{ee}\u{ef}\u{f0}\u{f1}\u{f2}\u{f3}\u{f4}\u{f5}\u{f6}\u{f8}\u{f9}\u{fa}\u{fb}\u{fc}\u{fd}\u{fe}\u{ff} \t\r\n\f0-9-,./#&]*$")))
(assert (or (<= (str.len z) 18) (not (= (str.len z) 24))))
(assert (or (not (= (str.at y 26) "(")) (= "<style>@keyframes x{}</style><li style=""anima name:x"" onanimationend=""alert(1)""></li>est</hgroup>" (str.replace y "tion-" " ")) (not (= "<script ondbl<b>ick=""alert(1)"">test</script>" (str.replace x "cl" "<b>")))))
(assert (or (not (= "innerHT" (str.substr y 144 7))) (str.contains z """>tes")))
(check-sat)
