; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script /***/>/***/confirm('\u{5c}uFF41\u{5c}uFF4C\u{5c}uFF45\u{5c}uFF52\u{5c}uFF54\u{5c}u1455\u{5c}uFF11\u{5c}u1450')/***/</script /***/") (= x "<script draggab\u{1d400}le=""true"" ondrag=""alert(1)"">te\u{10348}st</script>") (= x "<input name=""secret"" type=""password"">")))
(assert (or (= z "contenteditable>test</strike>") (= z "ter>")))
(assert (= y (str.++ x z)))
(assert (or (not (= """script draggab\u{1d400}le=""true"" ondrag=""alert(1)"">te\u{10348}st</script>" (str.replace x "<" """"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[^@]+@[^@]+\.[^@]+$"))) (not (str.prefixof "<" x))))
(assert (or (not (= (str.at x 34) "d")) (= "fir" (str.substr y 22 3)) (not (str.in_re x ((_ re.from_regex ecma2020) "^([ \u{5c}u00c0-\u{5c}u01ffa-zA-Z0-9\-.'&]){2,128}$")))))
(assert (not (str.contains y ">/***/co")))
(assert (or (= (str.indexof y "ord""" 0) 32) (not (<= (str.len y) 108))))
(assert (<= (str.len x) 61))
(assert (or (= (str.at z 0) "t") (= "<input name=""sec""et"" type=""password"">" (str.replace x "r" """")) (>= (str.len z) 52)))
(assert (= (str.at y 24) "r"))
(check-sat)
