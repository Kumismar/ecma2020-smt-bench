; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section onmouseover=""alert(1)"">test</section>") (= x "<keygen onmouseover=""alert(1)"">test</keygen>") (= x "<aside ondblclick=""alert(1)"">test</aside>")))
(assert (or (= z "list id=x tabindex=1 onbeforedeactivate=alert(1)></datalist><input autofocus>") (= z "alert(1)"">test</video>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "=" 0) 19)) (str.contains (str.replace z ">" "<b>") "<b>")))
(assert (not (str.contains x " onmouseo")))
(assert (or (str.contains (str.replace x "</sec" "alert(1)") ">testalert(1)tion") (= (str.at y 75) "a")))
(assert (or (= (str.indexof z "vid" 0) 16) (str.in_re z ((_ re.from_regex ecma2020) "([0-9]{3}([-][0-9]{3}) ([-][0-9]{3}) ([-][0-9]{1})$)")) (not (str.contains (str.replace z "fo" "x") "exred"))))
(assert (not (= (str.at x 20) "e")))
(assert (or (not (str.prefixof "<sect" x)) (not (= (str.indexof z "er" 0) 42)) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z\u{e9}\u{e1}\u{171}\u{fa}\u{151}\u{f3}\u{fc}\u{f6}\u{ed}\u{c9}\u{c1}\u{170}\u{da}\u{150}\u{d3}\u{dc}\u{cd}_ ]{2,}")))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z ]+$")))
(check-sat)
