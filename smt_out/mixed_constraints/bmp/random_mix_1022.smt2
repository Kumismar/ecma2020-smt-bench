; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=&#0000106&#0000097&#0000118&#0000097&#0000115&#0000099&#0000114&#0000105&#0000112&#0000116&#0000058&#0000097&") (= x "<form draggable=""true"" ondragstart=""aler\u{10348}t(1)"">test</form>")))
(assert (or (= z """alert(1)"">test</xmp>") (= z "tenteditable>test</blink>")))
(assert (= y (str.++ x z)))
(assert (or (= "test</form" (str.substr x 47 10)) (not (str.contains y "r\u{10348}t"))))
(assert (not (str.contains z "</xmp>")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(([X-Z]{1})(\d{7})([A-Z]{1}))|((\d{8})([A-Z]{1}))|(([A-Z]{1})(\d{8}))$"))) (= (str.at z 19) "b")))
(assert (or (= "/form>" (str.substr y 52 6)) (not (= (str.at z 18) "/"))))
(assert (or (not (= (str.indexof x "t" 0) 2)) (str.prefixof "(1)"">tes" z) (= "tenteditable>tesalert(1)link>" (str.replace z "t</b" "alert(1)"))))
(assert (or (not (= "<IMG SRC=&# 00106&#0000097&#0000118&#0000097&#0000115&#0000099&#0000114&#0000105&#0000112&#0000116&#0000058&#0000097&" (str.replace x "00" " "))) (not (str.contains y "form>""a"))))
(assert (not (= (str.at z 8) "a")))
(check-sat)
