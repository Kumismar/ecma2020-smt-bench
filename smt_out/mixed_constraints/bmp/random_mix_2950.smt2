; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb oncopy=""alert(1)"" contenteditable>test</rb>") (= x "<xss id=x tabindex=1 ondeactivate=alert(1)></xss><input autofocus>") (= x "<link onkeyup=""alert(1)"" contenteditable>test</link>")))
(assert (or (= z "oad=alert(2)//'></div>") (= z "(1)"">test</meter>") (= z "e=""alert(1)\u{20000}"">test</td>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "rb") (= (str.indexof x "abind" 0) 11) (= (str.at x 50) "<")))
(assert (or (str.contains (str.replace y "bl" """") "ga""e=") (not (str.in_re z ((_ re.from_regex ecma2020) "^(3)$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^\d+$"))))
(assert (or (str.prefixof "(1)""" z) (not (= (str.indexof y "ut" 0) 53)) (not (str.prefixof "<rb oncopy" y))))
(assert (or (not (str.suffixof "</td>" y)) (not (= (str.at z 15) "r")) (= (str.at x 17) "(")))
(check-sat)
