; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script oncontextmenu=""alert(1)"">test</script>") (= x "<svg><picture onload=alert(1)></picture>")))
(assert (or (= z "T>document.vulnerable=true;</SCRIPT><![endif]-->") (= z "1) tabindex=1 id=x></area><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "rue;" 0) 23)) (= (str.at z 2) " ") (str.prefixof "1) " z)))
(assert (or (not (str.suffixof "</script>" x)) (not (= (str.at y 37) "<"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]+(\s+[a-zA-Z]+)*$"))) (not (str.prefixof "<sv" y)) (not (= ">" (str.substr z 36 10)))))
(assert (not (str.prefixof "<script" y)))
(check-sat)
