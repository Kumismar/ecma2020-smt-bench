; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed draggable=""true"" ondrag=""alert(1)"">test</embed>") (= x "<html onMouseEnter html onMouseEnter=""javascript:parent.javascript:alert(1)""></html onMouseEnter>")))
(assert (or (= z "javascript:document.location=&apos;http://www.google.com/&apos;&quot;&gt;XSS&lt;/A&gt;") (= z "tabindex=1 onbeforedeactivate=alert(1)></abbr><input autofocus>") (= z "ression(document.vulnerable=true);"">")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len z) 86) (str.prefixof "ress" z)))
(assert (or (not (str.prefixof "<h" x)) (str.contains x "ml onMouse")))
(assert (or (= "`""'><img src=xxx:x \x0C nerror=javascript:alert(1)>" (str.replace x "o" " ")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[6789]\d{8}$"))) (= (str.at z 0) "t")))
(assert (or (= (str.indexof z "true)" 0) 28) (= "ression(document.vuxnerable=true);"">" (str.replace z "l" "x"))))
(check-sat)
