; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option id=x tabindex=1 ondeactivate=alert(1)></option><input id=y autofocus>") (= x "//|\\ <script //|\\ src='https://dl.dropbox.com/u/13018058/js.js'> //|\\ </script //|\\") (= x "<bdo onbeforecopy=""alert(1)"" contenteditable>test</bdo>")))
(assert (or (= z "as=""html"" datasrc=""#X""></div>") (= z ") tabindex=1 id=x></dd><input autofocus>") (= z "extmenu=""alert(1)"">test</audio>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "o onbefor"))
(assert (or (str.contains (str.replace y "://" "javascript:") "psjavascript:dl") (not (str.in_re z ((_ re.from_regex ecma2020) "^(?:(?:\+?1\s*(?:[.-]\s*)?)?(?:(\s*\(?([2-9]1[02-9]|[2-9][02-8]1|[2-9][02-8][02-9])\)?\s*)|([2-9]1[02-9]|[2-9][02-8]1|[2-9][02-8][02-9]))\s*(?:[.-]\s*)?)([2-9]1[02-9]|[2-9][02-9]1|[2-9][02-9]{2})\s*(?:[.-]\s*)?([0-9]{4})$"))) (= "<kbd id=x tabindex=1 onbeforeactiv""alert(1)></kbd>" (str.replace x "ate=" """"))))
(assert (or (not (<= (str.len z) 16)) (not (str.prefixof "//|\\ <scr" x))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{435}\u{401}a-zA-Z]+$"))))
(assert (or (= "<bdo obeforecopy=""alert(1)"" contenteditable>test</bdo>extmenu=""alert(1)"">test</audio>" (str.replace y "n" "")) (not (str.contains y "able>te")) (>= (str.len x) 73)))
(assert (or (not (str.prefixof "extmenu" z)) (str.in_re y ((_ re.from_regex ecma2020) "^([0-9\-\(\) ]*)$")) (= "do onbef" (str.substr x 2 8))))
(check-sat)
