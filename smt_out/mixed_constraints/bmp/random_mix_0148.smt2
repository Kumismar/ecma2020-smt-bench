; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><progress style=""anima\u{1d400}tion-name:x"" onanimationstart=""alert(1)""></progress>") (= x "<content onfocusout=alert(1) tabindex=1 id=x></content><input autofocus>") (= x "<mark onmouseout=""alert(1)"">test</mark>")))
(assert (or (= z "tenteditable>test</wbr>") (= z "ctivate=alert(1)></figure>")))
(assert (= y (str.++ x z)))
(assert (not (= "e" (str.substr x 29 1))))
(assert (or (not (<= (str.len x) 72)) (not (str.in_re z ((_ re.from_regex ecma2020) "[^0-9]{3,30}"))) (= (str.at x 14) "u")))
(assert (or (not (str.suffixof "st</wbr>" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?:\+?1\s*(?:[.-]\s*)?)?(?:\(\s*([2-9]1[02-9]|[2-9][02-8]1|[2-9][02-8][02-9])\s*\)|([2-9]1[02-9]|[2-9][02-8]1|[2-9][02-8][02-9]))\s*(?:[.-]\s*)?([2-9]1[02-9]|[2-9][02-9]1|[2-9][02-9]{2})\s*(?:[.-]\s*)?([0-9]{4})(?:\s*(?:#|x\.?|ext\.?|extension)\s*(\d+))?$"))) (= (str.indexof y "ct" 0) 39)))
(assert (or (not (= (str.indexof y "e" 0) 5)) (not (str.prefixof "tent" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9_ +-,.?]{3,}$")))))
(assert (or (str.prefixof "<st" x) (str.prefixof "<mark o" y)))
(assert (or (str.contains (str.replace z "le>te" """") "b""s") (= "re>" (str.substr z 23 4)) (not (str.contains y "id=x"))))
(check-sat)
