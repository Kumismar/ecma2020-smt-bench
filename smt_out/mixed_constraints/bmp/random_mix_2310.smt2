; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp draggable=""true"" ondragenter=""alert(1)"">test</xmp>") (= x "<style>@keyframes x{}</style><samp style=""animation-name:x"" onanimationend=""alert(1)""></samp>")))
(assert (or (= z "e=""alert(1)"">test</b>") (= z ")"" contenteditable>test</param>") (= z "x tabindex=1 ondeactivate=alert(1)></ol>\u{1f4a9}<input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z ">te" 0) 18)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{5d0}-\u{5ea}_-].{2,50}$"))) (not (= (str.at x 22) "/"))))
(assert (or (str.suffixof "t</param>" y) (not (= "e=""alert(1)"">talert(1)</b>" (str.replace z "est" "alert(1)")))))
(assert (or (= (str.at z 8) "d") (= (str.indexof y "1" 0) 41) (not (= "le>" (str.substr y 71 3)))))
(assert (or (not (str.suffixof "autofocus>" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(\+?1?( ?.?-?\(?\d{3}\)?) ?.?-?)?(\d{3})( ?.?-? ?\d{4})$")))))
(check-sat)
