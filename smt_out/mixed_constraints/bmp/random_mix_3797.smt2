; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><cite ondrop=alert(1) contenteditable>drop here</cite>") (= x "<nav onkeydown=""alert(1)"" contenteditable>test</nav>") (= x "<datalist onmousemove=""alert(1)"">test</datalist>")))
(assert (or (= z "nblur=alert(1) tabindex=1 id=x></template><input autofocus>") (= z "0003c;") (= z "oad=alert(41)></div>//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "</tfoot>" y))
(assert (not (= " dragga" (str.substr y 4 7))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z]{4,25}"))))
(assert (or (str.contains x " onmouse") (not (str.contains (str.replace y "EF\" "alert(1)") ">\xalert(1)xB")) (str.in_re x ((_ re.from_regex ecma2020) "^([\w-])+@([\w-])+(\.[\w-])+"))))
(assert (or (not (= "<div draggable=""true"" contenteditable>drag me</div><cite ondrop=alert(1javascript:contenteditable>drop here</cite>nblur=alert(1) tabindex=1 id=x></template><input autofocus>" (str.replace y ") " "javascript:"))) (str.contains x "alert(1")))
(assert (= (str.at z 3) "3"))
(check-sat)
