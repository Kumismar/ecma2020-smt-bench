(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html id=x tabindex=1 onfocusin=alert(1)></html>") (= x "<style>:target {color: red;}</style><shadow id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></shadow>") (= x "<object onmousemove=""alert(1)"">test</object>")))
(assert (or (= z "harCode(88,83,83))"">") (= z "here</ins>") (= z "tivate=alert(1)></frameset>")))
