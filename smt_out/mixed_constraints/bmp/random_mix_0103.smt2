; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th onfocusout=alert(1) tabindex=1 id=x></th><input autofocus>") (= x "<frame onmouseover=""alert(1)"">test</frame>")))
(assert (or (= z "test</track>") (= z "eypress=""alert(1)"" contenteditable>test</progress>") (= z " onload=alert(1)></footer>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^.{5,16}$"))) (str.contains z "st</tra")))
(assert (not (= (str.at y 31) "e")))
(assert (or (not (= (str.at x 21) "l")) (not (= (str.at z 46) "t"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9-+.\s()]*$"))) (<= (str.len x) 69)))
(assert (str.prefixof "eypre" z))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z- _\.]{1,25}$"))) (not (str.prefixof "tes" z)) (= (str.indexof z "ert(1" 0) 10)))
(check-sat)
