; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup onfocusout=alert(1) tabindex=1 id=x></optgroup><input au\u{10348}tofocus>") (= x "<style>:target {color: red;}</style><xmp id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></xmp>") (= x "<hr onmousemove=""alert(1)"">test</hr>")))
(assert (or (= z "nmousemove=""alert(1)"">test</article>") (= z "is!") (= z ")"">XXX</a>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "to" 0) 67) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z].+"))) (not (str.prefixof "<hr o" y))))
(assert (or (<= (str.len y) 67) (str.in_re z ((_ re.from_regex ecma2020) "^0(7|8|9)0\d{8}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[\u{3041}-\u{3093}\u{30fc}]*$"))))
(assert (or (= (str.indexof z "t(1)" 0) 24) (= "time onmo<b>semove=""alert(1)"">test</time>" (str.replace z "u" "<b>")) (= (str.indexof z ")"">te" 0) 19)))
(assert (not (str.suffixof ">is!" y)))
(check-sat)
