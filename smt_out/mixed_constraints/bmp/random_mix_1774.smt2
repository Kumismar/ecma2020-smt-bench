; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<wbr onmouseup=""alert(1)"">test</wbr>") (= x "<rt onbeforecut=""alert(1)"" contenteditable>test</rt>")))
(assert (or (= z "pacer draggable=""true"" ondragend=""alert(1)"">test</spacer>") (= z "T;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9]{5,}$"))) (= "r " (str.substr y 40 2)) (str.contains (str.replace z "T;" " ") " ")))
(assert (or (str.contains z " drag") (str.prefixof "<wbr o" y) (= "est</rt>" (str.substr x 44 8))))
(assert (or (= "entedita" (str.substr x 31 8)) (str.suffixof ";" z) (str.contains y "1) tabin")))
(assert (not (str.suffixof "BF" x)))
(assert (or (= (str.len z) 57) (not (= (str.indexof z "t" 0) 17)) (str.prefixof "ck=""alert(" z)))
(assert (not (str.prefixof "<rt onbef" x)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "[A-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$")))
(check-sat)
