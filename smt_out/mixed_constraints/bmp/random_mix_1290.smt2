; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q id=x tabindex=1 onbeforedeactivate=alert(1)></q><input autofocus>") (= x "<embed id=x tabindex=1 ondeactivate=alert(1)></embed><input id=y autofocus>") (= x "<em onblur=alert(1) tabindex=1 id=x></em><input autofocus>")))
(assert (or (= z "(1)"">test</template>") (= z "F=&quot;//www.google.com/&quot;&gt;XSS&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (= "(1)"">test</tem<b>>" (str.replace z "plate" "<b>")))
(assert (or (str.suffixof "utofocus>" x) (not (= "<embe d=x tabindex=1 ondeactivate=alert(1)></embed><input id=y autofocus>(1)"">test</template>" (str.replace y "d i" " "))) (not (= "/temp" (str.substr z 10 5)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[^@]+@[^@]+\.[a-zA-Z0-9]{2,6}"))) (= (str.at x 63) "o")))
(assert (or (str.contains (str.replace z "st</t" " ") """>te empl") (not (str.prefixof "<em onblu" x))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^13[0-9]{9}$|14[0-9]{9}|15[0-9]{9}[0-9]{9}[0-9]{9}$|18[0-9]{9}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{5}$"))))
(assert (str.contains x "</em><inp"))
(assert (or (not (str.contains x "/em><in")) (= (str.at x 11) "n")))
(assert (not (str.contains y ">(1)"">t")))
(check-sat)
