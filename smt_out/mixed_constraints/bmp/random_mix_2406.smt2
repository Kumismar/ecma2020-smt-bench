; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<button onmousedown=""alert(1)"">test</button>") (= x "<script src=//brutelogic.com.br/1.js>") (= x "<rp draggable=""true"" ondragstart=""alert(1)"">test</rp>")))
(assert (or (= z "t(1)"" contenteditable>test</span>") (= z "emove=""alert(1)"">test</tfoot>") (= z " ondragover=alert(1) contenteditable>drop here</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "ted" 0) 12)) (<= (str.len z) 60) (str.contains (str.replace z "1)""" "javascript:") "(javascript: c")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^Grac1as!$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[\x21-\x7E]{1,2}"))) (str.prefixof "</font>" y) (not (str.prefixof "<bu" x))))
(assert (str.prefixof "t(1)"" con" z))
(assert (not (= "nstart" (str.substr y 70 6))))
(check-sat)
