; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\xE3\x80\x80javascript:alert(1)</script>") (= x "<style>:target {color: red;}</style><br id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></br>")))
(assert (or (= z "n>") (= z " onmousemove=""alert(1)"">test</track>") (= z "le=""true"" ondragleave=""alert(1)"">test</body>")))
(assert (= y (str.++ x z)))
(assert (= "<style>:target {color: red;}</style><br id=x style=""transition:color 10s"" ontransition""l=alert(1)></br> onmousemove=""alert(1)"">test</track>" (str.replace y "cance" """")))
(assert (or (str.prefixof """" x) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*$")))))
(assert (>= (str.len y) 96))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{3}-\d{4}-\d{3}$"))) (= (str.indexof y "ition" 0) 57)))
(assert (not (= "<style>:target {color: red;}</style><br id=x style=""xsition:color 10s"" ontransitioncancel=alert(1)></br>" (str.replace x "tran" "x"))))
(assert (or (not (str.contains y "ra")) (>= (str.len x) 44)))
(assert (or (not (= "scri" (str.substr y 28 4))) (not (str.prefixof "<" x)) (str.contains z "</track>")))
(assert (str.suffixof "t</body>" y))
(check-sat)
