; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote onkeyup=""alert(1)"" contenteditable>test</blockquote>") (= x "<wbr onclick=""alert(1)"">test</wbr>") (= x "<bgsound onbeforecopy=""aler\u{1f600}t(\u{20000}1)"" contenteditable>test</bgsound>")))
(assert (or (= z "nkeydown>") (= z "=""alert(1)"">test</dd>") (= z "ouseout=""alert(1)"">test</ins>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "est</dd>" y) (not (str.contains z ")"">"))))
(assert (or (<= (str.len z) 12) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{8,10}$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "[^@]*@[^@]*[.][^@]*[^@]")))))
(assert (or (str.contains y "<blockquot") (= (str.at y 25) "e") (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z]+\.[A-Za-z]{2,3}$")))))
(assert (<= (str.len z) 16))
(check-sat)
