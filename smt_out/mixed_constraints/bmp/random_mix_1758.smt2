; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure id=x tabindex=1 ondeactivate=alert(1)></figure><input id=y autofocus>") (= x "<nobr id=x tabindex=1 onfocusin=alert(1)></nobr>")))
(assert (or (= z "st</\u{10348}td>") (= z "ve=""alert(1)"">test</dt>") (= z "s>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9@\.]{6,50}$"))) (not (= (str.indexof y "gur" 0) 3))))
(assert (or (not (str.suffixof "/\u{10348}td>" z)) (not (str.contains (str.replace x "r " " ") "<nob i")) (not (= "<script\x2F>javascript:t(1)</script>" (str.replace x "aler" "")))))
(assert (or (not (str.prefixof "<nobr id=" y)) (= (str.indexof x "u" 0) 4)))
(assert (= (str.len x) 77))
(check-sat)
