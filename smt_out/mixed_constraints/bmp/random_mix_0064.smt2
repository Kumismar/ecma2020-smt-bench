; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><spacer onload=alert(1)></spacer>") (= x "&lt;BR SIZE=\""&{alert('XSS')}\""&gt;")))
(assert (or (= z "et {color: red;}</style><plaintext id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></plaintext>") (= z "nbeforeactivate\u{20000}=alert(1)></font>") (= z "p://www.w3.org/1999/xlink"">")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "<" 0) 0)))
(assert (or (str.prefixof "<aside onf" y) (str.prefixof "<sv" y)))
(assert (or (= (str.indexof x "rt(1)" 0) 23) (str.contains z "//www.")))
(assert (or (str.prefixof "<" y) (not (str.suffixof "intext>" y)) (= (str.len y) 147)))
(assert (not (str.suffixof "xt>" y)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^([+\d].*)?\d$")) (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-Za-z0-9_\-\.]+)@([A-Za-z0-9_\-\.]+)\.([A-Za-z]{2,12})$")))))
(assert (not (= "t('XSS" (str.substr x 20 6))))
(assert (or (not (= (str.indexof z "/xli" 0) 19)) (not (str.contains (str.replace x "<spac" "alert(1)") "vg>alert(1)e")) (not (= (str.at x 6) "s"))))
(check-sat)
