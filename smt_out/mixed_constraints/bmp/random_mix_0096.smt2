; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex onmouseenter=""alert(1)"">test</isindex>") (= x "<\u{10348}slot oncut=""alert(1)"" contenteditable>test</slot>") (= x "<cite onmouseenter=""alert(1)"">test</cite>")))
(assert (or (= z "semove=""alert(1)"">test</input>") (= z "CgnWFNTJyk8L3NjcmlwdD4K&quot;&gt;") (= z "f=""\xE3\x80\x80javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9a-zA-Z._-]+@[0-9a-zA-Z._-]+[\\.]{1}[0-9a-zA-Z]+[\\.]?[0-9a-zA-Z]+$"))) (str.suffixof "est</slot>" x)))
(assert (or (not (= "t(1)"" id=""" (str.substr y 39 10))) (not (str.contains y "le")) (not (= "pt:java" (str.substr z 23 7)))))
(assert (or (not (= (str.at y 25) "(")) (= (str.at z 18) "w")))
(assert (or (= (str.indexof z "t</a>" 0) 68) (not (= "<isindex onmouseenter=""alert(1)"">test</isin emove=""alert(1)"">test</input>" (str.replace y "dex>s" " "))) (str.suffixof "t;" y)))
(check-sat)
