; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<META HTTP-EQUIV=""refresh"" CONTENT=""0;url=data:text/html;base64,PHNjcmlwdD5hbGVydCgnWFNTJyk8L3NjcmlwdD4K"">") (= x "<q onmouseout=""alert(1)"">test</q>")))
(assert (or (= z "beforeactivate=alert(1)></figcaption>") (= z "teditable>test</isindex>") (= z "er=""alert(1)"">test</hr>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<div " y) (not (= (str.indexof z "nd" 0) 19))))
(assert (or (not (str.prefixof "<q onmo" x)) (not (= (str.at z 69) "n")) (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*[a-z])[a-z0-9].{8,255}")))))
(assert (str.contains y "html;b"))
(assert (= (str.at y 69) " "))
(assert (= ")"">te" (str.substr x 22 5)))
(check-sat)
