; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;STYLE type=&quot;text/css&quot;&gt;BODY{background:url(&quot;javascript:alert(&apos;XSS&apos;)&quot;)}&lt;/STYLE&gt;") (= x "&lt;IMG SRC=&quot;javascript:alert(&apos;XSS&apos;);&quot;&gt;") (= x "<div style=""width: expression(document.vulnerable=true;);"">")))
(assert (or (= z "ll onmousedown=""alert(1)"">test</small>") (= z "ex>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 114) (not (str.suffixof "ex>" z))))
(assert (or (= (str.indexof y "si" 0) 71) (not (str.suffixof "a>" y))))
(assert (str.contains y "v style="))
(assert (or (not (= "own=""aler" (str.substr z 11 9))) (not (str.prefixof "ex" z))))
(assert (or (not (= (str.at x 59) "&")) (= (str.len z) 12)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+\/!#$%&'*=?^_`{|}~-]+@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]{2,})+$"))))
(check-sat)
