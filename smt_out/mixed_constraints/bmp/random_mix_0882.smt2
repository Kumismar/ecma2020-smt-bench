; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hgroup onbeforecut=""alert(1)"" contenteditable>test</hgroup>") (= x "<element onkeypress=""alert(1)"" contenteditable>test</element>")))
(assert (or (= z "pt></svg>") (= z "raggable=""true"" ondragenter=""alert(1)"">test</element>") (= z "wn=""alert(1)"">test</dt>")))
(assert (= y (str.++ x z)))
(assert (= "nter=""a" (str.substr z 23 7)))
(assert (or (str.contains y "re") (= "pt></" (str.substr z 0 5))))
(assert (or (not (str.contains y "eypress=""")) (str.suffixof "t</hgroup>" x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([A-z0-9._%+-]+@[A-z0-9.-]+\.[A-z]{2,6})|([0-9-\s]{10,})$"))))
(assert (str.suffixof "pt></svg>" y))
(assert (or (not (= "gable=""tr" (str.substr y 64 9))) (not (str.prefixof "<dir onm" y))))
(check-sat)
