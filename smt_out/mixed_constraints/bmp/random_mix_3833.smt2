; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area id=x tabindex=1 onbeforedeactivate=alert(1)></area><input autofocus>") (= x "<nextid o\u{10348}nmouseover\u{1f4a9}=""alert(1)"">test</nextid>")))
(assert (or (= z "dy onkeydown=""alert(1)"" contenteditable>test</tbody>") (= z "c=x\x10onerror=""javascript:alert(1)"">") (= z "ndler>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z]+$")) (= (str.indexof y "ale" 0) 85)))
(assert (or (= (str.at x 64) "a") (= "<area id=x tabindex=1 onbeforedeactivate=alert(1)></area><input autofocu>c=x\x10onerror=""javascript:alert(1)"">" (str.replace y "s" ""))))
(assert (or (= (str.at z 16) "j") (not (= (str.at y 36) "t")) (not (= (str.len x) 74))))
(assert (<= (str.len x) 69))
(check-sat)
