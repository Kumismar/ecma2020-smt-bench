; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea ondblclick=""alert(1)"">test</textarea>") (= x "<div style=""binding: url([link to code]);"">") (= x "--><!-- ---> <img src=xxx:x onerror=javascript:alert(1)> -->")))
(assert (or (= z "nt id=x tabindex=1 ondeactivate=alert(1)></element><input id=y autofocus>") (= z "t</image>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 11) "n")) (str.prefixof "t<" z)))
(assert (not (= (str.at y 12) "b")))
(assert (or (str.prefixof "-" x) (str.in_re x ((_ re.from_regex ecma2020) "^(?:[a-fA-F0-9]{8}|[a-fA-F0-9]{11}|[a-fA-F0-9]{14}|[a-fA-F0-9]{15,16}|[a-fA-F0-9]{18})$")) (str.contains x "ditable>")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\+?\d{1,3}?[- .]?\(?(?:\d{2,3})\)?[- .]?\d\d\d[- .]?\d\d\d\d$"))) (= "a ondblcli" (str.substr x 8 10))))
(assert (or (= (str.len y) 99) (= "--><!-- ---> <img src=xxx:x onerror=javascript:alert(1)> -->nt id=x tabi""1 ondeactivate=alert(1)></element><input id=y autofocus>" (str.replace y "ndex=" """"))))
(check-sat)
