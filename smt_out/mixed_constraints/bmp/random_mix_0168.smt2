; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a id=x tabindex=1 onfocusin=alert(1)></a>") (= x "<x%0Donxxx=1") (= x "<style>:target {color: red;}</style><tr id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tr>")))
(assert (or (= z "ouseup=""alert(1)"">test</tt>") (= z "l=stylesheet onload=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "us" 0) 24)))
(assert (or (not (str.contains z ")"">test")) (not (= (str.indexof y "er" 0) 31))))
(assert (or (str.prefixof "<" y) (not (str.contains (str.replace z "eu" " ") "s p=""al"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^\d{11}$|^\d{3,4}-\d{3,4}-\d{4}$")) (= "<style>:target {c""or: red;}</style><tr id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tr>" (str.replace x "ol" """")) (= (str.at x 35) "a")))
(check-sat)
