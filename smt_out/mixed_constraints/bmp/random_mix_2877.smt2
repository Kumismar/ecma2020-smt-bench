; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em onpaste=""alert(1)"" contenteditable>test</em>") (= x "<footer onkeypress=""alert(1)"" contenteditable>test</footer>") (= x "<dt onclick=""alert(1)"">test</dt>")))
(assert (or (= z "mg/onerror=\x0Ajavascript:alert(1)\x0Asrc=xxx:x />") (= z "=alert(1)></tt>") (= z "te=alert(1)></td><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "t" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[276][0-9]{7}"))) (not (= "mgalert(1)error=\x0Ajavascript:alert(1)\x0Asrc=xxx:x />" (str.replace z "/on" "alert(1)")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_+\-%]+[a-zA-Z0-9_.+\-%]+[a-zA-Z0-9_+\-%]+@(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}$"))))
(assert (or (<= (str.len y) 52) (= "id=y auto" (str.substr y 72 9))))
(assert (or (not (str.contains z " autofo")) (str.prefixof "<f" y) (= "st</dt>" (str.substr x 25 9))))
(assert (or (not (= "(" (str.substr y 25 1))) (= (str.at x 13) "p")))
(assert (not (str.contains y "itable>te")))
(check-sat)
