; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""110""><svg xmlns=""http://www.w3.org/2000/svg"">") (= x "<basefont id=x tabindex=1 onfocus=alert(1)></basefont>")))
(assert (or (= z "r=confirm`1` //>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (= "t" (str.substr x 39 1)))
(assert (or (= "m`1` //" (str.substr z 8 7)) (= (str.indexof y "w." 0) 35)))
(assert (or (not (str.suffixof ">" z)) (not (= (str.indexof x "t(1)""" 0) 25)) (not (= "x" (str.replace z ">" "x")))))
(assert (or (= "nt i" (str.substr x 7 4)) (not (str.contains (str.replace x """><sv" "x") "0xg ")) (<= (str.len z) 30)))
(assert (or (not (= (str.indexof z "`1` /" 0) 9)) (not (str.contains y "=""http://w")) (not (str.in_re x ((_ re.from_regex ecma2020) ".{5,}")))))
(assert (or (not (str.prefixof "<div id=" y)) (not (str.contains x "<source o"))))
(check-sat)
