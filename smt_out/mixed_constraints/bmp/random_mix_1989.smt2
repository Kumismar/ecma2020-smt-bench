; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script> var+x+=+showModelessDialog+(this); alert(x.document.cookie); </script>") (= x "<iframe src=""javascript:document.vulnerable=true; <")))
(assert (or (= z "x onxxx=1 \u{20000}onxxx=1") (= z "/dd>") (= z ")"" contenteditable>test</track>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len x) 56))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^((([!#$%&'*+\-/=?^_`{|}~\w])|([!#$%&'*+\-/=?^_`{|}~\w][!#$%&'*+\-/=?^_`{|}~\.\w]{0,}[!#$%&'*+\-/=?^_`{|}~\w]))[@]\w+([-.]\w+)*\.\w+([-.]\w+)*)$"))) (not (str.contains x "s); alert("))))
(assert (= (str.indexof z "rac" 0) 26))
(assert (or (= (str.at z 7) "=") (not (str.prefixof "<ifram" y))))
(assert (or (not (str.prefixof "ext>" z)) (not (= "javascript:>" (str.replace z "/dd" "javascript:"))) (= (str.len x) 79)))
(assert (or (= (str.len y) 97) (not (str.prefixof "g" z)) (= (str.indexof y "e)" 0) 66)))
(assert (not (= "ck>" (str.substr z 28 10))))
(assert (str.suffixof "nUnload>" x))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([^0-9]*)"))))
(check-sat)
