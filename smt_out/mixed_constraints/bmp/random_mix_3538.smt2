; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section draggable=""true"" ondrag=""alert(1)"">test</section>") (= x "`""'><img src=xxx:x onerror\x00=javascript:alert(1)>")))
(assert (or (= z "form>") (= z "pt:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (= (str.at z 5) "t"))
(assert (not (= (str.at y 16) "l")))
(assert (or (not (= "`""'" (str.substr x 0 3))) (not (str.contains (str.replace z "sc" "<b>") "1)</<b>ri"))))
(assert (not (str.prefixof "<fra" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}0-9-]+\.[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}]{2,}$"))) (not (str.contains y "(1)"">te"))))
(assert (not (= (str.len z) 5)))
(assert (str.contains y "nerror"))
(check-sat)
