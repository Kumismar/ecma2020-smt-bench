; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist draggable=""true"" ondrag=""alert(1)"">test</datalist>") (= x "<map onmouseup=""alert(1)"">test</map>") (= x "&lt;A HREF=\""http&#58;//google&#58;ha&#46;ckers&#46;org\""&gt;XSS&lt;/A&gt;")))
(assert (or (= z ")></xss>") (= z "t id=x tabindex=1 onbeforedeactivate=alert(1)></fieldset><input autofocus>") (= z "ntenteditable>test</ruby>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len y) 68) (str.in_re x ((_ re.from_regex ecma2020) "^[-_0-9A-Za-z]+$"))))
(assert (or (= (str.at x 12) "u") (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9 +]{3,}"))))
(assert (or (= (str.indexof z "ntedi" 0) 3) (not (= "alert(1)""" (str.substr x 16 9)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z\u{623}-\u{64a}]+[ ]{0,1}[a-zA-Z\u{623}-\u{64a}]*"))) (not (= (str.indexof y ">" 0) 53)) (not (<= (str.len z) 33))))
(assert (str.contains (str.replace x "al" " ") "dat i"))
(check-sat)
