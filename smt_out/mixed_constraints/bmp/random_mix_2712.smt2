; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog id=x tabindex=1 onfocusin=alert(1)></dialog>") (= x "<option draggable=""true"" ondragstart=""alert(1)"">test</option>")))
(assert (or (= z " id=x tabindex=1 onfocusin=alert(1)></optgroup>") (= z "bject ondblclick=""alert(1)"">test</object>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "></dialog>" x)) (= (str.at x 23) " ")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[1-9][0-9]{3} ?(?!sa|sd|ss)[a-zA-Z]{2}$")) (str.contains z "ck=""ale")))
(assert (or (not (= (str.at x 32) "t")) (= "bject ondblclick=""alert(1)""xest</object>" (str.replace z ">t" "x"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z0-9-]+$"))) (str.contains y " dr")))
(check-sat)
