; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist onmousedown=""alert(1)"">test</datalist>") (= x "navigator.vibrate(500)")))
(assert (or (= z "x>") (= z "ipt&#058;alert('XSS')&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "nmou" " ") "t o sedo") (str.suffixof "t>x>" y)))
(assert (or (str.contains x "tali") (not (str.in_re y ((_ re.from_regex ecma2020) "^(0[1-9]|1[012])$")))))
(assert (not (str.contains x "avigator.v")))
(assert (or (not (str.suffixof "S')&gt;" z)) (<= (str.len z) 5) (= ">" (str.substr z 1 6))))
(check-sat)
