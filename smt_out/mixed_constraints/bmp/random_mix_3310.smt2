; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<content onpaste=""alert(1)"" contenteditable>test</content>") (= x "<output onbeforecut=""alert(1)"" contenteditable>test</output>")))
(assert (or (= z "est</picture>") (= z "rt(1)"" id=""fuzzelement1"">test</a>") (= z "x=1 onactivate=alert(1)></xmp>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace z "p her" """") "ro""e</"))
(assert (or (= "rt(1)"" id=""fuzzelement1"">test< a>" (str.replace z "/" " ")) (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-zA-z]{2,4}$")) (= "</c" (str.substr y 48 3))))
(assert (or (not (str.suffixof "t>" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "[\x21-\x7E]"))) (= (str.indexof z "id=""" 0) 7)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9+\\s]*$"))) (str.contains x "test") (str.suffixof ")></xmp>" y)))
(check-sat)
