; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>if(""x\\xEE\xA9\x93"".length==2) { javascript:alert(1);}</script>") (= x "<;STYLE TYPE="";text/javascript"";>;alert(';XSS';);<;/STYLE>;") (= x "<source draggable=""true"" ondragleave=""alert(1)"">test</source>")))
(assert (or (= z "ter=""alert(1)"">test</keygen>") (= z "ble=""true"" ondragleave=""alert(1)"">test</legend>") (= z "aggable=""true"" ondragstart=""alert(1)"">test</col>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._-]+$"))) (= (str.indexof x "/S" 0) 51) (not (= "<script>if(""x\\xEE\xA9\x93"".length==2) { javascript:alert(1);}</script>ble=""tru"" ondragleave=""alert(1)"">test</legend>" (str.replace y "e""" """")))))
(assert (or (str.suffixof "gend>" z) (= (str.at y 44) "S")))
(assert (or (not (str.contains (str.replace z "t" "x") "ble=""xrue")) (not (str.contains (str.replace x "(';XS" "x") "ertxS"))))
(assert (or (= (str.indexof x "xA9\x" 0) 19) (not (= "e=""alert(1" (str.substr x 35 10)))))
(assert (or (str.contains y "rue") (str.contains z "ce") (= (str.indexof x "l" 0) 15)))
(check-sat)
