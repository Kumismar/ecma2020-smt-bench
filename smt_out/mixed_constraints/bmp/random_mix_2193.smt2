; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><ol id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></ol>") (= x "<style>:target {color:red;}</style><link id=x style=""transition:color 1s"" ontransitionend=alert(1)></link>")))
(assert (or (= z "onbeforecopy=""alert(1)"" contenteditable>test</aside>") (= z "st</form>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^0[1-68][0-9]{8}$"))))
(assert (not (str.suffixof "F" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z]{2,}\s[a-zA-z]{1,}'?-?[a-zA-Z]{2,}\s?([a-zA-Z]{1,})?)"))) (str.in_re y ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{454}\u{404}\u{457}\u{407}\u{406}\u{456}Ii\u{490}\u{491}\u{2018}'\u{2019}?`\s]+$"))))
(assert (or (= "ompass." (str.substr z 29 7)) (not (= "<style>:target {color:red;}</style><link idyle=""transition:color 1s"" ontransitionend=alert(1)></link>" (str.replace x "=x st" "")))))
(assert (or (= (str.at x 75) "n") (= (str.indexof x "l" 0) 4)))
(assert (or (not (= (str.len z) 9)) (not (str.suffixof "rame>" x)) (not (str.prefixof "<style>:ta" y))))
(check-sat)
