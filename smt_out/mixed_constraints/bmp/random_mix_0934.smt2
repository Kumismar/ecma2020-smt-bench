; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time onblur=alert(1) tabindex=1 id=x></time><input autofocus>") (= x "<br id=x tabindex=1 onfocusin=alert(1)></br>") (= x "<style>@keyframes x{}</style><map style=""animation-name:x"" onanimationend=""alert(1)""></map>")))
(assert (or (= z "able id=x t\u{1f4a9}abindex=1 onfocus=alert(1)></table>") (= z " ondragleave=""alert(1)"">test</small>") (= z "></table>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\s*[a-zA-Z,\u{e7},\u{c7},\u{11f},\u{11e},\u{131},\u{130},\u{f6},\u{d6},\u{15f},\u{15e},\u{fc},\u{dc},\s]+\s*$"))) (not (>= (str.len x) 85))))
(assert (or (= (str.len y) 54) (not (str.in_re y ((_ re.from_regex ecma2020) "^.{10,11}$")))))
(assert (or (= (str.indexof z """" 0) 7) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-z A-Z  0-9 ' . / &]{2,60}$"))) (not (= (str.indexof y "e" 0) 4))))
(assert (or (= (str.indexof x "d=""a" 0) 72) (not (str.contains (str.replace x "oreco" "") "nbefpy=""a"))))
(check-sat)
