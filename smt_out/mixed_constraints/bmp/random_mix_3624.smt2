; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col draggable=""true"" ondragstart=""alert(1)"">test</col>") (= x "<div draggable=""true"" contenteditable>drag me</div><marquee ondrop=alert(1) contenteditable>drop here</marquee>")))
(assert (or (= z "alert(1)></iframe>") (= z "er=alert(1) contenteditable>drop here</embed>") (= z "s>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 21) "i") (not (= (str.len x) 111))))
(assert (or (= (str.at y 50) "/") (str.prefixof " DATAF" z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^\w{1,15}$"))))
(assert (or (= "<col draggable=""true"" ondragstart=""alert(1)"">t /col>" (str.replace x "est<" " ")) (not (str.suffixof "marquee>s>" y))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\S+$"))) (= (str.indexof y ">ale" 0) 54) (not (str.contains y "ntentedi"))))
(assert (or (<= (str.len y) 80) (not (str.prefixof "<div d" x))))
(assert (not (= "1" (str.substr z 6 1))))
(assert (= (str.indexof x "r" 0) 6))
(check-sat)
