; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onfocusout=alert(1) id=x><input autofocus>") (= x "<xmp onkeypress=""alert(1)"" contenteditable>test</xmp>") (= x "<main id=x tabindex=1 onbeforedeactivate=alert(1)></main><input autofocus>")))
(assert (or (= z "end=""alert(1)"">test</rt>") (= z "/tt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([_A-z0-9 ]){5,}$"))) (str.suffixof "rt>" y)))
(assert (= (str.len z) 24))
(assert (or (not (<= (str.len y) 57)) (str.contains x "ditab") (str.prefixof "<input " y)))
(assert (or (str.contains (str.replace z "=""" "x") "endxa") (= """>t" (str.substr x 26 3))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^.{0,4}$"))))
(assert (or (= "tivate=" (str.substr y 34 7)) (str.prefixof "#X000003c" z)))
(assert (not (= "<mxn id=x tabindex=1 onbeforedeactivate=alert(1)></main><input autofocus>" (str.replace x "ai" "x"))))
(check-sat)
