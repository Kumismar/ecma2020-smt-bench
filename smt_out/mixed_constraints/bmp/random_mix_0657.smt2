; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend oncontextmenu=""alert(1)"">test</legend>") (= x "<LA\u{20000}YER S\u{20000}RC=""%(scriptlet)s""></LAYER>") (= x "<div draggable=""true"" contenteditable>drag me</div><span ondragover=alert(1) contenteditable>drop here</span>")))
(assert (or (= z "test</code>") (= z "egend id=x tabindex=1 onfocus=alert(1)></legend>") (= z "rp draggab\u{1f4a9}le=""true"" ondragend=""alert(1)"">test</\u{10348}rp>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[(]?([0-9]{3})[)]?([-. ])?([0-9]{3})([-. ])?([0-9]{4})$"))))
(assert (or (not (= (str.indexof y "el=a" 0) 93)) (not (str.in_re z ((_ re.from_regex ecma2020) "^\s*(3[01]|[12][0-9]|0?[1-9])\.(1[012]|0?[1-9])\.((?:19|20)\d{2})\s*$")))))
(assert (or (str.prefixof "te" z) (not (str.contains z "st</code>")) (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-z0-9._-])+@([a-z0-9.-])+(.)([a-z]){2,4}$")))))
(assert (or (not (str.suffixof "est</code>" z)) (str.prefixof "<l" x)))
(assert (or (= "<LA\u{20000}YER S\u{20000}RC=""%(salert(1)let)s""></LAYER>" (str.replace x "cript" "alert(1)")) (not (= """alert(1" (str.substr y 68 8)))))
(assert (not (str.contains (str.replace x "nu=""" "<b>") "xtme<b>aler")))
(check-sat)
