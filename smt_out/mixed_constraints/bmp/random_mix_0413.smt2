; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onmouseenter=""alert(1)"">test</input>") (= x "&{document.vulnerable=true;};") (= x "<style>:target {color: red;}</style><em id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></em>")))
(assert (or (= z " onkeyup=""alert(1)"" contenteditable>test</iframe>") (= z "name:x"" onanimationstart=""alert(1)""></acronym>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{8,10}$"))))
(assert (or (= (str.indexof y ">test" 0) 30) (str.contains z "e>")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "(^\d{5}$)|(^\d{5}-\d{4}$)"))))
(assert (or (not (str.prefixof "&" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^(\+[0-9]{2,}[0-9]{4,}[0-9]*)(x?[0-9]{1,})?$"))) (not (str.prefixof "<inpu" x))))
(assert (or (>= (str.len y) 67) (not (= " {col" (str.substr x 14 5))) (not (= (str.at y 30) "t"))))
(assert (not (str.prefixof "&{do" x)))
(check-sat)
