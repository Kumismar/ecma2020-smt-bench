; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onload=alert(1)></iframe>") (= x "<style>:target {color:red;}</style><html id=x style=""transition:color 1s"" ontransitionend=alert(1)></html>") (= x "<mark id=x tabindex=1 onactivate=alert(1)></mark>")))
(assert (or (= z "e=""true"" ondrag=""alert(1)"">\u{1f600}test</small>") (= z "Unload=""javascript:javascript:alert(1)""></svg onUnload>") (= z "vg><dat\u{1f4a9}alist onload=alert(1)></datalist>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "e=""true"" o" z)))
(assert (or (not (str.contains y "g><dat\u{1f4a9}al")) (not (= (str.at y 70) "i"))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]{3}[0-9]{3}")))
(assert (or (not (= (str.at y 16) "d")) (not (str.in_re z ((_ re.from_regex ecma2020) "^.{1,200}"))) (str.suffixof ">" x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "\d+"))))
(assert (or (not (str.suffixof "ode>TYLE>" y)) (not (str.prefixof "v" z)) (= (str.indexof y "ion:c" 0) 60)))
(assert (not (str.prefixof "vg><dat\u{1f4a9}al" z)))
(check-sat)
