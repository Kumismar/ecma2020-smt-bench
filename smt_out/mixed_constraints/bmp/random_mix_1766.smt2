; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tt id=x tabindex=1 onfocus=alert(1)></tt>") (= x "<style>:target {color: red;}</style><hr id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></hr>") (= x "&lt;IMG SRC=&quot; &amp;#14;  javascript:alert(&apos;XSS&apos;);&quot;&gt;")))
(assert (or (= z "r=javascript:alert(1)> -->") (= z "lert(1)"" contenteditable>test</i>") (= z "on\u{20000}mouseenter=""alert(1)"">test</data>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len x) 57)) (not (= "ert(1)></" (str.substr x 30 9))) (str.contains (str.replace y "lor 1" "x") "on:cox0s")))
(assert (str.contains y "lor "))
(assert (or (not (str.prefixof "r=javascri" z)) (not (= "t(" (str.substr y 97 2))) (str.contains y "r:")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[A-Z|a-z|\s-]{1,}")) (str.contains z "entedit")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9\-\s]{5,60}$"))))
(assert (not (= "g>" (str.substr z 13 6))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{1,5}([.,]{1}[0-9]{1,2})*$")) (not (= (str.indexof z "F" 0) 12))))
(check-sat)
