; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><figcaption id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></figcaption>") (= x "<embed onmouseenter=""alert(1)"">test</embed>")))
(assert (or (= z "s.onerror=confirm(1)") (= z "i>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len z) 1)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6,28}$"))) (str.contains z "=confir")))
(assert (or (str.suffixof "n>" y) (= (str.at z 0) "i")))
(assert (or (= "<styx>:target {color: red;}</style><figcaption id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></figcaption>s.onerror=confirm(1)" (str.replace y "le" "x")) (not (<= (str.len z) 6))))
(assert (not (>= (str.len y) 152)))
(assert (or (not (str.prefixof "<st" x)) (str.contains z """al")))
(check-sat)
