; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onkeydown=""alert(1)"" contenteditable>test</rtc>") (= x "<samp oncontextmenu=""alert(1)"">test</samp>") (= x "<xmp id=x tabindex=1 onbeforedeactivate=alert(1)></xmp><input autofocus>")))
(assert (or (= z "lt;/A&gt;") (= z ")>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 3) "m") (not (= (str.at x 19) "1"))))
(assert (str.suffixof ">lt;/A&gt;" y))
(assert (str.prefixof ")" z))
(assert (or (not (= (str.indexof x "aler" 0) 36)) (not (= (str.indexof y "lert(" 0) 22))))
(assert (or (str.suffixof "gt;" z) (str.in_re z ((_ re.from_regex ecma2020) "^[67]{1}[0-9]{8}$"))))
(assert (= (str.at x 43) """"))
(assert (= "di" (str.substr y 34 2)))
(check-sat)
