; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><rb style=""animation-name:x"" onanimationstart=""alert(1)""></rb>") (= x "<style>:target {col\u{20000}or:red;}</style><form id=x style=""transition:color 1s"" on\u{20000}transitionend=alert(1)></form>")))
(assert (or (= z "r.vibrate(500)") (= z "igcaption>") (= z "t\u{10348}</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "bdi>" z) (str.in_re x ((_ re.from_regex ecma2020) "^\S+@[a-zA-Z0-9._-]+?\.[a-zA-Z]{2,3}$"))))
(assert (or (not (= (str.indexof z "gca" 0) 1)) (not (= "talert(1)/bdi>" (str.replace z "\u{10348}<" "alert(1)"))) (str.prefixof "<" x)))
(assert (or (not (str.contains z "te(50")) (str.in_re x ((_ re.from_regex ecma2020) "[0-9\s-]{0,15}"))))
(assert (<= (str.len y) 123))
(assert (or (str.contains y " x") (not (= "ue"" on" (str.substr y 21 6))) (<= (str.len y) 99)))
(assert (or (not (= (str.at y 85) ">")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z. ']*$")))))
(check-sat)
