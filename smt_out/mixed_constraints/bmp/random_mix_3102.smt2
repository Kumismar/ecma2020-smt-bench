; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary id=x tabindex=1 ondeactivate=alert(1)></summary><input id=y autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><nobr ondragover=alert(1) contenteditable>drop here</nobr>")))
(assert (or (= z " DYN\u{1f600}SRC=""java\u{1d400}script:javascript:alert(1)"">") (= z "OBJECT TYPE=&quot;text/x-scriptlet&quot; DATA=&quot;http://ha.ckers.org/scriptlet.html&quot;&gt;&lt;/OBJECT&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "us>" x)) (str.suffixof "yChange>" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(0|86|17951)?(13[0-9]|15[012356789]|17[678]|18[0-9]|14[57]|19[0-9]|16[0-9])[0-9]{8}$"))) (not (= "<su" (str.substr x 0 3)))))
(assert (or (not (str.contains z "xt/")) (str.in_re x ((_ re.from_regex ecma2020) "^[0-9-/\s]*"))))
(assert (or (str.prefixof "OB" z) (<= (str.len z) 121) (not (str.suffixof "t</ruby>" z))))
(assert (str.contains (str.replace z "BJECT" "x") "Ox TYPE"))
(check-sat)
