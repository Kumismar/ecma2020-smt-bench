; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form><textarea &#13; onkeyup='\u{5c}u0061\u{5c}u006C\u{5c}u0065\u{5c}u0072\u{5c}u0074&#x28;1&#x29;'>") (= x "<data oncut=""alert(1)"" contenteditable>test</data>")))
(assert (or (= z "SRC=""javascript:document.vulnerable=true;"">") (= z "lert(1)"">test</summary>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 18) "m")) (not (str.in_re x ((_ re.from_regex ecma2020) "^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,50})+$"))) (>= (str.len z) 38)))
(assert (or (str.contains (str.replace x "at" """") "<d""a ") (not (>= (str.len x) 47))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^0[6-7]{1}(([0-9]{2}){4})|((\s[0-9]{2}){4})|((-[0-9]{2}){4})$"))) (= "lnerable" (str.substr z 27 8)) (= (str.indexof z "ent.v" 0) 21)))
(assert (or (not (str.contains y "test</sum")) (str.prefixof "<data " x)))
(assert (not (str.suffixof "</summary>" y)))
(assert (or (= " onkeypres" (str.substr y 4 10)) (= "ript:do" (str.substr z 11 7))))
(check-sat)
