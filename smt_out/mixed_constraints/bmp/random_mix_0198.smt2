; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<label id=x tabindex=1 ondeactivate=alert(1)></label><input id=y autofocus>") (= x "<audio onmouseleave=""alert(1)"">test</audio>")))
(assert (or (= z "*/xpression(alert('XSS'))>") (= z "rt(1)"">test</nav>") (= z ";SCRIPT SRC=//ha.ckers.org/.j>;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "rt(1)"">t" z)) (= (str.at x 37) "a") (str.in_re y ((_ re.from_regex ecma2020) "[0-9--]*$"))))
(assert (not (= ">" (str.substr z 21 4))))
(assert (or (not (str.suffixof "ofocus>" x)) (not (str.suffixof ">" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^#[a-fA-F0-9]{6}|#[a-fA-F0-9]{3}|rgb *\( *[0-9]{1,3}%? *, *[0-9]{1,3}%? *, *[0-9]{1,3}%? *\)|rgba *\( *[0-9]{1,3}%? *, *[0-9]{1,3}%? *, *[0-9]{1,3}%? *, *[0-9]{1,3}%? *\)|black|green|silver|gray|olive|white|yellow|maroon|navy|red|blue|purple|teal|fuchsia|aqua|url\(#[^\)]+\)$")))))
(assert (not (= (str.len z) 31)))
(assert (or (str.prefixof "<la" y) (str.contains (str.replace y "1)" "alert(1)") "lert(alert(1)"">te")))
(assert (or (str.contains z "/nav>") (not (str.contains (str.replace x "utof" "") "d=y aocu")) (str.suffixof "</audio>" x)))
(check-sat)
