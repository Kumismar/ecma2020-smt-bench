; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;BASE HREF="";javascript:alert(';XSS';);//"";>;") (= x "<meta oncopy=""alert(1)"" contenteditable>test</meta>")))
(assert (or (= z "focus>") (= z "ml;base64,%(base64)s"">")))
(assert (= y (str.++ x z)))
(assert (str.contains x "(1)"))
(assert (or (not (str.prefixof "<aside onb" x)) (str.contains x "F=") (= (str.indexof x "</" 0) 44)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "(?=^.{8,14}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$"))) (not (str.contains y "ascript")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9 .()+-]{6,16}$")))))
(assert (<= (str.len x) 51))
(check-sat)
