; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><kbd style=""animation-name:x"" onanimationstart=""alert(1)""></kbd>") (= x "<command oncontextmenu=""alert(1)"">test</command>") (= x "<IMG SRC=x oncanplay=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "ummary>") (= z "color: red;}</style><td id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></td>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 95) "l"))
(assert (not (= (str.len y) 139)))
(assert (or (not (str.prefixof "<style>@k" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "(\+?\d[- .]*){10,12}")))))
(assert (or (= (str.indexof z "or" 0) 3) (str.prefixof "<IMG" x) (= "contex" (str.substr y 11 6))))
(assert (or (not (= "a" (str.substr x 45 1))) (= (str.at z 29) "s")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"))))
(check-sat)
