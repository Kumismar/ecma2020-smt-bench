; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><s ondrop=alert(1) contenteditable>drop here</s>") (= x "<var onmouseover=""alert(1)"">test</var>") (= x "<shadow onkeypress=""alert(1)"" contenteditable>test</shadow>")))
(assert (or (= z "</rtc>") (= z "ring.fromCharCode(88,83,83))"">") (= z "-scriptlet\"" DATA=\""http&#58;//ha&#46;ckers&#46;org/scriptlet&#46;html\""&gt;&lt;/OBJECT&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (= "var" (str.substr x 34 3))) (not (<= (str.len y) 75))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9]{3,9}$")) (not (str.suffixof "/rtc>" z))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^\(\d{3}\) \d{3}-\d{4}$")) (not (= "<var onmouseor=""alert(1)"">test</var>" (str.replace x "ve" "")))))
(assert (str.prefixof "<var on" y))
(assert (not (>= (str.len z) 6)))
(check-sat)
