; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><blockquote style=""animation-name:x"" onanimationend=""alert(1)""></blockquote>") (= x "<div draggable=""true"" contenteditable>drag me</div><iframe ondrop=alert(1) contenteditable>drop here</iframe>") (= x "<rtc onbeforecut=""alert(1)"" contenteditable>test</rtc>")))
(assert (or (= z "ton>") (= z "le>test</slot>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 6) "t")) (not (str.in_re z ((_ re.from_regex ecma2020) "(^[^@]+@\w+(\.\w+)+$)|(.*\d){9,}")))))
(assert (or (= (str.indexof x "ike" 0) 4) (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-9]){5}"))) (not (= (str.len z) 14))))
(assert (or (= (str.at y 28) "c") (not (str.contains (str.replace y "i" "javascript:") "ntedjavascript:ta"))))
(assert (or (str.contains z "le>tes") (= (str.indexof x "><" 0) 50)))
(assert (not (str.contains (str.replace z "ton" "javascript:") "javascript:>")))
(check-sat)
