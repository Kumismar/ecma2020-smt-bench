; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp onblur=alert(1) tabindex=1 id=x></rp><input autofocus>") (= x "<! foo=""><scrip\u{10348}t>alert(91)</script>\u{20000}"">") (= x "<basefont onfoc\u{10348}usout=alert(1) \u{1f600}tabindex=1 id=x></basefont><input autofocus>")))
(assert (or (= z "forecopy=""alert(1)"" contenteditable>test</p>") (= z "aggable=""true"" ondragstart=""alert(1)"">test</strong>") (= z "0003c;")))
(assert (= y (str.++ x z)))
(assert (= "fon" (str.substr x 54 3)))
(assert (or (str.suffixof "3c;" z) (= "<rp onblur=alt(1) tabindex=1 id=x></rp><input autofocus>0003c;" (str.replace y "er" "")) (not (= "x03c;" (str.replace z "00" "x")))))
(assert (or (not (= (str.indexof y "91" 0) 24)) (not (= (str.at z 3) "3"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[\+][3][8][0][0-9]{2}[0-9]{7}$|^[\+][3][8][\(][0][0-9]{2}[\)][0-9]{7}$|^[\+][3][8][\(][0][0-9]{2}[\)][0-9]{3}[-][0-9]{2}[-][0-9]{2}$"))))
(assert (or (= (str.at y 95) "e") (= (str.len x) 58) (not (str.suffixof "p>" z))))
(assert (or (not (= (str.indexof z "e" 0) 6)) (str.contains z "03c")))
(assert (or (= (str.at y 65) "r") (>= (str.len z) 3)))
(check-sat)
