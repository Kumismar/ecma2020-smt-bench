; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp onbeforepaste=""alert(1)"" contenteditable>test</xmp>") (= x "<;IMG SRC=';vbscript:msgbox("";XSS"";)';>;")))
(assert (or (= z "t(1)></table>") (= z "alert(1)"">test</br>") (= z "lert(1)"">test</canvas>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len x) 38)))
(assert (or (str.suffixof "t</canvas>" z) (not (= (str.indexof x "orepa" 0) 10))))
(assert (or (>= (str.len y) 158) (str.prefixof "<xm" y) (not (str.suffixof "canvas>" y))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\u{105}\u{107}\u{106}\u{119}\u{142}\u{141}\u{144}\u{143}\u{f3}\u{d3}\u{15b}\u{15a}\u{17c}\u{17b}\u{17a}\u{179}\-]{3,20}$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\+(?:[0-9] ?){6,14}[0-9]$"))) (= (str.len x) 86) (str.contains z "rite()>")))
(assert (or (not (= (str.at x 14) "a")) (not (str.contains z ")></table"))))
(check-sat)
