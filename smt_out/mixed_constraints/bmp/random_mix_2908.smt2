; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div oncut=""alert(1)"" contenteditable>test</div>") (= x "<x onmousemove=alert(1)>hover this!") (= x "<style>@keyframes x{}</style><mark style=""animation-name:x"" onanimationend=""alert(1)""></mark>")))
(assert (or (= z "tt onmousedown=""alert(1)"">test</tt>") (= z "editable>drag me</div><blockquote ondragover=alert(1) contenteditable>drop here</blockquote>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "le><m" (str.substr x 26 5))) (not (= (str.at z 53) " "))))
(assert (str.contains (str.replace x "se" "") "nmoudown="))
(assert (= ">d" (str.substr y 56 2)))
(assert (or (str.contains (str.replace x " thi" "x") "verxs!") (str.suffixof "est</tt>" y) (= "<div oncut=""alert(1)"" contenteditable>test div>" (str.replace x "</" " "))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\s]{1,30}$"))))
(check-sat)
