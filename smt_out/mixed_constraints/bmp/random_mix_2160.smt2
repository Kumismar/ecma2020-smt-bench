; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike onmousedown=""alert(1)"">test</strike>") (= x "SRC=&#10<IMG 6;&#97;&#118;&#97;&#115;&#99;&#114;&#105;&#112;&#116;\u{1f4a9}&#58;&#97;&#108;&#\u{1f600}101;&#114;&#116;&#40;&#39;&#88;&#83;&#83;&#39;&#41;>") (= x "<style>@keyframes x{}</style><mark style=""animation-name:x"" onanimationend=""alert(1)""></mark>")))
(assert (or (= z "lert(1)"">test</cite>") (= z "nimationend=""alert(1)""></div>")))
(assert (= y (str.++ x z)))
(assert (= "<strikx onmousedown=""alert(1)"">test</strike>" (str.replace x "e" "x")))
(assert (or (not (= (str.at y 42) "d")) (str.contains (str.replace y "o" "") "ke n") (= "rt" (str.substr z 2 2))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[0-9()\. -+]{10,15}$")))
(assert (or (not (= "alert(1)" (str.substr y 21 8))) (= (str.at y 130) "9") (str.contains z "=alert")))
(assert (not (= "io" (str.substr y 49 2))))
(assert (or (str.contains (str.replace z ")" "alert(1)") "rt(1alert(1)""></d") (= (str.indexof z "t</" 0) 12)))
(assert (or (str.prefixof "<image " y) (not (= (str.at x 16) "o")) (not (>= (str.len z) 15))))
(check-sat)
