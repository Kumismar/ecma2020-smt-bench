; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title draggable=""true"" ondragstart=""alert(1)"">test</tit\u{1f600}le>") (= x "<code onbeforecopy=""alert(1)"" contenteditable>test</code>") (= x "<abbr onkeydown=""alert(1)"" contenteditable>test</abbr>")))
(assert (or (= z "rue"" ondragleave=""alert(1)"">test</address>") (= z "p style=""animation-name:x"" onanimationend=""alert(1)""></p>") (= z "onclick=""alert(1)"">test</picture>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "onc" z)))
(assert (or (str.contains y "name:") (not (str.in_re z ((_ re.from_regex ecma2020) "http://hydraruzxpnew4\u{430}f.onion")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9][0-9][0-9][0-9]"))) (not (= "</picture>" (str.substr z 23 10))) (not (str.suffixof "ture>" y))))
(assert (str.prefixof "<" x))
(assert (or (str.contains (str.replace y "nend" "") "matio=""ale") (str.in_re x ((_ re.from_regex ecma2020) "^\d{4}\/\d{1,2}\/\d{1,2}$"))))
(check-sat)
