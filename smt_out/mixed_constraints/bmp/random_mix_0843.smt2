; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd id=x tabindex\u{10348}=1 onde\u{20000}activate=alert(1)></dd><input id=y autofocus>") (= x "<tbody id=x tabindex=1 onbeforedeactivate=alert(1)></tbody><input autofocus>")))
(assert (or (= z "rt(1)>") (= z "mpt(1)")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "d=y auto")) (= ">" (str.substr x 41 5))))
(assert (or (<= (str.len x) 79) (not (= (str.at x 61) "a")) (not (= "gable=""true"" contenteditable>\u{1d400}drag me</div><mark ondragover=alert(1) contenteditable>drop here</mark>" (str.replace z """" """")))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[_0-9]{1,}$")) (str.suffixof "t(1)>" z)))
(assert (or (not (str.prefixof "r" z)) (str.contains z "t(1)>") (str.suffixof "s>mpt(1)" y)))
(assert (or (str.contains x "tbody>") (not (str.suffixof "s>" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "(80276|83276)\d{10}")))))
(assert (= (str.len x) 76))
(check-sat)
