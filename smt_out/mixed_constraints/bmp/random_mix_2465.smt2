; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas onmousemove=""alert(1)"">test</canvas>") (= x "<figure draggable=""true"" ondrag=""alert(1)"">test</figure>")))
(assert (or (= z "d=""alert(1)"">test</multicol>") (= z "ce style=""animation-name:x"" onanimationstart=""alert(1)""></source>") (= z "utofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "draggable=")) (str.in_re y ((_ re.from_regex ecma2020) "[0-9-]*$"))))
(assert (or (str.suffixof "s>" z) (not (str.in_re x ((_ re.from_regex ecma2020) "\+7\s\([0-9]{3}\)\s[0-9]{3}-[0-9]{2}-[0-9]{2}")))))
(assert (or (str.suffixof "cus>" z) (not (= "d=""aalert(1)1)"">test</multicol>" (str.replace z "lert(" "alert(1)"))) (str.contains (str.replace x "ble=" "x") "ax""true")))
(assert (not (= (str.indexof z "s" 0) 4)))
(assert (or (not (str.contains x "=""al")) (not (str.contains x ")"">test<")) (= (str.indexof z """ale" 0) 2)))
(assert (not (= (str.at y 88) "=")))
(check-sat)
