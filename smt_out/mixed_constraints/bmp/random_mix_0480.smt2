; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid onfocusout=alert(1) tabindex=1 id=x></nextid><input autofocus>") (= x "<style>@keyframes x{}</style><u style=""animation-name:x"" onanimationstart=""alert(1)""></u>") (= x "<template onmousedown=""alert(1)"">test</template>")))
(assert (or (= z "1\x9Fjavascri\u{1f600}\u{1f4a9}pt:alert(1)</script>") (= z "ntenteditable>test</svg>") (= z "ttp://onxxx%3D1/")))
(assert (= y (str.++ x z)))
(assert (= "est</" (str.substr y 34 5)))
(assert (or (str.prefixof "<nex" y) (not (str.in_re z ((_ re.from_regex ecma2020) "(^$)|(^[a-zA-Z0-9\u{5c}u00C0-\u{5c}u00D6\u{5c}u00D8-\u{5c}u00F6\u{5c}u00F8-\u{5c}u00FF][-a-zA-Z0-9.'& \u{5c}u00C0-\u{5c}u00D6\u{5c}u00D8-\u{5c}u00F6\u{5c}u00F8-\u{5c}u00FF]{1,}$)"))) (str.contains (str.replace y "tart" "") "ns=")))
(assert (or (= "yl" (str.substr y 25 2)) (not (= "<button onpast""=""alert(1)"" contenteditable>test</button>rt(1)"">test</cite>" (str.replace y "e" """"))) (not (<= (str.len y) 146))))
(assert (or (not (= (str.indexof z "nxx" 0) 7)) (not (str.suffixof "ipt>" y))))
(assert (or (not (str.contains z "\u{1f4a9}pt:a")) (not (= "x%3D1/" (str.substr z 10 10)))))
(check-sat)
