; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<A HREF=""http://0102.0146.0007.00000223/"">XSS</A>") (= x "<XML ID=I><X><C><![CDATA[<IMG SRC=""javas]]<![CDATA[cript:javascript:alert(1);"">]]</C><X></xml>")))
(assert (or (= z """>z") (= z "t(1)"" contenteditable>test</rtc>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "</xml>" x)) (not (str.prefixof """>" z)) (= (str.at z 22) "t")))
(assert (not (= (str.at y 29) "7")))
(assert (not (= (str.at z 1) ">")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z\u{c4}\u{d6}\u{dc}\-]+(\s*[A-Za-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}.-]+)*$"))) (not (str.prefixof "<A" y))))
(assert (not (str.suffixof ">XSS</A>" x)))
(check-sat)
