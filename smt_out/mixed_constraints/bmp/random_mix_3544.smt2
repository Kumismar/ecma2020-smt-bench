; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><progress ondrop=alert(1) contenteditable>drop here</progress>") (= x "<rt onfocusout=alert(1) tabindex=1 id=x></rt><input autofocus>") (= x "<sup onmousedown=""alert(1)"">test</sup>")))
(assert (or (= z ">") (= z "ansitionend=alert(1)></dd>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y " onf")) (not (str.contains y "gable=""t")) (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z\s .'-]+"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[-!#$%&'*+\/0-9=?A-Z^_a-z`{|}~](\.?[-!#$%&'*+\/0-9=?A-Z^_a-z`{|}~])*@[a-zA-Z0-9](-*\.?[a-zA-Z0-9])*\.[a-zA-Z](-?[a-zA-Z0-9])+$"))))
(assert (or (= "<sup onmous=""alert(1)"">test</sup>" (str.replace x "edown" "")) (str.contains (str.replace z "ler" "") "nd=at(") (str.in_re y ((_ re.from_regex ecma2020) "(.){3,}"))))
(assert (or (not (= (str.at y 35) "l")) (= "<rt onfocusout=alert(1) tabindex=1 id=x></rt><inputalert(1)tofocus>>" (str.replace y " au" "alert(1)"))))
(assert (= "(1) tabi" (str.substr y 20 8)))
(assert (or (not (= (str.at y 50) "t")) (not (str.suffixof ")></dd>" z))))
(check-sat)
