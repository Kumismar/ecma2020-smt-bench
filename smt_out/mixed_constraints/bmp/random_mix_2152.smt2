; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd onmouseover=""alert(1)"">test</kbd>") (= x "<basefont onfoc\u{10348}usout=alert(1) \u{1f600}tabindex=1 id=x></basefont><input autofocus>")))
(assert (or (= z "XSS STYLE="";behavior: url(http://ha.ckers.org/xss.htc);"";>;") (= z "de */") (= z " onanimationstart=""alert(1)""></strong>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len x) 73)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]{4,15}$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9-+\s()]{8,16}$"))) (str.contains y "m=""test"" f")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "\+(9[976]\d|8[987530]\d|6[987]\d|5[90]\d|42\d|3[875]\d|2[98654321]\d|9[8543210]|8[6421]|6[6543210]|5[87654321]|4[987654310]|3[9643210]|2[70]|7|1|)\d{1,4}-\d{1,18}$"))))
(assert (= "://ha.cker" (str.substr y 68 10)))
(assert (not (= (str.indexof z " *" 0) 2)))
(assert (or (= "<basefont onfoc\u{10348}usout=alert(1) \u{1f600}tabindex=1 id=x>efont><input autofocus>XSS STYLE="";behavior: url(http://ha.ckers.org/xss.htc);"";>;" (str.replace y "</bas" "")) (not (= "nanimat" (str.substr z 2 7)))))
(assert (or (= (str.indexof x "f" 0) 5) (str.prefixof "<kbd on" x) (not (= (str.indexof z "/" 0) 2))))
(check-sat)
