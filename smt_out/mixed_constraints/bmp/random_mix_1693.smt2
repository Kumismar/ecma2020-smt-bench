; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid id=x tabindex=1 onactivate=alert(1)></nextid>") (= x "<canvas oncut=""alert(1)"" contenteditable>test</canvas>")))
(assert (or (= z "t</dfn>") (= z ":document.vulnera\u{10348}ble=true\u{20000};"">") (= z "erable=true;</script>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 27) "c")))
(assert (not (= "lert(1)"" " (str.substr y 16 9))))
(assert (= " tabi" (str.substr y 12 5)))
(assert (or (= (str.at z 28) """") (>= (str.len z) 12) (not (= "<sup onmouseout=""alert)"">test</sup>1"">test</a>" (str.replace y "(1" "")))))
(assert (not (str.suffixof "\u{20000};"">" y)))
(assert (or (not (str.prefixof "t</dfn" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9a-zA-Z_ -]{1,20}")))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^\+?\d{7,15}$")))
(assert (not (<= (str.len z) 8)))
(check-sat)
