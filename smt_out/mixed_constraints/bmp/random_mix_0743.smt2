; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onbeforecopy=alert(1) value=""XSS"" autofocus>") (= x "<style>:target {color:red;}</style><title id=x style=""transition:color 1s"" ontransitionend=alert(1)></title>") (= x "<dt ondblclick=""alert(1)"">test</dt>")))
(assert (or (= z "source src=""validaudio.wav"" type=""audio/wav""></audio>") (= z "abindex=1 id=x></span><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 44) "=")) (not (= "o>" (str.substr z 51 7))) (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*[A-Za-z0-9])[A-Za-z0-9\s]*")))))
(assert (not (str.contains x ")></nextid")))
(assert (or (not (= "ab<b>ex=1 id=x></span><input autofocus>" (str.replace z "ind" "<b>"))) (not (>= (str.len y) 81))))
(assert (or (not (str.contains x "opy=aler")) (str.contains (str.replace z " i" "alert(1)") "ex=1alert(1)d=")))
(assert (= (str.at y 47) "c"))
(assert (or (= (str.at x 0) "<") (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z\s]+)$")))))
(assert (or (not (= " 1s"" ontra" (str.substr x 70 10))) (str.suffixof "t</dt>" x)))
(assert (or (not (>= (str.len x) 32)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{3}\s?[0-9]{2}$")))))
(check-sat)
