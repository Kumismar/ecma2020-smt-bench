; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><noscript ondrop=alert(1) contenteditable>drop here</noscript>") (= x "<embed onmouseenter=""alert(1)"">test</embed>")))
(assert (or (= z "able>test</h1>") (= z "r=""alert(1)"">test</meter>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 3) "e")))
(assert (= (str.len y) 57))
(assert (not (str.contains (str.replace x "r=""a" "<b>") "te<b>lert")))
(assert (or (not (str.suffixof "/embed>" x)) (str.in_re z ((_ re.from_regex ecma2020) "^(\+91[\-\s]?)?[0]?(91)?[789]\d{9}$"))))
(assert (or (not (= (str.indexof z "able>" 0) 0)) (not (= (str.at y 35) "l"))))
(assert (or (= (str.at z 0) "a") (str.contains x "d onmo") (str.suffixof "test</h1>" y)))
(check-sat)
