; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb id=x tabindex=1 onfocus=alert(1)></rb>") (= x "<base onmouseover=""alert(1)"">test</base>") (= x "<style>@keyframes x{}</style><template style=""animation-name:x"" onanimationend=""alert(1)""></template>")))
(assert (or (= z ">") (= z ">te\u{1f600}st\u{1d400}</rp>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "template>>" y)))
(assert (or (= " " (str.replace z ">" " ")) (str.prefixof ">te\u{1f600}st\u{1d400}<" z)))
(assert (= "&lt;META HTTPxV=\""refresh\"" CONTENT=\""0; URL=http&#58;//;URL=javascript&#058;alert('XSS');\""test</rt>" (str.replace y "-EQUI" "x")))
(assert (or (= (str.at y 40) ">") (not (<= (str.len z) 59)) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9,. ]*$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9])(?=.*?[#?!@$%^&*-]).{8,}$")) (not (<= (str.len x) 52))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "achetez"))))
(check-sat)
