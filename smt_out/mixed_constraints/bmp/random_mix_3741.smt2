; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound onkeyup=""alert(1)"" contenteditable>test</bgsound>") (= x "<;SCRIPT SRC="";http://ha.ckers.org/xss.jpg"";>;<;/SCRIPT>;")))
(assert (or (= z ">") (= z """>test</blink>") (= z " onerror=""javascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-z. \u{e1}\u{c1}\u{e9}\u{c9}\u{f3}\u{d3}\u{f6}\u{d6}\u{151}\u{150}\u{fa}\u{da}\u{fc}\u{dc}\u{171}\u{170}]){3,}$"))) (= (str.indexof z ">" 0) 0) (not (= (str.indexof x "t" 0) 22))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(\d{10})$"))))
(assert (or (not (str.contains x "l onload")) (not (= (str.at x 32) "r"))))
(assert (>= (str.len x) 53))
(assert (or (not (= (str.len y) 88)) (not (= "/SCRIPT>; " (str.substr y 48 10)))))
(assert (not (str.suffixof "CRIPT>;" x)))
(check-sat)
