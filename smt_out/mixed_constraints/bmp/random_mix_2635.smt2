; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area onmousemove=""alert(1)"">test</area>") (= x "<img src=1 href=1 onerror=""javascript:alert(1)""></img>")))
(assert (or (= z "/www.google.com/"";>;XSS<;/A>;") (= z "eout=""alert(1)"">test</ul>") (= z "ig>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len x) 48) (= (str.len z) 25) (not (= "<area onxousemove=""alert(1)"">test</area>/www.google.com/"";>;XSS<;/A>;" (str.replace y "m" "x")))))
(assert (str.suffixof "s>" z))
(assert (or (= "1)"">test" (str.substr y 23 8)) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9-_.,/ ]*$")) (not (str.in_re y ((_ re.from_regex ecma2020) "^((8|\+3)[\- ]?)?(\(?\d{3}\)?[\- ]?)?[\d\- ]{3,10}$")))))
(assert (or (not (str.prefixof "<area onm" y)) (not (str.contains x "<\u{10348}he"))))
(assert (or (= (str.at y 47) ">") (not (str.contains (str.replace z "ig" "") ">"))))
(assert (not (= (str.indexof z "itab" 0) 4)))
(assert (str.suffixof "></img>ig>" y))
(check-sat)
