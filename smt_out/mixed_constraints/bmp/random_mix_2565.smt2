; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<A HREF=""http://66.102.7.147/"">XSS</A>") (= x "<div style=""background:url(test5.svg)"">PRESS ENTER</div>//[""'`-->]]>]</div>")))
(assert (or (= z "oot draggable=""true"" ondragenter=""alert(1)"">test</tfoot>") (= z "s"" ontransitioncancel=alert(1)></menuitem>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "([Gg][Ii][Rr] 0[Aa]{2})|((([A-Za-z][0-9]{1,2})|(([A-Za-z][A-Ha-hJ-Yj-y][0-9]{1,2})|(([A-Za-z][0-9][A-Za-z])|([A-Za-z][A-Ha-hJ-Yj-y][0-9]?[A-Za-z]))))\s?[0-9][A-Za-z]{2})"))) (= (str.indexof z "t<" 0) 47)))
(assert (or (= (str.indexof x "S</A" 0) 33) (not (= (str.at z 39) "(")) (str.prefixof "<div" y)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^a+\d{8}$")) (not (= "//[""'`-" (str.substr x 56 7))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9-&()\[\],. ]{1,150}$")))))
(assert (or (not (= "tfoot>" (str.substr z 50 7))) (= """ on" (str.substr z 1 4)) (str.prefixof "<div s" y)))
(assert (= (str.indexof y "1" 0) 19))
(check-sat)
