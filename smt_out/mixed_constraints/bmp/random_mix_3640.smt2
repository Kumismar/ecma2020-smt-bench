; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><progress id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></progress>") (= x "<style>:target {transform: rotate(180deg);}</style><cite id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></cite>") (= x "1script3document.vulnerable=true;1/script3")))
(assert (or (= z " onmouseout=""alert(1)"">test</u>") (= z "nfocus=alert(1)></p>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "t(1)" 0) 11)) (not (= "tra" (str.substr y 84 3))) (not (<= (str.len z) 50))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z\d\-_\.]+@[a-zA-Z\d\.\-]+\.[a-zA-Z]{2,6}$")))
(assert (str.contains (str.replace x "scri" "<b>") "1<b>p"))
(assert (or (not (str.prefixof " " z)) (not (str.prefixof "<font id=x" y))))
(assert (not (str.suffixof "3" x)))
(check-sat)
