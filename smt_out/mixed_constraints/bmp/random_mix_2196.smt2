; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><p ondrop=alert(1) contenteditable>drop here</p>") (= x "<main onpaste=""alert(1)"" contenteditable>test</main>")))
(assert (or (= z "1)"">test</p>") (= z "est</hgroup>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len y) 109))
(assert (or (not (= "ble>dr" (str.substr y 34 6))) (str.suffixof "/hgroup>" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9\s,]+"))) (str.suffixof "t</main>" x)))
(assert (= "t</p>" (str.substr y 106 8)))
(assert (str.contains (str.replace z "st</p" "<b>") ")"">te<b>>"))
(assert (or (not (str.contains x "drop=ale")) (not (= "<m<b>in onpaste=""alert(1)"" contenteditable>test</main>" (str.replace x "a" "<b>")))))
(assert (or (str.contains x "(1) cont") (not (= (str.at y 62) "p"))))
(assert (str.contains x "rag me</d"))
(assert (= "est<" (str.substr y 57 4)))
(check-sat)
