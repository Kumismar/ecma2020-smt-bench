; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark onmouseout=""alert(1)"">test</mark>") (= x "<svg><h1 onload=alert(1)></h1>")))
(assert (or (= z "OAD=javascript:javascript:alert(1)>") (= z "te\u{1d400}st<\u{20000}/center>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "(1)>" 0) 21))
(assert (or (not (str.suffixof "(1)>" z)) (= (str.at x 5) " ")))
(assert (or (not (str.contains z "AD=j")) (not (= (str.at x 11) "l")) (not (= "rt(1)" (str.substr y 68 5)))))
(assert (not (str.contains x "1)"">test")))
(assert (or (not (= "<svg><h1 onload=alert(1)>h1>OAD=javascript:javascript:alert(1)>" (str.replace y "</" ""))) (= "MG SRC=&" (str.substr x 5 8))))
(assert (or (not (str.suffixof "<\u{20000}/center>" z)) (not (str.suffixof "ert(1)>" y)) (not (= (str.indexof z "te\u{1d400}s" 0) 0))))
(assert (<= (str.len z) 2))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z_-]{2,}$"))))
(check-sat)
