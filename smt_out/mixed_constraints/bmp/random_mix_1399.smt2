; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><sup id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></sup>") (= x "<style>@keyframes x{}</style><legend style=""animation-name:x"" onanimationend=""alert(1)""></legend>")))
(assert (or (= z "xtmenu=""alert(1)"">test</td>") (= z "0%"" onmouseover=""prompt(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "nd>" x)) (not (str.prefixof "<me" y))))
(assert (or (not (= (str.len y) 124)) (= (str.at x 27) """") (= "nsi" (str.substr y 56 3))))
(assert (or (str.prefixof "<st" y) (not (= (str.len y) 137)) (>= (str.len z) 25)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z ]*$"))) (str.contains z "r=""prompt(") (not (str.in_re y ((_ re.from_regex ecma2020) "^(0?[1-9]|[12][0-9]|3[01])[\/](0?[1-9]|1[012])[\/]\d{4}\s([0-1]?[0-9]|2[0-3]):[0-5][0-9]$")))))
(assert (not (= (str.indexof x "p i" 0) 39)))
(assert (or (str.suffixof "/a>" z) (not (str.suffixof "t</td>" y))))
(check-sat)
