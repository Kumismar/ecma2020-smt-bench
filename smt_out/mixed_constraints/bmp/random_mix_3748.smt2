; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe src=mhtml:http://html5sec.org/test.gif!xss.html></iframe>//[""'`-->]]>]</div>") (= x "<rb oncopy=""alert(1)"" contenteditable>test</rb>")))
(assert (or (= z " draggable=""true"" contenteditable>drag me</div><object ondrop=alert(1) contenteditable>drop here</object>") (= z "here</slot>") (= z "1)"">test</isindex>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\(?(?!1|800|833|844|855|866|877|888)\d{3}\)?(-?|\s?)\d{3}(-|\s|\s-\s)?\d{4}$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^(17)$")))))
(assert (str.contains (str.replace y "=a" "javascript:") "ljavascript:l"))
(assert (or (not (>= (str.len y) 87)) (str.contains (str.replace x ")"" co" "x") "t(1xn")))
(assert (not (str.prefixof "<rb on" y)))
(assert (str.contains (str.replace x "l5" """") "//htm""s"))
(assert (or (not (= (str.at x 27) "m")) (not (<= (str.len y) 159))))
(check-sat)
