; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><abbr ondrop=alert(1) contenteditable>drop here</abbr>") (= x "<span onfocusout=alert(1) tabindex=1 id=x></span><input autofocus>") (= x "<meter onkeydown=""alert(1)"" c\u{1f4a9}ontenteditable>test</mete\u{10348}r>")))
(assert (or (= z "eet"">") (= z "st.gif!xss.html></iframe>//[""'`-->]]>]</div>") (= z "ndex=1 id=x></spacer><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "TP-EQ") (= "focusout" (str.substr x 8 8)) (not (= (str.at y 92) "c"))))
(assert (or (not (= (str.at y 0) "<")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9]([0-9]?)(,[0-9]{1,2})?$")))))
(assert (or (str.suffixof ">" x) (= "<div draggable=""true"" contenteditable>drag me</div><abbr ondrop=alert(1) contenteditable>drop here</abb""" (str.replace x "r>" """")) (str.suffixof "/mete\u{10348}r>" x)))
(assert (or (= "frame" (str.substr y 65 5)) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{5}$"))))
(assert (or (= (str.at x 68) "t") (str.contains z "id=x></sp") (str.in_re x ((_ re.from_regex ecma2020) "^(\([0-9]{2}\) ([0-9]{4}|[0-9]{5})-[0-9]{4})$"))))
(check-sat)
