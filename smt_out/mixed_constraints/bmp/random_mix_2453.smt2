; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<DIV STYLE=""background-image: url(javascript:javascript:alert(1))"">") (= x "<!--") (= x "`-alert(1)"">'onload=""`<svg\u{1f600}/1='")))
(assert (or (= z "le=""true"" ondragstart=""alert(1)"">test</b>") (= z "x tabindex=1 onactivate=alert(1)></tbody>")))
(assert (= y (str.++ x z)))
(assert (or (= "<a href=http:alert(1)foo.bar/#x=`y></a><img alt=""`><img src=x:\u{20000}x onerror=javascript:alert(1)>\u{1f4a9}</a>"">" (str.replace x "//" "alert(1)")) (not (str.prefixof "x" z)) (= (str.at z 12) " ")))
(assert (or (= "vate=aler" (str.substr z 19 9)) (= (str.indexof x "a" 0) 2)))
(assert (or (= "url(j" (str.substr y 30 5)) (str.in_re y ((_ re.from_regex ecma2020) "^[0-9,-]+$"))))
(assert (not (= (str.at x 66) ">")))
(assert (str.suffixof "dy>" y))
(assert (or (not (str.contains y "rt(1))"">le")) (not (str.suffixof "--" x))))
(assert (not (>= (str.len z) 37)))
(assert (not (= (str.at x 4) " ")))
(assert (or (str.prefixof "<!" x) (str.suffixof "t</b>" y)))
(check-sat)
