; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#60") (= x "'); alert('xss'); var x='")))
(assert (or (= z "me</div><b ondragover=alert(1) contenteditable>drop here</b>") (= z "enteditable>test</rp>") (= z ">test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len x) 12) (= "<b>#60" (str.replace x "&" "<b>")) (str.prefixof "&#60m" y)))
(assert (or (not (str.prefixof "'); alert" x)) (not (str.prefixof "me</div" z)) (not (str.suffixof "</rp>" z))))
(assert (str.suffixof "); var x='" x))
(assert (or (= "'); aleralert(1)s'); var x='" (str.replace x "t('xs" "alert(1)")) (not (= (str.len z) 17)) (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]+[a-zA-Z -]*"))))
(assert (= (str.at z 43) "b"))
(assert (not (= "tes" (str.substr x 47 3))))
(check-sat)
