; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track onblur=alert(1\u{1f4a9}) tabindex=1 id=x></track><\u{1d400}input autofocus>") (= x "<col draggable=""true"" ondrag=""alert(1)"">test</col>")))
(assert (or (= z "ge.png""><img onloadstart=alert(1)></picture>") (= z "=""alert(1)"">test</article>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "><" " ") "g"" i") (str.contains x "er=""a") (str.prefixof "<col" y)))
(assert (not (= "le>" (str.substr y 73 8))))
(assert (or (= (str.indexof y "np" 0) 51) (str.in_re z ((_ re.from_regex ecma2020) "^\d{1,7}-\d{2}-\d$"))))
(assert (or (not (= "i" (str.substr x 50 1))) (not (= (str.indexof z "/big>" 0) 0)) (not (str.contains x """>test</co"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "(?:((?:0[1-9]|1[0-9]|2[0-9])\/(?:0[1-9]|1[0-2])|(?:30)\/(?!02)(?:0[1-9]|1[0-2])|31\/(?:0[13578]|1[02]))\/(?:19|20)[0-9]{2})"))))
(assert (or (not (str.contains (str.replace z """" " ") "= al")) (not (= (str.at x 19) "a"))))
(assert (not (= "/style><as" (str.substr y 28 10))))
(check-sat)
