; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong id=x tabindex=1 ondeactivate=alert(1)></strong><input id=y autofocus>") (= x "<font oncut=""alert(1)"" contenteditable>test</font>")))
(assert (or (= z "eup=""alert(1)"">test</wbr>") (= z "7%6C%65%2E%63%6F%6D\""&gt;XSS&lt;/A&gt;") (= z "=""alert(1)"" contenteditable>test</multicol>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9_\-!@$&\. ]{1,50}$"))) (= (str.len y) 53)))
(assert (not (= (str.at z 4) ">")))
(assert (or (not (str.contains y "teditable>")) (<= (str.len y) 125)))
(assert (= (str.at y 61) "1"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{1,5}$"))))
(assert (not (= (str.len x) 77)))
(assert (not (= (str.at y 42) "(")))
(check-sat)
