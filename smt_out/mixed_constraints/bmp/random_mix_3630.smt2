; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sCRIpt x="">"" src=//15.rs></script>") (= x "<bgsound onkeyup=""alert(1)"" contenteditable>test</bgsound>")))
(assert (or (= z """a\u{1d400}lert(1)"" contenteditable>test</data>") (= z "></var><input autofocus>") (= z "ter=""alert(1)"">test</shadow>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z " au")) (str.contains x "tabl") (not (str.prefixof "<sCRIpt x" y))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z]*$"))) (= (str.at x 37) "i")))
(assert (or (= "drag" (str.substr x 38 4)) (not (= ".rs></s" (str.substr x 22 7))) (not (>= (str.len z) 23))))
(assert (= (str.indexof z "s" 0) 22))
(assert (or (= "rt(1)"">t" (str.substr y 43 8)) (not (str.prefixof "<s" x)) (str.contains x "></scr")))
(check-sat)
