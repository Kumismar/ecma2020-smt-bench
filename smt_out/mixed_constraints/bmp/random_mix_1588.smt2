; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas id=x tabindex=1 ondeactivate=alert(1)></canvas><input id=y autofocus>") (= x "<style>:target {color: red;}</style><sup id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></sup>") (= x "<input onmouseenter=""alert(1)"">test</input>")))
(assert (or (= z "(1) autofocus><input autofocus>") (= z "t(1\u{20000})"">test\u{20000}</option>") (= z "onmouseenter=""alert(1)"">test</ins>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "onmous" z)) (str.contains x "ter=""aler") (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{1,4}$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9 .()+-]{6,16}$"))) (= (str.indexof x "rget" 0) 10) (= (str.at z 2) "1")))
(assert (= (str.at x 68) "r"))
(assert (or (str.suffixof "3C;->" y) (str.contains x "abin") (not (str.in_re x ((_ re.from_regex ecma2020) "^([1-9]{2}|[0-9][1-9]|[1-9][0-9])[0-9]{3}$")))))
(check-sat)
