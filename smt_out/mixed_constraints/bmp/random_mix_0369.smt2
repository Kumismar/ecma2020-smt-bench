; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<head onblur=alert(1) tabindex=1 id=x></head><input autofocus>") (= x "<figcaption ondblclick=""alert(1)"">test</figcaption>")))
(assert (or (= z " onactivate=alert(1)></xss>") (= z "t(1)"">te\u{10348}st</script>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 53) "u") (not (str.contains x "1 id")) (= "1)></xs" (str.substr z 18 7))))
(assert (not (str.prefixof "y" z)))
(assert (or (= "alert(1" (str.substr x 24 7)) (not (= (str.at y 73) "<"))))
(assert (or (= "y" (str.substr y 3 1)) (not (str.contains y "ption on"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^(\+91[\-\s]?)?[0]?(\+91.[\-\s]?)?[0]?(91)?[6789]\d{9}$")) (not (<= (str.len x) 67)) (str.contains x " onmo")))
(check-sat)
