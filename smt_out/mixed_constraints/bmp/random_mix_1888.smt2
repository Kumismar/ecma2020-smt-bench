; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param oncopy=""alert(1)"" contenteditable>test</param>") (= x "<xmp on\u{1f600}keyup=""alert(1)"" contenteditable>test</\u{1f600}xmp>") (= x "<input onkeydown=""alert(1)"" contenteditable>test</input>")))
(assert (or (= z "/font>") (= z "=""true"" ondragend=""alert(1)"">test</progress>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 46) "/")))
(assert (or (= "on\u{1f600}keyup=""alert(1)"" contenteditable>test</\u{1f600}xmp>" (str.replace x "<xmp " "")) (not (= (str.at z 10) "o")) (str.suffixof "font>" z)))
(assert (or (= (str.indexof y "am o" 0) 4) (= "=""true"" ondragend=""alert""1)"">test</progress>" (str.replace z "(" """"))))
(assert (not (str.contains z "ont")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9a-zA-Z]+[\w\.-]+@[\w\.-]+\.\w{2,}$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{1,}$"))) (= (str.indexof y ")" 0) 22) (not (str.prefixof "e><script" z))))
(assert (or (not (= "nt.c" (str.substr x 58 4))) (= "<input onkeydown=""alert(1)"" contenteditable""test</input>" (str.replace x ">" """"))))
(check-sat)
