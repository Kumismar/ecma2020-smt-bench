; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nobr draggable=""true"" ondragstart=""alert(1)"">test</nobr>") (= x "<style>@keyframes x{}</style><nav style=""animation-name:x"" onanimationend=""alert(1)""></nav>") (= x "<frame onmousedown=""alert(1)"">test</frame>")))
(assert (or (= z "ondragstart=""alert(1)"">test</caption>") (= z "1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "t(")) (not (str.contains (str.replace x "=""tru" "javascript:") "lejavascript:e"""))))
(assert (not (str.suffixof "ion>" z)))
(assert (or (>= (str.len y) 51) (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]{7}"))) (str.prefixof "ond" z)))
(assert (or (= "alert(1)ndragstart=""alert(1)"">test</caption>" (str.replace z "o" "alert(1)")) (str.in_re z ((_ re.from_regex ecma2020) "^[\u{30a1}-\u{30f3}\u{30f4}\u{30fc}]*$"))))
(assert (or (not (= ">" (str.substr y 52 9))) (= (str.len y) 94)))
(assert (str.contains z "start=""ale"))
(assert (str.prefixof "ondragst" z))
(check-sat)
