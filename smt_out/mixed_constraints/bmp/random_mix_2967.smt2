; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img draggable=""true"" ondragstart=""alert(1)"">test</img>") (= x "<style>:target {color: red;}</style><optgroup id=x style=""transition:color 10s"" ontransitioncancel=ale\u{1f4a9}rt(1)></optgroup>") (= x "<;SCRIPT>;a=/XSS/")))
(assert (or (= z "ls onfocusout=alert(1) tabindex=1 id=x></details><input autofocus>") (= z ">") (= z "g>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "sout=" 0) 9)) (= "cusout=a" (str.substr y 62 8))))
(assert (or (not (<= (str.len y) 131)) (str.prefixof "<img dr" y) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{5}$$")))))
(assert (= "PT>;" (str.substr y 6 4)))
(assert (or (<= (str.len z) 4) (not (= (str.indexof z ">" 0) 1))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-])([a-zA-Z0-9_\-\.\+]*)@(\[((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.){3}|((([a-zA-Z0-9\-]+)\.)+))([a-zA-Z]{2,}|(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\])$"))) (= (str.at z 13) "t")))
(assert (= "le><opt" (str.substr y 33 7)))
(assert (or (not (str.prefixof "ls onfocus" z)) (str.in_re x ((_ re.from_regex ecma2020) "^[\w-]+(\.[\w-]+)*@([\w-]+\.)+[a-zA-Z]+$")) (str.prefixof "<sty" x)))
(check-sat)
