; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset onclick=""alert(1)"">test</frameset>") (= x "<output oncontextmenu=""alert(1)"">test</output>") (= x "<optgroup draggable=""true"" ondrag=""alert(1)"">test</optgroup>")))
(assert (or (= z """ ontransitionrun=alert(1)></content>") (= z "test</mete\u{10348}r>") (= z "IPT>a=/XSS/")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "ondr" 0) 27)) (str.contains x "tes") (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6,20}$")))))
(assert (or (not (>= (str.len z) 9)) (= (str.indexof y "oup>" 0) 56) (not (str.contains (str.replace y "ans" "alert(1)") "ntralert(1)ition"))))
(assert (or (>= (str.len z) 10) (str.contains x "/frameset>") (not (str.prefixof "<" x))))
(assert (= (str.indexof y "c" 0) 12))
(check-sat)
