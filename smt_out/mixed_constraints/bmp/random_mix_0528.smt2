; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track onkeydown=""alert(1)"" contenteditable>test</track>") (= x "<fieldset ondblclick=""alert(1)"">test</fieldset>")))
(assert (or (= z ">") (= z "http://www.w3.org/2000/svg"" onload=""alert(document.domain)""/>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "nt" 0) 30)) (not (str.prefixof "<fieldset " y))))
(assert (= (str.len x) 47))
(assert (not (str.suffixof "rack>>" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9\u{251c}\u{a6}\u{251c}\u{2592}\u{251c}\u{107}\u{251c}\u{e6}\u{252c}\u{2551}\u{252c}\u{ac}\u{251c}\u{12a}\u{251c}\u{ae}\u{251c}\u{141}\u{251c}\u{2502}\u{251c}\u{2551}\u{251c}\u{100}\u{251c}\u{a9}\u{251c}\u{bc}\u{251c}\u{2593}\u{251c}\u{2563}\u{251c}\u{fc}\u{251c}\u{113}\u{251c}\u{179}\u{251c}\u{14d}\u{251c}\u{dc}\u{251c}\u{106}\u{251c}\u{142}\u{251c}\u{12b}\u{251c}\u{c6}\u{251c}\u{d6}\u{251c}\u{17c}\u{251c}\u{bd}\u{251c}\u{bb}\u{251c}\u{10c}\u{251c}\u{255d}\u{251c}\u{e4}\u{251c}\u{157}\u{251c}\u{c5}\u{251c}\u{a2}\u{251c}\u{a3} ]+"))) (str.prefixof ":" z) (= (str.indexof z "atio" 0) 18)))
(assert (or (not (>= (str.len y) 104)) (= "<datalist onbeforepaste=""alert(1)"" contenteditable>tes<b>datalist>03c;" (str.replace y "t</" "<b>")) (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-z\u{e4}\u{f6}\u{fc}A-Z\u{c4}\u{d6}\u{dc}\u{df}0-9\-]{0,63})$")))))
(check-sat)
