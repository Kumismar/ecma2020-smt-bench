; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track draggable=""true"" ondragenter=""alert(1)"">test</track>") (= x "<style>:target {color:red;}</style><mark id=x style=""transition:color 1s"" ontransitionend=alert(1)></mark>")))
(assert (or (= z "alert(1)"">test</img>") (= z "ion>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[^\s@]+@[^\s@]+\.[^\s@]+$"))))
(assert (or (not (str.contains (str.replace z "est</" " ") """>t img>")) (= "mg>" (str.substr z 17 3)) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9\s-]{0,9}")))))
(assert (or (not (= "n" (str.substr z 2 1))) (not (<= (str.len z) 11))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^\(?([+]31|0031|0)-?6(\s?|-)([0-9]\s{0,3}){8}$"))))
(assert (not (= (str.at x 41) "h")))
(check-sat)
