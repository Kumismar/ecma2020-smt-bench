; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div style=content:url(%(svg)s)></div>") (= x "&lt;SCRIPT SRC=http://ha.ckers.org/xss.js") (= x "<br onpaste=""alert(1)"" contenteditable>test</br>")))
(assert (or (= z "rue"" ondrag=""alert(1)"">test</shadow>") (= z "draggable=""true"" ondrag=""alert(1)"">test</nextid>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x " tabin")))
(assert (or (not (str.suffixof "extid>" z)) (str.suffixof "extid>" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[^@\s]+@[^@\s]+\.[^@\s]{2,}$"))))
(assert (= "l" (str.substr x 1 1)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+.[w]+$"))) (str.prefixof "<div style" y)))
(assert (or (not (= (str.at y 20) "/")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[^@]+@[^@]+\.[a-zA-Z]{2,3}$")))))
(assert (not (= (str.len z) 36)))
(check-sat)
