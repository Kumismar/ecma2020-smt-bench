; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><summary style=""animation-name:x"" onanimationstart=""alert(1)""></summary>") (= x "<a href=""javascript&colon;\u{5c}u0061&#x6C;&#101%72t&lpar;1&rpar;""><button>")))
(assert (or (= z "s;&gt; out") (= z " onbeforedeactivate=alert(1)></pre><input autofocus>") (= z "a\u{10348}der>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z]+[\s][A-Za-z ]+"))) (not (>= (str.len y) 116)) (= "ut" (str.substr z 8 5))))
(assert (or (not (str.prefixof "a\u{10348}de" z)) (>= (str.len x) 61) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z\u{5c}u00C0-\u{5c}u017F]+(([',. -][a-zA-Z\u{5c}u00C0-\u{5c}u017F])?[a-zA-Z\u{5c}u00C0-\u{5c}u017F]*)*$"))))
(assert (or (str.contains z "ctivate") (not (str.prefixof "<" x))))
(assert (or (not (= "a\u{10348}de" (str.substr y 101 4))) (= (str.at x 6) "d") (not (= "le><summ" (str.substr x 26 8)))))
(assert (or (not (<= (str.len y) 146)) (str.contains x "x{}</st")))
(check-sat)
