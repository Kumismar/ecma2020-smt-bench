; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ScRipT 5-0*3+9\u{10348}/3=>prompt(1)</ScRipT giveanswerhere=?") (= x "<small onmouseleave=""alert(1)"">test</small>")))
(assert (or (= z "e>test</code>") (= z "p onblur=alert(1) tabindex=1 id=x></colgroup><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "p onbl" z)) (str.prefixof "p onblur=" z) (str.contains z "ess=""alert")))
(assert (not (str.suffixof "e=?" x)))
(assert (or (str.contains x "l onmouseo") (not (str.contains y "lert(1)")) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\-\+]{11,15}$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(?:http(s)?:\/\/)?[\w.-]+(?:\.[\w\.-]+)+[\w\-\._~:/?#[\]@!\$&'\(\)\*\+,;=.]+$"))) (not (str.contains (str.replace y "n" "") "tml omo"))))
(assert (or (str.suffixof "rhere=?" x) (str.suffixof "tofocus>" z)))
(check-sat)
