; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><span onload=alert(1)></span>") (= x "/*iframe/src*/<iframe/src=""<iframe/src=@""/onload=prompt(1) /*iframe/src*/>") (= x "<command onbeforepaste=""alert(1)"" contenteditable>test</command>")))
(assert (or (= z """;>;XSS<;/A>;") (= z "t onblur=alert(1) tabindex=1 id=x></dt><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "epas" 0) 16)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{20,25}$")))))
(assert (or (not (= (str.len x) 74)) (>= (str.len x) 58)))
(assert (= (str.indexof y "r" 0) 15))
(assert (or (= (str.at x 11) "o") (str.contains (str.replace z "A" "") ";/>;") (not (str.contains (str.replace x "a" "") "Fjvasc"))))
(assert (not (= "<hgroup on<b>useup=""alert(1)"">test</hgroup>est</sup>" (str.replace y "mo" "<b>"))))
(assert (or (not (= (str.indexof y "au" 0) 120)) (str.prefixof "<in" x) (not (str.prefixof "<rp" y))))
(assert (or (str.contains z "=1 id=") (str.contains y "oa")))
(assert (= (str.at z 28) " "))
(check-sat)
