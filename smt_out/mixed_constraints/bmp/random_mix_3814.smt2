(assert (= (str.len y) 105))
(assert (or (not (= "&#x0javascript:est</rp>" (str.replace y "3ct" "javascript:"))) (str.suffixof "t</ins>" x)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9@]+$"))))
