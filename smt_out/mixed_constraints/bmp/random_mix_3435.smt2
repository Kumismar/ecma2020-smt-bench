; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "!--"" /><script>alert('xss');</script>") (= x "<basefont id=x tabindex=1 ondeactivate=alert(1)></basefont><input id=y autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><nobr ondragover=alert(1) contenteditable>drop here</nobr>")))
(assert (or (= z "ert(1)"">test</strong>") (= z ">") (= z "ntextmenu=""alert(1)"">test</blockquote>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "t>al" 0) 13)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[_A-Za-z0-9-\+]+(\.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(\.[A-Za-z0-9]+)*(\.[A-Za-z]{2,})$")))))
(assert (or (not (str.suffixof "tofocus>" x)) (not (str.prefixof """`'" x)) (= "cript>al" (str.substr y 9 8))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{5d0}-\u{5ea}_-].{2,50}$")))
(assert (or (= (str.indexof x "ler" 0) 69) (= ">" (str.substr z 0 7)) (= (str.indexof y "--"" " 0) 1)))
(assert (= (str.at z 0) ">"))
(check-sat)
