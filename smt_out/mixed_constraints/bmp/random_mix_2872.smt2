; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<content id=x tabindex=1 onfocus=alert(1)></content>") (= x "<acronym onkeydown=""alert(1)"" contenteditable>test</acronym>") (= x "<wbr onbeforepaste=""alert(1)"" contenteditable>test</wbr>")))
(assert (or (= z "img src=x onerror=javascript:alert(A)>") (= z " id=x tabindex=1 onactivate=alert(1)></s>") (= z "ronym draggable=""tr\u{1d400}ue"" ondrag=""alert(1)"">test</acronym>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "x=1 o"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z]{1,5}"))) (str.in_re x ((_ re.from_regex ecma2020) "^[^@]+@[^@]+\.[a-zA-Z]{2,}$")) (= "<wbr onbeforepaste=""alert(1)"" contealert(1)itable>test</wbr>ronym draggable=""tr\u{1d400}ue"" ondrag=""alert(1)"">test</acronym>" (str.replace y "nted" "alert(1)"))))
(assert (or (<= (str.len y) 95) (= (str.len z) 41)))
(assert (or (str.contains (str.replace y "1)"" " "") "ert(cont") (not (str.prefixof "index=1" z))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]{4,}|\+?(38|8)?0(39|50|63|66|67|68|73|91|92|93|94|95|96|97|98|99)[0-9]{7}$"))) (not (>= (str.len z) 50))))
(check-sat)
