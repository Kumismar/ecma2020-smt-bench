; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object onkeypress=""alert(1)"" contenteditable>test</object>") (= x "<plaintext oncontextmenu=""alert(1)"">test</plaintext>") (= x "<marquee onmouseover=""alert(1)"">test</marquee>")))
(assert (or (= z "lert(1)""></select>") (= z "t(1) contenteditable>drop here</cite>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 77) " "))
(assert (or (str.suffixof "</select>" y) (not (>= (str.len x) 93)) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?!info@|help@|sales@).*")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z ]{3,}"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.]{6,20}$"))))
(assert (or (= (str.indexof z "1)"">t" 0) 4) (str.contains (str.replace z "e" """") "ont""ntedi")))
(check-sat)
