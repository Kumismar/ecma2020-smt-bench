; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img id=x tabindex=1 onbeforeactivate=alert(1)></img>") (= x "<style>:target {color: red;}</style><basefont id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></basefont>") (= x "<isindex onfocusout=alert(1) tabindex=1 id=x></isindex><input autofocus>")))
(assert (or (= z "e=""transition:color 10s"" ontransitioncancel=alert(1)></code>") (= z " ondrag=""alert(1)"">test</wbr>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "ocus>" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([0-9,a-z,A-Z]+)([.,_,-]([0-9,a-z,A-Z]+))*[@]([0-9,a-z,A-Z]+)([.,_,-]([0-9,a-z,A-Z]+))*[.]([0-9,a-z,A-Z]){2,5}?$"))) (str.contains z "tio")))
(assert (or (not (= (str.at y 6) "1")) (str.prefixof "e=""transit" z) (str.contains (str.replace x "e=" " ") "vat a")))
(assert (or (str.prefixof "<style>:ta" x) (= (str.indexof y ":targ" 0) 7)))
(check-sat)
