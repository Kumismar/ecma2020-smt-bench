; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element onmouseleave=""alert(1)"">test</element>") (= x "<?xml version=""1.0"" encoding=""ISO-8859-1""?><!DOCTYPE foo [<!ELEMENT foo ANY><!ENTITY xxe SYSTEM ""file:///etc/shadow"">]><foo>&xee;</foo>")))
(assert (or (= z "k onbeforecut=""alert(1)"" contenteditable>test</link>") (= z "lclick=""alert(1)"">test</a>") (= z "color:red;}</style><hr id=x style=""transition:color 1s"" ontransitionend=ale\u{10348}rt(1)></hr>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 3) "r")) (not (= (str.indexof y "t" 0) 7)) (not (= (str.at x 34) "e"))))
(assert (str.suffixof "t>" x))
(assert (= (str.indexof z "cli" 0) 1))
(assert (or (= "<element onmouselea<b>lert(1)"">test</element>" (str.replace x "ve=""a" "<b>")) (not (str.in_re y ((_ re.from_regex ecma2020) "\S+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$")))))
(assert (or (str.contains x "nerror=") (not (str.contains y "ut=""a")) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9]).{14,128}$")))))
(assert (not (str.prefixof "<a " y)))
(assert (= (str.indexof y "t(1" 0) 27))
(check-sat)
