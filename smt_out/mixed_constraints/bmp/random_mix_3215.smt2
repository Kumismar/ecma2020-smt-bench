; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<audio autoplay onplaying=alert(1)><source src=""validaudio.wav"" type=""audio/wav""></audio>") (= x "<rt id=x ta\u{1f4a9}bindex=1 onfo\u{1f600}cus=alert(1)></rt>")))
(assert (or (= z "1)"">test</image>") (= z "own=alert(1\u{20000})>click this!") (= z "ert(String.fromCharCode(88,83,83))<;/SCRIPT>;")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 21) ">")) (str.in_re y ((_ re.from_regex ecma2020) "^[+]*[0-9]{1,4}[0-9]{11}$")) (not (str.prefixof "<" x))))
(assert (or (= (str.indexof x "rt(1)" 0) 29) (str.in_re y ((_ re.from_regex ecma2020) "^L[0-9]{2}P[0-9]{4}$")) (not (str.suffixof "k this!" y))))
(assert (not (= (str.at z 10) ".")))
(assert (= "<rt id=x ta\u{1f4a9}bindex=1alert(1)o\u{1f600}cus=alert(1)></rt>own=alert(1\u{20000})>click this!" (str.replace y " onf" "alert(1)")))
(check-sat)
