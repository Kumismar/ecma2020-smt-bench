; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image oncontextmenu=""alert(1)"">test</image>") (= x "<div style=""font-family:foo}color=red;"">XXX")))
(assert (or (= z "eyup=""alert(1)"" contenteditable>test</var>") (= z "eover=""alert(1)"">test</noscript>") (= z "x></b\u{1f600}lockquote><in\u{10348}put autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "t</v" (str.substr z 35 4))) (str.suffixof "(a+b+c+d);" y)))
(assert (or (not (= (str.indexof y "enu=""" 0) 17)) (not (str.contains (str.replace x "le=" "javascript:") " styjavascript:""fo"))))
(assert (= "<div style=xfont-family:foo}color=red;"">XXX" (str.replace x """" "x")))
(assert (not (str.contains x " s")))
(assert (= (str.indexof x """ale" 0) 21))
(assert (or (not (str.contains x "iv s")) (= "t(" (str.substr z 0 2))))
(assert (or (not (str.prefixof "<image on" x)) (not (str.suffixof "ed;"">XXX" x)) (not (str.contains x "le=""f"))))
(assert (or (str.suffixof "t</var>" y) (str.prefixof "<d" x) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{5,5}$")))))
(check-sat)
