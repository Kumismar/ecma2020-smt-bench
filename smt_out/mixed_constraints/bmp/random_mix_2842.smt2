; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i onmouseup=""alert(1)"">test</i>") (= x "<frame onpaste=""alert(1)"" contenteditable>test</frame>") (= x "<div draggable=""true"" contenteditable>drag me</div><frameset ondrop=alert(1) contenteditable>drop here</frameset>")))
(assert (or (= z "ag me</div><slot ondrop=alert(1) contenteditable>drop here</slot>") (= z ":100%;height:100%""  onmouseover=""prompt(1)"" onclick=""alert(1)"">x</button>?") (= z " ondragleave=""alert(1)"">test</tbody>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "ame>" x))
(assert (or (not (str.suffixof "ton>?" y)) (not (= (str.indexof x "tedi" 0) 28)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\x20-\x7e\x80-\xff]*$")))))
(assert (or (str.prefixof "<div " y) (not (str.contains y "&#\u{1f600}x3\u{20000}c;")) (str.contains (str.replace z "t</" "") ">testb")))
(assert (or (str.contains z " ondragle") (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[A-Za-z])(?=.*\d)(?=.*[$@$!%*#?&])[A-Za-z\d$@$!%*#?&]{8,}$")))))
(assert (= (str.indexof y "c" 0) 22))
(assert (not (= (str.len y) 93)))
(assert (not (= "e" (str.substr z 37 1))))
(assert (not (= "e>drop " (str.substr y 79 7))))
(assert (not (str.contains z "r=""pro")))
(check-sat)
