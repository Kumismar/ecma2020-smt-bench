; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<big ondblclick=""alert(1)"">test</big>") (= x "<frame onpaste=""alert(1)"" contenteditable>test</frame>")))
(assert (or (= z "ame>") (= z "aggable=""true"" ondragenter=""alert(1)"">test</b>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<big o" x) (not (= (str.indexof x ">" 0) 27))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9a-zA-Z-\u{c1}\u{c0}\u{c2}\u{c4}\u{c9}\u{c8}\u{ca}\u{cb}\u{cd}\u{cc}\u{ce}\u{cf}\u{d3}\u{d2}\u{d4}\u{d6}\u{da}\u{d9}\u{db}\u{dc}\u{e1}\u{e0}\u{e2}\u{e4}\u{e9}\u{e8}\u{ea}\u{eb}\u{ed}\u{ec}\u{ee}\u{ef}\u{f3}\u{f2}\u{f4}\u{f6}\u{fa}\u{f9}\u{fb}\u{fc}\u{c7}'\u{e7},.\u{20ac}\u{a3}$_ \.]{2,100}$"))) (not (str.contains y " th")) (not (= (str.indexof x "me o" 0) 4))))
(assert (or (not (= (str.at y 32) "/")) (not (<= (str.len y) 119)) (str.prefixof "*/" x)))
(assert (or (= (str.at z 6) "e") (not (str.contains z "me")) (not (str.suffixof ">" z))))
(check-sat)
