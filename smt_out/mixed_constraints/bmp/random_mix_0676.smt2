; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><h1 ondrop=alert(1) contenteditable>drop here</h1>") (= x "<template onbeforecopy=""alert(1)"" contenteditable>test</template>") (= x "<thead onclick=""alert(1)"">test</thead>")))
(assert (or (= z "le>test</html>") (= z "tmenu=""alert(1)"">test</marquee>") (= z "cus=alert(1)></kbd>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "di" 0) 1))
(assert (or (= (str.indexof x "c" 0) 18) (not (str.contains z "/mark>"))))
(assert (or (not (str.prefixof "cus=al" z)) (not (str.prefixof "tm" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "(01|02|03|04|05|06|07|08|09)[ \.\-]?[0-9]{2}[ \.\-]?[0-9]{2}[ \.\-]?[0-9]{2}[ \.\-]?[0-9]{2}")))))
(assert (not (= "eforeco" (str.substr y 13 7))))
(assert (or (not (>= (str.len y) 87)) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{5,5}$"))) (not (str.contains (str.replace z ">t" "x") "lexest</"))))
(assert (or (str.prefixof "c" z) (not (<= (str.len x) 107)) (not (= (str.at x 33) " "))))
(assert (or (= (str.indexof y "ncl" 0) 8) (not (str.suffixof "st</html>" z))))
(check-sat)
