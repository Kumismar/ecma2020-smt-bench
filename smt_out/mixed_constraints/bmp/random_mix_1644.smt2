; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<OBJECT CLASSID=""clsid:333C7BC4-460F-11D0-BC04-0080C7055A83""><PARAM NAME=""DataURL"" VALUE=""javascript:alert(1)""></OBJECT>") (= x "<frameset onkeydown=""alert(1)"" contenteditable>test</frameset>") (= x "<col oncopy=""alert(1)"" contenteditable>tes\u{1d400}t</col>\u{1f600}")))
(assert (or (= z "nXxx=1") (= z "y(a)"" to=""//example.com/?a"" />")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "le>te" 0) 36) (not (str.prefixof "<ST" y))))
(assert (or (str.contains z "Xxx=") (not (= (str.indexof z "t" 0) 4)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(\d{2,3})$")))))
(assert (or (= (str.at z 1) "X") (not (= (str.len z) 41)) (not (str.suffixof "></a>" x))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^((8|\+7)[\- ]?)?(\(?\d{3}\)?[\- ]?)?[\d\- ]{10}$"))) (str.prefixof "<" x)))
(check-sat)
