; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><table id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></table>") (= x "<meter draggable=""true"" ondragend=""alert(1)"">test</meter>")))
(assert (or (= z "ange>") (= z " tabindex=1 onbeforeactivate=alert(1)></rb>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace x "see" """") "ou""nter")))
(assert (not (= (str.indexof y "1" 0) 24)))
(assert (or (= "end=""aler" (str.substr y 30 9)) (= (str.indexof y "yle><" 0) 47)))
(assert (= "e=""true"" o" (str.substr y 15 10)))
(assert (or (not (= (str.at y 52) "e")) (not (= "ang<b>" (str.replace z "e>" "<b>")))))
(assert (or (str.suffixof "focus>" x) (not (<= (str.len z) 43)) (not (= (str.at x 15) "e"))))
(assert (not (str.contains x "><")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[0-9.]{6,9}([0-9A-Z]{0,3})$")) (str.suffixof "t(1)></rb>" y)))
(assert (str.contains z "ert(1)></r"))
(check-sat)
