; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp onmouseover=""alert(1)"">test</xmp>") (= x "<header onmouseout=""alert(1)"">test</header>") (= x "&#x000003c;")))
(assert (or (= z "ex=1 ondeactivate=alert(1)></li><input id=y autofocus>") (= z "a:,alert()>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<script" x)) (str.in_re y ((_ re.from_regex ecma2020) "^(\d{1,2})$"))))
(assert (or (not (= "(1)"">test<" (str.substr y 25 10))) (str.in_re x ((_ re.from_regex ecma2020) "^\+?[1-9]\d{1,14}$")) (not (str.suffixof "lert()>" y))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "\b[\w\.-]+@((?!gmail|yahoo|outlook|aol|mail|protonmail|icloud|gmx|yandex).)[\w\.-]+\.\w{2,4}\b"))) (str.suffixof "alert()>" y)))
(assert (not (= (str.at x 36) "p")))
(assert (= (str.indexof x " o" 0) 7))
(check-sat)
