; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed onpaste=""alert(1)"" contenteditable>test</embed>") (= x "<IMG SRC=x onunload=""alert(String.fromCharCode(88,83,83))"">") (= x "<aside onkeydown=""alert(1)"" contenteditable>test</aside>")))
(assert (or (= z " draggable=""true"" ondragenter=""alert(1)"">test</bgsound>") (= z "ot; AllowScriptAccess=&quot;always&quot;&gt;&lt;/EMBED&gt;") (= z "ut:blank"" onerror=javascript:alert(1)//></style>")))
(assert (= y (str.++ x z)))
(assert (= (str.at z 47) ";"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+-]+@(?!gmail.com)(?!yahoo.com)(?!hotmail.com)(?!yahoo.co.in)(?!aol.com)(?!live.com)(?!outlook.com)[a-zA-Z0-9_-]+.[a-zA-Z0-9-.]{2,61}$"))) (not (str.prefixof "<e" y)) (not (str.suffixof "/EMBED&gt;" y))))
(assert (or (not (str.contains (str.replace x "side>" "<b>") "t</a<b>")) (not (str.contains x "de(88")) (= (str.indexof y "e" 0) 5)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,5}$")))
(assert (or (not (= "/style>" (str.substr y 100 9))) (not (= "ut:blank"" rror=javascript:alert(1)//></style>" (str.replace z "one" "")))))
(assert (or (not (= (str.indexof y "tab" 0) 36)) (str.in_re y ((_ re.from_regex ecma2020) "^[ ]*[^""""<>]{0,50}[ ]*$"))))
(assert (or (not (= "String.fr" (str.substr x 27 9))) (str.contains y "focusin") (= (str.indexof x "e" 0) 14)))
(check-sat)
