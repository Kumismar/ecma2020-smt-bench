; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem id=x tabindex=1 onfocusin=alert(1)></menuitem>") (= x "<iframe id=x tabindex=1 onactivate=alert(1)></iframe>")))
(assert (or (= z "on-name:x"" onanimationend=""alert(1)""></tt>") (= z "><address id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></address>") (= z "/table>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "=alert(1)>")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[_a-z0-9-]+(\.[_a-z0-9-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,})"))) (not (str.contains (str.replace z "</tt" " ") "> >"))))
(assert (or (not (str.prefixof "<iframe" y)) (not (str.prefixof "<" y))))
(assert (or (not (= "<menuitem" (str.substr y 0 9))) (not (= (str.indexof x "<i" 0) 0))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([\w\d.\-+_\u{2018}]+)@((?:[-a-z0-9]+\.)+[a-z]{2,})$"))))
(assert (not (str.suffixof "ddress>" z)))
(assert (not (str.contains x "sin=")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[\/][a-zA-Z\s]+[\/]$"))) (not (str.prefixof "<menuitem" y))))
(check-sat)
