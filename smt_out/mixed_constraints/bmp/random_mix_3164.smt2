; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<template draggable=""true"" ondragenter=""alert(1)"">test</template>") (= x "<img onmouseup=""alert(1)"">test</img>") (= x "<style>@keyframes x{}</style><bgsound style=""animation-name:x"" onanimationend=""alert(1)""></bgsound>")))
(assert (or (= z "LINK REL="";stylesheet""; HREF="";javascript:alert(';XSS';);"";>;") (= z ".css&quot;&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "tem") (str.in_re y ((_ re.from_regex ecma2020) "(^(?!0{5})(\d{5})(?!-?0{4})(|-\d{4})?$)")) (= "';XSS'" (str.substr z 48 6))))
(assert (= "/fr" (str.substr z 2 3)))
(assert (or (not (str.suffixof ";>;" y)) (str.in_re x ((_ re.from_regex ecma2020) "^([a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3})|(\d{9})$"))))
(assert (str.prefixof "vascript:" z))
(assert (or (= ".css&quo gt;" (str.replace z "t;&" " ")) (not (str.in_re z ((_ re.from_regex ecma2020) "[\u{3041}-\u{3093}|\u{3000}| ]+$"))) (= (str.at z 13) "1")))
(assert (str.contains x "ter=""alert"))
(assert (not (= (str.at z 88) "e")))
(check-sat)
