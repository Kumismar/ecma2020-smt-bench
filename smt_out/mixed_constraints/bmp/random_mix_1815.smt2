; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist draggable=""true"" ondragend=""alert(1)"">test</datalist>") (= x "<bgsound draggable=""true"" ondragend=""alert(1)"">test</bgsound>")))
(assert (or (= z "oup onfocusout=alert(1) tabindex=1 id=x></colgroup><input autofocus>") (= z "able>drag me</div><template ondragover=alert(1) contenteditable>drop here</template>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<var" y)))
(assert (not (str.suffixof "mplate>" y)))
(assert (not (<= (str.len x) 58)))
(assert (or (not (= (str.indexof z "cus" 0) 8)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z](\s?[a-zA-Z]*)*$")))))
(assert (or (not (= (str.at z 7) "o")) (not (>= (str.len z) 59)) (str.contains z "g me<")))
(assert (not (= (str.at y 27) "n")))
(check-sat)
