; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem onmousemove=""alert(1)"">test</menuitem>") (= x "<address onmouseenter=""alert(1)"">test</address>")))
(assert (or (= z "x dur=1s repeatCount=2 />") (= z ")"">te\u{1f600}st\u{1d400}</rp>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "o>" y) (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3})$")))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^\+[0-9]+$")))
(assert (or (= (str.at y 51) "u") (= (str.len x) 46) (= (str.indexof z ">" 0) 2)))
(assert (or (str.contains y "mo") (not (str.prefixof "&lt;?" y))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[\w\-\s]+$"))) (= (str.indexof z """>" 0) 1) (str.contains (str.replace y "move" "javascript:") "mousejavascript:=")))
(assert (= "(1) " (str.substr y 130 4)))
(check-sat)
