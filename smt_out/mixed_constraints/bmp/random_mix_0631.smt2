; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html oncontextmenu=""alert(1)"">test</html>") (= x "<label onblur=alert(1) tabind\u{1f4a9}ex=1 id=x></label><input autof\u{10348}ocus>") (= x "<q onmouseenter=""alert(1)"">test</q>")))
(assert (or (= z "activate=alert(1)></marquee>") (= z "alist>") (= z "rike>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z ][a-zA-Z ]*[a-zA-Z ]$"))) (str.prefixof "<label onb" y) (not (str.prefixof "<q on" y))))
(assert (not (str.contains y "t(1)"">te")))
(assert (or (not (str.prefixof "<html on" x)) (not (= "ri"">" (str.replace z "ke" """")))))
(assert (or (not (= (str.len z) 28)) (str.in_re y ((_ re.from_regex ecma2020) "^[^ -~\u{ff61}-\u{ff9f}]*$"))))
(check-sat)
