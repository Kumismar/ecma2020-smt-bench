; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<command draggable=""true"" ondrag=""alert(1)"">test</command>") (= x """><img src=1 onerr\u{1f600}or=alert(1)>.gif") (= x "<script>javascript:alert(1)</script\x0B")))
(assert (or (= z "wn=""alert(1)"">test</wbr>") (= z "nend=""alert(1)""></track>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "/command>" x)))
(assert (or (not (str.contains x "r=""ale")) (not (str.in_re x ((_ re.from_regex ecma2020) "(2018|2019|2020|2021|2022)"))) (not (= "<script> cript:alert(1)</script\x0B" (str.replace x "javas" " ")))))
(assert (not (str.prefixof "<style>:t" x)))
(assert (or (str.contains (str.replace y "Bwn" "javascript:") "t\x0javascript:=""a") (not (str.suffixof "</track>" y))))
(assert (or (= (str.len x) 39) (not (= (str.len z) 40)) (= (str.len x) 35)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\+[0-9]{2}\s)?(([0-9]{2}\s){1}[0-9]{3}(\s|-)?[0-9]{2}(\s|-)?[0-9]{2}|[0-9]{3}(\s|-)?[0-9]{3}(\s|-)?[0-9]{3}){1}$"))) (= (str.at x 6) "t") (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\u{e4}\u{f6}\u{fc} .'-]+$")))))
(check-sat)
