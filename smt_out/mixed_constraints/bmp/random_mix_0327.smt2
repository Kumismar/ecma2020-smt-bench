; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<math><brute href=javascript:alert(1)>click") (= x "<summary onfocusout=alert(1) tabindex=1 id=x></summary><input autofocus>")))
(assert (or (= z "fn>") (= z "t onchange=alert(1) value=xss>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 1) "n") (str.suffixof "ntext>>" y)))
(assert (or (not (= "i" (str.substr x 40 1))) (not (= (str.indexof y "t=ale" 0) 18)) (not (str.contains y "</cite>"))))
(assert (or (= (str.indexof y "nchan" 0) 75) (str.contains z "nchange=al") (not (str.prefixof "<summa" x))))
(assert (or (not (= "ut auto" (str.substr x 59 7))) (= (str.at z 7) "n") (str.in_re x ((_ re.from_regex ecma2020) "^[1-9]\d{9}$"))))
(assert (not (str.contains z " value=xs")))
(check-sat)
