; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var onmouseleave=""alert(1)"">test</var>") (= x "\u{20000}<svg><path><animateMotion onend=alert(1) dur=1s repeatCount=1>") (= x "&lt;A HREF=\""http&#58;//66&#46;102&#46;7&#46;147/\""&gt;XSS&lt;/A&gt;")))
(assert (or (= z "cus>") (= z "<svg xmlns=""http://www.w3.org/2000/svg"">")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 45) "1") (not (str.in_re z ((_ re.from_regex ecma2020) "^(?:19|20)[0-9]{2}-(?:(?:0[1-9]|1[0-2])-(?:0[1-9]|1[0-9]|2[0-9])|(?:(?!02)(?:0[1-9]|1[0-2])-(?:30))|(?:(?:0[13578]|1[02])-31))$")))))
(assert (str.contains (str.replace y "n" "") "th><aimat"))
(assert (or (= (str.at y 98) "2") (str.contains (str.replace x "46" "javascript:") "6&#javascript:;102") (= "useleave=" (str.substr y 9 9))))
(assert (or (not (str.suffixof ">cus>" y)) (not (str.contains y "nmouseleav"))))
(assert (or (= "<var onmouseleave=""alert(1)"">test</var<b>s>" (str.replace y ">cu" "<b>")) (not (= ">" (str.substr z 3 3))) (str.suffixof """>" z)))
(assert (or (str.suffixof "g"">" y) (not (= (str.at z 8) ">"))))
(check-sat)
