; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<data draggable=""true"" ondragend=""alert(1)"">test</data>") (= x "<object classid=""clsid:..."" codebase=""javascript:document.vulnerable=true;"">")))
(assert (or (= z "fromCharCode(97, 108, 101, 114, 116, 40, 49, 41)</SCRIPT>") (= z "re</del>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-fA-F0-9]{6}$"))) (str.contains y "agen")))
(assert (not (= "l>" (str.substr y 82 4))))
(assert (or (not (str.prefixof "<data d" y)) (= (str.indexof y "ndrag" 0) 24)))
(assert (or (not (<= (str.len y) 88)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9][a-zA-Z0-9_-]+([.][a-zA-Z0-9_-]+)*[@][a-zA-Z0-9_-]+([.][a-zA-Z0-9_-]+)*[.][a-zA-Z]{2,}$"))) (not (str.prefixof "<figcapti" y))))
(assert (or (not (= "</d" (str.substr y 57 3))) (not (= (str.at z 0) "l"))))
(check-sat)
