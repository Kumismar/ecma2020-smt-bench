; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext onbeforepaste=""alert(1)"" contenteditable>test</plaintext>") (= x "<style>@keyframes x{}</style><blockquote style=""animation-name:x"" onanimationend=""alert(1)""></blockquote>") (= x "<IMG SRC=x onchange=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "<input autofocus>") (= z "tabindex=1 onbeforedeactivate=alert(1)></spacer><input autofocus>") (= z "t(1)"" contenteditable>test</title>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 10) "e")) (not (str.contains z "=""")) (>= (str.len y) 37)))
(assert (or (= (str.indexof y "lert(" 0) 37) (str.suffixof "ofocus>" z) (= (str.indexof x ">test" 0) 51)))
(assert (or (str.prefixof "im" z) (= (str.at x 0) "<") (not (= (str.at y 15) "a"))))
(assert (not (= (str.indexof y "q" 0) 35)))
(assert (or (not (str.contains z "x=1 onbefo")) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*\S).{3,}"))) (not (>= (str.len z) 12))))
(assert (= (str.len z) 17))
(check-sat)
