; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=x\x11onerror=""javascript:alert(1)"">") (= x "<applet draggable=""true"" ondrag=""alert(1)"">test</applet>")))
(assert (or (= z """javascript:document.vulnerable=true;"">") (= z """>X</div> {IE7}") (= z "><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (= "r=""j" (str.substr x 20 4)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[_\.0-9a-zA-Z'+-]+@([0-9a-zA-Z][0-9a-zA-Z-]+\.)+[a-zA-Z]{2,6}$"))))
(assert (or (str.contains y "n>ntedi") (not (<= (str.len y) 81))))
(assert (= " ond" (str.substr y 28 4)))
(assert (or (not (str.suffixof "test</h1>" z)) (not (= "<section draggable=""true"" ondrag=""alert(1)"">test< tion></span>" (str.replace y "/sec" " ")))))
(assert (= (str.at x 5) "n"))
(assert (or (= "e"" ondrag" (str.substr y 22 9)) (= (str.len y) 62)))
(assert (or (not (= (str.indexof x "app" 0) 1)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9-+\s()]{8,16}$")))))
(assert (not (str.contains x "rc=x\x11o")))
(assert (or (= (str.at x 7) " ") (not (str.contains x "t(1)"">"))))
(check-sat)
