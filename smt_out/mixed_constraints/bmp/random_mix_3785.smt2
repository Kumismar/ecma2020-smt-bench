; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onblur=""alert(String.fromCharCode(88,83,83))"">") (= x "<style>:target {color:red;}</style><dl id=x style=""transition:color 1s"" ontransitionend=alert(1)></dl>") (= x "<style>:target {color: red;}</style><dd id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></dd>")))
(assert (or (= z "><ruby ondrop=alert(1) contenteditable>drop here</ruby>") (= z "=""alert(1)"" contenteditable>test</hr>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$"))) (not (str.contains z "ontentedi"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^0([8|9|6])([0-9]{8}$)"))) (not (= (str.indexof x "`'><" 0) 1))))
(assert (not (= "<IMG SRC=x onblur=""alerxString.fromCharCode(88,83,83))"">><ruby ondrop=alert(1) contenteditable>drop here</ruby>" (str.replace y "t(" "x"))))
(assert (or (not (= (str.len z) 55)) (not (str.prefixof "<style>" y))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[_A-z0-9 ]{1,}$"))) (str.suffixof "t</hr>" z)))
(assert (or (not (= "r" (str.substr z 10 1))) (not (>= (str.len y) 134))))
(check-sat)
