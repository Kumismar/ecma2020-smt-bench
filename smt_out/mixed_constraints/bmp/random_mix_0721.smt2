; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee onstart='javascript:alert&#x28;1&#x29;'>^__^") (= x "<datalist id=x tabindex=1 onbeforeactivate=alert(1)></datalist>") (= x "<acronym onclick=""alert(1)"">test</acronym>")))
(assert (or (= z "rt(1)"">test</div>") (= z ">") (= z "/frameset>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,12}"))) (not (str.suffixof "atalist>" x)) (= (str.indexof y "r" 0) 3)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[a-z\u{e0}\u{e8}\u{e9}\u{ec}\u{f2}\u{f9}]+")) (not (<= (str.len z) 32)) (= (str.len x) 54)))
(assert (not (= "/fxset>" (str.replace z "rame" "x"))))
(assert (or (= (str.indexof z ">" 0) 9) (str.contains (str.replace x "=a" "alert(1)") "roralert(1)le")))
(assert (or (not (= (str.indexof x "forea" 0) 30)) (= (str.at y 49) "^") (not (str.prefixof "rt(1)""" z))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-z0-9-\u{f1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{d1}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}]+$"))) (= (str.at x 47) "'")))
(check-sat)
