; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 onmouseup=""alert(1)"">test</h1>") (= x "<h1 onfocusout=alert(1) tabindex=1 id=x></h1><input autofocus>") (= x "<style>@keyframes x{}</style><image style=""animation-name:x"" onanimationstart=""alert(1)""></image>")))
(assert (or (= z "ydown=""alert(1)"" contenteditable>test</em>") (= z "un=alert(1)></wbr>") (= z "ouseout=""alert(1)"">test</nextid>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "p>1)")) (str.suffixof "xtid>" y) (str.contains (str.replace z "t</pa" " ") " ram>")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,5}$"))))
(assert (or (not (= (str.at z 27) "x")) (not (str.prefixof "<f" x))))
(assert (or (= ">" (str.substr z 31 3)) (= (str.at y 35) "n") (<= (str.len y) 73)))
(check-sat)
