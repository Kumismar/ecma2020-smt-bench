; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """/><img/onerror=\x20javascript:alert(1)\x20src=xxx:x />") (= x "<aside id=x tabindex=1 onbe\u{1f4a9}foreactivate=alert(1)></aside>") (= x "<blink oncut=""alert(1)"" contenteditable>test</b\u{1f4a9}link>")))
(assert (or (= z "xtarea oninput=alert(1)>XSS</textarea>") (= z "</noembed>") (= z "teditable>test</table>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 36) "e"))
(assert (or (not (str.prefixof "tedita" z)) (not (= "s>va" (str.substr y 44 4))) (not (= "<aside id=x tabindex=1 onbe\u{1f4a9}foreactivate=alert(1)></aside""table>test</table>" (str.replace y ">tedi" """")))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^(\+?[\d -]{8,15}[,]{0,1})*$")) (not (str.contains z "coo"))))
(assert (or (not (>= (str.len x) 73)) (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s]{1,50})$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^([ \u{5c}u00c0-\u{5c}u01ffa-zA-Z'\-])+$")))))
(assert (or (not (str.contains x "1)"" conte")) (not (str.contains y "rror=\x")) (not (str.prefixof "<blink onc" x))))
(assert (not (str.prefixof "<blink o" x)))
(check-sat)
