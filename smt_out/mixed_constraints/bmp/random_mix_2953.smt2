; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite id=x tabindex=1 onfocus=alert(1)></cite>") (= x "<template onkeydown=""alert(1)"" contenteditable>test</temp\u{20000}lat\u{1f4a9}e>")))
(assert (or (= z "teditable>test</li>") (= z "=&qu\u{1f600}ot;livescript:[code]&quot;&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 60) "z")) (= (str.len y) 99) (not (>= (str.len y) 80))))
(assert (or (str.prefixof "<cit" y) (not (= (str.indexof x "t(" 0) 25))))
(assert (or (str.suffixof "</li>" y) (not (str.prefixof "teditab" z)) (not (= (str.indexof z "de]&" 0) 22))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[0-9 ()+-]+$")) (= (str.indexof z ":[c" 0) 18) (str.contains (str.replace z "u\u{1f600}ot" """") "q"";li")))
(assert (or (= "teditable>test< >" (str.replace z "/li" " ")) (not (str.prefixof "lert" z))))
(check-sat)
