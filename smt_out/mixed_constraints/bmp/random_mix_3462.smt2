; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\xEF\xBB\xBFjavascript:alert(1)</script>") (= x "<article onmouseover=""alert(1)"">test</article>") (= x "%253cscript%253ealert(document.cookie)%253c/script%253e")))
(assert (or (= z "onkeydown=""alert(1)"" contenteditable>test</figure>") (= z "foo><x foo=""%><script>alert(91)</script>"">//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<tbody" y)) (<= (str.len y) 90)))
(assert (not (= (str.at x 15) "e")))
(assert (or (not (= (str.indexof y "a" 0) 22)) (not (= (str.at z 36) "i")) (not (= "</scri" (str.substr y 43 6)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[+]*[(]{0,1}[0-9]{1,4}[)]{0,1}[-\s\.\/0-9]*$"))) (str.contains z """ onanim")))
(assert (or (not (str.contains (str.replace z """%>" "javascript:") "oo=javascript:<")) (not (str.suffixof ">" x))))
(assert (or (not (= (str.indexof y "e>te" 0) 87)) (not (= (str.indexof y "TY" 0) 2)) (not (= (str.at x 42) "c"))))
(check-sat)
