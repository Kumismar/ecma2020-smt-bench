; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area onpaste=""alert(1)"" contenteditable>test</area>") (= x "<details onmousemove=""alert(1)"">test</details>") (= x "<mark draggable=""true"" ondragenter=""alert(1)"">test</mark>")))
(assert (or (= z "ame ondblclick=""alert(1)"">test</iframe>") (= z " ondeactivate=alert(1)></center\u{1f600}><input id=y au\u{1f4a9}tofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "ontentedit")))
(assert (or (str.prefixof "rc=x " z) (not (= "(1)></" (str.substr y 71 6)))))
(assert (= (str.at z 20) "1"))
(assert (or (not (= (str.len y) 102)) (not (= "pu" (str.substr z 36 2)))))
(assert (or (= "t" (str.substr x 32 1)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z \-\.]{1,34}$")))))
(check-sat)
