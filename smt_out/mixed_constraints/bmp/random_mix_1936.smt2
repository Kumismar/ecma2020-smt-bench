; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><abbr style=""animation-name:x"" onanimationstart=""alert(1)""></abbr>") (= x "<video id=x tabindex=1 onactivate=alert(1)></video>")))
(assert (or (= z "tarea onclick=""alert(1)"">test</textarea>") (= z " tabindex=1 onactivate=alert(1)></dl>") (= z "1)"" contenteditable>test</bdo>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "te=alert") (= "abind" (str.substr z 2 5))))
(assert (or (not (= (str.indexof y "abin" 0) 13)) (not (str.in_re x ((_ re.from_regex ecma2020) "^AX\d{3,7}|AI\d{3,7}|PA\d{3,7}$")))))
(assert (or (= (str.indexof y " tabi" 0) 95) (str.contains z """>test<") (str.suffixof "gen>" y)))
(assert (str.contains y "style=""ani"))
(check-sat)
