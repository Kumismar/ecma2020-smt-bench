; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<acronym draggable=""true"" ondragend=""alert(1)"">test</acronym>") (= x "<var id=x tabindex=1 onbeforeactivate=alert(1)></var>") (= x "<big onclick=""alert(1)"">test</big>")))
(assert (or (= z "nt>") (= z "e=""alert(1)"" contenteditable>test</u>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[+]?\d?[ .-]?[(]?\d{3}[)]?[ .-]?\d{3}[ .-]?\d{4}$"))))
(assert (or (= "alert(1)"">" (str.substr y 14 10)) (= "<var xouseout=""alert(1)"">test</var>" (str.replace x "onm" "x")) (str.prefixof "<acronym " y)))
(assert (or (not (str.contains (str.replace x "k=" "") "c""ale")) (= (str.at z 1) "t") (not (= (str.indexof y "e=""" 0) 42))))
(assert (or (str.suffixof ">" z) (not (= "<var id=x tabindex=1 onbeforeactivate=alert(1)></var>e=""alert(1)"" contenteditable>testalert(1)>" (str.replace y "</u" "alert(1)"))) (str.in_re x ((_ re.from_regex ecma2020) "\d\d\d \d\d\d \d\d\d\d$"))))
(assert (str.prefixof "<big on" y))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[\w\-\.]+@[\w\-\.]+(\.\w+)+$"))))
(check-sat)
