; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><xmp id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></xmp>") (= x "<wbr onmouseout=""alert(1)"">test</wbr>")))
(assert (or (= z "src=http://yoursite.com/your_files.js></script>") (= z "aa aaaaaaaaa aaaaaaaaaa href=j&#97v&#97script&#x3A;&#97lert(1)>ClickMe")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([1-9]{1}[\d]{0,2}(\.[\d]{3})*(\,[\d]{0,2})?|[1-9]{1}[\d]{0,}(\,[\d]{0,2})?|0(\,[\d]{0,2})?|(\,[\d]{1,2})?)$"))) (= "js" (str.substr z 35 2)) (not (= (str.indexof z "#" 0) 31))))
(assert (or (= (str.indexof y "le" 0) 4) (= "ansi" (str.substr x 79 4))))
(assert (or (not (str.prefixof "<wbr " y)) (= (str.at y 4) "l")))
(assert (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]{3,}@[A-Za-z]{1,}[.]{1}[A-Za-z.]{1,}")))
(assert (or (= (str.at x 3) "r") (not (= (str.at x 9) "a"))))
(assert (= (str.len x) 109))
(check-sat)
