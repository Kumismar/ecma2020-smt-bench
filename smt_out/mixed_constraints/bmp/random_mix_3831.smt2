; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby draggable=""true"" ondragstart=""alert(1)"">test</ruby>") (= x "<hgroup oncontextmenu=""alert(1)"">test</hgroup>")))
(assert (or (= z "></style>") (= z ":[code]"";>;")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 9)) (= "<hgroup alert(1)textmenu=""alert(1)"">test</hgroup>" (str.replace x "oncon" "alert(1)")) (str.in_re y ((_ re.from_regex ecma2020) "^\d{5}(?:[-\s]\d{4})?"))))
(assert (str.suffixof "</ruby>" x))
(assert (or (not (str.contains x "ab")) (str.contains (str.replace x "te" """") "npas""=""ale") (not (= (str.at y 36) "a"))))
(assert (= (str.indexof z "style" 0) 3))
(check-sat)
