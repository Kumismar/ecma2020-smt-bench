; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><multicol ondragover=alert(1) contenteditable>drop here</multicol>") (= x "<spacer onbeforecopy=""alert(1)"" contenteditable>test</spacer>")))
(assert (or (= z "';XSS';)>;") (= z ";")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 17) "o") (not (str.in_re z ((_ re.from_regex ecma2020) "^[^\s*]([a-zA-Z\u{f1}\u{d1}\u{c0}-\u{ff}0-9.,-/#\s]+){0,500}$"))) (not (str.suffixof "ert(1)>" x))))
(assert (or (not (str.suffixof "br>" z)) (str.contains z "';XSS';)>;") (str.contains z "S';")))
(assert (or (not (str.contains (str.replace z ";" """") """")) (str.contains (str.replace z "S';)" "alert(1)") ";XSalert(1)>;") (>= (str.len y) 126)))
(assert (str.prefixof "<d" x))
(assert (or (not (str.contains (str.replace z "XS" " ") "'; S';)>")) (not (str.prefixof "';XSS';)" z))))
(assert (not (str.prefixof "<spacer on" y)))
(assert (not (= "'" (str.substr z 0 1))))
(check-sat)
