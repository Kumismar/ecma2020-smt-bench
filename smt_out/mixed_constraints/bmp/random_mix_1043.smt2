; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;META HTTP-EQUIV=\""refresh\"" CONTENT=\""0;url=data&#58;text/html;base64,PHNjcmlwdD5hbGVydCgnWFNTJyk8L3NjcmlwdD4K\""&gt;") (= x "<div draggable=""true"" contenteditable>drag me</div><figure ondrop=alert(1) contenteditable>drop here</figure>")))
(assert (or (= z " SRC=x onscroll=""alert(String.fromCharCode(88,83,83))"">") (= z "e"" contenteditable>drag me</div><datalist ondragover=alert(1) contenteditable>drop here</datalist>") (= z "ideo oncut=""alert(1)"" contenteditable>test</video>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<div draggable=""true"" contentxitable>drag me</div><figure ondrop=alert(1) contenteditable>drop here</figure>" (str.replace x "ed" "x"))) (= "VydCgnWFN" (str.substr x 88 9)) (str.contains z "lert(1")))
(assert (<= (str.len x) 66))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[ A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]+$"))) (= "t(1)></d" (str.substr x 38 8))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) ".+@.+\.[A-Za-z]{2,}$"))))
(assert (or (= "e"" contentedialert(1)e>drag me</div><datalist ondragover=alert(1) contenteditable>drop here</datalist>" (str.replace z "tabl" "alert(1)")) (= "<div draggable=""true"" contenalert(1)itable>drag me</div><figure ondrop=alert(1) contenteditable>drop here</figure>" (str.replace x "ted" "alert(1)")) (= (str.at z 13) "t")))
(assert (or (not (str.contains z " onscro")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[_A-z0-9\u{5c}u4e00-\u{5c}u9fa5]{1,10}$"))) (= (str.at x 97) "e")))
(assert (not (str.contains x "NTENT=\")))
(check-sat)
