; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br onkeypress=""alert(1)"" contenteditable>test</br>") (= x "<samp oncopy=""alert(1)"" contenteditable>test</samp>") (= x "<style>@keyframes x{}</style><samp style=""animation-name:x"" onanimationstart=""alert(1)""></samp>")))
(assert (or (= z "r=""alert(1)"">test</tfoot>") (= z "itable>test</s>") (= z "1)></bdo><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[_A-Za-z0-9-\+]+(\.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(\.[A-Za-z0-9]+)*(\.[A-Za-z]{2,})$"))) (not (str.contains x "Ri"))))
(assert (or (= (str.indexof z "le>te" 0) 4) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z]\d[A-Za-z][ -]?\d[A-Za-z]\d$")))))
(assert (or (= "r=""a""(1)"">test</tfoot>" (str.replace z "lert" """")) (not (str.contains x "t(1)""></b")) (not (= "<br onkeypress=""alert(1)"" contenteditable>t/br>itable>test</s>" (str.replace y "est<" "")))))
(assert (or (not (str.prefixof "<st" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{3,4}-\d{7,8}$"))) (str.contains z "ap")))
(assert (str.contains (str.replace x "=" """") "style"""""))
(check-sat)
