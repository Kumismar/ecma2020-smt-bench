; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em draggable=""true"" ondragleave=""alert(1)"">test</em>") (= x "<svg><caption onload=alert(1)></caption>") (= x "<input oncontextmenu=""alert(1)"">test</input>")))
(assert (or (= z "ulticol>") (= z "el onmousedown=""alert(1)"">test</del>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z "icol>" 0) 3))
(assert (or (str.suffixof "el>" z) (str.suffixof "st</del>" y) (not (= (str.len y) 52))))
(assert (not (= (str.at z 31) "e")))
(assert (or (str.prefixof "el onm" z) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z]{1,}$"))) (str.contains (str.replace z "icol" "<b>") "ult<b>>")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-9]){10,}$"))))
(assert (str.contains z "rt("))
(assert (or (= (str.indexof x """ o" 0) 19) (str.in_re z ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}]).{6,}"))))
(assert (= "uljavascript:>" (str.replace z "ticol" "javascript:")))
(assert (not (= (str.len x) 53)))
(assert (>= (str.len z) 5))
(check-sat)
