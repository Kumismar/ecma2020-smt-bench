; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<m\u{10348}ark onm\u{1f600}ouseover=""alert(1)"">test</mark>") (= x "<wbr onmouseout=""alert(1)"">test</wbr>") (= x "<rt onkeydown=""alert(1)"" contenteditable>test</rt>")))
(assert (or (= z "alert(1)"">test</plaintext>") (= z "nanimationend=""alert(1)""></summary>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 24) "r") (= (str.at y 50) "t") (not (str.prefixof "<m\u{10348}ark on" x))))
(assert (= (str.indexof x "m>" 0) 55))
(assert (str.contains x "k "))
(assert (or (not (>= (str.len x) 29)) (str.contains (str.replace z "1)" "x") "rt(x"">t") (not (str.in_re y ((_ re.from_regex ecma2020) "^([0-9]{11})?$")))))
(check-sat)
