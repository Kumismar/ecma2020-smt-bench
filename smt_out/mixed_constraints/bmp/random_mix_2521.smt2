; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del id=x tabindex=1 ondeacti\u{20000}vate=alert(1)></del><input id=y autofocus>") (= x "<image onmousedown=""alert(1)"">test</image>") (= x "<video autoplay onloadedmetadata=alert(1)> <source src=""validvideo.mp4"" type=""video/mp4""></video>")))
(assert (or (= z "0061;&#x06c;&#x0065;&#x00000072;&#x00074;(1)></script>") (= z "mousemove=""alert(1)"">test</head>") (= z "ag=""alert(1)"">test</sup>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len z) 24))
(assert (or (str.contains z "l val") (not (<= (str.len z) 33)) (not (= (str.indexof y "t" 0) 17))))
(assert (str.suffixof "e>" x))
(assert (or (str.contains x "play on") (str.suffixof "/sup>" y)))
(assert (or (= "require" (str.substr x 35 7)) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9-]{5,11}")))))
(assert (= "d=y au" (str.substr x 58 6)))
(assert (not (= (str.len z) 54)))
(check-sat)
