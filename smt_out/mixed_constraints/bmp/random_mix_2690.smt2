; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup oncut=""alert(1)"" contenteditable>test</optgroup>") (= x "<style>:target {color:red;}</style><a id=x style=""transition:color 1s"" ontransitionend=alert(1)></a>") (= x "<;IMG SRC="";http://www.thesiteyouareon.com/somecommand.php?somevariables=maliciouscode"";>;")))
(assert (or (= z "=&quot;text/css&quot;&gt;BODY{background:url(&quot;javascript:alert(&apos;XSS&apos;)&quot;)}&lt;/STYLE&gt;") (= z "useout=""alert(1)"">test</dir>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "group>" x)))
(assert (or (= (str.at z 65) "r") (not (str.in_re y ((_ re.from_regex ecma2020) "^( {0,}[A-Za-z\u{c6}\u{e6}\u{d8}\u{f8}\u{c5}\u{e5}'\u{c4}\u{e4}\u{d6}\u{f6}\u{dc}\u{fc}\u{df}\u{c9}\u{e9}\u{c0}\u{e0}\u{c8}\u{e8}\u{d9}\u{f9}\u{c2}\u{e2}\u{ca}\u{ea}\u{ce}\u{ee}\u{d4}\u{f4}\u{db}\u{fb}\u{cb}\u{eb}\u{cf}\u{ef}\u{178}\u{ff}\u{c7}\u{e7}\u{c1}\u{e1}\u{cd}\u{ed}\u{d3}\u{f3}\u{da}\u{fa}\-]{2,} {0,}){1,}$")))))
(assert (or (not (str.suffixof "</dir>" y)) (= "able>te" (str.substr x 36 7))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]+$|^[0-9]{4}[a-zA-Z]{3}$|^(([a-zA-Z]{1,2}[0-9]{4}[a-zA-Z]{1,2})|([a-zA-Z]{1,2}[1-9]?[1-9][0-9]{4}))$|^C[a-zA-Z]{3}$|[S|P|H|T|s|p|h|t]{1}[0-9]{4}[a-zA-Z]{3}$"))) (str.in_re y ((_ re.from_regex ecma2020) "^CS\d{3,7}$")) (not (= "iptlet." (str.substr z 1 7)))))
(check-sat)
