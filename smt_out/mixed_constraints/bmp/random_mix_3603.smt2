; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u id=x tabindex=1 onfocusin=alert(1)></u>") (= x "<blockquote onfocusout=alert(1) tabindex=1 id=x></blockquote><input autofocus>")))
(assert (or (= z "onxxx=1") (= z "alert(1)"">") (= z "t type=radio id=x onfocus=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "t=" 0) 21))
(assert (not (= (str.at x 43) "i")))
(assert (= (str.indexof z "ler" 0) 1))
(assert (or (not (str.prefixof "<b" x)) (str.in_re z ((_ re.from_regex ecma2020) "\d+(\.\d{0,20})?"))))
(assert (or (= (str.at y 48) "1") (not (= "<blockquote onfocusout=alert(1) tabi<b>1 id=x></blockquote><input autofocus>onxxx=1" (str.replace y "ndex=" "<b>"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{3041}-\u{3093} \u{3000}]+$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9]+[a-zA-Z0-9 -.:]+"))))
(check-sat)
