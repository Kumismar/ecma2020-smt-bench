; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><param id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></param>") (= x "<html onMouseOut html onMouseOut=""javascript:javascript:alert(1)""></html onMouseOut>") (= x "<ul id=x tabindex=1 ondeactivate=alert(1)>\u{10348}</ul><input id=y autofocus>")))
(assert (or (= z "avascript\x09:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "e:x"" onanimationend=""alert(1)""></template>") (= z "ut=""alert(1)"">test</abbr>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<style>:" y)) (not (= "<style>:target {transform: rotate(180deg);}</style><param id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></param>avascript\x09:javascript:alert(1)"" id=""fuzzelemxt1"">test</a>" (str.replace y "en" "x"))) (str.suffixof "pt>\u{1d400}" y)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "(?=.*[0-9]).{2,4}[/][0-9]{4,10}")))
(assert (or (= "s>" (str.substr x 68 7)) (not (str.suffixof ">" y))))
(assert (or (>= (str.len y) 96) (= (str.len z) 61) (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]{1,5}"))))
(assert (not (str.prefixof "<htm" x)))
(assert (or (not (= " " (str.substr x 90 1))) (str.prefixof "<html" x)))
(assert (not (str.suffixof "/noembed>" z)))
(check-sat)
