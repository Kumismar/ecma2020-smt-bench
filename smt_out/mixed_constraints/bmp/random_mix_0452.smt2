; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><textarea id=x style=""transition:color 1s"" ontransitionend=alert(1)></textarea>") (= x "<section ondblclick=""alert(1)"">test</section>") (= x "<rtc draggable=""true"" ondragenter=""alert(1)"">test</rtc>")))
(assert (or (= z "><input autofocus>") (= z "C=x onwheel=""alert(String.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "e(88,8") (str.suffixof ">" x) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}\u{104}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b} ]*$")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{2019}'-]+$"))) (not (str.suffixof "ofocus>" x))))
(assert (not (str.contains y """>\u{10348}")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*[0-9].*)(?=.*[A-Z].*)(?=.*[a-z].*).{8,}$"))) (str.suffixof "utofocus>" z)))
(check-sat)
