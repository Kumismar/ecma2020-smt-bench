; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hgroup onbeforepaste=""alert(1)"" contenteditable>test</hgroup>") (= x "<script>({0:#0=alert/#0#/#0#(123)})</script>") (= x "<track onmouseout=""alert(1)"">test</track>")))
(assert (or (= z ")></link>") (= z " autofocus>") (= z "1 onactivate=alert(1)></legend>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "e" (str.substr y 66 1))) (str.prefixof "bl" z) (not (str.suffixof "legend>" z))))
(assert (= "<hgroup onbeforepaste=""alert(xcontenteditable>test</hgroup>" (str.replace x "1)"" " "x")))
(assert (= "er ondblcl" (str.substr x 5 10)))
(assert (or (not (= (str.at x 61) ">")) (not (str.suffixof "focus>" z)) (not (= (str.indexof z "vate=" 0) 8))))
(assert (not (= "1)"">tes" (str.substr x 25 7))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9a-z._-]+@{1}[0-9a-z.-]{2,}[.]{1}[a-z]{2,5}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "\S+@\S+\.\S*$")))))
(assert (or (str.suffixof "us>" z) (str.in_re y ((_ re.from_regex ecma2020) "\([0-9]{2}\) [0-9]{8,9}$"))))
(check-sat)
