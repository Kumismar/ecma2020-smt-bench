; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><button ondragover=alert(1) contenteditable>drop here</button>") (= x "<button oncopy=""alert(1)"" contenteditable>test</button>") (= x "<img alt='%></xmp><img src=xx:x onerror=aler")))
(assert (or (= z "lert(1)"">test</svg>") (= z "nav>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(1\s*[-\/\.]?)?(\((\d{3})\)|(\d{3}))\s*[-\/\.]?\s*(\d{3})\s*[-\/\.]?\s*(\d{4})\s*(([xX]|[eE][xX][tT])\.?\s*(\d+))*$"))) (not (= "teditab" (str.substr x 28 7))) (str.prefixof " me</div" z)))
(assert (or (= (str.len x) 55) (= "<button oncopy=""alert(1)"" contenteditable>test</button>" (str.replace x " " " ")) (= (str.at x 7) " ")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]{6,18}$"))) (not (str.contains (str.replace z "/st" " ") "(1)>< rike>")) (str.prefixof "<img a" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z \-'_]+$"))) (= (str.at x 36) "s")))
(assert (= "ton " (str.substr y 55 4)))
(check-sat)
