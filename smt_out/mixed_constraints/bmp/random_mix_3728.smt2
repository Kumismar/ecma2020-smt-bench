; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea onbeforepaste=alert(1) autofocus></textarea>") (= x "\u{10348}&#x\u{10348}003C;") (= x "<figure onmousedown=""alert(1)"">test</figure>")))
(assert (or (= z "lert(1);</script>") (= z ">test</th>") (= z "r onbeforecopy=""alert(1)"" contenteditable>test</meter>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "a>" x) (= "<figur  onmousedown=""alert(1)"">test</figure>" (str.replace x "e" " ")) (not (str.in_re x ((_ re.from_regex ecma2020) "^(([-\w\d]+)(\.[-\w\d]+)*@([-\w\d]+)(\.[-\w\d]+)*(\.([a-zA-Z]{2,10}|[\d]{1,3})){1,2})$")))))
(assert (or (not (str.suffixof "))>" z)) (not (str.suffixof "d>" x))))
(assert (or (= "=""aler" (str.substr z 14 6)) (str.prefixof "\u{10348}&#x" x) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9\-\+\(\) ]{8,18}$")))))
(assert (or (str.prefixof ">test</t" z) (not (= (str.len z) 10)) (= "ion>" (str.substr z 6 10))))
(check-sat)
