; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><dt ondragover=alert(1) contenteditable>drop here</dt>") (= x "<address onmousemove=""alert(1)"">test</address>") (= x "<template id=x tabindex=1 onbeforedeactivate=alert(1)></template><input autofocus>")))
(assert (or (= z "></noframes>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len z) 12)))
(assert (or (>= (str.len y) 103) (not (str.prefixof "></no" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z]+[,.]?[ ]?|[a-z]+['-]?)+$")))))
(assert (or (= (str.indexof y "dr" 0) 5) (not (str.in_re x ((_ re.from_regex ecma2020) "^\s*[a-zA-Z,\u{e7},\u{c7},\u{11f},\u{11e},\u{131},\u{130},\u{f6},\u{d6},\u{15f},\u{15e},\u{fc},\u{dc},\s]+\s*$"))) (str.prefixof "<tem" y)))
(assert (or (= (str.indexof y "te><i" 0) 62) (= (str.at z 0) ">") (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z'*-/s]+$"))))
(assert (or (not (str.prefixof "<addres" x)) (str.contains (str.replace x "rt(" " ") "=""ale 1")))
(assert (str.suffixof "ocus>" x))
(check-sat)
