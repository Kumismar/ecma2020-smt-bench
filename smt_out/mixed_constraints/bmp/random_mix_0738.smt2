; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext id=x tabindex=1 onbeforedeactivate=alert(1)></plaintext><input autofocus>") (= x "<style>:target {color:red;}</style><big id=x style=""transition:color 1s"" ontransitionend=alert(1)></big>") (= x """`'><script>\xE2\x80\x87javascript:alert(1)</script>")))
(assert (or (= z "onym>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof ">" z)))
(assert (or (not (= "alert(1)" (str.replace z "onym>" "alert(1)"))) (not (= (str.indexof z "ym" 0) 2)) (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9_]{1,15}"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]{8,11}$"))) (= "ym>" (str.substr z 2 8)) (= (str.at x 9) "p")))
(assert (not (= (str.at z 2) "y")))
(check-sat)
