; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tt onmouseover=""alert(1)"">test</tt>") (= x "ABC<div style=""x:\xE2\x80\x82expression(javascript:alert(1)"">DEF") (= x "<dialog onblur=alert(1) tabindex=1 id=x></dialog><input autofocus>")))
(assert (or (= z "ontenteditable>test</br>") (= z "1)"">test</frameset>") (= z "head style=""animation-name:x"" onanimationend=""alert(1)""></head>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "mouse" 0) 2) (= "1)"">test" (str.substr z 0 8))))
(assert (not (str.contains z "edita")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9]{7}"))) (not (= (str.indexof y ")"">" 0) 24))))
(assert (or (not (= (str.at y 88) "1")) (str.prefixof "<" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(([+][(]?[0-9]{1,3}[)]?)|([(]?[0-9]{4}[)]?))\s*[)]?[-\s\.]?[(]?[0-9]{1,3}[)]?([-\s\.]?[0-9]{3})([-\s\.]?[0-9]{3,4})"))) (not (str.suffixof "t>" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\u{5c}u3041-\u{5c}u309F\u{5c}u30A1-\u{5c}u30FF]+$")))))
(assert (not (str.suffixof "</tt>" x)))
(check-sat)
