; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base onbeforecopy=""alert(1)"" contenteditable>test</base>") (= x "<col id=x tabindex=1 onactivate=alert(1)></col>")))
(assert (or (= z "ipt>") (= z "</IFRAME>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "RAME>" y)) (not (str.prefixof "</IFR" z)) (str.contains (str.replace z "AME" "javascript:") "IFRjavascript:>")))
(assert (= (str.at z 2) "t"))
(assert (= "ad" (str.substr z 3 2)))
(assert (<= (str.len z) 12))
(assert (not (= "index=1 on" (str.substr y 13 10))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-Z|a-z|0-9](.|_){0,1})+[A-Z|a-z|0-9]@([A-Z|a-z|0-9])+((.){0,1}[A-Z|a-z|0-9]){2}.[a-z]{2,3}$"))) (= (str.at y 24) "c")))
(assert (or (str.contains x "abi") (= ">" (str.substr z 3 5))))
(assert (or (str.prefixof "ip" z) (= (str.len z) 9)))
(check-sat)
