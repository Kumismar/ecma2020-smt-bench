; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noframes onkeypress=""alert(1)"" contenteditable>test</noframes>") (= x "<style>:target {color:red;}</style><optgroup id=x style=""transition:color 1s"" ontransitionend=alert(1)></optgroup>") (= x "<div draggable=""true"" contenteditable>drag me</div><option ondragover=alert(1) contenteditable>drop here</option>")))
(assert (or (= z "le>test</rt>") (= z "avascript:javascript:alert(1)""></body onLoad>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "onLoad>" y)) (not (str.prefixof "ava" z)) (str.contains (str.replace x " ond" "javascript:") "onjavascript:ragov")))
(assert (or (= "es" (str.substr y 60 2)) (= "<style>:target {xlor: red;}</style><caption id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></caption>itable>test</samp>" (str.replace y "co" "x")) (not (str.suffixof ");//\""&gt;" z))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[\u{5c}u30A1-\u{5c}u30F6].*\S+.*")) (not (= (str.at y 71) "t"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9+]{10,16}$"))) (not (= (str.at z 11) ">")) (str.contains y "frames>ava")))
(check-sat)
