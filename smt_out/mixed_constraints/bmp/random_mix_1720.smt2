; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a onbeforepaste=""alert(1)"" contenteditable>test</a>") (= x "<rp onpaste=""alert(1)"" contenteditable>test</rp>")))
(assert (or (= z "=""alert(1)"">test</wbr>") (= z ">test</p>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<s" y)) (= (str.at y 60) "t") (str.prefixof "=""alert(" z)))
(assert (str.suffixof "a>" z))
(assert (or (= "</p>" (str.substr z 5 5)) (str.suffixof "/wbr>" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^((0[1-9]|[12]\d|3[01]|[4-7][0-9])([04][1-9]|[15][0-2])\d{2}(\d{5}))$"))))
(assert (= (str.indexof y """ con" 0) 21))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[^/#$.[\]]+$"))) (not (= (str.indexof y "t(1)""" 0) 17))))
(assert (= "=""aler" (str.substr y 48 6)))
(assert (str.suffixof "t</rp>" x))
(check-sat)
