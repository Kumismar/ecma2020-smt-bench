; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video onkeypress=""alert(1)"" con\u{1d400}tenteditable\u{1d400}>test</video>") (= x "<strong onfocusout=alert(1) tabindex=1 id=x></strong><input autofocus>") (= x "<code onkeydown=""alert(1)"" contenteditable>test</code>")))
(assert (or (= z " id=x tabindex=1 onactivate=alert(1)></track>") (= z "test</datalist>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "datalist>" z) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?:0(?!(5|7))(?:2|3|4|8|9))(?:-?\d){7}$|^(0(?=5|7)(?:-?\d){9})$"))) (not (str.suffixof "/track>" z))))
(assert (or (str.contains y "nanim") (not (str.in_re x ((_ re.from_regex ecma2020) "(^(([A-Z&\u{e2}\u{96}\u{92}]|[a-z&]|\s){1})(([A-Z&\u{e2}\u{96}\u{92}]|[a-z&]){3})([0-9]{6})((([A-Z&\u{e2}\u{96}\u{92}]|[a-z&]|[0-9]){3})))|(^(([A-Z&\u{e2}\u{96}\u{92}]|[a-z&]){3})([0-9]{6})((([A-Z&\u{e2}\u{96}\u{92}]|[a-z&]|[0-9]){3})))")))))
(assert (not (= (str.at x 65) "o")))
(assert (str.prefixof "test</da" z))
(assert (or (str.prefixof "<c" y) (not (= (str.len y) 69)) (= (str.indexof x ">" 0) 46)))
(assert (not (<= (str.len y) 57)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9 +()]+$"))) (not (= "onfocu" (str.substr x 8 6)))))
(check-sat)
