; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>BODY{-moz-binding:url(""http://www.securitycompass.com/xssmoz.xml#xss"")}</style>") (= x "<base onmousemove=""alert(1)"">test</base>") (= x "<;IMG SRC=&;#x6A&;#x61&;#x76&;#x61&;#x73&;#x63&;#x72&;#x69&;#x70&;#x74&;#x3A&;#x61&;#x6C&;#x65&;#x72&;#x74&;#x28&;#x27&;#x58&;#x53&;#x53&;#x27&;#x29>;")))
(assert (or (= z "ble>test</script>") (= z "t</ol>") (= z "=""alert(1)"">test</output>")))
(assert (= y (str.++ x z)))
(assert (or (= "x=1 " (str.substr z 10 4)) (not (str.contains x "e(1"))))
(assert (or (not (= (str.indexof z "l" 0) 3)) (not (= (str.at y 29) "o")) (not (<= (str.len y) 168))))
(assert (= (str.at x 98) "7"))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[0-9-]+$")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9()\-+Xx\s,]+$"))) (not (= "t</ol>" (str.substr y 150 10)))))
(check-sat)
