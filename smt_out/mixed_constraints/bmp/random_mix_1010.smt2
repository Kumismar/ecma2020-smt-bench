; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<header draggable=""true"" ondragstart=""alert(1)"">test</header>") (= x "<;DIV STYLE="";background-image: url(&;#1;javascript:alert(';XSS';))"";>;")))
(assert (or (= z "script:alert(1)</script>") (= z "roup>") (= z "cture id=x tabindex=1 onactivate=alert(1)></picture>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "lert(" """") ":a""1)<") (not (= "x=1 " (str.substr z 18 4)))))
(assert (or (not (= (str.indexof x "ble" 0) 14)) (not (= (str.at z 7) ">"))))
(assert (or (str.contains z "lert(1)</") (str.prefixof "<head" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{2,3})$"))) (not (= "javas" (str.substr y 41 5))) (str.contains x "tyle><sc")))
(assert (or (not (= (str.len x) 71)) (not (= (str.indexof y "/pict" 0) 114))))
(assert (not (str.suffixof "tofocus>" z)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9].{3,50}")))
(check-sat)
