; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br><br><br><br><br><br><x id=x>#x") (= x "<fieldset id=x tabindex=1 onbeforedeactivate=alert(1)></fieldset><input autofocus>")))
(assert (or (= z " type=submit>") (= z "useout=""alert(1)"">test</xmp>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^12$"))))
(assert (not (>= (str.len x) 25)))
(assert (or (not (= (str.at z 3) "s")) (= (str.indexof x "=da" 0) 25) (not (<= (str.len y) 74))))
(assert (str.prefixof " type=su" z))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z]{1}[a-zA-Z0-9\._#\-]{0,100}@([a-zA-Z0-9\-_\.]){1,100}\.[a-zA-Z]{2,}){1}$"))))
(assert (or (not (= (str.indexof y "tes" 0) 52)) (str.prefixof "<b" x) (= "<aside onmousemove=javascript:ert(1)"">test</aside>" (str.replace x """al" "javascript:"))))
(assert (or (= "seout=" (str.substr y 35 6)) (not (str.contains x "<br><x i"))))
(assert (= "src=x xor=\u{1f600}""alert(1)"">" (str.replace z "onerr" "x")))
(assert (or (str.contains y "rt(") (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-5][0-9][0-9][0-9][0-9]$")))))
(check-sat)
