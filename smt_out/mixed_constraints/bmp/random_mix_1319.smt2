; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<A href=javas%26#9\u{1d400}9;ript:alert(1)>click") (= x "<;SCRIPT "";a=';>;';""; SRC="";http://ha.ckers.org/xss.js"";>;<;/SCRIPT>;")))
(assert (or (= z "dt>") (= z "ess>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]+[a-zA-Z -]*")) (= "f=" (str.substr y 6 2)) (not (= (str.indexof z "dt>" 0) 0))))
(assert (or (str.prefixof "<A " y) (not (<= (str.len x) 63)) (not (= (str.indexof y "d" 0) 69))))
(assert (not (= (str.indexof z "ess>" 0) 0)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{4}\d{3}\d{4}$"))) (= (str.len z) 32)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(1\s*[-\/\.]?)?(\((\d{3})\)|(\d{3}))\s*[-\/\.]?\s*(\d{3})\s*[-\/\.]?\s*(\d{4})\s*(([xX]|[eE][xX][tT])\.?\s*(\d+))*$"))) (not (= (str.len x) 69))))
(assert (str.prefixof "nten" z))
(check-sat)
