; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x oncontextmenu=""alert(String.fromCharCode(88,83,83))"">") (= x "<style>@keyframes x{}</style><blink style=""animation-name:x"" onanimationend=""alert(1)""></blink>") (= x "<style>@keyframes x{}</style><figcaption style=""animation-name:x"" onanimationstart=""alert(1)""></figcaption>")))
(assert (or (= z "index=1 onfocus=alert(1)></title>") (= z "index=1 onfocusin=alert(1)></legend>") (= z "st</ins>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(([\d]{2} )|(2[abAB] ))*(([\d]{2})|(2[abAB]))$"))))
(assert (str.contains (str.replace y "xtmen" "javascript:") "contejavascript:u=""a"))
(assert (or (not (= (str.indexof y "i" 0) 31)) (str.prefixof "<" x)))
(assert (or (not (= (str.indexof x "keyf" 0) 8)) (not (= "ins>" (str.substr z 4 9)))))
(assert (or (str.prefixof "in" z) (not (>= (str.len z) 34)) (= (str.indexof x "eg);" 0) 38)))
(check-sat)
