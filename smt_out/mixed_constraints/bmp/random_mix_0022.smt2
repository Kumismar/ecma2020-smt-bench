; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><xmp onload=alert(1)></xmp>") (= x "<p onfocusout=alert(1) tabindex=1 id=x></p><input autofocus>") (= x "<select id=x tabindex=1 onbeforedeactivate=alert(1)></select><input autofocus>")))
(assert (or (= z ">") (= z ")></dfn>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/title>" x)) (not (str.prefixof "<" x)) (not (str.contains x "inde"))))
(assert (= "echo('" (str.substr x 16 6)))
(assert (not (str.contains (str.replace y "ele" " ") "<s ct")))
(assert (not (str.suffixof "de>" y)))
(assert (or (not (str.suffixof ">" x)) (not (str.contains x "xmp ")) (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z]+[\s][A-Za-z ]+"))))
(check-sat)
