; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script ^__^>alert(String.fromCharCode(49))</script ^__^") (= x "<div id=""108""><!-- IE 5-8 standards mode -->")))
(assert (or (= z "e>drag me</div><bdo ondrop=alert(1) contenteditable>drop here</bdo>") (= z "p=""alert(1)"" contenteditable>test</time>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "e -->" x))
(assert (or (not (= "nte" (str.substr y 62 3))) (not (= (str.indexof y "i" 0) 4)) (not (str.suffixof "</time>" z))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\w+((-\w+)|(\.\w+))*\@[A-Za-z0-9]+((\.|-)[A-Za-z0-9]+)*\.[A-Za-z0-9]+$"))) (not (= (str.indexof z "a" 0) 4))))
(assert (= "</bdo>" (str.substr z 61 9)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9 -]{3,12}$"))) (not (= "<script ^__^>alert(String.fromCharCode(49))</script ^__^p=""alert(1)"" coxenteditable>test</time>" (str.replace y "nt" "x"))) (str.contains z "tented")))
(assert (or (not (str.prefixof "<d" y)) (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z\u{e1}\u{e0}\u{e2}\u{e4}\u{e3}\u{e5}\u{e7}\u{e9}\u{e8}\u{ea}\u{eb}\u{ed}\u{ec}\u{ee}\u{ef}\u{f1}\u{f3}\u{f2}\u{f4}\u{f6}\u{f5}\u{fa}\u{f9}\u{fb}\u{fc}\u{fd}\u{ff}\u{e6}\u{153}\u{c1}\u{c0}\u{c2}\u{c4}\u{c3}\u{c5}\u{c7}\u{c9}\u{c8}\u{ca}\u{cb}\u{cd}\u{cc}\u{ce}\u{cf}\u{d1}\u{d3}\u{d2}\u{d4}\u{d6}\u{d5}\u{da}\u{d9}\u{db}\u{dc}\u{dd}\u{178}\u{c6}\u{152} .,'-]*$")) (= "aler" (str.substr y 13 4))))
(check-sat)
