; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta content=""&NewLine; 1 &NewLine;; JAVASCRIPT&colon; alert(1)"" http-equiv=""refresh""/>") (= x "<small id=x tabindex=1 onbeforeactivate=alert(1)></small>") (= x "<del onkeydown=""alert(1)"" contenteditable>test</del>")))
(assert (or (= z "ol>") (= z "eover=""alert(1)"">test\u{20000}</abbr>") (= z "Name=transform repeatCount=2 dur=1s>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 28) "n") (not (str.suffixof "l>" z)) (not (str.prefixof "<del onk" y))))
(assert (or (not (= "alert" (str.substr y 59 5))) (>= (str.len y) 51)))
(assert (= "ansform r" (str.substr z 7 9)))
(assert (or (not (str.contains x "tiva")) (not (str.contains (str.replace y "tC" " ") "ea ou")) (not (= (str.at z 1) "a"))))
(assert (or (= (str.at y 35) "i") (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z ]{1,}")))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,5}$")))
(check-sat)
