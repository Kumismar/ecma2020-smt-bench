; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strong id=x tabindex=1 onfocusin=alert(1)></strong>") (= x "<source onkeydown=""alert(1)"" contenteditable>test</source>") (= x "<div draggable=""true"" contenteditable>drag me</div><tbody ondrop=alert(1) contenteditable>drop here</tbody>")))
(assert (or (= z "t>") (= z ">test</data>") (= z "3)"">crosssitespt")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([A-Za-z]+[,.]?[ ]?|[A-Za-z]+['-]?)+$"))) (not (str.prefixof "3)"">c" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "([1-9]{1})([0-9]{1})")))))
(assert (= "ale" (str.substr x 34 3)))
(assert (or (not (str.suffixof "strong>" x)) (str.prefixof "t" z)))
(assert (or (not (= "1 onfocu" (str.substr x 22 8))) (= (str.len z) 16) (= (str.at y 55) "d")))
(assert (or (not (= (str.len y) 109)) (= (str.indexof x "ocu" 0) 27) (not (= "nteditable" (str.substr y 34 10)))))
(assert (not (str.suffixof "e>" x)))
(assert (or (= (str.at z 1) ">") (str.suffixof "ce>t>" y)))
(check-sat)
