; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input oninput=alert(1) value=xss>") (= x "<plaintext id=x tabindex=1 onbeforedeactivate=alert(1)></plaintext><input autofocus>")))
(assert (or (= z "yup=""alert(1)"" contenteditable>test</em>") (= z "t=alert(1) tabindex=1 id=x></em><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{4}-\d{1,2}-\d{1,2}$"))))
(assert (not (str.contains (str.replace z "p" "alert(1)") "ualert(1)=""a")))
(assert (not (= (str.indexof z "sinIE" 0) 1)))
(assert (or (str.suffixof ">" x) (str.prefixof "yup=""alert" z) (str.suffixof "xss>" x)))
(assert (or (str.contains (str.replace z "1" "alert(1)") "(alert(1))"" co") (not (= "e" (str.substr z 29 1)))))
(assert (or (not (str.suffixof "=xss>" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "^.{9,10}$")))))
(check-sat)
