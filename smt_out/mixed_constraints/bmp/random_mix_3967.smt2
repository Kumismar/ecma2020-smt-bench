; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><kbd style=""animation-name:x"" onanimationstart=""alert(1)""></kbd>") (= x "<ins onclick=""alert(1)"">test</ins>") (= x "<style>:target {color:red;}</style><body id=x style=""transition:color 1s"" ontransitionend=alert(1)></body>")))
(assert (or (= z "st</bgsound>") (= z "et\""&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(14)$"))) (not (= (str.indexof z "sou" 0) 6)) (<= (str.len y) 120)))
(assert (or (not (= "<style>:target {color:red;}</style><body id=x style=""tranalert(1)on:color 1s"" ontransitionend=alert(1)></body>et\""&gt;" (str.replace y "siti" "alert(1)"))) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z_-]{3,}$"))) (not (str.contains z "et\""&gt;"))))
(assert (not (= (str.indexof x ";<" 0) 47)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"))) (str.prefixof "<ins oncl" y) (not (str.prefixof "<style" y))))
(assert (or (not (= "sound>" (str.substr z 6 10))) (<= (str.len z) 47)))
(check-sat)
