; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onunhandledrejection=alert(1)><script>fetch('//xyz')</script>") (= x "ABC<div style=""x:expression\x5C(javascript:alert(1)"">DEF")))
(assert (or (= z "st</div>") (= z "over=alert(1) contenteditable>drop here</samp>") (= z "r onbeforepaste=""alert(1)"" contenteditable>test</var>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "tion=ale")) (str.suffixof "test</var>" y)))
(assert (= (str.indexof z "t<" 0) 46))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^([+])?([^\\d]?\\d){5,18}$")) (str.prefixof "e" z) (= "r>" (str.substr y 107 9))))
(assert (or (= ")"" conten" (str.substr z 24 9)) (= (str.indexof y ":ale" 0) 42)))
(assert (= (str.indexof z "ente" 0) 18))
(check-sat)
