; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><hr ondrop=alert(1) contenteditable>drop here</hr>") (= x "<body onbeforeprint=alert(1)>")))
(assert (or (= z "tml ondblclick=""alert(1)"">\u{1d400}test</html>") (= z "icol onkeydown=""alert(1)"" contenteditable>test</multicol>") (= z """>test</keygen>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "html>" z) (= (str.indexof x "e"" " 0) 19) (not (str.in_re x ((_ re.from_regex ecma2020) "^\D{1,15}$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9_\.][a-zA-Z0-9_\-\.]*[a-zA-Z0-9_\-]|[a-zA-Z0-9_]"))))
(assert (str.contains (str.replace x "t>" "javascript:") "elecjavascript:"))
(assert (or (>= (str.len z) 84) (str.suffixof "obr>" x)))
(assert (or (not (str.prefixof "<div drag" x)) (= "icol onkeydown=""alert(1)"" contenteditable>test</mulalert(1)l>" (str.replace z "tico" "alert(1)"))))
(assert (not (>= (str.len x) 30)))
(assert (str.contains x "table>d"))
(assert (= "able>" (str.substr z 37 5)))
(assert (or (str.prefixof "tml ond" z) (= "<body onbeforejavascript:t=alert(1)>" (str.replace x "prin" "javascript:"))))
(assert (not (str.prefixof "<d" x)))
(check-sat)
