; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time id=x tabindex=1 onbeforedeactivate=alert(1)></time><input autofocus>") (= x "<p onmousemove=""alert(1)"">test</p>")))
(assert (or (= z "X000003\u{20000}C;") (= z ")"">test</tt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w]{1,}[\w.+-]{0,}@[\w-]{1,}([.][a-zA-Z]{2,}|[.][\w-]{2,}[.][a-zA-Z]{2,})$"))) (not (str.contains z """>test</")) (str.contains x "alert(1")))
(assert (or (str.contains (str.replace z "st</t" "<b>") "e<b>t>") (str.contains x "able=""tr") (= "<p onmousemove=""alert(1)"">javascript:/p>)"">test</tt>" (str.replace y "test<" "javascript:"))))
(assert (or (not (= (str.indexof z "0" 0) 1)) (not (= (str.indexof x "<in" 0) 57))))
(assert (str.prefixof "<time" x))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{5d0}-\u{5ea}_-].{2,50}$"))))
(assert (or (str.contains (str.replace z "</tt" "<b>") "test<b>>") (not (str.in_re z ((_ re.from_regex ecma2020) "^\s?\d{3}-\d{6}?$")))))
(check-sat)
