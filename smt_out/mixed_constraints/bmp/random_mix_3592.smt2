; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\u{1f600}\x0Djavascript:javascript:alert(1)"" id=""fuzzelement1"">\u{10348}test</a>") (= x "<base id=x tabindex=1 onfocus=alert(1)></base>")))
(assert (or (= z "ndex=1 onfocus=alert(1)></address>") (= z "ript:alert(&quot;XSS&quot;)>&quot;;&apos;&gt; out") (= z "st</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)+$")) (not (= (str.at z 7) "o"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^UD\d{3,7}$"))))
(assert (or (= (str.at z 18) "r") (= "<a href=""\u{1f600}\x0Djavascript:javascript:alert(1)"" id=""fuzzelement1"">\u{10348}te<b></a>st</dfn>" (str.replace y "st" "<b>"))))
(assert (or (= (str.at x 5) "<") (not (str.in_re x ((_ re.from_regex ecma2020) "^([ \u{5c}u00c0-\u{5c}u01ffa-zA-Z'\-]){3,50}$")))))
(assert (or (not (str.contains x "nfocus=al")) (str.contains z "ert(1)>")))
(check-sat)
