; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em onpaste=""alert(1)"" contenteditable>test</em>") (= x "<figure id=x tabindex=1 onbeforeactivate=alert(1)></figure>") (= x "&#X0003c")))
(assert (or (= z "itioncancel=alert(1)></iframe>") (= z "frame id=x tabindex=1 onbeforedeactivate=alert(1)></frame><input autofocus>") (= z "e><header id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></header>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "frame " z)) (not (>= (str.len x) 55)) (str.prefixof "<em onpas" y)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\w+.\w+@[a-zA-Z_]+?\.[a-zA-Z]{2,3}$"))))
(assert (or (= (str.at y 54) ">") (not (str.contains (str.replace x "e" """") "igur"" id="))))
(assert (str.contains (str.replace y "a" " ") "c n"))
(assert (or (= (str.indexof y "rans" 0) 71) (not (= (str.at y 15) "e")) (not (str.in_re x ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}")))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) ".*(^(bc1|[13])[a-zA-HJ-NP-Z0-9]{25,39}$).*")) (= (str.indexof x "003c" 0) 4) (= "ate=al" (str.substr z 37 6))))
(assert (str.prefixof "<fig" y))
(assert (= (str.at x 32) "<"))
(check-sat)
