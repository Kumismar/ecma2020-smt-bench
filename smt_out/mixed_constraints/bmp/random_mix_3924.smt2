; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video draggable=""true"" ondragend=""alert(1)"">test</video>") (= x "<scr<script>ipt>alert('XSS');</scr</script>ipt>") (= x "<body onUnload body onUnload=""javascript:javascript:alert(1)""></body onUnload>")))
(assert (or (= z " contenteditable>test</track>") (= z "=""javascript:alert('XSS');""></IFRAME>"">123</h1>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len x) 48)) (not (str.contains (str.replace z "3<" "javascript:") "12javascript:/"))))
(assert (or (= (str.at z 7) "t") (= (str.indexof x """>t" 0) 43) (not (= (str.indexof z "/IF" 0) 29))))
(assert (not (= "ac" (str.substr z 25 2))))
(assert (or (str.contains y "</body o") (not (str.prefixof "</td>" z))))
(assert (or (not (str.contains z "('XSS');"">")) (str.in_re y ((_ re.from_regex ecma2020) "^[\u{5c}u4e00-\u{5c}u9fa5]{0,}$")) (not (str.in_re z ((_ re.from_regex ecma2020) "^(0[1-9]|1[0-2])\/\d{2}$")))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[0]{1}[x]{1}[a-zA-Z0-9]{40}$")) (not (str.contains (str.replace y "n" "") " ob"))))
(check-sat)
