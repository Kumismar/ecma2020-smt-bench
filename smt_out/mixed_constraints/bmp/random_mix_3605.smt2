; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span onkeypress=""alert(1)"" contenteditable>test</span>") (= x "<ruby id=x tabindex=1 onbeforedeactivate=alert(1)></ruby><input autofocus>")))
(assert (or (= z "=""true"" ondragleave=""alert(1)"">test</picture>") (= z "ageshow=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "dth=" 0) 15) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_]{4,32}$"))) (= (str.len x) 44)))
(assert (or (str.suffixof "est</i>" x) (not (= (str.indexof y "></r" 0) 49))))
(assert (or (= (str.indexof y "drag" 0) 84) (str.in_re y ((_ re.from_regex ecma2020) "^09[0-9]{8}"))))
(assert (= "<span onkeypress=""alert(1)"" conte""itable>test</span>" (str.replace x "nted" """")))
(check-sat)
