; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sub oncontextmenu=""alert(1)"">test</sub>") (= x "<mark onbeforepaste=""ale\u{10348}rt(1)"" contenteditable>test</mark>") (= x "<dir onkeydown=""alert(1)"" contenteditable>test</dir>")))
(assert (or (= z "keyframes x{}</style><frameset style=""animation-name:x"" onanimationend=""alert(1)""></frameset>") (= z "elect>")))
(assert (= y (str.++ x z)))
(assert (= "lect" (str.substr z 1 4)))
(assert (or (not (str.prefixof "<sub " x)) (= (str.len y) 133) (str.suffixof ">" x)))
(assert (or (not (= "<style>@keyframes x{}</style><ol style ""animation-name:x"" onanimationend=""alert(1)""></ol>" (str.replace x "=" " "))) (not (str.contains z "style>")) (not (= (str.indexof y "con" 0) 7))))
(assert (or (= (str.at z 15) "s") (= (str.at x 18) "r") (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.+(com|org)"))))
(assert (or (str.contains y "noframes>") (str.suffixof "ect>" z) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.]{8,20}$")))))
(assert (not (= "<sub oncontextmenu=""alert(1)"">texub>" (str.replace x "st</s" "x"))))
(check-sat)
