; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav onmouseover=""alert(1)"">test</nav>") (= x "<style>@keyframes x{}</style><rtc style=""animation-name:x"" onanimationend=""alert(1)""></rtc>") (= x "<hr id=x tabindex=1 onfocus=alert(1)></hr>")))
(assert (or (= z "oncontextmenu=""alert(1)"">test</tfoot>") (= z "rticle>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "</nav>" (str.substr x 32 6))) (not (= (str.indexof x "yle=" 0) 36))))
(assert (or (not (<= (str.len x) 101)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[-a-z0-9_+\.]+\@([-a-z0-9]+\.)+[a-z0-9]{2,4}$"))) (str.contains (str.replace z "rticl" "") "e>")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[\$\d\., ]+$"))) (= "s" (str.substr y 37 1))))
(assert (not (= (str.indexof x "le>te" 0) 47)))
(assert (or (not (str.contains z "CRI")) (not (str.suffixof "</tfoot>" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-])([a-zA-Z0-9_\-\.\+]*)@(\[((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.){3}|((([a-zA-Z0-9\-]+)\.)+))([a-zA-Z]{2,}|(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\])$")))))
(assert (str.contains y "le"))
(check-sat)
