; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<map id=x tabindex=1 onfocus=alert(1)></map>") (= x "<b draggable=""true"" ondragenter=""alert(1)"">test</b>") (= x "<td onbeforepaste=""alert(1)"" contenteditable>test</td>")))
(assert (or (= z "ase>") (= z "=x onfocus=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 4)) (not (= "=x onfocus=alert(javascript:>" (str.replace z "1)" "javascript:"))) (= (str.at z 1) "x")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^(\+33[0-9]{1}[0-9]{8})$|^(^0[0-9]{9})$")) (str.in_re z ((_ re.from_regex ecma2020) "^[a-z A-Z ]*$")) (>= (str.len x) 44)))
(assert (or (= (str.at x 27) """") (str.in_re y ((_ re.from_regex ecma2020) "^\s*[^@]+([@]{1})[0-9a-zA-Z\._-]+([\.]{1})[0-9a-zA-Z\._-]+\s*$"))))
(assert (not (str.prefixof "<b drag" y)))
(check-sat)
