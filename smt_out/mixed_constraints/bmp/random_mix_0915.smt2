; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<small draggab\u{20000}le=""true"" ondragstart=""alert(1)"">te\u{20000}st</small>") (= x "<footer draggable=""true"" ondragleave=""alert(1)"">test</footer>") (= x "<address onmouseleave=""alert(1)"">test</address>")))
(assert (or (= z "ntenteditable>test</slot>") (= z " 10s"" ontransitioncancel=alert(1)></ul>") (= z "able>")))
(assert (= y (str.++ x z)))
(assert (not (= "<footer draggable=""true"" ondragleave=""alert(1)"">test</footer> 10s"" onitioncancel=alert(1)></ul>" (str.replace y "trans" ""))))
(assert (or (not (= "<sm<b> draggab\u{20000}le=""true"" ondragstart=""alert(1)"">te\u{20000}st</small>" (str.replace x "all" "<b>"))) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z\u{154}\u{c1}\u{c2}\u{102}\u{c4}\u{139}\u{106}\u{c7}\u{10c}\u{c9}\u{118}\u{cb}\u{11a}\u{cd}\u{ce}\u{10e}\u{110}\u{143}\u{147}\u{d3}\u{d4}\u{150}\u{d6}\u{158}\u{16e}\u{da}\u{170}\u{dc}\u{dd}\u{162}\u{df}\u{155}\u{e1}\u{e2}\u{103}\u{e4}\u{13a}\u{107}\u{e7}\u{10d}\u{e9}\u{119}\u{eb}\u{11b}\u{ed}\u{ee}\u{10f}\u{111}\u{144}\u{148}\u{f3}\u{f4}\u{151}\u{f6}\u{159}\u{16f}\u{fa}\u{171}\u{fc}\u{fd}\u{163}\u{2d9} \t\r\n\f\u{15b}, \u{107}, \u{142}, \u{f3}, \u{144}, \u{17c}, \u{17a}, \u{105}, \u{119}]*$"))) (str.contains y "ss>nt")))
(assert (or (not (= (str.indexof x "r" 0) 8)) (str.in_re y ((_ re.from_regex ecma2020) "^\+?\d+$"))))
(assert (not (= (str.at z 3) "e")))
(assert (not (str.contains x "1)"">test<")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]{1,200}$"))) (= (str.at y 44) "s")))
(check-sat)
