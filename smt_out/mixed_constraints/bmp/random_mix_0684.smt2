; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound onkeydown=""alert(1)"" contenteditable>test</bgsound>") (= x "<option draggable=""true"" ondrag=""alert(1)"">test</option>")))
(assert (or (= z "ndblclick=""alert(1)"">test</center>") (= z "rt(1)></b>") (= z "mes x{}</style><font style=""animation-name:x"" onanimationend=""alert(1)""></font>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "<option dr") (not (= (str.indexof x "o" 0) 1))))
(assert (= (str.at z 18) ")"))
(assert (or (= (str.indexof x "nten" 0) 32) (not (str.contains (str.replace x "</" "") "estb")) (not (>= (str.len x) 47))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9.@-]{6,55}")))
(assert (or (not (str.suffixof "b>" y)) (not (= (str.at x 26) "1"))))
(check-sat)
