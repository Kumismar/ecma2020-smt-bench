; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure onmouseenter=""alert(1)"">test</figure>") (= x "<command draggable=""true"" ondrag=""alert(1)"">test</command>")))
(assert (or (= z "w, {Safe: {value: {get: function() {return document.cookie}}}});alert(Safe.get())</script>") (= z "t autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "(13[0-9]|14[5|7]|15[0|1|2|3|5|6|7|8|9]|18[0|1|2|3|5|6|7|8|9]|17[0|1|2|3|5|6|7|8|9]|19[0|1|2|3|5|6|7|8|9])\d{8}$")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{8,10}$")) (not (= "<figure onmouseenter=""alert(1)"">te<b>igure>" (str.replace x "st</f" "<b>"))) (str.prefixof "<div " y)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[ABCEGHJKLMNPRSTVXY][0-9][ABCEGHJKLMNPRSTVWXYZ] ?[0-9][ABCEGHJKLMNPRSTVWXYZ][0-9]$"))) (not (str.suffixof "ocus>" y)) (str.suffixof "t</menu>" z)))
(assert (or (= "turn doc" (str.substr y 96 8)) (>= (str.len z) 88) (not (= (str.at z 7) "o"))))
(assert (or (not (>= (str.len y) 69)) (not (str.prefixof "<figure on" y))))
(assert (or (not (str.suffixof "us>" z)) (not (= (str.at y 24) """"))))
(check-sat)
