; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tt onbeforecopy=""alert(1)"" contenteditable>test</tt>") (= x "<noscript onbeforepaste=""alert(1)"" contenteditable>test</noscript>") (= x "<address draggable=""true"" ondragenter=""alert(1)"">test</address>")))
(assert (or (= z "opy=""alert(1)"" contenteditable>test</multicol>") (= z "o.mp4"" type=""video/mp4""></video>") (= z "script>&")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace y "ure> " "<b>") "fig<b>ond")))
(assert (or (not (= (str.indexof x "ble>t" 0) 47)) (not (= (str.indexof x "ble>" 0) 47))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[^@]+@\w+\.\w+$"))) (not (str.in_re z ((_ re.from_regex ecma2020) ".{3,80}$"))) (not (str.contains (str.replace x "alert" "javascript:") "y=""javascript:(1)"""))))
(assert (not (= (str.len z) 56)))
(assert (or (not (str.contains x "st</addres")) (str.contains z "de") (not (= "/tt>o" (str.substr y 49 5)))))
(assert (or (not (str.contains x "e"" ond")) (str.suffixof ">test</tt>" x)))
(assert (or (not (= (str.indexof y "t" 0) 8)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z_\d]+$")))))
(check-sat)
