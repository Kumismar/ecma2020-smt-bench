; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onLoad body onLoad=""javascript:javascript:alert(1)""></body onLoad>") (= x "<aside oncopy=""alert(1)"" contenteditable>test</aside>")))
(assert (or (= z "r=""\u{1f600}alert(1)"">test</dfn>") (= z """alert(String.fromCharCode(8\u{20000}8,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(?:(?:[2-8]\d|9[0-7]|0?[28]|0?9(?=09))(?:\d{2}))$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^\D?(\d{2})\D?\D?(\d{5})\D?(\d{4})$"))) (not (str.contains x "1)"">"))))
(assert (or (not (str.prefixof """aler" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-Z0-9]{5}-){6}[A-Z0-9]{5}$"))) (str.suffixof "></q>" y)))
(assert (str.contains y "Ch"))
(assert (= "e>test</" (str.substr y 39 8)))
(check-sat)
