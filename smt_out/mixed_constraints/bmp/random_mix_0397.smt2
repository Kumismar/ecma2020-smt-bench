; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup oncontextmenu=""alert(1)"">test</optgroup>") (= x "<b onmouseover=""alert(1)"">test</b>")))
(assert (or (= z "test</strike>") (= z "=1 onfocus=alert(1)></dir>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<b onmouseove<b>alert(1)"">test</b>" (str.replace x "r=""" "<b>"))) (>= (str.len y) 74) (not (<= (str.len z) 24))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^(.*\d.*){6,}$")) (not (str.suffixof "</strike>" y))))
(assert (not (str.prefixof "<optgrou" x)))
(assert (or (not (= "<b> onmouseover=""alert(1)"">test</b>test</strike>" (str.replace y "<b" "<b>"))) (= "test</b>=" (str.substr y 26 9))))
(check-sat)
