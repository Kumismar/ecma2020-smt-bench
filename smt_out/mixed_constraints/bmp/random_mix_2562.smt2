; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nobr onmousemove=""alert(1)"">test</nobr>") (= x "<del onmouseover=""alert(1)"">test</del>") (= x "<menu onkeydown=""alert(1)"" contenteditable>test</menu>")))
(assert (or (= z "(1)></script><input autofocus>") (= z "gsound style=""animation-name:x"" onanimationend=""alert(1)""></bgsound>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "/input>" x))
(assert (or (<= (str.len z) 22) (not (<= (str.len x) 43)) (str.prefixof "gs" z)))
(assert (or (not (str.contains x "ble>t")) (not (str.in_re z ((_ re.from_regex ecma2020) "^(?!0\.00)[1-9]\d{0,7}(,\d{3})*(\.\d{0,4})?$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z][a-zA-Z\\s]+$")))))
(assert (or (not (= "e:x"" ona" (str.substr z 27 8))) (not (str.contains y "alert(1)"">")) (not (str.suffixof " here</rb>" y))))
(assert (or (= ">" (str.substr y 69 5)) (not (str.contains (str.replace z "u" " ") "p t")) (not (= "<nobr onmousemove=""alex)"">test</nobr>(1)></script><input autofocus>" (str.replace y "rt(1" "x")))))
(assert (not (= "input au" (str.substr z 14 8))))
(check-sat)
