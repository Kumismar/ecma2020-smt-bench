; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:\xE2\x80\x88expression(javascript:alert(1)"">DEF") (= x "\\'); alert(\'xss\');var x=\'")))
(assert (or (= z "dex=1 onactivate=alert(1)></caption>") (= z "tyle>@keyframes x{}</style><time style=""animation-name:x"" onanimationend=""alert(1)""></time>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "yle=""" "") "iv stx")) (not (str.in_re z ((_ re.from_regex ecma2020) "^0[1-9]([\s]?\d\d){4}$"))) (not (= (str.at z 1) "a"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[a-z0-9]+([._\\-]*[a-z0-9])*@([a-z0-9]+[-a-z0-9]*[a-z0-9]+.){1,63}[a-z0-9]+$")) (<= (str.len x) 31)))
(assert (not (str.contains y "/script>")))
(assert (str.suffixof "EF" x))
(assert (or (= (str.indexof z "rt(" 0) 0) (not (>= (str.len x) 23)) (= "\\');  rt(\'xss\');var x=\'dex=1 onactivate=alert(1)></caption>" (str.replace y "ale" " "))))
(assert (not (= "ert(1)><" (str.substr z 19 8))))
(assert (not (str.suffixof "reload>" x)))
(assert (or (not (= (str.at z 14) "t")) (not (<= (str.len x) 37))))
(check-sat)
