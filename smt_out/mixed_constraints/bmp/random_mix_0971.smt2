; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet oncut=""alert(1)"" contenteditable>test</applet>") (= x "<video autoplay controls onseeked=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>")))
(assert (or (= z "ert(1)"" contenteditable>test</de\u{20000}tails>") (= z "f=""\u{1f600}\x0Djavascript:javascript:alert(1)"" id=""fuzzelement1"">\u{10348}test</a>") (= z "te=alert(1)></u>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "let oncut")) (<= (str.len z) 44)))
(assert (or (not (= (str.at x 46) "/")) (str.suffixof "/applet>" x)))
(assert (or (not (= "ert" (str.substr x 36 3))) (not (>= (str.len y) 86)) (not (= (str.indexof x "t on" 0) 6))))
(assert (not (= "Snake says" (str.substr x 29 10))))
(assert (not (= "<applet oncut=alert(1)"" contenteditable>test</applet>ert(1)"" contenteditable>test</de\u{20000}tails>" (str.replace y """" ""))))
(assert (or (not (= (str.indexof y "lot" 0) 2)) (not (str.contains x "le>test<")) (= (str.at y 44) "t")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{3041}-\u{309e}\u{30fc}]+$"))) (= (str.indexof y "p" 0) 11)))
(check-sat)
