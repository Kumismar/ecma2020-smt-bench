; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;IMG SRC="";livescript:[code]"";>;") (= x "<details onbeforecopy=""alert(1)"" contenteditable>test</details>")))
(assert (or (= z "ivate=alert(1)></u>") (= z "t(1)\u{1f600}"" id=""fuzzelement1"">test</a>") (= z "t(1)"" contenteditable>test</rt>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len x) 63)) (not (str.suffixof "[code]"";>;" x))))
(assert (or (not (= "t(1)""  enteditable>test</rt>" (str.replace z "cont" " "))) (str.contains y "tyle>") (= (str.at z 1) ">")))
(assert (or (str.contains z "enteditabl") (str.prefixof "t(1)"" con" z) (not (str.contains x "SR"))))
(assert (or (not (str.prefixof "'>ale" y)) (not (>= (str.len x) 30)) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9][(][0-9]{3}[)] [0-9]{3}-[0-9]{4}")))))
(assert (or (not (str.suffixof ">" x)) (not (= "cript:" (str.substr y 17 6)))))
(assert (str.contains (str.replace x "onl" "alert(1)") "v alert(1)oad"))
(check-sat)
