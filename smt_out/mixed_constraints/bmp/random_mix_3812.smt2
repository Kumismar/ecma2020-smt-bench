; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th onkeydown=""alert(1)"" contenteditable>test</th>") (= x "<style>:target {color:red;}</style><abbr id=x style=""transition:color 1s"" ontransitionend=alert(1)></abbr>") (= x "<cite onmousedown=""alert(1)"">test</cite>")))
(assert (or (= z "tivate=alert(1)></meta>") (= z "lert(1)"">test</form>")))
(assert (= y (str.++ x z)))
(assert (or (= "<th onkeydown=""ale"")"" contenteditable>test</th>" (str.replace x "rt(1" """")) (not (= "a>" (str.substr y 127 9)))))
(assert (or (str.contains x "e=") (not (str.in_re z ((_ re.from_regex ecma2020) "^\+?[7][-\(]?\d{3}\)?[-\s]?\d{3}-?\d{2}-?\d{2}$")))))
(assert (str.contains x "<style>:ta"))
(assert (= (str.indexof z "(" 0) 4))
(assert (or (str.contains (str.replace z "ta>" "") "></me") (not (str.contains y "n=""ale")) (>= (str.len z) 19)))
(assert (not (= "1)%253c/s" (str.substr y 46 9))))
(check-sat)
