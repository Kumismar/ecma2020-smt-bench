; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite oncontextmenu=""alert(1)"">test</cite>") (= x "<ol onmouseover=""alert(1)"">test</ol>")))
(assert (or (= z "k onmouseleave=""alert(1)"">test</track>") (= z "(\\""\"";") (= z "un=alert(1)></noscript>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "1)"">t")) (not (str.in_re x ((_ re.from_regex ecma2020) "^\+?[\d\s\.*]+$"))) (not (= "/" (str.substr x 36 1)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z\u{c6}\u{e6}\u{d8}\u{f8}\u{c5}\u{e5}'\u{c4}\u{e4}\u{d6}\u{f6}\u{dc}\u{fc}\u{df}\u{c9}\u{e9}\u{c0}\u{e0}\u{c8}\u{e8}\u{d9}\u{f9}\u{c2}\u{e2}\u{ca}\u{ea}\u{ce}\u{ee}\u{d4}\u{f4}\u{db}\u{fb}\u{cb}\u{eb}\u{cf}\u{ef}\u{178}\u{ff}\u{c7}\u{e7}\u{c1}\u{e1}\u{cd}\u{ed}\u{d3}\u{f3}\u{da}\u{fa}\s0-9\-]*$"))) (not (str.contains x "ver=""aler"))))
(assert (or (not (= ">test<" (str.substr x 30 6))) (str.suffixof "\\""\"";" y) (str.contains z "mo")))
(assert (or (not (= (str.at z 28) "i")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z-0-9\s]*$")))))
(check-sat)
