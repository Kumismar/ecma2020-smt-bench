; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><a style=""animation-name:x"" onanimationstart=""alert(1)""></a>") (= x "<canvas onbeforecopy=""alert(1)"" contenteditable>test</canvas>")))
(assert (or (= z "t onmousemove=""alert(1)"">test</input>") (= z "ad=alert(1)></xmp>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}0-9 _]*[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}0-9][A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}0-9 _]*$")) (str.suffixof "nu>" x)))
(assert (or (not (str.contains (str.replace z "lert(" " ") "=a 1)><")) (str.contains (str.replace z "er" "x") "e=""alxt(1)") (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\-]{10,20}$"))))
(assert (= (str.len x) 61))
(assert (or (str.contains y "/a>") (= "<caas onbeforecopy=""alert(1)"" contenteditable>test</canvas>" (str.replace x "nv" "")) (not (= "-n" (str.substr y 48 2)))))
(assert (not (= (str.at y 14) "r")))
(check-sat)
