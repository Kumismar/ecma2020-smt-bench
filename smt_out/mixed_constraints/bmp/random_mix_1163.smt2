; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<spacer id=x tabindex=1 onactivate=alert(1)></spacer>") (= x "<dl id=x tabindex=1 onactivate=alert(1)></dl>") (= x "<s onbeforepaste=""ale\u{10348}rt(1)"" contenteditable>test</s>")))
(assert (or (= z "javascript:javascript:alert(1)""></body onUnload>") (= z "nteditable>test</frame>") (= z "est<\u{20000}/ul>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^^\D?(\d{3})\D?\D?(\d{3})\D?(\d{4})$")) (not (str.prefixof "<" x))))
(assert (str.contains z "table>t"))
(assert (or (not (str.suffixof "test</s>" x)) (str.suffixof "</frame>" y)))
(assert (or (not (str.contains y "100&#97&")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[^<>%]*$"))) (not (str.suffixof "t</dir>;" y))))
(assert (or (not (>= (str.len z) 21)) (= (str.indexof y "d" 0) 1)))
(assert (not (= (str.at z 50) "/")))
(assert (or (not (= (str.at y 109) "o")) (not (= (str.indexof x "c" 0) 26)) (not (str.in_re z ((_ re.from_regex ecma2020) "(^\d{5}$)|(^\d{5}-\d{4}$)")))))
(check-sat)
