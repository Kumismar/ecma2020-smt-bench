; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta onbeforecopy=""alert(1)"" contenteditable>test</meta>") (= x "<div id=""91"">[A]") (= x "<blockquote onmousedown=""alert(1)"">test</blockquote>")))
(assert (or (= z "/img><input autofocus>") (= z "(1)"" contenteditable>test</abbr>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<div id=""91"">[A](1)"" javascript:ntenteditable>test</abbr>" (str.replace y "co" "javascript:"))) (str.contains x "t</b")))
(assert (or (not (>= (str.len y) 79)) (str.in_re x ((_ re.from_regex ecma2020) "^(https?://)[^\s]+$")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[_A-Za-z0-9-+]+(.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(.[A-Za-z0-9]+)*(.[A-Za-z]{2,})$")))))
(assert (or (str.prefixof "<di" y) (not (str.prefixof "<div " x)) (= (str.at x 11) """")))
(assert (or (str.prefixof "<d" x) (= "ocusin=" (str.substr x 23 7))))
(check-sat)
