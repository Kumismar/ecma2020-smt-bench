; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x onxxx%3D1") (= x "<noembed draggable=""true"" ondragleave=""alert(1)"">test</noembed>") (= x "<basefont onmousedown=""alert(1)"">test</basefont>")))
(assert (or (= z "oncontextmenu=""alert(1)"">test</section>") (= z "id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></template>")))
(assert (= y (str.++ x z)))
(assert (str.contains y "lor "))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^.{6,18}$"))) (= (str.indexof y "d>on" 0) 61) (not (= (str.indexof y "onc" 0) 12))))
(assert (or (not (= (str.len x) 111)) (not (str.contains z "(1)><"))))
(assert (= "<noembed draggabx=""true"" ondragleave=""alert(1)"">test</noembed>id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></template>" (str.replace y "le" "x")))
(assert (or (not (= (str.at y 4) "e")) (not (= "xtmenu" (str.substr z 7 6))) (= (str.at z 36) "t")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(([gG][iI][rR] {0,}0[aA]{2})|((([a-pr-uwyzA-PR-UWYZ][a-hk-yA-HK-Y]?[0-9][0-9]?)|(([a-pr-uwyzA-PR-UWYZ][0-9][a-hjkstuwA-HJKSTUW])|([a-pr-uwyzA-PR-UWYZ][a-hk-yA-HK-Y][0-9][abehmnprv-yABEHMNPRV-Y]))) [0-9][abd-hjlnp-uw-zABD-HJLNP-UW-Z]{2}))$"))))
(check-sat)
