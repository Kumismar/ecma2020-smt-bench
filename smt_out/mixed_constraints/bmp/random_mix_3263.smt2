; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead \u{1f4a9}onmouseleave=""alert(1)"">test</\u{1f600}thead>") (= x "<details onkeyup=""alert(1)"" contenteditable>test</details>") (= x "<META HTTP-EQUIV=""refresh"" CONTENT=""0;url=data:text/html base64,PHNjcmlwdD5hbGVydCgnWFNTJyk8L3NjcmlwdD4K"">")))
(assert (or (= z "><section style=""animation-name:x"" onanimationend=""alert(1)""></section>") (= z "able=""true"" ondragenter=""alert(1)"">test</div>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "=""alert(1)")) (not (str.contains z ")"" content"))))
(assert (or (not (= (str.indexof x "wdD" 0) 71)) (str.prefixof "<" x) (str.in_re z ((_ re.from_regex ecma2020) "(?=(.*[0-9]))(?=.*[a-z\u{430}-\u{44f}])(?=(.*[A-Z\u{410}-\u{42f}]))(?=(.*)).{6,20}"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(\+[0-9]{2,}[0-9]{4,}[0-9]*)(x?[0-9]{1,})?$"))))
(assert (= (str.indexof z "on-na" 0) 24))
(assert (or (not (= (str.at y 10) "-")) (not (str.in_re z ((_ re.from_regex ecma2020) "^(\+\d{2})?([\- ]?\d+)+$")))))
(check-sat)
