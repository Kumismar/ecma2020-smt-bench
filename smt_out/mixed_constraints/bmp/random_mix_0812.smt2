; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist draggable=""true"" ondragend=""alert(1)"">test</datalist>") (= x "<title oncontextmenu=""alert(1)"">test</title>") (= x "<tr onmousedown=""alert(1)"">test</tr>")))
(assert (or (= z "editable>test</ul\u{1d400}>") (= z "n-name:x"" onanimationstart=""alert(1)""></spacer>") (= z "\u{20000}w>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(\d+|\d{1,3}(,\d{3})*)(\.\d+)?$"))))
(assert (or (not (<= (str.len x) 53)) (not (= (str.at z 0) "\u{20000}")) (not (= (str.at y 60) ">"))))
(assert (or (= (str.len y) 64) (not (str.suffixof "\u{20000}w>" y))))
(assert (= "ation-nam" (str.substr y 45 9)))
(assert (or (str.suffixof "(1)>" y) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"))) (= "\u{20000}w>" (str.substr z 0 3))))
(assert (or (= ">" (str.substr z 18 9)) (str.in_re z ((_ re.from_regex ecma2020) "^[_A-Za-z0-9-+]+(.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(.[A-Za-z0-9]+)*(.[A-Za-z]{2,})$")) (= (str.at x 34) "n")))
(assert (not (>= (str.len x) 40)))
(check-sat)
