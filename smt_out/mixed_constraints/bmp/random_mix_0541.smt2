; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track draggable=""true"" ondragstart=""alert(1)"">test</track>") (= x "<image xlink:href=""data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' onload='alert(88)'%3E%3C/svg%3E""/>")))
(assert (or (= z " name=""x""><area href onfocusin=alert(1) id=x>") (= z "yle>:target {color: red;}</style><figcaption id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></figcaption>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof ") id=x>" y))
(assert (or (>= (str.len x) 50) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w\-]+$")))))
(assert (str.suffixof ">" z))
(assert (or (= (str.at y 90) "a") (= (str.indexof y "<" 0) 0) (not (= "ul onf" (str.substr x 1 6)))))
(assert (str.suffixof "=x>" z))
(assert (>= (str.len y) 99))
(assert (or (= (str.at y 152) "n") (not (= (str.indexof y "focus" 0) 82)) (= "cusin=a" (str.substr z 25 7))))
(assert (or (= "i" (str.substr z 28 1)) (not (str.in_re z ((_ re.from_regex ecma2020) "^\S.{1,23}\S$")))))
(check-sat)
