; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object draggable=""true"" ondragend=""alert(1)"">test</object>") (= x "<script onkeydown=""alert(1)"" contenteditable>test</script>") (= x "<img draggable=""true"" ondragstart=""alert(1)"">test</img>")))
(assert (or (= z "ver=""alert(1)"">test</dir>") (= z "aste=""alert(1)"" contenteditable>test</rp>") (= z "onbeforedeactivate=alert(1)></button><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "rt") (= "<img draggable=""true""javascript:dragstart=""alert(1)"">test</img>" (str.replace x " on" "javascript:"))))
(assert (or (str.contains z "ta") (not (>= (str.len z) 37)) (str.in_re z ((_ re.from_regex ecma2020) "^((\+\d{1,3}(-| )?\(?\d\)?(-| )?\d{1,5})|(\(?\d{2,6}\)?))(-| )?(\d{3,4})(-| )?(\d{4})(( x| ext)\d{1,5}){0,1}$"))))
(assert (not (= "drag" (str.substr x 27 4))))
(assert (or (str.suffixof "focus>" y) (not (= (str.at z 14) ">")) (str.suffixof "est</dir>" y)))
(assert (not (= "=""alert(1" (str.substr y 17 9))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\(?[1-9]{2}\)?\s?[0-9]{5}-[0-9]{4}$"))))
(assert (or (str.contains z "t(1)""") (not (= "r=""al" (str.substr z 2 5)))))
(assert (>= (str.len y) 63))
(check-sat)
