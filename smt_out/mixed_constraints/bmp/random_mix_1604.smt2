; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form><a href=""javascript:\u{5c}u0061lert&#x28;1&#x29;"">X</script><img/*/src=""worksinchrome&colon;prompt&#x28;1&#x29;""/*/onerror='eval(src)'>") (= x "<style>:target {transform: rotate(180deg);}</style><dfn id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dfn>") (= x "<style>@im\port'\ja\vasc\ript:alert(\""XSS\"")';</style>")))
(assert (or (= z "ap>") (= z ">") (= z "mationend=""alert(1)""></button>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "number_spaces"))) (not (str.prefixof "<" x)) (str.contains x "lert(")))
(assert (or (= (str.len y) 58) (= "ja\vas" (str.substr x 17 6)) (= (str.at x 9) "o")))
(assert (= (str.indexof z ">" 0) 0))
(assert (or (= (str.indexof x "port'" 0) 11) (str.contains (str.replace z "ap>" "x") "x") (not (str.in_re x ((_ re.from_regex ecma2020) "^[6-9]{1}\d{9}$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^\+?[78][-\(]?\d{3}\)?-?\d{3}-?\d{2}-?\d{2}$"))))
(check-sat)
