; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section oncopy=""a\u{1f4a9}lert(1)"" contenteditable>test</sect\u{20000}ion>") (= x "<bdi onmouseup=""alert(1)"">test</bdi>")))
(assert (or (= z "nd=""alert(1)"">test</bgsound>") (= z "alert(';XSS';);"";>;<;/FRAMESET>;")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!#^\-%*_?&])[A-Za-z\d@$!#^\-%_*?&]{6,}")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$")) (= (str.indexof z "<" 0) 19)))
(assert (or (>= (str.len y) 80) (not (= (str.indexof z "SS';" 0) 9)) (not (= (str.indexof z """" 0) 3))))
(assert (not (str.contains (str.replace x "nco" " ") "ion o py=""a")))
(assert (or (str.contains z "FRAMESE") (= "nmouseup=""" (str.substr y 6 10))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]{2,6})+$"))))
(assert (not (str.suffixof ";" z)))
(check-sat)
