; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onmousedown=""alert(1)"">test</cite>") (= x "<i id=x tabindex=1 onfocus=alert(1)></i>")))
(assert (or (= z "g><b onload=alert(1)></b>") (= z "center>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "th><in" (str.substr z 32 6))) (= (str.len x) 40) (not (str.in_re x ((_ re.from_regex ecma2020) "^([ \u{5c}u00c0-\u{5c}u01ffa-zA-Z'\-])+$")))))
(assert (or (str.prefixof "<cite o" x) (= (str.at z 4) "e") (str.in_re y ((_ re.from_regex ecma2020) "^[\u{3041}-\u{3093}\u{30a1}-\u{30f6}\u{3000}\s]+$"))))
(assert (or (= "nload=a" (str.substr y 46 7)) (= (str.indexof z "nter>" 0) 2)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{10,20}"))) (not (str.prefixof " dragga" z))))
(assert (or (not (= (str.at y 3) "t")) (str.contains (str.replace x "it" " ") "<c e ")))
(check-sat)
