; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead onmouseout=""alert(1)"">test</thead>") (= x "<strong draggable=""true\u{1f600}"" ondragenter=""alert(1)"">test</strong>")))
(assert (or (= z """>test</pre>") (= z "rt(1)></hgroup>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "trong>" x)))
(assert (or (not (str.suffixof ">" z)) (= "rou" (str.substr z 10 3)) (= (str.at y 67) "t")))
(assert (or (not (= "<strong draggable=""true\u{1f600}"" ondragenter=""t(1)"">test</strong>rt(1)></hgroup>" (str.replace y """aler" """"))) (str.in_re z ((_ re.from_regex ecma2020) "^(?:[a-zA-Z0-9_\-.\/+]*)(?:@|[a-zA-Z])(?:[a-zA-Z0-9_\-.\/]+)*$"))))
(assert (or (not (= ">test</p" (str.substr z 1 8))) (= "alert(1)"">" (str.substr y 39 10))))
(check-sat)
