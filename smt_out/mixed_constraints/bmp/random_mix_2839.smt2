; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;TABLE>;<;TD BACKGROUND="";javascript:alert(';XSS';)"";>;<;/TD>;<;/TABLE>;") (= x "<table id=x tabindex=1 onfocusin=alert(1)></table>")))
(assert (or (= z "nsition:color 1s"" ontransitionend=alert(1)></basefont>") (= z "/style><hr id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></hr>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "([01]?[0-9]{1}|2[0-3]{1}):[0-5]{1}[0-9]{1}")) (>= (str.len z) 21) (str.contains y " 1s")))
(assert (str.contains x "D B"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{5,}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9]{3,}"))))
(assert (not (= "yle=" (str.substr y 91 4))))
(assert (or (str.prefixof "<table" x) (not (= (str.len x) 73))))
(check-sat)
