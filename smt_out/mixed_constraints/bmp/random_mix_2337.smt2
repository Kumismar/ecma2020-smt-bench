; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><frame id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></frame>") (= x "<ol onmouseout=""alert(1)"">test</ol>")))
(assert (or (= z "keyup=""alert(1)"" contenteditable>test</section>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<ol o" x) (not (str.in_re x ((_ re.from_regex ecma2020) "^[\u{30a1}-\u{30f3}\u{30f4}\u{30fc}0-9|\u{3000}| ]+$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^(https:\/\/)?[a-zA-Z0-9-]*.myshopify.com\/?$")))))
(assert (or (not (= "keyup=" (str.substr z 0 6))) (not (<= (str.len y) 167)) (not (= "ut=""aler" (str.substr x 12 8)))))
(assert (or (str.suffixof "ion>" z) (not (str.prefixof "<ol onmou" x)) (not (str.contains z ">"))))
(assert (= (str.indexof y "=" 0) 45))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]{3}([1-9]\d{0,3})?"))) (not (= (str.at x 40) ")"))))
(check-sat)
