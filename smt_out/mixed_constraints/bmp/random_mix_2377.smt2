; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onafterprint=alert(1)>") (= x "<link onbeforecopy=""alert(1)"" contenteditable>test</link>") (= x "<listing draggable=""true"" ondragleave=""alert(1)"">test</listing>")))
(assert (or (= z """alert(1)"">test</asi\u{1d400}de>\u{20000}") (= z "t autofocus>") (= z "out=""alert(1)"">test</abbr>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof """" z))
(assert (= (str.at y 53) "<"))
(assert (or (= (str.len y) 40) (= (str.len y) 89) (str.prefixof "<body ona" x)))
(assert (or (not (= (str.at y 20) "a")) (not (str.prefixof "s" z)) (not (= "fterprin" (str.substr x 9 8)))))
(assert (or (not (= (str.len y) 69)) (not (str.contains z "focus"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z]+(\s+[a-zA-Z]+)*$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^(\s*)(([A-Za-z]{1,2}[ ]?[0-9]{1,4})|([A-Za-z]{3}[ ]?[0-9]{1,3})|([0-9]{1,3}[ ]?[A-Za-z]{3})|([0-9]{1,4}[ ]?[A-Za-z]{1,2})|([A-Za-z]{3}[ ]?[0-9]{1,3}[ ]?[A-Za-z])|([A-Za-z][ ]?[0-9]{1,3}[ ]?[A-Za-z]{3})|([A-Za-z]{2}[ ]?[0-9]{2}[ ]?[A-Za-z]{3})|([A-Za-z]{3}[ ]?[0-9]{4}))(\s*)$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{7,8}-[0-9Kk]"))))
(assert (not (str.suffixof "=alert(1)>" x)))
(check-sat)
