; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select onmousedown=""alert(1)"">test</select>") (= x "<bgsound oncut=""alert(1)"" contenteditable>test</bgsound>")))
(assert (or (= z " tabindex=1 onfocus=alert(1)></td>") (= z "draggable=""true"" ondrag=""alert(1)"">test</fieldset>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "</td>" z) (not (str.contains (str.replace z "=""tru" "<b>") "e<b>e"" o")) (str.contains y "ag=")))
(assert (not (= (str.at x 8) "o")))
(assert (not (= "t</" (str.substr z 38 3))))
(assert (= (str.indexof y "us" 0) 12))
(assert (not (= "t(1)" (str.substr y 68 4))))
(assert (or (= (str.len y) 94) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{5,9}$")) (= (str.at x 41) "c")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(13[0-9]|14[5|7]|15[0|1|2|3|5|6|7|8|9]|18[0|1|2|3|5|6|7|8|9])\d{8}"))) (not (= (str.len y) 90)) (str.contains y "lert(1)""")))
(assert (= "onmo" (str.substr y 8 4)))
(check-sat)
