; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdi id=x tabindex=1 onbeforeactivate=alert(1)></bdi>") (= x "<script draggabl\u{20000}e=""tr\u{1f600}ue"" ondragleave=""alert(1)"">test</script>") (= x "<strong draggable=""true"" ondragleave=""alert(1)"">test</strong>")))
(assert (or (= z "irm(1)") (= z "ert(1)"">test</embed>") (= z "os;XSS&apos;)&quot;);}&lt;/STYLE&gt;&lt;A CLASS=XSS&gt;&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "rt(" 0) 1)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{10,}$"))))
(assert (or (str.contains z "irm(") (not (= "est</stro" (str.substr y 49 9)))))
(assert (str.suffixof "1)" y))
(assert (or (= "<script raggabl\u{20000}e=""tr\u{1f600}ue"" ondragleave=""alert(1)"">test</script>ert(1)"">test</embed>" (str.replace y "d" "")) (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+\.[A-Za-z0-9.-]+\.[A-Za-z]{1,63}$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[\w\-_&.,`#@!\s]+.{11,}$"))) (= "lert(" (str.substr y 41 5))))
(check-sat)
