; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param draggable=""true"" ondragstart=""alert(1)"">test</param>") (= x "<element id=x tabindex=1 ondeactivate=alert(1)></element><input id=y autofocus>") (= x "<article draggable=""true"" ondragend=""alert(1)"">test</article>")))
(assert (or (= z ">XXX</div>") (= z "ndragstart=""alert(1)\u{1f4a9}"">test</cit\u{1f4a9}e>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 27) "<") (not (= " conte" (str.substr y 26 6))) (= (str.len z) 10)))
(assert (or (not (str.prefixof "<" y)) (str.contains y "e>test</r") (str.suffixof "cus>" x)))
(assert (or (not (>= (str.len z) 33)) (not (>= (str.len x) 57))))
(assert (or (not (str.contains y "nt><inpu")) (not (= (str.at z 32) "\u{1f4a9}"))))
(assert (= (str.at x 12) "a"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z]{1}[a-zA-Z0-9\._#\-]{0,100}@([a-zA-Z0-9\-_\.]){1,100}\.[a-zA-Z]{2,}){1}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{3041}-\u{3093}\u{3094}\u{30fc}\u{3000} ]*$"))))
(assert (= (str.indexof x "ue" 0) 22))
(check-sat)
