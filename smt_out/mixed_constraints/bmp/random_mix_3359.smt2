; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter onmouseenter=""alert(1)"">test</meter>") (= x "<style>@keyframes x{}</style><br style=""animation-name:x"" onanimationend=""alert(1)""></br>")))
(assert (or (= z ":x"" onanimationend=""alert(1)""></video>") (= z "est</header>") (= z "ain>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[0-9()\. -+]{10,15}$")) (str.prefixof "<" x)))
(assert (or (not (= (str.indexof x "aler" 0) 21)) (not (>= (str.len x) 33))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9@-_+\.]{1,100}$")) (str.suffixof "o>" z) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?!:\/\/)(([a-zA-Z0-9]+\.)+)?[a-zA-Z0-9][a-zA-Z0-9-]+\.[a-zA-Z]{2,6}?$")))))
(assert (or (= "<style>@keyframes x{}</style><br style=""ajavascript:mation-name:x"" onanimationend=""alert(1)""></br>est</header>" (str.replace y "ni" "javascript:")) (not (= (str.at z 4) "/")) (not (str.prefixof "ain>" z))))
(assert (or (str.contains x "rt(1)"">") (not (= (str.indexof z "anim" 0) 6))))
(check-sat)
