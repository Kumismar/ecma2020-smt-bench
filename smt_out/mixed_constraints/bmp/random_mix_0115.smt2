; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav\u{1f600} ondblclick=""alert(1)"">test</nav>") (= x "<output oncontextmenu=""alert(1)"">test</output>")))
(assert (or (= z "tenteditable>test</rt>") (= z "65%72%74(/XSS/)></script ????????????")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 29) "1")))
(assert (>= (str.len z) 12))
(assert (or (= (str.at y 24) "l") (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9+ ]{7,18}"))) (not (<= (str.len z) 7))))
(assert (or (= "<output oncontextnu=""alert(1)"">test</output>" (str.replace x "me" "")) (str.prefixof "tentedi" z)))
(assert (or (not (>= (str.len y) 61)) (not (str.in_re y ((_ re.from_regex ecma2020) "-?\d{1,3}\.\d+")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-z0-9\u{430}-\u{44f}\u{451}\u{401}\u{457}\u{407}\u{456}\u{406}\u{454}\u{404}\u{4d8}\u{4d9}\u{492}\u{493}\u{49a}\u{49b}\u{4a2}\u{4a3}\u{4e8}\u{4e9}\u{4ae}\u{4af}\u{4b0}\u{4b1}\u{4ba}\u{4bb}-]*\.[a-z0-9\u{430}-\u{44f}\u{451}\u{401}\u{457}\u{407}\u{456}\u{406}\u{454}\u{404}\u{4d8}\u{4d9}\u{492}\u{493}\u{49a}\u{49b}\u{4a2}\u{4a3}\u{4e8}\u{4e9}\u{4ae}\u{4af}\u{4b0}\u{4b1}\u{4ba}\u{4bb}.-]*[a-z0-9\u{430}-\u{44f}\u{451}\u{401}\u{457}\u{407}\u{456}\u{406}\u{454}\u{404}\u{4d8}\u{4d9}\u{492}\u{493}\u{49a}\u{49b}\u{4a2}\u{4a3}\u{4e8}\u{4e9}\u{4ae}\u{4af}\u{4b0}\u{4b1}\u{4ba}\u{4bb}]+$"))))
(check-sat)
