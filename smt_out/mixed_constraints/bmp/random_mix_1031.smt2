; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe src=http://ha.ckers.org/scriptlet.html <") (= x "<strong onblur=alert(1) tabindex=1 id=x></strong><input autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><u ondragover=alert(1) contenteditable>drop here</u>")))
(assert (or (= z ">") (= z "VydCgnWFNTJyk8L3NjcmlwdD4K\""&gt;")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z ">" 0) 0)))
(assert (or (= "<tr ck id=x tabindex=1 onfocusin=alert(1)></track>/s>" (str.replace y "a" " ")) (not (str.prefixof "<div" x)) (str.contains y "://")))
(assert (str.contains x "rago"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[ \t\r\n\f0-9-()-+]*$"))) (= "<track oncontextmenu=""aalert(1)t(1)"">test</track>semove=""alert(1)"">test</map>" (str.replace y "ler" "alert(1)"))))
(assert (or (<= (str.len y) 114) (not (str.in_re y ((_ re.from_regex ecma2020) "[- \.a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}\u{e1}\u{e0}\u{e9}\u{e8}\u{ed}\u{ec}\u{f3}\u{f2}\u{fa}\u{f9}\u{e2}\u{ea}\u{ee}\u{f4}\u{fb}0-9]{3,}")))))
(assert (or (not (= "ue"" c" (str.substr y 18 5))) (str.prefixof "<sty" x) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_.-]+$")))))
(assert (or (not (= (str.indexof x "me sr" 0) 5)) (not (= (str.indexof x "SS" 0) 24))))
(assert (not (str.suffixof "dD4K\""&gt;" z)))
(check-sat)
