; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<td onbeforecut=""alert(1)"" contenteditable>test</td>") (= x "<meta onkeyup=""alert(1)"" contenteditable>test</meta>")))
(assert (or (= z "src=1.gif onerror=alert(1)>") (= z "! foo=""><script>javascript:alert(1)</script>"">")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{30a1}-\u{30f3}\u{30f4}\u{30fc}\u{3000}]+$"))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{10,}")))
(assert (str.contains x "forecut=""a"))
(assert (not (= (str.indexof y "let>:" 0) 95)))
(assert (or (= (str.indexof x "e" 0) 7) (not (= (str.at y 29) "e")) (str.suffixof "t(1)>" y)))
(assert (or (= (str.at z 1) "r") (= (str.indexof z " oner" 0) 9)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(.){4,}$"))) (= "<mxta onkeyup=""alert(1)"" contenteditable>test</meta>" (str.replace x "e" "x"))))
(check-sat)
