; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var draggable=""true"" ondrag=""alert(1)"">test</var>") (= x "<span onfocusout=alert(1) tabindex=1 id=x></span><input autofocus>") (= x "<figcaption d\u{20000}raggable=""true"" ondra\u{1d400}gend=""alert(1)"">test</figcaption>")))
(assert (or (= z "OU WANT TO BE DISPLAYED`);</script><iframe frameborder=""0%EF%BB%BF") (= z "ldset>") (= z "#X003c;")))
(assert (= y (str.++ x z)))
(assert (or (= "<var <b>aggable=""true"" ondrag=""alert(1)"">test</var>" (str.replace x "dr" "<b>")) (= (str.indexof x "=""tr" 0) 14)))
(assert (not (str.suffixof "et>" z)))
(assert (or (= "<figcaption d\u{20000}raggable=""true"" ondra\u{1d400}gend=""alert"">test</figcaption>" (str.replace x "(1)""" """")) (str.prefixof "l" z) (not (= (str.len x) 69))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9 _-\u{e9}\u{e8}\u{ef}\u{f6}\u{e7}]+$"))) (str.contains z "et>")))
(check-sat)
