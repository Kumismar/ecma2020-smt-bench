; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onmouseenter=""alert(1)"">test</html>") (= x "&#x3C")))
(assert (or (= z "able=""true"" ondragleave=""alert(1)"">test</head>") (= z " src=x onerror=javascript:alert(""A"")>")))
(assert (= y (str.++ x z)))
(assert (or (not (= " onbefore" (str.substr x 8 9))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9]{0,1}$")))))
(assert (or (= (str.indexof z ">tes" 0) 34) (str.suffixof "ert(""A"")>" y)))
(assert (not (= "te=alert(1" (str.substr y 36 10))))
(assert (str.suffixof ">" x))
(assert (= (str.indexof y "x one" 0) 10))
(assert (= (str.at x 0) "&"))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{10,}")) (str.prefixof "&#x3Ca" y) (not (str.contains y "icle onmo"))))
(check-sat)
