; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<map id=x tabindex=1 onb\u{20000}eforedeactivate=alert(1)></map><inp\u{1f4a9}ut autofocus>") (= x "<slot id=x tabindex=1 onfocus=alert(1)></slot>") (= x "<ul draggable=""true"" ondragleave=""alert(1)"">test</ul>")))
(assert (or (= z "eup=""alert(1)"">test</footer>") (= z "ooIQZr") (= z "test</button>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 23) (not (str.in_re y ((_ re.from_regex ecma2020) "^([0-9 -]){6,6}$")))))
(assert (not (= "<dajavascript:a onblur=alert(1) tabindex=1 id=x></data><input autofocus>r==1)?'':eval('r=1;" (str.replace y "t" "javascript:"))))
(assert (or (<= (str.len x) 107) (= (str.at x 5) "r") (not (= (str.at z 3) "="))))
(assert (or (not (= (str.indexof x "deact" 0) 30)) (not (= (str.at x 8) "g"))))
(assert (not (= (str.indexof x "va" 0) 36)))
(assert (or (str.prefixof "<n" y) (not (= "<slot id=x tabindex=1 javascript:ocus=alert(1)></slot>test</button>" (str.replace y "onf" "javascript:")))))
(assert (or (= (str.indexof x "<s" 0) 0) (not (str.in_re z ((_ re.from_regex ecma2020) "^(1[0-2]|0?[1-9])$")))))
(check-sat)
