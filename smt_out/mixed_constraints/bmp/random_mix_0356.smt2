; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd onmouseout=""alert(1)"">test</kbd>") (= x "<style>:target {color: red;}</style><datalist id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></datalist>") (= x "<dir onkeydown=""alert(1)"" contenteditable>test</dir>")))
(assert (or (= z "ption]]""><x foo=""]foo><script>alert(1)</script>"">") (= z "itable>drop here</embed>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]*\.?[0-9]+"))))
(assert (or (str.suffixof "/script>"">" y) (not (= (str.at y 106) ")")) (not (str.prefixof "<kbd onmou" y))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[04](([0-9]){2,})"))) (not (str.prefixof "<sty" y))))
(assert (or (= (str.indexof z " her" 0) 11) (not (<= (str.len z) 58)) (not (>= (str.len y) 142))))
(assert (= (str.at y 9) "y"))
(check-sat)
