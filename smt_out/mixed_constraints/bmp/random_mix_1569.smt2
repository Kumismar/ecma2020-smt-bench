; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x16javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<mark id=x tabindex=1 onbeforedeactivate=alert(1)></mark><input autofocus>") (= x "<style>:target {color: red;}</style><base id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></base>")))
(assert (or (= z "xxx:x />") (= z """alert(1)"">test</ul>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "/>" y))
(assert (str.contains (str.replace y "r 1" "") "o0"))
(assert (or (not (= (str.at x 6) "f")) (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{3}-[0-9]{4}$")) (not (str.suffixof ":x />" z))))
(assert (or (str.prefixof "xxx" z) (>= (str.len y) 73)))
(assert (or (not (<= (str.len z) 25)) (not (str.prefixof "<a onblur=" y))))
(assert (or (not (= (str.indexof y "=" 0) 7)) (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-9]|0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$"))) (= (str.indexof y "d" 0) 7)))
(check-sat)
