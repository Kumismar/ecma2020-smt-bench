; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<head onkeypress=""alert(1)"" contenteditable>test</head>") (= x "<figcaption draggable=""true"" ondrag=""alert(1)"">test</figcaption>") (= x "<kbd draggable=""true"" ondragleave=""alert(1)"">test</kbd>")))
(assert (or (= z ">") (= z "s';</STYLE>") (= z "ditable>test</input>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "0ip" 0) 6) (= (str.indexof y "ndra" 0) 30) (str.prefixof "<kbd drag" x)))
(assert (or (not (str.suffixof "</input>" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9-()]*$"))) (>= (str.len x) 52)))
(assert (= (str.at x 18) "b"))
(assert (or (not (= (str.indexof y "(1" 0) 42)) (not (str.suffixof "E>" z))))
(check-sat)
