; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><cite onload=alert(1)></cite>") (= x "<frame draggable=""true"" ondragleave=""alert(1)"">test</frame>")))
(assert (or (= z "nblur=alert(1) tabindex=1 id=x></h1><input autofocus>") (= z "est</html>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<frame dra" x))
(assert (or (str.contains (str.replace x "p her" """") "o""e</t") (= (str.at z 18) "i") (str.prefixof "<svg>" x)))
(assert (or (not (str.contains (str.replace x "r" "<b>") "ale<b>t(1)")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9][a-zA-Z0-9\- ]{0,10}?[a-zA-Z0-9]$"))) (str.in_re z ((_ re.from_regex ecma2020) "^[\\+]{0,1}[0-9]{6,12}$"))))
(assert (or (str.contains (str.replace z "put " " ") "1><in aut") (not (= (str.indexof y "e=""" 0) 15))))
(assert (or (not (= (str.len z) 53)) (str.prefixof "<fra" x)))
(assert (or (str.contains x "rt(1)") (not (str.contains z "d="))))
(assert (or (not (= (str.at z 25) " ")) (str.contains x "=aler")))
(check-sat)
