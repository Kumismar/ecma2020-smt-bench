; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure onmousemove=""alert(1)"">test</figure>") (= x "<script onmouseout=""alert(1)"">test</script>") (= x "<sub id=x tabindex=1 ondeactivate=alert(1)></sub><input id=y autofocus>")))
(assert (or (= z "<input autofocus>") (= z "r oncut=""alert(1)"" contenteditable>test</var>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^14$"))) (str.contains z "table")))
(assert (not (str.suffixof "focus>" y)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^0[0-9].*$"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*\d)(?=.*[a-zA-Z])(?!.*\s).{6,15}$")) (not (= (str.at x 40) "u"))))
(assert (or (= (str.len y) 61) (str.prefixof "<s" x) (not (= (str.indexof y "r " 0) 44))))
(assert (= "<B>docume" (str.substr y 8 9)))
(assert (str.contains x "move=""a"))
(assert (or (= (str.indexof x "activ" 0) 30) (str.suffixof "st</var>" z) (= (str.at x 20) """")))
(assert (not (= (str.indexof x "le=t" 0) 57)))
(check-sat)
