; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<listing onbeforepaste=""alert(1)"" contenteditable>test</listing>") (= x "<rb onblur=alert(1) tabindex=1 id=x></rb><input autofocus>") (= x "<strong onbeforepaste=""alert(1)"" contenteditable>test</strong>")))
(assert (or (= z "rt(1)//"">") (= z ")"">test</blockquote>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<listing" y)) (not (<= (str.len y) 67)) (not (= "/"">" (str.substr z 6 8)))))
(assert (or (str.prefixof ")"">" z) (str.in_re x ((_ re.from_regex ecma2020) "^(?!0{5})(\d{5})(?!-?0{4})(|-\d{4})?$"))))
(assert (or (not (= "l" (str.substr y 25 1))) (not (= "<strong onbeforjavascript:e=""alert(1)"" contenteditable>test</strong>" (str.replace x "epast" "javascript:"))) (not (str.contains z "//"">"))))
(assert (or (str.contains (str.replace z "(1)" "x") "rtx/") (not (= "<strong onbeforepasx=""alert(1)"" contenteditable>test</strong>" (str.replace x "te" "x"))) (= (str.indexof z "o" 0) 11)))
(assert (or (= (str.indexof x "rong" 0) 3) (not (str.prefixof "<listi" y))))
(check-sat)
