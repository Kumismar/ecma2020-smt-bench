; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><basefont style=""animation-name:x"" onanimationend=""alert(1)""></basefont>") (= x "<details ontoggle=alert(1) open>test</details>")))
(assert (or (= z "/style><tfoot id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tfoot>") (= z "\xBFexpress\u{1f600}ion(javascript:alert(1)"">DEF") (= z "ggable=""true"" contenteditable>drag me</div><content ondragover=alert(1) contenteditable>drop here</content>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "g" z) (not (= "<style>:target {color:red;}</style><base id=x style=""transitx:color 1s"" ontransitionend=alert(1)></base> id=y autofocus>" (str.replace y "ion" "x"))) (str.contains y "lert(1)></")))
(assert (or (str.contains y "ansf") (not (str.in_re y ((_ re.from_regex ecma2020) "^[_A-z0-9._%+-]+@[_A-z0-9.-]+\.[_A-z]{1,}$"))) (not (str.prefixof "<style" x))))
(assert (or (str.suffixof "ot>" z) (not (= "yle=""anima" (str.substr x 41 10)))))
(assert (or (<= (str.len y) 212) (str.suffixof "(1)"">DEF" z)))
(check-sat)
