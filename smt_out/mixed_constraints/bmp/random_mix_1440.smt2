; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q oncut=""alert(1)"" contenteditable>test</q>") (= x "perl -e 'print \""&lt;IMG SRC=java\0script&#058;alert(\\""XSS\\"")&gt;\"";' &gt; out")))
(assert (or (= z "lert(&apos;XSS&apos;)&quot;&gt;&lt;/TABLE&gt;") (= z "ion(alert(123))][color]") (= z "ert(1)""></svg onunload>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "e>" (str.substr x 36 2))) (not (= (str.len y) 67)) (not (str.in_re x ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$")))))
(assert (or (= "perl -e 'print \""&ltxMG SRC=java\0script&#058;alert(\\""XSS\\"")&gt;\"";' &gt; out" (str.replace x ";I" "x")) (= "t" (str.substr x 51 1))))
(assert (<= (str.len y) 76))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^\S{6,32}$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\-\.\+]*)([a-zA-Z0-9_\-])@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,10}|[0-9]{1,3})(\]?)$"))) (= (str.at y 67) "\")))
(check-sat)
