; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary draggable=""true"" ondragenter=""alert(1)"">test</summary>") (= x "<IMG SRC=x onresize=""alert(String.fromCharCode(88,83,83))"">") (= x "<object onbeforecut=""alert(1)"" contenteditable>test</object>")))
(assert (or (= z "e;//--></script>") (= z "(1)"">test</nobr>") (= z "rt(1)"">test</button>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "nobr>" z)) (not (str.suffixof "/script>" z)) (not (str.contains (str.replace y "=" " ") "SRC x "))))
(assert (or (not (= "<am onclick=""alert(1)"">test</acronym>utofocus>" (str.replace y "crony" ""))) (= (str.indexof y "r" 0) 35)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&\u{2019}*+\/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[-a-z0-9!#$%&'*+\/=?^_`{|}~]+(\.[-a-z0-9!#$%&'*+\/=?^_`{|}~]+)*@(([a-z0-9]([-a-z0-9]*[a-z0-9]+)?){1,63}\.)+([a-z0-9]([-a-z0-9]*[a-z0-9]+)?){2,63}$"))) (not (= (str.len z) 16))))
(assert (or (not (str.suffixof "</script>" z)) (not (str.prefixof "<" y)) (= (str.len z) 76)))
(assert (= (str.at x 22) "u"))
(check-sat)
