; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i id=x tabindex=1 onactivate=alert(1)></i>") (= x "<dl onkeydown=""alert(1)"" contenteditable>test</dl>")))
(assert (or (= z "plaintext onclick=""alert(1)"">test</plaintext>") (= z "iv><element ondragover=alert(1) contenteditable>drop here</element>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "([0-9]{1,2}[A-Za-z])|()"))) (str.contains (str.replace x "t(1)" " ") "er "" ") (str.prefixof "<dl on" y)))
(assert (= (str.len y) 60))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[Bb]\d{8}")) (not (= (str.at z 38) "t")) (not (str.prefixof "plain" z))))
(assert (or (>= (str.len z) 35) (str.contains y "cel=ale")))
(assert (= "<dl onkeydo""n=""alert(1)"" contenteditable>test</dl>" (str.replace x "w" """")))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{5}$")))
(assert (str.prefixof " onfo" z))
(assert (or (not (= "</i>" (str.substr x 39 6))) (= "xt" (str.substr y 57 2))))
(assert (not (= "drop here<" (str.substr z 48 10))))
(check-sat)
