; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<output draggable=""true"" ondragstart=""alert(1)"">test</output>") (= x "<element draggable=""true"" ondragleave=""alert(1)"">test</element>")))
(assert (or (= z "t>\u{1d400}") (= z """; AllowScriptAccess="";always"";>;<;/EMBED>;") (= z "mouseover=""alert(document.cookie)""></IFRAME>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "\([0-9]{2}\) [0-9]{8,9}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z\u{c0}\u{c1}\u{c2}\u{c3}\u{c4}\u{c5}\u{c6}\u{c7}\u{c8}\u{c9}\u{ca}\u{cb}\u{cc}\u{cd}\u{ce}\u{cf}\u{d0}\u{d1}\u{d2}\u{d3}\u{d4}\u{d5}\u{d6}\u{d8}\u{d9}\u{da}\u{db}\u{dc}\u{dd}\u{de}\u{df}\u{e0}\u{e1}\u{e2}\u{e3}\u{e4}\u{e5}\u{e6}\u{e7}\u{e8}\u{e9}\u{ea}\u{eb}\u{ec}\u{ed}\u{ee}\u{ef}\u{f0}\u{f1}\u{f2}\u{f3}\u{f4}\u{f5}\u{f6}\u{f8}\u{f9}\u{fa}\u{fb}\u{fc}\u{fd}\u{fe}\u{ff}]*$"))) (not (<= (str.len y) 112))))
(assert (not (= "art=""" (str.substr x 33 5))))
(assert (or (= (str.at x 7) "t") (= "eover=" (str.substr z 7 6)) (not (str.contains (str.replace y "ptA" "javascript:") "wScrijavascript:cce"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{1,}$"))) (not (= "e=""tr" (str.substr x 17 5))) (= (str.at x 2) "u")))
(assert (or (= (str.at z 7) "w") (str.suffixof "t</output>" x)))
(check-sat)
