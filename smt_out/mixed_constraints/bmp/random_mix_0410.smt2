; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea onpaste=alert(1) autofocus></textarea>") (= x "<blockquote onbeforepaste=""alert(1)"" contenteditable>test</blockquote>")))
(assert (or (= z "gstart=""alert(1)"">test</nobr>") (= z "imationstart=""\u{1f4a9}alert(1)""\u{1d400}></element>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "(1)"" " 0) 32)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^(\+33|0|0033)[12345679][1-9]\d{7}$")))
(assert (or (not (str.contains z "element")) (str.suffixof "r>" y) (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]+( [a-zA-Z]+)*$"))))
(assert (= "onfocus=al" (str.substr x 25 10)))
(assert (or (not (= "te>" (str.substr x 67 5))) (not (= "gstart=""""ert(1)"">test</nobr>" (str.replace z "al" """")))))
(assert (or (not (str.suffixof ">" z)) (str.contains y "=""\u{1f4a9}alert(") (not (= "1) aut" (str.substr x 24 6)))))
(check-sat)
