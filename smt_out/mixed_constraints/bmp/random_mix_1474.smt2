; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><address onload=a\u{1d400}le\u{1f4a9}rt(1)></address>") (= x "<base oncontextmenu=""alert(1)"">test</base>") (= x "<svg onbeforecopy=""alert(1)"" contenteditable>test</svg>")))
(assert (or (= z "change=alert(1)>") (= z "img src=xss onerror=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "n" 0) 7))
(assert (str.prefixof "i" z))
(assert (str.prefixof "foo<scrip" y))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^.+@.+\..+$"))) (not (str.suffixof "address>" x))))
(assert (or (= """ ondra" (str.substr z 8 7)) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\+42(0|1) ?|0)?([1-9]{1}[0-9]{2} ?[0-9]{3} ?[0-9]{3})$")))))
(assert (or (not (str.contains y "t"" ")) (not (<= (str.len x) 58)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[^\f\n\r\t\v]{2,44}$")))))
(assert (or (not (str.suffixof "test</svg>" x)) (not (= (str.indexof x ">test" 0) 30))))
(check-sat)
