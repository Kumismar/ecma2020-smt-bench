; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<scr<script>ipt>alert('XSS');</scr</script>ipt>") (= x "<u draggable=""true"" ondragstart=""alert(1)"">test</u>") (= x "<fieldset onbeforepaste=""alert(1)"" contenteditable>test</fieldset>")))
(assert (or (= z "cript>") (= z "nd=alert(1)></li>") (= z " oncopy=""alert(1)"" contenteditable>test</sup>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 38) "(") (not (str.in_re y ((_ re.from_regex ecma2020) "^[Bb]\d{8}")))))
(assert (not (str.contains y "(1)"" con")))
(assert (or (str.contains (str.replace y "drags" "<b>") " on<b>tart") (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9]{10})$")))))
(assert (or (= "<u draggable=""true"" ondragstaalert(1)alert(1)"">test</u>cript>" (str.replace y "rt=""" "alert(1)")) (= (str.at z 9) "1")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[#.0-9a-zA-Z\s,-/']{3,250}"))))
(assert (= (str.at y 47) "<"))
(assert (str.contains z "ble>"))
(check-sat)
