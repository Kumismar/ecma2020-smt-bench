; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div/onmouseover='alert(1)'> style=""x:"">") (= x "<style>@keyframes x{}</style><noscript style=""animation-name:x"" o\u{1d400}nanimationend=""alert(1)""></noscript>") (= x "<IMG SRC=javascript:alert('XSS')>")))
(assert (or (= z "avaSCRIPT&colon;confirm&lpar;1&rpar;""") (= z "=""\u{20000}alert(1)"" contenteditable>test</command>") (= z "href=""\x18javascript:javascript:alert(1)\u{1f600}"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (= "<bgsound SRC=""jalert(1)vascript:document.vulnerable=true;"">" (str.replace x "a" "alert(1)")) (= (str.at y 72) ")") (str.contains x "pt:al")))
(assert (str.contains z "par;"""))
(assert (or (not (str.prefixof "<style>@" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9.,]+(%){0,1}")))))
(assert (or (not (str.contains y "</a")) (str.prefixof "<div/o" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{3,}"))) (not (>= (str.len x) 49)) (not (<= (str.len y) 109))))
(assert (or (not (str.suffixof "r;1&rpar;""" y)) (= (str.at y 2) "M")))
(check-sat)
