; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg onmouseover=""alert(1)"">test</\u{1d400}svg>") (= x "<center draggable=""true"" ondragenter=""alert(1)"">test</center>") (= x "<style>:target {color: red;}</style><td id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></td>")))
(assert (or (= z "ition:color 1s"" ontransitionend=alert(1)></html>") (= z "t(1)"">test</dfn>") (= z "t>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "</" 0) 16) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-z0-9_.+-]+@[a-z0-9-]+\.[a-z0-9-.]+$")))))
(assert (or (= (str.indexof z "(1)><" 0) 37) (<= (str.len z) 54)))
(assert (or (>= (str.len y) 151) (not (= (str.len x) 39))))
(assert (str.contains (str.replace y "d>t(" "x") "</tx1)"))
(assert (not (str.suffixof "dfn>" z)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$")))
(check-sat)
