; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>d.innerHTML+='';</script>") (= x "<b onbeforepaste=""alert(1)"" contenteditable>test</b>") (= x "<div draggable=""true"" contenteditable>drag me</div><rtc ondragover=alert(1) contenteditable>drop here</rtc>")))
(assert (or (= z "itable>drop here</center>") (= z "ing>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9-_\.]{2,20}$"))) (= ">ing>" (str.substr y 32 10)) (not (= (str.indexof y "scr" 0) 1))))
(assert (or (not (= (str.indexof z "g" 0) 2)) (not (str.prefixof "<" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-HJ-NPR-Za-hj-npr-z\d]{8}[\dX][A-HJ-NPR-Za-hj-npr-z\d]{8}")))))
(assert (str.prefixof "<script" x))
(assert (= (str.indexof y "dro" 0) 59))
(check-sat)
