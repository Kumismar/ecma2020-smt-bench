; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><base id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></base>") (= x "<input onfocusout=alert(1) id=x><input autofocus>") (= x "<a aa aaa aaaa aaaaa aaaaaa aaaaaaa aaaaaaaa  aaaaaaaaa aaaaaaaaaa  href=j&#97v&#97script&#x3A;&#97lert(1)>ClickMe")))
(assert (or (= z "st</bdo>") (= z "ipt>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 26) " ") (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{20,25}$"))) (not (= (str.len x) 111))))
(assert (or (str.prefixof "<style>:" y) (not (= (str.len z) 9)) (not (str.contains (str.replace x ">:tar" "alert(1)") "lealert(1)g"))))
(assert (not (str.prefixof "st</b" z)))
(assert (str.suffixof "t>" y))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*?[1-9])\d{3,5}(\.\d+)?$"))) (str.contains (str.replace z "nu>" "x") "x") (not (str.contains (str.replace x "a" "alert(1)") "ut=alert(1)l"))))
(assert (str.prefixof "<style" x))
(check-sat)
