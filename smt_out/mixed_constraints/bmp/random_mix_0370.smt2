; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend onmousemove=""alert(1)"">test</legend>") (= x "<select id=x tabindex=1 onbeforeactivate=alert(1)></select>") (= x "<command onbeforecut=""alert(1)"" contenteditable>test</command>")))
(assert (or (= z """alert(1)"">test</content>") (= z "teditable>drag me</div><tt ondragover=alert(1) contenteditable>drop here</tt>") (= z "nteditable>test</time>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ">" y) (not (= (str.at x 33) "c")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[-+.\w]{1,64}@[-.\w]{1,64}\.[-.\w]{2,6}$")))))
(assert (or (= (str.at x 48) ")") (not (= """alerjavascript:)"">test</content>" (str.replace z "t(1" "javascript:"))) (str.in_re x ((_ re.from_regex ecma2020) "^\d{4}\s\d{4}$"))))
(assert (or (not (= "rt(1)>" (str.substr x 44 6))) (= (str.indexof x "ou" 0) 11)))
(assert (or (not (= (str.at z 2) "l")) (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{5}(-\d{4})?$")))))
(check-sat)
