; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u id=x tabindex=1 onbeforeactivate=alert(1)></u>") (= x "&lt;A HREF=\""http&#58;//66&#46;102&#46;7&#46;147/\""&gt;XSS&lt;/A&gt;")))
(assert (or (= z "ggable=""true"" contenteditable>drag me</div><thead ondragover=alert(1) contenteditable>drop here</thead>") (= z "ocus>") (= z " onfocus=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "o" z))
(assert (or (str.contains (str.replace y " id=x" "x") "<subx ") (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9a-zA-Z]{1,15}$"))) (= (str.indexof z "s>" 0) 3)))
(assert (<= (str.len y) 87))
(assert (or (not (= (str.indexof y "nt" 0) 84)) (not (str.contains x "nbefo")) (str.contains x "ndex=1 o")))
(assert (or (= (str.indexof y "d=x t" 0) 4) (= "onbef" (str.substr y 3 5))))
(check-sat)
