; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div \u{1d400}draggable=""true"" contenteditable>drag me</div><s ondragover=alert(1) contenteditable>drop here</s>") (= x "<bdo onmouseenter=""alert(1)"">test</bdo>") (= x "<style>:target {transform: rotate(180deg);}</style><style id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></style>")))
(assert (or (= z "d draggable=""true"" ondragstart=""alert(1)"">test</kbd>") (= z "</spacer>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "acer>" y)) (not (= (str.at x 79) "e")) (= (str.at y 51) ">")))
(assert (str.prefixof "<s" y))
(assert (or (= (str.at z 2) "s") (str.prefixof "<div \u{1d400}drag" y)))
(assert (or (not (= "1)<" (str.substr z 27 3))) (= (str.indexof x "/bd" 0) 34) (not (= "d draggabalert(1)true"" ondragstart=""alert(1)"">test</kbd>" (str.replace z "le=""" "alert(1)")))))
(assert (or (str.contains x "ou") (not (str.in_re y ((_ re.from_regex ecma2020) "[^ @]*@[^ @]*\.[^ @]{2,}"))) (str.contains (str.replace z "/spac" "javascript:") "<javascript:er>")))
(assert (= "ed" (str.substr x 82 2)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(.){6,}$"))))
(check-sat)
