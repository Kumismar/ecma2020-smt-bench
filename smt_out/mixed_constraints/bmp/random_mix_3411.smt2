; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby id=x tabindex=1 onfocusin=alert(1)></ruby>") (= x "&lt;HTML&gt;&lt;BODY&gt;")))
(assert (or (= z "wbr>") (= z "drag me</div><wbr ondrop=alert(1) contenteditable>drop here</wbr>") (= z "HREF="";http://0x42.0x0000066.0x7.0x93/"";>;XSS<;/A>;")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "L&g" 0) 7))
(assert (or (str.contains z "="";htt") (not (str.prefixof "<s" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[p{Z}s]*(?:[^p{Z}s][p{Z}s]*){4,100}$")))))
(assert (or (= (str.at z 28) "r") (not (str.suffixof "y>" x)) (not (= (str.indexof y "e" 0) 17))))
(assert (or (= (str.at z 16) "4") (str.contains (str.replace y ";&" """") "ML&gt""l") (not (str.suffixof "t;wbr>" y))))
(check-sat)
