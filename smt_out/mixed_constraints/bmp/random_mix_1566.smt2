; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>dr\u{1f600}ag me</div><isindex ondrop=alert(1) cont\u{1f4a9}enteditable>drop here</isindex>") (= x "<input autofocus onfocus=alert(1)>") (= x "&lt;SCRIPT =&quot;blah&quot; SRC=&quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;")))
(assert (or (= z "ex=1 id=x></spacer><input autofocus>") (= z "0080c744f389&gt;&lt;param name=url value=javascript&#058;alert('XSS')&gt;&lt;/OBJECT&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "ex=1 " z) (not (= "ex=1" (str.substr x 18 4))) (str.contains z "OBJEC")))
(assert (or (<= (str.len y) 77) (not (= (str.at x 19) "f")) (str.contains y "ble>")))
(assert (or (str.contains z "S')&gt;&") (not (= ">dr\u{1f600}ag" (str.substr y 37 6))) (= (str.indexof y "ro" 0) 64)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[\u{e4}\u{fc}\u{f6}a-z0-9.-]+\.[a-z]{2,63}$"))))
(check-sat)
