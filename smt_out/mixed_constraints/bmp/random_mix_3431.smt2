; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><script id=x style=""transition:color 1s"" ontransitionend=alert(1)></script>") (= x "<ins onmouseout=""alert(1)"">test</ins>") (= x "<data id=x tabindex=1 ondeactivate=alert(1)></data><input id=y autofocus>")))
(assert (or (= z "APAAi-") (= z "r=alert(1) contenteditable>drop here</option>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "ere" """") "rop h""</o") (not (= "tivate=a" (str.substr x 28 8)))))
(assert (or (not (= "PAAi-" (str.substr z 1 5))) (str.prefixof "<style>:" x)))
(assert (or (str.suffixof "-" y) (not (str.suffixof ">APAAi-" y)) (= " her" (str.substr y 141 4))))
(assert (or (str.suffixof "AAi-" z) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?:(010-\d{4})|(01[1|6|7|8|9]-\d{3,4}))-(\d{4})$")))))
(assert (or (= (str.indexof x "le=""" 0) 11) (<= (str.len x) 74)))
(assert (<= (str.len z) 6))
(check-sat)
