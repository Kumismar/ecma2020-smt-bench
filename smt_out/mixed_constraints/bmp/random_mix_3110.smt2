; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input id=x tabindex=1 ondeactivate=alert(1)></input><input id=y autofocus>") (= x "<abbr onblur=alert(1) tabindex=1 id=x></abbr><input autofocus>")))
(assert (or (= z ">") (= z "onkeydown=""alert(1)"" contenteditable>test</div>") (= z "nt>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "ert" (str.substr x 38 3))) (= (str.at x 53) "r") (not (str.prefixof ">" z))))
(assert (= "<abbr onblur=alert(1) tabind""=1 id=x></abbr><input autofocus>" (str.replace x "ex" """")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(.+){5}(-(.+){4})?$"))))
(assert (not (= (str.indexof z ">" 0) 0)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^\S.*\S")))
(assert (not (= "<<b>onblur=alert(1) tabindex=1 id=x></abbr><input autofocus>" (str.replace x "abbr " "<b>"))))
(assert (not (= "ente" (str.substr z 25 4))))
(assert (or (str.suffixof "ocus>" x) (str.in_re y ((_ re.from_regex ecma2020) "^.{7,255}$"))))
(check-sat)
