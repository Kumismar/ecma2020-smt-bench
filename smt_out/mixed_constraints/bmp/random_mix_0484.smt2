; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video onloadstart=alert(1)><source>") (= x "<style>:target {color: red;}</style><strike id=x style=""transition:color 10s"" on\u{10348}trans\u{1f4a9}itioncancel=alert(1)></strike>") (= x "<legend onmouseleave=""alert(1)"">test</legend>")))
(assert (or (= z "ame:x"" onanimationstart=""alert(1)""></option>") (= z "alert(1)></base><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "t(1" 0) 4)) (not (= (str.len x) 36)) (= (str.at z 26) "y")))
(assert (or (not (str.contains y "ns\u{1f4a9}")) (= (str.indexof y "ut i" 0) 56)))
(assert (or (= "e><" (str.substr z 14 3)) (= (str.at z 17) "i")))
(assert (or (not (str.contains (str.replace x "t=al" "<b>") "star<b>er")) (not (str.in_re y ((_ re.from_regex ecma2020) "(?=.*[a-zA-Z]).{2,}")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9]{5,10}"))) (str.contains y "er")))
(assert (str.contains x "eave"))
(assert (or (not (= (str.at z 2) "\u{17e}")) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9])(?=.*?[#?!@$%^&*-]).{8,}$")))))
(assert (not (str.suffixof "trike>" x)))
(check-sat)
