; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet onmouseleave=""alert(1)"">test</applet>") (= x "<section onmousedown=""alert(1)"">test</section>")))
(assert (or (= z "ansform: rotate(180deg);}</style><blink id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></blink>") (= z "est</pre>") (= z "></map>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "/section>" x) (str.suffixof "l>" x)))
(assert (or (not (str.suffixof "/map>" y)) (= (str.indexof y "ple" 0) 3)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^\d*(\.\d{0,2})?$")) (= (str.at z 5) "p") (str.contains z "est</pr")))
(assert (not (str.contains (str.replace z "/" "x") "}<xstyle")))
(check-sat)
