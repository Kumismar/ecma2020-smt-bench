; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u drag\u{20000}gable=""true"" on\u{1d400}dragend=""alert(1)"">test</u>") (= x "<style>@keyframes x{}</style><object style=""animation-name:x"" onanimationend=""alert(1)""></object>") (= x "<command onmouseenter=""alert(1)"">test</command>")))
(assert (or (= z "ncut=""alert(1)"" contenteditable>test</big>") (= z "!#$%&()*~+-_.,:;?@[/|\]^`=document.vulnerable=true;>") (= z " ontransitioncancel=alert(1)></sup>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "nmouseente")))
(assert (str.contains y "^`=d"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[1-9][0-9]{3,}$"))) (= (str.indexof z ": ur" 0) 4) (>= (str.len x) 95)))
(assert (str.prefixof "<comm" y))
(assert (= (str.indexof x "}</s" 0) 20))
(assert (or (str.prefixof "!#$%" z) (not (= (str.indexof z """ ont" 0) 59))))
(assert (not (= (str.len z) 35)))
(assert (not (str.contains z "(1)>")))
(assert (not (str.contains (str.replace x "comm" "javascript:") "<javascript:and o")))
(assert (not (str.suffixof "e;>" z)))
(assert (or (not (= (str.at z 1) "c")) (= "d on" (str.substr x 7 4))))
(check-sat)
