; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var oncut=""alert(1)"" contenteditable>test</var>") (= x "<a href=""\x14javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<audio autoplay controls onvolumechange=alert(1)><source src=""validaudio.wav"" type=""audio/wav""></audio>")))
(assert (or (= z "test</button>") (= z "IRED>]>") (= z "avascript:alert(1)> -->")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 4) ">")) (not (str.contains (str.replace z "ut" "<b>") "b<b>to"))))
(assert (not (str.suffixof "est</a>" x)))
(assert (or (not (= (str.indexof x "u" 0) 50)) (not (= (str.indexof y "utt" 0) 55)) (not (<= (str.len z) 14))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^\S+@(([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,6})$")) (str.in_re z ((_ re.from_regex ecma2020) "^.{0,4}$")) (str.suffixof "IRED>]>" z)))
(assert (or (= "ncut=""" (str.substr y 6 6)) (= (str.indexof x "t(" 0) 44)))
(assert (= (str.at z 3) "D"))
(assert (or (= (str.len y) 139) (not (= (str.at y 20) "r"))))
(check-sat)
