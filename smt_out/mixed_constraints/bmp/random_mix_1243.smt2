; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee onkeydown=""alert(1)"" contenteditable>test</marquee>") (= x "<svg onunload=window.open('javascript:alert(1)')>")))
(assert (or (= z "ror=javascript:alert(1)>") (= z "rt(1)"">test</video>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "e on" 0) 7) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\u{e1}\u{10d}\u{10f}\u{e9}\u{11b}\u{ed}\u{148}\u{f3}\u{159}\u{161}\u{165}\u{16f}\u{fa}\u{fd}\u{17e}\u{c1}\u{10c}\u{10e}\u{c9}\u{cd}\u{11a}\u{147}\u{d3}\u{158}\u{160}\u{164}\u{da}\u{16e}\u{dd}\u{17d}\s\.\-]*")))))
(assert (= "<ima" (str.substr x 0 4)))
(assert (or (str.suffixof "video>" z) (str.prefixof "<m" x)))
(assert (not (= (str.indexof x " onu" 0) 4)))
(assert (or (not (= (str.len x) 60)) (str.prefixof "ror=java" z) (not (str.suffixof ">" x))))
(check-sat)
