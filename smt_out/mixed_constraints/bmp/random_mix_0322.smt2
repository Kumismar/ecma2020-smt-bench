; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div onpaste=""alert(1)"" contenteditable>test</div>") (= x "<style onkeypress=""alert(1)"" contenteditable>test</style>") (= x "<svg><tfoot onload=alert(1)></tfoot>")))
(assert (or (= z "us>") (= z "menu=""alert(1)"">test</body>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<sty" y)))
(assert (or (not (str.suffixof "/body>" y)) (not (str.in_re z ((_ re.from_regex ecma2020) "^([+]+)*[0-9\s-]{5,20}")))))
(assert (= (str.indexof y "style" 0) 1))
(assert (or (str.prefixof "<bo" x) (= (str.indexof y ")"">" 0) 63) (str.prefixof "<di" x)))
(assert (str.suffixof "ot>us>" y))
(assert (not (= "<style onkeypress=""alert(1)"" contenteditable>""/style>us>" (str.replace y "test<" """"))))
(assert (or (not (str.suffixof "us>" z)) (not (= (str.at x 9) "s"))))
(check-sat)
