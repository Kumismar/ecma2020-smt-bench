; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup oncopy=""alert(1)"" contenteditable>test</optgroup>") (= x "<div id=""53""><xml id=""xss"" src=""test.htc""></xml>")))
(assert (or (= z "=&quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;") (= z "tle onbeforecut=""alert(1)"" contenteditable>test</title>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[1-9]{2}$"))) (not (= (str.indexof z "t" 0) 5)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9]{0,40}$")))))
(assert (or (= "entedit" (str.substr y 32 7)) (not (= (str.indexof x "a" 0) 18))))
(assert (str.contains (str.replace y "n" "") "tle obefor"))
(assert (or (= "con" (str.substr y 27 3)) (not (= (str.len z) 55))))
(assert (or (not (str.contains (str.replace z " cont" "") "t(1)""e")) (not (= "table>" (str.substr y 85 6)))))
(assert (or (str.suffixof "le>" y) (not (str.in_re x ((_ re.from_regex ecma2020) "^()?[0-9\- ]{10}[0-9\- ]*$")))))
(assert (or (not (<= (str.len x) 68)) (= (str.indexof z ">" 0) 42)))
(check-sat)
