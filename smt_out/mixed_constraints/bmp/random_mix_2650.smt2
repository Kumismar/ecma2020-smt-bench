; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<multicol id=x tabindex=1 onactivate=alert(1)></multicol>") (= x "<style>:target {color: red;}</style><basefont id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></basefont>")))
(assert (or (= z "ctivate=alert(1)></div>") (= z "abindex=1 ondeactivate=alert(1)></details><input id=y autofocus>") (= z "G SRC=\""javascript&#058;alert('XSS');\""&gt;")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 33) "a") (= "');\""&" (str.substr z 34 6)) (not (= (str.at y 110) "t"))))
(assert (or (not (= (str.at z 20) "0")) (not (str.contains (str.replace z "a" "<b>") "<b>bi"))))
(assert (not (<= (str.len y) 106)))
(assert (or (= "<multicol id=x tabindex=1 onactivate=alert(1)></multicol>G SRC=\""javascript&#05""ert('XSS');\""&gt;" (str.replace y "8;al" """")) (>= (str.len y) 67)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^.{0,15}$")) (not (str.suffixof "l>" x))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^09[0-9]{8}$"))) (str.in_re z ((_ re.from_regex ecma2020) ".{0,256}"))))
(assert (not (= ";}<" (str.substr y 26 3))))
(assert (str.contains z "S');"))
(check-sat)
