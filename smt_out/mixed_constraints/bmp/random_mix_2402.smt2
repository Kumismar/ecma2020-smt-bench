; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><script>//&NewLine;confirm(1);</script </svg>") (= x "<frameset onmouseleave=""alert(1)"">test</frameset>") (= x "<blink oncontextmenu=""alert(1)"">test</blink>")))
(assert (or (= z "ress>") (= z "onxxx=1")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "<div style")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]*"))) (str.suffixof "ocus>" y)))
(assert (or (= (str.at x 18) "u") (not (= (str.at y 25) "l")) (= "<svg><s >//&NewLine;confirm(1);</script </svg>" (str.replace x "cript" " "))))
(assert (= (str.indexof x "n" 0) 4))
(assert (not (str.prefixof """></style>" z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z'\u{e0}\u{e2}\u{e9}\u{e8}\u{ea}\u{f4}\u{f9}\u{fb}\u{e7}\u{c0}\u{c2}\u{c9}\u{c8}\u{d4}\u{d9}\u{db}\u{c7}\s-]{1,30})$"))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[#$^+=!*()@%&]).{8,10}$")))
(assert (str.prefixof "on" z))
(check-sat)
