; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title id=x tabindex=1 onbeforedeactivate=alert(1)></title><input autofocus>") (= x "<IMG SRC=x onblur=""alert(String.fromCharCode(88,83,83))"">") (= x "<frame oncontextmenu=""alert(1)"">test</frame>")))
(assert (or (= z """= alt=javascript:alert(1)//"">") (= z "/colgroup>")))
(assert (= y (str.++ x z)))
(assert (= "deactivat" (str.substr y 31 9)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,15}$")) (= (str.indexof x "tabi" 0) 12)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\d*[.]?\d*$"))) (not (= (str.at z 25) ")")) (not (= (str.at y 1) "t"))))
(assert (or (= (str.at y 42) "d") (not (str.prefixof "<IMG S" x)) (not (str.prefixof "<s" y))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[A-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df} ]{1,30}"))))
(check-sat)
