; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main onclick=""alert(1)"">test</main>") (= x "<video draggable=""true\u{1d400}"" ondrag=""alert(1)"">test</video>") (= x "<noembed onkeydown=""alert(1)"" contenteditable>test</noembed>")))
(assert (or (= z "acer><input autofocus>") (= z "param>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 58) "a")) (not (str.prefixof """true" z))))
(assert (or (= "acer><inp" (str.substr z 0 9)) (= (str.indexof x "t</em" 0) 34)))
(assert (or (not (str.suffixof ">" z)) (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9_ ]{1,64}$")) (<= (str.len x) 71)))
(assert (or (not (= (str.indexof z "ac" 0) 0)) (= (str.indexof y "put" 0) 68)))
(assert (or (not (= "er><i" (str.substr z 2 5))) (not (str.in_re y ((_ re.from_regex ecma2020) "[V][0-9]{16}")))))
(check-sat)
