; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figcaption id=x tabindex=1 onbeforedeactivate=alert(1)></figcaption><input autofocus>") (= x "<canvas onfocusout=alert(1) tabindex=1 id=x></canvas><input autofocus>") (= x "<style>@keyframes x{}</style><rb style=""animation-name:x"" onanimationstart=""alert(1)""></rb>")))
(assert (or (= z "on>") (= z "ge onclick=""alert(1)"">test</image>") (= z "dl oncontextmenu=""alert(1)"">test</dl>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z\u{d1}\u{f1}\u{c1}\u{e1}\u{c9}\u{e9}\u{cd}\u{ed}\u{d3}\u{f3}\u{da}\u{fa}\u{dc}\u{fc}\s]+$"))))
(assert (or (= (str.indexof y "nst" 0) 68) (str.contains x "bind") (not (str.contains z ")"">te"))))
(assert (not (= (str.indexof y "gcap" 0) 3)))
(assert (or (not (= (str.indexof x "d" 0) 13)) (= "le>@ke" (str.substr x 4 6)) (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}$"))))
(assert (<= (str.len y) 52))
(check-sat)
