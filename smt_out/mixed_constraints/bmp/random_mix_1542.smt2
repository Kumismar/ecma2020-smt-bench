; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside onkeypress=""alert(1)"" contenteditable>test</aside>") (= x "<strong onmouseout=""alert(1)"">test</strong>")))
(assert (or (= z "hange=alert(1)></style>") (= z "rt('XSS');"">")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len x) 44) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?!.*--)[0-9 /]+$"))) (not (str.prefixof "<source" x))))
(assert (str.contains (str.replace x "p" "<b>") "onkey<b>r"))
(assert (or (not (str.contains (str.replace z "t('XS" "x") "rxS'")) (not (= "nge=al" (str.substr z 2 6))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[^<>()!%]*$")))))
(assert (or (= ";"">" (str.substr z 9 7)) (= (str.at x 12) "p")))
(assert (not (str.prefixof "<s" x)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9'.-]+@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*(\.[a-z]{2,15})$"))) (not (str.suffixof ">" y))))
(assert (or (= (str.at z 7) "'") (str.contains (str.replace y " on" "alert(1)") "e""alert(1)drag") (str.prefixof "<as" x)))
(check-sat)
