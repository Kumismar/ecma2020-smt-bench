; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br ondblclick=""alert(1)"">test</br>") (= x "<slot draggable=""true"" ondragenter=""alert(1)"">test</slot>") (= x "<center onpaste=""alert(1)"" contenteditable>test</center>")))
(assert (or (= z " onbeforeactivate=alert(1)></p>") (= z "alert(1)></center>")))
(assert (= y (str.++ x z)))
(assert (not (= "(1)><" (str.substr y 35 5))))
(assert (= (str.indexof x "k=""al" 0) 13))
(assert (or (not (= "cente" (str.substr z 11 5))) (not (str.suffixof ">" x)) (str.prefixof "<u onm" x)))
(assert (or (= (str.at y 18) "l") (str.in_re y ((_ re.from_regex ecma2020) "^[0-9a-zA-Z]+[\w.-]+@[\w\.-]+\.\w{2,}$"))))
(assert (or (not (= (str.at y 45) "1")) (str.in_re z ((_ re.from_regex ecma2020) "^[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*(.[a-z]{2,3})$")) (str.suffixof "/p>" z)))
(assert (or (not (str.suffixof "/p>" y)) (<= (str.len x) 59) (= (str.at y 1) "c")))
(assert (= "<br ondblclick=""alrt(1)"">test</br>alert(1)></center>" (str.replace y "e" "")))
(assert (= (str.indexof z "></c" 0) 8))
(check-sat)
