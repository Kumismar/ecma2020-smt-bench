; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "'-alert(1)-'") (= x "<bdo id=x tabindex=1 onbeforeactivate=alert(1)></bdo>") (= x "<div onfocusout=alert(1) tabindex=1 id=x></div><input autofocus>")))
(assert (or (= z "ble>test</mark>") (= z "ansitioncancel=alert(1)></param>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "ark>" z)) (not (str.in_re z ((_ re.from_regex ecma2020) "1[3456789]\d{9}$"))) (not (str.prefixof "ble>t" z))))
(assert (or (= (str.indexof y "r" 0) 5) (not (= (str.at y 34) "a"))))
(assert (or (not (str.prefixof "<bdo " x)) (= (str.indexof x ")-'" 0) 9)))
(assert (or (not (= (str.at x 2) "d")) (= "><" (str.substr z 23 2)) (not (>= (str.len z) 10))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "(?:19|20)[0-9]{2}-(?:(?:0[1-9]|1[0-2])-(?:0[1-9]|1[0-9]|2[0-9])|(?:(?!02)(?:0[1-9]|1[0-2])-(?:30))|(?:(?:0[13578]|1[02])-31))"))))
(assert (str.suffixof "focus>" x))
(check-sat)
