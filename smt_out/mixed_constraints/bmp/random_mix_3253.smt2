; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""javas\x05cript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<div draggable=""true"" contenteditable>drag me</div><noembed ondrop=alert(1) contenteditable>drop here</noembed>")))
(assert (or (= z "ode(99,108,105,99,107),isTrusted:true})); </script>") (= z "lert(1)></param>") (= z "bdo onload=alert(1)></bdo>")))
(assert (= y (str.++ x z)))
