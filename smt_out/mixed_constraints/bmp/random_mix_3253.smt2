(assert (not (<= (str.len y) 142)))
(assert (not (= (str.indexof y "<big " 0) 83)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[6-9]{1}\d{9}$")))
(assert (or (not (str.contains y "tr")) (= "<input onblur=write(XSS) autofxs><input autofocus>" (str.replace x "ocu" "x")) (str.suffixof "/div>" y)))
