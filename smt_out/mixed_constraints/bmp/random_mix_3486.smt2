; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "perl -e &#039;print \"";<;SCR\0IPT>;alert(\"";XSS\"";)<;/SCR\0IPT>;\"";;&#039; >; out") (= x "<base onmousemove=""alert(1)"">test</base>")))
(assert (or (= z " ontransitionrun=alert(1)></address>") (= z "d=x></s><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "autof" 0) 15) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9-+\.\s()/]*$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(#[a-z]+\s*)*#[a-z]+\s*$"))) (not (= (str.at x 10) "0"))))
(assert (or (<= (str.len x) 88) (= (str.at x 22) ";") (not (= (str.indexof z "n" 0) 2))))
(assert (not (= "<javascript: onmousemove=""alert(1)"">test</base>d=x></s><input autofocus>" (str.replace y "base" "javascript:"))))
(check-sat)
