; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1><font color=blue>hellox worldss</h1>") (= x "<noscript oncontextmenu=""alert(1)"">test</noscript>")))
(assert (or (= z "s>") (= z "ideo onloadstart=alert(1)><source>") (= z "b onbeforecut=""alert(1)"" contenteditable>test</b>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 68) (= (str.len z) 2) (str.prefixof "s>" z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "\d\d\d\.\d\d\d\.\d\d\d-\d\d$"))) (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[A-Za-z])(?=.*\d).{8,}$")) (= (str.at x 35) "t")))
(assert (or (= ">" (str.substr z 1 6)) (not (str.in_re z ((_ re.from_regex ecma2020) "^(\+0?1\s)?\(?[2-9]{1}[0-9]{2}\)?[\s.-]?\d{3}[\s.-]?\d{4}$"))) (not (str.contains z "t(1)><so"))))
(assert (= "(" (str.substr x 30 1)))
(assert (or (not (str.contains (str.replace z "s>" """") """")) (not (= "<h1><font color >hellox worldss</h1>" (str.replace x "=blue" " ")))))
(check-sat)
