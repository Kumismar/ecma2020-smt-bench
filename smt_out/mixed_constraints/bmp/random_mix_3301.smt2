; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<i onpaste=""alert(1)"" contenteditable>test</i>") (= x "<SCRIPT>String.fromCharCode(97, 108, 101, 114, 116, 40, 49, 41)</SCRIPT>")))
(assert (or (= z "</embed>") (= z "iv draggable=""true"" contenteditable>drag me</div><sup ondrop=alert(1) contenteditable>drop here</sup>") (= z "/form>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<i onpaste" x)))
(assert (not (= (str.indexof z "p=ale" 0) 59)))
(assert (or (not (str.prefixof "<SCRIPT" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^0\d{1,3}-?\d{2,4}-?\d{4}")))))
(assert (not (= "<i onpaste=alert(1)lert(1)"" contenteditable>test</i>" (str.replace x """a" "alert(1)"))))
(assert (or (<= (str.len y) 57) (not (str.suffixof "ed>" z))))
(assert (or (not (str.contains x "alert(1")) (not (= "<i onpaste=""alert(1)""javascript:tenteditable>test</i>/form>" (str.replace y " con" "javascript:")))))
(check-sat)
