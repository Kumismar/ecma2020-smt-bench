; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed id=x tabin\u{10348}dex=1 onfocus=alert(1)></noembed>") (= x "<blink oncontextmenu=""alert(1)"">test</blink>") (= x "<main onbeforecopy=""alert(1)"" contenteditable>test</main>")))
(assert (or (= z "t(1)"">test</content>") (= z "rt(1) tabindex=1 id=x></frame><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(?:0|\(?\+33\)?\s?|0033\s?)[1-79](?:[\.\-\s]?\d\d){4}$"))))
(assert (or (not (= "link on" (str.substr y 2 7))) (str.contains (str.replace x "ex" "<b>") "nt<b>tme") (= (str.at x 59) "t")))
(assert (not (str.contains (str.replace y "\u{10348}d" "x") "binxex=")))
(assert (str.contains (str.replace z "es" "alert(1)") "1)"">talert(1)t</"))
(assert (or (str.suffixof "emplate>" y) (not (str.prefixof "<main" y)) (= (str.at x 40) "1")))
(assert (or (not (str.prefixof "<blink " y)) (not (str.suffixof "focus>" z))))
(assert (not (= (str.at x 23) "l")))
(assert (or (str.prefixof "<main on" x) (not (str.suffixof "autofocus>" y))))
(check-sat)
