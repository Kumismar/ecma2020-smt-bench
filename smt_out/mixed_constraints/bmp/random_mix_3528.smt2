; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><button ondrop=alert(1) contenteditable>drop here</button>") (= x "<data onmousedown=""alert(1)"">test</data>") (= x "&#X03C;")))
(assert (or (= z """alert(1)"">test</meter>") (= z "ragstart=""alert(1)"">test</ruby>") (= z "n onmousedown=""alert(1)"">test</section>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]*$"))))
(assert (or (>= (str.len y) 139) (not (= "data>" (str.substr x 35 9))) (not (str.in_re y ((_ re.from_regex ecma2020) "\w[-\w.+]*@([A-Za-z0-9][-A-Za-z0-9]+\.)+[A-Za-z]{2,14}")))))
(assert (or (str.contains (str.replace x "=" """") "id""x tab") (str.prefixof "ta" z) (not (>= (str.len x) 40))))
(assert (or (str.contains y """ale") (not (= (str.indexof x "te" 0) 29))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[0-9\-\+]{11,15}$")) (not (<= (str.len x) 112)) (str.contains y "nmousedow")))
(assert (not (= (str.indexof y "</" 0) 158)))
(assert (not (str.prefixof "<b" y)))
(check-sat)
