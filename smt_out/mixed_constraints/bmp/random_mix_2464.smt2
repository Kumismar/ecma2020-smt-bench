; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><var style=""animation-name:x"" onanimationend=""alert(1)""></var>") (= x "<input id=x tabinde\u{1d400}x=1 onact\u{10348}ivate=alert(1)></input>") (= x "<image onmouseup=""alert(1)"">test</image>")))
(assert (or (= z " onmo\u{1f600}useup=""alert(1)"">test</style>") (= z "e=""alert(1)"">test</li>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "up=""alert(") (= "<var st" (str.substr y 29 7)) (not (str.in_re y ((_ re.from_regex ecma2020) "^http(s)?:\/\/(www\.)?linkedin\.com\/.*$")))))
(assert (or (>= (str.len z) 4) (not (str.in_re x ((_ re.from_regex ecma2020) "[ a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}-]{4,100}"))) (not (= (str.at z 30) "t"))))
(assert (= "crip" (str.substr x 41 4)))
(assert (or (not (= (str.indexof x "t\u{10348}i" 0) 28)) (not (str.contains z "ert(1")) (not (str.contains x "mous"))))
(check-sat)
