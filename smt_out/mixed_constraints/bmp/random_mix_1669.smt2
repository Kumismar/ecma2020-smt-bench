; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><set onend=alert(1) attributename=x dur=1s>") (= x "<ins id=x tabindex=1 ondeactivate=aler\u{1d400}t(1)></ins><input id=y autofocus>")))
(assert (or (= z "cus=alert(1) type=text/html>") (= z "mp>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len x) 72) (not (= (str.indexof x "d" 0) 5)) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z\u{5c}u30A1-\u{5c}u30FF]*")))))
(assert (not (= (str.indexof z "mp" 0) 0)))
(assert (or (str.contains y "ame=x") (str.contains y "1) attrib")))
(assert (or (not (= "=1 o" (str.substr x 18 4))) (= (str.indexof y "attr" 0) 25) (not (str.contains (str.replace y "tena" "javascript:") "ibujavascript:me=x "))))
(assert (not (str.suffixof "t;/A&gt;g>" y)))
(assert (or (not (= (str.at z 2) ">")) (= (str.at y 18) "e")))
(check-sat)
