; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame onmouseup=""alert(1)"">test</frame>") (= x "<isindex onbeforecopy=""alert(1)"" contenteditable>test</isin\u{1f600}dex>")))
(assert (or (= z "tput onkeyup=""alert(1)"" contentedita\u{1f600}ble>test</ou\u{1f4a9}tput>") (= z "utofocus>") (= z "t=1 onerror=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[1-9]")) (not (= (str.at z 0) "u")) (= "u\u{1f4a9}tpu" (str.substr y 88 5))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{7}|\d{10}$"))) (not (str.contains y ")"" conten"))))
(assert (or (not (= (str.len x) 64)) (str.suffixof "/isin\u{1f600}dex>" x) (= "te=""a" (str.substr x 13 5))))
(assert (str.suffixof "\u{1f4a9}tput>" y))
(assert (not (= (str.at z 3) "f")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "(13[0-9]|14[5|7]|15[0|1|2|3|5|6|7|8|9]|18[0|1|2|3|5|6|7|8|9]|17[0|1|2|3|5|6|7|8|9]|19[0|1|2|3|5|6|7|8|9])\d{8}$")) (not (str.contains x "<fram")) (not (str.contains z "rror=ale"))))
(check-sat)
