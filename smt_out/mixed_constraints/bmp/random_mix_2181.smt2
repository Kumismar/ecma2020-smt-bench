; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details onkeyup=""alert(1)"" contenteditable>test</details>") (= x "<details ontoggle=alert(1) open>test</details>")))
(assert (or (= z "ipt:document.vulnerable=true;"">") (= z " rotate(180deg);}</style><sup id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></sup>") (= z "p>")))
(assert (= y (str.++ x z)))
(assert (= "rror=\" (str.substr x 11 6)))
(assert (or (str.prefixof "<det" x) (not (str.in_re x ((_ re.from_regex ecma2020) "^(31|30|0[1-9]|[12][0-9]|[1-9])\.(0[1-9]|1[012]|[1-9])\.((18|19|20)\d{2}|\d{2})$"))) (not (= (str.len x) 46))))
(assert (or (not (str.contains z "focus>")) (= "keyup=" (str.substr y 11 6)) (str.in_re x ((_ re.from_regex ecma2020) "(?=.*[A-Za-z])[A-Za-z0-9.'\s]*"))))
(assert (or (not (str.contains (str.replace x "te" "alert(1)") " conalert(1)nt")) (= (str.at x 13) "g")))
(assert (or (not (>= (str.len y) 86)) (not (str.contains (str.replace y "t</" "<b>") "tes<b>de"))))
(check-sat)
