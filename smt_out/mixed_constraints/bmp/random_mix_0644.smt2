; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog onclick=""alert(1)"">test</\u{10348}\u{10348}dialog>") (= x "<style onblur=alert(1) tabindex=1 id=x></style><input autofocus>") (= x "<meta onmouseover=""alert(1)"">test</meta>")))
(assert (or (= z "style=""animation-name:x"" onanimationend=""alert(1)""></tfoot>") (= z """>test</shadow>") (= z "or=\u{1f600}""alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "a>"">t")) (= "ofo" (str.substr z 41 3)) (str.contains z "t(")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\w{1,15}$"))) (= """xest</shadow>" (str.replace z ">t" "x"))))
(assert (= "ptl" (str.substr x 36 3)))
(assert (not (str.suffixof "/\u{10348}\u{10348}dialog>" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9,-]{9}"))) (str.suffixof "t>" y)))
(assert (or (not (>= (str.len x) 54)) (not (= "on" (str.substr z 14 2)))))
(check-sat)
