; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" cont\u{10348}enteditable>dra\u{1f4a9}g me</div><rb ondragover=alert(1) contenteditable>drop here</rb>") (= x "<colgroup draggable=""true"" ondragstart=""alert(1)"">test</colgroup>") (= x "<style>@keyframes x{}</style><span style=""animation-name:x"" onanimationstart=""alert(1)""></span>")))
(assert (or (= z "</div>") (= z "tenteditable>drop here</style>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 50) "x"))
(assert (or (str.prefixof "<style" x) (not (= (str.indexof z "div>" 0) 2)) (str.in_re y ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{401}][\u{430}-\u{44f}\u{451}]+(-[\u{410}-\u{42f}\u{401}][\u{430}-\u{44f}\u{451}]+)? [\u{410}-\u{42f}\u{401}][\u{430}-\u{44f}\u{451}]+( [\u{410}-\u{42f}\u{401}][\u{430}-\u{44f}\u{451}]+)?$"))))
(assert (or (not (str.suffixof "/colgroup>" x)) (not (str.prefixof "=" z)) (= "mbed onm" (str.substr x 4 8))))
(assert (= "<colgroup draggable=""true"" ondragstaxlert(1)"">test</colgroup>tenteditable>drop here</style>" (str.replace y "rt=""a" "x")))
(assert (or (= "<div draggable=""true"" cont\u{10348}enxditable>dra\u{1f4a9}g me</div><rb ondragover=alert(1) contenteditable>drop here</rb>tenteditable>drop here</style>" (str.replace y "te" "x")) (not (str.prefixof "<c" x)) (str.suffixof "focus>" z)))
(assert (str.contains z "/style"))
(check-sat)
