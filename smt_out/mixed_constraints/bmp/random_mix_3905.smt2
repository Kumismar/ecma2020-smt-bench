; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hgroup onbeforepaste=""alert(1)"" contenteditable>test</hgroup>") (= x "<LAYER SRC=""http://ha.ckers.org/scriptlet.html""></LAYER>")))
(assert (or (= z "rable=true"")}</style>") (= z "spacer>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 20) ">") (str.prefixof "<title " y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_-])+@([a-zA-Z0-9_-])+(.[a-zA-Z0-9_-])+"))) (not (= "<META " (str.substr y 6 6))) (not (= (str.indexof z "t(1)>" 0) 0))))
(assert (or (= "}</" (str.substr z 12 3)) (not (= (str.len x) 62)) (not (>= (str.len z) 35))))
(assert (not (str.suffixof "er>" y)))
(assert (= "r" (str.substr y 29 1)))
(check-sat)
