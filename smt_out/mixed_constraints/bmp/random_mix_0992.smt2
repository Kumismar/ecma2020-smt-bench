; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;A HREF=&quot;h&#x0A;tt&#09;p://6&amp;#09;6.000146.0x7.147/&quot;&gt;XSS&lt;/A&gt;") (= x "<content onkeydown=""alert(1)"" contenteditable>test</content>") (= x "<label onmouseout=""alert(1)"">test</label>")))
(assert (or (= z "u i\u{10348}d=x contextmenu=x onshow=alert(1)>right click me!") (= z "=1 onfocusin=alert(1)></image>") (= z "st</command>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<" y)) (not (str.in_re z ((_ re.from_regex ecma2020) "^1([358][0-9]|4[579]|66|7[0135678]|9[89])\d{8}$")))))
(assert (or (not (<= (str.len z) 22)) (>= (str.len y) 134) (not (= (str.at z 11) "t"))))
(assert (or (not (str.suffixof "image>" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z]+\.[A-Za-z]{2,3}$"))) (str.suffixof "ick me!" y)))
(assert (str.suffixof ";" x))
(check-sat)
