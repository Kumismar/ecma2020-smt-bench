; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta id=x tabindex=1 onfocus=alert(1)></meta>") (= x "<? foo=""><x foo='?><script>javascript:alert(1)</script>'>"">") (= x "<pre draggable=""true"" ondragend=""alert(1)"">test</pre>")))
(assert (or (= z "terprint=alert(1)>") (= z "teditable>test</bdi>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<?" y)))
(assert (or (= "terprint=aler"">" (str.replace z "t(1)" """")) (= (str.at z 2) ">")))
(assert (str.suffixof "e>" x))
(assert (or (str.contains (str.replace x "le=" "") "gab""tru") (= "<p  draggable=""true"" ondragend=""alert(1)"">test</pre>" (str.replace x "re" " ")) (not (= "1)</scr" (str.substr x 44 7)))))
(assert (or (= (str.len z) 20) (str.contains x "dragend=""") (not (str.in_re y ((_ re.from_regex ecma2020) "^[+][0-9]{11}$")))))
(assert (or (str.prefixof "tedita" z) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9()\-+Xx\s,]+$")))))
(assert (or (>= (str.len z) 11) (>= (str.len z) 13)))
(check-sat)
