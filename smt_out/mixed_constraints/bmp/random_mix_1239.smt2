; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc oncut=""alert(1)"" contenteditable>test</rtc>") (= x "<map oncopy=""alert(1)"" contenteditable>test</map>") (= x "<style\u{1d400}>@keyframes x{}</style><sup style=""animation-name:x"" onanimationend=""alert(1)""></sup>")))
(assert (or (= z "1)"">test</bdo>") (= z "--`<iMG/srC=` onerror=confirm``> --!>") (= z """alert(1)"">test</optgroup>")))
(assert (= y (str.++ x z)))
(assert (or (= "<IMG SRC=javascript:alert(\u{2018}X<b>\u{2019})>" (str.replace x "SS" "<b>")) (not (str.contains (str.replace y "st<" """") "e>te""/rtc>"))))
(assert (or (not (= (str.indexof z "optgr" 0) 17)) (str.in_re y ((_ re.from_regex ecma2020) "^[1-9]\d{9}$"))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-z]{2,15}$")))
(assert (or (= (str.at y 61) ">") (str.prefixof "<rtc " y) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\s*)?(\+)?([- _():=+\/]?\d[- _():=+]?){4,20}(\s*)?$")))))
(assert (not (>= (str.len x) 41)))
(assert (or (str.prefixof "<rt" x) (not (= (str.indexof z """al" 0) 0)) (not (str.prefixof "<map on" x))))
(check-sat)
