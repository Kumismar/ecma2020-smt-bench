; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<label id=x tabindex=1 onfocusin=alert(1)></label>") (= x "<input type=image onloadstart=alert(1) src=validimage.png>") (= x "<samp id=x tabindex=1 onfocus=alert(1)></samp>")))
(assert (or (= z """true"" ondragend=""alert(1)"">test</details>") (= z "est</a>") (= z "/article>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9/\:_]{10,255}"))) (not (= (str.len y) 79))))
(assert (or (not (= "ge onload" (str.substr x 15 9))) (>= (str.len y) 52) (not (str.suffixof "ils>" y))))
(assert (not (str.contains z "t</")))
(assert (or (= (str.at y 1) "l") (str.suffixof "ails>" y)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(.+)@(.+)\.([a-z]{2,})$"))))
(assert (or (not (str.contains (str.replace x "min" "<b>") """ad<b>"" ")) (str.contains y "st</") (not (= "e"" ondrage" (str.substr z 4 10)))))
(check-sat)
