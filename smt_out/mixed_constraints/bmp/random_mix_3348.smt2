; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><style style=""animation-name:x"" onanimationstart=""alert(1)""></style>") (= x "<noframes onmouseover=""alert(1)"">test</noframes>")))
(assert (or (= z "e>test</command>") (= z "onerror=alert(1)&NewLine;") (= z "cr\u{10348}ipt 1=2")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "e>") (= (str.indexof z "(1" 0) 17)))
(assert (or (= (str.indexof z "t</" 0) 4) (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8}")))))
(assert (or (str.prefixof "<" x) (not (= (str.at x 31) """"))))
(assert (not (= "<noframes onmouseover=""alert(<b>"">test</noframes>" (str.replace x "1)" "<b>"))))
(assert (not (= "alert" (str.substr z 8 5))))
(check-sat)
