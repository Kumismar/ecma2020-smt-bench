; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp onmousedown=""alert(1)"">test</xmp>") (= x "<iframe onblu\u{1d400}r=alert(1) id=x><input autofocus>")))
(assert (or (= z """>test</tfoot>") (= z "td>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<xmp onmo" x) (str.contains (str.replace y "wn=""" "<b>") "sedo<b>a")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "Penticton|Kelowna|Vernon|West Kelowna|Armstrong|Coldstream|Enderby|Lake Country|Lumby|Oliver|Osoyoos|Peachland|Spallumcheen|Summerland|")) (not (str.contains z "td>"))))
(assert (or (= "blu\u{1d400}r=a" (str.substr y 10 7)) (not (<= (str.len z) 22)) (not (= (str.len z) 14))))
(assert (or (<= (str.len x) 77) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]{3}[0-9]{3}")))))
(assert (= "<noscript onkeyup=""alert(1)"" contentalert(1)itable>test</noscript>sindex onmouseenter=""alert(1)"">test</isindex>" (str.replace y "ed" "alert(1)")))
(check-sat)
