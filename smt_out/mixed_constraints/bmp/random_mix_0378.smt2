; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span onmousedown=""alert(1)"">test</span>") (= x "<shadow ondblclick=""alert(1)"">test</shadow>")))
(assert (or (= z "=""true"" ondrag=""alert(1)"">test</s\u{1d400}trong>") (= z " x=\'") (= z "asefont>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "test<")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\u{e1}\u{10d}\u{10f}\u{e9}\u{11b}\u{ed}\u{148}\u{f3}\u{159}\u{161}\u{165}\u{16f}\u{fa}\u{fd}\u{17e}\u{c1}\u{10c}\u{10e}\u{c9}\u{cd}\u{11a}\u{147}\u{d3}\u{158}\u{160}\u{164}\u{da}\u{16e}\u{dd}\u{17d}\s\.\-]*")))))
(assert (or (<= (str.len z) 11) (= (str.at y 22) "r")))
(assert (or (str.contains z " x=\") (str.suffixof "/span>" x) (= "te" (str.substr x 29 2))))
(assert (or (= (str.at x 43) "<") (str.suffixof "u>" y)))
(check-sat)
