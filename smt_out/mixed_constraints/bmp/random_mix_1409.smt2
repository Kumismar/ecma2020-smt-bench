; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<OBJECT classid=clsid:ae24fdae-03c6-11d1-8b76-0080c744f389><param name=url value=javascript:document.vulnerable=true></object>") (= x "<noframes id=x tabindex=1 onfocusin=alert(1)></noframes>")))
(assert (or (= z "ert(1)></mark>") (= z "ct>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "ct>"))
(assert (or (str.prefixof "m on" z) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*"))) (not (<= (str.len x) 56))))
(assert (or (not (= (str.at x 39) "r")) (not (str.in_re z ((_ re.from_regex ecma2020) "([a-z0-9]+[._-]){0,}?[a-z0-9]+@[a-z0-9]+[.]{1}[a-z]{2,4}$"))) (= (str.at x 60) ">")))
(assert (not (>= (str.len y) 61)))
(check-sat)
