; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr draggable=""true"" ondragend=""alert(1)"">test</hr>") (= x "<cod\u{1f4a9}e ondblclick=""alert(1)"">test</co\u{1f4a9}de>")))
(assert (or (= z "dblclick=""alert(1)"">test</sub>") (= z "x style=""transition:color 10s"" ontransitioncancel=alert(1)></object>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "st</sub>" (str.substr y 73 9))) (str.in_re z ((_ re.from_regex ecma2020) "^(?=.{8,20})(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9]).*$"))))
(assert (or (not (= "alert(1" (str.substr z 50 7))) (str.prefixof "dbl" z)))
(assert (or (not (<= (str.len x) 46)) (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9\s]{16,20}"))))
(assert (or (not (= (str.at z 29) ">")) (not (= "k=""alert(1" (str.substr y 58 10)))))
(assert (not (str.contains z "aler")))
(check-sat)
