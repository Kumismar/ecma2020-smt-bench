; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address id=x tabindex=1 onfocusin=alert(1)></address>") (= x "<span id=x tabindex=1 ondeactivate=alert(1)></span><input id=y autofocus>")))
(assert (or (= z "AEjavascript:alert(1)</script>") (= z "(1)"" contenteditable>test</td>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(\+33|0|0033)[12345679][1-9]\d{7}$"))) (not (= (str.indexof y "t</t" 0) 78))))
(assert (not (str.suffixof ">" x)))
(assert (not (str.suffixof "t>" z)))
(assert (or (not (str.suffixof "td>" y)) (= (str.at y 65) "t")))
(assert (or (not (str.prefixof "<span id=x" y)) (= (str.at x 53) ">") (not (str.contains z "/scrip"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "\+375\((25|29|33|44)\)\d{3}.+")) (= (str.indexof y " t" 0) 13)))
(check-sat)
