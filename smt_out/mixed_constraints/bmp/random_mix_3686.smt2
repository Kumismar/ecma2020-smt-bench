; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><small id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></small>") (= x "&lt;t&#58;set attributeName=\""innerHTML\"" to=\""XSS&lt;SCRIPT DEFER&gt;alert(&quot;XSS&quot;)&lt;/SCRIPT&gt;\""&gt;") (= x "<;A HREF="";http://ha.ckers.org@google"";>;XSS<;/A>;")))
(assert (or (= z "vate=alert(1)></big>") (= z "eactivate=alert(1)></section><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s_.-]*$")))
(assert (= (str.at x 13) "t"))
(assert (or (= (str.indexof y "=""tra" 0) 68) (not (str.contains z "alert(1)")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{5c}u00C0-\u{5c}u017F  -]*$")))))
(assert (or (str.contains y "targ") (str.contains z "</big") (= (str.indexof y ">;XSS" 0) 39)))
(assert (or (str.contains (str.replace z "/dfn" "<b>") "st<<b>>") (= (str.len y) 148) (not (= (str.indexof z "p" 0) 32))))
(assert (not (= (str.at x 9) """")))
(assert (not (>= (str.len y) 95)))
(check-sat)
