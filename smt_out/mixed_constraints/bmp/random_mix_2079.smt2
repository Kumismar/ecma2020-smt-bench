; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<big draggable=""true"" ondragend=""alert(1)"">test</big>") (= x "<! foo=""[[[Inception]]""><x foo=""]foo><script>alert(1)</script>"">") (= x "<meter onkeypress=""alert(1)"" contenteditable>test</meter>")))
(assert (or (= z "d=""fuzzelement1"">test</a>") (= z "ondblclick=""alert(1)"">test</applet>")))
(assert (= y (str.++ x z)))
(assert (not (= "<! foo=""[[[Inception]]""><x foo=""]foo><script>alert(1)</script>"">d=""fuzzelement1"">test</a>" (str.replace y """" """"))))
(assert (str.suffixof "t</applet>" y))
(assert (<= (str.len x) 57))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Z|a-z|\s-]*"))))
(assert (or (= " foo=""><sc" (str.substr x 2 10)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\s\-']+$"))) (not (= (str.len z) 35))))
(assert (or (str.prefixof "<! foo=" x) (not (= "ele" (str.substr y 60 3))) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{2}\/[0-9]{2}\/[0-9]{4}$")))))
(assert (or (not (= "<! foo<b>[Inception]]""><x foo=""]foo><script>alert(1)</script>"">d=""fuzzelement1"">test</a>" (str.replace y "=""[[" "<b>"))) (not (str.prefixof "<! foo=""" x)) (str.suffixof "t>" y)))
(check-sat)
