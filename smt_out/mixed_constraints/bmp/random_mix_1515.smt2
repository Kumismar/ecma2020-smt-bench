; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea autofocus onfocusin=alert(1)>test</textarea>") (= x "<html id=x tabindex=1 onfocus=alert(1)></html>")))
(assert (or (= z "d=x tabindex=1 onbeforeactivate=alert(1)></footer>") (= z "S');\""&gt;") (= z "/video>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "on") (str.suffixof ">" x)))
(assert (or (= (str.at x 32) "e") (not (str.prefixof " drag" z)) (<= (str.len y) 98)))
(assert (or (>= (str.len x) 49) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{8}$")))))
(assert (or (not (<= (str.len x) 63)) (= (str.indexof z "S')" 0) 0)))
(assert (= "&gt;" (str.substr z 6 4)))
(assert (str.suffixof "footer>" y))
(assert (str.prefixof "<ht" x))
(check-sat)
