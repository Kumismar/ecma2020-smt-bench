; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem onfocusout=alert(1\u{10348}) tabindex=1 id=x></menuitem><input autof\u{20000}ocus>") (= x "<style>@keyframes x{}</style><thead style=""animation-name:x"" onanimationstart=""alert(1)""></thead>")))
(assert (or (= z "/onmouseover=prompt(1)") (= z "ue"" ondragleave=""alert(1)"">test</footer>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9_ -\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}]{0,20}$"))))
(assert (or (= (str.indexof z "1)""" 0) 23) (str.suffixof "rompt(1)" y)))
(assert (or (not (<= (str.len x) 86)) (not (= (str.at x 42) "i")) (str.contains (str.replace x "onani" "javascript:") "x"" javascript:mat")))
(assert (or (= "<dt draggablejavascript:true"" ondragleave=""alert(1)"">test</dt>LOL<script>alert(123)</script></svg>" (str.replace y "=""" "javascript:")) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z]{1,50}")))))
(assert (or (not (= (str.indexof y "e" 0) 5)) (= (str.indexof y "</me" 0) 47)))
(assert (= (str.len z) 22))
(assert (>= (str.len z) 16))
(check-sat)
