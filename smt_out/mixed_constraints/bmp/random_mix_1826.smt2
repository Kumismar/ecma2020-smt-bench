; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noembed onmouseover=""alert(1)"">test</noembed>") (= x "<article onbeforepaste=""alert(1)"" contenteditable>test</article>")))
(assert (or (= z "t {color:red;}</style><sup id=x style=""transition:color 1s"" ontransitionend=alert(1)></sup>") (= z "est</dir>") (= z "{transform: rotate(180deg);}</style><xmp id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></xmp>")))
(assert (= y (str.++ x z)))
(assert (or (= ">" (str.substr y 72 1)) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}\-_\.]+@[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}0-9\-_\.]+\.[a-zA-Z\-_\.]{2,10}$"))))
(assert (or (not (>= (str.len z) 99)) (not (= "lert" (str.substr y 123 4))) (not (= (str.len y) 67))))
(assert (or (str.suffixof "t</dir>" z) (= (str.len y) 55)))
(assert (not (str.contains y "rt(1)></s")))
(check-sat)
