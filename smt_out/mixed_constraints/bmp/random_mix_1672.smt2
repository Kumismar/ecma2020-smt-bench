; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var id=x t\u{1f4a9}abindex=1 onbeforedeactivate=alert(\u{1f4a9}1)></var><input autofocus>") (= x "<script oncut=""alert(1)"" contente\u{10348}dita\u{20000}ble>test</script>") (= x "<!-- IE 5-9 standards mode -->")))
(assert (or (= z "e=""animation-name:x"" onanimationend=""alert(1)""></header>") (= z "orecopy=""alert(1)"" contenteditable>test</command>")))
(assert (= y (str.++ x z)))
(assert (= "<!-- IE 5-9 standards mode -->e=""animation-n""e:x"" onanimationend=""alert(1)""></header>" (str.replace y "am" """")))
(assert (or (str.contains y "nima") (str.contains x "/var><in") (not (str.prefixof "<" x))))
(assert (or (not (= "t" (str.substr x 6 1))) (not (= (str.len x) 30))))
(assert (= (str.at z 10) "l"))
(assert (not (= (str.at x 8) "s")))
(assert (= "oo" (str.substr y 80 2)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\u{c0}-\u{ff}][a-zA-Z\u{c0}-\u{ff}]+([-'\s][a-zA-Z\u{c0}-\u{ff}][a-zA-Z\u{c0}-\u{ff}]+)?"))) (not (= (str.at z 31) "n")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z ]{1,20}$")))))
(check-sat)
