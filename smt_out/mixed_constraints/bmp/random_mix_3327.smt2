; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><frame ondrop=alert(1) contenteditable>drop here</frame>") (= x "<picture oncontextmenu=""alert(1)"">test</picture>") (= x "<details draggable=""true"" ondragend=""alert(1)"">test</details>")))
(assert (or (= z "r>") (= z "78xx=1") (= z "1)"" contenteditable>test</sect\u{20000}ion>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 87) "l") (= "<div draggable=""true"" contteditable>drag me</div><frame ondrop=alert(1) contenteditable>drop here</frame>78xx=1" (str.replace y "en" ""))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[1-4][0-9][0-9]?$|^[1-9]\d$|^[1-9]$|^500$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([+]+)*[0-9\s-]{5,20}"))) (not (str.contains z "r>"))))
(assert (not (= (str.indexof z "ntent" 0) 6)))
(assert (or (not (str.prefixof "78x" z)) (not (= (str.len z) 39))))
(check-sat)
