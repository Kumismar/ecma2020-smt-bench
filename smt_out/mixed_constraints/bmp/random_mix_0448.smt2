; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<animate attributeName=""xlink:href"" begin=""0"" from=""javascript:alert(137)"" to=""&"" />") (= x "</stylesheet>//[""'`-->]]>]</div>") (= x "<iframe onmouseout=""alert(1)"">test</iframe>")))
(assert (or (= z "(&apos;XSS&apos;);&quot;&gt;") (= z "ABLE><TD BACKGROUND=""javascript:alert('XSS')"">")))
(assert (= y (str.++ x z)))
(assert (str.contains y "]>]</d"))
(assert (or (not (>= (str.len x) 48)) (str.contains y "buteNa")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "([a-z]+[a-z1-9._-]*)@{1}([a-z1-9\.]{2,})\.([a-z]{2,3})"))) (= "<iframe onmouseout=""alert(1""st</iframe>" (str.replace x ")"">te" """"))))
(assert (or (str.prefixof ">" z) (str.prefixof "ABLE>" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(0/91)?[6-9][0-9]{9}"))) (= "ondr" (str.substr y 25 4))))
(assert (or (str.contains (str.replace y "aler" "alert(1)") """alert(1)t(1") (str.contains y "ava") (not (= "<TD" (str.substr y 37 3)))))
(assert (or (>= (str.len y) 123) (str.suffixof ")"">" z)))
(check-sat)
