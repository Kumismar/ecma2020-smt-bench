; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a draggable=""true"" ondragleave=""alert(1)"">test</a>") (= x "<;SCRIPT a="";>;""; SRC="";http://ha.ckers.org/xss.js"";>;<;/SCRIPT>;")))
(assert (or (= z "x>") (= z "'hello\x27;javascript:alert(1)//';</script></p>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<;SCRI" x) (= ">" (str.substr z 1 2)) (= (str.indexof y "ipt" 0) 83)))
(assert (or (not (str.contains z "x>")) (not (= (str.indexof x "e" 0) 11))))
(assert (or (not (= "<;SCRIPT a="";>;""; SRC="";http://ha.ckers.org/xs s"";>;<;/SCRIPT>;" (str.replace x "s.j" " "))) (<= (str.len z) 11) (= (str.at y 28) "a")))
(assert (or (str.prefixof "'he" z) (not (str.in_re y ((_ re.from_regex ecma2020) "^([0-9]{4})\s?([A-Za-z]{2})$")))))
(assert (or (not (= "RIP" (str.substr x 59 3))) (not (str.in_re y ((_ re.from_regex ecma2020) "^(0|\+33)[1-9]([-. ]?[0-9]{2}){4}$")))))
(check-sat)
