; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body id=x tabindex=1 ondeactivate=alert(1)></body><input id=y autofocus>") (= x "<img src=x\x12onerror=""javascript:alert(1)"">") (= x "<html onpaste=""alert(1)"" contenteditable>test</html>")))
(assert (or (= z "name:x"" onanimationstart=""alert(1)""></cite>") (= z "yframes x{}</style><ruby style=""animation-name:x"" onanimationend=""alert(1)""></ruby>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "></xmp>" x) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-f0-9]*$")))))
(assert (or (not (str.contains x "ert(1)""")) (not (str.contains (str.replace z "1)"">" "") "ert(</cit")) (not (str.prefixof "<img s" y))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([1-9]|0[1-9]|1[0-9]|2[0-9]|3[0-1])[\/]([1-9]|0[1-9]|1[0-2])[\/](1[9][0-9][0-9]|2[0][0-9][0-9])$"))) (= "r" (str.substr y 18 1))))
(assert (str.suffixof "script>" x))
(assert (or (not (= (str.len z) 83)) (str.suffixof "autofocus>" x) (str.contains (str.replace y "t=""a" "") "rlert(")))
(assert (str.contains y "1 onfocu"))
(assert (= "r=""javasc" (str.substr x 20 9)))
(assert (= (str.at z 1) "f"))
(check-sat)
