; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tt draggable=""true"" ondragstart=""alert(1)"">test</tt>") (= x "<div draggable=""true"" contenteditable>drag me</div><legend ondragover=alert(1) contenteditabl\u{1d400}e>drop here</legend>")))
(assert (or (= z "lur=""alert(String.fromCharCode(88,83,83))"">") (= z "2s"" ontransitionrun=alert(1)></menuitem>")))
(assert (= y (str.++ x z)))
(assert (= "<javascript:t draggable=""true"" ondragstart=""alert(1)"">test</tt>2s"" ontransitionrun=alert(1)></menuitem>" (str.replace y "t" "javascript:")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9()\. -+]{10,15}$"))))
(assert (or (= (str.at x 10) "a") (not (str.in_re y ((_ re.from_regex ecma2020) "\d\d\d\d\d\d\d\d\d\d$"))) (not (= (str.at z 28) ">"))))
(assert (or (str.suffixof "m>" z) (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{8}$")))))
(assert (or (str.suffixof "</legend>" x) (str.contains z "(String.f")))
(assert (str.contains y "(1)"" "))
(assert (= "omCha" (str.substr z 20 5)))
(check-sat)
