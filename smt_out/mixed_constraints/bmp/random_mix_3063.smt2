; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img SRC=""javascript:document.vulnerable=true;"">") (= x "\u{1d400}<div id=""123""><span class=foo>Some text</span>")))
(assert (or (= z "itable>test</strong>") (= z "alert(1)"">test</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "ert(1)")) (str.prefixof "\u{1d400}<div id" x)))
(assert (or (not (>= (str.len x) 39)) (not (str.in_re x ((_ re.from_regex ecma2020) "^0(7|8|9)0\d{8}$"))) (= (str.indexof x "t" 0) 22)))
(assert (or (= (str.at z 9) "s") (not (str.contains (str.replace z "deo>" "") "i")) (not (= (str.at x 12) "v"))))
(assert (or (not (str.suffixof "(1)" z)) (= "st</bdi>" (str.substr z 12 9))))
(assert (not (<= (str.len x) 57)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9_-]+(.[a-zA-Z0-9_-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*(.[a-z]{2,})$"))))
(assert (not (str.contains y " SRC=""j")))
(check-sat)
