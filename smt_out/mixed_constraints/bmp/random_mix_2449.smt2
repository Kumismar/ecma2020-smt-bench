; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<head onmouseout=""alert(1)"">test</head>") (= x "<p id=x tabindex=1 onfocus=alert(1)></p>")))
(assert (or (= z "ent EVENT=onreadystatechange>javascript:alert(1)</SCRIPT>") (= z "le>test</data>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y ">t" 0) 48)) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\+\d{2})?(?:\s*\d){9,}")))))
(assert (not (<= (str.len z) 14)))
(assert (str.suffixof "CRIPT>" y))
(assert (or (not (>= (str.len y) 46)) (not (str.in_re y ((_ re.from_regex ecma2020) "[+0-9][0-9]*")))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^1[1-9]\d{9}$")) (not (str.suffixof "IPT>" y)) (str.prefixof "<head" y)))
(assert (or (not (= "ert(" (str.substr x 29 4))) (not (= (str.at x 9) "a"))))
(assert (= (str.at z 10) "o"))
(assert (or (str.contains (str.replace y "onmou" "javascript:") " javascript:seou") (str.prefixof "<" x)))
(check-sat)
