; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table onmousedown=""alert(1)"">test</table>") (= x "<th onbeforecopy=""alert(1)"" contenteditable>test</th>") (= x "<video draggable=""true"" ondragstart=""alert(1)"">test</video>")))
(assert (or (= z "onload=alert(1)></meter>") (= z "alert(1)"">test</caption>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains y "e ")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{4}\d{3}\d{3}$"))))
(assert (or (not (= (str.indexof y "alert" 0) 20)) (not (= "1)"">t" (str.substr y 43 5))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z\u{e1}\u{e0}\u{e2}\u{e3}\u{e9}\u{e8}\u{ea}\u{ed}\u{ef}\u{f3}\u{f4}\u{f5}\u{f6}\u{fa}\u{e7}\u{f1}\u{c1}\u{c0}\u{c2}\u{c3}\u{c9}\u{c8}\u{cd}\u{cf}\u{d3}\u{d4}\u{d5}\u{d6}\u{da}\u{c7}\u{d1} ]+$")))))
(assert (or (str.suffixof "if>" x) (str.contains x "able>test") (not (= "r>" (str.substr z 22 6)))))
(assert (or (not (str.suffixof "#X03c)s"">" y)) (not (str.prefixof "<style" x))))
(check-sat)
