; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{1f600}<b\u{10348}r>") (= x "<small onmouseleave=""alert(1)"">test</small>") (= x "<base onkeypress=""alert(1)"" contenteditable>test</base>")))
(assert (or (= z "ascript:javascript:alert(1)"">X") (= z "ptipt>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "pti" z))
(assert (or (not (>= (str.len x) 34)) (= "<javascript:ll onmouseleave=""alert(1)"">test</small>ptipt>" (str.replace y "sma" "javascript:")) (not (= "i" (str.substr z 2 1)))))
(assert (or (not (= "t>" (str.substr z 4 6))) (not (str.contains z "tipt>")) (str.contains z "pt")))
(assert (or (str.prefixof "ptip" z) (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9-]{2,10}"))))
(check-sat)
