; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1d400}colgroup id=x tabindex=1 onbeforeactivate=alert(1)></colgroup>") (= x "<label\u{10348} draggable=""true"" ondragenter=""alert(1)"">test</label>") (= x "<a draggable=""true"" ondragleave=""alert(1)"">test</a>")))
(assert (or (= z "_.,:;?@[/|\]^`=alert(&quot;XSS&quot;)&gt;") (= z "83))"">")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "(1)" 0) 38))
(assert (or (= (str.indexof x "est<" 0) 50) (str.contains x "roup id=x")))
(assert (or (not (>= (str.len y) 94)) (not (<= (str.len x) 59)) (not (= "lert(1" (str.substr x 39 6)))))
(assert (not (str.contains (str.replace x "=" "alert(1)") "gablealert(1)""t")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[BGHRS]{2}[0-9]{3,3}[-][0-9]{4}$"))) (str.contains y "de(97, 1") (str.in_re y ((_ re.from_regex ecma2020) "([0-9]{1,2})"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9A-Za-z\u{104}\u{10c}\u{118}\u{116}\u{12e}\u{160}\u{172}\u{16a}\u{17d}\u{105}\u{10d}\u{119}\u{117}\u{12f}\u{161}\u{173}\u{16b}\u{17e}\-]{2,63}\.[A-za-z]{2}"))))
(assert (<= (str.len x) 67))
(assert (str.contains y "3)"))
(check-sat)
