; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<map oncut=""alert(1)"" contenteditable>test</map>") (= x "<bgsound onmouseenter=""alert(1)"">test</bgsound>")))
(assert (or (= z "ideo>") (= z "ame draggable=""true"" ondragleave=""alert(1)"">test</iframe>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "ame dragga" z)) (str.suffixof "s>" x)))
(assert (or (= (str.at x 16) "e") (= "ve" (str.substr y 77 2))))
(assert (or (not (str.contains (str.replace z "rame" "") "if>")) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df} a-z\-]{1,40}")))))
(assert (or (str.contains (str.replace x "ente" "<b>") "t<b>d") (not (str.contains y "able")) (not (= "nd onm" (str.substr x 6 6)))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([A-z\u{119}\u{f3}\u{105}\u{15b}\u{142}\u{17c}\u{17a}\u{107}\u{144}\u{118}\u{d3}\u{104}\u{15a}\u{141}\u{17b}\u{179}\u{106}\u{143} ,.]){2,}$"))))
(assert (or (str.prefixof "<b" y) (not (str.in_re x ((_ re.from_regex ecma2020) "^[\w-]+(\.[\w-]+)*@([a-z0-9-]+(\.[a-z0-9-]+)*?\.[a-z]{2,6}|(\d{1,3}\.){3}\d{1,3})(:\d{4})?$")))))
(assert (or (= (str.at y 10) "n") (str.contains (str.replace z """>te" "alert(1)") "1)alert(1)st</i")))
(check-sat)
