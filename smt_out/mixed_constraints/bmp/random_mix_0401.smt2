; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><header ondragover=alert(1) contenteditable>drop here</header>") (= x "<div style=width:1px;filter:glow onfilterchange=javascript:alert(1)>x")))
(assert (or (= z "filter:url(#c);marker:url(#d);mask:url(#e);stroke:url(#f);""/>") (= z " id=x></map><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "utton")) (not (str.in_re y ((_ re.from_regex ecma2020) "[1-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{4}\/\d{1,2}\/\d{1,2}$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^.{0,6}$")))))
(assert (or (str.contains z "ap><inp") (not (= "abbr>" (str.substr x 35 9)))))
(assert (or (= (str.at x 65) "1") (str.contains x "eader")))
(assert (not (= "le" (str.substr y 71 2))))
(check-sat)
