; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb onclick=""alert(1)"">test</rb>") (= x "<blockquote onkeydown=""alert(1)"" contenteditable>test</blockquote>") (= x "<a onmouseout=""alert(1)"">test</a>")))
(assert (or (= z "utput id=x tabindex=1 onbeforeactivate=alert(1)></output>") (= z "olor]")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 59) "e")))
(assert (not (str.suffixof "]" z)))
(assert (or (str.suffixof "olor]" z) (str.in_re y ((_ re.from_regex ecma2020) "^\w+.\w+@[a-zA-Z_]+?\.[a-zA-Z]{2,3}$")) (str.contains (str.replace x "alert" "alert(1)") "out=""alert(1)(1)"">")))
(assert (or (not (= "u""put id=x tabindex=1 onbeforeactivate=alert(1)></output>" (str.replace z "t" """"))) (= (str.indexof x """" 0) 14) (str.prefixof "olor" z)))
(assert (or (str.suffixof "></output>" x) (not (= "nd" (str.substr z 15 2)))))
(assert (or (= "olor]" (str.substr z 0 8)) (not (str.contains (str.replace x "1)"">t" "x") "t(xes"))))
(check-sat)
