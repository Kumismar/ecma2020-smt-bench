; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:\xC2\xA0expression(javascript:alert(1)"">DEF") (= x "<ul onkeydown=""alert(1)"" contenteditable>test</ul>") (= x "<div draggable=""true"" contenteditable>drag me</div><style ondrop=alert(1) contenteditable>drop here</style>")))
(assert (or (= z "AN&gt;") (= z "eout=""alert(1)"">tes\u{1d400}t</caption>") (= z "6&;#09;6.000146.0x7.147/"";>;XSS<;/A>;")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{2} \d{5}-\d{4}$"))))
(assert (or (str.contains (str.replace y "d" "x") "<xiv") (not (= (str.indexof x "058" 0) 23)) (str.prefixof "<di" y)))
(assert (= (str.at x 25) "e"))
(assert (or (str.suffixof "SS<;/A>;" z) (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{1}[0-9]{9}"))))
(assert (str.prefixof "<xss id=x" y))
(assert (or (not (= (str.at y 49) "v")) (not (<= (str.len x) 111))))
(assert (not (= "6&;#09;6.000146.""47/"";>;XSS<;/A>;" (str.replace z "0x7.1" """"))))
(check-sat)
