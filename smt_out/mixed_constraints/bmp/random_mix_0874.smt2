; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp draggable=""true"" ondragleave=""alert(1)"">test</samp>") (= x "<IMG SRC=x onmousemove=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "t</legend>") (= z "ctivate=alert(1)></button><input autofocus>") (= z "le>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 26) "<")) (not (str.in_re x ((_ re.from_regex ecma2020) "^([\w-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-zA-Z]{2,6}(?:\.[a-zA-Z]{2})?)$"))) (not (str.contains (str.replace z "put " "<b>") "n<b>aut"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-9a-zA-Z]([\+\-_\.][0-9a-zA-Z]+)*)+@(([0-9a-zA-Z][-\w]*[0-9a-zA-Z]*\.)+[a-zA-Z0-9]{2,4})$"))) (not (= (str.indexof y "im" 0) 46)) (not (str.contains (str.replace x "em" "") "ouso"))))
(assert (or (not (= "ab" (str.substr x 11 2))) (not (= "l" (str.substr z 0 1)))))
(assert (or (not (= (str.at x 0) "<")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{9,}$"))) (not (= "end>" (str.substr y 63 7)))))
(assert (not (str.contains (str.replace y "ove" "javascript:") "usemjavascript:=""")))
(check-sat)
