; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;XML ID=I&gt;&lt;X&gt;&lt;C&gt;&lt;!&#91;CDATA&#91;&lt;IMG SRC=\""javas&#93;&#93;&gt;&lt;!&#91;CDATA&\u{1f4a9}#91;cript&#58;a\u{1f4a9}lert('XSS');\""&gt;&#93;&#93;&gt;") (= x "<dd onmouseleave=""alert(1)"">test</dd>") (= x "<style>@keyframes x{}</style><div style=""animation-name:x"" onanimationstart=""alert(1)""></div>")))
(assert (or (= z "e</content>") (= z "x=1 onbeforedeactivate=alert(1)></i><input autofocus>") (= z """x:\xE2\x80\x88expression(javascript:alert(1)"">DEF")))
(assert (= y (str.++ x z)))
(assert (= "able>\u{1d400}tes" (str.substr y 39 9)))
(assert (or (= (str.len y) 98) (not (= (str.indexof z "/cont" 0) 2)) (not (= "ct" (str.substr y 52 2)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(?:[a-fA-F0-9]{8}|[a-fA-F0-9]{11}|[a-fA-F0-9]{14}|[a-fA-F0-9]{15,16}|[a-fA-F0-9]{18})$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[1-9][0-9]{3}$")))))
(assert (or (= (str.indexof x "1 o" 0) 19) (not (str.in_re x ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+.[a-z]{2,3}$"))) (str.contains x "</")))
(assert (not (str.prefixof "<style>@" y)))
(check-sat)
