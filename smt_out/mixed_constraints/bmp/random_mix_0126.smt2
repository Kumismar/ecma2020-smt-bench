; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address onbefo\u{1d400}recut=""alert(1)"" contenteditable>test</address>") (= x "<body onmouseover=""alert(1)"">test</body>")))
(assert (or (= z "(1)"">test</p>") (= z "</template>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "plate>" z) (= (str.indexof y "t(1)" 0) 23) (= (str.at x 21) "a")))
(assert (or (= "nmouseov" (str.substr x 7 8)) (not (= (str.indexof y "e>e>t" 0) 107)) (<= (str.len z) 18)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9a-zA-Z_.-]+@[0-9a-zA-Z.-]+\.[a-zA-Z]{2,3}$"))) (not (str.prefixof "<body " x)) (not (= (str.indexof y "1)"">" 0) 25))))
(assert (not (= ")" (str.substr z 2 1))))
(check-sat)
