; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<col onbeforecopy=""alert(1)"" contenteditable>test</col>") (= x "'""""><script language=""JavaScript""> alert('X \nS \nS');</script>")))
(assert (or (= z "t(1)"">test</i>") (= z "rt(1)></p>") (= z "est</dl>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 8) "p")) (str.contains y "nbeforeco")))
(assert (or (not (= (str.indexof z ">" 0) 5)) (not (= (str.at x 16) "y")) (str.prefixof "<col onb" y)))
(assert (= "</s""><script >alert(document.cookie)</script>" (str.replace x "cript" """")))
(assert (or (= (str.at y 12) "e") (not (str.prefixof "<c" x)) (not (str.contains y "copy=""a"))))
(assert (or (not (str.suffixof "1)></p>" y)) (not (str.suffixof "/i>" z)) (str.suffixof "</script>" x)))
(assert (not (= (str.len y) 65)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\+?[0-9 ]{9,20}"))))
(assert (<= (str.len y) 76))
(check-sat)
