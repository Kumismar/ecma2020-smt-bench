; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen autofocus onfocusin=alert(1)>") (= x "<svg><style>{font-family&colon;'<iframe/onload=confirm(1)>'") (= x "<shadow oncut=""alert(1)"" contenteditable>test</\u{1f600}shadow>")))
(assert (or (= z "yle>") (= z "editable>test</strike>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "y" z)))
(assert (= (str.at x 2) "t"))
(assert (or (str.prefixof "e" z) (not (str.contains y "me/"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^13[0-9]{9}$|14[0-9]{9}|15[0-9]{9}[0-9]{9}[0-9]{9}$|18[0-9]{9}$"))))
(assert (str.contains x "alert(1)"))
(assert (not (str.contains x "ocus onfoc")))
(assert (or (str.suffixof "trike>" y) (str.in_re y ((_ re.from_regex ecma2020) "^AT\d{3,7}|AI\d{3,7}$")) (not (= (str.at x 40) "t"))))
(assert (str.contains (str.replace z "s" "x") "xeup="""))
(assert (not (>= (str.len y) 50)))
(check-sat)
