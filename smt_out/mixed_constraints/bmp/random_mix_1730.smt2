; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<fieldset onmouseup=""alert(1)"">test</fieldset>") (= x "<main ondblclick=""alert(1)"">test</main>")))
(assert (or (= z "sin=alert(1)></table>") (= z "e draggable=""true"" ondragend=""alert(1)"">test</title>") (= z "style>:target {transform: rotate(180deg);}</style><img id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></img>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "</main>"))
(assert (= (str.indexof y "t</" 0) 31))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9a-zA-Z]{3,4}$"))) (not (= (str.at x 21) "r"))))
(assert (<= (str.len x) 48))
(assert (or (not (= (str.indexof z "=""" 0) 11)) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df} a-z\-]{1,40}"))) (not (str.prefixof "<mai" x))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\s*([A-Za-z]{1,}([\.,] |[-']| ))+[A-Za-z]+\.?\s*$"))) (= (str.at y 5) " ") (str.prefixof "<fieldset" x)))
(assert (or (str.suffixof "></span>" y) (= (str.len y) 60)))
(check-sat)
