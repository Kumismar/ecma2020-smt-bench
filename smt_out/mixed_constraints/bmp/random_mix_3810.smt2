; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<applet onblur=alert(1) tabindex=1 id=x></applet><input autofocus>") (= x "<xmp draggable=""true"" ondrag=""alert(1)"">test</xmp>") (= x "<isindex onfocusout=alert(1) tabindex=1 id=x></isindex><input autofocus>")))
(assert (or (= z ")`>;") (= z "alert(1)"">test</article>") (= z "datalist><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (= ")`>javascript:" (str.replace z ";" "javascript:")))
(assert (= (str.indexof y "1)"">t" 0) 36))
(assert (or (not (str.prefixof "<xm" x)) (str.suffixof ">;" z)))
(assert (>= (str.len y) 92))
(assert (or (str.suffixof "/tfoot>" y) (>= (str.len y) 91)))
(assert (= "<isindex onfocusout=alert(1) tabindex=1 id=x><xsindex><input autofocus>alert(1)"">test</article>" (str.replace y "/i" "x")))
(assert (or (not (str.contains (str.replace z ")`>" "") ";")) (not (str.contains y "7/&qu")) (not (= "l" (str.substr z 4 1)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9_\-\u{5c}u4e00-\u{5c}u9fa5]+"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]+(?:\s[a-zA-Z]+)+$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{8}[a-zA-Z]{1}"))))
(check-sat)
