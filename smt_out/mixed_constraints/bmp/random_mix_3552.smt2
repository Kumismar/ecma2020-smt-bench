; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=1 href=1 onerror=""javascript:alert(1)""></img>") (= x "<img src\x09=x onerror=""javascript:alert(1)"">") (= x "<style>@keyframes x{}</style><select style=""animation-name:x"" onanimationend=""alert(1)""></select>")))
(assert (or (= z "id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></time>") (= z ":text/&#x6a&#x61&#x76&#x61&#x73&#x63&#x72&#x69&#x000070&#x074,&#x0061;&#x06c;&#x0065;&#x00000072;&#x00074;(1)></script>") (= z "eenter=""alert(1)"">test</blink>")))
(assert (= y (str.++ x z)))
(assert (str.contains x """j"))
(assert (or (not (str.prefixof "<style" x)) (= (str.indexof z "#x72" 0) 37)))
(assert (= (str.at x 15) "="))
(assert (or (str.prefixof "<styl" x) (not (= (str.at z 5) "r")) (not (= (str.indexof y "ste=""" 0) 9))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-z ]*$"))) (not (= "eenter=""alert(1)""est</blink>" (str.replace z ">t" "")))))
(assert (not (= "/scri" (str.substr y 208 5))))
(assert (not (= "form 2" (str.substr z 28 6))))
(assert (not (= "<style>@keyframes x{}</style><select style=""ajavascript:imation-name:x"" onanimationend=""alert(1)""></select>" (str.replace x "n" "javascript:"))))
(assert (or (not (str.prefixof "<s dragg" x)) (not (str.suffixof "</script>" y))))
(check-sat)
