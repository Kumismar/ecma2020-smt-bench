; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>     function b() { return Safe.get(); } alert(b({type:String.fromCharCode(99,108,105,99,107),isTrusted:true})); </script>") (= x "<nav onmouseup=""alert(1)"">test</nav>")))
(assert (or (= z "ed onblur=alert(1) tabindex=1 id=x><\u{10348}/embed><input autofocus>") (= z "e=""alert(1)"" contenteditable>test</var>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace x "h" " ") "fromC arC")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\+)?\d{1,20}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^(([^<>()\[\]\\.,;:\s@""]+(\.[^<>()\[\]\\.,;:\s@""]+)*)|("".+""))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$"))) (>= (str.len y) 162)))
(assert (not (<= (str.len x) 136)))
(assert (not (str.contains z """al")))
(assert (str.suffixof "nav>" x))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[^\s]+(\s+[^\s]+)*$"))) (str.contains y "tu")))
(check-sat)
