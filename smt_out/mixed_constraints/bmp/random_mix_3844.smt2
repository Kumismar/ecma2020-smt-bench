; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav onmouseover=""alert(1)"">test</nav>") (= x "<div draggable=""true"" contenteditable>drag me</div><samp ondragover=alert(1) contenteditable>drop here</samp>") (= x "<style>:target {color: red;}</style><data id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></data>")))
(assert (or (= z "><discard onbegin=alert(1)>") (= z "</style><nobr style=""animation-name:x"" onanimationend=""alert(1)""></nobr>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "/samp>" x) (not (= (str.indexof y "v></" 0) 36))))
(assert (or (not (str.contains y "s>rt(1)""")) (not (str.contains (str.replace x "e" "x") "nmousxo")) (<= (str.len y) 147)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^1[3|4|5|7|8][0-9]{9}$"))) (= "><discardxgin=alert(1)>" (str.replace z " onbe" "x")) (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{6,20}"))))
(assert (= "o" (str.substr x 5 1)))
(assert (str.contains x "el"))
(check-sat)
