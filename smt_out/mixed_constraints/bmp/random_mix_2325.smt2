; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em onbeforecut=""alert(1)"" contenteditable>test</em>") (= x "<html oncut=""alert(1)"" contenteditable>test</html>")))
(assert (or (= z "ipt:alert(1)""></body onLoad>") (= z "rt(1)"" contenteditable>test</svg>") (= z "tart=""alert(1)"">test</dd>")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_+\-]+(?:[a-zA-Z0-9_\.+\-]+[a-zA-Z0-9_+\-]+)?@(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}$")))
(assert (or (not (= "=x style=""transition:"" 1s"" ontransitionend=alert(1)></span>" (str.replace z "color" """"))) (str.contains x "t</ht") (= "ntedita" (str.substr x 28 7))))
(assert (or (not (str.contains (str.replace z ")""" "") "t(1 c")) (not (= (str.indexof y "t&#4" 0) 4)) (str.in_re x ((_ re.from_regex ecma2020) "^(https?:\/\/)?[-a-z0-9]+(\.[-a-z0-9]+)+(\/[-a-z0-9@:%_+.,~#?&=]+)*\/?$"))))
(assert (or (= ")"" con" (str.substr y 24 6)) (not (str.suffixof "onLoad>" y))))
(check-sat)
