; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\x3c") (= x "<q onpaste=""alert(1)"" contenteditable>test</q>")))
(assert (or (= z "tenteditable>drop here</wbr>") (= z "index=1 ondeactivate=alert(1)></iframe><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "<q onpaste=""alert(1)"" contenteditabxst</q>" (str.replace x "le>te" "x")) (not (str.contains y "tedit"))))
(assert (or (not (str.contains y "=""alert(1)")) (not (= (str.at z 0) "i"))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^\d+\s*$")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\d+(,\d+$)?"))) (not (str.suffixof "re</wbr>" z))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9]+$"))))
(check-sat)
