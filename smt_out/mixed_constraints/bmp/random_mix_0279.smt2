; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main onmouseout=""alert(1)"">test</main>") (= x "<option id=x tabindex=1 onfocus=alert(1)></option>") (= x "<h1 onmouseout=""alert(1)"">test</h1>")))
(assert (or (= z "ditable>test</slot>") (= z "\u{10348}\u{10348}<LI>XSS</br>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "est</h1>d" (str.substr y 27 9))) (str.prefixof "\u{10348}\u{10348}<LI>" z) (str.in_re z ((_ re.from_regex ecma2020) "^((\+|00)33\s?|0)[1-9](\s?\d{2}){4}$"))))
(assert (or (str.prefixof "<option i" y) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9,. ]*$")))))
(assert (or (= (str.at x 20) "p") (not (str.in_re x ((_ re.from_regex ecma2020) "^\+*\d{9,}"))) (str.contains y "useou")))
(assert (= "t=" (str.substr y 15 2)))
(check-sat)
