; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rb onbeforecopy=""alert(1)"" contenteditable>test</rb>") (= x "<IFRAME SRC=""javascript:alert('XSS');""></IFRAME>")))
(assert (or (= z ")"">test</map>") (= z "os;))&quot;&gt;")))
(assert (= y (str.++ x z)))
(assert (str.suffixof ";" y))
(assert (or (not (str.contains (str.replace x """ja" "javascript:") "RC=javascript:vasc")) (= (str.indexof y "ot;&g" 0) 58)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-z0-9._-]+@[a-z0-9._-]{2,}\.[a-z]{2,4}$"))) (not (= (str.at x 33) "S")) (str.contains x "for")))
(assert (or (not (= "('XSS')" (str.substr x 29 7))) (= (str.at x 35) "e") (not (str.in_re x ((_ re.from_regex ecma2020) "^[^/#$.[\]]+$")))))
(assert (= (str.at y 18) "c"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(?!000|666)[0-8][0-9]{2}-(?!00)[0-9]{2}-(?!0000)[0-9]{4}"))) (str.prefixof "<rb on" y) (not (= "ME SRC" (str.substr y 5 6)))))
(check-sat)
