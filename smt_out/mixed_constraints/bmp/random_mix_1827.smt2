; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<output oncut=""alert(1)"" contenteditable>test</output>") (= x "<cite onblur=alert(1) tabindex=1 id=x></cite><input autofocus>") (= x "</style>//[""'`-->]]>]</div>")))
(assert (or (= z "st</applet>") (= z "nsition:color 10s"" ontransitioncancel=alert(1)></code>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "x></c" 0) 36)) (= """ contenteditable>te<b>/small>" (str.replace z "st<" "<b>"))))
(assert (str.contains x "able>tes"))
(assert (or (= "<cite onblur=alert(1) tabindex""=x></cite><input autofocus>" (str.replace x "=1 id" """")) (not (str.contains x "t=""alert"))))
(assert (or (str.suffixof ")></code>" z) (str.in_re x ((_ re.from_regex ecma2020) "^[( )0-9]+$"))))
(assert (not (str.prefixof "nsition" z)))
(assert (= (str.at y 9) "n"))
(assert (or (not (str.contains z "lert(1)></")) (not (= (str.at z 13) " "))))
(assert (= (str.len y) 116))
(assert (str.suffixof "</canvas>" z))
(check-sat)
