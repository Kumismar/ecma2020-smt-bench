; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><data style=""animation-name:x"" onanimationstart=""alert(1)""></data>") (= x "<del oncopy=""alert(1)"" contenteditable>test</del>")))
(assert (or (= z "alert(1)"">test</title>") (= z "id=x style=""transition:color 1s"" ontransitionend=alert(1)></plaintext>") (= z "nsitionrun=alert(1)></html>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace y "olo" "<b>") "ion:c<b>r 1"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([A-Za-z0-9_\-.+])+@([A-Za-z0-9_\-.])+\.([A-Za-z]{2,})$"))))
(assert (or (= "st" (str.substr z 5 2)) (not (str.suffixof ")""></data>" x))))
(assert (or (not (str.contains z ")"">tes")) (= (str.len x) 49)))
(assert (str.suffixof "ntext>" z))
(assert (not (= (str.indexof z "n=al" 0) 9)))
(assert (not (= (str.len x) 95)))
(check-sat)
