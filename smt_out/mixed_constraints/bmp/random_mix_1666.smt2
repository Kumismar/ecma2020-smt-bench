; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup onmouseout=""alert(1)"">test</colgroup>") (= x "<iframe id=x onfocus=alert(1)>")))
(assert (or (= z ">") (= z "nk>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len z) 3)))
(assert (or (not (= "k>" (str.substr z 1 7))) (str.suffixof ">nk>" y) (str.prefixof "<iframe " x)))
(assert (or (not (str.contains (str.replace y "me " "alert(1)") "raalert(1)id=x ")) (= (str.indexof y "ter" 0) 3) (= (str.at x 19) "s")))
(assert (<= (str.len y) 87))
(assert (or (not (= (str.indexof z ">" 0) 0)) (= (str.at z 0) ">")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "/([\w\-]+\@[\w\-]+\.[\w\-]+)/"))) (str.suffixof "nk>" z)))
(assert (or (= (str.indexof y "=al" 0) 20) (str.suffixof "group>>" y)))
(check-sat)
