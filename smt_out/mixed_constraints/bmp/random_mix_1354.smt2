; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed src=""http://corkami.googlecode.com/svn/!svn/bc/480/trunk/misc/pdf/helloworld_js_X.pdf""> ?") (= x "<div draggable=""true"" contenteditable>drag me</div><bgsound ondrop=alert(1) contenteditable>drop here</bgsound>") (= x "<;\u{1d400}FRAMESET>;<;FRAME SRC="";javascript:alert(';XSS';);"";>;<;/FRAMESET>;")))
(assert (or (= z "d=""javascript:javascript:alert(1)""></style onLoad>") (= z "up oncopy=""alert(1)"" contenteditable>test</sup>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 26) "e") (not (= (str.indexof y "e<" 0) 44))))
(assert (or (= (str.at x 40) "m") (not (str.in_re x ((_ re.from_regex ecma2020) "^([\w\+-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$"))) (= (str.at y 4) "e")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9A-Za-z\-]+$"))) (= " onLoad>" (str.substr z 42 10))))
(assert (or (str.contains x "ound ondr") (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{e1}\u{10d}\u{10f}\u{e9}\u{11b}\u{ed}\u{148}\u{f3}\u{159}\u{161}\u{165}\u{16f}\u{fa}\u{fd}\u{17e}\u{c1}\u{10c}\u{10e}\u{c9}\u{cd}\u{11a}\u{147}\u{d3}\u{158}\u{160}\u{164}\u{da}\u{16e}\u{dd}\u{17d}\s]*")))))
(assert (or (not (>= (str.len y) 144)) (not (= "lert(" (str.substr z 26 5))) (str.suffixof " onLoad>" z)))
(assert (not (= "up oncopy=""alert(1)"" contenteditable>testalert(1)sup>" (str.replace z "</" "alert(1)"))))
(check-sat)
