; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em onpaste=""alert(1)"" contenteditable>test</em>") (= x "<style>:target {color: red;}</style><li id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></li>") (= x "<bdo oncut=""alert(1)"" contenteditable>test</bdo>")))
(assert (or (= z "=alert(1)></datalist>") (= z "</image>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<im" y))
(assert (or (not (= "=ale" (str.substr y 48 4))) (not (= "<em onpaste=""alerx"" contenteditable>test</em>" (str.replace x "t(1)" "x")))))
(assert (not (str.suffixof ">" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^([A-Z\u{104}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b}a-z\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}]+[,.]?[ ]?|[A-Z\u{104}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b}a-z\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}]+['-]?)+")) (not (str.in_re z ((_ re.from_regex ecma2020) "[w]{3}\.[A-Za-z0-9._%+-]*\.[A-Za-z]{2,3}$"))) (= (str.indexof y "/" 0) 29)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^\d{14}$")))
(assert (or (= "a" (str.substr z 1 1)) (str.prefixof "<em " y)))
(assert (or (= (str.at x 25) "t") (= " styl" (str.substr x 44 5))))
(assert (not (str.contains y ">test</em")))
(check-sat)
