; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html draggable=""true"" ondragleave=""alert(1)"">test</html>") (= x "<p onmouseup=""alert(1)"">te\u{1d400}st</p>")))
(assert (or (= z ")</script>") (= z "=""alert(1)"">test</marquee>") (= z " REL=""stylesheet"" HREF=""javascript:alert('XSS');"">")))
(assert (= y (str.++ x z)))
(assert (= "test</bd" (str.substr y 45 8)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9 -]+$"))) (not (= (str.indexof x "p" 0) 1))))
(assert (or (str.contains z "uee>") (str.contains (str.replace z "ipt>" "x") "/scrx")))
(assert (or (not (<= (str.len y) 88)) (= (str.at x 27) "a") (not (= (str.at y 0) "<"))))
(assert (not (= (str.at z 0) "o")))
(check-sat)
