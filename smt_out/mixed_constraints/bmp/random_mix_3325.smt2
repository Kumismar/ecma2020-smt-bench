; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture onkeypress=""alert(1)"" contenteditable>test</picture>") (= x "&<script>document.vulnerable=true;</script>")))
(assert (or (= z "able=""true"" ondrag=""alert(1)"">test</li>") (= z "ag me</div><dialog ondragover=alert(1) contenteditable>drop here</dialog>") (= z "le>test</basefont>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y """" 0) 20) (str.suffixof "asefont>" y) (not (= "le>test</ font>" (str.replace z "base" " ")))))
(assert (or (not (str.prefixof "<picture " y)) (= "out=""" (str.substr z 4 5)) (not (= "ipt>docu" (str.substr y 5 8)))))
(assert (or (str.suffixof "dialog>" z) (not (str.in_re x ((_ re.from_regex ecma2020) "^(IR|IG|IN|IP|IH|IM|ir|ig|in|ip|ih|im).+"))) (not (str.contains z "gove"))))
(assert (not (>= (str.len z) 71)))
(assert (or (str.contains z ">drop") (str.in_re z ((_ re.from_regex ecma2020) "^0\d{1,3}-?\d{2,4}-?\d{4}")) (<= (str.len z) 73)))
(check-sat)
