; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=d><x xmlns=""><iframe onload=alert(97)""></div>") (= x "<progress onpaste=""alert(1)"" contenteditable>test</progress>") (= x "<mark draggable=""true"" ondragenter=""alert(1)"">test</mark>")))
(assert (or (= z "ert(1)"">") (= z "lert(1)"">test</section>") (= z "&gt;")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 5) "i") (not (str.in_re x ((_ re.from_regex ecma2020) "^AX\d{3,7}|AI\d{3,7}|PA\d{3,7}$"))) (str.suffixof ")"">" z)))
(assert (<= (str.len y) 89))
(assert (or (= "ofocus>le" (str.substr y 61 9)) (not (str.suffixof "oot>" x))))
(assert (or (not (str.suffixof "tt>" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6,}$"))) (not (str.contains z "&gt;"))))
(assert (or (not (= "/menuite" (str.substr z 5 8))) (str.contains x "=""><ifra")))
(assert (not (str.prefixof "<di" y)))
(assert (or (= (str.at x 42) "1") (str.contains y """><ifra")))
(check-sat)
