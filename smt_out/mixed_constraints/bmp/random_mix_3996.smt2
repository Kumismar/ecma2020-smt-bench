; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input type=image src=1 onerror=alert(1)>") (= x "<style>:target {transform: rotate(180deg);}</style><col id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></col>")))
(assert (or (= z "dex draggable=""true"" ondragstart=""alert(1)"">test</isindex>") (= z "est</strong>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "otate(18") (not (str.contains z "roso"))))
(assert (or (not (str.suffixof "g>" y)) (not (= "<style>:taget {transform: rotate(180deg);}</style><col id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></col>" (str.replace x "r" ""))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[_\s\w\d]{3,}$")))))
(assert (or (not (str.contains y "ransform:")) (not (str.contains (str.replace x "e><co" "javascript:") "ljavascript:l id="))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^.{6,64}$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^0[1-689][0-9]{8}$")))))
(check-sat)
