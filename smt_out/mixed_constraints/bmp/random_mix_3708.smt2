; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base onkeypress=""alert(1)"" contenteditable>test</base>") (= x "<multicol id=x tabindex=1 ondeactivate=alert(1)></multicol><input id=y autofocus>")))
(assert (or (= z "id=x tabindex=1 ondeactivate=alert(1)></noembed><input id=y autofocus>") (= z "art=""al\u{10348}ert(1)""></pre>") (= z "//businessinfo.co.uk/labs/xss/xss.swf"" allowscriptaccess=always>?")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "\u{10348}er" 0) 62) (not (= (str.indexof z " tab" 0) 4)) (not (str.prefixof "//busin" z))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z '-]+$")))
(assert (or (not (str.prefixof "i" z)) (not (= (str.at z 15) "c"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6,50}$"))) (= "aalert(1)t=""al\u{10348}ert(1)""></pre>" (str.replace z "r" "alert(1)"))))
(assert (str.contains y " autofoc"))
(assert (or (not (= (str.indexof y "1" 0) 24)) (= (str.len x) 55)))
(check-sat)
