; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT SRC=http&#58;//ha&#46;ckers&#46;org/xss&#46;js&gt;&lt;/SCRIPT&gt;") (= x "&#x3c\u{1d400}")))
(assert (or (= z "editable>test</dialog>") (= z "ody onblur body onblur=""javascript:javascript:alert(1)""></body onblur>") (= z "tion>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "autofocus>" y)))
(assert (or (= "nfocus=" (str.substr x 14 7)) (str.suffixof ">" z) (not (str.contains y "foc"))))
(assert (or (str.prefixof "&#x3c\u{1d400}" x) (= (str.indexof z "log>" 0) 18)))
(assert (or (= (str.len x) 6) (str.in_re z ((_ re.from_regex ecma2020) "[\u{430}-\u{44f}\u{410}-\u{42f}0-9- ]{2,100}")) (not (str.in_re y ((_ re.from_regex ecma2020) "^.{5,35}$")))))
(assert (or (not (str.contains x "&#x3c\u{1d400}")) (not (<= (str.len z) 37))))
(check-sat)
