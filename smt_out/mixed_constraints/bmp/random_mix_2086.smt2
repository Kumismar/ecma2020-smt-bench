(assert (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z]{6}[A-Za-z0-9]{2}[A-Za-z][A-Za-z0-9]{2}[A-Za-z][A-Za-z0-9]{3}[A-Za-z]$")))
(check-sat)
