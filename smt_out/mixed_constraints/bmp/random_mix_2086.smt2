(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "veris-->group<svg/onload=alert(/XSS/)//") (= x "<del id=x tabindex=1 ondeacti\u{20000}vate=alert(1)></del><input id=y autofocus>")))
(assert (or (= z "cument.vulnerable=true"")}</style>") (= z "le>:target {color:red;}</style><span id=x style=""transition:color 1s"" ontransitionend=alert(1)></span>") (= z "//3334957647/1>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "veris-->gr" y) (not (= "id=x tab" (str.substr x 5 8)))))
(assert (or (str.prefixof "v" y) (not (= "<de<b> id=x tabindex=1 ondeacti\u{20000}vate=alert(1)></del><input id=y autofocus>cument.vulnerable=true"")}</style>" (str.replace y "l" "<b>"))) (>= (str.len z) 23)))
