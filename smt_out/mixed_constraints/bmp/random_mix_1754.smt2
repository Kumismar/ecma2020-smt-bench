; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre onbeforecopy=""alert(1)"" contenteditable>test</pre>") (= x "<hr id=x tabindex=1 onfocus=alert(1)></hr>") (= x "<style>:target {transform: rotate(180deg);}</style><menu id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></menu>")))
(assert (or (= z "emplate>") (= z "dex=1 id=x></section><input autofocus>") (= z """ dynsrc=""javascript:document.vulnerable=true;"">")))
(assert (= y (str.++ x z)))
(assert (str.contains x "style"))
(assert (or (not (= "ert(1" (str.substr y 112 5))) (not (str.contains x "test</pr"))))
(assert (or (not (str.contains (str.replace x "ler" "x") "py=""axt(")) (not (= (str.at z 18) "p")) (= "<pr ess onbeforecopy=""alert(1)"" content\u{10348}editable>test</progress>" (str.replace x "ogr" " "))))
(assert (or (not (str.prefixof """ dynsrc=""" z)) (str.suffixof ">" y)))
(assert (or (str.contains x "n=ale") (not (str.prefixof "<style>" y))))
(assert (or (>= (str.len x) 124) (not (str.in_re z ((_ re.from_regex ecma2020) "\D+")))))
(assert (not (= (str.indexof y "rm:" 0) 23)))
(check-sat)
