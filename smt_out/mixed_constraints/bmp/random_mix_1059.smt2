; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn id=x tabindex=1 onactivate=alert(1)></dfn>") (= x "<th draggable=""true"" ondragstart=""alert(1)"">test</th>")))
(assert (or (= z "<area style=""animatio\u{10348}n-name:x"" onanimationend=""alert(1)""></area>") (= z "script a=\u{5c}u0061 & /=%2F")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len x) 47)) (= (str.indexof x "e=" 0) 30) (not (= (str.indexof z "re" 0) 2))))
(assert (or (str.contains x "lert") (not (= (str.indexof x "1)></" 0) 38)) (= (str.len x) 53)))
(assert (or (str.contains z "ip") (not (str.suffixof "t</th>" x))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(^[aAbB][a-jA-J]\d{5}$|^[aAbB][a-jA-J]\d{5}\D{1}\d{1}$)"))) (not (= (str.len y) 70)) (not (str.in_re y ((_ re.from_regex ecma2020) "[\+,\s,0-9]*")))))
(assert (or (str.contains x "ert") (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9,.'\- ]*$")))))
(assert (= "<h draggable=""true"" ondragstart=""alert(1)"">test</th>script a=\u{5c}u0061 & /=%2F" (str.replace y "t" "")))
(check-sat)
