; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript id=x tabindex=1 onfocus=alert(1)></noscript>") (= x "<svg><dt onload=alert(1)></dt>") (= x "<label onclick=""alert(1)"">test</label>")))
(assert (or (= z "nmouseenter=""alert(1)"">test</area>") (= z " onbeforedeactivate=alert(1)></noscript><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "nmouseenter=""ale<b>1)"">test</area>" (str.replace z "rt(" "<b>")) (not (<= (str.len y) 101))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w\-_]{2,14}$"))) (not (str.prefixof " onbefor" z))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^\d{10,11}$")) (str.suffixof "y>" x) (= (str.at z 45) "n")))
(assert (or (not (= "<alert(1)abel onclick=""alert(1)"">test</label>" (str.replace x "l" "alert(1)"))) (not (str.prefixof "URL(\\" z))))
(check-sat)
