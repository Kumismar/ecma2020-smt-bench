; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav onfocusout=alert(1) tabindex=1 id=x></nav><input autofocus>") (= x "<th oncut=""alert(1)"" contenteditable\u{10348}>test</th>")))
(assert (or (= z "gle.com/"";>;XSS<;/A>;") (= z "e"" ondragenter=""alert(1)"">test</applet>") (= z " id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (= "fram" (str.substr x 53 4)) (not (str.contains (str.replace y " on" "<b>") "ess<b>dblc")) (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{11}")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9\s\-\.\+\(\)]{7,22}"))))
(assert (= (str.indexof z ">;" 0) 10))
(assert (or (= "=""alert(" (str.substr z 14 8)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z 0-9.,+-]*$")))))
(assert (or (not (= """" (str.substr z 17 1))) (= " id=""fuzzelement1"">test" (str.replace z "</a>" "")) (not (str.prefixof "<th onc" x))))
(assert (or (= (str.indexof x "nten" 0) 23) (= (str.at z 19) ">") (= "<th oncu<b>alert(1)"" contenteditable\u{10348}>test</th>" (str.replace x "t=""" "<b>"))))
(check-sat)
