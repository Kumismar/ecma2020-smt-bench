; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp onblur=alert(1) tabindex=1 id=x></xmp><input autofocus>") (= x "<output draggable=""true"" ondragenter=""alert(1)"">test</output>")))
(assert (or (= z "(1)></frameset>") (= z "animationstart=""alert(1)""></footer>") (= z "te=alert(1)></input>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 29) "=")) (not (= (str.at z 15) ">"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9 \-._,]+")) (= "ol>" (str.substr x 62 7)) (= "<output draalert(1)e=""true"" ondragenter=""alert(1)"">test</output>te=alert(1)></input>" (str.replace y "ggabl" "alert(1)"))))
(assert (or (str.prefixof "<xmp " x) (= "<style>:target {color:red;}</style><rt id=x style=""transition:color xntransitionend=alert(1)></rt>" (str.replace x "1s"" o" "x")) (not (str.suffixof ">" y))))
(assert (or (not (str.contains (str.replace y "nblu" "") "or=al")) (= "tionstart" (str.substr z 5 9)) (not (str.suffixof "/audio>" x))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9_+-]{8,15}")))
(assert (or (not (= "lert(1) " (str.substr y 13 8))) (= (str.indexof y "autof" 0) 50)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^\+?[\d\s]{6,18}$")))
(check-sat)
