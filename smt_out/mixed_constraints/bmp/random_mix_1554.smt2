; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<head onpaste=""alert(1)"" contenteditable>test</head>") (= x "<small onmousemove=""alert(1)"">test</small>")))
(assert (or (= z "le>@keyframes x{}</style><address style=""animation-name:x"" onanimationstart=""alert(1)""></address>") (= z "key!") (= z "genter=""alert(1)"">test</content>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\([2-9]{1}[0-9]{2}\)[\s][0-9]{3}[-][0-9]{4}$"))) (not (= (str.at x 26) "1")) (str.suffixof "y!" z)))
(assert (or (= (str.indexof y "ames" 0) 61) (not (<= (str.len z) 13)) (not (str.suffixof "head>" x))))
(assert (not (= "<head onpaste=""a rt(1)"" contenteditable>test</head>le>@keyframes x{}</style><address style=""animation-name:x"" onanimationstart=""alert(1)""></address>" (str.replace y "le" " "))))
(assert (or (not (str.suffixof "object>" y)) (not (= (str.indexof z "rt=""" 0) 73))))
(check-sat)
