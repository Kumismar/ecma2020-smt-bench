; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><applet id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></applet>") (= x "<form><input formaction=javascript:alert(1) type=image src=SOURCE>") (= x "<div draggable=""true"" contenteditable>\u{1d400}drag me</div><mark ondragover=alert(1) contenteditable>drop here</mark>")))
(assert (or (= z "cript onbeforecopy=""alert(1)"" contenteditable>test</noscript>") (= z "ex=1 onbeforeactivate=alert(1)></rp>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "orm>" y) (not (str.prefixof "<svg><" y)) (str.in_re x ((_ re.from_regex ecma2020) "([0-9]{5})$"))))
(assert (or (not (str.contains (str.replace x "jav" "x") "C=\""xasc")) (= "ct" (str.substr z 14 2))))
(assert (or (= (str.len x) 110) (not (= (str.at z 77) "t"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[^*?].*$"))))
(assert (or (not (str.suffixof "1)></rp>" z)) (str.suffixof "ark>" x)))
(assert (or (= "ansition:" (str.substr y 58 9)) (not (str.contains (str.replace y "v dr" "") "ia")) (str.prefixof "<form>" x)))
(check-sat)
