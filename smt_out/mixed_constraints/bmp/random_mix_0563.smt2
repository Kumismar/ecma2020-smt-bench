; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<var onclick=""alert(1)"">test</var>") (= x "<mark oncopy=""alert(1)"" contenteditable>test</mark>") (= x "<kbd draggable=""true"" ondragenter=""alert(1)"">test</kbd>")))
(assert (or (= z ">") (= z "ndragend=""alert(1)"">test</sup>") (= z "1 id=x></big><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "</kbd>" x) (= "avascript" (str.substr y 9 9)) (str.suffixof "test</svg>" y)))
(assert (or (str.contains (str.replace x """ co" "<b>") "rt(1)<b>ntent") (= (str.at y 58) "/")))
(assert (= (str.len z) 1))
(assert (str.in_re x ((_ re.from_regex ecma2020) "\b[\w\.-]+@((?!gmail|yahoo|outlook|aol|mail|protonmail|icloud|gmx|yandex).)[\w\.-]+\.\w{2,4}\b")))
(assert (str.contains (str.replace x "ente" "<b>") "ont<b>ditab"))
(check-sat)
