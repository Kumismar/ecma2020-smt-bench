; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe src=javascript:alert(1)>") (= x "<div draggable=""true"" contenteditable>drag me</div><blink ondragover=alert(1) contenteditable>drop here</blink>")))
(assert (or (= z "dy onload=prompt&lpar;1&rpar;&gt;'>") (= z ")"">test</br>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x "est")))
(assert (or (str.prefixof "fo" z) (not (str.contains x "\""")) (not (= (str.len z) 1))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z\u{e1}\u{e0}\u{e2}\u{e4}\u{e3}\u{e5}\u{e7}\u{e9}\u{e8}\u{ea}\u{eb}\u{ed}\u{ec}\u{ee}\u{ef}\u{f1}\u{f3}\u{f2}\u{f4}\u{f6}\u{f5}\u{fa}\u{f9}\u{fb}\u{fc}\u{fd}\u{ff}\u{e6}\u{153}\u{c1}\u{c0}\u{c2}\u{c4}\u{c3}\u{c5}\u{c7}\u{c9}\u{c8}\u{ca}\u{cb}\u{cd}\u{cc}\u{ce}\u{cf}\u{d1}\u{d3}\u{d2}\u{d4}\u{d6}\u{d5}\u{da}\u{d9}\u{db}\u{dc}\u{dd}\u{178}\u{c6}\u{152} .,'-]*$"))) (str.suffixof "st</br>" z) (str.prefixof "<ifra" x)))
(assert (or (not (str.prefixof "<div drag" y)) (not (str.contains x "e src=j"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$"))))
(check-sat)
