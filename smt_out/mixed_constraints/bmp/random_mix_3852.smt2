; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><acronym id=x style=""transition:color 1s"" ontransitionend=alert(1)></acronym>") (= x "<div draggable=""true"" contenteditable>drag me</div><dt ondrop=alert(1) contenteditable>drop here</dt>") (= x "<img srcset=1 onerror=alert(1)>")))
(assert (or (= z "/h1>") (= z "r=""alert(1)"">test</span>") (= z "head>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(\+\d{1,2}\s)?\(?\d{3}\)?[\s.-]{0,1}\d{3}[\s.-]{0,1}\d{4}[\sextEXT]{0,5}\d{0,6}$"))) (= (str.indexof y "ransi" 0) 57)))
(assert (or (not (str.contains (str.replace y "l" "") "ate=aer")) (= (str.indexof y "d" 0) 1) (= (str.at z 12) ">")))
(assert (or (= "rror" (str.substr x 17 4)) (= (str.indexof z "t<" 0) 16)))
(assert (or (not (str.contains y ">he")) (= (str.len x) 112)))
(assert (not (= "1>" (str.substr z 2 7))))
(assert (not (str.suffixof "1>" z)))
(check-sat)
