; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><applet id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></applet>") (= x "<a href=""javascript\x0A:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "redeactivate=alert(1)></track><input autofocus>") (= z "ing ondblclick=""alert(1)"">test</listing>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace y "<sty" "javascript:") "javascript:le>:t")))
(assert (or (= (str.len x) 130) (str.in_re y ((_ re.from_regex ecma2020) "^((?!\.)[\w\-_.]*[^.])(@\w+)(\.\w+(\.\w+)?[^.\W])$"))))
(assert (or (not (str.suffixof "cus>" y)) (not (str.contains z "><i")) (not (= (str.at y 20) "s"))))
(assert (= (str.indexof y "n" 0) 19))
(assert (or (str.contains z "nactiv") (not (str.contains (str.replace z "font" "alert(1)") "alert(1)>"))))
(assert (not (<= (str.len y) 113)))
(check-sat)
