; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<SCRIPT a="">'>"" SRC=""http://ha.ckers.org/xss.js""></SCRIPT>") (= x "<style>:target {color: red;}</style><article id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></article>") (= x "<svg><![CDATA[><image xlink:href=""]]><img src=xx:x onerror=alert(2)//""></svg>//[""'`-->]]>]</div>")))
(assert (or (= z "ondragend=""alert(1)"">test</frame>") (= z "t(\u{201c}XSS\u{201d}); </SCRIPT>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "/SCR" 0) 50))
(assert (or (= (str.at y 21) "h") (= (str.at y 121) "S")))
(assert (or (= "able>t" (str.substr x 35 6)) (not (str.prefixof "t(\u{201c}XSS\u{201d}" z))))
(assert (or (not (str.suffixof "div>" x)) (str.in_re y ((_ re.from_regex ecma2020) "^\s*1\d{10}\s*$")) (>= (str.len z) 24)))
(assert (or (not (str.suffixof "ame>" z)) (not (str.in_re z ((_ re.from_regex ecma2020) "^202[1-9]$"))) (not (= (str.at z 25) "<"))))
(assert (not (= (str.indexof z "/fr" 0) 26)))
(assert (not (str.suffixof "]</div>" x)))
(check-sat)
