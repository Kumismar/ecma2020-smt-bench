; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<td ondblclick=""alert(1)"">test</td>") (= x "<;A HREF="";http://google:ha.ckers.org"";>;XSS<;/A>;\u{1d400}") (= x "<colgroup draggable=""true"" ondragstart=""alert(1)"">test</colgroup>")))
(assert (or (= z " tabindex=1 ondeactivate=alert(1)></img><input id=y autofocus>") (= z "ameset onmousedown=""alert(1)"">test</frameset>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}a-zA-Z]+$")) (not (str.suffixof ">" z)) (not (<= (str.len z) 46))))
(assert (not (str.contains z "ById(%2")))
(assert (not (= "n" (str.substr x 5 1))))
(assert (or (not (str.prefixof "<td" x)) (str.suffixof "eset>" y) (not (str.in_re z ((_ re.from_regex ecma2020) "([0-9]){1,4}$")))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^([\w-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,16}(?:\.[a-z]{2})?)$")))
(assert (or (not (str.contains x "gle:ha.ck")) (not (str.contains (str.replace x "ers." "") "a.ckorg""")) (not (= ":h" (str.substr x 24 2)))))
(assert (not (<= (str.len y) 120)))
(check-sat)
