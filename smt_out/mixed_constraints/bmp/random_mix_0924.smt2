; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x oncanplaythrough=""alert(String.fromCharCode(88,83,83))"">") (= x "<input name=""secret"" type=""password"">")))
(assert (or (= z "te(180deg);}</style><ol id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></ol>") (= z "d>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[1-9][0-9]?[0-9]?$"))) (= (str.at z 20) "e") (= (str.at x 8) "a")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-\u{17c}A-\u{17b}]{2,20}$"))))
(assert (or (not (str.contains (str.replace x "sites" "x") "rossxpt")) (str.suffixof "word"">" x)))
(assert (or (str.suffixof ")></ol>" z) (>= (str.len x) 33) (= (str.at z 36) "t")))
(assert (not (str.prefixof "<IMG SR" x)))
(assert (or (not (= "<centerxeforecut=""alert(1)"" contenteditable>test</center>" (str.replace x " onb" "x"))) (str.prefixof "<in" x) (= (str.indexof x " SRC" 0) 4)))
(assert (not (= (str.len x) 37)))
(assert (str.contains z "rip"))
(check-sat)
