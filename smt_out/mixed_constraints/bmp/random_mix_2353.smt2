; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image oncut=""alert(1)"" contenteditable>test</image>") (= x "<a href=""\x0Fjavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<embed onblur=alert(1) tabindex=1 id=x><\u{10348}/embed><input autofocus>")))
(assert (or (= z "st</details>") (= z "lick=\u{1f600}""alert(1)"">t\u{20000}est</isindex>") (= z "le>  #x{font-family:foo[bar;color:green;}  #y];color:red;{}  </style>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<e" x)))
(assert (= "o\u{20000}w>" (str.substr y 106 6)))
(assert (or (not (str.prefixof "<e" y)) (not (= (str.indexof x "(1)""" 0) 40)) (not (str.prefixof "<image " x))))
(assert (or (not (= (str.at y 1) "i")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-\u{139}\u{13e}0-9. _-]{5,}$")))))
(assert (or (= "<a href=""\x0Fjavascript:javascript:alert(1)"" id=""fuzz""ment1"">test</a>st</details>" (str.replace y "ele" """")) (not (str.suffixof "</col>" z))))
(assert (not (>= (str.len y) 119)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{1,12}$")) (not (str.contains y "ame>lert("))))
(check-sat)
