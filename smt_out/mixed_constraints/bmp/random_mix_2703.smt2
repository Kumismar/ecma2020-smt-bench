; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#X000003C") (= x "<style onpaste=""alert(1)"" contenteditable>test</style>")))
(assert (or (= z "(1)></picture>") (= z "tes\u{1d400}t</col>\u{1f600}")))
(assert (= y (str.++ x z)))
(assert (or (not (= "big id=x tabindex=1 onbeforeacti alert(1)></big>" (str.replace z "vate=" " "))) (= "<style onpaste=""alert(1ntenteditable>test</style>tes\u{1d400}t</col>\u{1f600}" (str.replace y ")"" co" ""))))
(assert (or (>= (str.len y) 15) (= "alert(" (str.substr x 16 6)) (not (>= (str.len z) 5))))
(assert (or (str.prefixof "<script on" y) (= (str.at x 0) "<")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(1)$"))) (str.suffixof "s\u{1d400}t</col>\u{1f600}" y)))
(check-sat)
