; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby id=x tabindex=1 onbeforedeactivate=alert(1)></ruby><input autofocus>") (= x "<style>@keyframes x{}</style><textarea style=""animation-name:x"" onanimationend=""alert(1)""></textarea>")))
(assert (or (= z "alert(1)>x") (= z "cut=""alert(1)"" contenteditable>test</p>")))
(assert (= y (str.++ x z)))
(assert (str.contains y "ames x{}<"))
(assert (or (str.contains (str.replace y "st" """") "le>te""</p>") (= (str.len z) 10) (str.in_re x ((_ re.from_regex ecma2020) "^.+@.+\.[a-zA-Z]{2,63}$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[1]2$"))) (not (str.prefixof "cu" z))))
(assert (or (= (str.at x 81) "l") (not (str.suffixof ">" x)) (str.contains x "on")))
(assert (not (= (str.at x 59) "e")))
(assert (or (not (= (str.at x 21) "<")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9 \u{5c}u00D1\u{5c}u00F1]+$")))))
(assert (not (str.contains (str.replace z "</" " ") ">test a")))
(check-sat)
