; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script onbeforecut=""alert(1)"" contenteditable>test</script>") (= x "<a href=""\x05javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<style>:target {color: red;}</style><thead id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></thead>")))
(assert (or (= z "di>") (= z "V="";Set-Cookie""; Content="";USERID=<;SCRIPT>;alert(';XSS';)<;/SCRIPT>;"";>;")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 150) (not (str.in_re y ((_ re.from_regex ecma2020) "\d{3}-\d{4}")))))
(assert (or (str.contains y "t>") (not (= (str.at x 10) "x")) (not (<= (str.len x) 68))))
(assert (or (not (str.suffixof "3))"">" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-z_][a-z0-9_]{0,30}$"))) (not (= (str.at y 62) "h"))))
(assert (or (= "<listing ""ggable=""true"" ondrag=""alert(1)"">test</listing>" (str.replace x "dra" """")) (str.contains y "IP") (= (str.at y 130) ";")))
(assert (or (not (str.suffixof "PT>;"";>;" y)) (not (str.in_re z ((_ re.from_regex ecma2020) ".{0,118}")))))
(assert (or (not (= (str.len y) 89)) (not (= "Cookie" (str.substr z 8 6)))))
(check-sat)
