; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select id=x tabindex=1 ondeactivate=alert(1)></select><input id=y autofocus>") (= x "<i onpaste=""alert(1)"" contenteditable>test</i>") (= x "<iframe onbeforeload iframe onbefore\u{20000}load=""javascript:javascript:alert(1)""></iframe onbeforeload>")))
(assert (or (= z "strike>") (= z "=""http://ha.ckers.org/xss.js""></SCRIPT>")))
(assert (= y (str.++ x z)))
(assert (str.contains y "scrip"))
(assert (or (not (str.contains z "g/xss.")) (not (str.contains z "ss.js""></S"))))
(assert (or (not (str.prefixof " i" z)) (str.suffixof "CRIPT>" y) (= "k" (str.substr z 4 1))))
(assert (or (= (str.len y) 45) (not (str.in_re x ((_ re.from_regex ecma2020) "^1{0,1}(\(\d{3}\)\d{3}-\d{4}|\d{10})")))))
(assert (or (not (= (str.at x 25) "m")) (str.prefixof "<i onpast" x) (str.contains (str.replace x "le" """") "<se""ct i")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^(\((00|\+)39\)|(00|\+)39)?(32[04789]|38[890]|39[123]|34[024-9]|33[013-9]|36[0685]|35[0123]|37[0135789])(\s)?\d{6,7}$")) (not (= "ert" (str.substr x 67 3))) (not (str.in_re z ((_ re.from_regex ecma2020) "^([0-2][0-9]|(3)[0-1])(\/)(((0)[0-9])|((1)[0-2]))(\/)\d{4}$")))))
(assert (str.prefixof "strike>" z))
(check-sat)
