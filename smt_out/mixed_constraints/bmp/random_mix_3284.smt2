(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<data onclick=""alert(1)"">test</data>") (= x "<div id=""43""><?xml version=""1.0"" standalone=""no""?>") (= x "<figur\u{1f600}e onmouseout=""aler\u{1f4a9}t(1)"">test</figure>")))
(assert (or (= z "ble=true\u{20000};"">") (= z " draggable=""true"" ondragenter=""alert(1)"">test</hgroup>") (= z "ncut=""alert(1)"" contenteditable>test</h1>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "1)"" cont"))
(assert (or (str.prefixof "<data " y) (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z-.\u{f3}]|[\u{e0}-\u{fa}]|[\u{c0}-\u{da}]|[-z0-9-\s])+$")) (not (str.suffixof "</hgroup>" z))))
(assert (or (<= (str.len x) 103) (not (= (str.indexof x "e=""no" 0) 42)) (= (str.at x 0) "<")))
