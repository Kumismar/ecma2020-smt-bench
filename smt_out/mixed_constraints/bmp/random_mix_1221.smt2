; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen autofocus onfocusin=alert(1)>") (= x "<progress id=x tabindex=1 onbeforedeactivate=alert(1)></progress><input autofocus>") (= x "<noscript onmo\u{1f4a9}useup=""alert(1)"">test</noscript>")))
(assert (or (= z "mes x{}</style><b sty\u{10348}le=""animation-name:x"" onanimationend=""alert(1)"">\u{10348}</b>") (= z "nput autofocus>") (= z "ctivate=alert(1)></title>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "nput" z) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9._'%+-]+@(\[(\d{1,3}\.){3}|(?!hotmail|gmail|yahoo|live|msn|outlook|comcast|verizon|aol|icloud|mail|ymail|att|GMAIL|YAHOO|HOTMAIL|AOL)(([a-zA-Z\d-]+\.)+))([a-zA-Z]{2,4}|\d{1,3})(\]?)$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"))))
(assert (or (not (str.contains (str.replace z "tof" "alert(1)") "t aualert(1)o")) (not (= """alert(" (str.substr x 21 7))) (not (= (str.indexof y "on" 0) 26))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9]\w*$")) (str.prefixof "<progress " y) (not (= "o" (str.substr z 10 1)))))
(assert (str.prefixof "<noscri" x))
(check-sat)
