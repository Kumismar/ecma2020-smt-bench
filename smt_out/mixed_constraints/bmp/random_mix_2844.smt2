; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div  style=""position:absolute;top:0;left:0;width:100%;height:100%""  onmouseover=""prompt(1)"" onclick=""alert(1)"">x</button>?") (= x "<strike id=x tabindex=1 onactivate=alert(1)></strike>")))
(assert (or (= z " ONLO\u{1f600}AD=javas\u{20000}cript:alert(1)>") (= z "/ol>") (= z "alert(1)></track><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 35) ">")))
(assert (or (<= (str.len z) 5) (str.in_re x ((_ re.from_regex ecma2020) "^([(][0-9]{1,3}[)][-]?)?([0-9][-]?){3,16}[0-9]$"))))
(assert (or (not (= (str.at x 43) ">")) (<= (str.len z) 44)))
(assert (str.suffixof "</button>?" x))
(assert (or (not (>= (str.len y) 78)) (str.contains y ")"">x<")))
(assert (or (= "ol>" (str.substr z 1 9)) (str.suffixof "alert(1)>" y)))
(assert (str.contains y "(1)"))
(check-sat)
