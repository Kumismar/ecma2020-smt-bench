; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;INPUT TYPE=&quot;IMAGE&quot; SRC=&quot;javascript:alert(&apos;XSS&apos;);&quot;&gt;") (= x "<script onfocusout=alert(1) tabindex=1 id=x></script><input autofocus>") (= x "<button onfocusout=alert(1) id=x></button><input autofocus>")))
(assert (or (= z """ ontransitioncancel=alert(1)></samp>") (= z " onactivate=alert(1)></data>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "utofocus") (<= (str.len z) 79)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "0[2,3,4,7,8][0-9]{8}"))) (str.contains (str.replace y "lert" " ") "r=""a (1)") (not (<= (str.len x) 90))))
(assert (str.contains (str.replace x "lert" "<b>") "ut=a<b>("))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[a-zA-Z\d\w\W]{8,}$"))) (= (str.len z) 35) (not (str.prefixof "<progre" y))))
(check-sat)
