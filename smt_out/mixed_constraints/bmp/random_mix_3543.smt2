; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>~'\u{5c}u0061' ;  \u{5c}u0074\u{5c}u0068\u{5c}u0072\u{5c}u006F\u{5c}u0077 ~ \u{5c}u0074\u{5c}u0068\u{5c}u0069\u{5c}u0073.  \u{5c}u0061\u{5c}u006C\u{5c}u0065\u{5c}u0072\u{5c}u0074(~'\u{5c}u0061')</script U+") (= x "<style>:target {color:red;}</style><rb id=x style=""transition:color 1s"" ontransitionend=alert(1)></rb>")))
(assert (or (= z "tion:color 10s"" ontransitioncancel=alert(1)></rb>") (= z """animation-name:x"" onanimationend=""alert(1)""></wbr>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "t<" (str.substr z 12 2))) (not (= (str.at x 30) "t")) (not (str.contains y "=alert"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "([\D]{2}|[\d]{2})-{1}[\d]{3,4}"))) (not (str.prefixof "<style>" y))))
(assert (or (str.suffixof "cript U+" x) (not (str.suffixof "pt U+" x)) (= (str.at x 27) "t")))
(assert (or (not (str.prefixof """animation" z)) (str.suffixof "1)></rb>" y)))
(assert (or (not (= (str.indexof y "0" 0) 12)) (= (str.indexof y "t=""" 0) 9)))
(assert (not (= (str.at y 65) "o")))
(assert (not (str.prefixof "<sc" x)))
(check-sat)
