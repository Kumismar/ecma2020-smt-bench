; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><output ondragover=alert(1) contenteditable>drop here</output>") (= x "<style>@keyframes x{}</style><spacer style=""animation-name:x"" onanimationstart=""alert(1)""></spacer>")))
(assert (or (= z "input autofocus>") (= z "own=""alert(1)"">test</track>") (= z "g>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "tof" 0) 8)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[^0]\d{10,10}$")))))
(assert (or (= (str.indexof x ">d" 0) 37) (not (str.contains z "g>")) (str.in_re y ((_ re.from_regex ecma2020) "^[^0-9]+$"))))
(assert (str.prefixof "<sty" x))
(assert (or (str.contains (str.replace z "fr\u{1f600}" "javascript:") "/javascript:ame") (str.contains (str.replace y "on" "alert(1)") "matialert(1)-na") (not (= (str.at y 74) "t"))))
(assert (or (not (= (str.indexof z "g" 0) 0)) (>= (str.len y) 106)))
(check-sat)
