; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG SRC=javascript&#058;alert(&quot;XSS&quot;)&gt;") (= x "<area oncut=""alert(1)"" contenteditable>test</area>")))
(assert (or (= z "(1)") (= z "id=x tabindex=1 onfocusin=alert(1\u{1f600})></content>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 50) "(")))
(assert (or (str.prefixof "&" y) (not (str.in_re x ((_ re.from_regex ecma2020) "^1[35478][0-9]{9}$")))))
(assert (not (= (str.at y 16) "r")))
(assert (str.suffixof ")" z))
(assert (or (not (= (str.indexof y "t(&qu" 0) 32)) (not (= "&;IMG SRC=javascript&#058;alert(&quot;XSS&quot;)&gt;(1)" (str.replace y "lt" ""))) (not (= (str.indexof x "er" 0) 15))))
(assert (not (= (str.at z 30) "t")))
(check-sat)
