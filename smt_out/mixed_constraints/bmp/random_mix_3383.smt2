; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><keygen style=""animation-name:x"" onanimationend=""alert(1)""></keygen>") (= x "<svg onmousedown=""alert(1)"">test</svg>") (= x "<ins onmouseover=""alert(1)"">test</ins>")))
(assert (or (= z "g>") (= z "nt.cookie);//<</script>") (= z "1)"">test</ins>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "</ins>" (str.substr z 8 9))) (= (str.at z 9) ")") (not (= (str.len z) 2))))
(assert (not (str.contains y "avascri")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z s]+$"))))
(assert (or (not (str.contains z """>test<")) (not (= (str.indexof z "g" 0) 0)) (<= (str.len z) 2)))
(check-sat)
