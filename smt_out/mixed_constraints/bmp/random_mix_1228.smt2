; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame onmouseleave=""alert(1)"">test</frame>") (= x "<dialog draggable=""true"" ondragleave=""alert(1)"">test</dialog>")))
(assert (or (= z "t</aside>") (= z " tabindex=1 id=x></abbr><input autofocus>") (= z "><C><![<IMG SRC=""javas]]<![cript:document.vulnerable=true;"">]]</C></X></xml><SPAN DATASRC=#I DATAFLD=C DATAFORMATAS=HTML></span>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 0) ">")) (str.contains y "ame o")))
(assert (or (str.contains y ")"">te") (str.in_re y ((_ re.from_regex ecma2020) "^([0-2][0-9]|(3)[0-1])(\/)(((0)[0-9])|((1)[0-2]))(\/)\d{4}$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^\+?(\d[\d\-\.\s]+)?(\([\d\-\.\s]+\))?[\d\-\.\s]+\d$")) (not (str.contains z "ont"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[\w\.+\-_]+@([\w\d-]+\.)+[\w]{2,12}$"))) (<= (str.len y) 103) (not (str.prefixof "<frame o" y))))
(assert (not (= "<dialog draggablalert(1)=""true"" ondragleave=""alert(1)"">test</dialog>><C><![<IMG SRC=""javas]]<![cript:document.vulnerable=true;"">]]</C></X></xml><SPAN DATASRC=#I DATAFLD=C DATAFORMATAS=HTML></span>" (str.replace y "e" "alert(1)"))))
(assert (or (not (str.prefixof "<fra" x)) (not (= (str.at x 29) """"))))
(check-sat)
