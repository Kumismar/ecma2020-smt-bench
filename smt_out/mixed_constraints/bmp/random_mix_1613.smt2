; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<animation xlink:href=""javascript:alert(88)""/>") (= x "<div draggable=""true"" contenteditable>drag me</div><embed ondrop=alert(1) contenteditable>drop here</embed>")))
(assert (or (= z """>test</slot>") (= z "ils draggable=""true"" ondragend=""alert(1)"">test</details>") (= z "ascript:javascript:alert(1);"">")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 11) (>= (str.len z) 4) (not (= (str.at x 105) "d"))))
(assert (or (not (str.suffixof "t>" y)) (not (str.contains x "nimat")) (not (str.contains z "ble="))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "\b\d{3}\.\d{3}\.\d{3}-\d{2}\b|\b(\d{11})\b|\b[a-z]{5}-ldpa[0-9]{1}\b|\b[a-z]{5}\b-[a-z]{6}\b")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9+_.-]+@[a-zA-Z0-9.-]+$"))) (not (= (str.indexof y "rt(1" 0) 28))))
(assert (not (= "e</div><em" (str.substr x 44 10))))
(assert (or (= "cr" (str.substr y 28 2)) (= ";"">" (str.substr z 27 6)) (str.prefixof """>test</s" z)))
(assert (or (not (<= (str.len z) 58)) (= (str.indexof z "rt" 0) 22)))
(check-sat)
