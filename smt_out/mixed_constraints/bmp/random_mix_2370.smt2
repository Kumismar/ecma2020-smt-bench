; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><style id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></style>") (= x "<rp onfocusout=alert(1) tabindex=1 id=x></rp><input autofocus>") (= x "<style>:target {transform: rotate(180deg);}</style><template id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></template>")))
(assert (or (= z ";&lt;/SCRIPT&gt;") (= z " ondblclick=""alert(1)"">test</param>") (= z "EF")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<sty" x)) (not (str.contains (str.replace x "}" """") " red;""</st"))))
(assert (str.suffixof "tofocus>EF" y))
(assert (or (= (str.indexof y "0s" 0) 73) (not (= (str.at z 26) "t"))))
(assert (or (str.suffixof "/shadow>" x) (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-zA-Z]).{1,}"))) (not (= (str.indexof x "=al" 0) 14))))
(assert (or (not (= (str.at x 76) "n")) (not (= (str.indexof y "tra" 0) 16))))
(assert (not (= (str.len z) 2)))
(check-sat)
