; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><dd onload=alert(1)></dd>") (= x "<div draggable=""true"" contenteditable>drag me</div><dir ondrop=alert(1) contenteditable>drop here</dir>") (= x "<META HTTP-EQUIV=""Link"" Content=""<%(css)s>; REL=stylesheet"">")))
(assert (or (= z "=""true"" ondragleave=""alert(1)"">test</mark>") (= z "lert(1)"">test</div>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len x) 34)))
(assert (not (str.prefixof "<META H" x)))
(assert (or (str.contains z "div>") (str.prefixof "=""true""" z) (= "<svg><dd onload=alerjavascript:1)></dd>" (str.replace x "t(" "javascript:"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[-0-9]{1,}$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{1,5}"))))
(assert (not (str.prefixof "lert(1)""" z)))
(check-sat)
