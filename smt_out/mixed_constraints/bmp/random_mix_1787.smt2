; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menuitem oncut=""alert(1)"" contenteditable>test</menuitem>") (= x "<dt draggable=""true"" ondragend=""alert(1)"">test</dt>")))
(assert (or (= z "e"" contenteditable>drag me</div><dialog ondragover=alert(1) contenteditable>drop here</dialog>") (= z "id=x tabindex=1 onbeforeactivate=alert(1)></meter>") (= z "id=x tabindex=1 onbeforeactivate=alert(1)></var>")))
(assert (= y (str.++ x z)))
(assert (= (str.at z 46) "r"))
(assert (or (not (str.suffixof ">" z)) (not (str.suffixof ">" y))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^12$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*?[\u{5c}u30A1-\u{5c}u30FC])[\u{5c}u30A1-\u{5c}u30FC\s]*")))))
(assert (or (not (= (str.len y) 99)) (str.suffixof ">" x)))
(assert (not (= "<menuitem oncut=""alert(1)"" contenteditable>test</menuitem>id=x tabindex=xbeforeactivate=alert(1)></var>" (str.replace y "1 on" "x"))))
(check-sat)
