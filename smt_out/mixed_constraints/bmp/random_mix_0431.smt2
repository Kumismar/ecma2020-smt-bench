; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<content onbeforecut=""alert(1)"" contenteditable>test</content>") (= x "<kbd onkeydown=""alert(1)"" contenteditable>test</kbd>") (= x "<style>:target {color:red;}</style><img id=x style=""transition:color 1s"" ontransitionend=alert(1)></img>")))
(assert (or (= z "alert('XSS');\""&gt;") (= z "ick=""alert(1)"">test</data>") (= z "ess><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<kbd onke" y) (>= (str.len z) 9)))
(assert (or (str.suffixof "m>" z) (str.contains x "wn=""ale") (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z]{1}$|^[A-Za-z]{1}[-+ ]{1}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{14}$"))))
(assert (not (str.suffixof "ofocus>" z)))
(assert (not (= (str.len y) 81)))
(assert (or (not (<= (str.len x) 54)) (= (str.at z 2) "o")))
(assert (not (str.contains (str.replace x "/styl" " ") "d;}< e")))
(assert (or (not (= (str.at z 24) "a")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[u4e00-u9fa5]{1,7}$")))))
(assert (str.suffixof "g>" x))
(check-sat)
