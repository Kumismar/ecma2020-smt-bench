; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src ?itworksonchrome?\/onerror = alert(1)") (= x "<strong onbeforepaste=""alert(1)"" contenteditable>test</strong>")))
(assert (or (= z "<title style=""animation-name:x"" onanimationend=""alert(1)""></title>") (= z ";/A>;") (= z "n>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 5) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\w](?!.*?\.{2})[\w.]{1,28}[\w]$"))) (= ">" (str.substr y 63 5))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^.{7,255}$"))) (not (str.contains x "rksonchro")) (= "<strong onbeforepaste=""alert(1)"" conte""table>test</strong>" (str.replace x "ntedi" """"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\+\(\) ]{8,}$"))) (not (str.prefixof "<i" x)) (>= (str.len y) 45)))
(assert (or (= ">" (str.substr x 61 6)) (not (= (str.len z) 56))))
(assert (or (= (str.at z 2) "(") (not (= (str.at z 1) ">"))))
(check-sat)
