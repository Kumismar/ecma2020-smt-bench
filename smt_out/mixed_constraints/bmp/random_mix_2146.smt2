; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd id=x tabindex=1 onfocus=alert(1)></dd>") (= x "<sup onblur=alert(1) ta\u{1d400}bindex=1 id=x></s\u{20000}up><input autofocus>")))
(assert (or (= z "rm>") (= z "mouseup=""alert(1)"">test</th>")))
(assert (= y (str.++ x z)))
(assert (or (not (= " autofocu" (str.substr z 0 9))) (not (= (str.indexof x "up><i" 0) 42))))
(assert (or (= (str.at z 1) "m") (str.prefixof "<sup o" x)))
(assert (str.contains z "rm>"))
(assert (or (not (str.contains y "1)")) (str.in_re z ((_ re.from_regex ecma2020) "^(((0[1-9]|[12][0-9]|3[01])[/](0[13578]|1[02])|(0[1-9]|[12][0-9]|30)[/](0[469]|11)|(0[1-9]|1\d|2[0-8])[/]02)[/]\d{4}|29[/]02[/](\d{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[1359][26])00))$")) (str.in_re x ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{435}\u{401}a-zA-Z]+$"))))
(assert (str.prefixof "mouseup=" z))
(assert (or (str.prefixof "r" z) (not (>= (str.len y) 41)) (<= (str.len x) 62)))
(check-sat)
