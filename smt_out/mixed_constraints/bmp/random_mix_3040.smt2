; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>dr\u{1f600}ag me</div><isindex ondrop=alert(1) cont\u{1f4a9}enteditable>drop here</isindex>") (= x "<cite id=x tabindex=1 onbeforedeactivate=alert(1)></cite><input autofocus>") (= x "<iframe src=javascript:alert(1)>")))
(assert (or (= z "rt)") (= z "ert(1)"">test</dialog>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "1)>" x))
(assert (or (str.suffixof "tofocus>" x) (not (str.contains y "activa")) (not (str.contains (str.replace z "t)" "x") "rx"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^(IR|IG|IN|IP|IH|IM|ir|ig|in|ip|ih|im).+")) (not (= ")" (str.substr z 2 9)))))
(assert (str.suffixof "t)" z))
(assert (or (not (>= (str.len z) 1)) (str.contains y "me</div>") (not (= (str.at z 13) "/"))))
(assert (or (= (str.indexof z "l" 0) 1) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$"))) (not (str.prefixof "rt" z))))
(check-sat)
