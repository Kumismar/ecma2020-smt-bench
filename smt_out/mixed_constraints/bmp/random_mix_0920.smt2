; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<?xml version=""1.0"" encoding=""ISO-8859-1""?><!DOCTYPE foo [<!ELEMENT foo ANY><!ENTITY x\u{20000}xe SYSTEM ""fil\u{1f600}e:///dev/random"">]><foo>&xee;</foo>") (= x "<p draggable=""true"" ondragend=""alert(1)"">test</p>")))
(assert (or (= z "le=""animation-name:x"" onanimationend=""alert(1)""></xss>") (= z "drag=""alert(1)"">test</thead>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[( )a-zA-Z]+$"))) (= "d g=""alert(1)"">test</thead>" (str.replace z "ra" " "))))
(assert (or (str.prefixof "`-aler" y) (not (= "gabl" (str.substr x 7 4))) (= "end=""a" (str.substr z 33 6))))
(assert (not (= (str.indexof y " on" 0) 19)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{3,25}")) (not (str.prefixof "<p d" y)) (not (str.contains x "?xml versi"))))
(assert (not (= "></select" (str.substr y 120 9))))
(assert (or (not (<= (str.len x) 140)) (not (str.contains z "tion-name"))))
(assert (or (not (= (str.at y 65) "m")) (not (str.prefixof "<?xml " x))))
(check-sat)
