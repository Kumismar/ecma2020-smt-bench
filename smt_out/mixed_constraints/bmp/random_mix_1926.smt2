; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b id=x tabindex=1 onfocus=alert(1)></b>") (= x "<;IMG SRC=JaVaScRiPt\u{1d400}:alert(';XSS';)>;") (= x "<q onkeydown=""alert(1)"" contenteditable>test</q>")))
(assert (or (= z "rt(1)"">test</bgsound>") (= z "eenter=""alert(1)"">test</abbr>") (= z "t(1) type=image/gif>")))
(assert (= y (str.++ x z)))
(assert (= " draggable=""true"" contenteditable>drag me</div><area ondragover""lert(1) contenteditable>drop here</area>" (str.replace z "=a" """")))
(assert (or (not (= "ticol>" (str.substr z 34 8))) (str.prefixof "<b" x)))
(assert (or (= (str.len x) 48) (not (str.suffixof "gif>" y)) (str.suffixof "td>" z)))
(assert (not (= (str.at x 37) ";")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z-0-9]+$"))))
(assert (or (not (= (str.indexof z "enter" 0) 1)) (not (str.contains x "est</t\u{10348}")) (not (= (str.indexof x "t</q" 0) 43))))
(check-sat)
