; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style o\u{1f4a9}ncontextmenu=""alert(1)"">test</style>") (= x "<ol onmousedown=""alert(1)"">test</ol>") (= x "<colgroup onmouseout=""alert(1)"">test</colgroup>")))
(assert (or (= z "rt(1)"">test</wbr>") (= z """javascript:alert('XSS')"");}</STYLE><UL>\u{10348}\u{10348}<LI>XSS</br>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "down=""a") (not (str.suffixof "test</wbr>" y)) (not (str.prefixof "<style o" x))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[\u{5c}u2015\u{5c}u3000\u{5c}u30A1-\u{5c}u30F6\u{5c}u30FB-\u{5c}u30FE]+$")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "regardons"))))
(assert (or (str.suffixof "/style>" x) (= (str.indexof x "n" 0) 9)))
(assert (or (= (str.at y 79) "E") (str.prefixof "<ol onm" x)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "\d{6,10}")))
(assert (or (not (str.prefixof "<style>:ta" y)) (not (= (str.indexof z "ert(1" 0) 1)) (not (= ">test" (str.substr x 31 5)))))
(check-sat)
