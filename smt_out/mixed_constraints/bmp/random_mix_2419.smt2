; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr onbeforecut=""alert(1)"" contenteditable>test</abbr>") (= x "<figcaption id=x tabindex=1 onfocusin=alert(1)></figcaption>")))
(assert (or (= z " id=y autofocus>") (= z "er><input id=y autofocus>") (= z "nmouseenter=""alert(1)"">test</li>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len y) 68)))
(assert (not (= (str.len x) 56)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z]{2}[0-9]{1,3}$")) (str.contains z "1)"">test<") (str.prefixof "er><i" z)))
(assert (or (>= (str.len z) 25) (str.prefixof "<figcaptio" x) (not (str.contains y "te"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^([123]0|[012][1-9]|31)\/(0[1-9]|1[012])\/(19[0-9][0-9]|20[0-9][0-9])$")) (not (= " id=y aalert(1)ocus>" (str.replace z "utof" "alert(1)")))))
(check-sat)
