(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{5,14}$"))))
(assert (or (not (= (str.at z 6) "t")) (str.suffixof "ldset>" x) (str.suffixof "SS&quot;)>" x)))
(assert (or (not (= (str.at y 23) "0")) (= (str.at y 29) "c") (not (str.in_re y ((_ re.from_regex ecma2020) "^CB\d{3,7}|cb\d{3,7}$")))))
