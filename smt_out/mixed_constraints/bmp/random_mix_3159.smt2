(assert (or (= "e" (str.substr z 0 1)) (= (str.len x) 55) (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z'\u{e0}\u{e2}\u{e9}\u{e8}\u{ea}\u{f4}\u{f9}\u{fb}\u{e7}\u{c0}\u{c2}\u{c9}\u{c8}\u{d4}\u{d9}\u{db}\u{c7}\s-]{1,30})$"))))
(assert (= (str.indexof y ":ale" 0) 19))
(check-sat)
