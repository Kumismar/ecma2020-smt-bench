; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style></style\x09<img src=""about:blank"" onerror=javascript:alert(1)//></style>") (= x "<map id=x tabindex=1 ondeactivate=alert(1)></map><input id=y autofocus>")))
(assert (or (= z "\u{1d400}vate=alert(1)></q>") (= z "nactivate=alert(1)></noscript>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "e><" 0) 5) (str.in_re x ((_ re.from_regex ecma2020) "^[1990-2020]*$"))))
(assert (or (= (str.at z 3) "y") (not (str.contains (str.replace x "l" " ") "sty e></s")) (= (str.indexof x """tru" 0) 18)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[1|2]{1}[0-9]{3}-[0|1]{1}[0-9]{1}-[0-3]{1}[0-9]{1}$"))) (= "le\u{1f4a9}" (str.substr x 32 3))))
(assert (not (= "<map i =x tabindex=1 ondeactivate=alert(1)></map><input id=y autofocus>" (str.replace x "d" " "))))
(assert (str.prefixof "\u{1d400}va" z))
(assert (str.suffixof "utofocus>" x))
(check-sat)
