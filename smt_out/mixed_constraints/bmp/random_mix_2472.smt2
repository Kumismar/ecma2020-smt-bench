; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x16javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<svg><video onload=alert(1)></video>") (= x "<IMG SRC=x oninvalid=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "beforeactivate=alert(1)></template>") (= z ":expression(alert(';XSS';))"";>;")))
(assert (= y (str.++ x z)))
(assert (or (= "<kbd id=x tbindex=1 onfocusin=alert(1)></kbd>cus=alert(1)></a>" (str.replace y "a" "")) (not (str.prefixof "<a href" x))))
(assert (or (not (= (str.at z 29) ">")) (not (str.in_re y ((_ re.from_regex ecma2020) "^0[1-7][0-9]{7}$")))))
(assert (or (str.contains (str.replace z "aut" " ") "nput  ofo") (not (str.suffixof "S';))"";>;" z)) (= "<a href=""\x16javascript:javascript:""(1)"" id=""fuzzelement1"">test</a>" (str.replace x "alert" """"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(\d{5}([\-]\d{4})?)$")) (not (>= (str.len z) 35))))
(assert (= (str.at x 13) "j"))
(check-sat)
