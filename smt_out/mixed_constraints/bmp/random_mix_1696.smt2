; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<FRAMESET><FRAME SRC=""javascript:javascript:alert(1);""></FRAMESET>") (= x "<nobr onkeypress=""alert(1)"" contenteditable>test</nobr>") (= x "<dfn onmouseover=""\u{1f600}alert(1)"">test</dfn>")))
(assert (or (= z "r><br><br><br><br>...<br><br><br><br><input autofocus>") (= z "enteditable>test</hgroup>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<FR" y) (not (= (str.indexof z ">" 0) 1)) (not (= (str.indexof y "r" 0) 15))))
(assert (or (str.contains z "entedit") (not (str.in_re y ((_ re.from_regex ecma2020) ".*^\d{2,4}-?\d{2,4}-?\d{4}$.*"))) (str.suffixof "oup>" y)))
(assert (not (= (str.indexof y "</d" 0) 33)))
(assert (= "br>" (str.substr x 52 10)))
(assert (str.contains (str.replace z "<br><" "x") "r>xb"))
(assert (not (str.prefixof "<textare" x)))
(check-sat)
