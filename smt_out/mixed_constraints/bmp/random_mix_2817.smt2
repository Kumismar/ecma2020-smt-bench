; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><bgsound ondragover=alert(1) contenteditable>drop here</bgsound>") (= x "<iframe id=x tabindex=1 ondeactivate=alert(1)></iframe><input id=y autofocus>")))
(assert (or (= z "t(1)"">test</em>") (= z """ ontransitioncancel=alert(1)></col>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "scri" (str.substr y 28 4))) (<= (str.len x) 123) (not (str.prefixof "<ifram" x))))
(assert (or (not (str.contains x "over=""a")) (str.suffixof ">" x)))
(assert (str.suffixof "l>" y))
(assert (= (str.indexof y "dit" 0) 30))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{2}\/\d{2}\/\d{4}$"))) (<= (str.len z) 40)))
(assert (= "ut id" (str.substr y 59 5)))
(assert (not (>= (str.len x) 71)))
(check-sat)
