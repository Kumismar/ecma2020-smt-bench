; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><head onload=alert(1)></head>") (= x "<multicol onclick=""alert(1)"">test</multicol>") (= x "</style>//[""'`-->]]>]</div>")))
(assert (or (= z "abindex=1 onactivate=alert(1)></li>") (= z "able>test</acronym>") (= z "et {color: red;}</style><div id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></div>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y ">able>") (not (str.suffixof ">" x))))
(assert (str.prefixof "</sty" x))
(assert (or (str.contains z "te=al") (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z\W]+"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^\s*[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]{2,}\s+([\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s\.\-]{2,})$")))))
(assert (not (str.suffixof "v>" x)))
(assert (or (not (str.prefixof "<progress " y)) (not (= "ead>" (str.substr x 30 7)))))
(check-sat)
