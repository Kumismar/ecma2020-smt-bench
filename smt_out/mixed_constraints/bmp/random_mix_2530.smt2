; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s draggable=""true"" ondragstart=""alert(1)"">test</s>") (= x "<input type=checkbox id=x onfocus=alert(1)>")))
(assert (or (= z ")></aside>") (= z "ol onkeyup=""alert(1)"" contenteditable>test</col>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y """al")) (not (str.suffixof "ide>" z))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9\/]{1,50}$"))) (str.contains y "lert(")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(?:(?:\+?1\s*(?:[.-]\s*)?)?(?:\(\s*([2-9]1[02-9]|[2-9][02-8]1|[2-9][02-8][02-9])\s*\)|([2-9]1[02-9]|[2-9][02-8]1|[2-9][02-8][02-9]))\s*(?:[.-]\s*)?)?([2-9]1[02-9]|[2-9][02-9]1|[2-9][02-9]{2})\s*(?:[.-]\s*)?([0-9]{4})(?:\s*(?:#|x\.?|ext\.?|extension)\s*(\d+))?$"))))
(assert (or (not (str.prefixof "<s dragga" y)) (str.in_re x ((_ re.from_regex ecma2020) "^[_0-9]+")) (not (str.suffixof "t(1)>" x))))
(assert (or (not (str.prefixof "<s" x)) (>= (str.len z) 10)))
(assert (or (not (= (str.len y) 61)) (<= (str.len x) 59)))
(check-sat)
