; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot onbeforepaste=""alert(1)"" contenteditable>test</tfoot>") (= x "<dt id=x tabindex=1 ondeactivate=alert(1)></dt><input id=y autofocus>") (= x "<li onmouseout=""alert(1)"">test</li>")))
(assert (or (= z "(1)"" contenteditable>test</bgsound>") (= z "ck=""alert(1)"">test</b>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][0-9a-zA-Z]*@{1}[0-9a-zA-Z]+.(com|net|cn|com.cn)$"))) (>= (str.len z) 28)))
(assert (>= (str.len x) 61))
(assert (not (str.contains (str.replace z ")"">" "alert(1)") "rt(1alert(1)t")))
(assert (not (= "ivat" (str.substr x 27 4))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "\d+$"))))
(assert (not (str.contains x "(1)")))
(assert (or (str.contains z "/bgsound>") (not (str.in_re x ((_ re.from_regex ecma2020) "[a-z0-9._%+-a-z]+@[a-z0-9.-]+\.[a-z]{2,9}$"))) (not (str.contains x "color: "))))
(assert (or (not (str.prefixof "ck=""alert(" z)) (= (str.at z 7) "n")))
(check-sat)
