; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<head><META HTTP-EQUIV=""CONTENT-TYPE"" CONTENT=""text/html; charset=UTF-7""> </HEAD>+ADw-SCRIPT+AD4-document.vulnerable=true;+ADw-/SCRIPT+AD4-") (= x "<blink onkeypress=""alert(1)"" contenteditable>test</blink>") (= x "<style>:target {color: red;}</style><frameset id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></frameset>")))
(assert (or (= z "t</noscript>") (= z ">") (= z "nfocus=alert(1)></details>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 3) "i")) (= (str.at y 65) "i") (not (str.contains x "c\u{10348}lick=""a"))))
(assert (= "<blink onkeypress=""alert(1)"" contentedit<b>>test</blink>>" (str.replace y "able" "<b>")))
(assert (or (str.suffixof "/details>" z) (not (= (str.indexof z ">" 0) 0))))
(assert (or (not (>= (str.len x) 43)) (= "SS<;/ " (str.replace z "A>;" " ")) (not (str.in_re z ((_ re.from_regex ecma2020) "^((([0-1][0-9])|2[0-3])[\:]([0-5][0-9])([\:][0-5][0-9])?)|((([0][0-9])|1[0-2])[\:]([0-5][0-9])([\:][0-5][0-9])?([AM|PM])?)$")))))
(assert (or (not (str.prefixof "<head><ME" x)) (not (str.suffixof "s>" z))))
(check-sat)
