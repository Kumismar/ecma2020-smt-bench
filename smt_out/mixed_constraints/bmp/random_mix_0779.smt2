; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><hr style=""animation-name:x"" onanimationstart=""alert(1)""></hr>") (= x "<slot id=x tabindex=1 onfocus=alert(1)></slot>")))
(assert (or (= z "ste=""alert(1)"" contenteditable>test</body>") (= z " onkeypress=""alert(1)"" contenteditable>test</map>") (= z "ragend=""alert(1)"">test</xmp>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{0,6}"))))
(assert (or (not (str.suffixof "p>" z)) (= "=""anim" (str.substr y 38 6)) (not (= """ onani" (str.substr y 56 7)))))
(assert (or (str.suffixof "est</nav>" x) (not (= (str.indexof x "</" 0) 21)) (= (str.at y 15) "o")))
(assert (or (= (str.indexof z "edit" 0) 30) (not (= (str.indexof x "t</ma" 0) 44))))
(check-sat)
