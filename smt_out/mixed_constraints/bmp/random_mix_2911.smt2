; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><dir id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dir>") (= x "<applet onerror applet onerror=""javascript:javascript:alert(1)""></applet onerror>")))
(assert (or (= z "alert(1)"">test</dialog>") (= z "t:set attributeName=""innerHTML"" targetElement=""x"" to=""&lt;img&#11;src=x:x&#11;onerror&#11;=alert(116)&gt;"">//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{4}[A-Za-z]{2}")))
(assert (or (= (str.indexof y "s"" on" 0) 90) (not (= (str.at y 53) ":")) (str.in_re x ((_ re.from_regex ecma2020) "13"))))
(assert (or (= "<a  onerror applet onerror=""javascript:javascript:alert(1)""></applet onerror>" (str.replace x "pplet" " ")) (<= (str.len z) 136) (= "x&#11;" (str.substr y 153 6))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{16}$"))) (not (>= (str.len z) 125))))
(assert (str.prefixof "<di" y))
(assert (or (str.contains (str.replace y "ent" "") "Elem=") (= (str.at y 17) "b")))
(check-sat)
