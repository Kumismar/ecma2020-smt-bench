; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<u id=x tabindex=1 onbeforeactivate=alert(1)></u>") (= x "<html onbeforecut=""alert(1)"" contenteditable>test</html>")))
(assert (or (= z "s>") (= z "ion id=x tabindex=1 onfocus=alert(1)></figcaption>") (= z "ere</noframes>")))
(assert (= y (str.++ x z)))
(assert (or (= "on>" (str.substr z 47 3)) (str.suffixof "quote>" z)))
(assert (str.contains x "ert(1)>"))
(assert (<= (str.len z) 23))
(assert (not (= "nteditable" (str.substr x 34 10))))
(assert (str.contains z "s>"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+]{1}[a-zA-Z0-9._%+-]*@([a-zA-Z0-9-]{2,63}\.)+[a-zA-Z]{2,7}$"))) (not (= (str.at y 66) "p"))))
(assert (or (= "cap" (str.substr z 42 3)) (not (>= (str.len y) 92))))
(check-sat)
