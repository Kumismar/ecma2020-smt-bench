; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object id=x onfocusin=alert(1) type=text/html>") (= x "<template onmouseup=""alert(1)"">test</template>")))
(assert (or (= z "nd>") (= z "progress>") (= z "LE>;BODY{-moz-binding:url("";http://ha.ckers.org/xssmoz.xml#xss"";)}<;/STYLE>;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[+\d](?:.*\d)?$"))) (not (= (str.indexof z "http" 0) 28)) (not (>= (str.len y) 82))))
(assert (or (not (str.suffixof "E>;" y)) (= (str.at x 19) """") (= "<object id=x onfjavascript:sin=alert(1) type=text/html>" (str.replace x "ocu" "javascript:"))))
(assert (str.suffixof "mplate>nd>" y))
(assert (or (not (str.contains y """>te")) (not (= "text/html" (str.substr y 37 9)))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[\+\d ]+")))
(check-sat)
