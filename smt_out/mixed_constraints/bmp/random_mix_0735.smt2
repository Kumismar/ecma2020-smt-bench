; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<template id=x tabindex=1 onactivate=alert(1)></template>") (= x "<picture onmousemove=""alert(1)"">test</picture>") (= x "<source onmouseover=""alert(1)"">test</source>")))
(assert (or (= z "ntenteditable>test</details>") (= z "-EQUIV=""Set-Cookie"" Content=""USERID=<SCRIPT>document.vulnerable=true</SCRIPT>"">")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "list" 0) 27) (str.contains (str.replace y "l" "") "abe=""tr") (not (str.in_re y ((_ re.from_regex ecma2020) "^\d\d\d\d\d(-\d\d\d\d)?$")))))
(assert (or (not (str.contains (str.replace y "ails" "javascript:") "tjavascript:>")) (not (= (str.indexof y "CRI" 0) 82)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z\s -]+$")))))
(assert (or (str.prefixof "<temp" y) (not (<= (str.len x) 47))))
(assert (not (= (str.indexof z "DEF" 0) 2)))
(assert (= (str.len z) 28))
(assert (not (= "</" (str.substr z 18 2))))
(check-sat)
