; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area onfocusout=alert(1) tabindex=1 id=x></area><input autofocus>") (= x "<style>:target {color:red;}</style><object id=x style=""transition:color 1s"" ontransitionend=alert(1)></object>") (= x "<image xlink:href=""data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' onload='alert(88)'%3E%3C/svg%3E""/>")))
(assert (or (= z "ion:transform 2s"" ontransitionrun=alert(1)></multicol>") (= z "tc>") (= z "eleave=""alert(1)"">test</menuitem>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<image xl" x) (str.contains (str.replace y "x=1 o" "<b>") "binde<b>nacti")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^.{5,}"))))
(assert (or (= "eleave=""alert(1)"">test</tem>" (str.replace z "menui" "")) (not (= (str.indexof x "0/svg" 0) 73))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[\x20-\x7e\x80-\xff]*$"))) (not (str.contains z ">"))))
(assert (or (= (str.at x 4) "l") (not (= "vg%3E""/" (str.substr y 106 7)))))
(assert (or (not (= (str.at y 112) ">")) (= (str.at y 95) "s") (not (= (str.indexof x "dex=" 0) 31))))
(assert (not (str.prefixof "tc>" z)))
(check-sat)
