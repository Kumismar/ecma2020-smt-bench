; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element i\u{20000}d=x tabindex=1 onactivate=alert(1)></element>") (= x "<link onpaste=""alert(1)"" contenteditable>test</link>")))
(assert (or (= z "s>") (= z "id=x onfocusin=alert(1)>") (= z """></SCRIPT>")))
(assert (= y (str.++ x z)))
(assert (not (= "<center id=x tabindex=1 onactivate=alert(1)></center>cript on >" (str.replace y "Load" " "))))
(assert (or (not (= (str.len x) 52)) (str.contains (str.replace z "SC" "javascript:") "/javascript:RIPT") (not (str.in_re y ((_ re.from_regex ecma2020) "^\w+@[a-zA-Z_]+?\.[a-zA-Z]{2,3}$")))))
(assert (or (str.contains (str.replace y "ent" "") "m i") (not (= (str.at z 0) "s"))))
(assert (or (= (str.at x 0) "<") (= (str.len z) 2)))
(check-sat)
