; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><picture style=""animation-name:x"" onanimationstart=""alert(1)""></picture>") (= x "<center ondblclick=""alert(1)"">test</center>") (= x "&lt;?xml&\u{20000}#58;namespace prefix=\""t\"" ns=\""urn&#58;schemas-microsoft-com&#58;time\""&gt;")))
(assert (or (= z "9, 41)</SCRIPT>") (= z "pt>") (= z """ contenteditable>test</article>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 6) "<") (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$")) (not (= ">" (str.substr y 74 3)))))
(assert (not (= """ con" (str.substr z 0 5))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9a-zA-Z_.-]+@[0-9a-zA-Z.-]+[.]+[a-zA-Z]{2,}$"))) (not (str.suffixof "enter>" x)) (not (= (str.indexof y "t</" 0) 33))))
