; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<STYLE>li {list-style-image: url(""javascript:alert('XSS')"");}</STYLE><UL>\u{10348}\u{10348}<LI>XSS</br>") (= x "<plaintext onmouseover=""alert(1)"">test</plaintext>") (= x "<style>@keyframes x{}</style><tr style=""animation-name:x"" onanimationend=""alert(1)""></tr>")))
(assert (or (= z "</textarea><input autofocus>") (= z "rt'%(css)s';</STYLE>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len x) 79)) (str.contains (str.replace y "-" "x") "stxst") (= (str.at y 65) "Y")))
(assert (or (= (str.len y) 109) (str.prefixof "<ST" x) (not (str.contains y ") ta"))))
(assert (or (>= (str.len z) 19) (not (str.suffixof ">" z)) (not (str.contains z "gt"))))
(assert (not (= (str.indexof x "va" 0) 36)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z\u{142}\u{15b}\u{17c}\u{f3}\u{105}\u{119}\u{144}\u{107}][0-9a-z\u{142}\u{15b}\u{17c}\u{f3}\u{105}\u{119}\u{144}\u{107}A-Z-._\-]*$"))) (not (str.contains (str.replace x "plai" "javascript:") "<javascript:ntex"))))
(check-sat)
