; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track onmousemove=""alert(1)"">test</track>") (= x "<marquee onmousemove=""alert(1)"">test</marquee>") (= x "<em onfocusout=alert(1) tabindex=1 id=x></em><input autofocus>")))
(assert (or (= z "on onmousemove=""alert(1)"">test</figcaption>") (= z "er onmousedown=""alert(1)"">test</footer>") (= z "le draggable=""true"" ondragenter=""alert(1)"">test</title>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_\+.~#?&//=]*)"))))
(assert (or (= (str.indexof x "<" 0) 0) (not (str.prefixof "<sup" y)) (= "onxnmousemove=""alert(1)"">test</figcaption>" (str.replace z " o" "x"))))
(assert (or (str.prefixof "rt(1)"" " z) (not (= " draggab" (str.substr y 48 8))) (str.suffixof "ption>" y)))
(assert (or (not (str.contains (str.replace z "n" "x") "ox on")) (str.contains (str.replace y "mo" " ") " on usemo")))
(check-sat)
