; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<wbr draggable=""true"" ondrag=""alert(1)"">test</wbr>") (= x "<audio onmouseenter=""alert(1)"">test</audio>") (= x "<scr<script>ipt>alert(1)</scr</script>ipt>")))
(assert (or (= z "rt(1)>") (= z "index=1 onactivate=alert(1)></link>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<audio onmouseenter="" t(1)"">test</audio>" (str.replace x "aler" " "))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9()\-+Xx\s,]+$")))))
(assert (or (<= (str.len y) 89) (= (str.indexof x " id=" 0) 4) (not (= "alert(1)scr<script>ipt>alert(1)</scr</script>ipt>" (str.replace x "<" "alert(1)")))))
(assert (or (str.prefixof "rt(1)>" z) (= (str.at x 17) "d")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\u{d6}\u{f6}\u{fc}\u{dc}\u{c4}\u{e4}\u{df}\s\-]*)$"))))
(check-sat)
