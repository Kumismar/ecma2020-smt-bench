; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><dd style=""animation-name:x"" onanimationstart=""alert(1)""></dd>") (= x "<listing id=x tabindex=1 onbeforeactivate=alert(1)></listing>")))
(assert (or (= z "rame id=x onfocusin=alert(1)>") (= z "nkeypress=""alert(1)"" contenteditable>test</basefont>") (= z "2867/&quot;&gt;XSS&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<listin" x) (str.contains (str.replace z "1)>" "<b>") "t(<b>")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9 ,.'-]+$"))) (not (str.prefixof "<listin" y))))
(assert (or (not (= "bindex=1" (str.substr x 16 8))) (not (= (str.len x) 48))))
(assert (or (str.contains y "t(1)></li") (= (str.indexof y "orea" 0) 30)))
(check-sat)
