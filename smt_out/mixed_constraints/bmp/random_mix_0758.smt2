; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe ondblclick=""alert(1)"">test</iframe>") (= x "<bdo oncut=""alert(1)"" contenteditable>test</bdo>") (= x "<svg draggable=""true"" ondragend=""alert(1)"">test</svg>")))
(assert (or (= z " ??XSS??") (= z "le=""transition:transform 10s"" ontransitioncancel=alert(1)></xss>") (= z " onerror=""javascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "</" 0) 5)) (not (= (str.at y 47) "<")) (str.contains z "ntr")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z]([a-zA-Z0-9\-]){1,}[a-zA-Z0-9]$"))) (not (<= (str.len x) 58))))
(assert (or (str.contains (str.replace x "ntent" """") """ co""edi") (not (= """" (str.substr y 15 1))) (not (str.prefixof "ert(1" z))))
(assert (not (= "<iframe ond<b>click=""alert(1)"">test</iframe>" (str.replace x "bl" "<b>"))))
(check-sat)
