; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><output style=""animation-name:x"" onanimationstart=""alert(1)""></output>") (= x "<style>@keyframes x{}</style><applet style=""animation-name:x"" onanimationend=""alert(1)""></applet>")))
(assert (or (= z "{alert(&#039;XSS&#039;)}\&quot;&gt;") (= z "oncontextmenu=""alert(1)"">test</content>") (= z "lert(1)></i>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "onend" (str.substr y 71 5))) (>= (str.len y) 83)))
(assert (str.suffixof ">" y))
(assert (str.contains (str.replace y "m" """") "eyfra""es"))
(assert (or (= (str.indexof x "ar" 0) 75) (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{5}|[A-Za-z\d]{3}\s?[A-za-z\d]{3}$")))))
(assert (= (str.at x 49) "t"))
(assert (or (not (= (str.len z) 35)) (= (str.indexof y "t>on" 0) 95)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[0-9a-zA-Z_.-]+@[0-9a-zA-Z.-]+[.]+[a-zA-Z]{2,}$")))
(assert (or (str.prefixof "T" z) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w.-]+@[\w.-]+\.[a-zA-Z]{2,4}$"))) (not (str.prefixof "{ale" z))))
(assert (= "er" (str.substr y 21 2)))
(check-sat)
