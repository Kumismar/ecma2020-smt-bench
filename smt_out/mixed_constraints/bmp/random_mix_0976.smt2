; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tr draggable=""true"" ondragenter=""alert(1)"">test</tr>") (= x "ABC<div style=""x:\x20expression(javascript:alert(1)"">DEF") (= x "<style>@keyframes x{}</style><isindex style=""animation-name:x"" onanimationstart=""alert(1)""></isindex>")))
(assert (or (= z "var><input id=y autofocus>") (= z "draggable=""true"" ondragenter=""alert(1)"">test</strike>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 15) ">") (not (str.contains (str.replace z "le" "<b>") "gab<b>=""tru")) (>= (str.len y) 154)))
(assert (or (not (str.contains x "\u{10348}\u{10348}pa")) (not (str.contains (str.replace x ")"">DE" """") "(1""F"))))
(assert (or (= (str.at y 31) "r") (not (str.in_re y ((_ re.from_regex ecma2020) "^SNB|snb$"))) (str.contains x "tyle")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9]{25,50}"))) (str.contains (str.replace x ":" " ") "x \") (str.in_re y ((_ re.from_regex ecma2020) "^([\u{5c}u30A1-\u{5c}u30FC|\u{5c}u3000]+)$"))))
(assert (or (not (str.contains z "ut")) (str.prefixof "draggable" z) (not (str.suffixof "rike>" y))))
(assert (str.prefixof "<tr" y))
(check-sat)
