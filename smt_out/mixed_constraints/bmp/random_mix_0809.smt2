; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option draggable=""true"" ondragstart=""alert(1)"">test</option>") (= x "<svg><meter onload=alert(1)></meter>")))
(assert (or (= z "t</nobr>") (= z "s>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<op" x) (= (str.len y) 54)))
(assert (or (str.contains y "con") (= "ragstart" (str.substr y 28 8))))
(assert (or (not (str.prefixof "<svg><m" x)) (str.contains (str.replace z "r" "x") "</nobx>")))
(assert (not (str.prefixof "s>" z)))
(assert (or (not (= (str.len z) 8)) (>= (str.len z) 1)))
(assert (not (= (str.at y 11) "g")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}A-Za-z0-9\s]+$")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{c4}\u{e4}\u{d6}\u{f6}\u{dc}\u{fc}\u{df} \-]{3,20}$"))) (str.contains x "/o")))
(assert (str.contains x ")><"))
(assert (= (str.at y 54) "o"))
(check-sat)
