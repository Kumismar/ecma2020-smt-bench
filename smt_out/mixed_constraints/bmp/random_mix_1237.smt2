; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><section id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></section>") (= x "<style>:target {transform: rotate(180deg);}</style><details id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></details>")))
(assert (or (= z "test</script>") (= z "><input autofocus>") (= z "0003c;")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[0-1]?[0-9]")) (= (str.at y 69) "o")))
(assert (or (not (str.contains y "yle>:t")) (= "<style>:target {transform: rota""(180deg);}</style><details id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></details>><input autofocus>" (str.replace y "te" """")) (= (str.at z 0) "x")))
(assert (= (str.indexof x "(1" 0) 8))
(assert (= (str.indexof z "ipt" 0) 9))
(assert (or (not (str.contains z "lfra")) (not (str.prefixof "<s" x))))
(check-sat)
