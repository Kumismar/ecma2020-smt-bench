; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><animate onbegin=alert(1) attributeName=x dur=1s>") (= x "<;STYLE type="";text/css"";>;BODY{background:url("";javascript:alert(';XSS';)"";)}<;/STYLE>;") (= x "<style>:target {color:red;}</style><noembed id=x style=""transition:color 1s"" ontransitionend=alert(1)></noembed>")))
(assert (or (= z ":url('x[a];color:red;/*')"">XXX</x>//[""'`-->]]>]</div>") (= z "seenter=""alert(1)"">test</div>") (= z ";&gt;")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "seenter=" z))
(assert (or (str.prefixof "<s" x) (not (str.suffixof ">" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{3}-\d{2}-\d{4}$")))))
(assert (or (= (str.len z) 36) (not (= (str.at z 34) "/")) (not (= (str.at y 89) "e"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^((?:(?:(?:[a-zA-Z0-9][\.\-\+_]?)*)[a-zA-Z0-9])+)\@((?:(?:(?:[a-zA-Z0-9][\.\-_]?){0,62})[a-zA-Z0-9])+)\.([a-zA-Z0-9]{2,6})$"))) (= (str.len x) 54) (not (= " onbegin" (str.substr y 13 8)))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")))
(assert (not (= (str.indexof y ";)"";" 0) 72)))
(assert (not (str.contains x "r 1s"" ")))
(assert (not (= "/" (str.substr z 34 1))))
(assert (str.prefixof "<" y))
(check-sat)
