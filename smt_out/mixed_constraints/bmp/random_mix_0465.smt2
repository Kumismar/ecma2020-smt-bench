; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dir oncopy=""alert(1)"" contenteditable>test</dir>") (= x "<div draggable=""true"" contenteditable>drag me</div><map ondragover=alert(1) contenteditable>drop here</map>") (= x "<cite onmousedown=""alert(1)"">test</cite>")))
(assert (or (= z "=""true"" ondragstart=""alert(1)"">test</thead>") (= z "ert(0)</script>") (= z "00""></circle>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([1-9]{1}[0-9]{2}[1-9]{1}[0-9]{2}[0-9]{4}|[1-9]{1}[0-9]{2}[ \-]{1}[1-9]{1}[0-9]{2}[ \-]{1}[0-9]{4}|[\(]{1}[1-9]{1}[0-9]{2}[\)]{1}[ ]{1}[1-9]{1}[0-9]{2}[ \-]{1}[0-9]{4})$"))) (not (<= (str.len z) 12)) (= "</div><map" (str.substr y 45 10))))
(assert (or (not (str.contains z "ddres")) (str.prefixof """`'><s" y)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]{2,}\.[a-z]{2,}$"))) (str.contains z "ondra") (= "<b>div draggable=""true"" contenteditable>drag me</div><bdi ondragover=alert(1) contenteditable>drop here</bdi>" (str.replace x "<" "<b>"))))
(assert (or (= (str.len x) 49) (not (str.contains z "est</thead"))))
(assert (not (= (str.indexof y "rt(1)" 0) 70)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[A-za-z??????0-9]{0,}"))))
(assert (or (= (str.at x 30) "d") (not (>= (str.len z) 34))))
(check-sat)
