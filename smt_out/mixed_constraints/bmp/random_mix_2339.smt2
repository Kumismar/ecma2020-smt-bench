; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IM\u{10348}G SRC=x onpause=""alert(Str\u{1f600}ing.fromCharCode(88,83,83))"">") (= x "<body onbeforecopy=""alert(1)"" contenteditable>test</body>") (= x "<isindex onbeforecut=""alert(1)"" contenteditable>test</isindex>")))
(assert (or (= z "c=""about:blank"" onerror=javascript:alert(1)//></style>") (= z "ndragleave=""alert(1)"">test</style>") (= z "/tfoot>")))
(assert (= y (str.++ x z)))
(assert (not (= ")//><" (str.substr z 42 5))))
(assert (or (not (str.contains (str.replace x "ale" "") "e=""rt(")) (str.prefixof "<isind" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_]{3,20}$"))) (= (str.indexof x "in" 0) 31) (= " alert(1)ragend=""alert(1)"">test</hr>" (str.replace z "ond" "alert(1)"))))
(assert (or (not (str.suffixof ">" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "(\+[0-9]+|0)[0-9]( ?[0-9]{2}){4}")))))
(check-sat)
