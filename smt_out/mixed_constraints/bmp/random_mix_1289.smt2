; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address onmouseover=""alert(1)"">test</address>") (= x "<sub onbeforepaste=""alert(1)"" contenteditable>test</sub>") (= x "<style>:target {color: red;}</style><command id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></command>")))
(assert (or (= z "itable>test</meter>") (= z "></bgsound>") (= z "ouseover='\u{5c}u0061lert(1)'>%00")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 5) "v") (not (str.in_re x ((_ re.from_regex ecma2020) "([0-9]{6})?"))) (not (str.prefixof "<a" x))))
(assert (or (str.contains y "rt(") (not (str.prefixof "<style>:t" y))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(([^<>()\[\]\.,;:\s@]+(\.[^<>()\[\]\.,;:\s@]+)*)|(.+))@(([^<>()[\]\.,;:\s@]+\.)+[^<>()[\]\.,;:\s@]{2,})$")) (not (= (str.indexof x ">test" 0) 31)) (= (str.at z 1) "t")))
(assert (or (not (<= (str.len z) 36)) (not (str.suffixof "gsound>" y)) (not (= "></bgsoun" (str.substr z 0 9)))))
(check-sat)
