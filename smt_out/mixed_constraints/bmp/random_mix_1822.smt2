; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite oncopy=""alert(1)"" conte\u{10348}nteditable>test\u{1d400}</cite>") (= x "<colgroup onclick=""alert(1)"">test</colgroup>") (= x "<label draggable=""true"" ondrag=""alert(1)"">test</label>")))
(assert (or (= z "t</body>") (= z "d(confirm)>z")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<colgro" x)))
(assert (or (= "ragg" (str.substr x 8 4)) (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-Za-z0-9]*)$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*[a-zA-Z])[A-Za-z0-9]{4,64}$")))))
(assert (not (= "<colgroup onclalert(1)""alert(1)"">test</colgroup>d(confirm)>z" (str.replace y "ick=" "alert(1)"))))
(assert (not (str.prefixof "<cite on" x)))
(assert (= (str.at z 7) "r"))
(assert (or (<= (str.len z) 12) (not (str.in_re x ((_ re.from_regex ecma2020) "\w+ \w+.*"))) (not (= "<cite onc" (str.substr y 0 9)))))
(assert (or (= (str.at z 0) "d") (not (= (str.at z 1) "<"))))
(assert (not (str.prefixof "<ci" x)))
(check-sat)
