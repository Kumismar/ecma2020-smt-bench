; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<aside onbeforepaste=""alert(1)"" contenteditable>test</aside>") (= x "&lt;SCRIPT a=\""&gt;\"" SRC=\""http&#58;//ha&#46;ckers&#46;org/xss&#46;js\""&gt;&lt;/SCRIPT&gt;")))
(assert (or (= z "/output>") (= z "y=""alert(1)"" contenteditable>test</element>") (= z "(1)"" contenteditable>test</dt>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "side>" x) (not (= (str.len z) 43)) (= "(1)""" (str.substr z 8 4))))
(assert (or (not (= "<aside onbeforepaste=""alert(1)"" contenteditable>test</aside>/oux" (str.replace y "tput>" "x"))) (= "<as<b> onbeforepaste=""alert(1)"" contenteditable>test</aside>" (str.replace x "ide" "<b>"))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^\b[\w ]{1,50}\b$")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([0-9]{8,12})+$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*\d).+$")))))
(assert (or (not (= ";ckers&#" (str.substr x 45 8))) (= (str.indexof y "t" 0) 2) (not (= "ody " (str.substr y 2 4)))))
(assert (or (not (str.prefixof "<i" y)) (str.prefixof "&lt;SC" y) (str.prefixof "y" z)))
(check-sat)
