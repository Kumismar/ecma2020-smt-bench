; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del id=x tabindex=1 onbeforedeactivate=alert(1)></del><input autofocus>") (= x "<basefont draggable=""true"" ondragstart=""alert(1)"">test</basefont>")))
(assert (or (= z "enteditable>test</bgsound>") (= z "></meter>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x "auto")))
(assert (or (not (= (str.len y) 98)) (str.in_re x ((_ re.from_regex ecma2020) "^[0-3][0-7][0-7]|[0-7]{1,2}$"))))
(assert (or (not (= (str.at z 3) "m")) (not (= "<basefont draggable=""true"" ondragstart=""alealert(1))"">test</basefont>" (str.replace x "rt(1" "alert(1)"))) (not (str.in_re y ((_ re.from_regex ecma2020) "(DE\d{20})|(CH\d{19})|(AT\d{18})")))))
(assert (or (str.contains y "put") (not (str.prefixof "<base" x))))
(assert (or (<= (str.len y) 82) (str.prefixof "<style>:" y)))
(check-sat)
