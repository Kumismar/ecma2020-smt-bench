; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby onblur=alert(1) tabindex=1 id=x></ruby><input autofocus>") (= x "<keygen oncut=""alert(1)"" contenteditable>test</keygen>")))
(assert (or (= z "ick=\u{1f4a9}""alert(1)"">test</blink>") (= z "button>") (= z "/javascript,alert(1)""></script>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-z\u{e4}\u{f6}\u{fc}A-Z\u{c4}\u{d6}\u{dc}\u{df}0-9\-\.]{0,70})$"))) (= (str.indexof z "ri" 0) 7)))
(assert (or (not (>= (str.len y) 75)) (= (str.at x 35) "t")))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{13}$")))
(assert (or (not (str.contains z ")""></scr")) (>= (str.len z) 1)))
(assert (or (= (str.indexof z "te" 0) 16) (not (str.prefixof "but" z))))
(assert (or (= (str.at x 44) ">") (not (str.suffixof ">button>" y))))
(assert (<= (str.len y) 112))
(assert (or (not (= (str.at y 33) "d")) (= (str.indexof z "tton>" 0) 2)))
(check-sat)
