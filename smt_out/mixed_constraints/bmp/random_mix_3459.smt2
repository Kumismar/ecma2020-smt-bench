; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#0000060") (= x "//|\\ <script //|\\ src='https://dl.dropbox.com/u/13018058/js.js'> //|\\ </script //|\\") (= x "<mark onfocusout=alert(1) tabindex=1 id=x></mark><input autofocus>")))
(assert (or (= z "draggable=""true"" ondragenter=""alert(1)"">test</tr>") (= z "mouseover=""alert(1)"">test</strike>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,15}"))) (str.suffixof "focus>" x) (not (= (str.indexof z """>tes" 0) 19))))
(assert (or (str.prefixof "//|\\" y) (not (= "000" (str.substr x 4 3)))))
(assert (or (not (str.suffixof "tr>" z)) (= "<mark onfocusout=alert(1) tabindex=1 xx></mark><input autofocus>" (str.replace x "id=" "x")) (not (= (str.indexof y "ox.c" 0) 41))))
(assert (or (not (= (str.indexof y "aler" 0) 20)) (= (str.len z) 49) (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z ]{5,60}")))))
(assert (not (str.suffixof "autofocus>" x)))
(assert (not (str.contains x "k onfocu")))
(assert (not (str.contains (str.replace z "le" "<b>") "ggab<b>=""t")))
(check-sat)
