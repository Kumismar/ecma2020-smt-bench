; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee id=x tabindex=1 onbeforeactivate=alert(1)></marquee>") (= x "<STYLE>li {list-style-image: url(""javascript:alert('XSS')"");}</STYLE><UL>\u{10348}\u{10348}<LI>XSS</br>")))
(assert (or (= z "="";javascript:alert(';XSS';);"";>;") (= z "</tt>") (= z "ter onbeforecopy=""alert(1)"" contenteditable>test</footer>")))
(assert (= y (str.++ x z)))
(assert (str.contains y "</STYLE><U"))
(assert (or (= (str.indexof y " u" 0) 28) (= (str.len x) 61)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z0-9]{6,})$"))) (not (str.contains z "ont")) (str.contains z """;javasc")))
(assert (or (= "ter oalert(1)eforecopy=""alert(1)"" contenteditable>test</footer>" (str.replace z "nb" "alert(1)")) (not (str.prefixof "="";j" z))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z]{0,}")) (= (str.len y) 58) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9\(\)\-\.\s\+]{5,20}")))))
(assert (= (str.at x 26) "n"))
(assert (or (not (= "ipt:ale" (str.substr x 41 7))) (not (= (str.at x 12) "c"))))
(assert (not (= "e=ale" (str.substr x 40 5))))
(check-sat)
