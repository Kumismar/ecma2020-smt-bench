; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<wbr onkeypress=""alert(1)"" contenteditable>test</wbr>") (= x "\u{10348}&#x\u{10348}003C;")))
(assert (or (= z "e>drag me</div><pre ondragover=alert(1) contenteditable>drop here</pre>") (= z "t(1)"">test</header>") (= z "yle>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "ess=""a") (= (str.indexof y "l" 0) 18)))
(assert (= (str.at z 8) "t"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-z0-9._%+-]+@[a-zA-z0-9.-]+\.[a-zA-z]{2,4}$"))) (= " autof" (str.substr z 23 6)) (not (str.prefixof "<wbr" y))))
(assert (or (not (str.contains (str.replace z "v" """") "di""><")) (not (= (str.indexof z "yl" 0) 0))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "(^[-_A-Za-z0-9]+$)")))
(check-sat)
