; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<scrscriptipt>alert(1)</scrscriptipt>") (= x "<dfn draggable=""true"" ondrag=""alert(1)"">test</dfn>") (= x "<div draggable=""true"" contenteditable>drag me</div><section ondragover=alert(1) contenteditable>drop here</section>")))
(assert (or (= z "000003C") (= z """alert(1)"" contenteditable>test</spacer>") (= z "ame:x"" onanimationstart=""alert(1)""></cite>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{8,10}$"))) (not (str.suffixof "03C" z))))
(assert (or (not (str.contains (str.replace x """" "javascript:") "able=javascript:true")) (not (= (str.at x 100) " ")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z. ']*$")))))
(assert (or (not (= (str.len y) 44)) (not (= "rscri" (str.substr x 3 5))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Z]{2,3}_[a-z]+:[0-9]{4}$")))))
(assert (not (= (str.indexof z "000" 0) 0)))
(check-sat)
