; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen id=x \u{1f600}tabindex=1 onbeforeactivate=alert(1)></keygen>") (= x "<figcaption onmouseout=""alert(1)"">test</figcaption>")))
(assert (or (= z "0deg);}</style><map id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></map>") (= z "ut=""alert(1)"" contenteditable>test</applet>") (= z "ipt:alert(('A'))>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\d+(\.\d+)?"))) (not (str.prefixof "<" x))))
(assert (or (not (str.suffixof "(1)></map>" z)) (str.prefixof "<k" y) (= (str.indexof y "=a" 0) 41)))
(assert (or (not (>= (str.len z) 36)) (not (= (str.indexof z "ansi" 0) 34)) (= (str.indexof z "(1)""" 0) 7)))
(assert (str.contains z "eg);}"))
(check-sat)
