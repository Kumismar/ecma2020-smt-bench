; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><tfoot ondragover=alert(1) contenteditable>drop here</tfoot>") (= x "<script itworksinallbrowsers>/*<script* */alert(1)</script")))
(assert (or (= z "1)>") (= z "re>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "/" 0) 29))
(assert (or (not (str.contains z "vate=a")) (not (str.suffixof "1)</script" x))))
(assert (or (not (str.contains x "allbrows")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Z]{1}[AEIOU]{1}[A-Z]{2}[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|1[0-9]|2[0-9]|3[0-1])[HM]{1}(AS|BC|BS|CC|CS|CH|CL|CM|DF|DG|GT|GR|HG|JC|MC|MN|MS|NT|NL|OC|PL|QT|QR|SP|SL|SR|TC|TS|TL|VZ|YN|ZS|NE)[B-DF-HJ-NP-TV-Z]{3}[0-9A-Z]{1}[0-9]{1}$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-\u{17c}A-\u{17b}]{2,20}$"))) (not (= (str.indexof y "drag" 0) 8))))
(assert (= "<script it" (str.substr y 0 10)))
(check-sat)
