; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#x003c") (= x "<IMG """"""><SCRIPT>alert(""XSS"")</SCRIPT>"">")))
(assert (or (= z "plet id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></applet>") (= z ";")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z]+[,.]?[ ]?|[a-z]+['-]?)+$")) (not (= (str.indexof y """"""">" 0) 5))))
(assert (or (str.contains (str.replace z ";" " ") " ") (= "rt(""XSS"")" (str.substr x 20 9)) (not (str.suffixof "x003c;" y))))
(assert (or (= (str.indexof y "03c;" 0) 4) (= "transi" (str.substr z 41 6)) (not (= (str.at y 20) "l"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"))) (not (= (str.at x 4) " "))))
(assert (= (str.indexof x "st" 0) 30))
(check-sat)
