; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;A HREF="";http://ha.ckers.org@google"";>;XSS<;/A>;") (= x "<input onbeforecut=alert(1) value=""XSS"" autofocus>") (= x "<x%0Aonxxx=1")))
(assert (or (= z "div style=""x:expression((window.r==1)?'':eval('r=1;") (= z "n=alert(1) attributeName=x dur=1s>") (= z "d=x tabindex=1 onbeforeactivate=alert(1)></embed>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([^@\s]+)@((?:[-a-z0-9]+\.)+[a-z]{2,})$"))) (not (= (str.at x 6) "n")) (str.in_re z ((_ re.from_regex ecma2020) "[ \t\r\n\f0-9-()+-]*$"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^.{4,}")) (not (= (str.indexof x "%0A" 0) 2)) (>= (str.len y) 61)))
(assert (or (not (= (str.at z 7) "o")) (= "<thead onkeyup=""alert(1)"" contented""table>test</thead>" (str.replace x "i" """")) (not (= "alert(" (str.substr y 19 6)))))
(assert (str.contains x "ers."))
(assert (or (>= (str.len y) 76) (not (= (str.indexof y "a" 0) 19))))
(assert (not (= (str.at x 34) "g")))
(check-sat)
