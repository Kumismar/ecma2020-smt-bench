; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe id=x tabindex=1 onactivate=alert(1)></iframe>") (= x "<label onmousedown=""alert(1)"">test</label>") (= x "<video id=x controls onfocusin=alert(1)><source src=""validvideo.mp4"" type=video/mp4></video>")))
(assert (or (= z "t(';XSS';);//") (= z "onmouseleave=""alert(1)"">test</figcaption>")))
(assert (= y (str.++ x z)))
(assert (= "< bel onmousedown=""alert(1)"">test</label>" (str.replace x "la" " ")))
(assert (or (str.suffixof "l>" x) (not (= (str.at y 31) "a")) (<= (str.len x) 62)))
(assert (str.contains (str.replace x "se" "alert(1)") "moualert(1)down="))
(assert (or (not (str.prefixof "<rt on" y)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[+ 0-9-())]{10,15}$"))) (not (= (str.at y 68) "l"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,}$"))) (str.suffixof "/" y) (str.contains x "ert(1)></")))
(assert (or (str.prefixof "<vid" x) (str.contains (str.replace y "art=""" "alert(1)") "onstalert(1)a")))
(check-sat)
