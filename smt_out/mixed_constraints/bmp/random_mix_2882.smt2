; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<fieldset oncontextmenu=""alert(1)"">test</fieldset>") (= x "<a draggable=""true"" ondragenter=""alert(1)"">test</a>") (= x "<style>:target {transform: rotate(180deg);}</style><img id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></img>")))
(assert (or (= z "=java&#1&#2&#3&#4&#5&#6&#7&#8&#11&#12script:javascript:alert(1)>XXX</a>") (= z " onbeforedeactivate=alert(1)></tbody><input autofocus>") (= z "rt(1)></pre><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9 ]{1,10}$"))))
(assert (not (= ":alert" (str.substr z 54 6))))
(assert (str.contains y "rea> auto"))
(assert (not (str.suffixof "autofocus>" y)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^([0-9]{0,3})$")) (not (<= (str.len z) 31)) (= (str.indexof x "o\u{1f4a9}" 0) 13)))
(assert (str.prefixof "<a d" x))
(check-sat)
