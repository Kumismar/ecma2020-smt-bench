; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><noscript style=""animation-name:x"" onanimationstart=""alert(1)""></noscript>") (= x "&lt;A HREF=&quot;http://www.gohttp://www.google.com/ogle.com/&quot;&gt;XSS&lt;/A&gt;")))
(assert (or (= z "rt(1)"" contenteditable>test</th>") (= z "ct>")))
(assert (= y (str.++ x z)))
(assert (or (= "<div id=""90""><!-- Up to Opera 10.63 -->tenteditable>te t</sub>" (str.replace y "s" " ")) (not (= ">" (str.substr z 31 10)))))
(assert (not (str.prefixof "rt(1)" z)))
(assert (or (not (str.contains y ";XSS&l")) (not (str.in_re x ((_ re.from_regex ecma2020) "^\s?\d{3}-\d{6}?$")))))
(assert (or (str.prefixof "<style>@ke" x) (str.in_re x ((_ re.from_regex ecma2020) "^((\+|00)33\s?|0)[1-9](\s?\d{2}){4}$")) (not (str.in_re x ((_ re.from_regex ecma2020) "[^0-9!@#$%^&*|\\:;<>{}[\]+/?~=()]+")))))
(assert (not (str.suffixof "t>" x)))
(assert (= (str.indexof y "A HRE" 0) 4))
(check-sat)
