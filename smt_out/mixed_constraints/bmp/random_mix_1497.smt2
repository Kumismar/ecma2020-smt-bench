; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><samp onload=alert(1)></samp>") (= x "<sub onmousedown=""alert(1)"">test</sub>")))
(assert (or (= z "le>drop here</font>") (= z "od=""post"">")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_.]{2,}@[a-zA-Z0-9]{2,}.[a-zA-Z]{2,}(.[a-zA-Z]{2,3})?)$")) (str.suffixof "/font>" y)))
(assert (or (= (str.at y 10) "s") (= "></sa" (str.substr x 26 5)) (str.contains (str.replace z "post" " ") """ "">")))
(assert (or (= (str.at x 11) "e") (not (str.contains y "le>dr"))))
(assert (not (str.prefixof "<sub onmo" x)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^1([358][0-9]|4[579]|66|7[0135678]|9[89])\d{8}$"))))
(assert (or (not (str.prefixof "od=""pos" z)) (= (str.at y 51) "<") (str.in_re y ((_ re.from_regex ecma2020) "^-?[0-9]\d*$"))))
(check-sat)
