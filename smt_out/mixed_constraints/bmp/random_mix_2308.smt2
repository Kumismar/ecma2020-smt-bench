; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image id=x tabindex=1 onfocusin=alert(1)></image>") (= x "<STYLE>li {list-style-image: url(""javascript:javascript:alert(1)"");}</STYLE><UL><LI>XSS") (= x "<header onkeydown=""alert(1)"" contenteditable>test</header>")))
(assert (or (= z "ol onkeydown=""alert(1)"" contenteditable>test</multicol>") (= z "est</figcaption>") (= z "lert(1)></fieldset>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "ea>" """") "r""") (not (str.contains x "tyle-i"))))
(assert (= (str.len y) 113))
(assert (or (= (str.indexof z "i" 0) 6) (not (str.in_re y ((_ re.from_regex ecma2020) "^(01[2689]|09)[0-9]{8}$")))))
(assert (or (= (str.indexof z "/figc" 0) 4) (str.prefixof "ol" z) (= "<image id=x tabindex=1 onfocusin=al<b>t(1)></image>est</figcaption>" (str.replace y "er" "<b>"))))
(assert (= (str.indexof x ">li" 0) 6))
(assert (or (str.suffixof "n>" z) (= (str.at z 14) ">")))
(check-sat)
