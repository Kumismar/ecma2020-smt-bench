; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onbeforecopy=""alert(1)"" contenteditable>test</rtc>") (= x "<style>:target {transform: rotate(180deg);}</style><map id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></map>") (= x "&#X00003c")))
(assert (or (= z """>test</label>") (= z "ndblclick=""alert(1)"">test</rt>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 81) "/")) (= (str.at z 28) "t")))
(assert (not (= (str.len x) 124)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[\w\s-]*$")) (not (str.prefixof "&#X" y)) (not (= (str.at x 116) ")"))))
(assert (or (not (= (str.indexof x "copy" 0) 13)) (not (str.suffixof "st</label>" z))))
(assert (or (not (<= (str.len z) 15)) (str.suffixof "t>" z)))
(assert (not (str.contains (str.replace y "o" """") "sf""rm: r")))
(assert (or (not (str.contains y "(1)"">t")) (str.contains (str.replace x "t(1" "<b>") "r<b>)"" ")))
(check-sat)
