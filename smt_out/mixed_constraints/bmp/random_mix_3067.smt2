; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend onmouseenter=""alert(1)"">test</legen\u{20000}d>") (= x "<hgroup oncut=""alert(1)"" contenteditable>test</hgroup>")))
(assert (or (= z "eldset>") (= z "t {color: red;}</style><bgsound id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></bgsound>") (= z "tabindex=1 onbeforedeactivate=alert(1)></hr><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y " i")) (= (str.indexof z "u" 0) 28) (not (str.prefixof "<hgroup on" x))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z ,.'-]+$")) (not (= (str.at x 12) "u")) (not (= (str.indexof y "1)></" 0) 137))))
(assert (or (not (= (str.at y 15) "e")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{4,20}$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z][a-zA-Z0-9\-_\.]{2,15})$")))))
(assert (or (not (= (str.indexof y "=""" 0) 13)) (<= (str.len y) 57)))
(check-sat)
