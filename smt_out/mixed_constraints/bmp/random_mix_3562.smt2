; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><script>//&NewLine;confirm(1);</script </svg>") (= x "<optgroup onmouseenter=""alert(1)"">test</optgroup>") (= x "<blink id=x tabindex=1 ondeactivate=alert(1)></blink><input id=y autofocus>")))
(assert (or (= z "es x{}</style><data style=""animation-name:x"" onanimationstart=""alert(1)""></data>") (= z "onScroll>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "sty") (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]{6,20}$")))))
(assert (or (= "sedown=""alert(1)"">""/data>" (str.replace z "test<" """")) (= (str.indexof z "nScr" 0) 1) (str.contains z "onScroll>")))
(assert (or (str.suffixof "ocus>" x) (not (str.suffixof "roll>" y))))
(assert (or (= (str.at z 6) "l") (= (str.indexof z "data" 0) 15) (not (<= (str.len x) 56))))
(assert (or (not (= "<form onl" (str.substr x 5 9))) (str.contains (str.replace z "ll" "") "nScro>")))
(check-sat)
