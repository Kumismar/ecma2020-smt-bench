; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s oncut=""alert(1)"" contenteditable>test</s>") (= x "<noscript onmousemove=""alert(1)"">test</noscript>")))
(assert (or (= z "vascript:alert(1)'"">") (= z "//www.securitycompass.com/xss.js""></script>") (= z "le ondblclick=""alert(1)"">test</table>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "cript>" z) (str.prefixof "<s oncut=" x) (not (str.in_re z ((_ re.from_regex ecma2020) "[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}]{2,64}")))))
(assert (not (>= (str.len z) 16)))
(assert (or (str.prefixof "<" y) (not (str.suffixof "pt>" y))))
(assert (or (not (str.suffixof "st</s>" x)) (not (str.contains (str.replace x "nc" "") "<s out="))))
(assert (or (not (<= (str.len z) 44)) (not (= (str.indexof y "/" 0) 29))))
(check-sat)
