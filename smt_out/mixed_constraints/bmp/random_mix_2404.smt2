; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary onmousemove=""alert(1)"">test</summary>") (= x "<img src=foo.png onerror=alert(/xssed/) />") (= x "<video draggable=""true\u{1d400}"" ondrag=""alert(1)"">test</video>")))
(assert (or (= z "lert(1)"">test</iframe>") (= z "x></nav><input autofocus>") (= z "ionrun=alert(1)></meter>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<vide" y) (str.prefixof "<img src=" y) (str.contains (str.replace y "cus>" "alert(1)") "ofoalert(1)")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9-+\s()]{14}$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.]{4,20}$")))))
(assert (= (str.indexof y "rt" 0) 28))
(assert (or (= "beforec" (str.substr y 8 7)) (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.{5,32}$)(?![_.])(?!.*[_.]{2})[a-zA-Z0-9._]+$")))))
(assert (or (str.prefixof "<img src=f" y) (str.suffixof "autofocus>" y)))
(assert (not (= (str.indexof z "nru" 0) 2)))
(check-sat)
