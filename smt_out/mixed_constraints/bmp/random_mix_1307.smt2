; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<legend onpaste=""alert(1)"" contenteditable>test</legend>") (= x "<style>@keyframes x{}</style><optgroup style=""animation-name:x"" onanimationstart=""alert(1)""></optgroup>")))
(assert (or (= z "body>") (= z "label oncontextmenu=""alert(1)"">test</label>")))
(assert (= y (str.++ x z)))
(assert (or (not (= ">" (str.substr z 4 9))) (<= (str.len x) 71)))
(assert (str.suffixof "st</label>" y))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[\d-]+$"))))
(assert (or (= (str.len x) 56) (not (= "(1)""" (str.substr y 22 4))) (not (str.suffixof "l>" z))))
(assert (or (not (= (str.len y) 99)) (not (= (str.indexof x "conte" 0) 27)) (= (str.indexof y "e" 0) 2)))
(assert (or (not (str.contains (str.replace z "body" "alert(1)") "alert(1)>")) (not (= "<legend onpaste=""alert(1)"" contenteditable>tesalert(1)gend>label oncontextmenu=""alert(1)"">test</label>" (str.replace y "t</le" "alert(1)")))))
(assert (or (not (= (str.indexof y "gend>" 0) 51)) (not (str.contains z "conte"))))
(check-sat)
