; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption oncut=""alert(1)"" contenteditable>test</caption>") (= x "<h1 onmousemove=""alert(1)"">test</h1>")))
(assert (or (= z "template onbeforepaste=""alert(1)"" contenteditable>test</template>") (= z "rt(1)"">test</time>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "e>" y) (= (str.at z 16) "t")))
(assert (or (= "edi" (str.substr y 33 3)) (not (= (str.at y 32) "t")) (not (= (str.indexof z "1)"">t" 0) 3))))
(assert (or (not (str.contains (str.replace x "<" "<b>") "<b>di")) (not (str.contains y "alert(1)"" ")) (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{5,6}(?:[-\s]\d{4})?$")))))
(assert (or (not (= (str.at z 57) "e")) (not (str.contains (str.replace z "ase>" "x") "</bx")) (not (str.in_re x ((_ re.from_regex ecma2020) "^(([0-8][0-9])|(9[0-5])|(2[ab]))[0-9]{3}$$")))))
(assert (or (str.prefixof "<h1 onmou" y) (not (str.contains y "tab"))))
(assert (not (= (str.len x) 54)))
(check-sat)
