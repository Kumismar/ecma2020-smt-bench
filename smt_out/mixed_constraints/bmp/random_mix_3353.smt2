; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onkeypress=""alert(1)"" contenteditable>test</input>") (= x "<header onmouseenter=""alert(1)"">test</header>")))
(assert (or (= z "est</p>") (= z "mo\u{1f600}useup=""alert(1)"">test</style>") (= z "ert(1)"">test</noembed>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 30) """"))
(assert (or (not (= "tenteditab" (str.substr y 32 10))) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9&!#.\\'\- ]*$")) (not (str.contains y "mouseen"))))
(assert (or (= (str.indexof y "ndblc" 0) 8) (not (str.in_re x ((_ re.from_regex ecma2020) "^[\w\-]+$")))))
(assert (or (not (= ">test<" (str.substr y 31 6))) (not (str.prefixof "<i" y))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}@.0-9]+"))) (not (= (str.at z 5) "p"))))
(assert (not (= "t('X" (str.substr z 7 4))))
(check-sat)
