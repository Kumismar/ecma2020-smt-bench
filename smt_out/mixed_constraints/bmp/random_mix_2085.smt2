; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<slot draggable=""true"" ondragenter=""alert(1)"">test</slot>") (= x "<fieldset oncut=""alert(1)"" contenteditable>test</fieldset>")))
(assert (or (= z "quee oncut=""alert(1)"" contenteditable>test</marquee>") (= z "xpress\u{1f600}ion(javascript:alert(1)"">DEF") (= z "est</video>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace y "<da" "<b>") "<b>ta d")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "\d{12}$")) (not (= (str.len x) 57)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[+][0-9]{11}$")))))
(assert (or (not (= "EF" (str.substr z 33 5))) (str.prefixof "<slot dra" y)))
(assert (or (str.suffixof "t</slot>" x) (not (= (str.indexof z "video" 0) 5))))
(check-sat)
