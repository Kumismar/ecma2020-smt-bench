; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;LAYER SRC="";http://ha.ckers.org/scriptlet.html"";>;<;/LAYER>;") (= x "<rb onkeyup=""alert(1)"" contenteditable>test</rb>")))
(assert (or (= z "id=x></button><input autofocus>") (= z "alert(1)"">test</template>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len z) 3)) (not (<= (str.len y) 86))))
(assert (or (not (= (str.at z 9) "t")) (not (<= (str.len x) 66))))
(assert (str.contains z "lert(1)"""))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-z0-9]+([\-\.]{1}[a-z0-9]+)*\.[a-z]{2,}$"))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[\u{430}-\u{44f}\u{410}-\u{42f}a-zA-Z0-9_-]{3,255}")))
(assert (str.contains z """>test</t"))
(check-sat)
