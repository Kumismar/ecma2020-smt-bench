; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><p style=""animation-name:x"" onanimationend=""alert(1)""></p>") (= x "<wbr onmouseleave=""alert(1)"">test</wbr>")))
(assert (or (= z "ndrop=alert(1) contenteditable>drop here</fieldset>") (= z "/style><bgsound style=""animation-name:x"" onanimationstart=""alert(1)""></bgsound>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "und>" z) (not (str.prefixof "<wbr " y))))
(assert (or (<= (str.len y) 99) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{10}")))))
(assert (or (= (str.at y 19) "a") (not (str.in_re y ((_ re.from_regex ecma2020) "^((8|\+375)[\- ]?)?(\(?\d{2}\)?[\- ]?)?[\d\- ]{7,10}$"))) (not (str.contains x "=""al"))))
(assert (not (= (str.at y 4) " ")))
(assert (= (str.indexof x "HN" 0) 37))
(assert (not (str.contains x "e><p st")))
(check-sat)
