; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><big id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></big>") (= x "<wbr onbeforecut=""alert(1)"" contenteditable>test</wbr>") (= x "<spacer onkeyup=""alert(1)"" contenteditable>test</spacer>")))
(assert (or (= z "rt(1)></h1>") (= z "/details>") (= z "draggable=""true"" contenteditable>drag me</div><th ondrop=alert(1) contenteditable>drop here</th>")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[-._a-z0-9]+@(?:[a-z0-9][-a-z0-9]+\.)+[a-z]{2,6}$")))
(assert (not (str.contains x "ntentedi")))
(assert (= "<spacer onkeyup=""alert(1)"" contenteditaxtest</spacer>draggable=""true"" contenteditable>drag me</div><th ondrop=alert(1) contenteditable>drop here</th>" (str.replace y "ble>" "x")))
(assert (or (str.suffixof "(1)></h1>" z) (not (str.in_re x ((_ re.from_regex ecma2020) "^[^(<|>)]+$")))))
(assert (or (not (= "=""alert" (str.substr z 3 7))) (not (= (str.indexof z "</h1>" 0) 6))))
(assert (or (not (str.contains x """ con")) (str.contains y """transitio")))
(assert (not (str.prefixof "<style" x)))
(assert (or (= "(1)></big" (str.substr y 99 9)) (not (= (str.indexof y "e"" co" 0) 123))))
(assert (not (= (str.at z 4) "a")))
(check-sat)
