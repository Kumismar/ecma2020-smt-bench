; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed onbeforecut=""alert(1)"" contenteditable>test</embed>") (= x "<svg><code onload=alert(1)></code>")))
(assert (or (= z "alert(1)></summary>") (= z "ex=1 onfocus=alert(1)></template>") (= z "e=a:expression(alert())>;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "=aler")) (= "<svg><code onload=alert(1/code>" (str.replace x ")><" ""))))
(assert (not (str.prefixof "&l" y)))
(assert (not (<= (str.len x) 62)))
(assert (not (str.suffixof "</embed>" x)))
(assert (not (= (str.indexof x "1)>" 0) 24)))
(assert (or (not (= "cus=" (str.substr z 9 4))) (str.in_re z ((_ re.from_regex ecma2020) "\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}\b"))))
(check-sat)
