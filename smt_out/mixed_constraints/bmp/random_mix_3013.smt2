; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "`""'><img src=xxx:x \x2Fonerror=javascript:alert(1)>") (= x "<frameset onmouseenter=""alert(1)"">test</frameset>") (= x "<span id=x tabindex=1 onactivate=alert(1)></span>")))
(assert (or (= z "cut=""alert(1)"" contenteditable>test</keygen>") (= z "tyle><thead id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></thead>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace x "alert" """") ":""(1)>"))
(assert (or (not (>= (str.len z) 38)) (= (str.len y) 131)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\+?[\d\/\s\-]{8,20}$"))) (= (str.indexof y "tyl" 0) 49) (not (= (str.at z 54) "n"))))
(assert (or (str.contains (str.replace z "le>" "javascript:") "abjavascript:tes") (not (str.prefixof "46;xml\"" I" z))))
(assert (str.contains y "set>"))
(assert (not (str.suffixof "thead>" y)))
(assert (or (not (str.contains (str.replace z "tedit" "javascript:") "njavascript:a")) (= (str.indexof z "cut" 0) 0)))
(assert (or (str.prefixof "<sup on" x) (not (= "d=x tabin" (str.substr x 7 9)))))
(check-sat)
