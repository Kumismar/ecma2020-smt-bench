; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table oncut=""alert(1)"" contenteditable>test</table>") (= x "&lt;A HREF=&quot;http://www.gohttp://www.google.com/ogle.com/&quot;&gt;XSS&lt;/A&gt;")))
(assert (or (= z "ke>") (= z "rag me</div><script ondragover=alert(1) contenteditable>drop here</script>") (= z "test</figcaption>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x "ht" "javascript:") "t;javascript:tp:/") (not (= (str.indexof x "<th" 0) 0))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9a-zA-Z]*$"))))
(assert (or (not (>= (str.len z) 1)) (not (str.prefixof "<table " y)) (not (= (str.indexof y "itabl" 0) 33))))
(assert (str.prefixof "k" z))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9' \u{e0}\u{e2}\u{e9}\u{e8}\u{ea}\u{f4}\u{f9}\u{fb}\u{e7}\u{c0}\u{c2}\u{c9}\u{c8}\u{d4}\u{d9}\u{db}\u{c7} -]+$"))) (not (= (str.len y) 141))))
(assert (str.suffixof "table>" x))
(assert (= (str.indexof z "uote" 0) 7))
(assert (or (= (str.at x 28) "g") (str.suffixof "n>" y)))
(assert (or (not (= (str.at x 0) "<")) (str.in_re x ((_ re.from_regex ecma2020) "^.{8,}$"))))
(check-sat)
