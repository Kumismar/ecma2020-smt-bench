; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onseeked=""alert(String.fromCharCode(88,83,83))"">") (= x "<summary onbeforecopy=""alert(1)"" contenteditable>test</summary>") (= x "<style>:target {color:red;}</style><link id=x style=""transition:color 1s"" ontransitionend=alert(1)></link>")))
(assert (or (= z "base>") (= z "ror = prompt('&#49;')") (= z "ble>test</base>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "))")) (not (str.in_re z ((_ re.from_regex ecma2020) "^(\+33[0-9]{1}[0-9]{8})$|^(^0[0-9]{9})$")))))
(assert (or (str.suffixof ">" y) (= (str.indexof z "base>" 0) 0) (not (str.in_re z ((_ re.from_regex ecma2020) ".{9}|.{9,}")))))
(assert (str.contains z "base>"))
(assert (or (not (= (str.indexof x "tml" 0) 53)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z]{3}([1-9]\d{0,3})?")))))
(check-sat)
