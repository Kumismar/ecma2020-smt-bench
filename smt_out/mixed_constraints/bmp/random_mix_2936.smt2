; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ScRipT 5-0*3+9\u{10348}/3=>prompt(1)</ScRipT giveanswerhere=?") (= x "<style></style\x20<img src=""about:blank"" onerror=javascript:alert(1)//></style>")))
(assert (or (= z ">") (= z "test</br>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof ">" z))
(assert (or (not (= (str.indexof z "t</" 0) 3)) (not (str.suffixof "br>" y))))
(assert (or (not (= (str.indexof x "veans" 0) 40)) (not (str.in_re z ((_ re.from_regex ecma2020) "(98|\+98|0098|0)?9[0-9]{9}"))) (not (str.prefixof "<ma" x))))
(assert (or (= (str.at y 46) "o") (str.in_re y ((_ re.from_regex ecma2020) "[_a-z0-9-]+(\.[_a-z0-9-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,4})$")) (not (= "VaScRiP" (str.substr y 12 7)))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([ \u{5c}u00c0-\u{5c}u01ffa-zA-Z'\-])+$"))))
(check-sat)
