; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><multicol id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></multicol>") (= x "<em onmousedown=""alert(1)"">test</em>") (= x "<style>:target {color:red;}</style><noscript id=x style=""transition:color 1s"" ontransitionend=alert(1)></noscript>")))
(assert (or (= z "er onload=alert(1)></spacer>") (= z "ve=""alert(1)"">test</video>") (= z "nteditable>drop here</main>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len x) 43)) (str.contains z "sp") (= "<style>:target {color:red;}</style><noscript id=x style=""tranxion:color 1s"" ontransitionend=alert(1)></noscript>" (str.replace x "sit" "x"))))
(assert (or (= "ve=""alert(1)"">""/video>" (str.replace z "test<" """")) (str.contains (str.replace z "ideo>" """") "v""") (not (str.in_re y ((_ re.from_regex ecma2020) "\d{8,12}")))))
(assert (or (not (= (str.at y 40) """")) (str.suffixof "samp>" x) (>= (str.len x) 118)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^(((http|https)://)?(www.)?(youtube\.com\/(channel)/(.+)|youtube\.com\/(user)/(.+)))$")))
(assert (or (not (= (str.indexof y "</em" 0) 31)) (not (= "1)""" (str.substr y 85 3))) (not (= (str.at z 8) "d"))))
(assert (or (not (str.contains x "transition")) (= "</sp" (str.substr z 19 4))))
(check-sat)
