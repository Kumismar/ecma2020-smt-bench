; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#x003c") (= x "<style>:target {color: red;}</style><code id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></code>") (= x "<label onmousemove=""alert(1)"">test</label>")))
(assert (or (= z "=""alert(1)"" contenteditable>test</head>") (= z "ble>test</kbd>") (= z "tenteditable>test</ul>")))
(assert (= y (str.++ x z)))
(assert (= "tenteditableest</ul>" (str.replace z ">t" "")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[\u{3041}-\u{3093}\s\u{3000}]+"))) (= "#x003c" (str.substr x 1 6))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.\s]{1,80}$")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\w\-_&.,'`#@!\s]+$")))))
(assert (or (not (= "ble>test</" (str.substr z 9 10))) (not (str.prefixof "<;S" y)) (not (= "=""alert(1)"" contenteditable>xt</head>" (str.replace z "tes" "x")))))
(check-sat)
