; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image ondblclick=""alert(1)"">test</image>") (= x "<tbody id=x tabindex=1 onactivate=alert(1)></tbody>") (= x "<s onbeforepaste=""ale\u{10348}rt(1)"" contenteditable>test</s>")))
(assert (or (= z "m onmouseup=""alert(1)"">test</acronym>") (= z "ggable=""true"" ondragleave=""alert(1)"">test</footer>") (= z "\""xsstest&#46;xml\"" ID=I&gt;&lt;/XML&gt;")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<tbody i" x))
(assert (or (str.suffixof "e>" x) (not (str.suffixof "/XML&gt;" y))))
(assert (or (= (str.at x 1) "l") (= "<main onbeforecopy=""alert(1)"" contenteditable>t""</main>" (str.replace x "est" """")) (not (str.in_re x ((_ re.from_regex ecma2020) "(^[A-Z]{6}[0-9]{2}[A-Z][0-9]{2}[A-Z][0-9]{3}[A-Z])|(^.{4,11})")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9\+-]+$"))) (not (str.suffixof "test</s>" x))))
(check-sat)
