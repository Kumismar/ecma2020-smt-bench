; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xmp onmousemove=""al\u{1f600}ert(1)"">test</xmp>") (= x "<img STYLE=""xss:expr/*XSS*/ession(document.vulnerable=true)"">") (= x "<style>:target {color:red;}</style><track id=x style=""transition:color 1s"" ontransitionend=alert(1)></track>")))
(assert (or (= z "=""true"" ondragstart=""alert(1)"">test</param>") (= z "e\u{1d400} onmou\u{10348}seenter=""alert(1)"">test</style>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^([0-9]{4})-([0-9]{4})-([0-9]{4})$")) (not (= (str.at z 39) ">"))))
(assert (or (= "e"" ond" (str.substr y 66 6)) (not (= (str.indexof x "=""t" 0) 14))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z'.\s]{1,90}$"))))
(assert (or (not (>= (str.len z) 34)) (not (= (str.at x 99) ">"))))
(assert (not (str.prefixof "=""true""" z)))
(check-sat)
