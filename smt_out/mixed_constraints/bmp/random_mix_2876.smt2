; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike onbeforepaste=""alert(1)"" contenteditable>test</strike>") (= x "<nav oncontextmenu=""alert(1)"">\u{1d400}test\u{1f4a9}</nav>") (= x "<svg><ins onload=alert(1)></ins>")))
(assert (or (= z "content id=x tabindex=1 onbeforeactivate=alert(1)></content>") (= z "link>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<nav oncontextmenu=""alert(1)"">\u{1d400}te""</nav>" (str.replace x "st\u{1f4a9}" """"))) (not (= "s" (str.substr x 1 1)))))
(assert (not (str.contains (str.replace z "d=x " "javascript:") " ijavascript:tabin")))
(assert (str.contains x "v onconte"))
(assert (not (>= (str.len x) 35)))
(assert (not (= (str.indexof y "st\u{1f4a9}<" 0) 33)))
(assert (= (str.indexof x "(1)>" 0) 22))
(assert (not (str.contains (str.replace x "</na" "") "test\u{1f4a9}v>")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) ".{9,}")) (not (str.in_re y ((_ re.from_regex ecma2020) ".*[^\s+]{1,}.*")))))
(assert (or (not (= (str.indexof y "e=" 0) 81)) (str.in_re y ((_ re.from_regex ecma2020) "^[^_./<>]{1,}$")) (not (str.suffixof "nk>" z))))
(assert (or (not (str.prefixof "l" z)) (not (str.suffixof ">" z))))
(check-sat)
