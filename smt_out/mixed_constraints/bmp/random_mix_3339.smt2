; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound onmousemove=""alert(1)"">test</bgsound>") (= x "<video autoplay onplaying=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>")))
(assert (or (= z "animationend=""alert(1)""></center>") (= z "sindex>") (= z "nmouseout=""alert(1)"">test</title>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "sound>" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-Za-z0-9_\-.+])+@([A-Za-z0-9_\-.])+\.([A-Za-z]{2,})$")))))
(assert (or (not (str.contains y "nd=""a")) (not (str.prefixof "<" x)) (str.in_re x ((_ re.from_regex ecma2020) "^[^iIoOqQ'-]{10,17}$"))))
(assert (= (str.indexof x "ert(1" 0) 24))
(assert (not (= (str.indexof x "und o" 0) 5)))
(assert (or (= (str.at x 3) "d") (not (= "useup" (str.substr y 11 5))) (not (= (str.at y 70) "<"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^.{6,18}$"))))
(check-sat)
