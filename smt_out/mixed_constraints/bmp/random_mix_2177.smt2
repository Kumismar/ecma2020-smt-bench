; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc id=x tabindex=1 onactivate=alert(1)></rtc>") (= x "<form id=x tabindex=1\u{1f600} onbeforedeactivate=alert(1)></form><input autofocus>") (= x "<article id=x tabindex=1 onbeforeactivate=alert(1)></article>")))
(assert (or (= z ".0\u{2193}") (= z "rt(1)"">test</iframe>") (= z "amp><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "fo" 0) 15)) (= " auto" (str.substr z 10 5))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$")))
(assert (str.prefixof "'""`><scri" y))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^.{8,255}$"))) (not (= "ler" (str.substr x 37 3))) (not (= "o" (str.substr y 16 1)))))
(assert (str.contains (str.replace z "=ale" " ") "vate rt(1"))
(assert (or (not (str.suffixof ".0\u{2193}" z)) (str.suffixof "ofocus>" x)))
(check-sat)
