; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del onmouseup=""alert(1)"">test</del>") (= x "&lt;IMG SRC=\""jav&#x09;ascript&#058;alert('XSS');\""&gt;") (= x "<style>:target {color: red;}</style><listing id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></listing>")))
(assert (or (= z "tt><input id=y autofocus>") (= z ")""></video>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+.[A-Za-z]{2,4}$"))))
(assert (or (not (<= (str.len y) 132)) (not (str.contains y "58;ale")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[^@]+@(?!(yahoo|hotmail|gmail|googlemail|mail|email|cuoly))[^@]+\.[a-z]{2,}$")))))
(assert (or (str.prefixof "&" y) (not (str.suffixof "</video>" z)) (not (str.prefixof ")""></vid" z))))
(assert (or (not (= (str.at x 6) "C")) (not (= (str.at z 3) "<")) (not (= (str.indexof y "al" 0) 36))))
(assert (or (not (str.suffixof "video>" y)) (not (= (str.at z 9) "o"))))
(check-sat)
