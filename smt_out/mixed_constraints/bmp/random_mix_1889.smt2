; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "eval(URL.slice(-8))>#alert(1)") (= x "<samp draggable=""true"" ondrag=""alert(1)"">test</samp>") (= x "<area onbeforecut=""alert(1)"" contenteditable>test</area>")))
(assert (or (= z "ed;}</style><base id=x style=""transition:color 1s"" ontransitionend=alert(1)></base>") (= z "autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len x) 29) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9a-zA-Z!\u{c2}\u{a7}:;,._`&@$&%?+=*<>~|^{}""()[\]\/\-]{6,16}$")))))
(assert (not (str.suffixof "ocus>" z)))
(assert (or (not (str.contains z "ditable>t")) (not (= (str.at z 11) ">"))))
(assert (not (>= (str.len z) 1)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^0\d{9,10}$"))) (not (str.contains (str.replace x "<a" """") """re"))))
(assert (or (str.suffixof "alert(1)" x) (not (str.contains x "val(UR"))))
(assert (or (str.prefixof "ed;}</s" z) (str.contains y "io")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)+$"))) (= (str.len z) 10)))
(check-sat)
