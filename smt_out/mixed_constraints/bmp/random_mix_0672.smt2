; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<set attributeName=""xlink:href"" begin=""accessKey(b)"" to=""//example.com/?b"" />") (= x "\u{1f600}<blockquote onclick=""alert(1)"">t\u{1d400}est</blockquote>")))
(assert (or (= z ">") (= z "es>") (= z """>test</nobr>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "t</bl" 0) 36)))
(assert (or (not (= (str.indexof x "s" 0) 1)) (str.suffixof ">" z) (not (<= (str.len z) 7))))
(assert (or (str.prefixof "\u{1f600}<bl" x) (not (= "ckq" (str.substr x 42 3))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]+")))))
(assert (not (= "</nobr>" (str.substr z 6 10))))
(assert (= "e>dr" (str.substr y 100 4)))
(assert (str.prefixof "\u{1f600}<bl" y))
(assert (or (not (str.contains (str.replace y "uo" "") "lockqte o")) (not (= (str.indexof y ">es>" 0) 49))))
(assert (or (str.contains (str.replace z ">" """") """") (str.in_re y ((_ re.from_regex ecma2020) "[a-z\.]+@[a-z\.]+")) (str.prefixof ">" z)))
(check-sat)
