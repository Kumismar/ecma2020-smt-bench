; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\xE2\x80\x83javascript:javascript:alert(1)"" id=""fuzzelement1"">\u{10348}test</a>") (= x "<thead id=x tabindex=1 onbeforeactivate=alert(1)></the\u{1d400}ad>\u{1f4a9}") (= x "<multicol onmouseenter=""alert(1)"">test</multicol>")))
(assert (or (= z "1)></cite>") (= z "us>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "te" 0) 72)) (not (str.prefixof "<thead id" y)) (not (str.contains y "/multicol"))))
(assert (not (str.contains x "ex=1 onbe")))
(assert (or (str.prefixof "feed:al" z) (not (str.suffixof "a>us>" y))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9A-Za-z@_-]"))) (= (str.at y 49) "<") (= (str.indexof z ">" 0) 2)))
(assert (or (not (str.suffixof "rames>" y)) (not (str.suffixof "te>" z))))
(check-sat)
