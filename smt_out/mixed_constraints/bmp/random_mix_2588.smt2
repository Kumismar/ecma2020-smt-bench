; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen id=x \u{1f600}tabindex=1 onbeforeactivate=alert(1)></keygen>") (= x "<hgroup draggable=""true"" ondragenter=""alert(1)"">test</hgroup>")))
(assert (or (= z "l\u{1d400}ick=""alert(1)"">test</rtc>\u{1f4a9}") (= z "></b><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "nbefore" (str.substr y 26 7))) (str.contains x "=""alert") (= (str.indexof z ">" 0) 0)))
(assert (or (not (str.contains z "beforeac")) (str.contains x "t(1)") (not (>= (str.len z) 28))))
(assert (not (= "s>" (str.substr z 20 6))))
(assert (or (= (str.at x 46) """") (not (= (str.indexof z "test<" 0) 17)) (not (str.in_re y ((_ re.from_regex ecma2020) "^\S{6,14}$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{7,8}-[0-9Kk]{1}$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9 ]{6}$"))) (= (str.indexof y "ue""" 0) 21)))
(assert (not (= (str.at z 22) "S")))
(check-sat)
