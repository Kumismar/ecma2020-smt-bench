; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdi onmouseup=""alert(1)"">test</bdi>") (= x "<sup onmouseup=""alert(1)"">test</sup>") (= x "<acronym onmouseleave=""alert(1)"">test</acronym>")))
(assert (or (= z "aggable=""true"" ondragleave=""alert(1)"">test</xmp>") (= z "textarea onchange=alert(1)>XSS</textarea>") (= z "e>drag me</div><tr ondragover=alert(1) contenteditable>drop here</tr>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "t(1)" 0) 32) (not (str.prefixof "<b" x))))
(assert (str.suffixof "area>" z))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "((^|$)(0[0-9]{5,9}|3[0-9]{8,9}))$"))))
(assert (or (not (str.contains (str.replace y "p " "") "<suonmou")) (= "><inpu" (str.substr z 27 6))))
(assert (not (str.suffixof "/bdi>" x)))
(assert (not (= "re<" (str.substr y 109 3))))
(assert (or (not (<= (str.len x) 38)) (not (str.prefixof "<sup" x)) (= (str.at z 11) "u")))
(assert (= (str.at y 70) "1"))
(check-sat)
