; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup onmouseover=""alert(1)"">test</colgroup>") (= x "<label onmousemove=""alert(1)"">test</label>") (= x "<main id=x tabindex=1 onfocusin=alert(1)></main>")))
(assert (or (= z """>test</ins>") (= z "e(88,83,83))</script>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len x) 45)))
(assert (= (str.at x 67) "["))
(assert (not (str.contains x "ocu")))
(assert (not (= "nmousemove" (str.substr y 8 10))))
(assert (or (not (str.contains z "es")) (not (str.in_re x ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,10}$")))))
(assert (= (str.indexof z "cript" 0) 19))
(assert (or (not (str.contains (str.replace x "tabi" " ") "d=x  ndex")) (str.suffixof "ain>" x)))
(check-sat)
