; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nobr onmouseout=""alert(1)"">test</nobr>") (= x "<hgroup oncopy=""alert(1)"" contenteditable>test</hgroup>")))
(assert (or (= z "/q>") (= z "re>") (= z "ascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "tedi" 0) 32) (not (str.contains y "ous"))))
(assert (not (str.contains (str.replace x " " "alert(1)") "ralert(1)onm")))
(assert (or (not (= (str.indexof x "up on" 0) 5)) (not (= "<nobr onmouseo alert(1)"">test</nobr>" (str.replace x "ut=""" " "))) (str.in_re x ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+.[a-z]+$"))))
(assert (not (= "ascralert(1)t:alert(1)"">" (str.replace z "ip" "alert(1)"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[1-9][0-9]{3} ?(?!sa|sd|ss)[a-zA-Z]{2}$"))) (= (str.at x 44) "s") (str.prefixof "/q" z)))
(assert (or (= (str.at y 8) "m") (not (str.prefixof "<h" y))))
(assert (not (str.suffixof "(1)"">" z)))
(check-sat)
