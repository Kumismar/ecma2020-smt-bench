; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<st\u{1f600}yle>:target {color: red;}</style><objec\u{1f4a9}t id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></object>") (= x "<code onmouseover=""alert(1)"">test</code>") (= x "<b id=x tabindex=1 onfocus=alert(1)></b>")))
(assert (or (= z ":alert(1)</script>") (= z "onmouseout=""alert(1)"">test</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "est<" "<b>") "1)"">t<b>/")) (= (str.at y 41) "r")))
(assert (or (str.prefixof "<" y) (str.prefixof ">" z)))
(assert (or (str.contains y "ion:co") (= (str.at x 27) "a")))
(assert (or (str.prefixof "transfo" z) (= "<time onmouseleave=""alert(1)"">test</time>strike><input ialert(1) autofocus>" (str.replace y "d=y" "alert(1)"))))
(assert (or (= "ipt" (str.substr z 14 3)) (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z\u{c5}\u{c4}\u{d6}\u{e5}\u{e4}\u{f6} \-]{2,25}$"))))
(assert (or (not (= (str.at x 11) "s")) (str.in_re z ((_ re.from_regex ecma2020) "^[\u{3041}-\u{309e}\u{30fc}]+$"))))
(check-sat)
