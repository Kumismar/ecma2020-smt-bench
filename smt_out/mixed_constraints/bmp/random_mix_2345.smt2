; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onkeydown body onkeydown=""javascript:javascript:alert(1)""></body onkeydown>") (= x "<embed onbeforecopy=""alert(1)"" contenteditable>test</embed>") (= x "<col draggable=""true"" ondragenter=""aler\u{1f4a9}t(1)"">test</col>")))
(assert (or (= z "dex=1 id=x></rt><input autofocus>") (= z "(1)"" contenteditable>test</cite>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(([^<>()[\]\\.,;:\s@""]+(\.[^<>()[\]\\.,;:\s@""]+)*)|("".+""))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$"))))
(assert (or (not (str.prefixof "de" z)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-z.A-Z0-9]+$"))) (not (= "nsitio" (str.substr y 85 6)))))
(assert (or (str.suffixof "cite>" z) (str.prefixof "<XSS" x)))
(assert (or (not (= "table>tes" (str.substr z 15 9))) (str.contains z "cite>")))
(assert (or (str.suffixof "e>" y) (str.suffixof "ite>" y) (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z_-]{3,}$")))))
(check-sat)
