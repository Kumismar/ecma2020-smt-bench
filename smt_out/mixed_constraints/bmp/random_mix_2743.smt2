; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed width=500 height=500 code=""data:text/html,<script>%(payload)s</script>""></embed>") (= x "<ol onmouseout=""alert(1)"">test</ol>") (= x "<style>@keyframes x{}</style><marquee style=""animation-name:x"" onanimationend=""alert(1)""></marquee>")))
(assert (or (= z "x onmouseenter=""alert(1)"">test</isindex>") (= z "ta oncut=""alert(1)"" contenteditable>test</data>") (= z " onkeyup=""alert(1)"" contenteditable>test</body>")))
(assert (= y (str.++ x z)))
(assert (str.contains x "ma"))
(assert (or (not (str.prefixof "<embed" y)) (not (str.prefixof "<embed " y))))
(assert (or (str.contains x "e=""\u{10348}a") (not (= (str.len x) 87)) (>= (str.len z) 37)))
(assert (or (not (str.suffixof ">" z)) (not (str.contains (str.replace x "ou" "javascript:") "l onmjavascript:seo")) (not (str.contains (str.replace z "nt" """") ")"" co""e"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[\u{430}-\u{44f}\u{451}\u{410}-\u{42f}\u{401}0-9a-zA-z .?:,]{1,256}")) (not (str.prefixof "<div" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%-+]+@[a-z0-9.-]+\.[a-z]{2,4}$")))))
(assert (str.contains y "itable"))
(check-sat)
