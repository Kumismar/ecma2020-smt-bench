; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex id=x tabindex=1 onbeforedeactivate=alert(1)></isindex><input autofocus>") (= x "<a href=""javas\x0Acript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<object onerror=javascript:javascript:alert(1)>")))
(assert (or (= z "ckquote>") (= z "hgroup draggable=""true"" ondragenter=""alert(1)"">test</hgroup>") (= z "rt(1)""></listing>")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^\w{11,}$")))
(assert (or (= "<javascript:ndex id=x tabindex=1 onbeforedeactivate=alert(1)></isindex><input autofocus>" (str.replace x "isi" "javascript:")) (not (str.suffixof "ckquote>" y))))
(assert (or (not (str.contains y "ansfo")) (not (str.contains z "li"))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^([A-Za-z0-9_\-\.])+\@([A-Za-z0-9_\-\.])+\.([A-Za-z]{2,4})$")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^([\w\d.\-+_\u{2018}]+)@((?:[-a-zA-Z0-9]+\.)+[a-zA-Z]{2,})$")) (<= (str.len x) 86)))
(assert (not (= (str.indexof z """ on" 0) 22)))
(check-sat)
