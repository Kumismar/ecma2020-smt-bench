; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time onmouseenter=""alert(1)"">test</time>") (= x "<kbd draggable=""true"" ondrag=""alert(1)"">test</kbd>")))
(assert (or (= z "nend=""alert(1)""></spacer>") (= z ",PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg=="">") (= z "ggable=""true"" ondragend=""alert(1)"">test</dd>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "cer>" z)))
(assert (or (not (str.suffixof "st</time>" x)) (= "KTwvc2NyaX" (str.substr z 21 10))))
(assert (not (= "table" (str.substr y 59 5))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[1-9]")))
(assert (or (not (str.contains x "r=""ale")) (not (str.in_re x ((_ re.from_regex ecma2020) "^((\d{3}[- ]\d{3}[- ]\d{2}[- ]\d{2})|(\d{3}[- ]\d{2}[- ]\d{2}[- ]\d{3})|(\d{10}))$"))) (not (str.contains (str.replace y "<tim" "<b>") "<b>e "))))
(assert (or (str.contains x "r=""al") (>= (str.len z) 33) (not (= (str.indexof z "bGVy" 0) 13))))
(assert (or (= (str.at y 42) "c") (not (str.suffixof "/spacer>" y))))
(check-sat)
