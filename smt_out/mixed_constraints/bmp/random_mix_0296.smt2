; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time onkeyup=""alert(1)"" contenteditable>test</time>") (= x "<div draggable=""true"" contenteditable>drag me</div><wbr ondrop=alert(1) contenteditable>drop here</wbr>") (= x "<style>@keyframes x{}</style><object style=""animation-name:x"" onanimationstart=""alert(1)""></object>")))
(assert (or (= z "ert(1)"" contenteditable>test</em>") (= z """jav&#x0D;ascript:alert('XSS');"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "('XSS');"">" z)) (= (str.at z 12) "c") (not (= (str.at y 23) """"))))
(assert (not (= (str.at z 29) ")")))
(assert (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9]{5,10}")))
(assert (= (str.indexof x "<tim" 0) 0))
(assert (not (str.prefixof """alert" z)))
(assert (or (str.prefixof "<" y) (not (= (str.indexof z "t" 0) 16))))
(check-sat)
