; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base onbeforepaste=""alert(1)"" contenteditable>test</base>") (= x "<blockquote onm\u{1f4a9}ouseup=""alert(\u{20000}1)"">test</blockquote>")))
(assert (or (= z "est</var>") (= z "tenteditable>test</plaintext>") (= z "lticol onmouseout=""alert(1)"">test</multicol>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "st" 0) 1)))
(assert (not (= (str.at x 6) "q")))
(assert (str.contains x "paste"))
(assert (or (not (str.contains (str.replace z "t" " ") " en")) (not (str.suffixof "multicol>" y))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9-+\s()]*$"))))
(assert (str.contains z "1 onfocu"))
(assert (or (= (str.at z 0) "e") (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9_]{1,64}$")) (= (str.indexof x "am" 0) 13)))
(assert (or (str.prefixof "<blo" y) (str.contains (str.replace z "tof" "alert(1)") "aualert(1)ocus")))
(assert (or (not (= "<base onbeforepaste=""alert(1)"" contenteditable>talert(1)</base>tenteditable>test</plaintext>" (str.replace y "est" "alert(1)"))) (not (= (str.indexof y "oc" 0) 3)) (not (str.contains z "mou"))))
(check-sat)
