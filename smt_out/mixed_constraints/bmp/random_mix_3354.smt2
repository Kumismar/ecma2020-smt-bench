; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption onmousedown=""alert(1)"">test</caption>") (= x "<ruby onmouseleave=""alert(1)"">test</ruby>") (= x "<dir id=x tabindex=1 onactivate=alert(1)></dir>")))
(assert (or (= z "pos;XSS&apos;);//") (= z "te=""alert(1)"" contenteditable>test</a>") (= z "1)"" contenteditable>test</wbr>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len x) 54) (not (= "c" (str.substr y 1 1))) (not (str.contains x " onmous"))))
(assert (str.contains (str.replace x "ans" "<b>") """tr<b>itio"))
(assert (or (not (str.suffixof ";);//" y)) (str.contains z "test</wbr")))
(assert (or (str.suffixof "ot;&gt;" y) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[\s\S]{6,16}$")))))
(assert (not (= "=" (str.substr y 31 1))))
(assert (or (= "/" (str.substr x 31 1)) (= (str.at y 27) ">") (not (str.contains x "down="))))
(assert (not (= (str.indexof z "t" 0) 0)))
(assert (or (not (= (str.at y 28) "a")) (not (= (str.len x) 46))))
(check-sat)
