; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<label onclick=""alert(1)"">test</label>") (= x "<param draggable=""true"" ondrag=""alert(1)"">test</param>")))
(assert (or (= z "deo onmouseleave=""alert(1)"">test</video>") (= z "tabindex=1 id=x></tfoot><input autofocus>") (= z "n onkeydown=""alert(1)"" contenteditable>test</main>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "n onkeydow" z)) (not (str.suffixof "autofocus>" y))))
(assert (str.suffixof ">" x))
(assert (not (= (str.len z) 40)))
(assert (or (= (str.at y 50) "l") (not (= (str.indexof x " on" 0) 23))))
(assert (or (not (= (str.at y 22) "1")) (>= (str.len y) 99) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-z][a-zA-Z ]*$|^[\u{5c}u0600-\u{5c}u06FF][\u{5c}u0600-\u{5c}u06FF ]*$")))))
(assert (not (str.prefixof "<label " y)))
(check-sat)
