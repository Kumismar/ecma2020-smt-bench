; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<audio onmousedown=""alert(1)"">test</audio>") (= x "<h1 id=x tabindex=1 onbeforedeactivate=alert(1)></h1><inp\u{1d400}ut \u{1f600}autofocus>") (= x "<\u{10348}style>@keyframes x{}</style><map style=""animation-name:x"" onanimation\u{10348}start=""alert(1)""></map>")))
(assert (or (= z ">") (= z "e id=x tabindex=1 onbeforeactivate=alert(1)></title>") (= z "enteditable>drop here</noembed>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y " onmouse")) (= "<h1 id=x tabindex=1 onbeforedeactivate=alert(1)><""<inp\u{1d400}ut \u{1f600}autofocus>" (str.replace x "/h1>" """"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[1-9][0-9]{3} ?(?!sa|SA|sd|SD|ss|SS)[a-zA-Z]{2}$"))) (not (= "<b>" (str.replace z ">" "<b>")))))
(assert (or (not (str.suffixof "le>" y)) (not (str.contains y "3.org/2"))))
(assert (not (<= (str.len z) 38)))
(assert (or (= (str.at z 40) "(") (not (str.contains y "style>@k"))))
(check-sat)
