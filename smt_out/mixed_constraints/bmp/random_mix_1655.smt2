; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe draggable=""true"" ondragenter=""alert(1)"">test</iframe>") (= x "<cite onfocusout=alert(1) tabindex=1 id=x></cite><input autofocus>")))
(assert (or (= z "autofocus>") (= z "ert(1)>click this!")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "s>" y))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{0,}"))))
(assert (or (not (str.contains (str.replace z "g" "") "4]&t;")) (= "!" (str.substr z 17 10)) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*(_|[^\w])).{8,50}$")))))
(assert (or (not (str.contains y "est</ifr")) (not (str.prefixof "<cite onfo" x)) (= (str.indexof x "index" 0) 29)))
(assert (str.suffixof "</dd>" x))
(assert (not (= (str.at y 26) "n")))
(check-sat)
