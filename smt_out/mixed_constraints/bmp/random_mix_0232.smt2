; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote draggable=""true"" ondragstart=""alert(1)"">test</blockquote>") (= x "<li onbeforecopy=""alert(1)"" contenteditable>test</li>") (= x "<style>@keyframes x{}</style><thead style=""animation-name:x"" onanimationend=""alert(1)""></thead>")))
(assert (or (= z "rt(1)"">test</element>") (= z ")>click")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "ad>" x)) (= (str.at y 58) """")))
(assert (= "nbefo" (str.substr x 5 5)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[^;<>=]{2,100}$"))))
(assert (or (not (= "ame:x"" o" (str.substr y 54 8))) (>= (str.len z) 1)))
(assert (not (= "ad>" (str.substr x 92 8))))
(assert (or (not (= (str.indexof y "t<" 0) 47)) (not (str.prefixof "<s" y))))
(assert (= (str.len x) 69))
(check-sat)
