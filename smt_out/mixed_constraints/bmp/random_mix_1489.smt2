; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<center onkeydown=""alert(1)"" contenteditable>test</center>") (= x "<figcaption id=x tabindex=1 onbeforedeactivate=alert(1)></figcaption><input autofocus>")))
(assert (or (= z "sout=alert(1) tabindex=1 id=x></meter><input autofocus>") (= z "style>:target {color:red;}</style><select id=x style=""transition:color 1s"" ontransitionend=alert(1\u{10348})></select>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 47) "a")) (str.contains (str.replace x "nten" "") "otedit") (not (str.suffixof "ter>" x))))
(assert (or (= "<center onkeydown ert(1)"" contenteditable>test</center>" (str.replace x "=""al" " ")) (not (str.suffixof "t>" z))))
(assert (or (>= (str.len y) 85) (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-z][0-9a-z_.]*[a-z0-9])$")))))
(assert (or (not (= "cont" (str.substr y 74 4))) (not (<= (str.len z) 110))))
(check-sat)
