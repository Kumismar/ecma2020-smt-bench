; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav oncontextmenu=""alert(1)"">\u{1d400}test\u{1f4a9}</nav>") (= x "<caption id=x tabindex=1 onfocusin=alert(1)></caption>")))
(assert (or (= z "rt(1)"" contenteditable>test</map>") (= z "r=""alert(1)"">test</p>") (= z "lticol>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\D?(\d{2})\D?\D?(\d{5})\D?(\d{4})$"))) (not (= "rt(" (str.substr x 23 3)))))
(assert (or (not (str.prefixof "rt(1)"" co" z)) (str.contains z "st</s>") (= (str.at y 0) "<")))
(assert (or (not (str.prefixof "lt" z)) (<= (str.len x) 59)))
(assert (not (str.contains (str.replace y "n" "<b>") "tio<b> ")))
(assert (or (= (str.indexof x "u" 0) 12) (<= (str.len x) 98)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-z]{2,15}$")) (<= (str.len z) 41)))
(check-sat)
