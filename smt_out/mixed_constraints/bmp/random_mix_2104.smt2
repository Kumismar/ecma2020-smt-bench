; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form><input type=search onsearch=alert(1) value=""Hit return"" autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><option ondrop=alert(1) contenteditable>drop here</option>") (= x "*/</script>'>alert(1)/*<script/1='")))
(assert (or (= z "x=1 onfocus=alert(1)></basefont>") (= z "rt(1)"" id=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len y) 66)) (not (str.in_re y ((_ re.from_regex ecma2020) "zip"))) (not (str.prefixof "<form>" y))))
(assert (not (str.prefixof "x=1 onfo" z)))
(assert (or (str.contains y "style") (= (str.indexof y "g" 0) 8)))
(assert (= (str.indexof x " c" 0) 21))
(assert (not (= (str.indexof x "focu" 0) 66)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-3][0-7][0-7]|[0-7]{1,2}$"))) (str.contains (str.replace x "inpu" "") "><t ") (= "rt(1)"" id=""fuzzele 1"">test</a>" (str.replace z "ment" " "))))
(assert (or (not (str.suffixof "st</pre>" y)) (str.suffixof "nt>" y)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9 +]{0,15}$"))))
(check-sat)
