; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<<SCRIPT>document.vulnerable=true;//<</SCRIPT>") (= x "<style>:target {color: red;}</style><output id=x style=""transition:color 10s"" ontransitioncancel=alert(1\u{1d400})></output>")))
(assert (or (= z "th>") (= z "utofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "<<SCR<b>>document.vulnerable=true;//<</SCRIPT>" (str.replace x "IPT" "<b>")) (str.prefixof "<rtc o" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[+\d](?:.*\d)?$"))))
(assert (not (= "<SC" (str.substr x 1 3))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([\w\.\-]+)@([\w\-]+)((\.(\w){2,3})+)"))) (>= (str.len z) 1)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "\d+\/\d+\/\d+"))))
(assert (not (<= (str.len x) 125)))
(assert (not (= (str.at y 81) "r")))
(assert (or (= (str.at y 152) "d") (not (str.contains y "ipt:ale")) (str.prefixof "<<SCRIP" y)))
(assert (>= (str.len x) 46))
(check-sat)
