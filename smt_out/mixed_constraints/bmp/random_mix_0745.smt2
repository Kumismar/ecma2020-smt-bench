; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalis\u{1f4a9}t onclick=""alert(1)"">test</datalist>") (= x "<div draggable=""true"" contenteditable>drag me</div><div ondrop=alert(1) contenteditable>drop here</div>")))
(assert (or (= z "alert(1)"" contenteditable>test</template>") (= z "ate>") (= z "re>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\-\.\(\)\s]+$"))) (= (str.at x 10) "a")))
(assert (or (not (= "alert(1)"" contenteditable>tealert(1)t</template>" (str.replace z "s" "alert(1)"))) (not (str.contains (str.replace y "datal" "x") "<xi")) (str.prefixof "<div" x)))
(assert (not (= (str.at x 22) "e")))
(assert (>= (str.len z) 1))
(assert (or (not (= (str.len y) 49)) (str.suffixof ">" z)))
(assert (or (str.contains (str.replace y "dr" "") "iv agga") (str.contains x "g me") (str.contains x "e=""true"" ")))
(check-sat)
