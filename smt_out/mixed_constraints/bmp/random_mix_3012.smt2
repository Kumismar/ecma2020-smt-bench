; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption id=x tabindex=1 ondeactivate=alert(1)></caption><input id=y autofocus>") (= x "<u onbeforecut=""alert(1)"" contenteditable>test</u>") (= x "<head onbeforecut=""alert(1)"" contenteditable>test</head>")))
(assert (or (= z "ulnerable=true></object>") (= z ">") (= z "=""alert(1)"">test</object>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<isindex " y)))
(assert (or (not (= "d>>" (str.substr y 54 7))) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z]{1}[0-9]{5,6}")))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z0-9]{6,})$")) (not (<= (str.len y) 77)) (str.in_re x ((_ re.from_regex ecma2020) "\d?\d\.\d\d"))))
(assert (or (str.suffixof ">" z) (= (str.at x 9) "r")))
(check-sat)
