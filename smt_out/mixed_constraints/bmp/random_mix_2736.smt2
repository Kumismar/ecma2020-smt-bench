; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""\x1Djavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<style>@keyframes x{}</style><title style=""animation-name:x"" onanimationstart=""alert(1)""></title>")))
(assert (or (= z "section>") (= z "lclick=""alert(String.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 61) (= (str.indexof y "e" 0) 5)))
(assert (or (not (= (str.indexof z "ction" 0) 2)) (not (str.in_re y ((_ re.from_regex ecma2020) "^.{6,64}$")))))
(assert (str.contains y "3))"">"))
(assert (= (str.indexof z ">tes" 0) 14))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{f1}\u{d1} _]*[A-Za-z0-9\u{f1}\u{d1}][A-Za-z0-9\u{f1}\u{d1} _]*$"))) (not (str.suffixof "))"">" y)) (not (str.prefixof "<style>@" y))))
(assert (str.suffixof "3))"">" y))
(check-sat)
