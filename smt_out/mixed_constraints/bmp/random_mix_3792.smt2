; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<thead onmouseenter=""alert(1)"">test</thead>") (= x "<style>:target {transform: rotate(180deg);}</style><source id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></source>") (= x "<select draggable=""true"" ondrag=""alert(1)"">test</select>")))
(assert (or (= z "</data>") (= z "<input autofocus>") (= z "oembed>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof y "e" 0) 2)))
(assert (or (not (str.suffixof "ct>" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[^\W]+$"))) (not (= "ad onmou" (str.substr x 4 8)))))
(assert (or (not (str.prefixof "<sel" x)) (not (= (str.indexof z "ta>" 0) 4)) (str.contains (str.replace z "st</" "<b>") ">te<b>templ")))
(assert (or (= (str.len y) 50) (not (str.suffixof "area>" z)) (str.suffixof "mbed>" y)))
(check-sat)
