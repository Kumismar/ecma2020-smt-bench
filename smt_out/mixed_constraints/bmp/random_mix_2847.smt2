; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset onbeforepaste=""alert(1)"" contenteditable>test</frameset>") (= x "<rtc onmouseleave=""alert(1)"">test</rtc>")))
(assert (or (= z "r o\u{1f600}nmouseup=""alert(1)"">test</br>\u{20000}") (= z "m(1);</script </svg>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "/sv" 0) 15) (not (str.in_re x ((_ re.from_regex ecma2020) "^[()+ 0-9]+$")))))
(assert (or (not (str.contains (str.replace z "uot" "<b>") "ckq<b>e id=")) (= (str.at x 41) "t") (str.contains (str.replace z " <" "alert(1)") "criptalert(1)/s")))
(assert (not (str.prefixof "r o\u{1f600}nmo" z)))
(assert (str.contains x "<rtc"))
(assert (= "\u{20000}" (str.substr y 99 7)))
(assert (or (= (str.at y 22) "r") (= (str.indexof z "ou" 0) 6)))
(check-sat)
