; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image onmousedown=""alert(1)"">test</image>") (= x "<hgroup draggable=""true"" ondragenter=""alert(1)"">test</hgroup>")))
(assert (or (= z "ource draggable=""true"" ondragstart=""alert(1)"">test</source>") (= z "rt(1)></ol>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len z) 7))
(assert (or (= (str.at x 31) "e") (not (= "<image onmousedown=""a""(1)"">test</image>" (str.replace x "lert" """"))) (not (= (str.at x 9) "r"))))
(assert (or (not (str.contains y "ggable=""tr")) (not (= (str.at y 36) "=")) (str.suffixof ">" z)))
(assert (or (str.suffixof "></time>" z) (not (str.contains y "ragstart="))))
(assert (not (str.suffixof "l>" z)))
(assert (or (not (str.contains (str.replace z "t=" "alert(1)") "gstaralert(1)""")) (not (str.contains x ">test")) (not (str.in_re z ((_ re.from_regex ecma2020) "^.{9,10}$")))))
(assert (not (str.prefixof "<image on" x)))
(check-sat)
