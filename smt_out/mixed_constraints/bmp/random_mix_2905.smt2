; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em id=x tabindex=1 onfocusin=aler\u{1f4a9}t(1)></em>") (= x "<xmp onmouseout=""alert(1)"">test</xmp>")))
(assert (or (= z "test</header>") (= z " oncontextmenu=""alert(1)"">test</image>") (= z "ing.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[01]?[- .]?\(?[2-9]\d{2}\)?[- .]?\d{3}[- .]?\d{4}$"))))
(assert (or (= (str.at x 44) """") (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,}$"))) (<= (str.len x) 46)))
(assert (not (str.prefixof "<s" x)))
(assert (or (= (str.len y) 58) (not (= (str.at y 39) ">")) (not (str.in_re y ((_ re.from_regex ecma2020) "^(8)$")))))
(assert (not (str.contains y " onconte")))
(assert (or (= (str.at x 0) "<") (str.prefixof "<" x)))
(check-sat)
