; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre onmouseup=""alert(1)"">test</pre>") (= x "<b onbeforepaste=""alert(1)"" contenteditable>test</b>") (= x "<em draggable=""true"" ondragend=""alert(1)"">test</em>")))
(assert (or (= z "vulnerable=true;</script>;</b></a></xml>") (= z "tgroup>") (= z ">test</var>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<pre on<b>up=""alert(1)"">test</pre>tgroup>" (str.replace y "mouse" "<b>"))) (= "tgroupx" (str.replace z ">" "x"))))
(assert (str.suffixof "a></xml>" z))
(assert (not (str.prefixof "<em " y)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[1-8]{2}$")) (str.in_re y ((_ re.from_regex ecma2020) "^.{6,64}$"))))
(assert (or (<= (str.len x) 46) (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\u{e0}\u{e8}\u{ec}\u{f2}\u{f9}\u{e9}\u{c0}\u{c8}\u{cc}\u{d2}\u{d9}\u{c9}'\s]+$")) (not (str.prefixof "<pre" y))))
(check-sat)
