; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nobr onmouseleave=""alert(1)"">test</nobr>") (= x "<bdo onclick=""alert(1)"">test</bdo>") (= x "<applet onfocusout=alert(1) tabindex=1 id=x></applet><input autofocus>")))
(assert (or (= z "i><input autofocus>") (= z "edeactivate=alert(1)></applet><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "edea" z)) (not (= "<nobr onmouseleave=""alert(alert(1)test</nobr>" (str.replace x "1)"">" "alert(1)"))) (not (str.contains x """J"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(([hH][Tt]{2}[Pp][Ss]?):\/\/)?([\da-zA-Z\.-]+)\.([a-zA-Z\.]{2,6})([\/\w \.-]*)*\/?$"))))
(assert (not (= "applet>" (str.substr x 46 7))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([+]+)*[0-9\s-]{5,20}"))) (not (= (str.len z) 19)) (not (str.prefixof "<svg><bdo " y))))
(assert (or (not (= (str.at z 6) "u")) (not (= "=1 " (str.substr x 36 3)))))
(assert (or (not (= (str.indexof z "inp" 0) 3)) (not (str.in_re y ((_ re.from_regex ecma2020) "^([\w+-.%]+@[\w\-.]+\.[A-Za-z]{2,4},*[\W]*)+$")))))
(assert (or (= (str.indexof x "/n" 0) 35) (>= (str.len y) 79) (not (>= (str.len x) 38))))
(check-sat)
