; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><nextid onload=alert(1)></nextid>") (= x "<frame onblur=alert(1) tabindex=1 id=x></frame><input autofocus>") (= x "<bdo id=x tabindex=1 onbeforeactivate=alert(1)></bdo>")))
(assert (or (= z "2)` onbegin=`javascript:alert(1)` >") (= z "ad=alert(1)></tfoot>") (= z "le><noframes style=""animation-name:x"" onanimationstart=""alert(1)""></noframes>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "/www.sec" z) (str.contains x "put auto")))
(assert (not (<= (str.len z) 26)))
(assert (not (= (str.indexof x " id=" 0) 4)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9-\s]{8,12}"))) (not (str.contains (str.replace y "or" """") "onbef""ea"))))
(assert (not (= "(1)>" (str.substr y 25 4))))
(assert (str.contains y "ndex=1 "))
(assert (or (str.contains (str.replace z "`" "") "2) o") (not (= (str.indexof z "al" 0) 3))))
(assert (not (= (str.at y 9) " ")))
(assert (or (str.suffixof "oframes>" z) (>= (str.len x) 37)))
(assert (or (str.suffixof "</bdo>" x) (str.contains (str.replace y "rt(" "javascript:") "alejavascript:1) t")))
(check-sat)
