; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><style ondragover=alert(1) contenteditable>drop here</style>") (= x "<hgroup oncopy=""alert(1)"" contenteditable>test</hgroup>") (= x "<style>:target {transform: rotate(180deg);}</style><xss id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></xss>")))
(assert (or (= z "pt:alert(1)"">DEF") (= z "(1) src=validimage.png>") (= z """true"" ondragend=""alert(1)"">test</dt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "8 onxxx=1" z)) (= "<dfn id=x t ndex=1 onbeforedeactivate=alert(1)></dfn><input autofocus>" (str.replace x "abi" " "))))
(assert (not (str.contains (str.replace z "(1" "alert(1)") "talert(1))""")))
(assert (str.contains (str.replace x "=ale" "x") "rxrt("))
(assert (or (= (str.indexof y "hgro" 0) 1) (not (str.contains x ">te")) (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s]{1,50})$")))))
(assert (or (>= (str.len z) 19) (not (= (str.at z 18) "."))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9 ,.'-]+$"))) (not (str.contains z "ag")) (str.prefixof "<style>:ta" x)))
(assert (= (str.len z) 67))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+.[a-z]{2,4}$"))))
(check-sat)
