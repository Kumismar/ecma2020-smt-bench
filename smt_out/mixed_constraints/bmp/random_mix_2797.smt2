; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "innerHTML=location.hash>#<script>alert(1)</script>") (= x "<thead onbeforecopy=""alert(1)"" contenteditable>test</thead>") (= x "<X OnXxx=1")))
(assert (or (= z "=""true"" ondrag=""alert(1)"">test</input>") (= z "br draggable=""true"" ondragleave=""alert(1)"">test</wbr>") (= z " contenteditable>test</noscript>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "inne" y)) (not (= (str.at x 15) "c")) (not (= "ecut=""" (str.substr x 14 6)))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[0-9\/\-\+\s\(\)]*$")) (not (= "xXxx=1" (str.replace x "<X On" "x")))))
(assert (or (not (= (str.indexof y "HTML=" 0) 5)) (<= (str.len z) 33)))
(assert (or (not (str.prefixof "br d" z)) (not (= (str.at y 26) "a"))))
(assert (or (not (= "rt" (str.substr y 76 2))) (str.prefixof "<a" x)))
(check-sat)
