; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title oncontextmenu=""alert(1)"">test</title>") (= x "<kbd \u{10348}onpaste=""alert(1)"" contenteditable>test</kbd>")))
(assert (or (= z "lert(1)></img>") (= z ">test</option>\u{10348}")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z "1)><" 0) 5))
(assert (not (str.contains x "itle")))
(assert (not (= (str.at y 3) "t")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^\s*\d\s*")) (= (str.at y 42) "e")))
(assert (or (str.suffixof "st</title>" x) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._]{3,10}$")))))
(assert (= "mg>" (str.substr z 11 3)))
(assert (= (str.indexof z "/img" 0) 9))
(assert (str.suffixof ";"">" z))
(assert (= (str.at y 27) "n"))
(check-sat)
