; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;scrscriptipt>;alert(1)<;/scrscriptipt>;") (= x "<u id=x tabindex=1 onfocusin=alert(1)></u>")))
(assert (or (= z "yup=""alert(1)"" contenteditable>test</shadow>") (= z "javascript:alert(1))%7D"";</style>") (= z "ditable>test</li>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z][A-Za-z0-9 _,-.'!?]*$"))) (= "u>ditable>" (str.substr y 40 10)) (str.prefixof "<" x)))
(assert (or (<= (str.len z) 40) (str.in_re y ((_ re.from_regex ecma2020) "^[1][3,4,5,6,7,8,9][0-9]{9}$"))))
(assert (or (not (= "<u id=x tabindex=1alert(1)focusin=alert(1)></u>javascript:alert(1))%7D"";</style>" (str.replace y " on" "alert(1)"))) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9_-]+\.[a-zA-Z0-9-.]{2,61}$"))))
(assert (or (str.suffixof "w>" y) (= "<u id=x tabindex=1 onfosin=alert(1)></u>" (str.replace x "cu" "")) (not (str.contains (str.replace y "1" "x") "rt(x)"">te"))))
(check-sat)
