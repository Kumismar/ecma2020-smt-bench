; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<acro\u{1f4a9}nym onbeforepaste=""alert(1)"" contenteditable>test</acronym>") (= x "<audio src=1 onerror=alert(1)>")))
(assert (or (= z ")"">") (= z "xss</h1></marquee>")))
(assert (= y (str.++ x z)))
(assert (not (= "marquee" (str.substr z 10 7))))
(assert (str.contains y "SS<"))
(assert (<= (str.len z) 24))
(assert (or (= "t(1)""" (str.substr x 29 5)) (not (= (str.indexof x "(1)>" 0) 26))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*d)(?=.*[$@$^!%*?#&()-=_+])[A-Za-zd$@$^!%*?#&()-=_+]{8,}")))
(assert (or (= (str.at y 17) "e") (not (= (str.at x 34) "t"))))
(check-sat)
