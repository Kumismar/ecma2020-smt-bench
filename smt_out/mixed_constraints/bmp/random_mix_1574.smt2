; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<option onfocusout=alert(1) tabindex=1 id=x></option><input autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><body ondrop=alert(1) contenteditable>drop here</body>")))
(assert (or (= z "=1") (= z "transition:transform 2s"" ontransitionrun=alert(1)></isindex>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 13) "e")) (= (str.at y 100) " ") (not (str.prefixof "<option " y))))
(assert (or (not (str.prefixof "transit" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,15}$"))) (not (= (str.indexof x "te" 0) 25))))
(assert (= (str.at x 42) "x"))
(assert (or (str.contains z "transitio") (not (str.contains x "pti")) (not (str.contains (str.replace y "(1" "") "rt) con"))))
(assert (or (not (str.contains (str.replace z "itio" "") "transn:")) (not (= (str.len z) 60))))
(assert (or (not (= "on" (str.substr x 8 2))) (not (= (str.len y) 165))))
(check-sat)
