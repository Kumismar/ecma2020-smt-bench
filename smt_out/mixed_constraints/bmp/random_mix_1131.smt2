; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg xmlns=""http://www.w3.org/2000/svg"">") (= x "<keygen draggable=""true"" ondragleave=""alert(1)"">test</keygen>")))
(assert (or (= z "(1)"" contenteditable>test</acronym>") (= z "/footer>") (= z "]>]</div>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "er>" y)) (not (= (str.at x 15) "p")) (= "agleav" (str.substr x 29 6))))
(assert (str.contains y ">]>"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9]{1,5}$"))) (str.contains x "n draggabl") (not (str.suffixof """>/footer>" y))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[1][3,4,5,7,8][0-9]{9}$")) (str.contains y "ble=""") (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-z \/\\\.0-9]*$"))))
(assert (or (str.contains (str.replace x "tp:/" "alert(1)") "=""htalert(1)/w") (not (= (str.at z 9) "a"))))
(assert (or (str.suffixof "vg"">" x) (<= (str.len z) 44)))
(check-sat)
