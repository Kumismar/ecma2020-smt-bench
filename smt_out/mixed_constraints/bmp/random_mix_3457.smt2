; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body onafterprint=alert(1)>") (= x "&lt;IMG SRC=javascript:alert(&amp;quot;XSS&amp;quot;)&gt;")))
(assert (or (= z "rt(1)"">test</input>") (= z "x:x onerror=javascript:alert(1)>") (= z "e>test</i>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 10)) (not (= (str.len y) 60))))
(assert (or (not (str.prefixof "<small dra" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"))) (str.suffixof ":alert(1)>" y)))
(assert (or (not (= (str.at z 12) "/")) (>= (str.len y) 73)))
(assert (str.prefixof "<body on" x))
(assert (not (str.suffixof "lert(1)>" x)))
(check-sat)
