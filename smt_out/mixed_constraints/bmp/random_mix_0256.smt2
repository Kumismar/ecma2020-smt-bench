; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#x0003c;") (= x "<track id=x tabindex=1 onbeforedeactivate=alert(1)></track><input autofocus>") (= x "<style>@keyframes x{}</style><tr style=""animation-name:x"" onanimationend=""alert(1)""></tr>")))
(assert (or (= z "nload=alert(1)></map>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "/tr>" x) (not (str.contains x " onanima")) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9]{4,4}")))))
(assert (or (not (= "<tr" (str.substr y 0 3))) (not (= (str.len z) 1)) (str.suffixof "p>" z)))
(assert (= (str.at x 59) "n"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) ".{8,}$"))) (<= (str.len x) 82) (str.contains (str.replace y ";>" " ") "c ")))
(assert (not (str.suffixof "1)></map>" y)))
(assert (not (>= (str.len z) 18)))
(check-sat)
