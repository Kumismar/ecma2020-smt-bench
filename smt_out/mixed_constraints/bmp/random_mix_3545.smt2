; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<stylesheet xmlns=""http://www.w3.org/TR/WD-xsl"">") (= x "<IMG SRC=x onresize=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "nimationend=""alert(1)""></ol>") (= z "cript:javascript:alert(1);""></IFRAME>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "1)""></ol>" y))
(assert (= "rCo" (str.substr x 41 3)))
(assert (= (str.at x 16) "s"))
(assert (or (str.suffixof "st</meter>" y) (not (= "=x onres" (str.substr y 8 8))) (not (= "<xRC=x onresize=""alert(String.fromCharCode(88,83,83))"">" (str.replace x "IMG S" "x")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([1-9]{1}[\d]{0,2}(\.[\d]{3})*(\,[\d]{0,2})?|[1-9]{1}[\d]{0,}(\,[\d]{0,2})?|0(\,[\d]{0,2})?|(\,[\d]{1,2})?)$"))))
(assert (= (str.at z 26) """"))
(assert (or (not (str.prefixof "<IMG SRC=" x)) (not (str.suffixof ")"">" x))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(https?:\/\/)?((?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61})?)?[A-Za-z0-9]\\.)*[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z]{2,})?(\.[a-zA-Z]{2,})?\.[a-zA-Z]{2,}\/?(:[0-9]{1,5})?$"))))
(assert (or (not (= "83))"">nima" (str.substr y 53 10))) (= (str.at z 18) "(") (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9()\-+Xx\s,]+$")))))
(check-sat)
