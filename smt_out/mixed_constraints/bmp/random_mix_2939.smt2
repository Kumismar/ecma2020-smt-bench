; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><applet ondragover=alert(1) contenteditable>drop here</applet>") (= x "<div onmouseleave=""alert(1)"">test</div>")))
(assert (or (= z "ab\u{20000}l\u{1f600}e=""true"" ondragleave=""alert(1)"">test</noscript>") (= z "rt(1)"">test</base>") (= z "<input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (= "mous" (str.substr x 6 4)))
(assert (or (= (str.len x) 32) (not (str.suffixof "est</rb>" z)) (not (str.suffixof "e</applet>" x))))
(assert (or (= (str.at y 73) "r") (not (str.contains x "iv onm"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{9}?$"))) (str.contains (str.replace z "e>" """") "/bas""") (= (str.at z 16) "e")))
(assert (or (not (>= (str.len x) 112)) (not (str.contains x "le>d"))))
(assert (not (str.suffixof ">" x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9A-Za-z]{6}"))))
(check-sat)
