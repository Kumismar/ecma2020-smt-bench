; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "#""><img src=M onerror=alert('XSS');>") (= x "<map onkeypress=""alert(1)"" contenteditable>test</map>")))
(assert (or (= z "rget {color: red;}</style><address id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></address>") (= z "tivate=alert(1)></nobr><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "p" "alert(1)") "<maalert(1) onk")) (= (str.len x) 36) (not (= (str.len x) 53))))
(assert (or (= (str.at z 81) "c") (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9a-zA-Z-_.@]+$"))) (= "g src=M o" (str.substr y 6 9))))
(assert (or (<= (str.len x) 46) (= "I" (str.substr y 4 1)) (str.contains z "te=alert")))
(assert (or (= """true"" ondrag=""alertjavascript:)"">test</style>" (str.replace z "(1" "javascript:")) (not (= "M onerror=" (str.substr y 12 10)))))
(assert (not (= (str.indexof x "SS')" 0) 30)))
(check-sat)
