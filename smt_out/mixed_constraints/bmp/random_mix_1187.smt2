; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form onmouseout=""alert(1)"">test</form>") (= x "<kbd draggable=""true"" ondragenter=""alert(1)"">test</kbd>") (= x "<hgroup id=x tabindex=1 onbeforedeactivate=alert(1)></hgroup><input \u{1f600}autofocus>")))
(assert (or (= z "us=alert(1)></bgsound>") (= z "=x style=""transition:transform 2s"" ontransitionrun=alert(1)></strike>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof ">" x) (not (str.prefixof "1"">te" z)) (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{f1}\u{d1} _]*[A-Za-z0-9\u{f1}\u{d1}][A-Za-z0-9\u{f1}\u{d1} _]*$"))))
(assert (or (= (str.len x) 39) (not (>= (str.len y) 67)) (str.contains y "on")))
(assert (str.contains x "=""alert("))
(assert (or (not (str.prefixof "<s" y)) (not (= "l" (str.substr x 19 1)))))
(check-sat)
