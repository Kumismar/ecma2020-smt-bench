; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset><frame id=x onfocus=alert(1)>") (= x "<iframe xmlns=""#"" src=""javascript:alert(1)""></iframe>") (= x "<noembed onbeforecut=""alert(1)"" contenteditable>test</noembed>")))
(assert (or (= z "y>") (= z "true"" ondragenter=""alert(1)"">test</rtc>") (= z "lick=""makePopups()"">Spam</a>//[""'`-->]]>]</div>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len x) 89) (str.contains x "ameset><fr") (not (str.suffixof "t(1)>" x))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "(?=.*[A-Z])(?=.*[0-9])(?=.*[a-z]).{8,25}")) (str.prefixof "&#x" x)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "(^(.+\@.+\..+)$)")) (not (= (str.indexof x " sr" 0) 17)) (str.contains (str.replace x "b o" " ") "su nloa")))
(assert (str.suffixof "frame>" x))
(check-sat)
