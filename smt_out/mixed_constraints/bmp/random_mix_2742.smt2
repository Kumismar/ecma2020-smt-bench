; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd onbeforepaste=""alert(1)"" contenteditable>test</kbd>") (= x "<IMG SRC=x onseeked=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z " id=x tabindex=1 onbeforedeactivate=alert(1)></hr><input autofocus>") (= z "yle>@keyframes x{}</style\u{1f600}><base style=""animation-name:x"" onanimationstart=""aler\u{20000}t(1)""></base>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\s]*$"))) (str.prefixof "<" x)))
(assert (or (not (= ")" (str.substr y 56 1))) (= "name:x" (str.substr z 50 6))))
(assert (or (= (str.len y) 83) (= (str.at x 21) "a")))
(assert (or (= (str.indexof y """" 0) 20) (not (= """anima" (str.substr z 39 6)))))
(assert (or (= (str.len y) 150) (str.suffixof "se>" z)))
(assert (not (= (str.at y 38) "C")))
(check-sat)
