; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid onmouseleave=""alert(1)"">test</nextid>") (= x "<script src=http://yoursite.com/your_files.js></script>")))
(assert (or (= z "=alert(1)>double click this!") (= z "bbr>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9 '.]+$"))) (str.in_re y ((_ re.from_regex ecma2020) "^([A-Za-z0-9]*)$"))))
(assert (not (str.contains y "rsite.")))
(assert (= "<nextid onmouseleaxe=""alert(1)"">test</nextid>=alert(1)>double click this!" (str.replace y "v" "x")))
(assert (or (<= (str.len x) 49) (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-1][0-9]|2[0-3]):[0-5][0-9]$")))))
(assert (not (str.contains x "_file")))
(assert (or (not (= (str.at z 3) ">")) (not (>= (str.len y) 46))))
(assert (or (not (>= (str.len z) 28)) (not (= (str.at y 79) "h"))))
(assert (or (not (= "<script src=http://yoursite.com/your_falert(1)js></script>=alert(1)>double click this!" (str.replace y "iles." "alert(1)"))) (str.contains y "cr")))
(check-sat)
