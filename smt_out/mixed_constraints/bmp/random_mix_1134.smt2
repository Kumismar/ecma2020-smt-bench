; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q draggable=""true"" ondragenter=""alert(1)"">test</q>") (= x "<ul id=x tabindex=1 onbeforedeactivate=alert(1)></ul><input autofocus>") (= x "<noframes onmouseout=""alert(1)"">te\u{1d400}st</noframes>")))
(assert (or (= z "ert(1)""></keygen>") (= z "alert(1)"">test</main>") (= z "st</picture>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len y) 87)) (not (str.contains z "icture>")) (str.prefixof "<" y)))
(assert (or (= (str.at x 7) "e") (not (str.in_re z ((_ re.from_regex ecma2020) "^([+])?([^\\d]?\\d){5,18}$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{c4}\u{e4}\u{d6}\u{f6}\u{dc}\u{fc}\u{df} \-]{3,20}$"))))
(assert (or (not (= "(1)" (str.substr y 38 3))) (not (= "1" (str.substr y 55 1)))))
(check-sat)
