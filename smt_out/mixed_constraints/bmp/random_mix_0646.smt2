; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script onmouseover=""alert(1)"">test</script>") (= x "<div id=""62""><!-- IE 6-8\u{10348} -->")))
(assert (or (= z "1)></fieldset>") (= z "d oncontextmenu=""alert(1)"">test</thead>") (= z "ouseout=""alert(1)"">test</canvas>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len x) 38))
(assert (or (= "test</" (str.substr z 19 6)) (not (>= (str.len z) 36))))
(assert (or (not (str.prefixof "<sc" x)) (not (= (str.at x 12) "e")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z\u{c0}-\u{fa}]{2,30}$")))))
(assert (= (str.at x 20) """"))
(assert (= "8Ajav" (str.substr x 22 5)))
(assert (or (not (= (str.indexof y "t" 0) 6)) (= (str.at z 6) "t")))
(assert (not (str.prefixof "<div" y)))
(check-sat)
