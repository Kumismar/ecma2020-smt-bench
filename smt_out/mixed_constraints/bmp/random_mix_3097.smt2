; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "`""'><img src=xxx:x \x0Donerror=javascript:alert(1)>") (= x "<rp onmouseleave=""alert(1)"">test</rp>")))
(assert (or (= z "usedown=""alert(1)"">test</html>") (= z "lert(1)></input>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "(1)>" (str.substr y 55 4))) (not (str.contains (str.replace x "t</" "x") """>tesxr"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*[A-Za-z])[A-Za-z\s\.]*"))))
(assert (or (not (= "leave=""al" (str.substr x 11 9))) (not (= "`""'><img src=xxx:x \x0Donerror=javascript:alert(1)>usedo""""alert(1)"">test</html>" (str.replace y "wn=" """")))))
(assert (= (str.indexof x "<" 0) 0))
(assert (or (= (str.indexof y "=ja" 0) 30) (not (str.contains z "lert(1"))))
(check-sat)
