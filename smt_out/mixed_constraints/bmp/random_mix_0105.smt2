; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>crypto.generateCRMFRequest('CN=0',0,0,null,'alert(1)',384,null,'rsa-dual-use')</script>") (= x "<select draggable=""true"" ondragleave=""alert(1)"">test</select>") (= x "<style>@keyframes x{}</style><output style=""animation-name:x"" onanimationstart=""alert(1)""></output>")))
(assert (or (= z "on ondrop=alert(1) contenteditable>drop here</option>") (= z "ot;)&gt;") (= z "repaste=alert(1) value="""" autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len y) 103)) (not (= "tofoc" (str.substr z 28 5)))))
(assert (str.prefixof "<script>cr" x))
(assert (not (str.prefixof "o" z)))
(assert (or (= (str.at x 34) "u") (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.,_ \-]+$")))))
(assert (or (= "-name:x"" o" (str.substr x 53 10)) (= "<select draggable=""true"" ondragleave=""alert(1)"">test</select>on ondrolert(1) contenteditable>drop here</option>" (str.replace y "p=a" ""))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^([\+][0-9]{1,3}(\s)?)?([0-9]{9,})$")))
(assert (or (not (= "r" (str.substr y 90 1))) (not (str.contains y "rateC"))))
(assert (or (not (str.contains y "lert(1)"">t")) (not (str.contains y "/st"))))
(check-sat)
