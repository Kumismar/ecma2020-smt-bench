; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre onmouseenter=""alert(1)"">test</pre>") (= x "<style>:target {transform: rotate(180deg);}</style><dd id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dd>") (= x "<STYLE>@import'%(css)s';</STYLE>")))
(assert (or (= z "/textarea>") (= z "e>test</svg>") (= z "&{()}")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "><d" 0) 50) (= (str.indexof y "t" 0) 14)))
(assert (or (not (str.prefixof "<" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3})|(\d{9})$")))))
(assert (or (not (str.prefixof "<style>" y)) (= (str.len z) 12) (not (= " frameb" (str.substr x 74 7)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([\u{5c}u4E00-\u{5c}u9FA5]+|[a-zA-Z]+)$"))) (str.suffixof "&{()}" y)))
(check-sat)
