; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image onmouseover=""alert(1)"">test</image>") (= x "'""`><script>/* *\x2Fjavascript:alert(1)// */</script>") (= x "<div draggable=""true"" contenteditable>drag me</div><source ondrop=alert(1) contenteditable>drop here</source>")))
(assert (or (= z "(1)"" contenteditable>test</main>") (= z "lert(1)"">test</em>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof ">test</em>" y)) (not (str.prefixof "lert(1)"">" z))))
(assert (or (= "ont" (str.substr x 76 3)) (<= (str.len z) 36) (not (<= (str.len y) 60))))
(assert (or (= (str.at x 15) "*") (str.suffixof "(1)></dl>" x) (not (= (str.indexof x "j" 0) 20))))
(assert (or (not (= (str.indexof z "rt(" 0) 6)) (not (= (str.at x 108) ">")) (not (str.contains (str.replace z "m>" "x") "ex"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(([X-Z]{1})(\d{7})([A-Z]{1}))|((\d{8})([A-Z]{1}))|(([A-Z]{1})(\d{8}))$"))))
(check-sat)
