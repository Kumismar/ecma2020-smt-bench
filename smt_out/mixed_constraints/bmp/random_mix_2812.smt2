; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<li oncopy=""alert(1)"" contenteditable>test</li>") (= x "<wbr onbeforecopy=""alert(1)"" contenteditable>test</wbr>")))
(assert (or (= z "/sub>") (= z "dress>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<mbed onbeforepaste=""alert(1)"" contenteditable>test</embed>eave=""alert(1)"">test</data>" (str.replace y "e" ""))) (not (str.suffixof "ss>" z)) (= "(1)"">test<javascript:nk>" (str.replace z "/bli" "javascript:"))))
(assert (>= (str.len z) 1))
(assert (or (= "rt(1)""" (str.substr y 22 6)) (not (str.contains z "/sub>"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[^\._%+-][a-zA-Z0-9._%+-]+[^\._%+-]@[^\._%+-]([a-zA-Z0-9]([.-]?))+[^\._%+-]\.[a-zA-Z]{2,4}$")) (not (str.in_re z ((_ re.from_regex ecma2020) "\d{5,11}")))))
(check-sat)
