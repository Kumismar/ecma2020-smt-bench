; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menu onpas\u{1f600}te=""alert(1)"" contenteditable>test</menu>") (= x "<svg>\u{1d400}<dir onload=\u{1f4a9}alert(1)></dir>") (= x "<samp onbeforepaste=""alert(1)"" contenteditable>test</samp>")))
(assert (or (= z ")></footer>") (= z """>test</u>") (= z "ha&#46;ckers&#46;\u{20000}org/xss&#46;css';&lt;/STYLE&gt;")))
(assert (= y (str.++ x z)))
(assert (not (= "<svg>\u{1d400}<d r onload=\u{1f4a9}alert(1)></dir>" (str.replace x "i" " "))))
(assert (not (<= (str.len y) 113)))
(assert (or (str.prefixof "rue"" ond" z) (not (str.contains (str.replace x "ble" " ") "ta >tes")) (not (str.contains y "load"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9999999999]*$"))) (not (str.prefixof ")>" z))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{1,9}$"))))
(assert (not (<= (str.len x) 37)))
(assert (or (= (str.at z 5) "l") (str.suffixof "&gt;" y)))
(assert (= (str.indexof x "<sa" 0) 0))
(check-sat)
