; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><textarea style=""animation-name:x"" onanimationend=""alert(1)""></textarea>") (= x "<s oncontextmenu=""alert(1)"">test</s>") (= x "<pre onmousemove=""alert(1)"">test</pre>")))
(assert (or (= z "rt(String.fromCharCode(88,83,83))"">") (= z "er=""alert(1)"">test</style>") (= z "name:x"" onanimationend=""alert(1)""></code>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "lert" 0) 5)))
(assert (or (not (str.prefixof "<style" x)) (= "yle=" (str.substr x 41 4))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^((\+48)[0-9]{9})$")) (not (>= (str.len y) 119))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\s\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$"))) (= (str.at z 8) "t") (= (str.len x) 38)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z, 0-9 ]{7,}")) (not (str.suffixof "/s>" z))))
(check-sat)
