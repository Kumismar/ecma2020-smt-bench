; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<HTML><BODY>") (= x "<embed onfocusout=alert(1) tabindex=1 id=x></embed><input autofocus>") (= x "<body onFocus body onFocus=""javascript:javascript:alert(1)""></body onFocus>")))
(assert (or (= z "</code>") (= z """alert(1)"" contented\u{20000}itable>test</option>\u{10348}")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[^':]*$"))))
(assert (or (not (= "<body o""ocus body onFocus=""javascript:javascript:alert(1)""></body onFocus>" (str.replace x "nF" """"))) (not (str.contains x "(1)")) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{1,5}[,.]{0,1}[0-9]{0,2}")))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9!@#$%^*()_]{6,30}$")) (str.suffixof "tion>\u{10348}" y) (not (= (str.at z 29) "1"))))
(assert (not (= " conten" (str.substr z 10 7))))
(check-sat)
