; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><cite style=""animation-name:x"" onanimationstart=""alert(1)""></cite>") (= x "<div draggable=""true"" contenteditable>drag me</div><audio ondragover=alert(1) contenteditable>drop here</audio>")))
(assert (or (= z "nmousedown=""alert(1)"">test</bgsound>") (= z "=alert(1)></code>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "me:")) (str.prefixof "=alert" z)))
(assert (or (= ">" (str.substr z 16 6)) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z\u{c1}-\u{ff}0-9]+")))))
(assert (or (= (str.at z 7) "o") (str.prefixof "<style>" y)))
(assert (not (str.prefixof "<" x)))
(assert (or (<= (str.len z) 40) (= "t(1)>" (str.substr z 5 5)) (not (= (str.at z 33) "t"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*(.[a-z]{2,4})$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Z\u{c4}\u{d6}\u{dc}][\w\u{e4}\u{c4}\u{f6}\u{d6}\u{fc}\u{dc}\u{df}/ \.\-]*$"))) (not (str.suffixof "nd>" z))))
(assert (= (str.indexof x "</c" 0) 88))
(check-sat)
