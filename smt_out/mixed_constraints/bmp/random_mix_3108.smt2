; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><frameset style=""animation-name:x"" onanimationend=""alert(1)""></frameset>") (= x "<rp onkeyup=""alert(1)"" contenteditable>test</rp>")))
(assert (or (= z "edown=""alert(1)"">test</listing>") (= z "r 1s"" ontransitionend=alert(1)></video>") (= z "=""alert(1)"" contenteditable>test</li>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z """><x") (str.contains (str.replace x "rames" " ") "f  x{}") (not (str.in_re z ((_ re.from_regex ecma2020) "^([0-9a-zA-Z]+([_.-]?[0-9a-zA-Z]+)*@[0-9a-zA-Z]+[0-9,a-z,A-Z,.,-]*(.){1}[a-zA-Z]{2,4})+$")))))
(assert (or (= (str.at y 124) "l") (str.contains (str.replace y "ert" """") "l""(")))
(assert (or (= (str.at y 20) ")") (str.contains x "(1") (= "a" (str.substr x 46 1))))
(assert (or (str.prefixof "<style>@ke" x) (= "=""alert(1)"" contenteditable>te""i>" (str.replace z "st</l" """")) (not (str.prefixof "<rp " x))))
(assert (or (not (= ">" (str.substr x 44 3))) (str.prefixof "r 1s"" on" z)))
(check-sat)
