; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table id=x t\u{1f4a9}abindex=1 onfocus=alert(1)></table>") (= x "<div id=""127""><svg xmlns=""http://www.w3.org/2000/svg"" id=""x"">") (= x "<style>:target {color: red;}</style><svg id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></svg>")))
(assert (or (= z "tabindex=1 onfocus=alert(1)></meta>") (= z "rt(1)></colgroup>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 29) "u") (= (str.indexof z ">XXX<" 0) 19)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[A-z\u{c0}-\u{ff}0-9]+([\-\.]{1,2}[A-z\u{c0}-\u{ff}0-9]+)*\.[a-z]{2,20}(:[0-9]{1,5})?(\/.*)?$"))) (str.contains (str.replace y "s;" "alert(1)") "&apoalert(1)XS")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[A-z0-9._%+-]+@[A-z0-9.-]+\.[A-z]{2,63}$"))) (>= (str.len x) 47) (not (= "<table id=x t\u{1f4a9}abindex=1""focus=alert(1)></table>rt(1)></colgroup>" (str.replace y " on" """")))))
(assert (or (not (= "e" (str.substr y 33 1))) (not (str.in_re z ((_ re.from_regex ecma2020) "^1(3|4|5|6|7|8|9)\d{9}"))) (str.contains (str.replace y "cus=" "javascript:") " onfojavascript:al")))
(assert (not (>= (str.len x) 54)))
(assert (= (str.at x 48) ">"))
(check-sat)
