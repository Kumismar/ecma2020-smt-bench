; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 onfocusout=alert(1) tabindex=1 id=x></h1><input autofocus>") (= x "<br id=x tabindex=1 onfocusin=alert(1)></br>")))
(assert (or (= z "URCE>") (= z "g><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len z) 19) (= "<br i" (str.substr x 0 5))))
(assert (or (not (str.suffixof "us>" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{1,12}$")))))
(assert (or (= "<h1 onfo" (str.substr x 0 8)) (<= (str.len z) 27) (not (= (str.at y 30) "e"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[A-Z|a-z]{1,}")) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9+]*$"))) (str.suffixof "CE>" y)))
(check-sat)
