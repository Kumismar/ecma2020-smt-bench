; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><bgsound style=""animation-name:x"" onanimationstart=""alert(1)""></bgsound>") (= x "<param onclick=""alert(1)"">test</param>")))
(assert (or (= z "t(123)</script>") (= z "ead onbeforecopy=""alert(1)"" contenteditable>test</thead>") (= z "alert(1)></pre>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 90) ">") (not (str.contains x """alert"))))
(assert (not (= (str.indexof y "src=/" 0) 67)))
(assert (or (= (str.at x 70) "t") (str.contains (str.replace x "r i" "") "bd=x") (<= (str.len z) 11)))
(assert (or (str.contains (str.replace y "o" " ") "gs und ") (not (str.prefixof "<param on" x))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6}$"))) (= (str.indexof x "edita" 0) 34) (not (= (str.at x 10) "l"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\s*\S+.*$"))) (>= (str.len x) 30) (= (str.indexof x "m" 0) 5)))
(check-sat)
