; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;SCRIPT>;a=/XSS/") (= x "&#x00003C;") (= x "<img SRC='vbscript:document.vulnerable=true;'>")))
(assert (or (= z "ontransitionend=alert(1)></tr>") (= z "ut id=y autofocus>") (= z "t type=image src=validimage.png onload=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*\d)(?=.*[A-Z])(?=.*[a-z])[0-9A-Za-z]{8,}$"))) (not (= (str.indexof y "<;S" 0) 0)) (>= (str.len x) 60)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(13[0-9]|15[0-9]|18[0-9])d{8}$"))) (not (= (str.at y 48) " "))))
(assert (or (not (<= (str.len y) 65)) (= (str.at z 15) "=")))
(assert (or (str.suffixof "1)>" z) (not (= "e""/template>" (str.replace z "st<" """")))))
(check-sat)
