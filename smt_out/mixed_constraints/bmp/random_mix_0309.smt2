; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script src=//brutelogic.com.br/1.js>") (= x "<p onmouseover=""alert(1)"">test</p>")))
(assert (or (= z "rt(1)></mark>") (= z "ert(1)\u{10348}"">test</shadow>") (= z "e"" ondrag=""alert(1)"">test</title>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "x3" 0) 1)) (not (= (str.indexof y "avas" 0) 14)) (not (str.contains (str.replace x "//" "") " src=br"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(([^<>()\[\]\.,;:\s@]+(\.[^<>()\[\]\.,;:\s@]+)*)|(.+))@(([^<>()[\]\.,;:\s@]+\.)+[^<>()[\]\.,;:\s@]{2,})$"))))
(assert (= (str.len z) 13))
(assert (or (= (str.len z) 33) (not (str.prefixof "<p onmouse" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^([-0-9]){8,}$")))))
(assert (not (str.contains y "telog")))
(check-sat)
