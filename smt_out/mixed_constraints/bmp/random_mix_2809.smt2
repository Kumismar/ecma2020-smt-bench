; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th oncontextmenu=""alert(1)"">test</th>") (= x "<basefont onbeforecopy=""alert(1)"" contenteditable>test</basefont>")))
(assert (or (= z "eenter=""alert(1)"">te\u{1d400}st<\u{20000}/center>") (= z "e=""animation-name:x"" onanimationend=""alert(1)""></li>") (= z """jav\u{9}ascript:alert('XSS');"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 44) "t")) (not (= (str.at y 16) "d")) (str.contains x "e>test</")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9 a-z A-Z]$"))) (str.suffixof "enter>" z) (not (str.contains (str.replace y "ascri" """") "\u{9}""pt:a"))))
(assert (or (= (str.indexof y ">:ta" 0) 6) (not (= (str.indexof x "xtmen" 0) 11)) (<= (str.len x) 68)))
(assert (or (= "<th oncontextmenu=""alex1)"">test</th>" (str.replace x "rt(" "x")) (str.prefixof "<bas" y) (= (str.at y 49) "t")))
(assert (or (not (= "<th ncontextmenu=""alert(1)"">test</th>" (str.replace x "o" ""))) (<= (str.len x) 89)))
(check-sat)
