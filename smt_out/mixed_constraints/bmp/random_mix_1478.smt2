; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article draggable=""true"" ondragend=""alert(1)"">test</article>") (= x "<del draggable=""true"" ondragenter=""alert(1)"">test</del>")))
(assert (or (= z "</script>") (= z "id=x></command><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "tofocus>" y))
(assert (not (str.prefixof "id=x></noe" z)))
(assert (or (str.contains x "rticle>") (not (= (str.len z) 32))))
(assert (not (= "ea id" (str.substr x 7 5))))
(assert (or (not (= (str.at z 4) "r")) (= (str.at x 24) "d")))
(assert (= (str.len x) 61))
(assert (or (= (str.indexof z "u" 0) 19) (= "<del draggable=""true"" ondragenter=""a t(1)"">test</del>" (str.replace x "ler" " ")) (not (str.contains (str.replace z "and><" " ") "m inp"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9]{1}[A-Za-z0-9_.-]*@{1}[A-Za-z0-9_.-]{1,}\.[A-Za-z0-9]{1,}$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z]{5})(\d{4})([a-zA-Z]{1})|([a-zA-Z]{1})(\d{5})([a-zA-Z]{2})(\d{4})([a-zA-Z]{3})(\d{6})$"))) (str.contains x "dragga") (str.prefixof "<del" y)))
(check-sat)
