; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span onblur=alert(1) tabindex=1 id=x></span><input autofocus>") (= x "<th onmouseup=""alert(1)"">test</th>") (= x "<;SCRIPT "";a=';>;';""; SRC="";http://ha.ckers.org/xss.js"";>;<;/SCRIPT>;")))
(assert (or (= z "t=""alert(1)"" contenteditable>test</plaintext>") (= z "t(1)"">test</rp>") (= z "t(1)"">test</address>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^([+])(9{1})(1{1})(\d{10})|(\d{10})$"))))
(assert (= (str.indexof z ">" 0) 5))
(assert (not (>= (str.len x) 57)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{1,2}\/\d{1,2}\/\d{4}$"))))
(assert (str.contains z "rt"))
(assert (not (= "<th onmouseup=""alert( >test</th>t(1)"">test</rp>" (str.replace y "1)""" " "))))
(assert (or (not (str.contains z """>test</ad")) (not (= "t(est</rp>" (str.replace z "1)"">t" "")))))
(check-sat)
