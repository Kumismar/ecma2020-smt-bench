; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><strong id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></strong>") (= x "<iframe src=""vbscrip\u{20000}t:document.vulnerable=true;"">")))
(assert (or (= z "enteditable>test</pre>") (= z "x></select><input autofocus>") (= z "nactivate=alert(1)></xss>")))
(assert (= y (str.++ x z)))
(assert (or (not (>= (str.len z) 15)) (not (str.contains y "e>tes"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "/^13[0-9]{9}$|14[0-9]{9}|15[0-9]{9}$|18[0-9]{9}$/"))))
(assert (or (not (str.contains y "ue;"">")) (str.contains y "p\u{20000}t:docum") (not (= (str.at x 64) "o"))))
(assert (not (= (str.len y) 72)))
(assert (not (str.prefixof "nactivate=" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{10}|\d{10})$"))) (str.contains (str.replace z "tedit" "") "enabl")))
(check-sat)
