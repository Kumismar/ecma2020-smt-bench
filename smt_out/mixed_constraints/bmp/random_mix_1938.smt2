; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><form onload=alert(1)></form>") (= x "<image src=1 href=1 onerror=""javascript:alert(1)""></image>")))
(assert (or (= z "nxxx=1") (= z """true"" ondrag=""alert(1)"">test</col>") (= z "eover=""alert(1)""\u{20000}>test</textarea>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.]{8,20}$"))) (not (= (str.indexof z ">" 0) 0))))
(assert (or (= (str.at y 29) "e") (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z\u{15f}\u{fc}\u{f6}\u{131}\u{11f}\u{e7}\u{15e}\u{dc}\u{d6}\u{130}\u{11e}\u{c7}0-9-_\.]{1,15}$")))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^.{0,42}$")))
(assert (= (str.indexof x "er" 0) 22))
(assert (or (not (= (str.at x 13) "l")) (= "<a onmouseup=""alert<b>test</a>n=alert(1)></s>" (str.replace y "(1)"">" "<b>"))))
(check-sat)
