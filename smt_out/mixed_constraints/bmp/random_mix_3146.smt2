; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onblur=alert(1) tabindex=1 id=x></html><input autofocus>") (= x "<style>:target {transform: rotate(180deg);}</style><ruby id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></ruby>") (= x "<image onmouseenter=""alert(1)"">test</image>")))
(assert (or (= z "seover=""alert(1)"">test</cite>") (= z "lt;/br style=a:expression(alert())&gt;")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "di" 0) 36))
(assert (= (str.len z) 35))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^.+@.+\..{2,}$"))) (str.contains (str.replace y ">seov" "alert(1)") "agealert(1)er=""") (str.in_re y ((_ re.from_regex ecma2020) "([\w-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-zA-Z]{2,6}(?:\.[a-zA-Z]{2})?)$"))))
(assert (or (str.prefixof "<h" y) (>= (str.len x) 33)))
(assert (or (= (str.indexof z ")&gt" 0) 33) (not (= (str.at z 10) "a"))))
(check-sat)
