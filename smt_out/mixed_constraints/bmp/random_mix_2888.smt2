; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><svg style=""animation-name:x"" onanimationend=""alert(1)""></svg>") (= x "<div draggable=""true"" contenteditable>drag me</div><bdo ondrop=alert(1) contenteditable>drop here</bdo>") (= x "<table draggable=""true"" ondrag\u{20000}start=""alert(1)"">test</t\u{1f600}able>")))
(assert (or (= z "ocus=alert(1)>focus this!") (= z "le onkeyup=""alert(1)"" contenteditable>test</table>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "e=" (str.substr x 15 2))) (not (str.in_re z ((_ re.from_regex ecma2020) "([0-9]){6}\s([0-9]){5}")))))
(assert (or (not (= "< ble draggable=""true"" ondrag\u{20000}start=""alert(1)"">test</t\u{1f600}able>le onkeyup=""alert(1)"" contenteditable>test</table>" (str.replace y "ta" " "))) (not (str.in_re y ((_ re.from_regex ecma2020) "^.{0,1}$"))) (str.contains z "p=""a")))
(assert (or (= (str.indexof y "</t" 0) 32) (<= (str.len z) 52) (= (str.indexof x "ler" 0) 39)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([\w!#$%&'*+\-\/=?\^`{|}~]+\.)*[\w!#$%&'*+\-\/=?\^`{|}~]+@((((([a-zA-Z0-9]{1}[a-zA-Z0-9\-]{0,62}[a-zA-Z0-9]{1})|[a-zA-Z])\.)+[a-zA-Z]{2,62})|(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?)$"))))
(check-sat)
