; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table draggable=""true"" ondrag=""alert(1)"">test</table>") (= x "<META HTTP-EQUIV=""refresh"" CONTENT=""0; URL=http://;URL=javascript:javascript:alert(1);"">")))
(assert (or (= z " SRC=`javascript&#058;alert(\""RSnake says, 'XSS'\"")`&gt;") (= z "ransition:color 1s"" ontransitionend=alert(1)></bd\u{1f4a9}i>") (= z "dex=1 ondeactivate=alert(1)></canvas><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 21) "n") (str.contains (str.replace z "nsi" "alert(1)") """traalert(1)tion:") (not (str.contains y """0"))))
(assert (or (str.prefixof "<tab" y) (not (str.contains y "ocus>"))))
(assert (or (not (str.prefixof "<n" y)) (not (str.suffixof "</command>" x)) (str.suffixof "lert(1);"">" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]+|([0-9]+[,\.][0-9]{0,2})"))) (str.suffixof "st</table>" x) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9!-/:-@\u{2260}\[-`{-~]+$"))))
(assert (or (= (str.indexof x " dra" 0) 6) (str.prefixof " SRC" z) (not (= "ript&#058" (str.substr z 12 9)))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[0-9 A-z]{6,12}$")))
(check-sat)
