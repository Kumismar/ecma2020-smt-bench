; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<OBJECT classid=clsid:ae24fdae-03c6-11d1-8b76-0080c744f389><param name=url value=javascript:javascript:alert(1)></OBJECT>") (= x "&lt;IMG SRC=\""mocha&#58;&#91;code&#93;\""&gt;") (= x "<div draggable=""true"" contenteditable>drag me</div><area ondragover=alert(1) contenteditable>drop here</area>")))
(assert (or (= z "e>@keyframes x{}</style><spacer style=""animation-name:x"" onanimationend=""alert(1)""></spacer>") (= z "ontent oncut=""alert(1)"" contenteditable>test</content>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "n" 0) 1)) (not (str.prefixof "<OBJECT c" y)) (= (str.indexof z "(1)" 0) 39)))
(assert (or (not (str.suffixof "content>" y)) (= (str.at x 11) "=")))
(assert (not (str.suffixof "></spacer>" z)))
(assert (or (not (= (str.len y) 201)) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9]{3,10}"))) (= (str.len z) 54)))
(assert (or (not (str.prefixof "e>@k" z)) (= (str.len z) 67)))
(assert (or (not (= "r>" (str.substr z 41 9))) (= "ontent oncut=""alert(1)"" conte table>test</content>" (str.replace z "ntedi" " "))))
(assert (or (not (str.suffixof "pacer>" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.#\s]+$")))))
(check-sat)
