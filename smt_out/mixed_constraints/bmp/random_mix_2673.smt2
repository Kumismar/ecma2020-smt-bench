; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1f4a9}t\u{1f600}foot ondblclick=""alert(1)"">test</tfoot>") (= x "<tr onpaste=""alert(1)"" contenteditable>test</tr>")))
(assert (or (= z "ex=1 onfocusin=alert(1)></nextid>") (= z "onbeforecopy=""alert(1)"" contenteditable>test</h1>")))
(assert (= y (str.++ x z)))
(assert (or (not (= """>t" (str.substr y 42 3))) (not (str.in_re z ((_ re.from_regex ecma2020) "^(https?:\/\/)?(www.)?[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_\+.~#?&//=]{0,128})$"))) (not (str.contains x "dblc"))))
(assert (or (= (str.indexof z "yl" 0) 1) (= (str.at y 52) " ")))
(assert (or (str.contains (str.replace z "le>" "javascript:") "bjavascript:test") (not (str.contains y "e>test</h1")) (not (str.prefixof "<i" x))))
(assert (or (str.prefixof "ex=1 o" z) (not (str.prefixof "nmo" z))))
(assert (or (str.contains y "t>ex=") (not (>= (str.len y) 84)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{105}\u{107}\u{119}\u{142}\u{144}\u{f3}\u{15b}\u{17a}\u{17c}\u{104}\u{106}\u{118}\u{141}\u{143}\u{d3}\u{15a}\u{179}\u{17b}\s]{3,30}$")))))
(check-sat)
