; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript draggab\u{20000}l\u{1f600}e=""true"" ondragleave=""alert(1)"">test</noscript>") (= x "<div draggable=""true"" contenteditable>drag me</div><big ondragover=alert(1) contenteditable>drop here</big>") (= x "<basefont draggable=""true"" ondragend=""alert(1)"">test</basefont>")))
(assert (or (= z "T a="";>;""; SRC="";http://ha.ckers.org/xss.js"";>;<;/SCRIPT>;") (= z "Error=""javascript:javascript:alert(1)""></object onError>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "cri" 0) 12)))
(assert (or (not (= (str.indexof x "rip" 0) 5)) (not (= (str.indexof y "a" 0) 13)) (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[a-zA-Z])(?=.*[0-9])[A-Za-z0-9\./\s-]+$"))))
(assert (or (str.contains z ";>;""") (not (str.prefixof "<div dra" y)) (= (str.at z 30) "r")))
(assert (or (not (str.prefixof "&lt;SCRI" y)) (not (str.in_re y ((_ re.from_regex ecma2020) "(?:19|20)[0-9]{2}-(?:(?:0[1-9]|1[0-2])/(?:0[1-9]|1[0-9]|2[0-9])|(?:(?!02)(?:0[1-9]|1[0-2])/(?:30))|(?:(?:0[13578]|1[02])-31))"))) (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{9}"))))
(assert (not (= (str.at z 9) "g")))
(assert (or (not (= "Error=""javascript:javascript:alert(1)""></object oalert(1)rror>" (str.replace z "nE" "alert(1)"))) (not (str.suffixof "/SCRIPT>;" y)) (str.contains (str.replace y "e=""al" "x") "avxert")))
(check-sat)
