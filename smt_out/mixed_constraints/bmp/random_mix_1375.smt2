; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title id=x tabindex=1 onactivate=alert(1)></title>") (= x "<input type=checkbox id=x onfocusin=alert(1)>")))
(assert (or (= z "usedown=""alert(1)"">test</address>") (= z "true"" contenteditable>drag me</div><audio ondragover=alert(1) contenteditable>drop here</audio>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\u{5c}u00C0-\u{5c}u00FF-]*$"))) (= (str.at x 32) "e")))
(assert (or (str.contains y "=""alert") (not (str.in_re y ((_ re.from_regex ecma2020) "^\+?[\d\s]{6,18}$")))))
(assert (or (not (str.prefixof "<input" x)) (str.prefixof "usedo" z) (str.contains x "=1 onac")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z ]{2,250}$"))) (not (str.contains x "al"))))
(check-sat)
