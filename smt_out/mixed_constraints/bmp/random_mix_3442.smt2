; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section draggable=""true"" ondragend=""alert(1)"">test</section>") (= x "<script+src="">""+src=""http://yoursite.com/xss.js?69,69""></script>") (= x "<noframes onfocusout=alert(1) tabindex=1 id=x></noframes><input autofocus>")))
(assert (or (= z "ionr\u{1f4a9}un=alert(1)></marquee>") (= z " ondragleave=""alert(1)"">test</progress>") (= z "semove=""alert(1)"">test</data>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace x "s" "") ">tet"))
(assert (str.suffixof "cript>" x))
(assert (or (str.suffixof ">" y) (str.suffixof "uee>" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z]([a-zA-Z0-9\-]){1,}[a-zA-Z0-9]$"))))
(assert (or (= (str.at z 6) "g") (str.prefixof " ondr" z)))
(assert (or (= (str.at x 16) "s") (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z ]{5,25}")))))
(check-sat)
