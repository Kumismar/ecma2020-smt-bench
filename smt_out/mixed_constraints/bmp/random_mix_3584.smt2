; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 draggable=""true"" ondragenter=""alert(1)"">test</h1>") (= x "&lt;EMBED SRC=\""http&#58;//ha&#46;ckers&#46;org/xss&#46;swf\"" AllowScriptAccess=\""always\""&gt;&lt;/EMBED&gt;")))
(assert (or (= z "div id=x tabindex=1 onfocusin=alert(1)></div>") (= z "ntenteditable>test</ol>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "1>div id=") (= (str.at z 4) "t")))
(assert (not (= (str.at z 3) "l")))
(assert (or (= (str.len y) 153) (= (str.at z 17) "=")))
(assert (or (str.contains (str.replace y ";cke" "javascript:") "a&#46javascript:rs") (not (str.in_re z ((_ re.from_regex ecma2020) "\S+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$")))))
(assert (not (str.prefixof "<O" x)))
(assert (or (not (= "e" (str.substr z 15 1))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[1-9]\d*|0$")))))
(assert (not (str.suffixof "ED&gt;" x)))
(assert (or (not (<= (str.len x) 113)) (str.in_re x ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}\s]{2,30}$"))))
(check-sat)
