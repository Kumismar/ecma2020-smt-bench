; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><kbd ondrop=alert(1) contenteditable>drop here</kbd>") (= x "<a onmousemove=""alert(1)"">test</a>")))
(assert (or (= z "ext\u{10348}menu\u{1f600}=""alert(1)"">test</br>") (= z "le>test</base>") (= z "h"" CONTENT=""0;url=javascript:javascript:alert(1);"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[-\w][-\w.]+@{1}[-a-z0-9]+[.]{1}[a-z]{2,7}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^(WYTL|wytl)$"))) (not (>= (str.len y) 83))))
(assert (or (not (= "le>test< >" (str.replace z "/base" " "))) (not (str.prefixof "h" z))))
(assert (or (= (str.at z 2) ">") (str.contains (str.replace y "ag m" "x") "e>drxe</di")))
(assert (not (>= (str.len z) 48)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "((^(6|7)[0-9]{1,9}$)|(^(00|\+)[0-9]{1,15}$))"))) (= "t(" (str.substr z 15 2))))
(assert (or (not (str.contains z "ON")) (<= (str.len x) 39)))
(assert (or (str.contains y "teditable>") (= "<div dr<b>ggable=""true"" contenteditable>drag me</div><kbd ondrop=alert(1) contenteditable>drop here</kbd>ext\u{10348}menu\u{1f600}=""alert(1)"">test</br>" (str.replace y "a" "<b>"))))
(check-sat)
