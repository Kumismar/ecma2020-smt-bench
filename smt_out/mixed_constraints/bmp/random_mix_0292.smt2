; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onfocusout=alert(1) tabindex=1 id=x></sup><input autofocus>") (= x "<script src=""data:text/javascript,alert(1)""></script>")))
(assert (or (= z ">test</p\u{1d400}rogress>") (= z "index=1 onbeforedeactivate=alert(1)></listing><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= "index=1 onbefore ivate=alert(1)></listing><input autofocus>" (str.replace z "deact" " ")) (not (= "pt,alert" (str.substr x 31 8)))))
(assert (not (str.contains z "</p\u{1d400}rogr")))
(assert (not (str.prefixof "<s" y)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[^@]+@[^@]+\.[a-zA-Z]{2,6}|^\(?([0-9]{3})\)?[-. ]?([0-9]{3})[-. ]?([0-9]{4})")) (not (str.in_re z ((_ re.from_regex ecma2020) "[1-9][0-9]{3,4}"))) (not (str.contains z "est</p\u{1d400}r"))))
(assert (or (not (str.suffixof ">" x)) (not (str.contains (str.replace y "><" "<b>") "d=x<b>/")) (not (= "<script src= ata:text/javascript,alert(1)""></script>index=1 onbeforedeactivate=alert(1)></listing><input autofocus>" (str.replace y """d" " ")))))
(assert (or (not (str.contains y "tes")) (str.in_re z ((_ re.from_regex ecma2020) "^([0-9]{11})$"))))
(check-sat)
