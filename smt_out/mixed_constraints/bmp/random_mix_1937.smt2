; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption id=x tabindex=1 onbeforedeactivate=alert(1)></caption><input autofocus>") (= x "<script>alert('XSS');</script>") (= x "<comman\u{10348}d onfocusout=alert(1) tabindex=1 id=x></command><input aut\u{1d400}ofocus>")))
(assert (or (= z "mp draggable=""true"" ondragend=""alert(1)"">test</samp>") (= z "h onpaste=""alert(1)"" contenteditable>test</th>") (= z "ocusout=alert(1) tabindex=1 id=x></b><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "e><li" z)))
(assert (not (str.contains (str.replace x "d" "alert(1)") "ialert(1)=x")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\S{6,32}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^.{5,16}$"))) (not (str.prefixof "<cap" y))))
(assert (or (= (str.at x 37) "d") (str.prefixof "<c" y) (not (= "c>" (str.substr z 1 10)))))
(assert (or (not (= (str.indexof y "aut\u{1d400}" 0) 63)) (= "eactivate" (str.substr y 34 9))))
(assert (= "editable>" (str.substr z 28 9)))
(check-sat)
