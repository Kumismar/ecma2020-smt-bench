; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body ondblclick=""alert(1)"">test</body>") (= x "<\u{10348}head onclick=""alert(1)"">test</head\u{1f600}>")))
(assert (or (= z "pt:alert(1)""></body onUnload>") (= z "av&amp;#x0A;ascript:alert(&apos;\u{1d400}XSS&apos;);&quot;&gt;") (= z "utput onmouseenter=""alert(1)"">test</output>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "s" 0) 30)) (not (= (str.at z 37) "a"))))
(assert (= (str.indexof y ">" 0) 25))
(assert (or (<= (str.len z) 37) (= "ript:alert" (str.substr y 54 10)) (not (= (str.at y 87) ";"))))
(assert (or (= (str.len y) 68) (not (str.prefixof "av&amp" z)) (= "<\u{10348}head onclick=""alerx1)"">test</head\u{1f600}>pt:alert(1)""></body onUnload>" (str.replace y "t(" "x"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[A-z0-9\u{c4}\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\.\s]{1,}"))))
(assert (not (str.contains z "er=""alert")))
(check-sat)
