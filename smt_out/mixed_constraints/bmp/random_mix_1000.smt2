; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=javascript:javascript:alert(1)>") (= x "<math><brute xlink:href=javascript:alert(1)>click")))
(assert (or (= z "ncancel=alert(1)></nav>") (= z "id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></del>") (= z "YPE=""text/javascript"">document.vulnerable=true;</style>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len z) 68))
(assert (or (not (= (str.indexof x "a" 0) 10)) (str.prefixof "<math>" y) (= "<i id=x tabindex=1 ondeactivate=alert(1)javascript:</i><input id=y autofocus>nteditable>drag me</div><bgsound ondragover=alert(1) contenteditable>drop here</bgsound>" (str.replace y ">" "javascript:"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}$"))))
(assert (str.suffixof "(1)></del>" z))
(assert (or (not (= "<IMG SRC=javascript:javascript:alert(1)>YPE=""text/javascript"">documenalert(1)nerable=true;</style>" (str.replace y "t.vul" "alert(1)"))) (str.contains x "e xlink:hr") (not (= (str.len y) 72))))
(assert (or (= "j" (str.substr y 20 1)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0][0-9]{9,9}$"))) (= (str.at z 27) "r")))
(check-sat)
