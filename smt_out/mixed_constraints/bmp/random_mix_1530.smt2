; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a onbeforecopy=""alert(1)"" contenteditable>test</a>") (= x "<ul onkeypress=""alert(1)"" contenteditable>test</ul>")))
(assert (or (= z "ref=validstyles.css rel=stylesheet onload=alert(1)>") (= z "ert(1)"">test</frame>") (= z "ecopy=""alert(1)"" contenteditable>test</div>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<ul " x) (not (= "ess=""a" (str.substr y 11 6))) (not (str.in_re y ((_ re.from_regex ecma2020) "(?=^.{8,}$)(((?=.*[a-z])(?=.*[A-Z])(?=.*\d))|((?=.*[a-z])(?=.*[A-Z])(?=.*[!@#$%^*()]+))|((?=.*[a-z])(?=.*\d)(?=.*[!@#$%^*()]+))|((?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^*()]+))).*$")))))
(assert (or (not (str.suffixof "html>" y)) (str.suffixof "rt(1)>" z)))
(assert (not (= (str.at z 7) ">")))
(assert (or (not (str.contains x "ler")) (>= (str.len y) 57) (not (>= (str.len x) 48))))
(assert (>= (str.len y) 85))
(check-sat)
