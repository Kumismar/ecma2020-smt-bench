; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onkeypress=""alert(1)"" contenteditable>test</dfn>") (= x "<SCRIPT/XSS SRC=""http://ha.ckers.org/xss.js""></SCRIPT>")))
(assert (or (= z "p=""alert(1)"" contenteditable>test</legend>") (= z "ert(1)</script>") (= z "/em>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "&" y))
(assert (not (= (str.len x) 54)))
(assert (or (= "ess=""aler" (str.substr x 12 9)) (not (= (str.at y 15) "=")) (not (>= (str.len x) 48))))
(assert (or (not (= (str.indexof y "i" 0) 36)) (= (str.at z 4) "1") (not (str.in_re z ((_ re.from_regex ecma2020) "^[1-9][0-9]{4,}|\+?(38|8)?0(39|50|63|66|67|68|73|91|92|93|94|95|96|97|98|99)[0-9]{7}$")))))
(assert (or (not (= "able>te" (str.substr y 38 7))) (str.prefixof "<dfn o" y)))
(assert (not (>= (str.len z) 5)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z]{1,1}[0-9]{8}[a-zA-Z]{1,1}"))))
(check-sat)
