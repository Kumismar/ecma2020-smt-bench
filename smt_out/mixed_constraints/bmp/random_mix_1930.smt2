; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s\u{10348}lot onmouseout=""alert(1)"">test</slot>") (= x "<dialog draggable=""true"" ondrag=""alert(1)"">test</dialog>") (= x "<datalist onkeydown=""alert(1)"" contenteditable>test</datalist>")))
(assert (or (= z "alert(1)"">test</small>") (= z "arquee>") (= z "3c")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[+-]?[\d\.]*$")))
(assert (or (str.contains y "rag=""ale") (str.in_re z ((_ re.from_regex ecma2020) "^(\w).{4,32}$")) (not (= "3""" (str.replace z "c" """")))))
(assert (not (str.contains x "(1)")))
(assert (or (str.contains (str.replace z "rquee" "alert(1)") "aalert(1)>") (str.prefixof "<di" y)))
(assert (or (not (= (str.len y) 42)) (not (str.in_re z ((_ re.from_regex ecma2020) "\(?(\d{3})\)?[-\. ]?(\d{3})[-\. ]?(\d{4})$")))))
(check-sat)
