; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<SCRIPT SRC=""http://ha.ckers.org/xss.jpg""></SCRIPT>") (= x "<tfoot onbeforecopy=""alert(1)"" contenteditable>test</tfoot>") (= x "<dd onfocusout=alert(1) tabindex=1 id=x></dd><input autofocus>")))
(assert (or (= z "></marquee><input autofocus>") (= z "lert(1)></footer>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[A-Z\u{5d0}-\u{5ea}a-z ]{1,50}$")) (not (>= (str.len x) 56))))
(assert (or (not (str.contains z "></marqu")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z\u{c0}-\u{fa}\s]{2,30}$"))) (str.contains y "ick=""al")))
(assert (str.contains (str.replace z "test" """") "e>""</le"))
(assert (or (not (str.prefixof "></marquee" z)) (= " version=""" (str.substr x 18 10)) (<= (str.len x) 69)))
(assert (or (not (= ">test</a" (str.substr y 29 8))) (not (str.contains x "beforecopy")) (= "RIPT>" (str.substr x 46 7))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[A-z0-9 ._-]{2,60}$")) (str.prefixof "<t" x)))
(assert (= (str.at z 12) "o"))
(check-sat)
