; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blink onmouseup=""alert(1)"">test</blink>") (= x "<slot draggable=""true"" ondragend=""alert(1)"">test</slot>") (= x "<fieldset id=x tabindex=1 onfocus=alert(1)></fieldset>")))
(assert (or (= z """>test</object>") (= z "ieldset oncut=""alert(1)"" contenteditable>test</fieldset>") (= z "=""alert(1)"">test</li>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len x) 47)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[^<>%]*$"))) (= (str.at z 6) "<") (not (= "t(1" (str.substr y 38 3)))))
(assert (or (= (str.indexof x "=""" 0) 15) (not (str.in_re z ((_ re.from_regex ecma2020) "^(([\d]{2} )|(2[abAB] ))*(([\d]{2})|(2[abAB]))$")))))
(assert (or (= "</fi" (str.substr y 43 4)) (str.suffixof "t</object>" z) (= (str.indexof y "r" 0) 21)))
(assert (or (str.contains (str.replace z ">test" "javascript:") """javascript:<") (not (= (str.indexof y "ndex=" 0) 19)) (not (= (str.at z 5) "t"))))
(assert (or (>= (str.len y) 71) (= (str.at x 27) "a")))
(check-sat)
