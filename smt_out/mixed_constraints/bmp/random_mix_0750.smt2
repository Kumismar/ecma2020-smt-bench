; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title draggable=""true"" ondragstart=""alert(1)"">test</tit\u{1f600}le>") (= x "<strike draggable=""true"" ondragenter=""alert(1)"">test</strike>")))
(assert (or (= z "Some text</span>") (= z """true"" contenteditable>drag me</div><strike ondragover=alert(1) contenteditable>drop here</strike>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "nted" " ") "conte ita")) (not (= "ncut=""aler" (str.substr y 9 10)))))
(assert (or (not (= (str.len z) 28)) (str.contains x "true"" ondr") (= "xt" (str.substr z 7 2))))
(assert (or (str.contains y " text</sp") (not (= "<titlexdraggable=""true"" ondragstart=""alert(1)"">test</tit\u{1f600}le>""true"" contenteditable>drag me</div><strike ondragover=alert(1) contenteditable>drop here</strike>" (str.replace y " " "x"))) (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$"))))
(assert (or (= "<title dr<b>ggable=""true"" ondragstart=""alert(1)"">test</tit\u{1f600}le>" (str.replace x "a" "<b>")) (not (str.prefixof "<tit" y))))
(check-sat)
