; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure oncontextmenu=""alert(1)"">test</figure>") (= x "<label id=x tabindex=1 onbeforedeactivate=alert(1)></label><input autofocus>") (= x "<style>@keyframes x{}</style><cite style=""animation-name:x"" onanimationstart=""alert(1)""></cite>")))
(assert (or (= z "te\u{10348}r>") (= z "it value=click>") (= z "e>:target {color:red;}</style><style id=x style=""transition:color 1s"" ontransitionend=alert(1)></style>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^(01[2689]|09)[0-9]{8}$")) (not (str.suffixof "te\u{10348}r>" z))))
(assert (or (= "style>" (str.substr z 97 6)) (not (= (str.len y) 158))))
(assert (or (str.contains x "alert(1") (not (= (str.at y 63) "u"))))
(assert (or (str.suffixof "ure>" x) (not (str.contains z "=cli"))))
(assert (or (not (= (str.at z 13) "k")) (str.contains (str.replace y "styl" "javascript:") ";}</javascript:e><st")))
(assert (or (str.suffixof "</scri\u{1f600}pt>" x) (str.in_re x ((_ re.from_regex ecma2020) ".*@fsfe\.org")) (not (= "e" (str.substr z 1 1)))))
(check-sat)
