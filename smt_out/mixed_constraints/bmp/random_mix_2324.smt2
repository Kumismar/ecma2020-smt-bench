; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dl id=x tabindex=1 onactivate=alert(1)></dl>") (= x "<a onmouseover=""alert(document.cookie)"">xxs link</a>") (= x "<var ondblclick=""alert(1)"">test</var>")))
(assert (or (= z "id=""fuzzelement1"">test</a>") (= z "kbd>") (= z "/svg onLoad>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^(\d{5}(-\d{4})?|[A-Z]\d[A-Z] ?\d[A-Z]\d)$")) (not (= "zzelem" (str.substr y 51 6)))))
(assert (str.suffixof ">test</a>" y))
(assert (or (not (= (str.indexof y "us" 0) 9)) (not (= (str.at x 16) """")) (not (= "lert(1)" (str.substr x 32 7)))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{6,22}"))))
(assert (or (not (str.prefixof "<var" x)) (= (str.at y 57) "s")))
(assert (or (= "/svgnLoad>" (str.replace z " o" "")) (str.contains (str.replace z "t" "x") "enx1"">t")))
(check-sat)
