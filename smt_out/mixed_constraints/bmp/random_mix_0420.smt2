; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:\xE2\x80\x86expression(javascript:alert(1)"">DEF") (= x "<i id=x tabindex=1 onfocusin=alert(1)></i>")))
(assert (or (= z "=1 onfocus=alert(1)></a>") (= z "1)//'>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[\w-]+(\.[\w-]+)*@([a-z0-9-]+(\.[a-z0-9-]+)*?\.[a-z]{2,6}|(\d{1,3}\.){3}\d{1,3})(:\d{4})?$"))))
(assert (or (not (str.suffixof "lot>" z)) (not (= (str.indexof z """al" 0) 26)) (not (= (str.indexof y "x tab" 0) 6))))
(assert (or (= (str.len y) 66) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]*(\.[0-9]+)?$")))))
(assert (or (not (str.prefixof "ABC<div" y)) (not (str.suffixof "'>" y)) (str.contains (str.replace x "r" "") "img sc=""bl")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[7|8|9]\d{9}$"))) (= (str.indexof x "8" 0) 23)))
(check-sat)
