; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript id=x tabindex=1 ondeactivate=alert(1)></noscript><input id=y autofocus>") (= x "<dfn onkeypress=""alert(1)"" contenteditable>test</dfn>")))
(assert (or (= z "p onbeforepaste=""alert(1)"" contenteditable>test</sup>") (= z "</textarea>") (= z "nd=""alert(1)""></input>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace y "al" " ") "ss="" ert") (not (str.prefixof "<dfn o" y)) (str.prefixof "<dfn onkey" y)))
(assert (not (= "extare" (str.substr z 3 6))))
(assert (or (not (= (str.indexof x "ntedi" 0) 32)) (<= (str.len x) 56) (= (str.indexof x "deact" 0) 28)))
(assert (or (not (= "a>" (str.substr z 9 5))) (not (= "itabl" (str.substr z 36 5))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-z0-9-\u{f1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{d1}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}]+$")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*(.[a-z]{2,3})$"))))
(assert (str.contains (str.replace y "itabl" "x") "dxe>t"))
(check-sat)
