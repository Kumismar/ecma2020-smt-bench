; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=""/"" =_="" title=""onerror='prompt(1)'"">") (= x "<button oncontextme\u{1f600}n\u{1f600}u=""alert(1)"">test</button>") (= x "<script\x00>javascript:alert(1)</script>")))
(assert (or (= z "ble>test</frame>") (= z "r>") (= z "enteditable>drop here</wbr>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[_a-z0-9A-Z-]+(\.[_a-zA-Z0-9\+]+)*@[a-z0-9A-Z-]+(\.[a-zA-Z0-9-]+)*(\.[a-zA-Z]{2,})$")) (not (str.contains (str.replace x "p" "alert(1)") "='alert(1)rompt"))))
(assert (or (not (str.prefixof "<script> d" y)) (not (= (str.indexof y """ t" 0) 16))))
(assert (not (str.contains z "le")))
(assert (= (str.indexof x "le=" 0) 21))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z]{0,}")) (not (= (str.at x 29) "1")) (not (str.contains y "uteNa"))))
(assert (or (not (= (str.indexof z "r>" 0) 0)) (not (= "en" (str.substr z 0 2))) (not (= (str.len z) 27))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6,}$"))))
(check-sat)
