; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ScRi\u{20000}Pt>alert\u{1d400}(1)</sCriPt>") (= x "<meter draggable=""true"" ondragstart=""alert(1)"">test</meter>") (= x "<style>@keyframes x{}</style><colgroup style=""animation-name:x"" onanimationend=""alert(1)""></colgroup>")))
(assert (or (= z "st</div>") (= z ":color 1s"" ontransitionend=alert(1)></mark>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "st</div"))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[1]{1}[-]0?[0-9]{5,15}$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^\(?([0-9]{3})\)?[-.\u{25cf}]?([0-9]{3})[-.\u{25cf}]?([0-9]{4})$"))) (str.prefixof "st</div>" z)))
(assert (str.contains x "ragstart="""))
(assert (or (not (= (str.at x 16) "1")) (not (str.suffixof "YLE>;" y))))
(assert (or (str.suffixof "ark>" y) (not (= (str.indexof y "an" 0) 74))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z\u{e01}-\u{e5b}.,\-\s]+"))) (= (str.len z) 43)))
(assert (or (not (str.contains x "p st")) (not (= "able=""tr" (str.substr x 12 8)))))
(check-sat)
