; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input name\u{20000}=""password"" type=""password"" value=""secret"" />") (= x "<center onkeyup=""alert(1)"" contenteditable>test</center>")))
(assert (or (= z ">") (= z "edeactivate=alert(1)></em><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{4,20}$"))) (not (str.contains (str.replace x "edi" "<b>") "nt<b>tabl")) (= "word""" (str.substr x 18 5))))
(assert (= (str.indexof x " name" 0) 6))
(assert (str.contains x "pass"))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9._+-]{1,64}@(?=.{1,255}$)(?:[A-Za-z0-9-]+\.)*[A-Za-z0-9_+-]+$")) (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[a-zA-Z])(?=.*\d)[a-zA-Z\d\w\W]{8,64}$"))))
(assert (or (= (str.at z 35) "t") (= "alert(1)" (str.replace z ">" "alert(1)"))))
(check-sat)
