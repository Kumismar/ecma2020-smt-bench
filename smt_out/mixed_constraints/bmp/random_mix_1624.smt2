; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG SRC=JaVaScRiPt:alert(&apos;XSS&apos;)&gt;") (= x "<ins onbeforecopy=""alert(1)"" contenteditable>test</ins>")))
(assert (or (= z "ert(1)"">test</table>") (= z "ex=1 onbeforedeactivate=alert(1)></summary><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 6) "n")) (<= (str.len y) 99) (not (str.contains y "/summary"))))
(assert (str.suffixof "/ins>" x))
(assert (or (str.contains (str.replace y "ap" "") "t(&os;X") (>= (str.len z) 50)))
(assert (or (str.suffixof "ck>" x) (not (str.contains (str.replace z "dea" "") "forectiva")) (not (= (str.len x) 55))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[\sA-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]*$"))) (str.suffixof "oup>" z)))
(assert (not (= "(1)"" conte" (str.substr x 24 10))))
(assert (= (str.at x 15) "p"))
(check-sat)
