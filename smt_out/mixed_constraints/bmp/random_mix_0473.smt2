; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><code style=""animation-name:x"" onanimationstart=""alert(1)""></code>") (= x "<strike onmouseup=""alert(1)"">test</strike>")))
(assert (or (= z "ideo/poster/onerror=prompt(2)>""-confirm(3)-""") (= z "tyle><div style=""animation-name:x"" onanimationend=""alert(1)""></div>") (= z "v>")))
(assert (= y (str.++ x z)))
(assert (= "valert(1)" (str.replace z ">" "alert(1)")))
(assert (or (not (= "v>" (str.substr z 0 9))) (= (str.at z 0) "v")))
(assert (or (= (str.at y 79) "l") (not (str.in_re y ((_ re.from_regex ecma2020) "(?=.*[a-zA-Z]\s[0-9])[\.\w\s/-]{3,64}"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^([_A-z0-9\s]){2,}$")))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z]{5})+([0-9]{4})+([a-zA-Z]{1})$")))
(assert (= (str.at z 10) "r"))
(check-sat)
