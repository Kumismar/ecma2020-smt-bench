; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=""mocha:document.vulnerable=true;"">") (= x "<time id=x tabindex=1 ondeactivate=alert(1)></time><input id=y autofocus>") (= x "<img draggable=""true"" ondragleave\u{1d400}=""alert(1)"">test</img>")))
(assert (or (= z "ck=""alert(1)"">test</li>") (= z "ton onblur=alert(1) id=x></button><input autofocus>") (= z """alert(1)"">test</kbd>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<img " x) (str.contains (str.replace y "<" " ") " im")))
(assert (not (= (str.at y 45) "/")))
(assert (or (= "alert" (str.substr y 77 5)) (= "</blo" (str.substr x 107 5)) (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,5}$")))))
(assert (or (str.contains y "si") (str.suffixof "us>" x) (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{1,15}$"))))
(assert (= ":x onerr" (str.substr y 36 8)))
(check-sat)
