; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset onclick=""alert(1)"">test</frameset>") (= x "<dialog onmouseenter=""alert(1)"">test</dialog>") (= x "<!DOCTYPE doc [")))
(assert (or (= z " id=x></optgroup><input au\u{10348}tofocus>") (= z "\u{201d}%2b\u{201d}cript>alert(document.cookie)</script>") (= z "ntenteditable>test</pre>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "t" 0) 17))
(assert (str.suffixof "ialog>" x))
(assert (or (not (str.suffixof "\u{10348}tofocus>" z)) (not (<= (str.len y) 65))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]+[0-9]$"))) (= (str.at z 18) "<") (not (str.contains y "optgroup><"))))
(assert (or (not (= "<if""ame src=""http://example.com/"" style=""width:800px; height:350px; border:none; mask: url(#maskForClickjacking);""/>" (str.replace x "r" """"))) (not (str.contains z "ocument.")) (not (str.contains (str.replace x "e" """") "<fram""set"))))
(assert (or (str.prefixof "ntentedit" z) (not (= (str.at y 147) "r"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^(\d){3}(-)(\d){8}$"))))
(assert (not (str.contains (str.replace y "tedit" "<b>") "ten<b>abl")))
(check-sat)
