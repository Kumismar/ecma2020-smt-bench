; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<progress onkeyup=""alert(1)"" contenteditable>test</progress>") (= x "<br draggable=""true"" ondragstart=""alert(1)"">test</br>")))
(assert (or (= z "=x tabindex=1 onbeforedeactivate=alert(1)></font><input autofocus>") (= z "est</main>") (= z "t(1);</script>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "us>" z)) (= (str.at y 77) "a")))
(assert (or (not (= "ed>" (str.substr z 1 4))) (not (str.prefixof "<progre" y))))
(assert (str.suffixof ">" y))
(assert (or (= "<br draggable=""true"" ondragstart=""alert(1)"">test<alert(1)est</main>" (str.replace y "/br>" "alert(1)")) (str.in_re x ((_ re.from_regex ecma2020) "^[(A-Za-z  \u{e1}\u{e9}\u{ed}\u{f3}\u{fa}A\u{c9}\u{cd}\u{d3}\u{da}\u{d1}\u{f1})]{3,50}$"))))
(assert (not (= (str.indexof z "est</" 0) 0)))
(check-sat)
