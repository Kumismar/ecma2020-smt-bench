; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<shadow draggable=""true"" ondrag=""alert(1)"">test</shadow>") (= x "<cod\u{1f4a9}e ondblclick=""alert(1)"">test</co\u{1f4a9}de>") (= x "<element i\u{20000}d=x tabindex=1 onactivate=alert(1)></element>")))
(assert (or (= z "rt(1)></sup>") (= z "lert(1)"" contenteditable>test</base>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "nt>" x)))
(assert (not (= (str.indexof z "rt(" 0) 0)))
(assert (not (= (str.len y) 141)))
(assert (or (= ")></sup>" (str.substr z 4 10)) (not (= (str.indexof x """ale" 0) 18)) (str.suffixof "est</base>" y)))
(assert (or (= (str.len z) 12) (not (= (str.at x 48) "/"))))
(assert (= (str.indexof y "o" 0) 5))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(?=^.{8,20}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$"))) (not (<= (str.len y) 97))))
(check-sat)
