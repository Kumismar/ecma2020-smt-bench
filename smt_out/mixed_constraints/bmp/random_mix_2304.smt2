; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<x%0Donxxx=1") (= x "<script onkeyup=""alert(1)"" contenteditable>test</script>") (= x "<main onmouseup=""alert(1)"">test</main>")))
(assert (or (= z "t>") (= z "lert(1)"" contenteditable>test</rp>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "/img>" y))
(assert (str.prefixof "<wbr o" y))
(assert (not (str.contains x "us")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\([0-9]{3}\)[0-9]{3}-[0-9]{4}$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0]{1}|([0-9]{10})$")))))
(assert (or (not (= (str.indexof x "x" 0) 1)) (str.contains (str.replace z """ i" """") "(1)""d=""f")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) ".{0,20}")) (not (= (str.len y) 14))))
(check-sat)
