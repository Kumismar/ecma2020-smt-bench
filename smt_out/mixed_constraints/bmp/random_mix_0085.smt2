; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd onfocusout=alert(1) tabindex=1 id=x></dd><input autofocus>") (= x "<svg onload=""javascript:\u{10348}alert(123)"" xmlns=""#""></svg>")))
(assert (or (= z "l onclick=""alert(1)"">test</label>") (= z "nerror=alert(1) onload=/>") (= z ")></q>")))
(assert (= y (str.++ x z)))
(assert (or (= "ble>test</nd>" (str.replace z "oembe" "")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\-\+]{9,15}$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9 ]*$"))) (not (= "oc" (str.substr x 7 2))) (not (str.contains x "ntedit"))))
(assert (str.prefixof "<dd onf" y))
(assert (not (= (str.indexof y "able" 0) 10)))
(assert (or (not (str.suffixof "></style>" z)) (= (str.indexof y "r=ale" 0) 60)))
(assert (not (str.contains z "q>")))
(assert (= (str.at y 52) ">"))
(assert (or (= "<dd onfocusoutxalert(1) tabindex=1 id=x></dd><input autofocus>)></q>" (str.replace y "=" "x")) (not (str.in_re z ((_ re.from_regex ecma2020) ".{1,64}$"))) (= (str.len y) 86)))
(check-sat)
