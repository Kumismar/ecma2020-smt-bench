; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hgroup onmouseover=""alert(1)"">test</hgroup>") (= x "<del ondblclick=""alert(1)"">test</del>") (= x "<applet draggable=""true"" ondragleave=""alert(1)"">test</applet>")))
(assert (or (= z "ntenteditable>test</article>") (= z "e=""alert(1)"">test</dt>") (= z "3,83))"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<hgroup" x)) (<= (str.len x) 45) (not (= (str.at y 19) "e"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[^\d]{3,}"))) (not (str.prefixof "l" z)) (str.contains y "ondeacti")))
(assert (not (str.suffixof "3))"">" z)))
(assert (or (= (str.indexof x "1)" 0) 23) (not (str.contains x "pt""> alert"))))
(assert (or (= (str.indexof x "ra" 0) 9) (not (str.suffixof "up>" x))))
(assert (or (= (str.indexof z "3,83)" 0) 0) (= "=""alert(1" (str.substr x 19 9))))
(assert (or (not (= "b>" (str.substr z 2 3))) (<= (str.len x) 61)))
(check-sat)
