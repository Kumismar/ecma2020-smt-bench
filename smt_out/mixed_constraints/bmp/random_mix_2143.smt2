; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup onbeforecopy=""alert(1)"" contenteditable>test</colgroup>") (= x "<tr onmouseover=""alert(1)"">test</tr>")))
(assert (or (= z "alert(1)></dfn>") (= z "w3.org/1999/xlink"" xlink:href=""?"">") (= z """alert(1)"">test</listing>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "ouse")) (not (>= (str.len z) 9)) (str.contains z ">test</u")))
(assert (or (not (= "test</tr>w" (str.substr y 27 10))) (= "isting>" (str.substr y 83 9))))
(assert (or (not (= (str.indexof x " onm" 0) 3)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-2]{0,1}[0-9]{1}$")))))
(assert (or (not (= "te""fn>" (str.replace z "st</d" """"))) (not (= (str.indexof y "(1)""" 0) 22)) (not (str.suffixof "orm>" y))))
(assert (or (= (str.at x 9) " ") (not (str.contains (str.replace y "cont" "") ")"" e"))))
(check-sat)
