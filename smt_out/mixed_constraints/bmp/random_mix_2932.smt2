; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video onmousemove=""alert(1)"">test</video>") (= x "<;\u{1d400}FRAMESET>;<;FRAME SRC="";javascript:alert(';XSS';);"";>;<;/FRAMESET>;") (= x "<svg onmousedown=""alert(1)"">test</svg>")))
(assert (or (= z "g/src=` onerror=alert(1)> --!>") (= z "emove=""alert(1)"">test</kbd>") (= z " BACKGROUND=&quot;javascript:alert(&apos;XSS&apos;)&quot;&gt;&lt;/TD&gt;&lt;/TABLE&gt;")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "/kbd>" y) (= "vg onm" (str.substr x 2 6))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[-A-Za-z0-9_\u{e8}\u{e9}\u{f2}\u{e0}\u{f9} \s]*$"))) (not (str.prefixof "<v" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\d-]*$")))))
(assert (not (= "<;\u{1d400}FRAMESET>;<;FRAME Sjavascript:"";javascript:alert(';XSS';);"";>;<;/FRAMESET>;" (str.replace x "RC=" "javascript:"))))
(assert (or (str.suffixof "t;" y) (not (= "<;\u{1d400}FRAMESET>;<;FRAME SRC="";javascript:alert(';XSS';);""<;/FRAMESET>;" (str.replace x ";>;" "")))))
(assert (or (str.prefixof "<foo" y) (str.in_re z ((_ re.from_regex ecma2020) "^[\+]?[0-9]{0,3}[(]?[0-9]{0,5}[)]?[-\s\.]?[0-9]{3}[-\s\.]?[0-9]{0,6}$"))))
(assert (not (str.contains (str.replace y "dblc" "x") "p onxlick=")))
(check-sat)
