; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta onkeydown=""alert(1)"" contenteditable>test</meta>") (= x "<ol onmousedown=""alert(1)"">test</ol>") (= x "<marquee onblur=alert(1) tabindex=1 id=x></marquee><input autofocus>")))
(assert (or (= z "est</p>") (= z "t:alert(1)""></html onMouseOver>") (= z "eover=""alert(1)"">test</rt>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<marquee o" x) (not (= (str.indexof z "ve" 0) 2))))
(assert (or (= (str.len z) 7) (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+.[A-Za-z]{1,63}$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-zA-Z]).{6,}"))) (= (str.at y 91) "u")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z]{1,}[A-Za-z0-9@#%&* ]*$"))) (>= (str.len x) 34)))
(check-sat)
