; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav draggable=""true"" ondragend=""alert(1)"">test</nav>") (= x "<marquee width=1 loop=1 onfinish=alert(1)>XSS</marquee>") (= x "xss:ex/*XSS*//*/*/pression(alert(""XSS""))'>")))
(assert (or (= z "tyle=""transition:color 1s"" ontransitionend=alert(1)></source>") (= z "cript:alert(1);></embed>") (= z "ransitioncancel=alert(1)></abbr>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "\.(pdf|doc|docx)$"))) (= (str.indexof z "docum" 0) 0)))
(assert (or (not (str.prefixof "ransiti" z)) (>= (str.len y) 72)))
(assert (or (= (str.at x 16) "*") (not (str.contains z "ransitio")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z-\u{f1}\u{d1}\u{e1}\u{e9}\u{f3}\u{ed}\u{fa}\u{c1}\u{c9}\u{d3}\u{cd}\u{da} ]{1,60}$")))))
(assert (or (not (str.prefixof "tyle=""tra" z)) (str.in_re x ((_ re.from_regex ecma2020) "^[a-z0-9]+([._\\-]*[a-z0-9])*@([a-z0-9]+[-a-z0-9]*[a-z0-9]+.){1,63}[a-z0-9]+$")) (<= (str.len x) 60)))
(assert (= "cript:alert(1);><xmbed>" (str.replace z "/e" "x")))
(check-sat)
