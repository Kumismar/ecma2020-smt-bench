; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rt onclick=""alert(1)"">test</rt>") (= x "<style>:target {color:red;}</style><rt id=x style=""transition:color 1s"" ontransitionend=alert(1)></rt>") (= x "<head onmouseout=""alert(1)"">test</head>")))
(assert (or (= z "t(1)"">test</dl>") (= z "1)"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<rt on" x)) (str.prefixof "<head " y)))
(assert (or (not (= ")"">" (str.substr z 1 7))) (not (= (str.at x 25) ")")) (not (= (str.indexof z "t(1)" 0) 0))))
(assert (or (not (str.contains (str.replace z ")" "") "1"">")) (not (= (str.at y 49) "X"))))
(assert (or (not (str.prefixof "t(1)"">t" z)) (str.suffixof "on>" x) (not (= """>test</dl" (str.substr z 4 10)))))
(assert (or (not (str.contains (str.replace z ")"">t" "") "(1est</")) (not (= (str.indexof z "ar" 0) 6))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(12)$"))))
(check-sat)
