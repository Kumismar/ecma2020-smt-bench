; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><colgroup style=""animation-name:x"" onanimationend=""alert(1)""></colgroup>") (= x "<address id=x tabindex=1 onactivate=alert(1)></address>") (= x "<spacer id=x tabindex=1 ondeactivate=alert(1)></spacer><input id=y autofocus>")))
(assert (or (= z "<meter onload=alert(1)></meter>") (= z " id=x tabindex=1 onbeforeactivate=alert(1)><\u{1f4a9}\u{10348}/acronym>") (= z "1)>")))
(assert (= y (str.++ x z)))
(assert (not (= "vat" (str.substr x 31 3))))
(assert (= (str.indexof z "on" 0) 7))
(assert (or (str.contains (str.replace x "n" """") "=""a""imat") (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6,}"))) (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[^\d]+[\sa-z\sA-Z\s]"))))
(assert (or (not (= (str.indexof x "(" 0) 62)) (str.prefixof "<" y) (not (= (str.indexof z "(1" 0) 39))))
(assert (or (not (str.suffixof "/acronym>" y)) (not (str.suffixof "r>" z))))
(assert (not (str.contains y "x"" ona")))
(assert (or (= (str.at x 55) "-") (str.contains z "ert(1)"">")))
(check-sat)
