; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<caption onkeydown=""alert(1)"" contenteditable>test</caption>") (= x "<sup onbeforecopy=""alert(1)"" contenteditable>test</sup>")))
(assert (or (= z ">\x0Cjavascript:alert(1)</script>") (= z "t</rp>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 11) "r")) (= "<caption onkeydown=""alert(1)"" contenteditable>test</capjavascript:>\x0Cjavascript:alert(1)</script>" (str.replace y "tion>" "javascript:")) (not (= "t</rp>" (str.substr z 0 9)))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9 ]{4,8}")))
(assert (or (not (str.contains y "=""alert(")) (str.prefixof "<su" y)))
(assert (not (str.contains y "/caption>t")))
(assert (or (not (= "pt>" (str.substr z 30 5))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{3,}"))) (not (str.suffixof "</b>" z))))
(assert (or (str.prefixof "<su" x) (<= (str.len y) 81)))
(check-sat)
