; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<keygen onbeforecut=""alert(1)"" contentedita\u{20000}ble>test</keygen>") (= x "<embed onbeforepaste=""alert(1)"" contenteditable>test</embed>") (= x """><img src=x onerror=javascript:alert(A)>")))
(assert (or (= z "g=""alert(1)"">test</col>") (= z "1)"">test</footer>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "er" 0) 14) (not (= "ndex=1" (str.substr x 19 6)))))
(assert (or (= (str.indexof x "conte" 0) 32) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Z]{2}$"))) (not (>= (str.len y) 69))))
(assert (not (<= (str.len x) 60)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{3}-\d{7}-\d{7})$"))) (not (str.contains z "te"))))
(assert (not (= (str.len y) 77)))
(assert (or (not (str.contains y "gh=""aler")) (str.suffixof "r>" z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{6,}")) (not (str.prefixof """" x))))
(check-sat)
