; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgs\u{1f600}ound id=x tabindex=1 onbeforeactivate=alert(1)></bgsound>") (= x "</style &#32;><script &#32; :-(>/**/alert(document.location)/**/</script &#32; :-(") (= x "<? foo=""><x foo='?><script>javascript:alert(1)</script>'>"">")))
(assert (or (= z "ert(1)></button>") (= z "adow>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof """>" x)) (str.suffixof "/colgroup>" z)))
(assert (or (str.contains z "ado") (not (str.in_re x ((_ re.from_regex ecma2020) "^[\u{30a2}-\u{30f3}\u{309b}\u{309c}\u{30a1}-\u{30a9}\u{30e3}-\u{30e7}\u{30fc}\u{300c}\u{300d}\u{3001}]+$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w\W]{1,4}$"))) (not (= "</style &#32;><script &#32; :-(>/* alert(document.location)/**/</script &#32; :-(" (str.replace x "*/" " ")))))
(assert (or (not (= "yle>" (str.substr x 3 4))) (= (str.at y 34) "i")))
(check-sat)
