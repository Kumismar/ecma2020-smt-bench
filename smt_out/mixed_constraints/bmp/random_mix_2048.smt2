; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<td oncopy=""alert(1)"" contenteditable>test</td>") (= x "<style>.XSS{background-image:url(""javascript:document.vulnerable=true"");}</STYLE><A CLASS=XSS></a>")))
(assert (or (= z " tabindex=1 onf\u{1f4a9}ocusin=alert(1)></dfn>") (= z ";alert('XSS')\""&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "ble" 0) 61)) (not (= (str.len x) 98)) (not (= (str.indexof y "d> t" 0) 45))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[_\.0-9a-zA-Z'+-]+@([0-9a-zA-Z][0-9a-zA-Z-]+\.)+[a-zA-Z]{2,6}$"))))
(assert (or (not (str.contains (str.replace y "t" "javascript:") "<sjavascript:y")) (= (str.at z 6) ")")))
(assert (not (str.suffixof "/td>" x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[\w\s-]*$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[1-9]{1,3}"))))
(assert (or (str.contains y " CLASS=XSS") (str.suffixof "(1)></dfn>" z)))
(assert (or (= "t(1) co" (str.substr y 96 7)) (not (str.suffixof "t</spacer>" z))))
(check-sat)
