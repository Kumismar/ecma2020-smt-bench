; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot onkeydown=""alert(1)"" contenteditable>test</tfoot>") (= x "<ul draggable=""true"" ondragend=""alert(1)"">test</ul>")))
(assert (or (= z "=image onload=alert(1) src=validimage.png>") (= z "foo=""><script>javascript:alert(1)</script>"">")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "tfoot" 0) 1)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9_]{2,18}$"))) (str.contains x "1)"">test<")))
(assert (or (str.suffixof "ot>" x) (= ">" (str.substr z 27 1))))
(assert (or (not (str.contains x "enter=""ale")) (not (str.prefixof "=image onl" z)) (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{3,6}"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0+]{1}[0-9 ]{6,15}"))) (>= (str.len z) 39) (= "<template draggable=""true"" o dragenter=""alert(1)"">test</template>alert(1)></applet>" (str.replace y "n" " "))))
(assert (or (not (str.contains z "tofocus>")) (not (str.prefixof "ented" z)) (not (= "(1)"">tes" (str.substr x 37 8)))))
(check-sat)
