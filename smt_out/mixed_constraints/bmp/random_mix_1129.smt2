; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tr id=x tabindex=1 ondeactivate=alert(1)></tr><input id=y autofocus>") (= x "<ul onkeydown=""alert(1)"" contenteditable>test</ul>")))
(assert (or (= z "\"";") (= z "alert(1)"">test</del>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "1)")) (not (str.contains (str.replace y "</d" "alert(1)") "estalert(1)el>"))))
(assert (= (str.len z) 36))
(assert (or (not (= (str.indexof z "\" 0) 0)) (not (str.prefixof "<tr " y))))
(assert (not (= "xert(1)"">test</del>" (str.replace z "al" "x"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[\w\.]+@[a-zA-Z_]+\.[a-zA-Z]{1,4}$")) (not (str.prefixof "XSS')"");}" z)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{11,13}$")))))
(assert (not (= "own=""alert" (str.substr x 10 10))))
(check-sat)
