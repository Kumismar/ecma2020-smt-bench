; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""javas\x01cript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<b onblur=alert(1) tabindex=1 id=x></b><input autofocus>")))
(assert (or (= z "le=""true"" contenteditable>drag me</div><font ondragover=alert(1) contenteditable>drop here</font>") (= z ")"">test</strike>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "nt1"">")) (not (>= (str.len x) 63))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{406}\u{456}\u{407}\u{457}\u{404}\u{454}\s]+$"))))
(assert (or (= (str.indexof z """>te" 0) 1) (str.contains x "1)"" id")))
(assert (or (not (= "onten" (str.substr z 66 5))) (not (= "tedit" (str.substr y 82 5)))))
(assert (str.prefixof "le" z))
(check-sat)
