; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><th onload=alert(1)\u{1d400}></th>") (= x "#""><img src=M onerror=alert('XSS');>") (= x "<menu id=x tabindex=1 onactivate=alert(1)></menu>")))
(assert (or (= z "x03javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= z "onkeydown=""alert(1)"" contenteditable>test</footer>") (= z "onbeforeactivate=alert(1)></div>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[\d\-( )]+$")) (not (= "x03javascript:javascript:javascript:ert(1)"" id=""fuzzelement1"">test</a>" (str.replace z "al" "javascript:")))))
(assert (not (= "tedi" (str.substr z 27 4))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[\u{5c}u0600-\u{5c}u06FF\u{623}-\u{64a}a-z A-Z]*$")) (not (str.prefixof "<m" x)) (str.prefixof "<s" y)))
(assert (str.contains y "est</em>"))
(assert (or (not (= "op h" (str.substr y 97 4))) (not (str.in_re y ((_ re.from_regex ecma2020) "(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9]).{8,}")))))
(assert (= (str.len y) 81))
(assert (or (= (str.at x 8) "s") (= (str.len x) 31)))
(check-sat)
