; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr onbeforepaste=""alert(1)"" contenteditable>test</abbr>") (= x "ABC<div style=""x:\x0Aexpression(javascript:alert(1)"">DEF")))
(assert (or (= z "tivate=alert(1)></dt><input autofocus>") (= z "></wbr>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\d{1,3})(,\d{3})*(\.\d{1,2})?$"))) (not (str.prefixof "<abb" y)) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-z0-9._%+-]+@[A-z0-9.-]+\.[A-z]{2,4}$")))))
(assert (or (= (str.indexof y "<" 0) 3) (str.contains (str.replace x "ion(" "x") "ressxjava") (not (<= (str.len z) 11))))
(assert (or (not (str.contains (str.replace x "iv " "javascript:") "djavascript:styl")) (= "alert(1)"">" (str.substr x 43 10))))
(assert (= (str.at z 28) "i"))
(check-sat)
