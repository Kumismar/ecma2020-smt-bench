; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot onmousedown=""alert(1)"">test</tfoot>") (= x "<style>@keyframes x{}</style><th style=""animation-name:x"" onanimationend=""alert(1)""></th>")))
(assert (or (= z ">") (= z "ert(1)"">test</footer>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([\D]{3,17}\s[\D]{2,33})$"))) (= "th style=" (str.substr x 30 9)) (= "wn=" (str.substr x 16 3))))
(assert (or (not (str.suffixof ">" z)) (= """" (str.replace z ">" """")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{1,4}(\.[0-9]{1,2}?)?")))))
(assert (<= (str.len x) 129))
(assert (or (not (str.prefixof "<style>@k" y)) (not (= (str.indexof x """>" 0) 82)) (<= (str.len x) 42)))
(check-sat)
