; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist onmouseover=""alert(1)"">test</datalist>") (= x "<code onclick=""alert(1)"">test</code>")))
(assert (or (= z "\u{10348}trans\u{1f4a9}itioncancel=alert(1)></strike>") (= z "rt(1)"">test</tt>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "test</tt>" z))
(assert (or (str.prefixof "rt(1)"">tes" z) (not (= (str.len z) 16)) (str.prefixof "<code o" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "ES[0-9]{2}")) (= "de>" (str.substr x 33 6)) (not (= (str.indexof y "ns\u{1f4a9}i" 0) 52))))
(assert (or (not (= "<datalisjavascript:ouseover=""alert(1)"">test</datalist>" (str.replace x "t onm" "javascript:"))) (str.contains x "e on") (= "<code onclick=""alert(1)"">test</codjavascript:\u{10348}trans\u{1f4a9}itioncancel=alert(1)></strike>" (str.replace y "e>" "javascript:"))))
(assert (or (not (= (str.indexof z "></s" 0) 27)) (str.contains x ">test</")))
(assert (not (str.contains z "ans\u{1f4a9}i")))
(check-sat)
