; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base onkeyup=""alert(1)"" c\u{1f4a9}ontenteditable>test</base>") (= x "<dfn onmouseleave=""alert(1)"">test</dfn>") (= x "\u{1f600}<b\u{10348}r>")))
(assert (or (= z ":target {color: red;}</style><tfoot id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tfoot>") (= z "41;")))
(assert (= y (str.++ x z)))
(assert (not (= "er" (str.substr z 91 2))))
(assert (not (= (str.indexof y "\u{1f600}<" 0) 0)))
(assert (str.suffixof ">" x))
(assert (or (not (str.suffixof "b\u{10348}r>" x)) (not (= "de " (str.substr y 3 3)))))
(assert (or (str.contains (str.replace z "41" "<b>") "<b>;") (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.\s]{1,80}$"))) (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.'!#$%&*+\/=?^{|}~_-]+(\.[a-zA-Z0-9.'!#$%&*+\/=?^{|}~_-]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*(\.[a-zA-Z]{2,4})"))))
(assert (or (= (str.indexof x "onmo" 0) 5) (not (str.contains (str.replace y "\u{1f600}<b\u{10348}" "javascript:") "javascript:r>"))))
(check-sat)
