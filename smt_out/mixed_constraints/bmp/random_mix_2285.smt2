; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><head ondrop=alert(1) contenteditable>drop here</head>") (= x "<p oncopy=""alert(1)"" contenteditable>test</p>")))
(assert (or (= z "</link>") (= z "est</menuitem>") (= z "t</a>")))
(assert (= y (str.++ x z)))
(assert (not (= "k>" (str.substr z 5 8))))
(assert (= (str.indexof x "/p" 0) 27))
(assert (or (str.prefixof "t<" z) (str.in_re x ((_ re.from_regex ecma2020) "[0-9+]*$")) (str.contains x "it")))
(assert (str.contains y "e=""t"))
(assert (or (not (= (str.indexof y "t</a>" 0) 45)) (not (str.contains y "t:alert"))))
(assert (or (str.prefixof "est</me" z) (not (= "t" (str.substr x 40 1)))))
(check-sat)
