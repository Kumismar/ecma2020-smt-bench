; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><bdi id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></bdi>") (= x "<img ondblclic\u{10348}k=""alert(1)"">test</\u{20000}img>") (= x "<dt oncontextmenu=""alert(1)"">test</dt>")))
(assert (or (= z "sin=alert(1)></q>") (= z "nResize=""javascript:javascript:alert(1)""></body onResize>") (= z "table>test</kbd>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "sin=aler" z) (not (str.prefixof "tabl" z)) (= (str.at x 31) "s")))
(assert (not (= (str.at x 1) "d")))
(assert (or (= "<bdi" (str.substr x 36 4)) (not (str.suffixof "/dl></tr>" y)) (not (str.in_re y ((_ re.from_regex ecma2020) "(?=.*\d).{6,20}")))))
(assert (not (= (str.indexof z "t(1)>" 0) 8)))
(assert (or (not (= (str.indexof z "n=al" 0) 2)) (= "tioncanc" (str.substr y 83 8))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w\-\.]+@[\w\-\.]+(\.\w+)+$"))))
(check-sat)
