; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<area id=x tabindex=1 onbeforeactivate=alert(1)></area>") (= x "navigator.vibrate(500)")))
(assert (or (= z ">") (= z "d=""alert(1)""></th>") (= z "oad=&lt;!--&#09;&gt;&#10;alert&#10;&lpar;1&rpar;>")))
(assert (= y (str.++ x z)))
(assert (or (= "<xid=x tabindex=1 onbeforeactivate=alert(1)></area>" (str.replace x "area " "x")) (= "s" (str.substr z 0 1))))
(assert (or (str.suffixof "500)" x) (not (= (str.at x 4) "a"))))
(assert (or (not (= (str.at x 26) "l")) (not (= (str.indexof z ";!" 0) 7))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[\u{30a1}-\u{30f3}|\u{3000}| |\u{30fc}]+$")))
(assert (or (not (= "h>" (str.substr z 16 7))) (= (str.at x 26) "f") (<= (str.len x) 45)))
(assert (>= (str.len y) 97))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^((?!\.)[\w\-_.]*[^.])(@\w+)(\.\w+(\.\w+)?[^.\W])$")) (= "ea id=x t" (str.substr x 3 9)) (not (str.suffixof "te(500)" x))))
(check-sat)
