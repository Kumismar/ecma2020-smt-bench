; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<progress onmouseout=""alert(1)"">test</progress>") (= x "<style>:target {color:red;}</style><a id=x style=""transition:color 1s"" ontransitionend=alert(1)></a>") (= x "<div id=""116""><div id=""x"">x</div>")))
(assert (or (= z "nt1"">\u{10348}test</a>") (= z "vate=alert(1)></listing><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]{6,30}$")) (not (= (str.at y 39) "d")) (not (<= (str.len z) 71))))
(assert (not (= "</div>v" (str.substr y 27 7))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^1[0-9]{10}$"))) (str.suffixof ">\u{10348}test</a>" y)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[0][3|5|7|8|9]\d{8}$")))
(assert (or (not (str.contains z "est</")) (str.prefixof "<" y)))
(assert (or (not (str.prefixof "<p" y)) (not (str.suffixof "a>" z))))
(check-sat)
