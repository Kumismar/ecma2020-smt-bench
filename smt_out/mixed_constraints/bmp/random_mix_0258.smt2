; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd onkeypress=""alert(1)"" contenteditable>test</kbd>") (= x "<mark oncut=""alert(1)"" contenteditable>test</mark>")))
(assert (or (= z "ript>") (= z "nteditable>test</bdi>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "d>ript>" y))
(assert (or (= (str.at y 0) "<") (str.suffixof "k>ript>" y)))
(assert (or (not (str.contains z "ip")) (not (str.in_re z ((_ re.from_regex ecma2020) "^(?:19|20)[0-9]{2}$")))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "([0-1][0-9]|2[0-3]):([0-5][0-9])"))) (= (str.at z 1) "i") (= "rt(1)"" co" (str.substr y 16 9))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^\+?\d{6,16}")) (not (str.contains x "ble>")) (str.contains z "rip")))
(assert (not (= "pt>" (str.substr z 2 8))))
(assert (not (<= (str.len y) 80)))
(assert (or (str.suffixof "/mark>" x) (not (>= (str.len x) 46))))
(check-sat)
