; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select draggable=""true"" ondragstart=""alert(1)"">test</select>") (= x "<html onmouseenter=""alert(1)"">test</html>") (= x "<style>:target {color:red;}</style><datalist id=x style=""transition:color 1s"" ontransitionend=alert(1)></datalist>")))
(assert (or (= z "ipt>javascript:alert(1)</script -->") (= z "script:alert(1)</script>") (= z "></a>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len y) 88)))
(assert (= (str.indexof y "scr" 0) 41))
(assert (= (str.indexof y "nen" 0) 89))
(assert (or (not (= (str.indexof y "lat\u{1f4a9}e" 0) 89)) (not (str.prefixof "<style>:t" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{8,10}$")))))
(assert (or (str.contains (str.replace y "olo" "") "cr:") (not (str.contains z "></a"))))
(assert (or (str.contains y "d=") (not (str.in_re x ((_ re.from_regex ecma2020) "^[+]?\d?[ .-]?[(]?\d{3}[)]?[ .-]?\d{3}[ .-]?\d{4}$")))))
(assert (or (str.contains z "(1)><") (>= (str.len x) 52) (not (str.suffixof "t -->" z))))
(assert (str.suffixof "us>" x))
(check-sat)
