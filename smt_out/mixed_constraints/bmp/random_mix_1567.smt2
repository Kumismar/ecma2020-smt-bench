; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body\u{10348} ONLOAD=document.vulnerable=true;>") (= x "<meta content=""&NewLine; 1 &NewLine;; JAVASCRIPT&colon; alert(1)"" http-equiv=""refresh""/>")))
(assert (or (= z "(1)"">test</time>") (= z "ate=alert(1)></html><input id=y autofocus>") (= z "ousemove=""alert(1)"">test</address>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 28) "d") (not (= (str.indexof x "dy\u{10348} O" 0) 3))))
(assert (or (str.contains (str.replace y "=""al" " ") "ove ert") (str.in_re y ((_ re.from_regex ecma2020) "^\+?(?:\(?[0-9]\)?( |-)?){6,14}[0-9]$"))))
(assert (not (str.prefixof "ate=alert" z)))
(assert (or (= "D=do" (str.substr x 12 4)) (not (= (str.at y 69) "r"))))
(assert (str.contains (str.replace x "ol" " ") "IPT&c on; a"))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "(([A-Za-z0-9](([_.-]?[a-zA-Z0-9]+)*)@([A-Za-z0-9]+)(([_.-]?[a-zA-Z0-9]+)*).([A-Za-z]{2,}))|(^0[1-7][0-9]{8}$))")) (not (= (str.indexof y "<" 0) 0)) (not (= (str.indexof z "rt(" 0) 7))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(([^<>()\[\]\\.,;:\s@""]+(\.[^<>()\[\]\\.,;:\s@""]+)*)|("".+""))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$"))) (= "true;>a" (str.substr y 34 7)) (= "le=true" (str.substr x 31 7))))
(assert (= (str.at z 0) "a"))
(check-sat)
