; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<body id=x tabindex=1 onbeforeactivate=alert(1)></body>") (= x "*{color:red}</style>//[\u{1f600}""'`-->]]\u{1d400}>]</div>")))
(assert (or (= z "id=x tabindex=1 onfocusin=alert(1)></listing>") (= z "nd onmouseout=""alert(1)"">test</legend>") (= z "del id=x tabindex=1 onfocus=alert(1)></del>")))
(assert (= y (str.++ x z)))
(assert (= "id=x tabindexalert(1)focusin=alert(1)></listing>" (str.replace z "=1 on" "alert(1)")))
(assert (not (str.suffixof ")></del>" y)))
(assert (or (str.contains z """>test") (not (str.contains (str.replace z "st" """") "te""</leg")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{17}$")))))
(assert (or (str.contains y ")></del") (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{2}\.[0-9]{2}\.[0-9]{4} [0-9]{2}:[0-9]{2}$")))))
(assert (or (str.contains (str.replace x "]]\u{1d400}>]" """") "->""<") (>= (str.len x) 37) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z\u{415}\u{4b9}\u{413}\u{458}\u{413}\u{b6}\u{414}\u{4b1}\u{414}\u{4b9}\u{413}\u{a7}\u{415}\u{4bb}\u{413}\u{4a3}\u{413}\u{2013}\u{414}\u{b0}\u{414}\u{4bb}\u{413}\u{4ae}0-9-_\.]{1,15}$"))))
(assert (or (<= (str.len y) 95) (str.prefixof "*{co" y) (not (>= (str.len y) 88))))
(assert (or (not (= (str.at x 21) "/")) (not (= "/styl" (str.substr x 13 5)))))
(check-sat)
