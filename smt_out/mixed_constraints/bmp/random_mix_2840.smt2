; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><pre ondrop=alert(1) contenteditable>drop here</pre>") (= x "<style>@keyframes x{}</style><noframes style=""animation-name:x"" onanimationstart=""alert(1)""></noframes>") (= x "<kbd onblur=alert(1) tabindex=1 id=x></kbd><input autofocus>")))
(assert (or (= z "keypress=""aler\u{1f600}t(\u{1d400}1)"" contenteditable>test</option>") (= z "ed;';"">LOL")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(([gG][iI][rR] {0,}0[aA]{2})|((([a-pr-uwyzA-PR-UWYZ][a-hk-yA-HK-Y]?[0-9][0-9]?)|(([a-pr-uwyzA-PR-UWYZ][0-9][a-hjkstuwA-HJKSTUW])|([a-pr-uwyzA-PR-UWYZ][a-hk-yA-HK-Y][0-9][abehmnprv-yABEHMNPRV-Y]))) [0-9][abd-hjlnp-uw-zABD-HJLNP-UW-Z]{2}))$"))))
(assert (str.prefixof "k" z))
(assert (or (not (str.prefixof "<" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.,\s]*$"))) (= "keyprexs=""aler\u{1f600}t(\u{1d400}1)"" contenteditable>test</option>" (str.replace z "s" "x"))))
(assert (str.suffixof "ption>" z))
(assert (or (not (str.suffixof "LOL" y)) (not (= (str.at z 2) ";"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^AX\d{3,7}|AI\d{3,7}$"))))
(check-sat)
