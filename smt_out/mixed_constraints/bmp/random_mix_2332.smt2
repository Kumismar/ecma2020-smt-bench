; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<picture draggable=""true"" ondragleave=""alert(1)"">test</picture>") (= x "<blink id=x tabindex=1 onfocus=alert(1)></blink>")))
(assert (or (= z "t=""alert(1)"" contenteditable>test</applet>") (= z "index=1 onbeforeactivate=alert(1)></kbd>") (= z "FRAME SRC=""javascript:alert('XSS');""></IFRAME>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "focus=")) (not (= (str.at z 39) "e")) (not (= (str.at y 78) "d"))))
(assert (or (= (str.indexof z """ale" 0) 2) (not (str.in_re x ((_ re.from_regex ecma2020) "(?=^.{0,40}$)^\+?(\d[\d\-\.\s]+)?(\([\d\-\.\s]+\))?[\d\-\.\s]+\d$"))) (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,9}$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^1((3|5|8){1}\d{1}|70)\d{8}$"))) (= (str.indexof y "vate" 0) 83)))
(assert (not (str.contains x "=alert(")))
(assert (not (= "<citx onkeypress=""alert(1)"" contenteditable>test</cite>1 onfocus=alert(1)></code>" (str.replace y "e" "x"))))
(assert (or (= (str.at x 3) "i") (= "d" (str.substr z 2 1)) (str.suffixof "RAME>" y)))
(assert (str.suffixof "submit>" y))
(assert (not (str.contains z "RAME S")))
(check-sat)
