; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script src=""\\%(jscript)s""></script>") (= x "<time oncut=""alert(1)"" contenteditable>test</time>")))
(assert (or (= z "rue"" ondragenter=""alert(1)"">test</command>") (= z "set>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) ".{3,25}"))) (not (str.in_re x ((_ re.from_regex ecma2020) "([1-9]|[1-9][0-9])$")))))
(assert (or (= "<javascript:cript src=""\\%(jscript)s""></script>" (str.replace x "s" "javascript:")) (not (str.suffixof "set>" y)) (not (= (str.indexof x "ipt" 0) 4))))
(assert (str.prefixof "<s" y))
(assert (not (<= (str.len z) 52)))
(assert (not (= (str.len y) 79)))
(assert (or (not (= "<time oncut=""alertalert(1)"" contenteditable>test</time>" (str.replace x "(1)" "alert(1)"))) (str.contains y "t<") (not (= (str.indexof y "n " 0) 4))))
(assert (or (not (= (str.indexof y "o" 0) 6)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{7,15}$"))) (str.prefixof "<script" x)))
(assert (not (>= (str.len y) 153)))
(check-sat)
