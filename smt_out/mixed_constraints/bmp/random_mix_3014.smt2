; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr onmouseout=""alert(1)"">test</abbr>") (= x "<image onpaste=""alert(1)"" contenteditable>test</image>") (= x "&#34;&#62;<h1/onmouseover='\u{5c}u0061lert(1)'>")))
(assert (or (= z "t {color:red;}</style><iframe id=x style\u{10348}=""transit\u{10348}ion:color 1s"" ontransitionend=alert(1)></iframe>") (= z "/script>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "\d+ \d+ \d+ \d+"))) (str.suffixof "st</image>" x)))
(assert (or (not (= (str.at x 24) """")) (not (= "<div draggable=""true"" contenteditable>drag me</d""<title ondragover=alert(1) contenteditable>drop here</title>" (str.replace x "iv>" """"))) (not (str.in_re x ((_ re.from_regex ecma2020) "[#0-9A-Z\u{c1}\u{c9}\u{cd}\u{d3}\u{da}a-z\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}-]{1,30}")))))
(assert (or (not (str.contains x """alert(1)")) (= (str.at y 100) "n") (not (= (str.len y) 62))))
(assert (or (= (str.len y) 138) (= "lert(1" (str.substr z 82 6))))
(assert (or (= (str.indexof z "ed" 0) 10) (not (str.prefixof "<style>:ta" y))))
(assert (not (str.prefixof "<abbr" x)))
(check-sat)
