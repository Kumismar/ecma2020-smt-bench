; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><keygen onload=alert(1)></keygen>") (= x "<body onresize=""alert(1)"">") (= x "&lt;STYLE TYPE=\""text/javascript\""&gt;alert('XSS');&lt;/STYLE&gt;")))
(assert (or (= z "=""alert(1)"" contenteditable>test</li>") (= z ")"" contenteditable>test</optgroup>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "le>t") (not (= (str.at z 0) ")")) (not (= (str.at x 24) """"))))
(assert (>= (str.len x) 23))
(assert (or (not (= (str.indexof y "h1>&P" 0) 94)) (not (= "lo" (str.substr y 15 2))) (not (str.suffixof "roup>" z))))
(assert (or (str.suffixof "/li>" z) (= (str.at x 37) ">")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "\S{5,20}"))) (str.suffixof "t</li>" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z ]{2,250}$"))) (not (= (str.indexof y "=aler" 0) 19))))
(check-sat)
