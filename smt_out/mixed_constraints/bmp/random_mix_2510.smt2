; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<?xml version=""1.0""?><html:html xmlns:html='http://www.w3.org/1999/xhtml'><html:script>javascript:alert(1);</html:script></html:html>") (= x "<!--[if gte IE 4]><SCRIPT>javascript:alert(1);</SCRIPT><![endif]-->")))
(assert (or (= z "c;") (= z "st</small>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (= ";" (str.substr z 1 3)) (str.in_re y ((_ re.from_regex ecma2020) "^[CEPcep]-\d{6}-[AaBbCc]\d{3}$")) (>= (str.len z) 8)))
(assert (or (str.contains (str.replace y "ers" "x") "ml vxio") (not (= (str.at x 29) "r")) (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_-])+@([a-zA-Z0-9_-])+(.[a-zA-Z0-9_-])+")))))
(assert (or (= "alert(1)" (str.replace z "c;" "alert(1)")) (not (str.suffixof ">" z))))
(assert (not (str.contains y "if gte IE")))
(assert (or (>= (str.len z) 1) (not (= (str.indexof z ">" 0) 0)) (not (>= (str.len y) 76))))
(assert (not (= (str.indexof z "test" 0) 15)))
(assert (not (str.suffixof "dif]-->" x)))
(check-sat)
