; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noframes onblur=alert(1) tabindex=1 id=x></noframes><input autofocus>") (= x "'';!--\""&lt;XSS&gt;=&{()}") (= x "<sCrIpt/""<a""/srC=data:="".<a,[8].some(confirm)>")))
(assert (or (= z "tyle>") (= z "=x></strike><input autofocus>") (= z "=alert(1)></bgsound>")))
(assert (= y (str.++ x z)))
(assert (or (= "rC=data:=" (str.substr x 14 9)) (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{3,25}$"))))
(assert (or (not (>= (str.len z) 17)) (not (= (str.indexof y "ame" 0) 5)) (not (str.in_re y ((_ re.from_regex ecma2020) "^\s*([A-Za-z0-9]+[-_.]{0,})+([A-Za-z0-9]+[-_.]{0,})*@([A-Za-z0-9]+([-_.]{0,})+)+[A-Za-z0-9]+\s*$")))))
(assert (not (str.prefixof "<nof" x)))
(assert (or (not (= (str.indexof y ") tab" 0) 24)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[^\s*]([a-zA-Z\u{f1}\u{d1}\u{c0}-\u{ff}0-9.,\s]+){0,500}$")))))
(assert (or (= ":="".<a," (str.substr y 21 7)) (= "utof" (str.substr y 66 4))))
(check-sat)
