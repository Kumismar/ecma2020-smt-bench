; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onbeforecut=""alert(1)"" contenteditable>test</dfn>") (= x "<track onbeforecut=""alert(1)"" contenteditable>test</track>") (= x "<style>:target {color:red;}</style><picture id=x style=""transition:color 1s"" ontransitionend=alert(1)></picture>")))
(assert (or (= z "\u{201d}javascript:alert(\u{2018}XSS\u{2019})\u{201d}") (= z ";"";>;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "pacer")) (str.contains (str.replace y "aler" "javascript:") "ut=""javascript:t") (not (str.prefixof ";" z))))
(assert (not (<= (str.len y) 82)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\s*[a-zA-Z,\u{e7},\u{c7},\u{11f},\u{11e},\u{131},\u{130},\u{f6},\u{d6},\u{15f},\u{15e},\u{fc},\u{dc},\s]+\s*$"))) (str.suffixof "\u{2018}XSS\u{2019})\u{201d}" z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(?:(?:(?:0?[13578]|1[02])(\/|-|\.)31)\1|(?:(?:0?[1,3-9]|1[0-2])(\/|-|\.)(?:29|30)\2))(?:(?:1[6-9]|[2-9]\d)?\d{2})$|^(?:0?2(\/|-|\.)29\3(?:(?:(?:1[6-9]|[2-9]\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))$|^(?:(?:0?[1-9])|(?:1[0-2]))(\/|-|\.)(?:0?[1-9]|1\d|2[0-8])\4(?:(?:1[6-9]|[2-9]\d)?\d{2})$"))) (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{3,4}$"))))
(check-sat)
