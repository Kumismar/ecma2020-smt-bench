; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<br size=\""&{alert('XSS')}\"">") (= x "<input onblur=write(XSS) autofocus><input autofocus>") (= x "<center onkeydown=""alert(1)"" contenteditable>test</center>")))
(assert (or (= z "(\u{2018}XSS\u{2019})>") (= z "cript:alert(2)"">") (= z "drop here</blockquote>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<input on" y)) (not (str.contains y "focus><inp")) (str.prefixof "crip" z)))
(assert (not (str.contains z "le")))
(assert (or (= (str.at x 0) "<") (= (str.at x 3) "a") (= "le" (str.substr z 1 2))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]+ [a-zA-Z]+$"))))
(assert (= (str.at z 7) "l"))
(assert (or (not (= (str.indexof y "on" 0) 7)) (= "<center onkeydown=""alert(1)"" contentedixle>test</center>drop here</blockquote>" (str.replace y "tab" "x"))))
(check-sat)
