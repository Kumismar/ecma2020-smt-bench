; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><bdi id=x style=""transition:color 1s"" ontransitionend=alert(1)></bd\u{1f4a9}i>") (= x "<keygen id=x \u{1f600}tabindex=1 onbeforeactivate=alert(1)></keygen>")))
(assert (or (= z "eonpagonpageonpageshowshoweshowshowgeshow=""alert(1)"";") (= z "ert(1)"">test</xmp>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len z) 18) (not (= (str.indexof z "</x" 0) 12))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,6}$")) (not (str.contains (str.replace z "er" "javascript:") "javascript:t(1")) (= (str.at x 36) "n")))
(assert (not (str.suffixof "v>" x)))
(assert (or (= (str.indexof y "</su" 0) 74) (= (str.indexof y "si" 0) 56)))
(assert (or (= "ert(1)"">tejavascript:mp>" (str.replace z "st</x" "javascript:")) (= "pageo" (str.substr y 68 5)) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Z][0-9][A-Z] ?[0-9][A-Z][0-9]")))))
(assert (not (= "eonpagonpageonpagejavascript:showeshowshowgeshow=""alert(1)"";" (str.replace z "show" "javascript:"))))
(assert (or (not (str.prefixof "useout" z)) (str.suffixof "source](1)" x)))
(check-sat)
