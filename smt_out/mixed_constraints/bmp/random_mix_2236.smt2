; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ol onclick=""alert(1)"">test</ol>") (= x "<svg><path><animateMotion onbegin=alert(1) dur=""1s"" repeatCount=""1"">")))
(assert (or (= z """background-image: url(&#1;javascript:document.vulnerable=true;)"">") (= z "utofocus>") (= z "r>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 66)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[a-z0-9]+([\-.]{1}[a-z0-9]+)*\.[a-z]{2,5}(:[0-9]{1,5})?(\/.*)?$"))) (str.prefixof "<svg><" x)))
(assert (= (str.at x 30) "l"))
(assert (or (not (str.suffixof ">" z)) (= "tab" (str.substr x 11 3))))
(assert (or (not (str.suffixof "tofocus>" z)) (not (<= (str.len x) 68))))
(assert (or (not (= (str.indexof y "r=""" 0) 45)) (not (= (str.indexof x """ re" 0) 50))))
(assert (not (= (str.at z 37) ":")))
(check-sat)
