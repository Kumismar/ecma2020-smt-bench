; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex draggable=""true"" ondragleave=""alert(1)"">test</isindex>") (= x "<dialog draggable=""true"" ondragenter=""alert(1)"">test</dialog>")))
(assert (or (= z "e ondblclick=""alert(1)"">test</pre>") (= z ">test</thead>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at y 54) "f") (not (str.prefixof "e on" z)) (= ">test</is" (str.substr y 48 9))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^04[56789]\d{7}$"))) (str.prefixof "<dial" x) (not (str.prefixof "e ondb" z))))
(assert (= (str.at y 9) "r"))
(assert (or (not (str.suffixof "thead>" z)) (= (str.at x 13) "a") (not (str.suffixof "ndex>" x))))
(assert (not (str.suffixof "st</pre>" z)))
(assert (or (not (str.contains (str.replace z """al" "<b>") "ck=<b>e")) (str.contains (str.replace z "est</" " ") ">t the") (not (str.in_re x ((_ re.from_regex ecma2020) "^[(]?\d{3}[)]?[(\s)?.-]\d{3}[\s.-]\d{4}$")))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[^@]+@[^@]+[.]{1}[^@]{2,}$")))
(check-sat)
