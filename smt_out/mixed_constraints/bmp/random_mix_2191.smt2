; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "eval(URL.slice(-8))>#alert(1)") (= x "<shadow draggable=""true"" ondragenter=""alert(1)"">test</shadow>")))
(assert (or (= z "ipt:document.vulnerable=true;""></LAYER>") (= z "t(1)></ol>") (= z "edeactivate=alert(1)></header><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "edeactiva" z) (not (str.suffixof "</ol>" y)) (str.prefixof "edeactivat" z)))
(assert (= "sedown" (str.substr x 8 6)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_]([\._a-zA-Z0-9-+])*@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*(\.[A-Za-z]{2,})$"))) (not (str.prefixof "e" x)) (not (= (str.len z) 39))))
(assert (or (not (str.suffixof "R>" z)) (not (= "n" (str.substr y 35 1)))))
(assert (str.contains y "(-8))"))
(check-sat)
