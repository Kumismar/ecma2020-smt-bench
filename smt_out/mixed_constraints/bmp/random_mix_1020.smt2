; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea onmouseleave=""alert(1)"">test</textarea>") (= x "<style>:target {color:red;}</style><basefont id=x style=""transition:color 1s"" ontransitionend=alert(1)></basefont>") (= x "<style>:target {transform: rotate(180deg);}</style><bgsound id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></bgsound>")))
(assert (or (= z "enteditable>test</base>") (= z "1 onactivate=alert(1)></i>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 18) "i"))
(assert (str.suffixof "rt(1)></i>" y))
(assert (or (str.suffixof "xtarea>" x) (not (str.contains (str.replace y "=""" "<b>") "tyle<b>tran")) (str.prefixof "<sty" x)))
(assert (not (= "tyle=""tra" (str.substr y 51 9))))
(assert (or (not (str.prefixof "1 onacti" z)) (str.prefixof "o" z)))
(assert (or (= "bgs" (str.substr x 124 3)) (= (str.at y 62) "d")))
(assert (or (= "ase>" (str.substr z 19 4)) (not (= (str.indexof x "i" 0) 60)) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\w\s]{4,10}"))))
(assert (not (str.contains x "1)"">test")))
(check-sat)
