; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><rb id=x style=""transition:color 1s"" ontransitionend=alert(1)></rb>") (= x "<title oncut=""alert(1)"" contenteditable>test</title>")))
(assert (or (= z "id=y autofocus>") (= z "lert(1)"">test</article>") (= z "ript>")))
(assert (= y (str.++ x z)))
(assert (= (str.at y 103) "i"))
(assert (or (not (= (str.indexof y "alert" 0) 14)) (<= (str.len y) 61) (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z\u{c3}\u{201e}\u{c3}\u{a4}\u{c3}\u{2013}\u{c3}\u{b6}\u{c3}\u{153}\u{c3}\u{bc}\u{c3}\u{178}]{1,32}"))))
(assert (= (str.len x) 102))
(assert (or (= "g><a on" (str.substr x 3 7)) (str.prefixof "<style" x)))
(assert (not (str.suffixof "t>" z)))
(check-sat)
