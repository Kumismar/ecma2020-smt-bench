; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid ondblclick=""alert(1)"">test</nextid>") (= x "<main id=x tabindex=1 onfocusin=alert(1)></main>") (= x "Redirect 302 /a&#46;jpg http&#58;//victimsite&#46;com/admin&#46;asp&deleteuser")))
(assert (or (= z "ert(1)"">test</mark>") (= z " ondblclick=""alert(1)"">test</mark>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^.{0,25}$"))) (= """alert(1" (str.substr z 12 8))))
(assert (or (not (str.contains (str.replace z "tabi" "") "d=x n")) (str.prefixof "&lt" x) (not (str.in_re z ((_ re.from_regex ecma2020) "^[^-\s][\w\s\W]{1,40}$")))))
(assert (or (not (str.contains y "f=1 o")) (str.prefixof "<" x) (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{3}-\d{4}-\d{3}$")))))
(assert (not (str.suffixof "r>" x)))
(assert (not (= (str.indexof y ")" 0) 98)))
(check-sat)
