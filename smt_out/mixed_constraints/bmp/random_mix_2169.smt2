; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><address id=x style=""transition:color 1s"" ontransitionend=alert(1)></address>") (= x "<style onblur=alert(1) tabindex=1 id=x></style><input autofocus>") (= x "<div draggable=""true"" contenteditable>drag me</div><data ondrop=alert(1) contenteditable>drop here</data>")))
(assert (or (= z "st</caption>") (= z "1)></caption>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "t</capt" (str.substr z 1 7))) (<= (str.len y) 82) (not (str.in_re z ((_ re.from_regex ecma2020) "^\(?\d{3}\)?[\s.-]?\d{3}[\s.-]?\d{4}$")))))
(assert (= (str.indexof x "iv " 0) 2))
(assert (or (= (str.indexof z "/" 0) 3) (= (str.at x 25) ";")))
(assert (or (= "tion>" (str.substr z 7 7)) (not (str.suffixof "dress>" x)) (not (str.contains x "drag me<"))))
(assert (not (= (str.len x) 112)))
(assert (or (not (str.contains y " id=x")) (not (= (str.indexof z "t" 0) 8))))
(check-sat)
