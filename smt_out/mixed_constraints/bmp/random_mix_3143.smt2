; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nobr onmouseup=""alert(1)"">test</nobr>") (= x "<footer id=x tabindex=1 onfocusin=alert(1)></footer>") (= x "<main id=x tabindex=1 ondeactivate=alert(1)></main><input id=y autofocus>")))
(assert (or (= z "ce)&lt;/SCRIPT&gt;") (= z "eleave=""alert(1)"">test</source>")))
(assert (= y (str.++ x z)))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^([+ 0-9]){3,}$")))
(assert (= "ouse" (str.substr y 9 4)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{3}$"))) (str.contains x "rt(1)"">") (not (= (str.at z 15) "g"))))
(assert (= (str.len y) 56))
(assert (or (not (= "in id=x " (str.substr y 3 8))) (not (str.contains y "ex=1 onfo"))))
(check-sat)
