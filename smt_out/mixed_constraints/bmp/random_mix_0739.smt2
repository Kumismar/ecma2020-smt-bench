; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=x onsearch=""alert(String.fromCharCode(88,83,83))"">") (= x "<pre id=x tabindex=1 onfocus=alert(1)></pre>") (= x "<section onclick=""alert(1)"">test</section>")))
(assert (or (= z "le>") (= z "x=1 onfocus=alert(1)></basefont>") (= z " contenteditable>test</data>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 64) "a") (not (= ">" (str.substr z 2 2))) (<= (str.len z) 42)))
(assert (or (str.contains z "lert(") (not (str.suffixof "t</data>" y)) (not (str.in_re y ((_ re.from_regex ecma2020) "(?!000|666)[0-8][0-9]{2}-(?!00)[0-9]{2}-(?!0000)[0-9]{4}")))))
(assert (or (str.prefixof "x=1 " z) (not (= (str.len z) 41)) (not (str.contains x "t</pic"))))
(assert (or (not (= (str.at z 14) ";")) (not (= (str.at y 5) "i")) (not (str.in_re z ((_ re.from_regex ecma2020) "^0[0-9].*$")))))
(assert (or (not (str.suffixof "/basefont>" y)) (not (= (str.indexof x """a" 0) 12)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(.){6,}$")))))
(check-sat)
