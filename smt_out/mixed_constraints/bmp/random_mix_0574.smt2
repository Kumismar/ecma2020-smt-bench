; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details onbeforecopy=""alert(1)"" contenteditable>test</details>") (= x "&lt;IMG SRC=&quot;jav&#x09;ascript:alert(&apos;XSS&apos;);&quot;&gt;") (= x "<data id=x tabindex=1 onfocusin=alert(1)></data>")))
(assert (or (= z "d=x tabindex=1 onfocusin=alert(1)></bdo>") (= z "e=xss>")))
(assert (= y (str.++ x z)))
(assert (or (= "d=" (str.substr y 7 2)) (not (<= (str.len x) 65)) (str.suffixof ">" z)))
(assert (or (= (str.indexof z "></b" 0) 33) (str.contains z "s>")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(1|2)[0-9]{3}$"))) (>= (str.len z) 3)))
(assert (or (= "=a" (str.substr z 24 2)) (not (str.suffixof ")></bdo>" z)) (= ")"">te" (str.substr y 73 5))))
(check-sat)
