; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed code=""http://businessinfo.co.uk/labs/xss/xss.swf"" allowscriptaccess=always>?") (= x "ABC<div style=""x:\xE2\x80\x83expression(javascript:alert(1)"">DEF") (= x "<HTML><BODY>")))
(assert (or (= z ">") (= z "lert(1)"">test</font>") (= z "=/ onreadystatechange=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\s\-]+$"))) (not (str.prefixof "<HTML" y))))
(assert (or (= (str.indexof z "dyst" 0) 8) (str.suffixof "rt(1)>" z)))
(assert (or (= (str.indexof z "est" 0) 10) (str.suffixof "ML><BODY>" x) (str.contains y "ML><BO")))
(assert (= (str.indexof x "t" 0) 4))
(assert (not (str.suffixof ">" z)))
(check-sat)
