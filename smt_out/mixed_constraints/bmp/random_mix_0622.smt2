; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;XML ID=I>;<;X>;<;C>;<;![CDATA[<;IMG SRC="";javas]]>;<;![CDATA[cript:alert(';XSS';);"";>;]]>;") (= x "<address onpaste=""alert(1)"" contenteditable>test</address>")))
(assert (or (= z ">") (= z "enter=""alert(1)"">test</s>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "p>" x)) (not (str.suffixof ">;]]>;" x))))
(assert (or (not (= (str.at z 0) ">")) (not (str.contains y "/addres")) (= (str.at y 66) "t")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=^.{6,}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$"))) (not (= "')}" (str.substr z 6 3)))))
(assert (or (= "';);"";>;" (str.substr x 80 8)) (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9_-]{6,16}")))))
(assert (or (= "co" (str.substr y 28 2)) (= "" (str.replace z ">" "")) (not (= (str.indexof x "1)"" c" 0) 24))))
(check-sat)
