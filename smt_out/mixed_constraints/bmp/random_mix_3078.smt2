; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound oncut=""alert(1)"" contenteditable>test</bgsound>") (= x "<button onmouseover=""alert(1)"">test</button>") (= x "<font onkeydown=""alert(1)"" contenteditable>test</font>")))
(assert (or (= z "e"" ondrag=""alert(1)"">test</progress>") (= z "s>") (= z "alert(1)"" contenteditable>test</listing>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9 +]+"))))
(assert (or (not (>= (str.len x) 38)) (str.contains x ">test</")))
(assert (or (= (str.at z 0) "s") (= (str.indexof z "di" 0) 18) (not (str.prefixof "<bgsound" x))))
(assert (or (str.suffixof "bgsound>" x) (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z\u{c0}-\u{d6}\u{d8}-\u{f6}\u{f8}-\u{ff}- ]*"))))
(check-sat)
