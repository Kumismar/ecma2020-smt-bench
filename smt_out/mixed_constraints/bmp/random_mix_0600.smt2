; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th onmouseenter=""alert(1)"">test</th>") (= x "<optgroup onkeypress=""alert(1)"" contenteditable>test</optgroup>")))
(assert (or (= z "ert(1) contenteditable>drop here</s>") (= z "m: rotate(180deg);}</style><xss id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></xss>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "op ")) (not (str.suffixof "up>" x)) (not (= "<optgroup onkeypress=""alert(1)"" contenteditabalert(1)est</optgroup>m: rotate(180deg);}</style><xss id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></xss>" (str.replace y "le>t" "alert(1)")))))
(assert (or (= (str.at z 23) "d") (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9a-zA-Z_ -]{1,20}"))) (not (str.contains z "able>dr"))))
(assert (not (<= (str.len z) 108)))
(assert (str.contains y "(1)"))
(check-sat)
