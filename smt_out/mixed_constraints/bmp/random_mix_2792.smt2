; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\xE2\x80\x82javascript:alert(1)</script>") (= x "<tbody onmouseup=""alert(1)"">test</tbody>") (= x "<div draggable=""true"" contenteditable>drag me</div><tbody ondrop=alert(1) contenteditable>drop here</tbody>")))
(assert (or (= z "bject data=javascript:alert(1)>") (= z "dex=1 id=x></head><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "E2\" 0) 14) (str.suffixof "utofocus>" y)))
(assert (or (= (str.at x 10) "o") (= "dex=1 id=x></heaxinput autofocus>" (str.replace z "d><" "x")) (str.contains z "ta=jav")))
(assert (or (not (str.suffixof "eta>" y)) (not (= (str.at z 17) ">")) (str.in_re z ((_ re.from_regex ecma2020) "^\d{10,15}$"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z_-]{3,}$")) (not (<= (str.len z) 17))))
(assert (not (str.contains y "</tbo")))
(check-sat)
