; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<image draggable=""true"" ondragstart=""alert(1)"">test</image>") (= x "<body onunload body onunload=""javascript:j\u{20000}avasc\u{1d400}ript:alert(1)""></body onunload>")))
(assert (or (= z "down=""alert(1)"">test</listing>") (= z "&apos;XSS&apos;);&quot;&gt;") (= z "a autofocus onfocusin=alert(1)>test</textarea>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/image>" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[^<>\\/]+$"))) (not (= (str.at y 93) "s"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(?!-)[a-zA-Z0-9-]{1,63}"))) (not (str.suffixof "age>" x))))
(assert (or (not (= (str.indexof x """" 0) 17)) (not (= (str.indexof x "ta" 0) 31))))
(assert (not (str.contains (str.replace x "o" """") "<b""dy ")))
(check-sat)
