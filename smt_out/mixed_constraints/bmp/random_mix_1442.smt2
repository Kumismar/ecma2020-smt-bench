; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<multicol onmouseover=""alert(1)"">test</multicol>") (= x "<article onfocusout=alert(1) tabindex=1 id=x></article><input autofocus>")))
(assert (or (= z "ragend=""alert(1)"">test</iframe>") (= z ") tabindex=1 id=x></abbr><input autofocus>") (= z "ame:x"" onanimationend=""alert(1)""></small>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 27) "t") (<= (str.len y) 104) (not (<= (str.len x) 58))))
(assert (or (str.suffixof "l>" z) (not (str.suffixof "lticol>" x)) (not (str.suffixof "iframe>" y))))
(assert (= "rt(1" (str.substr y 23 4)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^.*(?=.{6,25}).*$")) (not (str.contains y "est"))))
(check-sat)
