; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video controls autoplay onended=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= x "<style>:target {color: red;}</style><big id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></big>") (= x "<svg><xmp onload=alert(1)></xmp>")))
(assert (or (= z "textarea onmousemove=""alert(1)"">test</textarea>") (= z "t;&gt;XSS&lt;/A&gt;") (= z "icture>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<" x)) (not (>= (str.len x) 67)) (not (str.in_re y ((_ re.from_regex ecma2020) "^http[s]{0,1}://[^/].*")))))
(assert (or (= (str.at y 94) "a") (not (= "tgt;XSS&lt;/A&gt;" (str.replace z ";&" ""))) (not (str.in_re z ((_ re.from_regex ecma2020) "^\+?[\d\s\-\(\)]{8,}$")))))
(assert (or (not (= (str.indexof x "on" 0) 10)) (not (= "r" (str.substr z 4 1))) (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*[A-Za-z])(?=.*\d)(?=.*[@$!%.,:;-_^\u{b0}+*#?&])[A-Za-z\d@$!%.,:;-_^\u{b0}+*#?&]{8,}$")))))
(assert (= "textarea onmousemove=""alert(1)"">test</textaralert(1)" (str.replace z "ea>" "alert(1)")))
(assert (str.prefixof "ic" z))
(assert (or (not (= (str.at x 13) "o")) (= "<svg><xmp javascript:d=alert(1)></xmp>" (str.replace x "onloa" "javascript:")) (str.prefixof "<style>:t" x)))
(assert (<= (str.len z) 26))
(check-sat)
