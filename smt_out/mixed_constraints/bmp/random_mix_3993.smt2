; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><basefont style=""animation-name:x"" onanimationend=""alert(1)""></basefont>") (= x "<div draggable=""true"" contenteditable>drag me</div><hr ondragover=alert(1) contenteditable>drop here</hr>")))
(assert (or (= z "G SRC=\u{201d}jav ascript:alert(\u{2018}XSS\u{2019});\u{201d}>") (= z "ve=""alert(1)"">test</rtc>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "hr>" x)) (not (str.contains y "ble>drag "))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9\+\-\(\)\s]+.$"))) (= (str.indexof x "t(" 0) 84) (not (= (str.at z 21) "t"))))
(assert (not (= (str.at z 20) "l")))
(assert (= "<SRC='vbscript:msgbox(""XSS"")'>" (str.replace x "IMG " "")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(?=[-_a-zA-Z0-9]*?[A-Z])(?=[-_a-zA-Z0-9]*?[a-z])(?=[-_a-zA-Z0-9]*?[0-9])[-_a-zA-Z0-9]{8,16}"))) (not (str.contains y ">X</di"))))
(assert (or (= (str.indexof y "s" 0) 9) (not (str.contains (str.replace z "(\u{2018}XSS" "alert(1)") "lertalert(1)\u{2019});\u{201d}"))))
(check-sat)
