; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meta oncopy=""alert(1)"" contenteditable>test</meta>") (= x "<style>:target {transform: rotate(180deg);}</style><datalist id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></datalist>")))
(assert (or (= z "abindex=1 onactivate=alert(1)></tr>") (= z "jav&#x09;ascript&#058;alert('XSS');\""&gt;") (= z "Aonerror=javascript:alert(1)>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "meta>" x)) (<= (str.len z) 46)))
(assert (or (not (= (str.at x 5) " ")) (not (= "<style>:target {transform: rotate(180deg);}</style><datalist id=x style=""transition:transform 2s"" ontransitionrun=alejavascript:1)></datalist>" (str.replace x "rt(" "javascript:")))))
(assert (or (not (str.prefixof "<meta " x)) (not (= "e>test</" (str.substr y 38 8))) (str.prefixof "<style>:ta" x)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "(^$)|(^.*(\S+).*$)")))
(check-sat)
