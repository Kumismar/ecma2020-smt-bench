; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nav onkeypress=""alert(1)"" contenteditable>test</nav>") (= x "'%22--%3E%3C/style%3E%3C/script%3E%3Cscript%3Eshadowlabs(0x000045)%3C/script%3E") (= x "<style>:target {color: red;}</style><title id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></title>")))
(assert (or (= z "nteditable>drag me</div><ins ondragover=alert(1) contenteditable>drop here</ins>") (= z "q>") (= z "60")))
(assert (= y (str.++ x z)))
(assert (or (= "6x" (str.replace z "0" "x")) (not (= (str.indexof y "crip" 0) 26)) (not (= (str.at z 1) "0"))))
(assert (= (str.indexof x "C" 0) 11))
(assert (= (str.len z) 2))
(assert (not (= (str.at y 14) "t")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "(?:[4-7]'(1[01]|\d)(''|[\x22]))|(?:[4-7]')"))) (str.suffixof "ins>" z)))
(assert (str.contains (str.replace x "et" " ") "targ  {co"))
(check-sat)
