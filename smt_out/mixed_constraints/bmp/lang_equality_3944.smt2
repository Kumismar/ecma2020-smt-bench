; lang_equality, BMP mode: are the languages of two regexes A and B built from ECMAScript regexes equal: an equation A = B, its negation, or a string x in exactly one of them
; construction: union_vs_operand, languages differ, encoding: disequation
(set-logic QF_SLIA)
(set-info :status sat)
(assert (not (= (re.union ((_ re.from_regex ecma2020) "^(0[1-9]|1[0-2])\/\d{2}$") ((_ re.from_regex ecma2020) "[a-zA-Z??????acce????ei????ln??????????uu??zz??csz??????ACCEE????????ILN??????????UUY?ZZ???O?CSZ?? ,.'-]{2,100}")) ((_ re.from_regex ecma2020) "^(0[1-9]|1[0-2])\/\d{2}$"))))
(check-sat)
