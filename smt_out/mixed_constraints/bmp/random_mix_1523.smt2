; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img SRC=""jav ascript:document.vulnerable=true;"">") (= x "<figure draggable=""true"" ondrag=""alert(1)"">test</figure>") (= x "<multicol id=x tabindex\u{10348}=1 onfocus=aler\u{1f600}t(1)></multicol>")))
(assert (or (= z "dex>") (= z "\u{10348}er=""alert(1)"">test</link>") (= z """transition:color 10s"" ontransitioncancel=alert(1)></acronym>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z0-9]{5})$"))) (not (str.contains y "ransi")) (not (str.in_re x ((_ re.from_regex ecma2020) "[ ]{0,}[a-zA-Z'`.,\-+*:;&]+(\s+[a-zA-Z'`.,\-+*:;&]+)+[ ]{0,}")))))
(assert (or (>= (str.len x) 54) (str.contains z "t(1)"">te") (not (str.contains (str.replace x "fo" "alert(1)") "r \u{10348}onalert(1)cu"))))
(assert (= (str.at y 56) "\u{10348}"))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{5,14}"))) (str.prefixof """transi" z)))
(assert (str.contains x "1 onfocu"))
(check-sat)
