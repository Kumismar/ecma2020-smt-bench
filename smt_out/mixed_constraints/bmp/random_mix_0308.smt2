; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details onbeforepaste=""alert(1)"" contenteditable>test</details>") (= x "<style>@keyframes x{}</style><dl style=""animation-name:x"" onanimationend=""alert(1)""></dl>")))
(assert (or (= z "lor: red;}</style><bdo id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></bdo>") (= z "ptgroup>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9+]{10,16}$"))))
(assert (or (= "palert(1)up>" (str.replace z "tgro" "alert(1)")) (not (= "it" (str.substr x 43 2))) (str.suffixof ">" y)))
(assert (or (not (= "dl style" (str.substr y 30 8))) (not (= (str.len z) 8)) (str.suffixof "group>" z)))
(assert (or (= (str.at z 0) "x") (= (str.indexof z "<bdo " 0) 18) (str.contains y "<dl ")))
(assert (or (not (= "tgrou" (str.substr z 1 5))) (not (str.prefixof "p" z)) (str.prefixof "<d" y)))
(assert (not (str.prefixof "lor:" z)))
(check-sat)
