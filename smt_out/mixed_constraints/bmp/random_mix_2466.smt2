; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg onload svg onload=""javascript:javascript:alert(1)""></svg onload>") (= x "<header onkeydown=""alert(1)"" contenteditable>test</header>") (= x "perl -e 'print \""&lt;SCR\0IPT&gt;alert(\\""XSS\\"")&lt;/SCR\0IPT&gt;\"";'\u{10348} &gt; out")))
(assert (or (= z "pt .com>a\u{1f600}lert(document.lo\u{10348}cation)</script") (= z "ameset id=x tabindex=1\u{1f4a9} on\u{1f600}focusin=alert(1)></frameset>") (= z "d>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 51) (not (= (str.at z 1) ">"))))
(assert (or (str.prefixof "p" x) (str.suffixof "rameset>" y) (= (str.len y) 122)))
(assert (or (= (str.indexof y "t:" 0) 33) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-3]?[0-9]\.[0-1]?[0-9]\.[0-9]{4}"))) (= "e\u{1d400}st<" (str.substr z 11 5))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}]+$")))
(assert (not (= ">" (str.substr z 1 2))))
(assert (= "xlert(1);"">" (str.replace z ":a" "x")))
(check-sat)
