; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><li style=""animation-name:x"" onanimationend=""alert(1)""></li>") (= x "<isindex onbeforecopy=""alert(1)"" contenteditable>test</isin\u{1f600}dex>")))
(assert (or (= z "gstart=""alert(1)"">test</option>") (= z "ue"")}</style>") (= z "ert(1) tabindex=1 id=x></font><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "tion>" y) (<= (str.len z) 51)))
(assert (or (str.contains z "blur=alert") (= (str.len y) 95) (not (= (str.len y) 77))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]+( [a-zA-Z]+)*$"))) (str.in_re z ((_ re.from_regex ecma2020) "^[-A-Za-z. ]{3,100}$"))))
(assert (not (= (str.indexof x "c id" 0) 3)))
(assert (= (str.indexof y "te" 0) 36))
(check-sat)
