; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title onmousemove=""alert(1)"">test</title>") (= x "<span onkeydown=""alert(1)"" contenteditable>test</span>") (= x "<caption onbeforecopy=""alert(1)"" contenteditable>test</caption>")))
(assert (or (= z " onmouseout=""alert(1)\u{1d400}\u{1f600}"">test</dt>") (= z "alog>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^.*?([A-Za-z0-9_-]+\.myshopify\.com).*$"))) (not (= (str.at z 4) ">"))))
(assert (or (= (str.at y 4) "t") (= (str.len y) 88) (not (= "<title onmousemove=""ax(1)"">test</title>" (str.replace x "lert" "x")))))
(assert (or (= "alog" (str.substr z 0 4)) (not (str.in_re x ((_ re.from_regex ecma2020) "^.{2,20}$"))) (= (str.at z 2) "o")))
(assert (or (str.contains (str.replace y "onlo" "<b>") "oot <b>ad") (not (str.prefixof "<title o" y))))
(check-sat)
