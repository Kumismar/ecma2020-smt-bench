; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del onkeypress=""alert(1)"" contenteditable>test</del>") (= x "<menuitem oncut=""alert(1)"" contenteditable>test</menuitem>") (= x "<style>@keyframes x{}</style><br style=""animation-name:x"" onanimationstart=""alert(1)""></br>")))
(assert (or (= z " onfocusin=alert(1)></head>") (= z "ofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "</head>" y)) (not (str.in_re y ((_ re.from_regex ecma2020) "^(\w{1,25})@(\w{1,16})(\.(\w{1,4})){1,3}$"))) (str.suffixof "/br>" x)))
(assert (not (= "me=url " (str.substr x 68 7))))
(assert (or (str.contains x "=""alert(") (not (str.contains z "usin=a")) (not (str.prefixof "<del onkey" x))))
(assert (or (str.prefixof "<sty" y) (not (= "<menuitem oncut=""alert(1)"" contenteditablealert(1)</menuitem>" (str.replace x ">test" "alert(1)"))) (str.in_re y ((_ re.from_regex ecma2020) "^\d{9,9}$"))))
(assert (not (str.contains (str.replace y "</" "") "testde")))
(assert (or (str.suffixof ">test</u>" y) (not (<= (str.len y) 86))))
(assert (not (= "e"" conte" (str.substr y 19 8))))
(check-sat)
