; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rotate(180deg);}</style><form id=x style=""transiti\u{20000}on:transform 2s"" ontrans\u{1f600}itionrun=alert(1)></form>") (= x "echo('IPT&gt;alert(\""XSS\"")&lt;/SCRIPT&gt;'); ?&gt;")))
(assert (or (= z "usemove=""alert(1)"">test</br>") (= z "table>test</\u{1f600}xmp>")))
(assert (= y (str.++ x z)))
(assert (not (= "echo('IPT&xalert(\""XSS\"")&lt;/SCRIPT&gt;'); ?&gt;" (str.replace x "gt;" "x"))))
(assert (or (not (<= (str.len z) 12)) (<= (str.len x) 60) (not (str.prefixof "<style>:t" y))))
(assert (or (not (= "use" (str.substr z 0 3))) (not (= (str.at z 10) "<"))))
(assert (or (not (= (str.at x 43) ")")) (>= (str.len x) 48) (not (= "rge" (str.substr x 10 3)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&\u{2019}*+\/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[_\s\w\d]{3,}$")))))
(check-sat)
