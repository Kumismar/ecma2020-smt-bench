; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title onpaste=""alert(1)"" contenteditable>test</title>") (= x "<dir onmouseleave=""alert(1)"">test</dir>") (= x "<command onpaste=""alert(1)"" contenteditable>test</command>")))
(assert (or (= z "rt(1)></content>") (= z ")\""") (= z "e>:target {transform: rotate(180deg);}</style><dd id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dd>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace x "(" "x") "lertx1)""")) (not (= (str.at x 32) "t")) (str.prefixof "<title" y)))
(assert (not (str.prefixof "<title" x)))
(assert (or (not (str.suffixof ")\""" z)) (str.in_re z ((_ re.from_regex ecma2020) "^([a-fA-F0-9]{6}|[a-fA-F0-9]{3})$"))))
(assert (or (not (= " onp" (str.substr x 6 4))) (not (str.contains x "itle o"))))
(assert (str.suffixof ">" z))
(assert (not (= (str.at y 8) "f")))
(assert (= (str.at y 49) "{"))
(check-sat)
