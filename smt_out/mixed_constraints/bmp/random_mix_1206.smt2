; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details id=x tabindex=1 onactivate=alert(1)></details>") (= x "<a href=""\xE2\x81\x9Fjavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<SCRIPT onreadystatechange=javascript:javascript:alert(1);></SCRIPT>")))
(assert (or (= z "1 onfocus=alert(1)></time>") (= z "><mark onload=alert(1)></mark>") (= z "ns>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "sta") (= (str.at x 12) "2")))
(assert (or (str.prefixof "as" z) (not (= (str.at z 24) "e")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9 _-\u{e9}\u{e8}\u{ef}\u{f6}\u{e7}]+$")))))
(assert (or (str.contains (str.replace y "st<" "javascript:") "e>te\u{1f600}javascript:/i>") (= "ale" (str.substr y 49 3)) (not (= (str.at x 57) ";"))))
(assert (or (not (= (str.indexof z "load=" 0) 9)) (not (str.contains (str.replace z "ime>" " ") "</t "))))
(assert (str.contains y "vasc"))
(assert (or (not (str.prefixof "<d" x)) (= "index=1 o" (str.substr x 17 9))))
(assert (<= (str.len y) 87))
(check-sat)
