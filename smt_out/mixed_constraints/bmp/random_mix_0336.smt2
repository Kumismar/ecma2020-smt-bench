; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=&{javascript:alert(1);};>") (= x "<strong oncut=""alert(1)"" contenteditable>test</strong>") (= x "<keygen oncontextmenu=""alert(1)"">test</keygen>")))
(assert (or (= z "</script>") (= z "ed;}</style><dt id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></dt>") (= z "test</ol>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "m>" x)) (not (= "ODY{background:url(&quot;javascript:alert(&apos;XSS&a&quot;)}&lt;/STYLE&gt;" (str.replace z "pos;)" ""))) (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9]{2,120}")))))
(assert (or (= (str.indexof z "s" 0) 10) (not (str.in_re z ((_ re.from_regex ecma2020) "^[^<>%]*$"))) (not (= "ey" (str.substr y 40 2)))))
(assert (or (not (str.prefixof "ed" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z A-Z 0-9 \u{df}]$")))))
(assert (or (str.prefixof "<IMG SRC=" y) (not (= (str.indexof z "i" 0) 16))))
(check-sat)
