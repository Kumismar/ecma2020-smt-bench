; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em oncut=""alert(1)"" contenteditable>test</em>") (= x "<div draggable=""true"" contenteditable>dra\u{1f4a9}\u{1d400}g me</div><ul ondragover=alert(1) contenteditable>drop here</ul>") (= x "<legend onfocu\u{20000}sout=alert(1) tabindex=1 id=x></legend><inpu\u{1d400}t autofocus>")))
(assert (or (= z "h style=""animation-name:x"" onanimationend=""alert(1)""></th>") (= z "ng.fromCharCode(88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x "end><inp")))
(assert (or (<= (str.len z) 38) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_.-]+@[a-zA-Z0-9-]{2,}[.][a-zA-Z]{2,3}$"))))
(assert (or (= (str.indexof x "focu" 0) 10) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\d]+([-_.][A-Za-z\d]+)*@([A-Za-z\d]+[-.])+[A-Za-z\d]{2,4}$"))) (= "scr" (str.substr y 14 3))))
(assert (or (not (str.suffixof ",83))"">" y)) (str.contains y "id=x></leg")))
(check-sat)
