; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary oncopy=""alert(1)"" contenteditable>test</summary>") (= x "<hgroup onkeypress=""alert(1)"" contenteditable>test</hgroup>") (= x "<rb onkeydown=""alert(1)"" contenteditable>test</rb>")))
(assert (or (= z "eyup=""alert(1)"" contenteditable>test</body>") (= z """alert(1)"">test</wbr>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "le>te" 0) 40) (<= (str.len x) 57) (not (str.contains (str.replace x "t" " ") "eou =""al"))))
(assert (or (str.suffixof "body>" z) (not (= (str.indexof y "grou" 0) 2)) (not (= "s" (str.substr x 43 1)))))
(assert (= (str.indexof x "/hg" 0) 51))
(assert (or (not (= "<summary oncopy=""alert(1)"" contenteditable>test<ummary>" (str.replace x "/s" ""))) (not (str.prefixof "<iframe " x))))
(assert (or (str.suffixof "st</wbr>" z) (= (str.at z 16) "/")))
(assert (or (not (= "<!--#exec cmd=""/bin/echo '<SCR'""--><!--#exec cmd=""/bin/echo 'IPT SRC=http://haers.org/xss.js></SCRIPT>'""--> ontransitionrun=alert(1)></hgroup>" (str.replace y ".ck" ""))) (not (<= (str.len y) 71)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9\?\-\.+!_]{1,19}$")))))
(assert (not (= (str.at z 4) "r")))
(check-sat)
