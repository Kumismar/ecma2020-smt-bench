; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd draggable=""true"" ondragend=""alert(1)"">test</dd>") (= x "<blink onkeydown=""alert(1)"" contenteditable>test</blink>") (= x "<div oncopy=""alert(1)"" contenteditable>test</div>")))
(assert (or (= z "s</h1></marquee>") (= z "/table>") (= z "useleave=""alert(1)"">test</blockquote>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 11) "l") (not (= (str.at y 8) "n"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(?:NL-)?(\d{4})\s*([A-Z]{2})$"))) (not (str.prefixof "<li drag" y))))
(assert (or (not (= (str.len y) 65)) (not (str.prefixof "<dd " x))))
(assert (or (not (= (str.indexof y "lert" 0) 33)) (not (= (str.len z) 37)) (str.in_re x ((_ re.from_regex ecma2020) "^[_A-Za-z0-9-+.]+([_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(.[A-Za-z0-9-]+)*(.[A-Za-z]{2,4}){1,2}$"))))
(assert (or (= "le>" (str.substr z 4 10)) (not (= "<blink onkeydown=""javascript:ert(1)"" contenteditable>test</blink>" (str.replace x "al" "javascript:"))) (str.prefixof "<di" x)))
(assert (str.suffixof "te>" z))
(check-sat)
