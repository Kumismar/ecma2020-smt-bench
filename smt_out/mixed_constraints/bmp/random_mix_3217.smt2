; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base h\u{1f600}ref=//0>") (= x "<time onbeforepaste=""alert(1)"" contenteditable>test</time>") (= x "<script+src="">""+src=""http://yoursite.com/xss.js?69,69""></script>")))
(assert (or (= z " src=x onerror=javascript:alert(1)>") (= z "eave=""alert(1)"">test</code>") (= z "  javascript:alert(&apos;XSS&apos;);&quot;&gt;")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9-\s]+$"))))
(assert (or (= (str.at y 58) "-") (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9_-]{4,14}"))))
(assert (or (not (= "le" (str.substr y 22 2))) (not (= "uot;&" (str.substr z 38 5))) (not (<= (str.len z) 30))))
(assert (str.prefixof "<" y))
(assert (or (str.suffixof "&gt;" y) (str.contains (str.replace x "ler" " ") "=""a t(1)")))
(check-sat)
