; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onfocus=write(XSS) autofocus>") (= x "<article onbeforecut=""alert(1)"" contenteditable>test</article>") (= x "<bdi onmouseover=""a\u{1f600}lert(\u{1d400}1)"">test</bdi>")))
(assert (or (= z "ript>") (= z "rt(1)"">test</dt>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[0-9, -]{5,17}")) (= "<i""t onfocus=write(XSS) autofocus>" (str.replace x "npu" """"))))
(assert (or (str.contains y "nput onf") (not (>= (str.len y) 64))))
(assert (str.contains (str.replace z "<" "") "test/dt>"))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[0-9\\-]+$")) (not (= (str.len z) 16))))
(assert (or (= "dt>" (str.substr z 13 10)) (str.suffixof "#60" z) (str.suffixof "r>" y)))
(assert (= "di onmouse" (str.substr y 2 10)))
(check-sat)
