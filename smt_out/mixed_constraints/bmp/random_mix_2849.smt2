(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<track oncontextmenu=""alert(1)"">test</track>") (= x "<abb\u{20000}r onmouseover=""alert(1)"">test\u{20000}</abbr>")))
(assert (or (= z " \""&lt;SCR\0IPT&gt;alert(\\""XSS\\"")&lt;/SCR\0IPT&gt;\"";'\u{10348} &gt; out") (= z "=""alert(1)"">test</br>") (= z "p>")))
(assert (= y (str.++ x z)))
(assert (str.contains z "p>"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z][a-zA-Z0-9]{5,19}$"))) (= "id=x tabi" (str.substr x 6 9)) (str.suffixof "/abbr>" x)))
(assert (str.contains z "t;/SCR"))
