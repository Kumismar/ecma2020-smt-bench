; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;IMG SRC="";livescript:[code]"";>;") (= x "<style>:target {transform: rotate(180deg);}</style><rt id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></rt>")))
(assert (or (= z "aside id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></aside>") (= z "focus>") (= z "red;}</style><big id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></big>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "od") (str.prefixof "focu" z) (= ">" (str.substr z 1 9))))
(assert (or (not (= (str.len x) 48)) (not (str.in_re y ((_ re.from_regex ecma2020) "^\w+((-\w+)|(\.\w+))*\@[A-Za-z0-9]+((\.|-)[A-Za-z0-9]+)*\.[A-Za-z0-9]+$"))) (not (= "y=" (str.substr x 9 2)))))
(assert (or (= "<;IMG SRC=""alert(1)ivescript:[code]"";>;" (str.replace x ";l" "alert(1)")) (= (str.indexof y ":[c" 0) 22) (not (str.prefixof "<style>:" x))))
(assert (or (= (str.indexof x "onrun" 0) 102) (str.contains z "us>") (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\u{c6}\u{e6}\u{d8}\u{f8}\u{c5}\u{e5}'\u{c4}\u{e4}\u{d6}\u{f6}\u{dc}\u{fc}\u{df}\u{c9}\u{e9}\u{c0}\u{e0}\u{c8}\u{e8}\u{d9}\u{f9}\u{c2}\u{e2}\u{ca}\u{ea}\u{ce}\u{ee}\u{d4}\u{f4}\u{db}\u{fb}\u{cb}\u{eb}\u{cf}\u{ef}\u{178}\u{ff}\u{c7}\u{e7}\u{c1}\u{e1}\u{cd}\u{ed}\u{d3}\u{f3}\u{da}\u{fa}\s0-9\-]*$"))))
(check-sat)
