; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<shadow onkeyup=""alert(1)"" contenteditable>test</shadow>") (= x "<rt onbeforecopy=""alert(1)"" contenteditable>test</rt>") (= x "<div id=x tabindex=1 ondeactivate=alert(1)></div><input id=y autofocus>")))
(assert (or (= z "abindex=1 onactivate=alert(1)></s>") (= z "able onmouseleave=""alert(1)"">test</table>") (= z "lert(1)></code>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "ert(")))
(assert (or (not (str.prefixof "<rt o" x)) (not (str.prefixof "</style>" z)) (= "<div id=x tabindex=1 ondeactix=alert(1)></div><input id=y autofocus>able onmouseleave=""alert(1)"">test</table>" (str.replace y "vate" "x"))))
(assert (not (= "er" (str.substr x 24 2))))
(assert (or (= (str.indexof y "p=""" 0) 14) (not (= (str.len y) 68)) (not (= (str.at z 32) "t"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z]{2}"))) (not (= (str.at z 5) "o")) (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z])\w\S{6,}")))))
(assert (not (>= (str.len y) 77)))
(assert (not (str.suffixof "></code>" z)))
(check-sat)
