; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "</ foo=""><script>javascript:alert(1)</script>"">") (= x """`'><script>\xE2\x80\x88javascript:alert(1)</script>") (= x "<command oncut=""alert(1)"" contenteditable>test</command>")))
(assert (or (= z "IMG SRC=x onabort=""alert(String.fromCharCode(88,83,83))"">") (= z "ion-name:x"" onanimationend=""alert(1)""></form>") (= z "le>test</tr>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len x) 66))
(assert (or (not (str.prefixof "IMG SRC=x " z)) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=^.{6,}$)((?=.*\d)|(?=.*\W+))(?![.\n])(?=.*[A-Za-z]).*$"))) (not (str.suffixof "</form>" z))))
(assert (or (not (str.contains x "pt ")) (str.in_re x ((_ re.from_regex ecma2020) "[\d+]{3,4}"))))
(assert (not (str.suffixof "</command>" x)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z\u{415}\u{4b9}\u{413}\u{458}\u{413}\u{b6}\u{414}\u{4b1}\u{414}\u{4b9}\u{413}\u{a7}\u{415}\u{4bb}\u{413}\u{4a3}\u{413}\u{2013}\u{414}\u{b0}\u{414}\u{4bb}\u{413}\u{4ae}0-9-_\.]{1,15}$"))) (= (str.at y 53) "t") (not (str.prefixof "<plai" y))))
(check-sat)
