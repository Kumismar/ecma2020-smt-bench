; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 id=x tabindex=1 onfocusin=alert(1)></h1>") (= x "&#X000003C") (= x "<span onmouseover=""alert(1)"">test</span>")))
(assert (or (= z "ext/j\u{5c}u0061v\u{5c}u0061&#115&#99&#114&#105&#112&#116,\u{5c}u0061%6C%65%72%74(/XSS/)></script") (= z "est</bdi>") (= z "(1)>")))
(assert (= y (str.++ x z)))
(assert (>= (str.len y) 14))
(assert (or (not (= "<span onmouseover=""alert(1)"">t </span>est</bdi>" (str.replace y "est" " "))) (not (= (str.len z) 4)) (not (str.prefixof "<span" y))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "([0-9]{0,10})|([0-9]{0,10}\.(?=[0-9])[0-9]{0,2})")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\w{15}$"))) (not (= (str.indexof y "\u{5c}u" 0) 49)) (not (= "<span onmouseover=""alert(1)"">test</span>ext/j\u{5c}u0061v\u{5c}u0061& 115&#99&#114&#105&#112&#116,\u{5c}u0061%6C%65%72%74(/XSS/)></script" (str.replace y "#" " ")))))
(assert (or (not (= (str.at z 8) ">")) (str.suffixof "plate>" y)))
(assert (or (= "<" (str.substr x 33 1)) (= (str.indexof x "=1 " 0) 17) (str.contains (str.replace x "n" "x") "tabixd")))
(check-sat)
