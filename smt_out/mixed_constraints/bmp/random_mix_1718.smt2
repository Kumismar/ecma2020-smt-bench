; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite id=x tabindex=1 onbeforeactivate=alert(1)></cite>") (= x "<p onmouseout=""alert(1)"">test</p>") (= x "<center onblur=alert(1) tabindex=1 id=x></center><input autofocus>")))
(assert (or (= z "\u{1d400})></output>") (= z """>test</ul>")))
(assert (= y (str.++ x z)))
(assert (not (= "<center onblur=alert(1) tabindex d=x></center><input autofocus>"">test</ul>" (str.replace y "=1 i" " "))))
(assert (not (str.suffixof "st</a>" y)))
(assert (not (str.prefixof "<cite id=" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z ]+$")) (not (= (str.at y 36) "d")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[-!#$%&'*+\/0-9=?A-Z^_a-z`{|}~](\.?[-!#$%&'*+\/0-9=?A-Z^_a-z`{|}~])*@[a-zA-Z0-9](-*\.?[a-zA-Z0-9])*\.[a-zA-Z](-?[a-zA-Z0-9])+$")))))
(assert (or (str.contains (str.replace y "p>"">t" "x") "t</xes") (= (str.at x 31) "r") (str.contains (str.replace y ")><" "javascript:") "ert(1javascript:/dl>r")))
(assert (or (not (= "index=1" (str.substr y 14 7))) (not (str.prefixof "\u{1d400})><" z))))
(assert (= (str.len x) 55))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[a-z0-9]+([\-\.]{1}[a-z0-9]+)*\.[a-z]{2,5}(:[0-9]{1,5})?(\/.*)?$")))
(check-sat)
