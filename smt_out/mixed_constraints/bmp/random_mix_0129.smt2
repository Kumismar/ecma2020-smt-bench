; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><small id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></small>") (= x "<var onkeyup=""alert(1)"" contenteditable>test</var>") (= x "<style>:target {transform: rotate(180deg);}</style><section id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></section>")))
(assert (or (= z "true"" ondragend=""alert(1)"">test</slot>") (= z ";#x58&;#x53&;#x53&;#x27&;#x29>;") (= z "ection>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len y) 170) (not (str.suffixof "/shadow>" x))))
(assert (str.suffixof "r>" x))
(assert (or (= (str.indexof z "io" 0) 3) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+[-]?[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$"))) (str.in_re y ((_ re.from_regex ecma2020) "[\w@.-]{6,35}"))))
(assert (str.prefixof "e" z))
(assert (or (= (str.indexof x "(1)"" " 0) 19) (not (= "ioncancel=" (str.substr x 86 10))) (str.contains (str.replace y "i" """") "blcl""ck=""")))
(check-sat)
