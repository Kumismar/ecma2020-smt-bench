; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr onmousemo\u{20000}ve=""alert(\u{1f4a9}1)"">test</abbr>") (= x "<del onmouseenter=""alert(1)"">test</del>") (= x "<template onkeydown=""alert(1)"" contenteditable>test</temp\u{20000}lat\u{1f4a9}e>")))
(assert (or (= z "st</pre>") (= z "=x tabindex=1 onfocusin=alert(1)></sup>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "foc" """") "n""us") (str.suffixof "sup>" y) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{2018}'\u{2019}\u{b4}`\u{454}\u{404}\u{457}\u{407}\u{406}i\u{490}\u{491}\s]+$")))))
(assert (not (str.contains x "use")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[+ 0-9-())]{10,15}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{5}[-0-9]{0,5}"))) (str.prefixof "<" x)))
(assert (or (not (str.contains x "ve=""al")) (str.prefixof "st</pre" z) (not (str.prefixof "=x tabinde" z))))
(assert (or (str.suffixof "re>" y) (not (>= (str.len y) 59)) (= "rt(" (str.substr y 66 3))))
(assert (>= (str.len z) 39))
(assert (str.suffixof "p\u{20000}lat\u{1f4a9}e>" x))
(check-sat)
