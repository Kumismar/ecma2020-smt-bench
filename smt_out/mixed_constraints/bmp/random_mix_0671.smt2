; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><blink id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></blink>") (= x "<script id=x tabindex=1 onbeforeactivate=alert(1)></script>")))
(assert (or (= z "m: rotate(180deg);}</style><picture id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></picture>") (= z "deactivate=alert(1)></col><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z ");}")) (not (str.contains x "ed;}</s"))))
(assert (or (= "/bli" (str.substr x 106 4)) (not (= (str.at x 39) "e"))))
(assert (str.contains z "input "))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\w{10}(\w{2})?$"))) (= "=ale" (str.substr y 123 4)) (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[a-z].*)(?=.*[A-Z].*)(?=.*[0-9].*)(?=.*[^A-Za-z0-9].*)(?=[^\s]+$).{8,20}$")))))
(check-sat)
