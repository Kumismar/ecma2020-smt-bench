; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input ondblclick=""alert(1)"">test</input>") (= x "<style>:target {color: red;}</style><del id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></del>")))
(assert (or (= z "k>") (= z "';)>;")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x ")><" 0) 101))
(assert (or (= (str.indexof x ">" 0) 6) (not (str.in_re z ((_ re.from_regex ecma2020) "((((?=\w)[^06oOgG_]){5}-){6}((?=\w)[^06oOgG_]){5})|((((?=\w)[^06oOgG_]){4}-){3}((?=\w)[^06oOgG_]){4})|(((?=\w)[^06oOgG_]){35})|(((?=\w)[^06oOgG_]){16})")))))
(assert (or (str.prefixof "<input" x) (not (str.suffixof ">" y))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w.%+-]+@[^-]([\w-]+\.)+[\w-]{2,6}$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][\sa-zA-Z\.]*"))))
(assert (or (not (str.suffixof "</del>k>" y)) (not (= (str.indexof x "><del" 0) 35)) (not (str.contains x "lor 10s"))))
(check-sat)
