; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""110""><svg xmlns=""http://www.w3.org/2000/svg"">") (= x "<template oncut=""alert(1)"" contenteditable>test</template>") (= x "<mark draggable=""true"" ondragend=""alert(1)"">test</mark>")))
(assert (or (= z "g src=xxx:x \x2Fonerror=javascript:alert(1)>") (= z "on-name:x"" onanimationstart=""alert(1)""></input>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[1][3578][0-9]{9}$"))))
(assert (or (not (= (str.len z) 18)) (= (str.indexof x """110" 0) 8) (= ")"" c" (str.substr x 24 4))))
(assert (not (= "r=1" (str.substr z 0 3))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(^[A-Za-z0-9\-]+$)"))) (str.in_re z ((_ re.from_regex ecma2020) "^[1-9]+\.?[0-9]*")) (not (= (str.at x 26) "r"))))
(assert (str.prefixof "<div " y))
(assert (not (= """ con" (str.substr x 25 5))))
(check-sat)
