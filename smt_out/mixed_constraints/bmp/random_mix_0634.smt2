; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript onbeforepaste=""alert(1)"" contenteditable>test</noscript>") (= x "<element id=x tabindex=1 onbeforedeactivate=alert(1)></element><input autofocus>") (= x "<input TYPE=""IMAGE"" SRC=""javascript:document.vulnerable=true;"">")))
(assert (or (= z "ert(1)"">test</br>") (= z "t(1)"">test</ins>") (= z "error=""javascript:alert(1)""></object>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 55) "=") (not (= (str.indexof z ">te" 0) 4))))
(assert (or (str.contains x "pt on") (not (str.prefixof "FRAMESE" z))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9\\s]{10,12}"))) (str.suffixof "autofocus>" x) (not (str.prefixof "<el" x))))
(assert (= "error=""javascri""lert(1)""></object>" (str.replace z "pt:a" """")))
(check-sat)
