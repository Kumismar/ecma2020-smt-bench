; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source draggable=""true"" ondragenter=""alert(1)"">test</source>") (= x "<bdi ondblclick=""alert(1)"">test</bdi>") (= x "<label id=x tabindex=1 onbeforedeactivate=alert(1)></label><input autofocus>")))
(assert (or (= z "ress any key!") (= z "CT>") (= z "ckquote onkeypress=""alert(1)"" contenteditable>test</blockquote>")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace y "ctiva" "") "edeate=a"))
(assert (or (not (str.prefixof "<l" x)) (= "y!" (str.substr z 11 7))))
(assert (or (not (= "g" (str.substr x 30 1))) (str.contains z """aler") (str.prefixof "<img" x)))
(assert (or (not (= (str.at x 32) "e")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,10}$")))))
(check-sat)
