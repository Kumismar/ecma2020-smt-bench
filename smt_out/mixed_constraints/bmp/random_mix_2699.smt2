; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;IMG STYLE="";xss:expr/*XSS*/ession(alert(';XSS';))"";>;") (= x "<i draggable=""true"" ondragend=""alert(1)"">\u{10348}test</i>")))
(assert (or (= z "n onkeydown=""alert(1)"" contenteditable>test</option>") (= z "eave=""alert(1)"">test</\u{1f600}thead>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 46) "p")))
(assert (or (str.contains x "ru") (= "eydown=""" (str.substr y 60 8))))
(assert (or (str.contains (str.replace y "*" "alert(1)") "/alert(1)XSS*/") (str.suffixof ")></rt>" z) (not (str.suffixof "</style>" z))))
(assert (not (= (str.indexof y "test" 0) 42)))
(assert (or (str.suffixof "ead>" y) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z0-9!#$%&'*+\/=?^_`{|}~.-]+@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*"))) (not (str.contains (str.replace x "(ale" "x") "nxrt("))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(\(11\) [9][0-9]{4}-[0-9]{4})|(\(11\) [1-7][0-9]{3}-[0-9]{4})|(\(1[2-9]\) [5-9][0-9]{3}-[0-9]{4})|(\([2-9][1-9]\) [5-9][0-9]{3}-[0-9]{4})$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "([a-zA-Z])+$"))) (not (= "<i draggable=""true"" ondragend=""aalert(1)(1)"">\u{10348}test</i>n onkeydown=""alert(1)"" contenteditable>test</option>" (str.replace y "lert" "alert(1)")))))
(assert (str.prefixof "<;IMG STYL" x))
(assert (str.prefixof "<;IMG S" x))
(check-sat)
