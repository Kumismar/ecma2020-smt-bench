; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<shadow id=x tabindex=1 onactivate=alert(1)></shadow>") (= x "<img[a][b][c]src[d]=x[e]onerror=[f]""alert(1)"">")))
(assert (or (= z ">test</element>") (= z " onkeyup=""alert(1)"" contenteditable>test</code>")))
(assert (= y (str.++ x z)))
(assert (or (= "c[d]=x[e]o" (str.substr y 15 10)) (str.contains y "e>t")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[_A-Za-z0-9-\+]+(\.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(\.[A-Za-z0-9]+)*(\.[A-Za-z]{2,})$"))) (= (str.at y 31) "a")))
(assert (or (= (str.indexof x "=x[e" 0) 19) (= "code>" (str.substr y 95 6))))
(assert (not (str.contains (str.replace x "e]o" """") "[""nerr")))
(assert (str.in_re z ((_ re.from_regex ecma2020) "(^(1300|1800|1900|1902)(|)[0-9]{3}(|)[0-9]{3}$)|(((^[\+]*61[2|3|4|7|8]{1})|^0[2|3|7|8]{1})(|)[0-9]{4}(|)[0-9]{4}$)|(^014(|)([0-9]{5}|[0-9]{6}|[0-9]{7})$)|(^13(|)[0-9]{4}$)|(^04[0-9]{2}(|)[0-9]{3}(|)[0-9]{3}$)")))
(assert (or (not (= (str.at y 13) "t")) (= (str.at z 15) "(") (not (= (str.len y) 61))))
(assert (not (<= (str.len x) 56)))
(assert (or (not (str.contains (str.replace x "hado" """") "<s""w ")) (str.in_re z ((_ re.from_regex ecma2020) "^\d{4,5}$"))))
(check-sat)
