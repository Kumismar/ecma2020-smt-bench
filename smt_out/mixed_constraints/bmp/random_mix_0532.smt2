; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG SRC=\""javascrip\u{10348}t&#058;alert('XSS')\""") (= x "<style>@keyframes x{}</style><ol style=""animation-name:x"" onanimationstart=""alert(1)""></ol>")))
(assert (or (= z "=""alert(1)"" contenteditable>test</basefont>") (= z " onbeforepaste=""alert(1)"" contenteditable>test</rp>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains (str.replace y "crip" """") "s""\u{10348}t")))
(assert (or (str.contains x "('X") (str.suffixof "extid>;"">" y) (not (= (str.indexof z ")" 0) 23))))
(assert (= "IM" (str.substr y 4 2)))
(assert (or (not (= "<style>@keyframesxx{}</style><ol style=""animation-name:x"" onanimationstart=""alert(1)""></ol>" (str.replace x " " "x"))) (not (= (str.indexof z "cri" 0) 9))))
(assert (or (str.contains (str.replace x ";I" "javascript:") "&ltjavascript:MG S") (= (str.at z 1) "o")))
(assert (or (not (str.prefixof "&lt" x)) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_-]([a-zA-Z0-9_-]|\.[a-zA-Z0-9_-])*@[a-zA-Z0-9_-]+\.[a-zA-Z0-9_-]([a-zA-Z0-9_-]|\.[a-zA-Z0-9_-])*$")) (not (str.suffixof "(1)""></ol>" x))))
(check-sat)
