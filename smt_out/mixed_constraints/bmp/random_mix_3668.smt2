; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript id=x tabindex=1 ondeactivate=alert(1)></noscript><input id=y autofocus>") (= x "<progress onpaste=""alert(1)"" contenteditable>test</progress>")))
(assert (or (= z "S by xss</h1></marquee>") (= z "teditable>test</legend>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[\w\.%+-]+@[\w.-]+\.[a-zA-Z]{2,4}$")))
(assert (or (= "id" (str.substr x 5 2)) (not (str.in_re z ((_ re.from_regex ecma2020) "^([1-9]\d*|0)(\.\d+)?$")))))
(assert (= (str.indexof x "es" 0) 6))
(assert (or (= (str.indexof x "test" 0) 45) (str.contains y "rogress") (str.suffixof "arquee>" y)))
(assert (or (str.contains x "edit") (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]{1}[-_a-zA-Z0-9]{5,19}$"))))
(assert (or (<= (str.len z) 26) (= (str.indexof z "xss<" 0) 5) (= (str.at x 13) "a")))
(assert (or (>= (str.len y) 78) (not (str.prefixof "<prog" y)) (not (str.prefixof "te" z))))
(check-sat)
