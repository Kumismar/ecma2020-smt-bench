; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<button onbeforecut=""alert(1)"" contenteditable>test</button>") (= x "<IMG SRC=javascript\u{10348}:alert(""XSS"")>")))
(assert (or (= z "1) tabindex=1 id=x></plaintext><input autofocus>") (= z "</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "ge=javasc") (= "ocu" (str.substr y 77 3)) (str.suffixof "bdi>" y)))
(assert (or (not (= (str.len z) 6)) (not (= "di>" (str.substr z 3 9)))))
(assert (or (not (= "autof" (str.substr z 38 5))) (str.contains x "ut=""al") (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{1,4}-\d{4}$|^\d{2,5}-\d{1,4}-\d{4}$")))))
(assert (or (not (>= (str.len y) 40)) (not (= (str.at y 5) "o")) (not (= (str.at y 45) "e"))))
(assert (not (str.prefixof "<" z)))
(assert (not (str.prefixof "<IMG SRC=j" y)))
(check-sat)
