; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr id=x tabindex=1 onactivate=alert(1)></hr>") (= x "<img src=""javascript:alert('XSS');"">")))
(assert (or (= z "ditable>drop here</header>") (= z "et onreadystatechange=alert(1)></applet>") (= z "alert(1)></b>")))
(assert (= y (str.++ x z)))
(assert (not (= "');"">" (str.substr x 31 6))))
(assert (or (= "ditab<b>>drop here</header>" (str.replace z "le" "<b>")) (not (<= (str.len z) 34)) (str.contains y "1)></b")))
(assert (= (str.len y) 150))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) ".{1,64}$"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9_ -\u{d6}\u{dc}\u{e4}\u{f6}\u{fc}\u{df}]{0,20}$"))) (not (str.contains (str.replace y """ja" "alert(1)") "r=alert(1)vas"))))
(check-sat)
