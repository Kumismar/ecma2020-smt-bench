; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<acronym onmouseleave=""alert(1)"">test</acronym>") (= x "<meta id=x tabindex=1 onbeforeactivate=alert(1)></meta>") (= x "<div draggable=""true"" contenteditable>drag me</div><embed ondragover=alert(1) contenteditable>drop here</embed>")))
(assert (or (= z "yload)s</script>") (= z "t=""alert(1)"">test</details>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "tails>" y) (not (= (str.indexof y "ten" 0) 25))))
(assert (or (not (str.suffixof "a>" x)) (= "r>p id" (str.substr y 53 6)) (>= (str.len z) 18)))
(assert (or (str.prefixof "<div" x) (str.prefixof "<acronym o" y)))
(assert (or (str.contains z "t(1)") (= (str.indexof z "/scri" 0) 8)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z' -]+"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "([a-zA-Z \-]){2,}"))))
(check-sat)
