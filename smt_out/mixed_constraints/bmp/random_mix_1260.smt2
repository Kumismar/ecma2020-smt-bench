; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas onclick=""alert(1)"">test</canvas>") (= x "<template draggable=""true"" ondragenter=""alert(1)"">test</template>")))
(assert (or (= z "/html>") (= z "</q>") (= z "{alert('XSS')}"">")))
(assert (= y (str.++ x z)))
(assert (or (= "le" (str.substr x 18 2)) (str.suffixof "/html>" z) (= "src=" (str.substr x 8 4))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{3,4}$"))))
(assert (or (not (= "<pre onmousemove=""alert(1)"">test</pre>SRC=\u{201d}javascrjavascript:alert(\u{2018}XSS\u{2019});\u{201d}>" (str.replace y "ipt:" "javascript:"))) (not (<= (str.len z) 12))))
(assert (or (= (str.indexof x "ale" 0) 17) (not (= (str.indexof x "e=" 0) 18))))
(check-sat)
