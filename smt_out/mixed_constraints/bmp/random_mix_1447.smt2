; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><isindex ondragover=alert(1) contenteditable>drop here</isindex>") (= x "<abbr id=x tabindex=1 onfocus=alert(1)></abbr>")))
(assert (or (= z " contenteditable>drop here</samp>") (= z "nactivate=alert(1)></thead>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z]+@{1}[A-Za-z]+\.{1}[A-Za-z]{2,}$"))) (= (str.indexof z "t" 0) 3)))
(assert (or (not (<= (str.len x) 59)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[^0-9<>%]*$"))) (not (str.contains (str.replace z "ent" "<b>") "t<b>ed"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "(2021)")) (not (>= (str.len x) 41)) (str.contains (str.replace y "x " """") "e""on")))
(assert (or (= "onte" (str.substr x 81 4)) (= (str.indexof y "ente" 0) 26) (<= (str.len z) 41)))
(check-sat)
