; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img\x32src=x onerror=""javascript:alert(1)"">") (= x "<video poster=javascript:javascript:alert(1)//")))
(assert (or (= z "nmouseover=""prompt(1)"">") (= z "rt('XSS');""") (= z "gable=""true"" ondragstart=""alert(1)"">test</tbody>")))
(assert (= y (str.++ x z)))
(assert (= "y>" (str.substr y 92 2)))
(assert (or (not (str.contains z "t(")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]{2,}@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])*$"))) (= (str.indexof z "y" 0) 46)))
(assert (or (not (= (str.indexof x "1" 0) 16)) (str.suffixof "st</tbody>" y)))
(assert (or (not (= "c=x oner" (str.substr x 10 8))) (not (= (str.at z 20) "i"))))
(check-sat)
