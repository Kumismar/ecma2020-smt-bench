; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 id=x tabindex=1 onbeforedeactivate=alert(1)></h1><inp\u{1d400}ut \u{1f600}autofocus>") (= x "<a href=""\x1Ejavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<noembed oncut=""alert(1)"" contenteditable>test</noembed>")))
(assert (or (= z "(1)"" conte\u{1f4a9}nteditable>test</td>\u{10348}") (= z "XSS';);"";>;<;/IFRAME>;") (= z "cript\u{20000}>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "cr" z)) (not (str.prefixof "<a href=" x))))
(assert (or (not (>= (str.len y) 94)) (= (str.at y 54) "i")))
(assert (or (not (= ">test<" (str.substr y 62 6))) (= "<a hrejavascript:1Ejavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>" (str.replace x "f=""\x" "javascript:"))))
(assert (or (= (str.indexof x "j" 0) 13) (= (str.at x 50) "&") (str.contains z "XSS';);")))
(assert (or (= (str.at z 4) ";") (= "/noemb" (str.substr x 47 6)) (= ");""" (str.substr z 5 3))))
(assert (or (= (str.indexof z "';)" 0) 3) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}$"))) (not (str.prefixof "<a href=""\" y))))
(check-sat)
