; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;/TITLE&gt;&lt;SCRIPT&gt;alert(""XSS"");&lt;/SCRIPT&gt;") (= x "<object id=x tabindex=1 ondeactivate=alert(1)></object><input id=y autofocus>")))
(assert (or (= z "</dialog>") (= z "usemove=""alert(1)"">test</shadow>") (= z ">drag me</div><menuitem ondrop=alert(1) contenteditable>drop here</menuitem>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[\(]\d{2}[\)]\s\d{5}[\-]\d{4}"))))
(assert (or (str.contains z "dialog") (not (str.suffixof "</dt>" y))))
(assert (not (str.prefixof "</" z)))
(assert (or (not (str.contains z "lea")) (not (= "&lt;/TITLE&gt;&lt;SCRIPT&gt;alert(""XSS"");&lt;/SCRIPT&gt;</dialert(1)>" (str.replace y "alog" "alert(1)")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-2]{0,1}"))) (not (str.prefixof "&lt;/TI" y))))
(assert (= "&lt;/TITLE&gt;&lt;SCRIPT&gt;alert(""<b>SS"");&lt;/SCRIPT&gt;" (str.replace x "X" "<b>")))
(assert (or (= "e</menu" (str.substr y 120 7)) (= (str.at y 18) """")))
(check-sat)
