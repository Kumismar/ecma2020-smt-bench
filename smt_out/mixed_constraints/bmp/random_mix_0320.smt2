; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;SCRIPT SRC=//ha.ckers.org/.j>;") (= x "<script onmouseout=""alert(1)"">test</script>") (= x "<details onpaste=""alert(1)"" contenteditable>test</details>")))
(assert (or (= z "tent onload=alert(1)></content>") (= z "leave=""alert(1)"">test</nextid>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len y) 88) (= (str.indexof z "1)><" 0) 18) (not (str.contains y "(1)></con"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(0?[1-9]|[12][0-9]|3[01])[\/](0?[1-9]|1[012])[\/]\d{4}\s([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"))) (not (= "ames>" (str.substr y 64 9))) (= (str.len y) 73)))
(assert (or (not (= "leave=""""(1)"">test</nextid>" (str.replace z "alert" """"))) (not (= (str.at z 2) "n"))))
(assert (or (not (= "tent onload=alert(1)><javascript:tent>" (str.replace z "/con" "javascript:"))) (not (= (str.len x) 58)) (str.contains x "cri")))
(assert (or (not (= ">ransiti" (str.substr y 77 8))) (= (str.at y 13) "s")))
(check-sat)
