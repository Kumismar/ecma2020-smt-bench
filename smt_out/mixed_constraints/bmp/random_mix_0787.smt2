; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del id=x tabindex=1 ondeacti\u{20000}vate=alert(1)></del><input id=y autofocus>") (= x "<frame draggable=""true"" ondrag=""alert(1)"">test</frame>") (= x "&lt;META HTTP-EQUIV=\""refresh\"" CONTENT=\""0; URL=http&#58;//;URL=javascript&#058;alert('XSS');\""")))
(assert (or (= z "itable>test</code>") (= z "/div><sub ondragover=alert(1) contenteditable>drop here</sub>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "/div><s" z)) (not (= (str.at z 69) "d"))))
(assert (or (not (str.suffixof "b>" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{7,}$"))) (str.in_re x ((_ re.from_regex ecma2020) "^([_a-zA-Z0-9-&]+((\.|\+)[_a-zA-Z0-9-&]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*(\.[a-zA-Z]{1,10}))?$"))))
(assert (or (= (str.indexof y "ita" 0) 33) (not (str.contains y "/t"))))
(assert (or (not (str.contains x " ondr")) (not (= (str.indexof y "L" 0) 47)) (str.prefixof "/div" z)))
(assert (str.contains y "ondrag"))
(check-sat)
