; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><track id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></track>") (= x "<caption onmouseleave=""alert(1)"">test</caption>") (= x "<acronym onkeypre\u{1f600}ss=""alert(1)"" contenteditable>tes\u{1d400}t</acronym>")))
(assert (or (= z "nbeforedeactivate=alert(1)></spacer><input autofocus>") (= z """ onanimationstart=""alert(1)""></xmp>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{5}(?:[-\s]\d{4})?"))))
(assert (or (not (<= (str.len z) 36)) (= "olor: red" (str.substr y 17 9))))
(assert (not (= "imation" (str.substr z 6 7))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^(([X-Z]{1})(\d{7})([A-Z]{1}))|((\d{8})([A-Z]{1}))|(([A-Z]{1})(\d{8}))$")) (not (= (str.indexof y "1)" 0) 29))))
(assert (or (not (<= (str.len x) 48)) (str.prefixof "nbefo" z)))
(check-sat)
