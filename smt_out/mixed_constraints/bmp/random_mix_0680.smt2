; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary onpaste=""alert(1)"" contenteditable>test</summary>") (= x """/><img/onerror=\x20javascript:alert(1)\x20src=xxx:x />") (= x "<rtc onmouseleave=""alert(1)"">test</rtc>")))
(assert (or (= z "t=""alert(1)"">test</ul>") (= z """alert(1)"">test</tr>") (= z "t(1)"" contenteditable>test</main>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "t(" z))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9\u{5c}u00C0-\u{5c}u024E_.,& -]+"))))
(assert (not (str.contains x "t(1)"">t")))
(assert (or (not (str.contains (str.replace z "(1" """") "alert"")"">t")) (not (= (str.indexof y "rt" 0) 1))))
(assert (or (= "leave=""a" (str.substr y 12 8)) (= "c" (str.substr x 28 1)) (= """/><img/onerror=\x<b>javascript:alert(1)\x20src=xxx:x />" (str.replace x "20" "<b>"))))
(assert (or (= (str.len x) 39) (str.in_re x ((_ re.from_regex ecma2020) "^([0]?[1-9]|[1|2][0-9]|[3][0|1])[./-]([0]?[1-9]|[1][0-2])[./-]([0-9]{4}|[0-9]{2})$")) (not (<= (str.len y) 88))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^DE(?:\s*[0-9a-zA-Z]\s*){20}$"))) (= (str.at x 9) "o") (not (<= (str.len z) 24))))
(assert (str.contains z "e>test</ma"))
(check-sat)
