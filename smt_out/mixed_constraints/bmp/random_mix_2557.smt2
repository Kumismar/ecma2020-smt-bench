; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<slot id=x tabindex=1 onbeforedeactivate=alert(1)></slot><input autofocus>") (= x "<;DIV STYLE="";background-image: url(&;#1;javascript:alert(';XSS';))"";>;")))
(assert (or (= z "/xmp><img src=xx:x onerror=aler") (= z "t(1)"">test</dir>") (= z "pt%3E%22)\u{2019}%3E")))
(assert (= y (str.++ x z)))
(assert (or (= "<slot id=x tabindex=1 onbeforedeactivate=ale></slot><input autofocus>" (str.replace x "rt(1)" "")) (not (= (str.indexof z "(1)""" 0) 1)) (str.prefixof "<;DIV ST" y)))
(assert (not (>= (str.len x) 40)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[\w-]+(\.[\w-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,4})$")) (str.in_re x ((_ re.from_regex ecma2020) "[A-z0-9.\-\@]{6,}")) (not (= (str.indexof y """>te" 0) 24))))
(assert (not (= (str.at z 4) "E")))
(assert (or (str.contains x ";javascri") (>= (str.len z) 6) (str.suffixof "test</dir>" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][0-9a-zA-Z]*@{1}[0-9a-zA-Z]+.(com|net|cn|com.cn)$"))) (not (= "<;DIV STYLE="";background-image: url(&;#1;javascript:alert(';XSS';))"";>;/xmp><img src=xx:x onerr<b>er" (str.replace y "or=al" "<b>")))))
(assert (or (not (= "onbefore" (str.substr x 22 8))) (str.contains z "rt(1")))
(check-sat)
