; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<optgroup onmouseover=""alert(1)"">test</optgroup>") (= x "<plaintext draggable=""true"" on\u{10348}drag=""alert\u{10348}(1)"">test</plaintext>") (= x "<main draggable=""true"" ondragend=""alert(1)"">test</main>")))
(assert (or (= z "t(1)"">test</applet>") (= z "eup=""alert(1)"">test</var>") (= z "(1)"" contenteditable>test</html>")))
(assert (= y (str.++ x z)))
(assert (= (str.len y) 96))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^((13[0-9])|(14[5|7])|(15([0-3]|[5-9]))|(16[0-9])|(17[0-9])|(18[0,5-9]))\d{8}$|^((13[0-9])|(14[5|7])|(15([0-3]|[5-9]))|(18[0,5-9]))\d{8}$")) (not (= (str.len x) 55)) (not (str.prefixof "<main dra" y))))
(assert (not (str.suffixof ">" z)))
(assert (not (= (str.at z 0) "t")))
(assert (or (not (str.suffixof "ar>" y)) (not (= "ndrage" (str.substr x 24 6)))))
(assert (or (<= (str.len z) 64) (not (str.contains z "lert(1"))))
(assert (or (str.prefixof "<op" x) (not (= (str.indexof y "gabl" 0) 15)) (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{8,}$")))))
(assert (not (= "ml>" (str.substr x 53 7))))
(assert (= (str.indexof x "l" 0) 14))
(check-sat)
