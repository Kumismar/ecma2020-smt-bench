; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "*{color:gre/**/en !/**/important} /* IE 6-9 Standards mode */") (= x "<svg><image href=validimage.png onload=alert(1)>") (= x "<img src=foo.png onerror=alert(/xssed/) />")))
(assert (or (= z "ame:x"" onanimationstart=""alert(1)""></tt>") (= z "rame>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<textarea " x)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([A-z0-9._%+-]+@[A-z0-9.-]+\.[A-z]{2,6})|([0-9-\s]{10,})$"))))
(assert (or (= (str.at x 36) "d") (not (= (str.len x) 42)) (not (str.suffixof ") />rame>" y))))
(assert (or (not (str.suffixof "e>" z)) (not (= (str.at z 29) "t"))))
(assert (not (str.prefixof "a" z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9]+@[a-z0-9]+.com"))) (str.contains (str.replace x "**/i" "<b>") "!/<b>mp")))
(assert (str.suffixof "e */" x))
(check-sat)
