; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;scrscriptipt>;alert(1)<;/scrscriptipt>;") (= x "alert;pg(""XSS"")") (= x "<div id=""126""><object id=""x"" classid=""clsid:CB927D12-4FF7-4a9e-A169-56E4B8A75598""></object>")))
(assert (or (= z "(1)"">test</span>") (= z "e"" ondragleave=""alert(1)"">test</header>") (= z "060")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof """)" x)) (= "9e-A169-5" (str.substr x 60 9)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z-\s]+$")))))
(assert (or (= (str.len y) 31) (not (str.suffixof "</object>" x))))
(assert (or (str.prefixof "e"" ondrag" z) (not (str.in_re z ((_ re.from_regex ecma2020) "(?=^.{8,}$)((?=.*\d)|(?=.*\W+)).*$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[_A-Za-z0-9-]+(\.[_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*(\.[A-Za-z0-9]{2,4})$"))) (not (= (str.len x) 91))))
(assert (or (not (= (str.len z) 39)) (not (= (str.at y 55) "n")) (not (str.prefixof "<div id=""" x))))
(assert (or (not (str.suffixof "der>" y)) (= (str.at z 43) "r")))
(check-sat)
