; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "'>//\\,<'>"">"">""*""") (= x "<frame oncopy=""alert(1)"" contenteditable>test</frame>") (= x "<svg><set onrepeat=alert(1) attributename=x dur=1s repeatcount=2>")))
(assert (or (= z "ript>"">") (= z "foredeactivate=alert(1)></embed><input autofocus>") (= z "=alert(1)></footer>")))
(assert (= y (str.++ x z)))
(assert (or (= "dur=1s re" (str.substr x 44 9)) (str.contains x ",<'") (= (str.indexof y "</scr" 0) 52)))
(assert (or (= (str.len x) 17) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-z0-9._%+-]+@[a-zA-z0-9.-]+\.[a-zA-z]{2,4}$"))))
(assert (not (= (str.indexof x "tente" 0) 28)))
(assert (or (str.contains x "\,") (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{3}-?[0-9]{4}$")))))
(assert (or (str.prefixof "<frame" x) (not (str.contains (str.replace y "pt>\x" " ") "scri 0A")) (not (= "me>" (str.substr x 50 10)))))
(assert (or (not (= (str.at z 28) "b")) (not (str.prefixof "<sv" x))))
(check-sat)
