; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address draggable=""true"" ondragstart=""\u{10348}alert(1)"">test\u{1f4a9}</address>") (= x "<var onfocusout=alert(1) tabindex=1 id=x></var><input autofocus>")))
(assert (or (= z "able=""true"" ondragstart=""alert(1)"">test</audio>") (= z "mouseover=""alert(1)"">test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^18$"))))
(assert (or (str.prefixof "<v" y) (not (= (str.indexof x """>t" 0) 48))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z\u{5c}u00C0-\u{5c}u00FF ]+"))) (str.prefixof "<addr" x) (not (str.suffixof "laintext>" z))))
(assert (or (not (= (str.indexof x "ad" 0) 1)) (not (= (str.at z 8) "a")) (not (str.contains (str.replace y "nfo" "alert(1)") "var oalert(1)cus"))))
(assert (or (not (>= (str.len x) 44)) (not (= "<" (str.substr y 0 1)))))
(assert (= (str.at y 5) "o"))
(check-sat)
