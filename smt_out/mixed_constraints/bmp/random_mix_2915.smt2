; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xml id=""X""><a><b><script>document.vulnerable=true;</script>;</b></a></xml>") (= x "<style>@keyframes x{}</style><a style=""animation-name:x"" onanimationend=""alert(1)""></a>")))
(assert (or (= z "alert(1)>\u{1f4a9}</a>"">") (= z """ contenteditable>test</rp>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof " o" z) (not (str.suffixof "t(1)"">" z))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9][0-9]"))))
(assert (or (not (<= (str.len y) 106)) (= (str.at y 56) "i") (not (str.contains z "enteditab"))))
(assert (>= (str.len y) 86))
(assert (or (str.contains x "ma") (not (= "s x{}</" (str.substr y 16 7))) (>= (str.len y) 100)))
(assert (not (str.contains y "nten")))
(check-sat)
