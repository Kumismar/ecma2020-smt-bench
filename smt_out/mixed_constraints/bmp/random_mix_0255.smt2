; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form action=javascript:alert(1)><input type=submit>") (= x "<STYLE>li {list-style-image: url(""javascript:javascript:alert(1)"");}</STYLE><UL><LI>XSS") (= x "<STYLE>.XSS{background-image:url(""javascript:javascript:alert(1)"");}</STYLE><A CLASS=XSS></A>")))
(assert (or (= z "ouseover=""alert(1)"">test</spacer>") (= z "ad=alert(1)")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-z\u{119}\u{f3}\u{105}\u{15b}\u{142}\u{17c}\u{17a}\u{107}\u{144}\u{118}\u{d3}\u{104}\u{15a}\u{141}\u{17b}\u{179}\u{106}\u{143} /,.]){2,}$"))))
(assert (not (str.prefixof "ad=alert(1" z)))
(assert (or (str.contains z """alert") (not (str.contains (str.replace y "ert" "alert(1)") "pt:alalert(1)(1")) (not (= (str.at x 29) "g"))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^\(*\+*[1-9]{0,3}\)*-*[1-9]{0,3}[-. /]*\(*[2-9]\d{2}\)*[-. /]*\d{3}[-. /]*\d{4} *\.* *\d{0,4}$")))
(assert (not (= (str.at z 20) "t")))
(assert (or (not (<= (str.len x) 59)) (not (= "<STYLE>.XSS{background-image:url(""javascript:javascript:a<b>rt(1)"");}</STYLE><A CLASS=XSS></A>" (str.replace x "le" "<b>")))))
(assert (or (<= (str.len x) 93) (not (= (str.at y 30) "1")) (str.suffixof "alert(1)" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\+380-\d{2}-\d{3}-\d{2}-\d{2}"))) (= (str.len x) 87)))
(check-sat)
