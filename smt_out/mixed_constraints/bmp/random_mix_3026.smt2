; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a xmlns:xlink=""http://www.w3.org/1999/xlink"" xlink:href=""javascript:alert(87)""><rect width=""1000"" height=""1000"" fill=""white""/></a>") (= x "<BODY ONLOAD=alert(\u{2019}XSS\u{2019})>") (= x "<style>@keyframes x{}</style><keygen style=""animation-name:x"" onanimationstart=""alert(1)""></keygen>")))
(assert (or (= z "reactivate=alert(1)></center>") (= z "1)"">test</template>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "(?!.*\d{7,}).*"))))
(assert (or (str.prefixof "reactivate" z) (str.contains (str.replace y "imati" "javascript:") "njavascript:on")))
(assert (or (not (= (str.at z 7) "t")) (not (str.contains z "te=ale")) (not (str.contains y " style=""an"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "cvv"))))
(assert (not (= (str.at y 23) "[")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\D{1,30}$"))) (not (= "reactivate=alert(1)></cer>" (str.replace z "nte" ""))) (not (str.contains x "99/x"))))
(check-sat)
