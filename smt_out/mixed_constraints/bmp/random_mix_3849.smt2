; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hgroup onbeforecopy=""alert(1)"" contenteditable>test</hgroup>") (= x "<var onmouseover=""alert(1)"">test</var>")))
(assert (or (= z "down=""alert(1)"">test</i>") (= z "?@[/|\]^`=alert("";XSS"";)>;") (= z "source onbeforecut=""alert(1)"" contenteditable>test</source>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "je")) (str.contains (str.replace z "bl" """") "ta""e") (str.suffixof "urce>" y)))
(assert (or (not (str.contains y "ar on")) (= (str.at z 3) ">") (str.suffixof ";" y)))
(assert (or (not (>= (str.len y) 92)) (not (= (str.indexof y "ble>t" 0) 44)) (not (str.contains y "ert(1)"" co"))))
(assert (or (= (str.at x 108) "/") (str.in_re y ((_ re.from_regex ecma2020) "^((13[0-9])|(14[5|7])|(15([0-3]|[5-9]))|(16[0-9])|(17[0-9])|(18[0,5-9]))\d{8}$|^((13[0-9])|(14[5|7])|(15([0-3]|[5-9]))|(18[0,5-9]))\d{8}$")) (not (<= (str.len z) 33))))
(assert (or (>= (str.len z) 25) (= (str.indexof y "test" 0) 28)))
(check-sat)
