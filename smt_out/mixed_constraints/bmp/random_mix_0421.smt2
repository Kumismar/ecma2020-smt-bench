; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<A HREF=""http://0x42.0x0000066.0x7.0x93/"">XSS</A>") (= x "<summary id=x tabindex=1 onbeforedeactivate=alert(1)></summary><input autofocus>")))
(assert (or (= z "03c;") (= z "ow id=x tabindex=1 onbeforedeactivate=alert(1)></shadow><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "(^([^@\s\074\076]+)@((?:[-a-z0-9]+\.)+[a-z]{2,})$)(?!(\r|\n))")))
(assert (or (str.contains z "vate=al") (= ";" (str.substr z 3 7))))
(assert (or (= (str.len x) 52) (not (= (str.at x 36) "x"))))
(assert (or (= (str.at z 11) "l") (not (str.in_re x ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[$@$!%*?&])[A-Za-z\d$@$!%*?&]{8,}")))))
(assert (not (= (str.indexof z "c;" 0) 2)))
(assert (or (not (str.contains z "abind")) (not (str.contains z "3c;")) (str.in_re x ((_ re.from_regex ecma2020) "(?!00)[0-3][0-9]"))))
(assert (or (= (str.len x) 49) (not (>= (str.len z) 66))))
(check-sat)
