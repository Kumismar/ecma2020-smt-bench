; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><ruby ondrop=alert(1) contenteditable>drop here</ruby>") (= x "<IMG SRC=x ontoggle=""alert(String.fromCharCode(88,83,83))"">") (= x "<element onmouseout=""alert(1)"">test</element>")))
(assert (or (= z "t;") (= z "x3C;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{3,6}$"))) (not (= ")"">test" (str.substr y 28 7)))))
(assert (= (str.at y 34) "f"))
(assert (or (<= (str.len x) 114) (not (= """true"" co" (str.substr y 15 9))) (not (str.suffixof ";" z))))
(assert (not (= "<div draggable=""true"" contenteditable>drag me""div><ruby ondrop=alert(1) contenteditable>drop here</ruby>x3C;" (str.replace y "</" """"))))
(assert (not (= "eover=" (str.substr y 10 6))))
(assert (or (not (= "<b>" (str.replace z "x3C;" "<b>"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{5}(?:-[0-9]{4})?$")))))
(assert (not (= (str.len x) 45)))
(check-sat)
