; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<s onmousemove=""alert(1)"">test</s>") (= x "<tbody onfocusout=alert(1) tabindex=1 id=x></tbody><input autofocus>") (= x "<w contenteditable id=x onfocus=alert()>")))
(assert (or (= z "</script>") (= z """ ondrag=""alert(1)"">test</main>") (= z "=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "alert(1)""" (str.substr y 23 9))) (not (str.suffixof "pt>" z)) (= (str.len x) 40)))
(assert (or (str.contains y " autofoc") (not (= (str.at y 24) """"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._-]+@[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+)+$"))) (str.contains (str.replace y "le" "x") "=""axr")))
(assert (str.contains z "lement1"">"))
(check-sat)
