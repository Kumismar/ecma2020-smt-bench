; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg oncontextmenu=""alert(1)"">test</svg>") (= x "<slot onmouseover=""alert(1)"">test</slot>")))
(assert (or (= z "alert(1)>") (= z "g me</div><frameset ondrop=alert(1) contenteditable>drop here</frameset>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains x "seover=""al")))
(assert (or (not (= "t" (str.substr y 26 1))) (not (= (str.at z 63) "f"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{3}[ ]{0,1}[0-9]{2}$"))) (not (>= (str.len z) 63)) (<= (str.len z) 18)))
(assert (or (str.suffixof ">" z) (not (= "<rb draggable="" "" ondragenter=""alert(1)"">test</rb> giveanswerhere=?" (str.replace y "true" " ")))))
(assert (not (= "<slot onmouseover=""alert(1)"">test</slog me</div><frameset ondrop=alert(1) contenteditable>drop here</frameset>" (str.replace y "t>" ""))))
(check-sat)
