; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=# onerror\x3D""javascript:alert(1)"" >") (= x "<svg><pre onload=alert(1)></pre>") (= x "&lt;A HREF=&quot;//www.google.com/&quot;&gt;XSS&lt;/A&gt;")))
(assert (or (= z "enuitem>") (= z "bed oncut=""alert(1)"" contenteditable>test</noembed>") (= z "gt;")))
(assert (= y (str.++ x z)))
(assert (or (= (str.len y) 48) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{2019}'-]+$")))))
(assert (or (not (= (str.at y 35) "l")) (not (str.in_re z ((_ re.from_regex ecma2020) "(^(?!0{5})(\d{5})(?!-?0{4})(|-\d{4})?$)")))))
(assert (or (not (str.contains x ")></pre>")) (not (str.suffixof "/A&gt;gt;" y))))
(assert (or (= "error\x3D""" (str.substr y 13 10)) (>= (str.len x) 43)))
(assert (or (str.suffixof "/nav>" z) (= (str.at z 7) ">")))
(assert (or (not (str.contains z "gt;")) (= ">" (str.substr z 7 3))))
(assert (or (= (str.len x) 59) (= "src=# one" (str.substr x 5 9))))
(check-sat)
