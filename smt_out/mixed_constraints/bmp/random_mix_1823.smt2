; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp onkeydown=""alert(1)"" contenteditable>test</samp>") (= x "<s draggable=""true"" ondragleave=""alert(1)"">test</s>") (= x "<div draggable=""true"" con\u{1f600}tenteditable>drag me</div><base ondrop=alert(1) contenteditable>drop here</base>")))
(assert (or (= z "S')%3c/script%3e") (= z "s") (= z "le=""transition:transform 2s"" ontransitionrun=alert(1)></mark>")))
(assert (= y (str.++ x z)))
(assert (= "S'alert(1)/script%3e" (str.replace z ")%3c" "alert(1)")))
(assert (not (str.contains x "<bas")))
(assert (or (str.contains (str.replace z "s" "javascript:") "javascript:") (not (str.prefixof "<s draggab" x))))
(assert (or (str.suffixof "ript%3e" y) (not (str.prefixof """`'><" y)) (str.prefixof "S" z)))
(assert (or (not (str.contains z "%3c/scrip")) (= (str.at y 29) "v")))
(assert (str.in_re z ((_ re.from_regex ecma2020) "(^((0\d{2,3})-)(\d{7,8})(-(\d{3,}))?$)|(^1((3|5|8){1}\d{1}|70)\d{8}$)")))
(assert (not (= "=""a" (str.substr x 31 3))))
(check-sat)
