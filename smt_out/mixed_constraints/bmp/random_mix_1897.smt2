; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source onmouseover=""alert(1)"">test</source>") (= x "<x %6Fnxxx=1")))
(assert (or (= z "t id=x style=""transition:color 1s"" ontransitionend=alert(1)></output>") (= z " onbeforedeactivate=alert(1)></progress><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/output>" z)) (= (str.at z 16) "a")))
(assert (or (str.contains y "1)></outpu") (not (str.prefixof " " z))))
(assert (not (= (str.indexof y "ale" 0) 32)))
(assert (not (= (str.at x 10) " ")))
(assert (or (str.contains (str.replace x "<x " "x") "x%6Fnx") (str.prefixof "<x" x) (<= (str.len x) 22)))
(assert (not (= (str.at z 27) "l")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\u{5c}u4e00-\u{5c}u9fa5]{2,4}$"))) (not (= ">" (str.substr y 80 6))) (not (= "rce" (str.substr x 40 3)))))
(assert (str.prefixof "t" z))
(check-sat)
