; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param onbeforecopy=""alert(1)"" contenteditable>test</param>") (= x "<script src=""http://code.jquery.com/jquery-1.4.4.js""></script>")))
(assert (or (= z "ck><input autofocus>") (= z "><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at x 22) "l")) (not (<= (str.len z) 15)) (str.suffixof "set>" z)))
(assert (or (= ">" (str.substr z 0 1)) (not (= (str.at x 23) "e")) (not (= "input a" (str.substr z 4 7)))))
(assert (= (str.indexof y "sc" 0) 1))
(assert (or (not (str.suffixof "s>" z)) (not (= "=" (str.substr z 15 1)))))
(assert (not (= "" (str.replace z "quee>" ""))))
(assert (= "<script src=""http://code.jquery.comalert(1)query-1.4.4.js""></script>><input autofocus>" (str.replace y "/j" "alert(1)")))
(assert (or (<= (str.len y) 81) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_\.\-]+@(?:[a-zA-Z0-9\-]+\.)+[a-z]{2,4}$")))))
(assert (not (str.contains x "=""http://")))
(check-sat)
