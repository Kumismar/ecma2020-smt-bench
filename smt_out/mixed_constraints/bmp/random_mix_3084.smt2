; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;DIV STYLE=&quot;background-image: url(javascript:alert(&apos;XSS&apos;))&quot;&gt;") (= x "<area onmousedown=""alert(1)"">test</a\u{1d400}rea>") (= x "<style>:target {transform: rotate(180deg);}</style><bdi id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></bdi>")))
(assert (or (= z "alert(1)"">test</image>") (= z "e=alert(1)></map>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "&lt;DIV " y)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9.]+$")))))
(assert (or (not (= (str.at x 24) "(")) (not (str.contains x """alert(1)"""))))
(assert (or (not (= "ert(" (str.substr x 55 4))) (= "<style>:target {transform: rotate(180dealert(1)</style><bdi id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></bdi>e=alert(1)></map>" (str.replace y "g);}" "alert(1)"))))
(assert (<= (str.len z) 58))
(assert (= (str.indexof z "</ma" 0) 11))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[_a-z0-9-]+(.[_a-z0-9-]+)*@[a-z0-9-]+(.[a-z0-9-]+)*[.]([a-z]{2,3})$"))))
(assert (or (not (str.suffixof "1)></map>" z)) (not (str.contains (str.replace z "ert(1" "<b>") "=al<b>)></m")) (str.in_re z ((_ re.from_regex ecma2020) "^L[0-9]{2}P[0-9]{4}$"))))
(assert (not (str.prefixof "alert(1" z)))
(check-sat)
