; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<p onclick=""alert(1)"">test</p>") (= x "<b onbeforepaste=""alert(1)"" contenteditable>test</b>")))
(assert (or (= z "tivate=alert(1)></base>") (= z ")></tbody>") (= z "enteditable>test</h1>")))
(assert (= y (str.++ x z)))
(assert (or (= "me:x"" onanimationend=""art(1)""></map>" (str.replace z "le" "")) (str.contains (str.replace z "v" "x") "tixate=a")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[_a-zA-Z0-9\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401} ]+$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[^@]+@[^@]+$"))) (str.suffixof ")></tbody>" z)))
(assert (or (not (= (str.at x 21) "t")) (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]{2,30}@[a-z0-9.-]{3,20}\.[a-z]{2,4}$"))))
(assert (not (str.contains z "bo")))
(assert (str.contains y "ick=""aler"))
(assert (or (str.prefixof "<b onbe" x) (= (str.at x 27) "/")))
(check-sat)
