; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div onkeydown=""alert(1)"" contenteditable>test</div>") (= x "<hgroup draggable=""true"" ondragleave=""alert(1)"">test</hgroup>") (= x "<noscript draggable=""true"" ondragend=""alert(1)"">test</noscript>")))
(assert (or (= z "/s>") (= z "yle><footer id=x style=""transition:color 1s"" ontransitionend=alert(1)></footer>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len y) 86) (not (str.contains z "n:co")) (not (str.in_re x ((_ re.from_regex ecma2020) "^\s*\d{10}\s*")))))
(assert (or (= (str.at x 44) "1") (= "/hgr" (str.substr x 53 4))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\u{e9}\u{e8}\u{ef}\u{f6}\u{e7}]+$")) (not (str.suffixof "</footer>" y)) (not (str.in_re y ((_ re.from_regex ecma2020) ".*([a-z0-9\+_\-]+)(\.[a-z0-9\+_\-]+)*@([a-z0-9\-]+\.)+[a-z]{2,6}$.*")))))
(assert (not (str.contains y "down=")))
(check-sat)
