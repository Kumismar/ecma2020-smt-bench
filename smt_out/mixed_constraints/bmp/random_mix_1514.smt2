; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video oncanplay=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= x "<noframes draggable=""true"" ondragend=""alert(1)"">test</noframes>")))
(assert (or (= z "MATAS=HTML&gt;&lt;/SPAN&gt;") (= z ">test</keygen>") (= z "rt(1)"">test\u{1f600}</element>")))
(assert (= y (str.++ x z)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[^\x22\x27\x26\x25\x21]*")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{1,3}(,[0-9]{2})?"))) (not (= "ert(" (str.substr y 40 4))) (>= (str.len x) 70)))
(assert (or (not (str.prefixof "<nofram" y)) (not (= (str.at x 59) "=")) (str.prefixof "<no" y)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{2}[0-9]{4,6}[0-9]{3,4}$"))))
(check-sat)
