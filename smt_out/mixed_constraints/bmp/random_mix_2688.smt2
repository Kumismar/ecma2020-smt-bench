; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid onblur=alert(1) tabindex=1 id=x></nextid><input autofocus>") (= x "<? echo('<SCR)';") (= x "<font onkeydown=""alert(1)"" contenteditable>test</font>")))
(assert (or (= z "lert(1)"" contenteditable>test</tbody>") (= z """alert(1)"" contenteditable>test</image>") (= z "yle=""transition:transform 2s"" ontransitionrun=alert(1)></rtc>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "tes" "javascript:") "ble>javascript:t</i") (= "t(" (str.substr y 21 2))))
(assert (or (str.contains (str.replace x "t" "x") "<sxy") (str.prefixof "<? echo" x)))
(assert (or (not (= (str.indexof z "sit" 0) 9)) (not (= (str.at z 22) "l")) (not (<= (str.len z) 10))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^((https?|ftp)://)?[^\s/$.?#]*\.[^\s]*$")) (= (str.at y 33) "t")))
(check-sat)
