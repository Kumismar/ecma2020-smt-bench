; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><xss style=""animation-name:x"" onanimationend=""alert(1)""></xss>") (= x "element[attribute='<img src=x onerror=alert('XSS');>")))
(assert (or (= z "=""alert(1)"">test</noframes>") (= z "mouseup=""alert(1)"">test</dfn>") (= z " autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "=""anim") (not (str.suffixof "'XSS');>" x))))
(assert (or (not (= "yle><xss" (str.substr x 25 8))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9_\+-]+(\.[A-Za-z0-9_\+-]+)*@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.([A-Za-z]{2,4})$"))) (not (= (str.at x 46) "t"))))
(assert (or (str.contains z "1)"">test") (not (str.in_re y ((_ re.from_regex ecma2020) "[+](-)(0-9)"))) (not (= (str.at x 31) "t"))))
(assert (or (not (str.contains (str.replace x "<sty" "<b>") "<b>le>@k")) (= "ames" (str.substr z 22 4)) (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,5}$")))))
(check-sat)
