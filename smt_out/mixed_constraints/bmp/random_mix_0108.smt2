(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "Redirect 302 /a.jpg http://victimsite.com/admin.asp&deleteuser") (= x "</xmp>") (= x "a=""get"";")))
(assert (or (= z "lert(1)"" contenteditable>test</\u{10348}td>") (= z "bel>") (= z "svg/1='")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 42) "a")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[^@]+@[^@]+\.[a-zA-Z]{2,}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z][a-zA-Z0-9]{5,19}$")))))
(assert (or (not (str.prefixof "</xmp>svg" y)) (str.prefixof "Redirec" y)))
(assert (not (str.prefixof "g h" z)))
(assert (or (str.contains x "/xmp>") (not (str.contains (str.replace x "ond" "javascript:") "p javascript:b"))))
(check-sat)
