; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "'-alert(1)//") (= x "<div draggable=""true"" contenteditable>drag me</div><figure ondragover=alert(1) contenteditable>drop here</figure>")))
(assert (or (= z "gator.vibrate(500)") (= z "kbd>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "v>") (not (str.contains (str.replace y "b" "javascript:") "/kjavascript:d>"))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "(?!.*@.*).*")))
(assert (not (str.contains (str.replace y "edit" "<b>") "tent<b>ab")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{407}\u{457}\u{406}\u{456}\u{404}\u{454}\u{490}\u{491}0-9\-\s]{5,60}$"))))
(assert (or (= (str.len x) 113) (not (str.in_re y ((_ re.from_regex ecma2020) "(?!00)[0-1][0-9]")))))
(assert (or (not (str.prefixof "'-a" y)) (= (str.indexof z "ate(" 0) 10) (not (= (str.indexof z "l" 0) 25))))
(assert (or (not (= (str.indexof z "kbd>" 0) 0)) (not (= (str.at y 4) " ")) (not (str.contains z "or.vi"))))
(assert (not (str.suffixof "0)" y)))
(check-sat)
