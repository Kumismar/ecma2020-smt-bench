; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<element onmouseover=""alert(1)"">test</element>") (= x "<span draggable=""true"" ondragstart=""alert(1)"">test</span>")))
(assert (or (= z "CRIPT FOR\u{20000}=document EVENT=onreadystatechange>javascript:alert(1)</SCRIPT>") (= z "el draggable=""true"" o\u{1f4a9}ndragleave=""alert(1\u{20000})"">test</label>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "CRIPT F" z) (not (str.prefixof "<title" y))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[.a-zA-z0-9_-]{1,}[@][a-z0-9_-]{1,}[.][a-z.]{3,}$")))
(assert (not (= (str.len z) 73)))
(assert (or (= (str.at z 8) "R") (not (str.suffixof "/element>" x))))
(assert (or (not (str.contains z "rue""")) (str.suffixof ")></data>" z)))
(assert (or (str.prefixof "<span drag" x) (not (str.suffixof "ead>" x))))
(check-sat)
