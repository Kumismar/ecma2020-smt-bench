; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<abbr id=x tabindex=1 onbeforeactivate=alert(1)></abbr>") (= x "<XSS STYLE=""behavior: url(%(htc)s);"">") (= x "<ins onmousedown=""alert(1)"">test</ins>")))
(assert (or (= z "eft:0;width:100%;height:100%"" onmouseover=""prompt(1)"">") (= z "t</dl>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "1)></a" (str.substr y 45 6))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\u{d1}\u{f1}\u{c1}\u{e1}\u{c9}\u{e9}\u{cd}\u{ed}\u{d3}\u{f3}\u{da}\u{fa}\s]+$"))) (not (str.suffixof "er>" y))))
(assert (str.prefixof "t</d" z))
(assert (or (= (str.at y 24) "1") (not (= (str.at y 33) ")"))))
(assert (not (str.contains z "itable>d")))
(assert (or (not (= """p" (str.substr y 80 2))) (not (str.prefixof "t</dl" z))))
(assert (or (not (str.suffixof "</dl>" z)) (= "<abbr id=x tabindx=1 onbeforeactivate=alert(1)></abbr>" (str.replace x "e" "")) (str.contains z "/dl>")))
(check-sat)
