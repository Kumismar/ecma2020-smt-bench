; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><param id=x style=""transition:color 1s"" ontransitionend=alert(1)></param>") (= x "<samp onbeforecut=""alert(1)"" contenteditable>test</samp>") (= x "<;HTML>;<;BODY>;")))
(assert (or (= z "&gt;") (= z "ndragstart=""alert(1)"">test</a>") (= z "onbeforeactivate=alert(1)></cite>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<" y))
(assert (or (not (str.prefixof "html id=" z)) (str.suffixof "u>" x) (str.in_re x ((_ re.from_regex ecma2020) "[0-9 \(\)\-\+]{5,15}"))))
(assert (not (= "t;" (str.substr z 2 6))))
(assert (or (not (str.contains z "test</a")) (not (str.prefixof "<sa" y)) (not (= (str.indexof z "al" 0) 17))))
(assert (or (not (str.contains y "\u{20000}est")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z][A-Za-z0-9 _,-.'!?]*$"))) (not (= "&;" (str.replace z "gt" "")))))
(check-sat)
