; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address onmouseleave=""alert(1)"">test</address>") (= x "<html id=x tabindex=1 onactivate=alert(1)></html>") (= x "<rtc onfocusout=alert(1) tabindex=1 id=x></rtc><input autofocus>")))
(assert (or (= z """ contenteditable>test</label>") (= z "ontenteditable>test</strike>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "d=x t" 0) 7))
(assert (or (not (>= (str.len x) 34)) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*[A-Za-z])(?=.*\d)(?=.*[@$!%.,:;-_^\u{b0}+*#?&])[A-Za-z\d@$!%.,:;-_^\u{b0}+*#?&]{8,}$"))) (str.contains x "tml>")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9,.!? ]*$"))))
(assert (not (<= (str.len x) 53)))
(assert (or (str.contains z "est</") (not (= "lert(1)>" (str.substr y 34 8)))))
(assert (or (str.contains (str.replace z "able>" "javascript:") "editjavascript:t") (not (= (str.len x) 56))))
(check-sat)
