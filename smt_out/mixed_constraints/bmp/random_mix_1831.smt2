; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frame draggable=""true"" ondrag=""alert(1)"">test</frame>") (= x """`'><script>\x7Ejavascript:alert(1)</script>")))
(assert (or (= z "e>") (= z " oncut=""alert(1)"" contenteditable>test</html>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9.-]+$"))))
(assert (or (= (str.len x) 44) (str.in_re z ((_ re.from_regex ecma2020) "^(4)$")) (= (str.at y 62) "c")))
(assert (not (= (str.indexof y ")</sc" 0) 34)))
(assert (not (= (str.at y 16) "u")))
(assert (not (str.suffixof "autofocus>" z)))
(assert (not (= "t</frame>" (str.substr y 45 9))))
(check-sat)
