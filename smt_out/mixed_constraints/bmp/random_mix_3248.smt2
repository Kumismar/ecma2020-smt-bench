; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe src=mhtml:http://html5sec.org/test.gif!xss.html></iframe>//[""'`-->]]>]</div>") (= x "<noscript id=x tabindex=1 onactivate=alert(1)></noscript>")))
(assert (or (= z "nclick=""alert(1)"">test</rt>") (= z "ascript:alert(1)// */</script>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "test</rt>" y) (not (str.prefixof "<iframe" y)) (= "lert(1)"">" (str.substr z 9 9))))
(assert (or (= ")></noscr" (str.substr x 44 9)) (= (str.at x 52) "t")))
(assert (or (not (str.suffixof "t(1)></em>" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9a-zA-Z ]+$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[ _A-z\u{410}-\u{44f}0-9]{1,}$"))))
(assert (or (not (= (str.indexof z "(1)/" 0) 13)) (not (str.prefixof "<" x))))
(assert (not (= "<iframe src=mhtml:http://htmlxsec.org/test.gif!xss.html></iframe>//[""'`-->]]>]</div>" (str.replace x "5" "x"))))
(check-sat)
