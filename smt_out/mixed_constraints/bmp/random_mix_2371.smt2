; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "foo<script>alert(1)</s\u{10348}cript>") (= x "<acro\u{1f4a9}nym onbeforepaste=""alert(1)"" contenteditable>test</acronym>")))
(assert (or (= z "(1)""></shadow>") (= z "test</br>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof z "/sel" 0) 33) (not (str.in_re z ((_ re.from_regex ecma2020) "cvc")))))
(assert (or (not (str.prefixof "<acr" y)) (not (= (str.indexof y "table" 0) 45)) (not (str.contains x ")</s\u{10348}cri"))))
(assert (or (= (str.at x 8) "p") (not (str.suffixof "shadow>" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[\\.0-9]+$")))))
(assert (or (>= (str.len x) 19) (not (str.suffixof "st</br>" z))))
(assert (str.contains z """></s"))
(check-sat)
