; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a draggable=""true"" ondrag=""alert(1)"">test</a>") (= x "<big onmouseout=""alert(1)"">test</big>")))
(assert (or (= z "rt(1)"">test</p\u{1d400}rogress>") (= z "lert(1)"">test</html>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "ogre" "alert(1)") "p\u{1d400}ralert(1)ss")) (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+]{1}[a-zA-Z0-9._%+-]*@([a-zA-Z0-9-]{2,63}\.)+[a-zA-Z]{2,7}$")) (str.contains y "tes")))
(assert (str.prefixof "rt" z))
(assert (or (not (= (str.indexof z "1)""" 0) 5)) (<= (str.len z) 26)))
(assert (str.prefixof "<a dr" y))
(assert (or (= (str.at y 37) ">") (not (= (str.at x 44) "t"))))
(assert (or (<= (str.len x) 53) (= "/html>" (str.substr z 14 7)) (= "javasc" (str.substr y 77 6))))
(assert (not (str.suffixof "l>" y)))
(check-sat)
