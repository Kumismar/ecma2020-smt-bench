; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b oncontextmenu=""alert(1)"">test</b>") (= x "<big draggable=""true"" ondragend=""alert(1)"">test</big>") (= x "<svg><noembed onload=alert(1)></noembed>")))
(assert (or (= z "seenter=""alert(1)"">test</blockquote>") (= z "c=""http://google.com""%%203E") (= z "nteditable>drag me</div><listing ondragover=alert(1) contenteditable>drop here</listing>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 22) "o")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[w]{3}\.[A-Za-z0-9._%+-]*\.[A-Za-z]{2,3}$"))))
(assert (or (= "b>" (str.substr x 34 7)) (not (= (str.at z 46) "e")) (= (str.indexof y "textm" 0) 8)))
(assert (or (str.contains z "lockquot") (<= (str.len z) 44)))
(assert (or (not (str.contains z "ditable>")) (= (str.len z) 27) (str.in_re z ((_ re.from_regex ecma2020) "^\+?[0-9]{8,14}$"))))
(assert (not (= (str.at z 1) "e")))
(assert (or (not (str.prefixof "c=""ht" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{1,9}|[0-9]{19}")))))
(check-sat)
