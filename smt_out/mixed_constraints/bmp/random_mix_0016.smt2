; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><figcaption ondragover=alert(1) contenteditable>drop here</figcaption>") (= x "<style>@keyframes x{}</style><strong style=""animation-name:x"" onanimationstart=""alert(1)""></strong>")))
(assert (or (= z "ontenteditable>test</var>") (= z "nbeforeactivate=alert(1)></table>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof z "</" 0) 25))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "\d{4,5}"))) (str.prefixof "<style" x)))
(assert (or (<= (str.len z) 36) (not (str.in_re z ((_ re.from_regex ecma2020) "(^\?$|^er\.[\d]{4}-[\d]{2}-[\d]{2}\.[\d.-]+)")))))
(assert (or (str.contains (str.replace x "e:x""" """") "nam"" ") (not (str.prefixof "<style>@k" y)) (str.contains (str.replace y "ar" """") "ionst""t=""al")))
(assert (or (not (str.contains x "{}<")) (str.suffixof "caption>" x) (not (str.in_re y ((_ re.from_regex ecma2020) "[+]{1}[7]{1}\s[(]{1}[9]{1}[0-9]{2}[)]{1}\s[0-9]{3}\s[0-9]{2}[-]{1}[0-9]{2}")))))
(assert (str.suffixof "est</var>" y))
(assert (= "d=" (str.substr z 42 2)))
(check-sat)
