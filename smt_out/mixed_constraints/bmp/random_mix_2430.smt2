; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite onblur=alert(1) tabindex=1 id=x></cite><input autofocus>") (= x "<content oncontextmenu=""alert(1)"">test</content>") (= x "<listing draggable=""true"" ondragleave=""alert(1)"">test</listing>")))
(assert (or (= z "x style=""transition:color 10s"" ontransitioncancel=alert(1)></ins>") (= z "table>test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (or (= """ ontr" (str.substr y 77 6)) (not (<= (str.len y) 74))))
(assert (or (not (= "<" (str.substr y 58 1))) (= (str.indexof x "x" 0) 13) (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z ]+"))))
(assert (or (not (str.prefixof "<" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-z \/\\\.0-9]*$"))) (= (str.indexof z "lert" 0) 14)))
(assert (or (not (str.suffixof "</ins>" z)) (not (= (str.indexof z "ainte" 0) 14))))
(assert (not (= "extmen" (str.substr x 15 6))))
(check-sat)
