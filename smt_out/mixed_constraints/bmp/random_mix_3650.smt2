; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<set attributeName=""xlink:href"" begin=""accessKey(d)"" to=""//example.com/?d"" />") (= x "<svg><col onload=alert(1)></col>")))
(assert (or (= z "1)></mark>") (= z "test</center>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "test<xenter>" (str.replace z "/c" "x"))) (not (str.contains z "ark>"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^\(?(\d{3})\)?[\s.-]?(\d{3})[\s.-]?(\d{4})$"))))
(assert (or (= (str.at z 0) "1") (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{5,5}"))) (not (= (str.len y) 45))))
(assert (or (not (= (str.len z) 10)) (not (str.contains (str.replace x "ad" "") "nlo=aler"))))
(assert (not (= (str.at z 1) ")")))
(check-sat)
