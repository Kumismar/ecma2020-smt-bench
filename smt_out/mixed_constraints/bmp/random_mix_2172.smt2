; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex draggable=""true"" ondragleave=""alert(1)"">test</isindex>") (= x "<span id=x tabindex=1 onfocusin=alert(1)></span>")))
(assert (or (= z "able=""true"" ondragend=""alert(1)"">test</mark>") (= z "rt(1) tabindex=1 id=x></source><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "(1)></span" (str.substr x 37 10))) (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{8,10}$")))))
(assert (or (not (str.contains x "1 onfoc")) (= (str.len z) 48) (not (= (str.indexof z "=1 " 0) 14))))
(assert (or (not (str.contains (str.replace y "sou" """") "/""rce")) (not (= "(1)"">tes" (str.substr x 17 8)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{3,25}$"))) (= (str.at x 13) "g")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9A-Z]{8}$"))) (not (str.suffixof "head>" z)) (not (str.contains x "x draggab"))))
(assert (or (not (= "rue"" ondr" (str.substr x 21 9))) (str.suffixof "est</mark>" z)))
(assert (not (= (str.at x 21) " ")))
(check-sat)
