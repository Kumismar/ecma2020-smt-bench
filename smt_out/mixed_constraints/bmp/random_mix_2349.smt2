; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<kbd onfocusout=alert(1) tabindex=1 id=x></kbd><input autofocus>") (= x "<marquee onblur=alert(1) tabindex=1 id=x></marquee><input autofocus>")))
(assert (or (= z "nteditable>test</s>") (= z "test</mark>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 3) (= "d=" (str.substr x 37 2))))
(assert (or (str.contains x "uee o") (not (= (str.indexof y "s>nt" 0) 66)) (str.suffixof "s>" x)))
(assert (or (str.prefixof "<marquee " x) (= "<kbd onfocusout=alert(1) tabindex=1 id=x></kbd><input autofocus<b></mark>" (str.replace y ">test" "<b>")) (= (str.len x) 68)))
(assert (or (not (= (str.indexof y "alert" 0) 16)) (not (str.contains x "qu")) (not (= "<in" (str.substr y 51 3)))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\.\s]{1,40}$")) (not (= "le>t" (str.substr z 8 4)))))
(assert (or (str.suffixof "test</s>" y) (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{8,10}$")))))
(check-sat)
