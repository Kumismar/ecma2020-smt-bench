; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure id=x tabindex=1 ondeactivate=alert(1)></figure><input id=y autofocus>") (= x "<article onmouseleave=""alert(1)"">test</article>")))
(assert (or (= z "vate=alert(1)></track><input autofocus>") (= z "tton onkeyup=""alert(1)"" contenteditable>test</button>") (= z "out=""alert(1)"">test</ruby>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$"))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[9|8|7|6|5|4|3|2|1|0]\d{8}$")))))
(assert (or (not (str.contains x ")"">te")) (= (str.at z 35) "a")))
(assert (or (not (str.suffixof "on>" y)) (not (str.prefixof "<fi" x)) (not (str.prefixof "<blockq" y))))
(assert (or (not (str.suffixof "focus>" z)) (not (str.suffixof "</article>" x)) (not (= (str.at y 69) "t"))))
(assert (not (= (str.indexof y "rt" 0) 80)))
(assert (not (str.prefixof "/param" z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9 _.-]{4,20}"))))
(check-sat)
