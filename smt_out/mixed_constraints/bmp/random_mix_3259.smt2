; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT a=&quot;blah&quot; &apos;&apos; SRC=&quot;http://ha.ckers.org/xss.js&quot;&gt;&lt;/SCRIPT&gt;") (= x "<command draggable=""true"" ondragend=""alert(1)"">test</command>")))
(assert (or (= z "cript:document.vulnerable=true;"">") (= z "ble>test</shadow>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[a-z\u{e9}\u{e8}\u{e2}]{3,30}")) (not (= "shadow>" (str.substr y 71 9)))))
(assert (or (= "h" (str.substr z 11 1)) (= (str.at x 55) "t") (str.suffixof "shadow>" z)))
(assert (or (str.suffixof "true;"">" z) (not (str.in_re y ((_ re.from_regex ecma2020) ".{1,128}")))))
(assert (not (str.suffixof "iframe>" x)))
(check-sat)
