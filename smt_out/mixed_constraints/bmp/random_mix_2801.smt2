; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dfn onfocusout=alert(1) tabindex=1 id=x></dfn><input autofocus>") (= x "<body BACKGROUND=""javascript:document.vulnerable=true;"">")))
(assert (or (= z "';XSS';)<;/SCRIPT>;") (= z "1)></dt>") (= z "abindex=1 id=x></picture><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "ocus>" x))
(assert (or (not (= (str.at z 6) "t")) (not (>= (str.len z) 41))))
(assert (not (= "e;"">1)" (str.substr y 52 6))))
(assert (or (= (str.at y 40) "l") (not (str.suffixof "T>;" y))))
(assert (not (= "u" (str.substr z 21 1))))
(assert (or (not (str.contains y "sout=")) (not (= (str.len y) 75)) (str.contains x "y BACKGRO")))
(assert (or (not (str.suffixof ">" z)) (= (str.indexof y "sout=" 0) 11)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[+]{0,1}(\d){1,3}[ ]?([-]?((\d)|[ ]){1,12})+$"))))
(check-sat)
