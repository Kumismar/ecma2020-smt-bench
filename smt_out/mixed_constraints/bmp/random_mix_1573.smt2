; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;A HREF=&quot;javascript:document.location=&apos;http://www.google.com/&apos;&quot;&gt;XSS&lt;/A&gt;") (= x "<x onmouseout=alert(1)>hover this!")))
(assert (or (= z "lert(1)></progress><input autofocus>") (= z ":red;}</style><ul id=x style=""transition:color 1s"" ontransitionend=alert(1)></ul>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "&lt;A " x)))
(assert (<= (str.len y) 146))
(assert (= (str.indexof y "/" 0) 43))
(assert (not (str.prefixof "<x onmou" x)))
(assert (= "1)></prog" (str.substr y 39 9)))
(assert (or (not (str.contains (str.replace y "on" "javascript:") "tijavascript:=&")) (not (= (str.indexof x ";&qu" 0) 79))))
(assert (or (not (= (str.at z 77) "/")) (not (= (str.len y) 139)) (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z-.\u{f3},]|[\u{e0}-\u{fa}]|[\u{c0}-\u{da}]|[-z0-9-\s])+$"))))
(check-sat)
