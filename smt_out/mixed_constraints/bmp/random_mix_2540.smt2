; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<frameset><frame onload=alert(1)>") (= x "<video src=1 href=1 onerror=""javascript:alert(1)""></video>")))
(assert (or (= z """>test</a>") (= z "ge=alert(1)>") (= z "test</audio>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "rt(1)>" z)) (not (str.contains x "video sr")) (not (<= (str.len z) 11))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9_ ]{1,64}$"))) (not (= (str.len x) 58)) (str.contains y "avascript")))
(assert (or (not (= (str.indexof z "t(1)" 0) 7)) (not (str.suffixof "st</a>" y)) (not (= (str.len z) 12))))
(assert (or (str.prefixof "<frameset" y) (str.suffixof "io>" z) (= (str.at y 47) ")")))
(assert (not (= (str.at x 0) "<")))
(check-sat)
