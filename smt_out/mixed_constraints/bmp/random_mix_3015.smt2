; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;SCRIPT a=`&gt;` SRC=\""http&#58;//ha&#46;ckers&#46;org/xss&#46;js\""&gt;&lt;/SCRIPT&gt;") (= x "<span oncontextmenu=""alert(1)"">test</span>") (= x "<style>:target {transform: rotate(180deg);}</style><img id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></img>")))
(assert (or (= z "le>drop here</caption>") (= z "MG LOWSRC=\""javascript&#058;alert('XSS')\""&gt;")))
(assert (= y (str.++ x z)))
(assert (not (= "gt;" (str.substr y 15 3))))
(assert (or (str.contains z ">test</vi") (not (= (str.len z) 39)) (>= (str.len x) 83)))
(assert (or (not (= (str.at z 3) "d")) (= (str.indexof y ";org/" 0) 53)))
(assert (= (str.indexof x "me" 0) 15))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^([A-Za-z]+(\.?\s)?)+[A-Za-z]+$")) (= (str.len z) 22)))
(assert (or (not (= "CRIPT&gt;l" (str.substr y 80 10))) (not (= "text" (str.substr x 10 4)))))
(check-sat)
