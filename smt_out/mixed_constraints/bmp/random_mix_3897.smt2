; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{1f4a9}<rtc draggable=""true"" ondragstart=""alert(1)"">test</rtc>") (= x "<del onmousemove=""alert(1)"">test</del>")))
(assert (or (= z "ng onmouseleave=""alert(1)"">test</listing>") (= z "ondragend=""alert(1)"">test</h1>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9`~!@$^().\-_]{8,39}"))) (not (str.contains z "seleave="""))))
(assert (not (str.suffixof "test</rtc>" x)))
(assert (or (not (str.contains (str.replace x "dra" "") "<rtc gga")) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$")))))
(assert (or (not (= "<script for=documejavascript: event=onreadystatechange>getElementById('safe123').click()</script>" (str.replace x "nt" "javascript:"))) (= ")"">t" (str.substr x 43 4))))
(assert (or (str.suffixof "sting>" z) (not (str.contains (str.replace y "e" "javascript:") "ggabljavascript:=""tru")) (= (str.at y 15) "=")))
(assert (or (not (str.suffixof ">" z)) (str.contains y "ndragen")))
(assert (or (not (str.prefixof "<del " x)) (str.contains y "/d")))
(check-sat)
