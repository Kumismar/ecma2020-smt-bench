; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><cite ond\u{1f4a9}ragover=alert(1) contenteditable>drop here</cite>") (= x "<button onmouseleave=""alert(1)"">test</button>") (= x "<\u{10348}element ondblclick=""alert(1)"">test</element>")))
(assert (or (= z "able>test</ruby>") (= z "cument.vulnerable=true;</script>"">") (= z "nu>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 31) ">")) (str.suffixof ">" y) (not (str.in_re y ((_ re.from_regex ecma2020) "^([\w\.\-]+)@([\w\-]+)((\.(\w){2,3})+)$")))))
(assert (or (not (<= (str.len y) 59)) (str.contains z "cript>"">") (str.suffixof "t>"">" y)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.,_ \-]+$"))) (not (= "e" (str.substr y 14 1))) (not (<= (str.len z) 17))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{9,12}"))))
(assert (or (= "<buttojavascript: onmouseleave=""alert(1)"">test</button>" (str.replace x "n" "javascript:")) (not (str.contains x "eave=""")) (not (= (str.at y 5) "d"))))
(check-sat)
