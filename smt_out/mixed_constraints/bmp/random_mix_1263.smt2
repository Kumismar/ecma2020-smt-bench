; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><nextid style=""animation-name:x"" onanimationend=""alert(1)""></nextid>") (= x "<iframe/src \/\/onload = prompt(1)") (= x "&lt;SCRIPT \""a='&gt;'\"" SRC=\""http&#58;//ha&#46;ckers&#46;org/xss&#46;js\""&gt;&lt;/SCRIPT&gt;")))
(assert (or (= z "aram onmouseout=""a\u{1d400}lert(1)"">test</param>") (= z "ex=1 onbeforeactivate=alert(1)></optgroup>") (= z "e>test</address>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) ".{18,19}"))) (not (= (str.indexof x "vascr" 0) 26)) (str.contains z "teditable")))
(assert (not (str.suffixof "d>" x)))
(assert (str.contains y "t</addr"))
(assert (or (>= (str.len y) 127) (not (str.prefixof "<style>@k" x))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Z]{1}[0-9]{7}[A-Z0-9]{1}$|^[T]{1}[A-Z0-9]{8}$|^[0-9]{8}[A-Z]{1}$"))))
(assert (not (str.contains z "ivate=al")))
(assert (= "n" (str.substr x 30 1)))
(check-sat)
