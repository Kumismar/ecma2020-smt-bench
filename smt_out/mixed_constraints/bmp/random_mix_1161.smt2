; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<http://onxxx%3D1/") (= x "<\u{1d400}abbr onbeforecopy=""alert(1)"" contenteditable>test</abbr>")))
(assert (or (= z "ta onmouseover=""alert(1)"">test</meta>") (= z "t;&lt;FRAME SRC=&quot;javascript:alert(&apos;XSS&apos;);&quot;&gt;&lt;/FRAMESET&gt;") (= z "test</sup>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "br>" x)) (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9][a-zA-Z0-9\-]+")) (str.in_re z ((_ re.from_regex ecma2020) "[\+\-\s0-9()]+"))))
(assert (= "st</su" (str.substr y 20 6)))
(assert (or (str.suffixof "meta>" z) (not (= (str.at y 21) "o"))))
(assert (or (not (str.contains (str.replace y "://" " ") "tp onxx")) (not (str.contains (str.replace z "T&" "alert(1)") "MESEalert(1)g")) (not (str.suffixof "</meta>" z))))
(assert (or (not (= (str.indexof x "r" 0) 5)) (not (str.contains x "D1")) (= (str.indexof x ")"" c" 0) 28)))
(assert (= (str.at x 17) "/"))
(assert (or (not (>= (str.len z) 4)) (not (= (str.indexof z "/" 0) 5))))
(check-sat)
