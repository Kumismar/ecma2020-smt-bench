; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark id=x tabindex=1 onbeforeactivate=alert(1)></mark>") (= x "<nobr id=x tabindex=1 onfocusin=alert(1)></nobr>") (= x "<input onmousemove=""alert(1)"">test</input>")))
(assert (or (= z "#91;code&#93;\""&gt;") (= z "\u{1d400}t(1)"">test</map\u{10348}>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len x) 51)) (not (= "tes" (str.substr z 7 3))) (= "<nobr id=x tabindex=1 onfocusin=alert(1)><b>r>" (str.replace x "</nob" "<b>"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^.{5,16}$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{1,3}([a-z]?)$"))) (str.prefixof "#91;" z)))
(assert (or (str.contains z ";cod") (not (str.prefixof "<fra" y)) (str.suffixof ">test</br>" x)))
(assert (str.suffixof ";\""&gt;" y))
(assert (str.prefixof "<inpu" y))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^((\+|00)33\s?|0)[1-9](\s?\d{2}){4}$"))))
(assert (or (str.contains x "confi") (= (str.at z 15) "&")))
(assert (str.contains y "(1)"">te"))
(check-sat)
