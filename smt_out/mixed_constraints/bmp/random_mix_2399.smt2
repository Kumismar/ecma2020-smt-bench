; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dt onkeydown=""alert(1)"" contenteditable>test</dt>") (= x "<nextid onbeforepaste=""alert(1)"" contenteditable>test</nextid>") (= x "<br draggable=""true"" ondragstart=""alert(1)"">test</br>")))
(assert (or (= z "=""alert(1)"">test</object>") (= z " onmouseover=""alert(1)"">test</iframe>") (= z "ert(1)>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 5) ")")))
(assert (or (not (= """nkeydown=""alert(1)"" contenteditable>test</dt> onmouseover=""alert(1)"">test</iframe>" (str.replace y "<dt o" """"))) (not (= """>te" (str.substr z 10 4))) (not (= "ch" (str.substr x 31 2)))))
(assert (or (str.suffixof "(1)>" y) (<= (str.len y) 91)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^\+38\s?\(\d{3}\)\s?\d{3}-?\d{2}-?\d{2}$"))) (not (str.contains (str.replace x "eydo" "javascript:") "t onkjavascript:wn=""a"))))
(assert (or (= (str.len z) 7) (not (= "embed>" (str.substr x 57 6)))))
(check-sat)
