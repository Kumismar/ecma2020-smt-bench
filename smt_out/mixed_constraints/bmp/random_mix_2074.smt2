; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img STYLE=""xss:expr/*XSS*/ession(document.vulnerable=true)"">") (= x "<div draggable=""true"" contenteditable>drag me</div><acronym ondrop=alert(1) contenteditable>drop here</acronym>")))
(assert (or (= z "contenteditable>test</figure>") (= z "re draggable=""true"" ondragenter=""alert(1)"">test</figure>") (= z "alert(1)"">test</tfoot>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len y) 140)))
(assert (= "textmenu=""" (str.substr y 13 10)))
(assert (or (str.suffixof "e>" z) (not (str.prefixof "<div drag" x))))
(assert (or (not (= "ner" (str.substr y 46 3))) (not (= "<img STYLE=""xss:expr/*XSS*/ession(document.vulnerablalert(1)rue)"">" (str.replace x "e=t" "alert(1)")))))
(assert (or (str.suffixof "igure>" z) (not (str.prefixof "<div dra" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[^0-9<>%]*$")))))
(assert (not (= (str.len z) 29)))
(check-sat)
