; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<th onmouseleave=""alert(1)"">test</th>") (= x "<svg><plaintext onload=alert(1)></plaintext>") (= x "<style>:target {transform: rotate(180deg);}</style><nav id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></nav>")))
(assert (or (= z "drop here</blockquote>") (= z "t</del>") (= z "id=x></multicol><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "=""a" z) (not (str.contains x "lert(1)")) (not (= "/t" (str.substr y 73 2)))))
(assert (not (= (str.at z 20) "u")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "([0-9]|\$|,|.)+"))) (not (= "nsform 2s""" (str.substr y 82 10)))))
(assert (or (not (str.suffixof "s>;" z)) (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9]{9}$"))))
(assert (not (= "t</d" (str.substr z 0 4))))
(assert (not (str.contains (str.replace z "</de" "") "tl")))
(assert (or (not (= (str.indexof y "a" 0) 9)) (= (str.indexof z "l" 0) 5)))
(assert (or (not (str.prefixof "t<" z)) (str.prefixof "<st" y)))
(check-sat)
