; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<datalist on\u{10348}keyup=""alert(1)"" contenteditable>test</datalist>") (= x "<slot oncopy=""alert(1)"" contenteditable>test</slot>")))
(assert (or (= z "nput id=y autofocus>") (= z "le=""true"" ondragstart=""alert(1)"">test</ol>") (= z "test</source>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9a-zA-Z\u{e4}\u{c4}\u{f6}\u{d6}\u{fc}\u{dc}\-]*\.[0-9A-Za-z]*$"))) (not (= "<slot oncopy=""alert(1)"" co<b>enteditable>test</slot>" (str.replace x "nt" "<b>")))))
(assert (or (= (str.len y) 45) (str.suffixof "urce>" z)))
(assert (or (not (str.suffixof " -->" z)) (str.contains z "true"" ondr")))
(assert (not (str.suffixof "st</ol>" z)))
(assert (or (not (<= (str.len y) 78)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[1-9][0-9]{7,12}$"))) (not (str.prefixof "<slot " x))))
(assert (not (= (str.indexof z "c" 0) 16)))
(check-sat)
