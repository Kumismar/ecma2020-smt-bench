; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<content onbeforepaste=""alert(1)"" contenteditable>test</content>") (= x "<style>:target {color: red;}</style><section id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></section>")))
(assert (or (= z "alert(1) \u{1f600}tabindex=1 id=x></basefont><input autofocus>") (= z "ex=1 onfocusin=alert(1)></element>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<content""beforepaste=""alert(1)"" contenteditable>test</content>ex=1 onfocusin=alert(1)></element>" (str.replace y " on" """"))) (not (str.suffixof "t>" z)) (str.prefixof "<cite " x)))
(assert (or (= "style=""tr" (str.substr x 50 9)) (str.suffixof "element>" z) (str.suffixof "ion>" x)))
(assert (or (= (str.at x 15) "{") (= (str.at y 114) "o")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "1[34578]\d{9}$"))) (= (str.len x) 117)))
(check-sat)
