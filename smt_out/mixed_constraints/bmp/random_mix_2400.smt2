; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><tfoot style=""animation-name:x"" onanimationstart=""alert(1)""></tfoot>") (= x "<figcaption onmousedown=""alert(1)"">test</figcaption>")))
(assert (or (= z "test</map>") (= z "orecut=""alert(1)"" contenteditable>test</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (= "<figcaption""nmousedown=""alert(1)"">test</figcaption>" (str.replace x " o" """")) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9\s-]{5,}")))))
(assert (or (not (str.suffixof "igcaption>" x)) (not (str.contains (str.replace x "/tfoo" "alert(1)") "<alert(1)t>")) (not (= (str.indexof z "est" 0) 1))))
(assert (= "<figcapjavascript:ion onmousedown=""alert(1)"">test</figcaption>orecut=""alert(1)"" contenteditable>test</bdi>" (str.replace y "t" "javascript:")))
(assert (or (<= (str.len z) 13) (= (str.at z 35) "e") (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9]{8,16}"))))
(assert (= (str.at z 5) "t"))
(assert (= (str.at y 10) "y"))
(assert (or (str.suffixof "est</bdi>" y) (not (>= (str.len x) 48)) (str.prefixof "t" z)))
(check-sat)
