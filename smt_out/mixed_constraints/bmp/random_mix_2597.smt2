; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><li ondrop=alert(1) contenteditable>drop here</li>") (= x "<table id=x t\u{1f4a9}abindex=1 onfocus=alert(1)></table>") (= x "<listing onmouseup=""alert(1)"">test</listing>")))
(assert (or (= z "ragend=""a\u{1f600}lert(1)"">t\u{1f600}est</bdo>") (= z "le>test</dt>") (= z "ta>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 39) (= (str.indexof x """>t" 0) 28) (not (str.suffixof "est</dt>" z))))
(assert (or (not (= "\u{1f600}lert(" (str.substr z 9 6))) (not (= "<div draggable=""true"" contenteditable>drag me</div><li ondrop=alert(1) contenteditable>drop ""/li>" (str.replace x "here<" """")))))
(assert (or (= "dex=1 onf" (str.substr x 18 9)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[^@]+@[^\.]+\..+$"))) (not (str.prefixof "<di" x))))
(assert (or (= (str.indexof x ">" 0) 40) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\s]+$")))))
(check-sat)
