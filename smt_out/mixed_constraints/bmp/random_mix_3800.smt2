; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;DIV STYLE=\""background-image&#58; url(javascript&#058;alert('XSS'))\""&gt;") (= x "<multicol onmouseup=""alert(1)"">test</multicol>")))
(assert (or (= z "put draggable=""true"" ondragenter=""alert(1)"">test</input>") (= z "<img/onerror=\x60javascript:alert(1)\x60src=xxx:x />")))
(assert (= y (str.++ x z)))
(assert (= "&lt;DIV SxYLE=\""background-image&#58; url(javascript&#058;alert('XSS'))\""&gt;" (str.replace x "T" "x")))
(assert (or (str.contains y "x60src=x") (not (str.suffixof "gt;" x)) (not (str.prefixof "<mul" x))))
(assert (or (= (str.len x) 46) (not (= " draggable" (str.substr y 49 10))) (str.in_re y ((_ re.from_regex ecma2020) "\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b"))))
(assert (not (= (str.at y 83) "r")))
(assert (str.suffixof "=xxx:x />" y))
(assert (or (str.contains x "#58; u") (= (str.indexof x "\""ba" 0) 14)))
(assert (or (not (= "est</multi" (str.substr x 32 10))) (= (str.len y) 133) (not (= "n" (str.substr z 28 1)))))
(check-sat)
