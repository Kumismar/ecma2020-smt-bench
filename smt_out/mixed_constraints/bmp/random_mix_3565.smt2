; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<font onkeypress=""alert(1)"" contenteditable>test</font>") (= x "<;TABLE>;<;TD BACKGROUND="";javascript:alert(';XSS';)"";>;<;/TD>;<;/TABLE>;")))
(assert (or (= z "sv\u{20000}g/onload=alert(1)") (= z ">") (= z "nmouseup=""alert(1)"">test</base>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[\+\-0-9]*$"))) (str.contains x "sourc") (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z-z\u{17c}\u{17a}\u{107}\u{144}\u{f3}\u{142}\u{119}\u{105}\u{15b}\u{17b}\u{179}\u{106}\u{104}\u{15a}\u{118}\u{141}\u{d3}\u{143}\u{f6}\u{e4}\u{fc}\u{d6}\u{c4}\u{dc}\u{df}]+ [a-zA-Z-z\u{17c}\u{17a}\u{107}\u{144}\u{f3}\u{142}\u{119}\u{105}\u{15b}\u{17b}\u{179}\u{106}\u{104}\u{15a}\u{118}\u{141}\u{d3}\u{143}\u{f6}\u{e4}\u{fc}\u{d6}\u{c4}\u{dc}\u{df}]+"))))
(assert (not (str.prefixof "<noscri" y)))
(assert (not (= (str.indexof z "scrip" 0) 6)))
(assert (or (not (= "<;TABLE>;<;TD BACKGROUND="";jalert(1)vascript:alert(';XSS';)"";>;<;/TD>;<;/TABLE>;" (str.replace x "a" "alert(1)"))) (= (str.at z 0) ">")))
(assert (or (not (= "alert(1)" (str.substr z 12 8))) (not (= "e>test<" (str.substr x 42 7)))))
(check-sat)
