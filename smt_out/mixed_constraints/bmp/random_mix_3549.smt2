; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby oncut=""alert(1)"" contenteditable>test</ruby>") (= x "<legend oncontextmenu=""alert(1)"">test</legend>") (= x "'); alert('XSS")))
(assert (or (= z "ea id=ta onfocus=%22write('<script>alert(1)</script>')%22 autofocus></textarea>") (= z "<input id\u{1f600}=y\u{20000} autofocus>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 22) " "))
(assert (or (str.contains z "cript>')%2") (str.contains z "ofocus")))
(assert (= (str.indexof y "auto" 0) 28))
(assert (or (str.contains (str.replace y "S<i" "<b>") "S<b>n") (<= (str.len x) 48)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[+]?[/./s/-/(/)/*/#0-9]{3,}"))) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+.[a-z]{2,}$")))))
(assert (or (= (str.at y 30) ")") (str.suffixof ">" y) (not (= "<legend oncontextmenu=""alert(1)"">test</legend>ea id=ta onfocus=%22write('<sipt>alert(1)</script>')%22 autofocus></textarea>" (str.replace y "cr" "")))))
(assert (= (str.at x 3) "b"))
(assert (or (not (= (str.len z) 79)) (<= (str.len y) 84)))
(check-sat)
