; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<address draggable=""true"" ondragenter=""alert(1)"">test</address>") (= x "<address onkeyup=""alert(1)"" contenteditable>test</address>")))
(assert (or (= z "raggable=""true"" ondragenter=""alert(1)"">test</option>") (= z "rt(1)>") (= z "e src=http://xss.rocks/scriptlet.html <")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 25) "e")) (not (str.prefixof "e src=h" z))))
(assert (or (str.contains z "rt") (not (str.in_re z ((_ re.from_regex ecma2020) "^[^\s][A-Za-z -]+$"))) (= ")>" (str.substr z 4 9))))
(assert (or (not (str.contains (str.replace z "rt(1)" "") ">")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9-_\.]{5,20}$")))))
(assert (or (= (str.indexof x "ed" 0) 35) (not (= (str.at z 48) "i")) (= "ddress on" (str.substr x 2 9))))
(assert (str.prefixof "<" x))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "\([0-9]{2}\)[\s][0-9]{4}-[0-9]{4}"))))
(check-sat)
