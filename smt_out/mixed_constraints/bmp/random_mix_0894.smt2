; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blink ondbl\u{1d400}click=\u{1f4a9}""alert(1)"">test</blink>") (= x "<div draggable=""true"" contenteditable>drag me</div><address ondragover=alert(1) contenteditable>drop here</address>")))
(assert (or (= z "rue"" contenteditable>drag me</div><article ondrop=alert(1) contenteditable>drop here</article>") (= z "id=x style=""transition:color 1s"" ontransitionend=alert(1)></col>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[^<>\\/]+$"))))
(assert (or (not (str.prefixof "id=x" z)) (= (str.at y 42) "=")))
(assert (or (not (str.contains y "ansiti")) (= "teditab" (str.substr y 28 7)) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{9,20}")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9,.!? ]*$"))) (not (= (str.indexof x "e" 0) 13)) (not (= (str.indexof x "able" 0) 10))))
(assert (or (not (str.suffixof ")></col>" y)) (= (str.len z) 94) (str.contains y ") c")))
(assert (or (str.contains y "matio\u{10348}n-") (not (= "ty" (str.substr z 6 2)))))
(assert (str.prefixof "rop her" z))
(check-sat)
