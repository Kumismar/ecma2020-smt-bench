; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\x0Bjavascript:alert(1)</script>") (= x "<frame onclick=""alert(1)"">test</frame>") (= x "%22/%3E%3CBODY%20onload=\u{2019}document.write(%22%3Cs%22%2b%22cript%20src=http://my.box.com/xss.js%3E%3C/script%3E%22)\u{2019}%3E")))
(assert (or (= z "ails onmouseup=""alert(\u{10348}\u{1f4a9}1)"">test</details>") (= z "(1)"">test</dir>") (= z "pt>/* *\x00/javascript:alert(1)// */</script>")))
(assert (= y (str.++ x z)))
(assert (not (= ">te" (str.substr x 25 3))))
(assert (not (= (str.at z 3) """")))
(assert (or (= (str.at z 33) "/") (str.in_re x ((_ re.from_regex ecma2020) "([\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}A-Za-z0-9\s\-\.\,\?\!\:]{3,100})"))))
(assert (or (not (= (str.at z 5) " ")) (str.contains (str.replace y "x." "javascript:") ".bojavascript:co")))
(assert (str.prefixof "ail" z))
(assert (or (str.prefixof "pt>/* *\x0" z) (str.suffixof "</summary>" z)))
(assert (or (not (str.prefixof "<fieldset " y)) (str.suffixof ")-""" z)))
(check-sat)
