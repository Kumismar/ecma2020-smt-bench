; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<embed code=javascript:javascript:alert(1);></embed>") (= x "<param draggable=""true"" ondragleave=""alert(1)"">test</param>")))
(assert (or (= z "ript:alert('XSS')\u{1f4a9};"">") (= z "put autofocus>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "dr" 0) 7))
(assert (or (str.prefixof "<param d" y) (= (str.at z 10) "c") (not (= (str.indexof y "ara" 0) 2))))
(assert (str.prefixof "<param dr" x))
(assert (= (str.indexof x "ert(1" 0) 96))
(assert (str.contains (str.replace y "u" "") "e=""tre"))
(assert (or (str.prefixof "<par" x) (str.suffixof "key!" x)))
(assert (or (= "<embed code=javascript:javascript:alert(1);></ealert(1)" (str.replace x "mbed>" "alert(1)")) (str.suffixof """>" y)))
(assert (or (not (= "<embed code=j vascript:javascript:alert(1);></embed>put autofocus>" (str.replace y "a" " "))) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z][0-9a-zA-Z]*@{1}[0-9a-zA-Z]+\.(com|net|cn|com\.cn)$"))))
(check-sat)
