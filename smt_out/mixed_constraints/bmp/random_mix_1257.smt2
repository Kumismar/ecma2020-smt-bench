; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<audio onkeyup=""alert(1)"" contenteditable>test</audio>") (= x "<blockquote draggable=""true"" ondragend=""alert(1)"">test</blockquote>")))
(assert (or (= z """animation-name:x"" onanimationstart=""alert(1)""></del>") (= z "t</param>") (= z "ncontextmenu=""alert(1)"">test</bdo>")))
(assert (= y (str.++ x z)))
(assert (or (= ">" (str.substr z 8 1)) (not (= (str.indexof z "rt(" 0) 39))))
(assert (or (not (= (str.at z 15) ":")) (not (= (str.at z 15) ">")) (not (= "m>" (str.substr z 7 8)))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_\.\+\-]+@[a-zA-Z0-9\.\-]+\.[a-zA-Z]+$"))) (not (= "#" (str.substr x 70 1)))))
(assert (or (str.suffixof "dio>" x) (not (str.contains z "1)""></de"))))
(assert (or (str.prefixof """" z) (str.prefixof "&lt;/br " y)))
(check-sat)
