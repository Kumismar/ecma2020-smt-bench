; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<basefont onmouseleave=""alert(1)"">test</basefont>") (= x "<canvas onmouseout=""alert(1)"">test</canvas>") (= x "g'""></IFRAME>Hover the cursor to the LEFT of this Message</h1>&ParamHeight=250")))
(assert (or (= z ">") (= z ";")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y """alert")) (str.in_re y ((_ re.from_regex ecma2020) "^[A-\u{44f}|\s]*$"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(http(s)?:)?(\/)?(\/)?(www\.)?(facebook|fb|linkedin)\.com\/.+$"))) (= (str.indexof y ")><" 0) 93) (not (str.in_re z ((_ re.from_regex ecma2020) "[1-9][0-9]{5}")))))
(assert (not (= (str.indexof z ";" 0) 0)))
(assert (or (not (str.suffixof "asefont>" x)) (not (str.contains x "="""))))
(check-sat)
