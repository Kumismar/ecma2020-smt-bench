; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blink onpaste=""alert(1)"" contenteditable>test</blink>") (= x "<plaintext id=x tabindex=1 onbeforeactivate=alert(1)></plaintext>")))
(assert (or (= z "st</applet>") (= z "rt(1)></s>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<blink on" y) (not (str.contains x "ofoc"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,6}$"))))
(assert (= (str.indexof y "nted" 0) 31))
(assert (or (= "=alert(" (str.substr x 43 7)) (str.suffixof "st</blink>" x)))
(assert (or (<= (str.len x) 72) (not (str.contains y "cut"))))
(assert (str.prefixof "<b" y))
(assert (or (= "t" (str.substr x 63 1)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}]+[a-zA-Z\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{df}\- \/]{1,29}$"))) (not (str.prefixof "<plaintext" y))))
(assert (not (<= (str.len y) 78)))
(check-sat)
