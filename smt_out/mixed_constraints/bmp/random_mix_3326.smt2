; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg xmlns=""#""><script>alert(1)</script></svg>") (= x "<IMG SRC=x onafterprint=""alert(String.fromCharCode(88,83,83))"">") (= x "<label onmouseleave=""alert(1)"">test</label>")))
(assert (or (= z "t;&gt;XSS&lt;/A&gt;") (= z """></script>") (= z "ontenteditable>test</xmp>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof "/script>" z)) (not (str.prefixof "t;&gt;" z))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "([A-HJ-NP-Za-hj-np-z0-9]){1}([0-9]){7}([a-zA-Z0-9]){1}"))))
(assert (= (str.at z 10) "l"))
(assert (not (= (str.indexof z "</xmp" 0) 19)))
(assert (or (= (str.len x) 63) (str.suffixof "el>" x) (not (str.prefixof "nm" z))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z.]+"))) (not (str.suffixof "t;" y))))
(assert (str.prefixof "<labe" y))
(assert (= "ave" (str.substr x 16 3)))
(check-sat)
