; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg><dfn onload=alert(1)></dfn>") (= x "ABC<div style=""x:\x09expression(javascript:alert(1)"">DEF") (= x "<legend onclick=""alert(1)"">test</legend>")))
(assert (or (= z "ondeactivate=alert(1)></center\u{1f600}><input id=y au\u{1f4a9}tofocus>") (= z " 2s"" ontransitionrun=alert(1)></meta>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "gend " 0) 3))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z\s\*]+$"))) (<= (str.len z) 43)))
(assert (or (not (str.suffixof "us>" z)) (str.suffixof ">" y)))
(assert (or (= (str.indexof z "nsi" 0) 10) (str.prefixof " 2s"" ontr" z)))
(assert (or (= (str.indexof y "lert(" 0) 17) (= (str.at x 51) """") (not (<= (str.len x) 44))))
(assert (str.prefixof "<legen" y))
(check-sat)
