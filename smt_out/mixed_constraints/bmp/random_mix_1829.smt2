; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link id=x tabindex=1 onactivate=alert(1)></link>") (= x "<small onblur=alert(1) tabindex=1 id=x></small><input autofocus>")))
(assert (or (= z "option onfocusout=alert(1) tabindex=1 id=x></option><input autofocus>") (= z "alert(1)></var>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]{1,64}[@]{1}[a-zA-Z0-9._%+-]{1,64}[.]{1}[a-zA-Z]{2,99}")) (str.contains x "lert") (not (= "r=alert" (str.substr x 12 7)))))
(assert (or (= (str.indexof z "t" 0) 4) (= (str.len y) 64) (not (>= (str.len y) 115))))
(assert (= "onb" (str.substr y 7 3)))
(assert (not (= (str.indexof y "1)" 0) 39)))
(check-sat)
