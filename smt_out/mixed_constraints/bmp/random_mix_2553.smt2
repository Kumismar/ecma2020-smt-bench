; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<textarea id=ta onfocus=%22write('<script>alert(1)</script>')%22 autofocus></textarea>") (= x "<style>@keyframes x{}</style><table style=""animation-name:x"" onanimationstart=""alert(1)""></table>") (= x "<style>@keyframes x{}</style><dl style=""animation-name:x"" onanimationend=""alert(1)""></dl>")))
(assert (or (= z "ver=""alert(1)"">test</datalist>") (= z "(1)"" contenteditable>test</frame>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<s" x)))
(assert (or (str.prefixof "<text" x) (not (= "</frame>" (str.substr z 25 9)))))
(assert (or (not (>= (str.len x) 79)) (= (str.at y 78) "i") (str.suffixof "t</frame>" z)))
(assert (or (= (str.at y 79) "a") (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{2}(.)([0-9]{2})(.)([0-9]{4})$")))))
(check-sat)
