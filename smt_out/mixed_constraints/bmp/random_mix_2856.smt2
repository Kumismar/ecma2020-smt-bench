; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&#60") (= x "<tt ondblclick=""alert(1)"">test</tt>") (= x "<div draggable=""true"" contenteditable>drag me</div><center ondragover=alert(1) contenteditable>drop here</center>")))
(assert (or (= z "alert(1)"">test</label>") (= z "om/\""&gt;XSS&lt;/A&gt;")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "&#" x)))
(assert (not (str.contains z """>test<")))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9._% -] @[A-Za-z0-9.-] \.[A-Za-z]{2,6}$")) (not (= (str.at y 6) "/"))))
(assert (or (= (str.indexof y ")"">te" 0) 11) (not (= """1000""/" (str.substr x 49 7))) (= "l>" (str.substr y 24 6))))
(assert (or (= (str.at x 27) "e") (not (>= (str.len y) 53)) (not (= "styl" (str.substr z 8 4)))))
(assert (not (str.suffixof "EF" y)))
(check-sat)
