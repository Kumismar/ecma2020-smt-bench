; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex onmouseleave=""alert(1)"">test</isindex>") (= x "&lt;SCRIPT&gt;a=/XSS/")))
(assert (or (= z "tivate=alert(1)></big><input id=y autofocus>") (= z "ate=alert(1)></area>") (= z "=1 onbeforedeactivate=alert(1)></marquee><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (= (str.at x 4) "S"))
(assert (or (= (str.at z 7) "r") (str.contains x "ert(1)"">")))
(assert (or (str.contains (str.replace y "1)><" """") "(""/mar") (= (str.indexof x "nte" 0) 27) (not (str.in_re z ((_ re.from_regex ecma2020) "^([0-9\-\(\) ]*)$")))))
(assert (str.prefixof "&lt;SCR" y))
(assert (or (= (str.indexof z "><inp" 0) 21) (not (= (str.len z) 44)) (not (>= (str.len y) 98))))
(assert (or (str.contains (str.replace y "efo" " ") "onb react") (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+.[a-z]{2,3}$"))) (= "URL=javas" (str.substr x 61 9))))
(assert (not (str.contains (str.replace y "&g" " ") "T t;a=/")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[^0-9][a-zA-Z0-9_]+([.][a-zA-Z0-9_]+)*[@][a-zA-Z0-9_]+([.][a-zA-Z0-9_]+)*[.][a-zA-Z]{2,4}$"))))
(check-sat)
