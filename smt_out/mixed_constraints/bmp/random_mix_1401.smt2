; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<footer draggable=""true"" ondragleave=""alert(1)"">test</footer>") (= x "<style>:target {color:red;}</style><samp id=x style=""transition:color 1s"" ontransitionend=alert(1)></samp>")))
(assert (or (= z "weshowshowgeshow=""alert(1)"";") (= z "tabindex=1 onbeforedeactivate=alert(1)></marquee><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9\u{e4}\u{f6}\u{fc}\u{df}\u{c4}\u{d6}\u{dc}]*"))) (not (= (str.indexof x "ert(" 0) 114)) (not (= "rt(1)></s" (str.substr x 93 9)))))
(assert (or (= ">test" (str.substr x 47 5)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9-+\s()]{14}$"))) (not (= (str.indexof x "ble=" 0) 14))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9\-\s]{2,50}"))) (= (str.at x 8) "n")))
(assert (>= (str.len x) 89))
(assert (str.contains (str.replace y " sty" "alert(1)") "xalert(1)le="))
(assert (= "<style>:target {color:r/style><samp id=x style=""transition:color 1s"" ontransitionend=alert(1)></samp>weshowshowgeshow=""alert(1)"";" (str.replace y "ed;}<" "")))
(assert (or (not (= (str.indexof x "ondra" 0) 25)) (str.suffixof "rack>" x)))
(check-sat)
