; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "'<script>window.onload=function(){document.forms[0].message.value='1';}</script>") (= x "<nav onmouseout=""alert(1)"">test</nav>")))
(assert (or (= z "t</a>") (= z "nd>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "t</a" 0) 0)) (= (str.at z 1) "<")))
(assert (or (str.prefixof "<nav" y) (not (= (str.indexof y "t" 0) 21))))
(assert (or (not (= (str.indexof z "n" 0) 0)) (not (= (str.at x 17) "a")) (not (= (str.at y 27) "t"))))
(assert (or (str.prefixof "n" z) (not (str.in_re z ((_ re.from_regex ecma2020) ".{3,24}")))))
(assert (not (str.suffixof "/a>" y)))
(check-sat)
