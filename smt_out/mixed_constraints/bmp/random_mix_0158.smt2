; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<param onkeyup=""alert(1)"" contenteditable>test</param>") (= x "<tbody draggable=""true"" ondragstart=""alert(1)"">test</tbody>")))
(assert (or (= z "(1)></sub>") (= z "</nav>") (= z "</nobr>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "(?=^[\S]{12,}$)(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*\W).*$")) (= (str.at y 60) "1") (>= (str.len y) 57)))
(assert (or (not (= (str.indexof z "cont" 0) 6)) (str.prefixof "</nob" z)))
(assert (or (not (str.contains z "</sub")) (not (str.suffixof ">" z)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w]{2,64}$")))))
(assert (not (str.prefixof "<tbody d" x)))
(assert (or (str.contains y "agstar") (>= (str.len y) 62) (= (str.len z) 7)))
(check-sat)
