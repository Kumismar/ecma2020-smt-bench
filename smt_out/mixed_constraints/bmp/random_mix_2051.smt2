(assert (or (not (= "a>" (str.substr y 104 10))) (not (str.contains y "st</"))))
(assert (or (not (= (str.len x) 70)) (not (>= (str.len y) 103)) (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z\u{c3}\u{20ac}\u{c3}\u{81}\u{c3}\u{201a}\u{c3}\u{192}\u{c3}\u{201e}\u{c3}\u{2026}\u{c3}\u{2020}\u{c3}\u{2021}\u{c3}\u{2c6}\u{c3}\u{2030}\u{c3}\u{160}\u{c3}\u{2039}\u{c3}\u{152}\u{c3}\u{8d}\u{c3}\u{17d}\u{c3}\u{8f}\u{c3}\u{90}\u{c3}\u{2018}\u{c3}\u{2019}\u{c3}\u{201c}\u{c3}\u{201d}\u{c3}\u{2022}\u{c3}\u{2013}\u{c3}\u{2dc}\u{c3}\u{2122}\u{c3}\u{161}\u{c3}\u{203a}\u{c3}\u{153}\u{c3}\u{9d}\u{c3}\u{17e}\u{c3}\u{178}\u{c3} \u{c3}\u{a1}\u{c3}\u{a2}\u{c3}\u{a3}\u{c3}\u{a4}\u{c3}\u{a5}\u{c3}\u{a6}\u{c3}\u{a7}\u{c3}\u{a8}\u{c3}\u{a9}\u{c3}\u{aa}\u{c3}\u{ab}\u{c3}\u{ac}\u{c3}\u{ad}\u{c3}\u{ae}\u{c3}\u{af}\u{c3}\u{b0}\u{c3}\u{b1}\u{c3}\u{b2}\u{c3}\u{b3}\u{c3}\u{b4}\u{c3}\u{b5}\u{c3}\u{b6}\u{c3}\u{b8}\u{c3}\u{b9}\u{c3}\u{ba}\u{c3}\u{bb}\u{c3}\u{bc}\u{c3}\u{bd}\u{c3}\u{be}\u{c3}\u{bf}]*$"))))
(assert (or (not (= (str.at y 13) "s")) (not (= "table" (str.substr z 40 5)))))
(assert (or (not (= (str.indexof x "t(123" 0) 49)) (not (str.prefixof "<opti" x))))
(assert (or (not (str.contains (str.replace x "cript" " ") "</s ><")) (not (= "m" (str.substr y 46 1)))))
