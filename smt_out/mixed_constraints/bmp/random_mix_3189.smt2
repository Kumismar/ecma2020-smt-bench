; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=x tabindex=1 onbeforeactivate=alert(1)></div>") (= x "<dt onmouseleave=""alert(1)"">test</dt>") (= x "<style>@keyframes x{}</style><basefont style=""animation-name:x"" onanimationstart=""alert(1)""></basefont>")))
(assert (or (= z ":transform 2s"" ontransitionrun=alert(1)></bgsound>") (= z "dblclick=""alert(1)"">test</s>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9.-_+-]{1,}@[a-zA-Z.-]{1,}[.]{1}[a-zA-Z]{2,}"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([0-9]{4})\s?([A-Za-z]{2})$"))) (str.prefixof "<dt onmo" y) (= (str.at y 26) "&")))
(assert (or (>= (str.len x) 29) (not (= "ipt)s?<B>=" (str.substr y 18 10))) (= "></b" (str.substr y 76 4))))
(assert (= (str.at z 5) " "))
(assert (str.contains z "t</nof"))
(assert (or (not (= (str.at x 13) "i")) (str.contains y ")><") (not (= ":transform 2s"" ontransitionrun=alert(1""</bgsound>" (str.replace z ")>" """")))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9].{6,}"))))
(assert (not (str.contains y "=alert(")))
(check-sat)
