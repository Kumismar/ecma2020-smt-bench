; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<;XSS STYLE="";xss:expression(alert(';XSS';))"";>;") (= x "<object onkeypress=""alert(1)"" contenteditable>test</object>") (= x "<spacer id=x tabindex=1 onbeforedeactivate=alert(1)></spacer><input autofocus>")))
(assert (or (= z "ert(1)"" contenteditable>test</embed>") (= z "st</mark>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "e" z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[^(<|>)]+$"))) (not (= "<spacer id=x tabindex=1 onbeforedeactivate=alert(1)></spacer><input aocus>" (str.replace x "utof" "")))))
(assert (str.suffixof "SS';))"";>;" x))
(assert (or (not (= (str.indexof x "t(" 0) 47)) (str.contains (str.replace x "able" " ") "it >t")))
(assert (not (str.prefixof "st</m" z)))
(assert (or (not (str.suffixof "rk>" z)) (not (str.contains z "</mark"))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[-a-z0-9!#$%&'*+\/=?^_`{|}~]+(\.[-a-z0-9!#$%&'*+\/=?^_`{|}~]+)*@(([a-z0-9]([-a-z0-9]*[a-z0-9]+)?){1,63}\.)+([a-z0-9]([-a-z0-9]*[a-z0-9]+)?){2,63}$")) (not (str.contains y "le>t"))))
(check-sat)
