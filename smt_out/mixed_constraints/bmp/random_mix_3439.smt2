; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><data ondragover=alert(1) contenteditable>drop here</data>") (= x """><h1><iframe width=""420"" height=""315"" src=""http://www.youtube.com/embed/sxvccpasgTE"" frameborder=""0"" allowfullscreen></iframe>123</h1>")))
(assert (or (= z "pt:alert(1))}</style>") (= z "on:transform 2s"" ontransitionrun=alert(1)></param>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len y) 192))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[0-9+() ]{5,}$")) (not (= (str.at x 18) "u")) (not (= (str.indexof x "T" 0) 82))))
(assert (or (not (= (str.indexof y "/" 0) 46)) (not (str.suffixof ">" z)) (not (str.suffixof "am>" z))))
(assert (or (not (str.contains y "un=al")) (>= (str.len x) 99)))
(check-sat)
