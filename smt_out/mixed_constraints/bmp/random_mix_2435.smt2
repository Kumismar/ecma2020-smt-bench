(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<canvas draggable=""true"" ond\u{20000}ragenter=""alert(1)"">test</canvas>") (= x "<isindex type=image onload=alert(1) src=validimage.png>") (= x "<i\u{20000}frame onmouseleave=""a\u{1f600}lert(1)"">test</iframe>")))
