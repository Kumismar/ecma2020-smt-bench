; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><slot id=x style=""transition:color 1s"" ontransitionend=alert(1)></slot>") (= x "<img oncut=""alert(1)"" contenteditable>test</img>")))
(assert (or (= z """alert(1)"" contenteditable>test</figcaption>") (= z "}&lt;/STYLE&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace z "en" "x") " contxte")) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{2} [0-9]{5}-[0-9]{4}"))) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@(?!gmail.com)(?!yahoo.com)(?!hotmail.com)(?!hotmail.co.il)(?!walla.co.il)(?!mail.ru)(?!outlook.com)(?!email.com)[a-z0-9.-]+\.[a-z]{2,}$")))))
(assert (= (str.at y 30) "d"))
(assert (or (= (str.at z 3) "c") (= (str.indexof z "t" 0) 1) (not (str.prefixof "<r" x))))
(assert (str.prefixof """aler" z))
(check-sat)
