; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<!-- IE 10 in IE5-9 Standards mode -->") (= x "<title onmouseover=""alert(1)"">test</title>") (= x "<strike onmouseenter=""alert(1)"">test</strike>")))
(assert (or (= z "onactivate=alert(1)></menu>") (= z " style=""transition:color 10s"" ontransitioncancel=alert(1)></spacer>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<wbr onmo" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^1((3|5|8){1}\d{1}|70|77)\d{8}$")))))
(assert (or (str.contains z "cel") (not (= (str.len x) 42)) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z\u{e4}\u{f6}\u{e6}\u{f8}\u{e5}0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$")))))
(assert (str.prefixof "<title o" x))
(assert (or (str.prefixof "<!-- IE 10" x) (not (= (str.at z 23) "e")) (str.contains x "over=""a")))
(assert (not (= (str.indexof y "/m" 0) 63)))
(check-sat)
