; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sup onbeforecut=""alert(1)"" contenteditable>test</su\u{1f4a9}p>") (= x "<area draggable=""true"" ondragend=""alert(1)"">test</area>") (= x "<div draggable=""true"" contenteditable>drag me</div><hgroup ondragover=alert(1) contenteditable>drop here</hgroup>")))
(assert (or (= z "ag=""\u{1f600}alert(1)"">test</td>") (= z "menu id=x tabindex=1 onactivate=alert(1)></menu>")))
(assert (= y (str.++ x z)))
(assert (or (= "<draggable=""true"" contenteditable>drag me</div><hgroup ondragover=alert(1) contenteditable>drop here</hgroup>ag=""\u{1f600}alert(1)"">test</td>" (str.replace y "iv d" "")) (not (= (str.len y) 79))))
(assert (or (not (str.suffixof "</hgroup>" y)) (not (= (str.indexof x "ue"" c" 0) 18)) (not (str.contains x "dragend=""a"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[1-9][0-9][0-9]-[0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]"))))
(assert (or (str.prefixof "<sup on" x) (str.prefixof "<div dragg" y) (not (str.contains (str.replace y "t1""" "<b>") "emen<b>>test"))))
(check-sat)
