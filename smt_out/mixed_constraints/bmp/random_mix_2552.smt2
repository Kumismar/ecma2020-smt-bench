; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xss id=x tabindex=1 onbeforedeactivate=alert(1)></xss><input autofocus>") (= x "alert&#40;1&#41")))
(assert (or (= z " onmousemove=""alert(1)"">test</tt>") (= z "o id=x tabindex=1 onbeforedeactivate=alert(1)></bdo><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (= (str.len y) 105))
(assert (or (str.prefixof "<xss i" y) (= "=" (str.substr x 7 1)) (str.contains (str.replace x "0;1&#" "x") "rt&#4x41")))
(assert (or (not (str.suffixof "ofocus>" x)) (str.prefixof "o " z)))
(assert (or (str.contains z "ter=""alert") (str.prefixof "<xs" x) (= (str.indexof z "cti" 0) 29)))
(assert (or (= (str.at z 5) "v") (= "ad=alert" (str.substr z 8 8))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "m5d8d")) (not (= "tions" (str.substr x 65 5)))))
(check-sat)
