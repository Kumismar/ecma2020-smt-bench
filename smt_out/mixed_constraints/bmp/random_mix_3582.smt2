; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<link onmousedown=""alert(1)"">test</link>") (= x "<h1 onmousemove=""alert(1)"">test</h1>")))
(assert (or (= z " onbeforeactivate=alert(1)></title>") (= z "rt(1);</STYLE>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "est" "alert(1)") "1)"">talert(1)</")) (not (str.contains y "foreac")) (not (= (str.indexof y "vat" 0) 53))))
(assert (or (str.suffixof "TYLE>" y) (str.contains y " tabind") (not (str.prefixof "em>" z))))
(assert (>= (str.len x) 32))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "\d{3} ?\d{3} ?\d{2} ?\d{2}"))) (= (str.at y 67) "n")))
(assert (or (= (str.at y 6) "m") (str.suffixof "est</link>" x)))
(check-sat)
