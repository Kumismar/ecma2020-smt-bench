; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><section id=x style=""transition:color 1s"" ontransitionend=alert(1)></section>") (= x "<style>:target {color:red;}</style><content id=x style=""transition:color 1s"" ontransitionend=alert(1)></content>") (= x "<menu id=x tabindex=1 onactivate=alert(1)></menu>")))
(assert (or (= z "tion>") (= z "1)></command>") (= z """><script>javascript:alert(1)</script>"">")))
(assert (= y (str.++ x z)))
(assert (= "<style>:target {color:red;}</style><section id=x style=""transition:color 1s"" ontransitionend=alert(1)></section>""><<b>ript>javascript:alert(1)</script>"">" (str.replace y "sc" "<b>")))
(assert (or (str.prefixof "<meta o" y) (not (str.in_re x ((_ re.from_regex ecma2020) "^\S+@[a-zA-Z0-9._-]+?\.[a-zA-Z]{2,3}$")))))
(assert (or (= "ection>" (str.substr x 105 10)) (not (str.contains y "yup=""a")) (not (= "t:alert(" (str.substr z 19 8)))))
(assert (or (not (str.contains y "ctivate=al")) (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z\s]+)$")) (not (str.contains (str.replace z "ript>" "<b>") "c<b>j"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-fA-F0-9]{6}|[a-fA-F0-9]{3})$"))) (not (str.prefixof "<menu id=" y))))
(assert (or (str.contains y "ent1""") (not (<= (str.len x) 113))))
(check-sat)
