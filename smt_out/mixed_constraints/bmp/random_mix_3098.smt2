; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><frameset ondrop=alert(1) contenteditable>drop here</frameset>") (= x "<legend onmouseover=""alert(1)"">test</legend>") (= x "<body onResize body onResize=""javascript:javascript:alert(1)""></body onResize>")))
(assert (or (= z "move=""alert(1)"">test</font>") (= z "/u>") (= z " tabindex=1 id=x></tbody><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 1) (= "al" (str.substr y 36 2))))
(assert (or (= (str.indexof y "d" 0) 1) (not (= (str.at z 15) ">")) (not (= (str.indexof x "ert" 0) 23))))
(assert (or (= (str.at z 13) ")") (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9-]+"))) (not (str.in_re x ((_ re.from_regex ecma2020) "(?=(?:[^a-zA-Z]*[a-zA-Z]){1})(?=(?:\D*\d){3}).*")))))
(assert (or (>= (str.len x) 37) (not (= (str.len z) 3))))
(check-sat)
