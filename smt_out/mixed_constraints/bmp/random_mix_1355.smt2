; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tfoot draggable=""true"" ondragend=""alert(1)"">test</tfoot>") (= x "<abbr onkeydown=""alert(1)"" contenteditable>test</abbr>")))
(assert (or (= z "tabindex=1 onbeforedeactivate=alert(1)></body><input autofocus>") (= z "own=""alert(1)"">test</u>") (= z "d=""fuzzelement1"">test</a>")))
(assert (= y (str.++ x z)))
(assert (= "<tfoot draggable=""true"" ondragend=""alert(1)"">test<b>tfoot>" (str.replace x "</" "<b>")))
(assert (or (>= (str.len x) 52) (= (str.indexof x "oot d" 0) 3)))
(assert (or (= """`'javascript:<script>\x7Ejavascript:alert(1)</script>1) tabindex=1 id=x></dt><input autofocus>" (str.replace y ">" "javascript:")) (not (str.prefixof "<t" x))))
(assert (not (= (str.at z 10) ">")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(([0-8][0-9])|(9[0-5])|(2[ab]))[0-9]{3}$$"))) (= (str.indexof y "t" 0) 1)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[\u{3041}-\u{3093}\u{30a1}-\u{30f6}\u{3000}\s]+$"))))
(assert (or (str.contains y "t(1)") (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{4,4}$"))))
(assert (str.contains x "tfoot drag"))
(assert (= (str.indexof x """ " 0) 22))
(check-sat)
