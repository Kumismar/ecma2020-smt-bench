; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<blockquote onmouseover=""alert(1)"">test</blockquote>") (= x "<a href=""\xE2\x81\x9Fjavascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<style>:target {color: red;}</style><meta id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></meta>")))
(assert (or (= z "st</shadow>") (= z """validaudio.wav"" type=""audio/wav""></audio>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len x) 121)) (not (str.contains z "av"" type="))))
(assert (or (= (str.indexof x "x st" 0) 45) (not (str.contains x "elem"))))
(assert (or (not (= (str.indexof z "daud" 0) 5)) (not (= (str.indexof z "st</s" 0) 0))))
(assert (or (<= (str.len x) 116) (not (str.suffixof ">" y)) (not (= "ou" (str.substr y 55 2)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[\d\- ]+$"))) (not (<= (str.len z) 52)) (not (= "<styl" (str.substr x 0 5)))))
(check-sat)
