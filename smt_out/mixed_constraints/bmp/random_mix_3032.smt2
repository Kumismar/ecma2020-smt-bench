; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;A HREF=\""htt p&#58;//6 6&#46;000146&#46;0x7&#46;147/\""&gt;XSS&lt;/A&gt;") (= x "<i oncontextmenu=""alert(1)"">test</i>") (= x "b=\""URL(\\""\"";")))
(assert (or (= z "mage>") (= z "ut=alert(1) value=xss>")))
(assert (= y (str.++ x z)))
(assert (or (= "RL(\\" (str.substr x 5 5)) (str.in_re y ((_ re.from_regex ecma2020) "(.+)@(.+){2,}\.(.+){2,}"))))
(assert (or (str.contains y "\""\"";mage>") (= "8;//6" (str.substr y 21 5))))
(assert (not (>= (str.len x) 28)))
(assert (str.prefixof "&" y))
(assert (or (not (<= (str.len z) 13)) (= (str.indexof y "ue" 0) 29) (str.contains z "ub")))
(assert (or (= (str.at z 3) "a") (str.suffixof "ss>" y)))
(assert (not (str.suffixof ";/A&gt;" x)))
(check-sat)
