; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<shadow draggable=""true"" ondrag=""alert(1)"">test</shadow>") (= x "<iframe draggable=""true"" ondragend=""alert(1)"">test</iframe>")))
(assert (or (= z "nput autofocus>") (= z "lert(1)\x22src=xxx:x />") (= z "techange=javascript:javascript:alert(1);></style>")))
(assert (= y (str.++ x z)))
(assert (or (not (= ")" (str.substr z 41 1))) (= ">" (str.substr y 78 3))))
(assert (or (str.contains (str.replace x "rt(1" "<b>") "e<b>)"">te") (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Z\u{c5}\u{c4}\u{d6}\u{c6}\u{d8}\u{cb}\u{c9}\u{c8}\u{ca}\u{db}\u{dc}a-z\u{e5}\u{e4}\u{f6}\u{e6}\u{f8}\u{eb}\u{e9}\u{e8}\u{ea}\u{fb}\u{fc}\s\-]{1,50}$"))) (not (>= (str.len y) 103))))
(assert (or (not (= " c" (str.substr y 27 2))) (not (= (str.indexof z "scr" 0) 13)) (str.contains (str.replace z "lert" "alert(1)") "alert(1)(1)\x")))
(assert (not (str.prefixof "techange" z)))
(check-sat)
