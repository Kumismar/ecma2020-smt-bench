; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp onmouseenter=""alert(1)"">test</rp>") (= x "<img SRC=""javascript:document.vulnerable=tru\u{20000}e;""") (= x "<legend onmouseup=""alert(1)"">test</le\u{1f600}gend>")))
(assert (or (= z "lert(1)></h1>") (= z "deactivate=alert(1)></samp><input id=y autofocus>") (= z "ditable>test</frameset>")))
(assert (= y (str.++ x z)))
(assert (= "<style>:target {transform: rotajavascript:80deg);}</style><colgroup id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></colgroup>></isindex><input id=y autofocus>" (str.replace y "te(1" "javascript:")))
(assert (not (str.contains y "mou")))
(assert (or (= (str.indexof x "javas" 0) 10) (not (str.contains x "le=tru\u{20000}e;""")) (= "<img SRC=""javascript:document.vulnerable=tru\u{20000}e;""dible>test</frameset>" (str.replace y "ta" ""))))
(assert (or (str.contains x "rable=tru\u{20000}") (not (str.suffixof "le=tru\u{20000}e;""" x)) (str.prefixof "<rp " y)))
(assert (or (not (= (str.indexof x "end" 0) 4)) (not (= (str.at x 12) "n")) (= "vas" (str.substr y 12 3))))
(assert (or (= (str.indexof x ">" 0) 27) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]+$")) (not (str.prefixof "<script " y))))
(check-sat)
