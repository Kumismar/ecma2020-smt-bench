; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<html onmouseleave=""alert(1)"">test</html>") (= x "<blink id=x tabindex=1 onbeforeactivate=alert(1)></blink>")))
(assert (or (= z "aption draggable=""true"" ondragenter=""alert(1)"">test</figcaption>") (= z " me</div><section ondrop=alert(1) contente\u{1f4a9}ditable>drop here</section>") (= z "t(1)"">test</bgsound>")))
(assert (= y (str.++ x z)))
(assert (or (= "est" (str.substr x 31 3)) (not (str.contains x "rt(1)>"))))
(assert (or (not (str.contains (str.replace y "ate=a" "x") "activxlert")) (str.prefixof "<style>@k" y) (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*?[a-zA-Z])(?=.*?\d)[a-zA-Z\d]{8,16}$")))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$")))
(assert (or (not (str.suffixof "n>" y)) (not (str.contains y "re")) (str.suffixof "tofocus>" y)))
(check-sat)
