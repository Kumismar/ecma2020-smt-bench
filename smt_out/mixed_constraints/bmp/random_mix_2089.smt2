; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>@keyframes x{}</style><strike style=""animation-name:x"" onanimationstart=""alert(1)""></strike>") (= x "<a href=""\x16javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "st</pre>") (= z "fromCharCode(88,83,83))""></img>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[\x00-\x7f]+@[\x00-\x7f]+"))) (not (= (str.at x 28) "s")) (str.prefixof "<c" y)))
(assert (or (not (str.prefixof "<style>@" x)) (not (= (str.len z) 8))))
(assert (not (= (str.at y 30) "r")))
(assert (or (str.prefixof "fro" z) (str.in_re y ((_ re.from_regex ecma2020) "^(\s*)?(\+)?([- _():=+]?\d[- _():=+]?){10,14}(\s*)?$")) (str.contains (str.replace x "t" " ") "scrip :jav")))
(assert (or (not (str.suffixof "/pre>" y)) (<= (str.len z) 36)))
(check-sat)
