; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script <B>document.vulnerable=true;</script>") (= x "<style>@keyframes x{}</style><basefont style=""animation-name:x"" onanimationend=""alert(1)""></basefont>")))
(assert (or (= z "y onclick=""alert(1)"">test</tbody>") (= z "blur=alert(1) tabindex=1 id=x></nobr><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= """t" (str.substr y 14 2))) (str.prefixof "<script " x)))
(assert (or (not (str.suffixof "ofocus>" y)) (str.contains z "lick=""")))
(assert (or (= "ont>" (str.substr x 97 6)) (str.suffixof "ript>))>;" y) (str.in_re x ((_ re.from_regex ecma2020) "^(?:\+?\d+\s*)?\(?\d{3}\)?[\s\.-]?\d{3}[\s\.-]?\d{4}$"))))
(assert (or (not (= (str.indexof y "io" 0) 52)) (str.prefixof "<style>@ke" y) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_]*$"))))
(assert (= "dragjavascript:le=""true"" ondragend=""alert(1)"">test</applet>" (str.replace z "gab" "javascript:")))
(assert (or (not (str.contains (str.replace y "</b" "") """>a")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\d]{3}[-]{1}[\d]{2}[-]{1}[\d]{4}"))) (str.prefixof "<st" x)))
(check-sat)
