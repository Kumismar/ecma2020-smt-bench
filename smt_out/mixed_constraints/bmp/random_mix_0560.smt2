; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<samp oncontextmenu=""alert(1)"">test</samp>") (= x "<li onkeypress=""alert(1)"" contenteditable>test</li>")))
(assert (or (= z "ndragend=""alert(1)"">test</rb>") (= z " onpaste=""alert(1)"" contenteditable>test</th>")))
(assert (= y (str.++ x z)))
(assert (= (str.at z 44) ">"))
(assert (or (not (= (str.at y 31) "t")) (not (str.suffixof "t</rb>" y)) (= "ke" (str.substr x 6 2))))
(assert (or (str.suffixof ">" y) (not (str.in_re y ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,20}"))) (not (str.prefixof "<samp " y))))
(assert (or (= (str.indexof x "/sam" 0) 36) (not (= (str.indexof x "p on" 0) 4))))
(check-sat)
