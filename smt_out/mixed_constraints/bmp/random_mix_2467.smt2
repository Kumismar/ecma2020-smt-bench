; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<source onmousedown=""alert(1)"">test</source>") (= x "<style>:target {color: red;}</style><datalist id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></datalist>")))
(assert (or (= z ")"">test</bdo>") (= z "1)"">test</input>") (= z "eforepaste=""alert(1)"" contenteditable>test</spacer>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<s" y)) (not (= (str.indexof z "nput>" 0) 11))))
(assert (= (str.at z 3) "t"))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(0|\+33)[1-9]([-.\u{a0}]?[0-9]{2}){4}$")) (not (str.prefixof ")"">test" z)) (>= (str.len y) 125)))
(assert (or (= "/input>" (str.substr z 9 9)) (not (str.contains y "s:no")) (not (= "nput>" (str.substr y 55 10)))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(?=[-_a-zA-Z0-9]*?[A-Z])(?=[-_a-zA-Z0-9]*?[a-z])(?=[-_a-zA-Z0-9]*?[0-9])[-_a-zA-Z0-9]{8,16}"))) (not (= (str.at z 1) """")) (= (str.len x) 119)))
(assert (or (= "<source onmousedown=""alert(1)""> st</source>1)"">test</input>" (str.replace y "te" " ")) (not (= (str.at x 89) "i")) (not (= ")"">test</i" (str.substr z 1 10)))))
(check-sat)
