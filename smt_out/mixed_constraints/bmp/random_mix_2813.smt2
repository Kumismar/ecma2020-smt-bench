; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "</script><script >alert(document.cookie)</script>") (= x "<content onkeypress=""alert(1)"" contenteditable>test</content>")))
(assert (or (= z "a>") (= z "put autofocus>") (= z "drop here</base>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{2}-[0-9]{3}"))))
(assert (or (not (= "pt" (str.substr x 6 2))) (= (str.at z 1) ">")))
(assert (not (= (str.indexof x "onte" 0) 2)))
(assert (= (str.at x 75) "n"))
(assert (or (not (= (str.at z 9) "<")) (not (str.contains x "</conten")) (str.contains z " h")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "((?=^.{6,}$).*$)"))) (not (= (str.indexof x "s" 0) 5)) (not (str.contains (str.replace x "tle o" "<b>") "i<b>ndblc"))))
(assert (not (str.prefixof "<con" y)))
(assert (= (str.len x) 61))
(check-sat)
