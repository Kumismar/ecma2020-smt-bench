; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark draggable=""true"" ondragleave=""alert(1)"">test</mark>") (= x "<pre onmouseleave=""alert(1)"">test</pre>") (= x "<ul onmousemove=""alert(1)"">test</ul>")))
(assert (or (= z "/mark>") (= z "1)"">test</dt>") (= z "sedown=""alert(1)"">test</data>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<bgsound SRC=""jajavascript:ript:document.vulnerable=true;"">index=1 id=x></legend><input autofocus>" (str.replace y "vasc" "javascript:"))) (str.prefixof "<ul onm" y) (str.prefixof "<mar" y)))
(assert (or (= (str.indexof y "r" 0) 3) (not (str.contains (str.replace y """>te" """") "1)""st</d")) (not (= (str.indexof z "a" 0) 2))))
(assert (str.prefixof "<" y))
(assert (not (= "e>" (str.substr x 37 4))))
(assert (or (not (str.suffixof "t</mark>" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[\w'\-,.][^0-9_!\u{c2}\u{a1}?\u{c3}\u{b7}?\u{c2}\u{bf}/\\+=@#$%\u{cb}\u{2020}&*(){}|~<>;:[\]]{2,}$")))))
(assert (or (not (= "t</ma" (str.substr x 49 5))) (str.contains (str.replace y "est<" """") "e>t""/t") (>= (str.len y) 78)))
(assert (= (str.indexof z "1 " 0) 1))
(check-sat)
