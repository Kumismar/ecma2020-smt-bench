; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure draggable=""true"" ondragleave=""alert(1)"">test</figure>") (= x "<strong draggable=""true"" ondragleave=""alert(1)"">test</strong>")))
(assert (or (= z " rotate(180deg);}</style><isindex id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></isindex>") (= z "ert(1)></isindex>") (= z "st</td>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at z 12) "n")) (= (str.at x 36) "=") (str.contains x "ert(1)"">t")))
(assert (or (= (str.at x 7) " ") (not (str.in_re y ((_ re.from_regex ecma2020) "^(5)([0-9]{9})$|^[4-5]([0-9]{15})$")))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) ".{16}|.{16,}"))) (not (str.suffixof "st</td>" y))))
(assert (or (not (str.contains x ")"">test</f")) (not (str.suffixof "ng>" x)) (not (= "able>drop " (str.substr y 83 10)))))
(assert (not (str.contains (str.replace x "ure d" "alert(1)") "<figalert(1)ra")))
(check-sat)
