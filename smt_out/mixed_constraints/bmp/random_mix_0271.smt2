; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike draggable=""true"" ondragenter=""alert(1)"">test</strike>") (= x "<optgroup onmouseout=""alert(1)"">test</optgroup>") (= x "<iframe oncontextmenu=""alert(1)"">test</iframe>")))
(assert (or (= z "avas\u{20000}cript:alert(1)>") (= z "techange=alert(1)></applet>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "s\u{20000}cr" 0) 49) (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9a-zA-Z\u{e01}-\u{e59}_-]{3,20}")))))
(assert (or (= "utput>" (str.substr x 37 10)) (not (str.suffixof "ptgroup>" x)) (not (= (str.indexof x """>t" 0) 30))))
(assert (or (str.prefixof "te" z) (= """>" (str.substr z 41 8))))
(assert (not (str.prefixof "<iframe " y)))
(check-sat)
