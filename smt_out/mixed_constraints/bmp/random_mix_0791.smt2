; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<form>") (= x "<big onclick=""alert(1)"">test</big>") (= x "<XML ID=I><X><C><![<IMG SRC=""javas]]<![cript:document.vulnerable=true;"">]]</C></X></xml><SPAN DATASRC=#I DATAFLD=C DATAFORMATAS=HTML></span>")))
(assert (or (= z "/dl>") (= z "IMG SRC=JaVaScRiPt:alert(&apos;XSS&apos;)&gt;") (= z "/samp>")))
(assert (= y (str.++ x z)))
(assert (= ">" (str.substr z 5 10)))
(assert (not (str.suffixof "pos;)&gt;" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9. +()]{9,}$"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9 ]+"))))
(assert (or (str.contains y "abl") (not (= (str.len x) 34)) (not (str.prefixof "<for" x))))
(assert (not (= " id=x ta" (str.substr x 4 8))))
(assert (or (str.suffixof "</span>" x) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}\s_.-]*$")) (= "HTM" (str.substr y 128 3))))
(check-sat)
