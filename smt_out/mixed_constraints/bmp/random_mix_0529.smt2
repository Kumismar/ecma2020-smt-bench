; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee onmouseup=""alert(1)\u{1f600}"">t\u{20000}est</marquee>") (= x "<div draggable=""true"" contenteditable>drag me</div><optgroup ondrop=alert(1) contenteditable>drop here</optgroup>") (= x "<rt draggable=""true"" ondragstart=""alert(1)"">test</rt>")))
(assert (or (= z "ggable=""true"" ondragenter=""alert(1)"">test</marquee>") (= z "ja\vasc\ript:document.vulnerable=true';</style>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "table>dro")) (not (= (str.indexof y "ler" 0) 98)) (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{3,}"))))
(assert (not (str.prefixof "<div dragg" y)))
(assert (or (= (str.len y) 74) (= (str.at y 33) "c") (<= (str.len x) 63)))
(assert (or (= (str.len x) 46) (= (str.indexof y "r" 0) 3)))
(assert (or (not (str.contains z "ragente")) (str.prefixof "<rt drag" x) (str.in_re y ((_ re.from_regex ecma2020) "^.{5,35}$"))))
(assert (= (str.indexof z "ocum" 0) 14))
(check-sat)
