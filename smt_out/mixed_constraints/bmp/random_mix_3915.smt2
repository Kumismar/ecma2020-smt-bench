; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b onmousemove=""alert(\u{10348}1)"">test</b>") (= x "<cite onmouseenter=""alert(1)"">test</cite>")))
(assert (or (= z "ss>") (= z "opy=""alert(1)"" contenteditable>test</bdo>") (= z "lue>hellox worldss</h1>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.at y 63) ">")) (= (str.len y) 38)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "\d+(\.\d{1})?"))) (not (= (str.at z 5) "e"))))
(assert (not (str.contains x "useente")))
(assert (or (not (= (str.len z) 22)) (not (str.in_re x ((_ re.from_regex ecma2020) "^(1\s*[-\/\.]?)?(\((\d{3})\)|(\d{3}))\s*[-\/\.]?\s*(\d{3})\s*[-\/\.]?\s*(\d{4})\s*(([xX]|[eE][xX][tT])\.?\s*(\d+))*$"))) (str.suffixof ">ss>" y)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{1,2}\/[0-9]{1,2}\/[0-9]{2,4}$"))))
(check-sat)
