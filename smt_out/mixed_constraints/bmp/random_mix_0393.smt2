; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div onmouseover='alert&lpar;1&rpar;'>DIV</div>") (= x "<rp onkeydown=""alert(1)"" contenteditable>test</rp>")))
(assert (or (= z ">test</mark>") (= z "table>drop here</header>") (= z "1 onbeforedeactivate=alert(1)></summary><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains z "e>drop ") (str.suffixof "v>" x)))
(assert (or (= "<b>div draggable=""true"" contenteditable>drag me</div><dfn ondragover=alert(1) contenteditable>drop here</dfn>" (str.replace x "<" "<b>")) (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]{2,}")))))
(assert (or (str.contains x "down=""al") (str.prefixof "table>drop" z)))
(assert (or (str.prefixof "1 onb" z) (not (str.in_re z ((_ re.from_regex ecma2020) ".+\.[a-zA-Z]+$"))) (str.prefixof "<d" y)))
(check-sat)
