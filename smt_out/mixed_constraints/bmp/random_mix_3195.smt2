; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=x tabindex=1 onbeforedeactivate=alert(1)></div><input autofocus>") (= x "<![><img src=""]><img src=x onerror=javascript:alert(1)//"">") (= x "<small onbeforecopy=""alert(1)"" contenteditable>test</small>")))
(assert (or (= z "tivate=alert(1)></nobr>") (= z "t;SCRIPT SRC=//ha&#46;ckers&#46;org/&#46;js&gt;")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "&gt;" z)))
(assert (or (not (str.suffixof "nav>" y)) (str.prefixof "<" x)))
(assert (not (>= (str.len z) 21)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{4,5}-?[0-9]{4}"))))
(assert (= """ con" (str.substr x 23 5)))
(assert (= (str.indexof z "s" 0) 26))
(assert (or (not (str.prefixof "<s" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]+\.?[0-9]*$"))) (= "<div id=x t bindex=1 onbeforedeactivate=alert(1)></div><input autofocus>" (str.replace x "a" " "))))
(assert (or (str.contains z "0s"" ont") (= " SCRIPT SRC=//ha&#46;ckers&#46;org/&#46;js&gt;" (str.replace z "t;" " "))))
(check-sat)
