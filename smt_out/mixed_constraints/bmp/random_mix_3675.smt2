; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<p onbeforepaste=""alert(1)"" contenteditable>test</p>") (= x """autofocus/onfocus=alert(1)//")))
(assert (or (= z "av onkeypress=""alert(1)"" contenteditable>test</nav>") (= z ">") (= z "><menuitem id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></menuitem>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "><menuit" z) (not (= (str.indexof z ">" 0) 0))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[1-9]([0-9]?)(,[0-9]{1,2})?$"))))
(assert (str.contains z ">test</n"))
(assert (not (>= (str.len y) 93)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^\s*\S+.*$")) (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-9]{1,3}\.){3}[0-9]{1,3}$")))))
(assert (or (not (str.prefixof ">" z)) (= "aggable=" (str.substr x 10 8)) (not (= (str.indexof x "s=ale" 0) 17))))
(check-sat)
