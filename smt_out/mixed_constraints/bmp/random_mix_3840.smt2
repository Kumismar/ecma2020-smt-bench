; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=\""jav&#x0A;ascript:alert('XSS');\"">") (= x "<svg><legend onload=alert(1)></legend>")))
(assert (or (= z "=""transition:transform 2s"" ontransitionrun=alert(1)></aside>") (= z "<script>\xE2\x80\x83javascript:alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (or (= "0A;ascr" (str.substr x 17 7)) (>= (str.len y) 171) (not (str.in_re x ((_ re.from_regex ecma2020) "^(1[0-2]|0?[1-9])$")))))
(assert (or (str.contains (str.replace x "ad=a" """") "onlo""lert") (not (str.contains (str.replace y "!" "x") "pos;;x-")) (= (str.len z) 48)))
(assert (= (str.at z 4) "a"))
(assert (or (not (str.prefixof "<IM" y)) (not (str.contains z ")</")) (str.suffixof "aside>" y)))
(assert (or (not (str.suffixof "S');\"">" x)) (not (= (str.at z 9) "i"))))
(check-sat)
