; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""javascript\x3A:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<dt draggable=""true"" ondrag=""alert(1)"">test</dt>")))
(assert (or (= z "beforedeactivate=alert(1)></body><input autofocus>") (= z ">;<;/TABLE>;")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "/a>" x)))
(assert (str.prefixof "itable>t" z))
(assert (or (str.contains z "E>;") (= ">" (str.substr x 47 2))))
(assert (not (str.contains (str.replace x "t1"">" "javascript:") "enjavascript:t")))
(assert (not (= "t>" (str.substr x 46 6))))
(assert (= "t>" (str.substr x 46 3)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9_]+( [a-zA-Z0-9_]+)*$"))) (not (= (str.indexof x "r" 0) 5)) (= (str.indexof z "dy><" 0) 30)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9]{4,20}$"))))
(assert (str.contains x "ref=""java"))
(assert (str.prefixof "<dt" x))
(assert (not (str.contains x "ascrip")))
(assert (not (str.suffixof "<;/TABLE>;" y)))
(check-sat)
