; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo onmouseup=""alert(1)"">test</bdo>") (= x "<template draggable=""true"" ondragstart=""alert(1)"">test</template>")))
(assert (or (= z """alert(1)"" contenteditable>test</bdi>") (= z "lt;XSS STYLE=\""behavior&#58; url(xss&#46;htc);\""&gt;")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<bdo" x)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z.-]+\.[a-z]{2,}$"))))
(assert (or (= (str.at y 55) "a") (not (= "></iframe>" (str.substr y 33 10))) (= (str.len z) 52)))
(assert (not (= "=\""b" (str.substr y 48 4))))
(assert (= (str.indexof z "58; u" 0) 25))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{6,15}$")) (str.in_re x ((_ re.from_regex ecma2020) "^[_a-z0-9-]+(\.[_a-z0-9-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,6})$"))))
(assert (str.suffixof ");\""&gt;" y))
(assert (or (str.suffixof "gt;" y) (str.contains z "ivate=aler")))
(check-sat)
