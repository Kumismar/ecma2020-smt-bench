; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<figure onkeyup=""alert(1)"" contenteditable>test</figure>") (= x "<command onmousedown=""alert(1)"">test</command>") (= x "<bgsound onkeypress=""alert(1)"" contenteditable>test</bgsound>")))
(assert (or (= z "geonpagonpageonpageshowshoweshowshowgeshow=""alert(1)"";") (= z "le><rp id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></rp>") (= z "(1)"">test</p>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "e>le" 0) 54) (= "<figure " (str.substr x 0 8))))
(assert (not (str.contains z "eshows")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[1-9][0-9]{5}$")) (not (= "<figure onkeyup=""alert(1)"" contenteditable>test</figure>geonpagonpageonpageshowshoweshowshowgeshoalert(1)lert(1)"";" (str.replace y "w=""a" "alert(1)"))) (str.prefixof "<" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^\d*(\.\d{0,2})?$")) (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+-]+@(?!gmail.com)(?!yahoo.com)(?!hotmail.com)(?!yahoo.co.in)(?!aol.com)(?!live.com)(?!outlook.com)[a-zA-Z0-9_-]+.[a-zA-Z0-9-.]{2,61}$"))) (not (str.suffixof "/rp>" z))))
(assert (= (str.indexof z "</a>" 0) 2))
(check-sat)
