; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b onbeforecopy=""alert(1)"" contenteditable>test</b>") (= x "<link draggable=""true"" ondragenter=""alert(1)"">test</link>")))
(assert (or (= z "><br><br><br><br><br>\u{20000}<br><br>") (= z "sitioncancel=ale\u{1f4a9}rt(1)></optgroup>") (= z ")"">test</thead>")))
(assert (= y (str.++ x z)))
(assert (= ")"">" (str.substr y 57 3)))
(assert (or (not (str.contains x "t=ale")) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9A-Za-z\s]+"))) (= (str.at z 7) "<")))
(assert (or (not (= (str.at y 56) ">")) (str.contains x "te") (not (= (str.at x 79) """"))))
(assert (not (str.suffixof "thead>" y)))
(assert (or (not (str.suffixof "roup>" y)) (not (str.suffixof "<br>" y))))
(check-sat)
