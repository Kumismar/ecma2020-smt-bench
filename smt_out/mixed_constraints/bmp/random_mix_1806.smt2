; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark id=x tabindex=1 onfocusin=alert(1)></mark>") (= x "<div draggable=""true"" contenteditable>drag me</div><strong ondragover=alert(1) contenteditable>drop here</strong>")))
(assert (or (= z "oncontextmenu=""alert(1)"">test</noframes>") (= z "alert(1)"">test</body>") (= z "svg>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "id" 0) 6)) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9A-Za-z@._-]+$")))))
(assert (or (not (str.prefixof "aler" z)) (not (str.contains (str.replace z "y" "") "d>")) (not (str.in_re x ((_ re.from_regex ecma2020) "^(http:\/\/www\.|https:\/\/www\.|http:\/\/|https:\/\/)?[a-zA-Z0-9]+([\-\.]{1}[a-zA-Z0-9]+)*\.[a-z]{2,5}(:[0-9]{1,5})?(\/.*)?$")))))
(assert (or (= (str.len z) 40) (= "id>st" (str.substr y 40 5)) (not (str.in_re z ((_ re.from_regex ecma2020) "^((ftp|http|https):\/\/)?(www.)?(?!.*(ftp|http|https|www.))[a-zA-Z0-9_-]+(\.[a-zA-Z]+)+((\/)[\w#]+)*(\/\w+\?[a-zA-Z0-9_]+=\w+(&[a-zA-Z0-9_]+=\w+)*)?$")))))
(assert (not (= (str.at x 15) """")))
(assert (not (str.contains x "rop ")))
(check-sat)
