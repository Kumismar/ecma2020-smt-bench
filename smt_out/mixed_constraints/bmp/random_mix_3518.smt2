; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tt id=x tabindex=1 onfocus=alert(1)></tt>") (= x "top[""al""+""ert""](1)") (= x "<base ondblclick=""alert(1)"">test</base>")))
(assert (or (= z "alert(1)"">test</embed>") (= z "SS%29//")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "S%2")))
(assert (or (str.contains y "1)"">tes") (= (str.len z) 7)))
(assert (or (not (= "a<b>t(1)"">test</embed>" (str.replace z "ler" "<b>"))) (= (str.indexof x "l" 0) 6) (not (= (str.indexof z "SS" 0) 0))))
(assert (or (not (str.suffixof "9//" z)) (not (= (str.at z 2) "%")) (not (= "t" (str.substr y 66 1)))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z]{3,10}$"))))
(check-sat)
