; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary id=x tabindex=1 onbeforeactivate=alert(1)></summary>") (= x "<~/XSS STYLE=xss:expression(alert('XSS'))>")))
(assert (or (= z "</progress>") (= z "1)"" contenteditable>test</link>") (= z "vg xmlns=""http://www.w3.org/2000/svg"">")))
(assert (= y (str.++ x z)))
(assert (= ">" (str.substr x 59 8)))
(assert (or (<= (str.len z) 43) (= (str.indexof x "ler" 0) 29)))
(assert (or (not (str.prefixof "/www.site" z)) (str.contains z "test<") (not (str.in_re y ((_ re.from_regex ecma2020) "^[\w.%+-]+@[^-]([\w-]+\.)+[\w-]{2,6}$")))))
(assert (str.prefixof "<~/XSS STY" x))
(assert (or (not (= (str.indexof z """ con" 0) 2)) (not (str.prefixof "e=" z))))
(assert (not (str.suffixof "te>" x)))
(assert (or (not (= "<summary id=x tabindex=1 onbeforeactivate=alert(1)></summary>vg xmlns=""http://www"".org/2000/svg"">" (str.replace y ".w3" """"))) (not (str.contains (str.replace y "pr" "<b>") "y></<b>ogres")) (not (= "<~/XSS STYLE=xss:expression(alert('XS<b>)></progress>" (str.replace y "S')" "<b>")))))
(check-sat)
