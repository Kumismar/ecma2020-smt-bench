; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "%253Cscript%253Ealert('XSS')%253C%252Fscript%253E") (= x "<aside oncopy=""alert(1)"" contenteditable>test</aside>") (= x "<var onmouseover=""prompt(1)"">On Mouse Over</var>")))
(assert (or (= z "ummary ondblclick=""alert(1)"">test</summary>") (= z """alert(1)"">test</tt>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[\d\- ]+$"))) (= ">test<" (str.substr z 28 6))))
(assert (= "%25xscript%253Ealert('XSS')%253C%252Fscript%253E" (str.replace x "3C" "x")))
(assert (or (str.contains (str.replace y """>t" "<b>") ")<b>es") (= (str.indexof x "5" 0) 2)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9.,]+"))) (not (str.contains y "y "))))
(assert (or (not (str.suffixof ">" z)) (not (= (str.at z 25) "1")) (str.prefixof "<as" y)))
(assert (= (str.at z 9) "d"))
(assert (or (= (str.at z 0) "e") (not (str.in_re y ((_ re.from_regex ecma2020) ".*83tsU.*")))))
(check-sat)
