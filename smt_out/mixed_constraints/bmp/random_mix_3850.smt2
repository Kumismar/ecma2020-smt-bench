; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video onclick=""alert(1)"">test</video>") (= x "&lt;META HTTP-EQUIV=\""refresh\"" CONTENT=\""0;url=javascript&#058;alert('XSS');\""&gt;") (= x "<html onMouseDown html onMouseDown=""javascript:javascript:alert(1)""></html onMouseDown>")))
(assert (or (= z "ascript:alert((A))>") (= z "ve=""alert(1)"">test</hr>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 14) "(")))
(assert (not (str.contains y "video>as")))
(assert (or (not (= "avasc" (str.substr x 49 5))) (str.suffixof "rt((A))>" z) (not (= "click=""al" (str.substr x 9 9)))))
(assert (not (= (str.at y 72) "c")))
(assert (or (not (str.suffixof ">" x)) (not (str.prefixof "as" z))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "(?=^.{8,}$)(?=.*\d)(?=.*\W+)(?![.\n])(?=.*[A-Z])(?=.*[a-z]).*$"))))
(assert (or (<= (str.len z) 30) (not (= (str.at z 3) """"))))
(assert (or (>= (str.len y) 74) (not (str.in_re z ((_ re.from_regex ecma2020) "^\d{9,13}$"))) (str.suffixof "Down>" x)))
(check-sat)
