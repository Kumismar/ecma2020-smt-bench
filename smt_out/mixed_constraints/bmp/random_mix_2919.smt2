; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q id=x tabindex=1 onbeforeacti\u{1d400}vate=alert(1)></q>") (= x "<cite onmouseover=""alert(1)"">test</cite>")))
(assert (or (= z "</sup>") (= z "alert(1)"">test</blink>") (= z "rt(1)"">test</bdo>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x " " 0) 10))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3})$"))))
(assert (= "ck=""alert(x)"">test</shadow>" (str.replace z "1" "x")))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^.{5}$")) (= "mouseo" (str.substr y 8 6)) (= (str.indexof y "(1)><" 0) 42)))
(assert (or (not (= (str.indexof y "eover" 0) 12)) (not (str.prefixof "<c" x))))
(assert (str.suffixof "></sup>" y))
(assert (or (not (<= (str.len y) 63)) (not (str.in_re z ((_ re.from_regex ecma2020) "[0789][0-9]{9}")))))
(check-sat)
