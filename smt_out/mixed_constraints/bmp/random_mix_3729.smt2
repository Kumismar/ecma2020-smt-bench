; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<spacer draggable=""true"" ondragenter=""alert(1)"">test</spacer>") (= x "\u{1f4a9}<menu draggable=""true"" ondrag=""alert(1)"">test</menu>")))
(assert (or (= z "keyup=""alert(1)"" contenteditable>test</a>") (= z "ls onmouseup=""alert(\u{10348}\u{1f4a9}1)"">test</details>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "o" 0) 18)) (not (str.suffixof "s>" y)) (= (str.indexof x "(1)"">" 0) 43)))
(assert (or (not (<= (str.len x) 68)) (str.in_re y ((_ re.from_regex ecma2020) ".{2,50}$")) (str.contains z "useup=""ale")))
(assert (or (not (str.prefixof "\u{1f4a9}<m" x)) (str.suffixof "ails>" z)))
(assert (or (= (str.at z 2) " ") (not (str.in_re x ((_ re.from_regex ecma2020) "^(?!.+@(gmail|google|yahoo|outlook|hotmail|msn)\..+).+@.+\..+$")))))
(assert (or (str.suffixof "group>" x) (str.contains (str.replace y "r dr" "alert(1)") "pacealert(1)a")))
(assert (= (str.at y 78) "d"))
(check-sat)
