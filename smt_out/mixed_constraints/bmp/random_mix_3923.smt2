; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr onmouseenter=""alert(1)"">test</hr>") (= x "<datalist draggable=""true"" ondragleave=""alert(1)"">test</datalist>") (= x "<svg onbeforepaste=""alert(1)"" contenteditable>test</svg>")))
(assert (or (= z "ocusin=alert(1)></bdo>") (= z "#X000003c") (= z "t(1)""></body onkeydown>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "#X000003c" z))
(assert (or (not (str.prefixof "#X00000" z)) (not (str.in_re x ((_ re.from_regex ecma2020) "^\s*\d\s*")))))
(assert (or (= (str.at z 2) "0") (str.contains x ">tes") (str.contains z "00")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^\S[\w \u{df}\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}]*"))))
(assert (or (not (str.suffixof ">;" z)) (not (= "io>" (str.substr z 20 3)))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^\w+((-\w+)|(\.\w+))*\@[A-Za-z0-9]+((\.|-)[A-Za-z0-9]+)*\.[A-Za-z0-9]+$"))))
(assert (or (= (str.indexof z "/bd" 0) 17) (<= (str.len y) 90) (>= (str.len y) 51)))
(assert (str.suffixof "3c" z))
(check-sat)
