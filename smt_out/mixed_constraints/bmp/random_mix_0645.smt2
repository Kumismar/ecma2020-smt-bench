; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><strike ondrop=alert(1) contenteditable>drop here</strike>") (= x "<svg><script onlypossibleinopera:-)\u{1d400}> alert(\u{10348}1)")))
(assert (or (= z "ript&#058;alert('XSS')\""&gt;") (= z "contenteditable>test</rb>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<svg><s" x)) (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z\u{c0}\u{c1}\u{c2}\u{c3}\u{c4}\u{c5}\u{c6}\u{c7}\u{c8}\u{c9}\u{ca}\u{cb}\u{cc}\u{cd}\u{ce}\u{cf}\u{d0}\u{d1}\u{d2}\u{d3}\u{d4}\u{d5}\u{d6}\u{d8}\u{d9}\u{da}\u{db}\u{dc}\u{dd}\u{de}\u{df}\u{e0}\u{e1}\u{e2}\u{e3}\u{e4}\u{e5}\u{e6}\u{e7}\u{e8}\u{e9}\u{ea}\u{eb}\u{ec}\u{ed}\u{ee}\u{ef}\u{f0}\u{f1}\u{f2}\u{f3}\u{f4}\u{f5}\u{f6}\u{f8}\u{f9}\u{fa}\u{fb}\u{fc}\u{fd}\u{fe}\u{ff}]*$")))))
(assert (or (str.contains z "></b") (str.contains z ")\""&gt")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^1[0-9]{10}$"))))
(assert (or (not (str.contains z "ble")) (<= (str.len z) 30)))
(assert (or (not (= (str.at y 115) "0")) (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z0-9_\.\-])+\@(([a-zA-Z0-9\-]{2,})+\.)+([a-zA-Z0-9]{2,})+$")))))
(check-sat)
