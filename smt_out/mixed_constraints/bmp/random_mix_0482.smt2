; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select onmouseout=""alert(1)"">test</select>") (= x "<keygen id=x onfocusin=alert(1)>")))
(assert (or (= z ") contenteditable>drop here</q>") (= z "ss=""alert(String.fromCharCode(88,83,83))"">") (= z "ieldset>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "rop here")))
(assert (= ">drop he" (str.substr z 17 8)))
(assert (not (>= (str.len z) 1)))
(assert (or (<= (str.len x) 41) (not (str.contains (str.replace y "mous" """") "n""eo")) (str.suffixof "e</q>" y)))
(assert (or (not (= "#x3A;a" (str.substr x 26 6))) (not (str.suffixof "hr>" z))))
(assert (str.contains z "eldset"))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "(([0-9A-Za-z]{1}[-0-9A-z\.]{1,}[0-9A-Za-z]{1})@([-A-Za-z]{1,}\.){1,2}[-A-Za-z]{2,})$"))))
(check-sat)
