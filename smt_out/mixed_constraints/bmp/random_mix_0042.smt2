; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<fieldset draggable=""true"" ondragleave=""alert(1)"">test</fieldset>") (= x "<abbr ondblclick=""alert(1)"">test</abbr>")))
(assert (or (= z "eforecopy=""alert(1)"" contenteditable>test</datalist>") (= z "@keyframes x{}</style><tbody style=""animation-name:x"" onanimationend=""alert(1)""></tbody>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<XML SRC=""http://ha.ckers.org/xssalert(1)xml"" ID=I></XML>mouseup=""alert(1)"">test</ul>" (str.replace y "test." "alert(1)"))) (= "ntentedit" (str.substr y 88 9)) (str.contains z "s x")))
(assert (not (= (str.indexof x ")" 0) 47)))
(assert (or (not (str.contains (str.replace y "/data" """") "t<""li")) (not (= (str.len y) 127))))
(assert (or (not (= (str.indexof x "t</a" 0) 31)) (not (>= (str.len x) 133)) (not (= (str.at y 101) "a"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{1,}$"))) (= (str.indexof y "test<" 0) 28) (not (= (str.at y 12) "l"))))
(assert (or (not (str.contains y "forecopy")) (not (str.suffixof "talist>" y)) (str.contains (str.replace y "ed" "x") "entxitab")))
(check-sat)
