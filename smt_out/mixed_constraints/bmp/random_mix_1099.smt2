; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "'%22--%3E%3C/style%3E%3C/script%3E%3Cscript%3Eshadowlabs(0x000045)%3C/script%3E") (= x "<plaintext onkeypress=""alert(1)"" contenteditable>test</plaintext>")))
(assert (or (= z "]>]</div>") (= z "t(1)"" contenteditable>test</plaintext>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9\.\-]{8,11}$"))) (= (str.at y 19) "s") (not (= "'%22--%3E%3C/syle%3E%3C/script%3E%3Cscript%3Eshadowlabs(0x000045)%3C/script%3Et(1)"" contenteditable>test</plaintext>" (str.replace y "t" "")))))
(assert (or (str.prefixof "<pla" y) (not (str.suffixof ">]</div>" z))))
(assert (or (not (= (str.at y 28) "i")) (not (= "t(1)"" cojavascript:nteditable>test</plaintext>" (str.replace z "nte" "javascript:")))))
(assert (or (= (str.at y 65) ")") (not (= "t(1)"" con""nteditable>test</plaintext>" (str.replace z "te" """"))) (str.suffixof "us>" x)))
(assert (or (str.contains x "/script%") (not (str.in_re x ((_ re.from_regex ecma2020) "^((\+\d{1,3}(-| )?\(?\d\)?(-| )?\d{1,5})|(\(?\d{1,6}\)?))(-| )?(\d{1,4})(-| )?(\d{1,4})(( x| ext)\d{1,5}){0,1}$")))))
(assert (not (str.prefixof "'%22--%3E%" y)))
(check-sat)
