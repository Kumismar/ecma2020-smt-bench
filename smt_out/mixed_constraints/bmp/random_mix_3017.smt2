; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<xss id=x tabindex=1 onfocusout=alert(1)></xss><input autofocus>") (= x "<address onmousedown=""alert(1)"">test</address>")))
(assert (or (= z "(1)"">test</option>") (= z "ert(1)"" contenteditable>test</footer>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at z 24) "l")))
(assert (or (>= (str.len x) 62) (str.in_re x ((_ re.from_regex ecma2020) "[0]{1}[0-9]{2}[0-9]{7}")) (str.contains (str.replace y "addr" "<b>") "<<b>es")))
(assert (or (= "rt(1)"" contenteditable>test</footer>" (str.replace z "e" "")) (not (= (str.indexof z " " 0) 9)) (= "o" (str.substr y 25 1))))
(assert (or (<= (str.len z) 26) (str.contains x " id=x ta") (not (str.prefixof "<xs" y))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z\u{415}\u{4b9}\u{413}\u{458}\u{413}\u{b6}\u{414}\u{4b1}\u{414}\u{4b9}\u{413}\u{a7}\u{415}\u{4bb}\u{413}\u{4a3}\u{413}\u{2013}\u{414}\u{b0}\u{414}\u{4bb}\u{413}\u{4ae}0-9-_\.]{1,15}$"))))
(check-sat)
