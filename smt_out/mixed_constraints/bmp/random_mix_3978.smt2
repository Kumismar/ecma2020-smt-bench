; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "&lt;IMG STYLE=\""xss&#58;expr/*XSS*/ession(alert('XSS'))\""&gt;") (= x "<li draggable=""true"" ondrag=""alert(1)"">test</li>") (= x "<output onclick=""alert(1)"">test</output>")))
(assert (or (= z "(1)"">test</marquee>") (= z "st</rb>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof x "<x" 0) 0))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,3}$"))))
(assert (not (<= (str.len x) 53)))
(assert (str.prefixof "<li dragg" x))
(assert (or (not (= (str.indexof x "clic" 0) 10)) (= "marquee>" (str.substr z 11 10)) (str.contains z "ee")))
(assert (or (str.contains z "te") (str.contains y "ick=""aler")))
(assert (= (str.at z 5) "b"))
(assert (or (= (str.indexof x "true""" 0) 15) (not (str.in_re x ((_ re.from_regex ecma2020) "(.){3,}")))))
(check-sat)
