; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del onmouseover=""alert(1)"">test</del>") (= x "<noembed id=x tabin\u{10348}dex=1 onfocus=alert(1)></noembed>")))
(assert (or (= z "|\]^`=document.vulnerable=true;>") (= z "est</plaintext>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9 ]{5,}"))))
(assert (str.contains x "eover"))
(assert (not (str.contains (str.replace z ";>" " ") "e ")))
(assert (or (not (= "t(" (str.substr x 38 2))) (not (<= (str.len x) 46))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*([^a-zA-Z\d\s])).{8,}$"))) (str.contains (str.replace y "o" "alert(1)") "el alert(1)n")))
(assert (or (not (<= (str.len y) 73)) (not (= "er" (str.substr y 36 2)))))
(check-sat)
