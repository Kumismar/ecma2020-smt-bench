; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onmouseenter=""alert(1)"">test</rtc>") (= x "<thead ondblclick=""alert(1)"">test</thead>")))
(assert (or (= z "2000/svg"">") (= z " contenteditable>drop here</time>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "t</thead>" x)))
(assert (or (not (= "er=""ale" (str.substr x 15 7))) (not (str.contains y "le>dro"))))
(assert (or (str.contains x "/s") (not (= (str.indexof x "n" 0) 6))))
(assert (or (not (= "rtc onmou" (str.substr y 1 9))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z0-9_]{1,64}$"))) (str.suffixof "</time>" y)))
(assert (str.contains x "be"))
(assert (not (= (str.at y 23) "t")))
(assert (not (= (str.indexof y "ert(1" 0) 21)))
(assert (or (str.contains (str.replace y """al" "javascript:") "wn=javascript:e") (not (= "<rtc onmouseenter=""alert(1)"">test</rtc> c""enteditable>drop here</time>" (str.replace y "ont" """")))))
(check-sat)
