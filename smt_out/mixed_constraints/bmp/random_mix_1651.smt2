; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section onmouseleave=""al\u{1f600}ert(1)"">test</section>") (= x "ABC<div style=""x:\xE2\x80\x85expression(javascript:alert(1)"">DEF") (= x "<small oncopy=""alert(1)"" contenteditable>test</small>")))
(assert (or (= z "=&;#x6A&;#x61&;#x76&;#x61&;#x73&;#x63&;#x72&;#x69&;#x70&;#x74&;#x3A&;#x61&;#x6C&;#x65&;#x72&;#x74&;#x28&;#x27&;#x58&;#x53&;#x53&;#x27&;#x29>;") (= z " id=x tabindex=1 onbeforeactivate=alert(1)></em>") (= z "aption>")))
(assert (= y (str.++ x z)))
(assert (or (= "=&;#x6A&;#x61&;#x76&;#x61&;#x73&;#x63&;#x7 &;#x69&;#x70&;#x74&;#x3A&;#x61&;#x6C&;#x65&;#x72&;#x74&;#x28&;#x27&;#x58&;#x53&;#x53&;#x27&;#x29>;" (str.replace z "2" " ")) (not (= (str.at z 16) "l"))))
(assert (or (str.prefixof "ABC<di" y) (str.prefixof "<small o" x) (not (str.prefixof "ABC" y))))
(assert (not (str.contains (str.replace y " o" "javascript:") "lljavascript:ncopy")))
(assert (not (str.contains y "x72&;#x69&")))
(assert (or (not (= ">test</sma" (str.substr y 40 10))) (not (str.in_re x ((_ re.from_regex ecma2020) "^.{1,8}$"))) (not (str.suffixof "mall>" x))))
(check-sat)
