; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<IMG SRC=javascrscriptipt:alert('XSS')>") (= x "<ul onmouseup=""alert(1)"">test</ul>") (= x "<div style=""background:url(test5.svg)"">PRESS ENTER</div>//[""'`-->]]>]</div>")))
(assert (or (= z "ck onbeforepaste=""alert(1)"" contenteditable>test</track>") (= z "x=1 id=x></content><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (>= (str.len y) 93)))
(assert (or (= (str.at z 25) ")") (str.prefixof "<div" x) (str.in_re y ((_ re.from_regex ecma2020) "^[^@]+@[^@]+\.[a-zA-Z]{2,}$"))))
(assert (or (not (= (str.at y 1) "I")) (str.suffixof "]</div>" x) (<= (str.len x) 41)))
(assert (not (= (str.indexof x ">]" 0) 64)))
(assert (str.contains x """al"))
(check-sat)
