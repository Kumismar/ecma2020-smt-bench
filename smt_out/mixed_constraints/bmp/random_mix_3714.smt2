; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color: red;}</style><tt id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></tt>") (= x "<textarea onk\u{1f600}eypress=""alert(1)"" contenteditable>test</textarea>")))
(assert (or (= z "<img/onerror=\x09javascript:alert(1)\x09src=xxx:x />") (= z "ipt:javascript:alert(1);"">") (= z "alert(1)"">test</dfn>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<img/onrror=\x09javascript:alert(1)\x09src=xxx:x />" (str.replace z "e" ""))) (= (str.indexof x "lor:" 0) 18) (not (str.in_re x ((_ re.from_regex ecma2020) ".{5,150}")))))
(assert (not (str.prefixof "<style>" x)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^\+[1-9]{1}[0-9]{3,14}$")) (not (= (str.indexof y "\x" 0) 77)) (<= (str.len x) 66)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^(?:[1-9]|\d\d\d*)$"))) (not (str.contains (str.replace y "ance" "") "cl")) (not (str.suffixof "h1>" x))))
(check-sat)
