; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ins draggable=\u{1f4a9}""true"" ondragenter=""a\u{10348}lert(1)"">test</ins>") (= x "<style>@keyframes x{}</style><\u{1f600}details style=""animation-name:x"" onanimationstart=""alert(1)""></details>") (= x "<figcaption draggable=""true"" ondragleave=""alert(1)"">test</figcaption>")))
(assert (or (= z "aggable=""true"" ondragend=""\u{1f4a9}alert(1)"">test</address>") (= z "st</input>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 53) "i") (not (= (str.indexof y "(1)""" 0) 47)) (not (= """ins draggable=\u{1f4a9}""true"" ondragenter=""a\u{10348}lert(1)"">test</ins>st</input>" (str.replace y "<" """")))))
(assert (or (str.prefixof "<ins drag" x) (= (str.indexof z "put>" 0) 6) (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9]{6,})$")))))
(assert (or (not (= (str.indexof x "x{}</" 0) 18)) (= "ert(1)""" (str.substr x 44 7)) (not (str.suffixof ">" y))))
(assert (= "<ins drag" (str.substr x 0 9)))
(assert (str.contains (str.replace z """>tes" "<b>") "t(1)<b>t</"))
(assert (or (not (str.contains y "ert(")) (not (str.contains y "ion drag")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9A-Za-z@._-]+$")))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "7$"))))
(check-sat)
