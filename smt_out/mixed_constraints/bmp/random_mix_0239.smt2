; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dir onbeforepaste=""alert(1)"" contenteditable>test</dir>") (= x "<keygen onmou\u{20000}semove=""alert(1)"">test</keygen>")))
(assert (or (= z "sedown=""alert(1)"">test</rtc>") (= z " draggable=""true"" ondragenter=""alert(1)"">test</ol>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "t</rtc>" z))
(assert (= " draggablejavascript:rue"" ondragenter=""alert(1)"">test</ol>" (str.replace z "=""t" "javascript:")))
(assert (or (= (str.at z 4) "g") (str.prefixof "<keygen " x)))
(assert (or (str.contains (str.replace x "d" "javascript:") "<javascript:i") (= (str.len x) 56) (not (str.in_re x ((_ re.from_regex ecma2020) "^\s*1\d{10}\s*$")))))
(assert (or (not (str.contains (str.replace z """" "x") "e=xtrue")) (not (= (str.len y) 106)) (= "st<" (str.substr z 20 3))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z-\s]+$")))
(check-sat)
