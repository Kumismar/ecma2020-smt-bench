; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<svg oncut=""alert(1)"" contenteditable>test</svg>") (= x "<hgroup onclick=""alert(1)"">test</hgroup>")))
(assert (or (= z "ert(1)"">test</dfn>") (= z "1)???") (= z "enteditable>test</strong>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<svg" y) (= "<hgroup onclick="" rt(1)"">test</hgroup>" (str.replace x "ale" " "))))
(assert (or (= (str.indexof z """>" 0) 1) (str.contains x "(1)"" con") (not (str.in_re z ((_ re.from_regex ecma2020) "treize heures")))))
(assert (not (= (str.len x) 48)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{7,15}$"))) (not (str.prefixof "<hgro" x))))
(check-sat)
