; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<X OnXxx=1") (= x "<meta onkeypress=""alert(1)"" contenteditable>test</meta>")))
(assert (or (= z "var>") (= z ")"">te\u{1f4a9}st</rp>") (= z "e</div><bdi ondrop=alert(1) contenteditable>drop here</bdi>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "SCRIPT&gt;" x) (<= (str.len y) 74) (>= (str.len y) 61)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([A-Za-z]{2}[ \-]?[0-9]{2})(?=(?:[ \-]?[A-Za-z0-9]){9,30}$)((?:[ \-]?[A-Za-z0-9]{3,5}){2,6})([ \-]?[A-Za-z0-9]{1,3})?$"))) (str.contains x "index=1 on")))
(assert (or (str.prefixof "<X On" x) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-z.A-Z0-9]+$"))) (not (str.contains x "</ifram"))))
(assert (or (not (str.contains (str.replace x "rt(1" """") "=""ale"")"" co")) (not (= (str.at x 23) "("))))
(assert (= "alert(1)meta onkeypress=""alert(1)"" contenteditable>test</meta>" (str.replace x "<" "alert(1)")))
(assert (not (= ")"">alert(1)t</rp>" (str.replace z "te\u{1f4a9}s" "alert(1)"))))
(assert (or (not (= (str.indexof z ">" 0) 2)) (= (str.at z 1) "a")))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z0-9-.]+"))))
(check-sat)
