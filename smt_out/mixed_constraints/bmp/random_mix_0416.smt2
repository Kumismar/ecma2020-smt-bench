; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><ruby ondrop=alert(1) contenteditable>drop here</ruby>") (= x "<var onblur=alert(1) tabindex=1 id=x></var><input autofocus>") (= x "<span onkeyup=""alert(1)"" contenteditable>test</span>")))
(assert (or (= z ": url(http://ha.ckers.org/xss.htc);"";>;") (= z "88,83,83))"">")))
(assert (= y (str.++ x z)))
(assert (not (= (str.len y) 91)))
(assert (= (str.at x 30) "d"))
(assert (not (str.contains (str.replace z "://ha" "") "p.")))
(assert (or (= "/ha.cker" (str.substr y 72 8)) (not (str.in_re x ((_ re.from_regex ecma2020) "^([A-z0-9._%+-]+@[A-z0-9.-]+\.[A-z]{2,6})|([0-9-\s]{10,})$"))) (str.prefixof "88,8" z)))
(assert (or (not (str.suffixof "autofocus>" x)) (not (>= (str.len x) 52))))
(assert (or (str.suffixof "re</ruby>" x) (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9]{1,30}$")))))
(assert (not (= (str.indexof y "rs.o" 0) 71)))
(assert (= (str.len x) 50))
(assert (or (str.suffixof """>C" y) (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{2}[0-9]{4,5}[0-9]{4}$")))))
(check-sat)
