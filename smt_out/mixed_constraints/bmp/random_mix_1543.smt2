; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main onclick=""alert(1)"">test</main>") (= x "'""""><script language=""JavaScript""> alert('X \nS \nS');</script>") (= x "<embed onkeydown=""alert(1)"" contenteditable>test</embed>")))
(assert (or (= z "t(1)"" contenteditable>test</td>") (= z "1 onactivate=alert(1)></footer>") (= z ">test</hgroup>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "'""""><scrip" y))
(assert (or (not (= (str.indexof z "test<" 0) 1)) (str.contains y "le") (str.suffixof "/footer>" y)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(0[0-9]|1[0-9]|2[0-3]):([0-5][0-9])$"))) (= "alert('X" (str.substr x 35 8)) (str.contains z ">tes")))
(assert (or (str.suffixof "st</main>" x) (= "ck" (str.substr x 14 2))))
(assert (str.contains (str.replace y "r" """") """><sc""ipt l"))
(assert (not (>= (str.len x) 58)))
(assert (or (str.suffixof "group>" z) (not (str.prefixof "<embed o" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "([0-9\+\/\(\)\-]{5,})*$")))))
(check-sat)
