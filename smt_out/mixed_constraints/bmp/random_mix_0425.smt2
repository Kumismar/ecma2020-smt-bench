; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<noscript id=x tabindex=1 onfocus=alert(1)></noscript>") (= x "<script>alert(1)</script\u{10348}>") (= x "<html onmouseenter=""alert(1)"">test</html>")))
(assert (or (= z "alert(1)"">test</meter>") (= z "l""+""ert""](1)") (= z "2=x onerror=""javascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len x) 63) (str.contains x "ript")))
(assert (or (= (str.indexof z "</m" 0) 14) (not (str.contains z "l""+"""))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-\u{17e}0-9-\u{201e}\u{201c},#+!&.?\u{2019}\u{2018}()' ]{10,}$"))))
(assert (or (not (= "sc" (str.substr x 1 2))) (not (str.prefixof "<style>:ta" x)) (not (= "index=1 on" (str.substr x 18 10)))))
(assert (or (not (= "<html onmouseente""alert(1)"">test</html>" (str.replace x "r=" ""))) (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}_'\s]+$"))))
(assert (not (= (str.at x 45) "e")))
(assert (or (not (str.prefixof "ble" z)) (not (= "r=""aler" (str.substr y 17 7)))))
(check-sat)
