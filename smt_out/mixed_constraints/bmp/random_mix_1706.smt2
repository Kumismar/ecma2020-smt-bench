; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a style=""-o-link:'javascript:javascript:alert(1)';-o-link-source:current"">X") (= x "<bdo draggable=""true"" ondragstart=""alert(1)"">test</bdo>") (= x "<font onmouseover=""alert(1)"">test</font>")))
(assert (or (= z "g me</div><template ondrop=alert(1) contenteditable>drop here</template>") (= z "nactivate=alert(1)></sub>") (= z "t(1);")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x "style" 0) 3) (not (>= (str.len z) 72))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "(?=.*[a-z])(?=.*[A-Z]).{6,}"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{1,15}$"))) (not (str.prefixof "g " z))))
(assert (or (str.contains (str.replace z ")" "alert(1)") "t(1alert(1);") (not (str.in_re x ((_ re.from_regex ecma2020) "^\u{41d}\u{43e}\u{43c}\u{435}\u{440} \u{442}\u{435}\u{43b}\u{435}\u{444}\u{43e}\u{43d}\u{443}$")))))
(assert (not (= (str.len z) 72)))
(assert (or (str.contains y "-sour") (>= (str.len z) 2) (not (= (str.indexof y "ggabl" 0) 8))))
(assert (= "<ol onmouseov alert(1)"">test</ol>" (str.replace x "er=""" " ")))
(assert (str.contains (str.replace z "scrip" "alert(1)") "/alert(1)t"))
(assert (str.suffixof "mplate>" y))
(check-sat)
