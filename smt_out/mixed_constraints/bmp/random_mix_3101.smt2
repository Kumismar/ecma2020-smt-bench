; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<strike onkeypress=""alert(1)"" contenteditable>test</strike>") (= x "&lt;IMG SRC=&quot; &amp;#14;  javascript:alert(&apos;XSS&apos;);&quot;&gt;")))
(assert (or (= z "ontextmenu=""alert(1)"">test</frame>") (= z ">test</time>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len x) 38)) (not (= (str.at y 55) "i"))))
(assert (or (not (= "st</t" (str.substr z 3 5))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{4,8}$")))))
(assert (or (str.contains x "vascri") (not (= (str.at z 0) ">")) (not (>= (str.len y) 89))))
(assert (not (str.suffixof "</big>" z)))
(assert (not (= (str.indexof x "/" 0) 42)))
(assert (or (str.suffixof "</time>" y) (not (= "tentedita" (str.substr x 33 9)))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}_'\s\d]+$")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[^@]*@[^@]*[.][^@]*[^@]"))))
(assert (str.suffixof "ke>" x))
(check-sat)
