; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<header draggable=""true"" ondrag=""alert(1)"">test</header>") (= x "<div style=""binding: url(http://www.securitycompass.com/xss.js);""> [Mozilla]") (= x "<kbd id=x tabindex=1 onfocus=alert(1)></kbd>")))
(assert (or (= z "onmouseleave=""a\u{1f600}lert(1)"">test</iframe>") (= z "st</abbr>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<hea" y) (not (str.prefixof "st</ab" z)) (= "<kbd id=x tabindex=1 onfocus=alert(1)></kbd>onmouse""=""a\u{1f600}lert(1)"">test</iframe>" (str.replace y "leave" """"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Z,1-9]{6}"))) (not (= (str.indexof z "for" 0) 8))))
(assert (or (not (str.suffixof "e>" y)) (= (str.at x 19) "1") (not (= "ue"" ond" (str.substr x 21 7)))))
(assert (not (str.suffixof "t</iframe>" z)))
(check-sat)
