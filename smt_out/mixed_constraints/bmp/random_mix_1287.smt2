; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\x0Bjavascript:alert(1)</script>") (= x "<sub oncut=""alert(1)"" contenteditable>test</sub>")))
(assert (or (= z "<script>alert(navigator.userAgent)</script>></body>") (= z "alert(1)"">test</bdo>")))
(assert (= y (str.++ x z)))
(assert (or (not (= ">" (str.substr y 11 1))) (not (>= (str.len x) 45))))
(assert (not (str.contains y "gator.u")))
(assert (not (= (str.at x 37) ">")))
(assert (or (not (str.contains z "ipt>alert")) (not (str.contains (str.replace y "g" "javascript:") "ijavascript:ator.")) (not (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9. ,-]+")))))
(assert (or (not (= (str.indexof x "ert(" 0) 29)) (not (str.prefixof """`'><scr" x))))
(check-sat)
