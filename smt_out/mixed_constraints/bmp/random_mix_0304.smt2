; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<script>alert(document.getElementsByTagName('html')[0].innerHTML.match(/'([^']%2b)/)[1])</script>") (= x "&#X003c")))
(assert (or (= z "quee><h1>XSS</h1></marquee>") (= z "up=""alert(1)"">test</frame>") (= z "l>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains x "#X0") (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z]*$")) (not (str.prefixof "<script>" y))))
(assert (or (not (str.suffixof "ipt>" x)) (not (= "ipt>" (str.substr y 93 4)))))
(assert (or (not (str.prefixof "u" z)) (= (str.indexof y "<" 0) 0)))
(assert (or (not (str.suffixof ">" z)) (not (str.prefixof "l" z)) (str.suffixof "me>" y)))
(check-sat)
