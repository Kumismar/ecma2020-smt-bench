; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del onpaste=""alert(1)"" contenteditable>test</del>") (= x "<var oncontextmenu=""alert(1)"">test</var>") (= x "<div draggable=""true"" contenteditable>drag me</div><shadow ondrop=alert(1) contenteditable>drop here</shadow>")))
(assert (or (= z "x=1 onbeforeactivate=alert(1)></basefont>") (= z "up=""alert(1)"">test</h1>") (= z "tenteditable>test</button>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.\-_]+@[a-zA-Z0-9\-]+\.[a-z]+")) (not (= (str.at y 58) "f"))))
(assert (or (= "<var onconxenu=""alert(1)"">test</var>" (str.replace x "textm" "x")) (not (= (str.at x 8) "o")) (= (str.at y 8) "a")))
(assert (not (= "(1)"" conte" (str.substr x 19 10))))
(assert (or (str.contains (str.replace z "onbef" "alert(1)") " alert(1)ore") (str.prefixof "tentedit" z) (<= (str.len x) 61)))
(assert (not (= "onpa" (str.substr y 5 4))))
(check-sat)
