; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<handler id=""y"">alert(127)</handler>") (= x "<style>@keyframes x{}</style><mark style=""animation-name:x"" onanimationend=""alert(1)""></mark>")))
(assert (or (= z "tmenu=""alert(1)"">test</font>") (= z "/caption>") (= z " onfocus=alert(1)></ins>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "ndler>" x) (<= (str.len z) 27)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[6]{1}")) (str.prefixof "/c" z) (str.contains x "handl")))
(assert (or (str.suffixof "(1)></ins>" y) (not (= (str.at x 24) "7")) (str.in_re z ((_ re.from_regex ecma2020) "\d{2}[ ]?\d{3}"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[a-z0-9A-Z._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"))))
(check-sat)
