; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp onbeforecopy=""alert(1)"" contenteditable>test</rp>") (= x "<big onmouseover=""alert(1)"">test</big>")))
(assert (or (= z "on-name:x"" onanimationend=""alert(1)""></select>") (= z """>test</nextid>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^(19|20)\d{2}$")) (str.suffixof "/nextid>" z)))
(assert (or (= "lect" (str.substr z 41 4)) (not (str.suffixof "st</rp>" x))))
(assert (or (= (str.indexof y "le>te" 0) 41) (<= (str.len y) 104)))
(assert (or (str.prefixof "<rp" y) (str.in_re z ((_ re.from_regex ecma2020) "^[_a-zA-Z0-9-]+(\.[_a-zA-Z0-9-]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*(\.[a-zA-Z]{2,6})$"))))
(assert (or (= (str.len z) 15) (not (= (str.at x 19) "o"))))
(assert (or (not (str.prefixof "<big" x)) (str.contains z "ert")))
(assert (str.suffixof ">" z))
(assert (not (str.prefixof "focus" z)))
(check-sat)
