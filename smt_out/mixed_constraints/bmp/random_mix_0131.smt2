; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 onmouseup=""alert(1)"">test</h1>") (= x "<del onmouseout=""alert(1)"">test</del>")))
(assert (or (= z "semove=""alert(1)"">test</content>") (= z " t\u{1f4a9}abindex=1 onfocus=alert(1)></table>") (= z "sitioncancel=alert(1)></xss>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[^0-9A-Za-z]+$"))) (not (= "alert" (str.substr z 21 5))) (not (= "nde" (str.substr y 40 3)))))
(assert (not (= (str.indexof z "=""ale" 0) 6)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z\u{410}\u{411}\u{412}\u{413}\u{414}\u{415}\u{416}\u{417}\u{418}\u{419}\u{41a}\u{41b}\u{41c}\u{41d}\u{41e}\u{41f}\u{420}\u{421}\u{422}\u{423}\u{424}\u{425}\u{426}\u{428}\u{429}\u{42a}\u{42b}\u{42c}\u{42d}\u{42e}\u{42f}\u{430}\u{431}\u{432}\u{433}\u{434}\u{435}\u{436}\u{437}\u{438}\u{439}\u{43a}\u{43b}\u{43c}\u{43d}\u{43e}\u{43f}\u{440}\u{441}\u{442}\u{443}\u{444}\u{445}\u{446}\u{448}\u{449}\u{44a}\u{44b}\u{44c}\u{44d}\u{44e}\u{44f} \t\r\n\f]*$"))) (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{2,4}(-)?[0-9]{2,4}(-)?[0-9]{3,4}$"))))
(assert (or (= (str.at y 39) "r") (= "<h1 onmouseup=""alert(1)"">test</h1>sitioncancel=alert(1alert(1)xss>" (str.replace y ")></" "alert(1)")) (= (str.at y 50) "=")))
(assert (or (= (str.len y) 62) (not (= (str.indexof x "ut=""" 0) 13))))
(assert (not (str.prefixof "<del" y)))
(assert (= (str.indexof x "t;TAB" 0) 2))
(assert (= "1)"">test<" (str.substr x 21 9)))
(check-sat)
