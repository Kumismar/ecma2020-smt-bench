; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<meter onfocusout=alert(1) tabindex=1 id=x></meter><input autofocus>") (= x "<img[a][b][c]src[d]=x[e]onerror=[f]""alert(1)"">") (= x "<td onpaste=""alert(1)"" contenteditable>test</td>")))
(assert (or (= z "ascript:alert(';XSS';))"";>;") (= z "e>drop here</head>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "<meter onjavascript:cusout=alert(1) tabindex=1 id=x></meter><input autofocus>ascript:alert(';XSS';))"";>;" (str.replace y "fo" "javascript:"))) (not (= (str.indexof y "&#1" 0) 62)) (not (= ">" (str.substr y 85 5)))))
(assert (or (= "[" (str.substr x 4 1)) (= (str.len y) 73)))
(assert (or (not (str.contains z ";))")) (not (= (str.indexof x "][c]" 0) 9))))
(assert (or (= (str.indexof z "t(';X" 0) 12) (not (str.contains x "\u{1f600}""x\"))))
(assert (not (str.contains z "t:alert('")))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{5}-[0-9]{6}")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-z ]*$")))))
(assert (= "ealert(1)drop here</head>" (str.replace z ">" "alert(1)")))
(check-sat)
