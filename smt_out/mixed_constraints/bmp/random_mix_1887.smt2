; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo onmouseout=""alert(1)"">test</bdo>") (= x "<div draggable=""true"" contenteditable>drag me</div><keygen ondragover=alert(1) contenteditable>drop here</keygen>") (= x "<base draggable=""true"" ondragenter=""alert(1)"">test</base>")))
(assert (or (= z "group>") (= z "ource>")))
(assert (= y (str.++ x z)))
(assert (= "<div draggable e"" contenteditable>drag me</div><bgsound ondrop=alert(1) contenteditable>drop here</bgsound>st</blink>" (str.replace y "=""tru" " ")))
(assert (= (str.indexof x "lert" 0) 18))
(assert (not (= "<div draggable=""true"" contenteditable>drag me</div><ke gen ondragover=alert(1) contenteditable>drop here</keygen>ource>" (str.replace y "y" " "))))
(assert (or (not (str.suffixof "st</bdo>" x)) (str.suffixof ">" x) (not (str.in_re x ((_ re.from_regex ecma2020) "[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451} ]{2,}")))))
(assert (or (not (= (str.at y 9) "g")) (not (str.suffixof "ody>" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]*[.]?[0-9]{0,2}")))))
(assert (= ">" (str.substr z 5 10)))
(assert (not (= ">" (str.substr x 36 10))))
(check-sat)
