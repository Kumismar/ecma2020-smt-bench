; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a style=""behavior:url(#default#AnchorClick);"" folder=""javascript:javascript:alert(1)"">XXX</a>") (= x "<div style=""xg-p:absolute;top:0;left:0;width:100%;height:100%"" onmouseover=""prompt(1)"" onclick=""alert(1)"">x</button>") (= x "<svg><bgsound onload=alert(1)></bgsound>")))
(assert (or (= z "rt(1)"">test</bdo>") (= z "rror=alert(1)>") (= z "ig><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "[a-z.@-_]*")))
(assert (not (<= (str.len y) 117)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z\u{5c}u00C0-\u{5c}u017F]+(([',. -][a-zA-Z\u{5c}u00C0-\u{5c}u017F])?[a-zA-Z\u{5c}u00C0-\u{5c}u017F]*)*$"))) (not (str.prefixof "<svg" y)) (= (str.len x) 116)))
(assert (or (str.suffixof "1)>" y) (= "ofoc" (str.substr z 13 4))))
(assert (or (not (str.contains z "t autof")) (str.in_re y ((_ re.from_regex ecma2020) "^(?:0|\(?\+33\)?\s?|0033\s?)[1-79](?:[\.\-\s]?\d\d){4}[1-79]|(?:0|\(?\+33\)?\s?|0033\s?)[1-79](?:[\.\-\s]?\d\d){4}$"))))
(check-sat)
