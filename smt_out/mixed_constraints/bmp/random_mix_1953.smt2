; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div oncopy=""alert(1)"" contenteditable>test</div>") (= x "<basefont onmouseup=""alert(1)"">test</basefont>")))
(assert (or (= z "io onmouseenter=""alert(1)"">test</audio>") (= z "recopy=alert(1) value=""XSS"" autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "st</div>" x) (not (= "1)" (str.substr y 19 2)))))
(assert (not (str.prefixof "<div o" x)))
(assert (or (not (= (str.indexof x "onmo" 0) 10)) (not (str.contains z "=alert"))))
(assert (or (not (= (str.indexof z "e" 0) 9)) (not (>= (str.len y) 81)) (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z\d'_\-+]+(?:\.[a-zA-Z\d'_\-+]+)*@[a-zA-Z\d][a-zA-Z\d._\-]*\.[a-zA-Z\d._\-]+$"))))
(assert (or (not (str.suffixof "dio>" z)) (not (str.prefixof "<" y))))
(check-sat)
