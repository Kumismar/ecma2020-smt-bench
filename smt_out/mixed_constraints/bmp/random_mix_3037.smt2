; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<summary onmouseenter=""alert(1)"">test</summary>") (= x "<style>:target {color: red;}</style><nav id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></nav>") (= x "<basefont oncopy=""alert(1)"" contenteditable>test</basefont>")))
(assert (or (= z "rt(1)></colgroup>") (= z "lert(1)"">test</isindex>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9].{9,9}"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\d]{11}$")))))
(assert (or (str.contains y "(1)></n") (str.suffixof "</isindex>" y)))
(assert (or (not (str.contains (str.replace x "ummar" "<b>") "<s<b>y ")) (not (= (str.at z 6) "<")) (= "oup>" (str.substr y 60 7))))
(assert (or (str.contains z "gro") (<= (str.len x) 110) (str.contains y ")><")))
(assert (or (not (str.prefixof "<;H" y)) (not (= (str.len x) 64))))
(assert (or (not (>= (str.len x) 108)) (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z.`'-]{2,24}( [A-Za-z0-9.`'-]{1,24}){0,5}")) (not (= (str.indexof z "olgro" 0) 9))))
(check-sat)
