; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video autoplay controls onvolumechange=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= x "<object data=""data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg=="">")))
(assert (or (= z "t(1)"" contenteditable>test</meter>") (= z "eyup=""alert(1)"" contenteditable>test</td>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{8,}$"))) (not (= (str.indexof y "ut" 0) 8)) (not (= (str.indexof y "e" 0) 10))))
(assert (or (= ">" (str.substr y 136 6)) (str.prefixof "eyu" z)))
(assert (not (<= (str.len y) 153)))
(assert (or (not (= (str.at y 59) "c")) (not (= (str.indexof z "cont" 0) 6))))
(check-sat)
