; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<sub draggable=""true"" ondragend=""alert(1)"">test</sub>") (= x "<div onmouseout=""alert(1)"">test</div>") (= x "<bgsound SRC=""javascript:document.vulnerable=true;"">")))
(assert (or (= z "itable>test</acronym>") (= z "er=""0%EF%BB%BF") (= z "e>BODY{-moz-binding:url(""http://www.securitycompass.com/xssmoz.xml#xss"")}</style>")))
(assert (= y (str.++ x z)))
(assert (or (not (<= (str.len y) 133)) (str.contains (str.replace z "BB%" "x") "%EF%xBF") (not (= (str.at z 69) "s"))))
(assert (or (not (= (str.indexof y "www" 0) 69)) (not (= (str.indexof z ">test" 0) 6)) (not (str.in_re y ((_ re.from_regex ecma2020) "^([A-Za-z0-9_\-\.])+@([A-Za-z0-9_\-])+.\.([A-Za-z]{2,4})$")))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^IH.+")) (not (str.contains (str.replace x "i" "alert(1)") "ed alert(1)d"))))
(assert (= (str.indexof y "alert" 0) 0))
(assert (or (>= (str.len y) 130) (str.suffixof "ue;"">" x) (= "<sup onmouseout=""alert(1 est</sup>" (str.replace x ")"">t" " "))))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^0[1-9][0-9]{8}$")))
(check-sat)
