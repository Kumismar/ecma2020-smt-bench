; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title id=x tabindex=1 onfocusin=alert(1)></title>") (= x "<command onmouseout=""alert(1)"">test</command>") (= x "<object onbeforeload object onbeforeload=""javascript:javascript:alert(1)""></object onbeforeload>")))
(assert (or (= z " \x11src=x onerror=""javascript:alert(1)"">") (= z "XSS')</script>")))
(assert (= y (str.++ x z)))
(assert (= """ale" (str.substr x 20 4)))
(assert (str.prefixof "XSS')</scr" z))
(assert (= (str.indexof z "ja" 0) 20))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^.{5,20}$"))))
(assert (or (str.contains x "=x tab") (not (<= (str.len z) 24)) (not (str.prefixof " " z))))
(assert (or (= "1)></img>" (str.substr x 37 10)) (<= (str.len z) 49) (= (str.indexof y "r" 0) 24)))
(assert (or (not (str.prefixof "%253Cscrip" x)) (not (str.in_re z ((_ re.from_regex ecma2020) "^(0[1-9]|1[0-2])\/(0[1-9]|[1-2][0-9]|3[0-1])\/[0-9]{4}$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[2-4][0-9]{5}$")))))
(assert (not (>= (str.len z) 18)))
(check-sat)
