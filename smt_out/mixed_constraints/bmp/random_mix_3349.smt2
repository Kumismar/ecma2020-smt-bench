; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tbody draggable=""true"" ondragstart=""alert(1)"">test</tbody>") (= x "<style>:target {color: red;}</style><figure id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></figure>") (= x "<img onmouseenter=""alert(1)"">test</img>")))
(assert (or (= z "ibrate(500)") (= z """ onanimationstart=""alert(1)""></cite>")))
(assert (= y (str.++ x z)))
(assert (or (= """ onanimat<b>art=""alert(1)""></cite>" (str.replace z "ionst" "<b>")) (not (= (str.indexof x "e" 0) 11))))
(assert (= "0" (str.substr z 9 1)))
(assert (str.suffixof "0)" z))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^([\w\.-]+@[\w\.-]+?\.[\w-]+\w)?$"))))
(assert (= (str.indexof y "te>" 0) 73))
(assert (or (str.contains (str.replace x "0" """") "\u{1f600}""0003") (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{6,}"))))
(check-sat)
