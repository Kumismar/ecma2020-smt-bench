; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dialog onbeforepaste=""alert(1)"" contenteditable>te\u{20000}\u{20000}st</dialog>") (= x "<style>:target {transform: rotate(180deg);}</style><sup id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></sup>") (= x "<td id=x tabindex=1 onfocus=alert(1)></td>")))
(assert (or (= z """alert(1)"" contenteditable>test</big>") (= z "tenteditable>test</tbody>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.len z) 25)) (not (str.contains (str.replace z "t(1" """") "er"")"" c"))))
(assert (or (= (str.at z 8) "t") (str.contains z " conte")))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([a-zA-Z\s]{3,})$"))) (str.prefixof "&" x) (not (= "<td id=x tabindex=1 onfocus=alert(1)></td>tenteditabl<b>est</tbody>" (str.replace y "e>t" "<b>")))))
(assert (not (= (str.len x) 42)))
(check-sat)
