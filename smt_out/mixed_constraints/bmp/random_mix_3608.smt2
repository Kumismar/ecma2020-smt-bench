; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<mark id=x tabindex=1 onfocus=alert(1)></mark>") (= x "<img \x12src=x onerror=""javascript:alert(1)"">")))
(assert (or (= z "rt(1)""></tt>") (= z " width=""420"" height=""315"" src=""http://www.youtube.com/embed/sxvccpasgTE"" frameborder=""0"" allowfullscreen></iframe>123</h1>") (= z "ascript:javascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$")) (not (str.contains (str.replace x " \x" "<b>") "<img<b>1")) (str.contains (str.replace z "scr" "") "aipt:")))
(assert (or (str.prefixof "<tbody" x) (str.contains z "rt(1)""></t") (not (str.prefixof "rt(1)""" z))))
(assert (not (= ">" (str.substr z 11 3))))
(assert (or (str.prefixof " width" z) (not (= (str.indexof z """>" 0) 5)) (str.contains (str.replace x "java" " ") """ s")))
(assert (str.in_re z ((_ re.from_regex ecma2020) ".{8,}$")))
(check-sat)
