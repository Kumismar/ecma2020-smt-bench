; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<base draggable=""true"" ondragstart=""alert(1)"">test</base>") (= x "<menu oncontextmenu=""alert(1)"">test</menu>") (= x "<style>@keyframes x{}</style><label style=""animation-name:x"" onanimationend=""alert(1)""></label>")))
(assert (or (= z "/ha.ckers.org/xss.jpg"";>;<;/SCRIPT>;") (= z "ce+/ert/.source](1)") (= z "><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len y) 55) (str.contains (str.replace x "(1)""" "<b>") "t<b>>test") (= "xmenu oncontextmenu=""alert(1)"">test</menu>ce+/ert/.source](1)" (str.replace y "<" "x"))))
(assert (not (str.suffixof "t</menu>" x)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^([+]+)*[0-9\s-]{5,20}"))) (not (= (str.at x 46) "m")) (not (str.prefixof "<menu" x))))
(assert (= (str.indexof z "ce" 0) 0))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{4,}"))) (not (= (str.indexof x "e" 0) 5))))
(assert (or (not (>= (str.len y) 188)) (= (str.at y 15) "e") (str.contains (str.replace x "ba" " ") "< se")))
(check-sat)
