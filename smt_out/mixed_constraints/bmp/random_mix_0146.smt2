; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\'><SCRIPT>alert(String.fromCharCode(88,83,83))</SCRIPT><img src="""" alt=\'") (= x "<SCRIPT ="">"" SRC=""http://ha.ckers.org/xss.js""></SCRIPT>") (= x "<meter onmouseover=""alert(1)"">test</meter>")))
(assert (or (= z "</u>") (= z "=""alert(1)"">test\u{20000}</abbr>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "eter on") (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[0-9]{1}Z[A-Z0-9]{1}")))))
(assert (= (str.indexof y "o" 0) 7))
(assert (or (not (= (str.len z) 24)) (not (>= (str.len z) 22)) (str.prefixof "<SCRIPT =""" x)))
(assert (or (not (str.contains z "er")) (str.contains y "ing.fro")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$"))) (str.suffixof "/abbr>" z)))
(assert (not (= (str.indexof z "(1)""" 0) 7)))
(assert (or (str.suffixof "t</meter>" x) (= (str.at x 37) "/")))
(check-sat)
