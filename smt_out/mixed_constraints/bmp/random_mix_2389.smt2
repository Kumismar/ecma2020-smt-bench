; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<hr id=x tabinde\u{10348}x=1 onfocusin=alert(1)></hr>") (= x "<style>:target {transform: rotate(180deg);}</style><tfoot id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></tfoot>")))
(assert (or (= z "rm: rotate(180deg);}</style><b id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></b>") (= z "utofocus>") (= z "useout=""alert(1)"">test</select>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z "est</" "") "1)"">tm") (= "t=" (str.substr z 5 2))))
(assert (or (str.prefixof "<hr i" x) (not (str.prefixof "<hr" x))))
(assert (or (= "1" (str.substr y 218 1)) (not (= (str.indexof x "r" 0) 10))))
(assert (<= (str.len y) 81))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[a-z A-Z \- / . ' &]{2,60}$")) (<= (str.len x) 136)))
(check-sat)
