; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del draggable=""true"" ondragleave=""alert(1)"">test</del>") (= x "<summary onmouseenter=""alert(1)"">test</summary>") (= x "<style>:target {color:red;}</style><li id=x style=""transition:color 1s"" ontransitionend=alert(1)></li>")))
(assert (or (= z ".com./"";>;XSS<;/A>;") (= z "</colgroup>") (= z "c=""view-source:http://www.example.org/"" frameborder=""0"" style=""width:400px;height:180px""></iframe>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "t(1)></hr>" z)))
(assert (or (not (str.prefixof "<summary " y)) (not (= "<style>:target {color:red;}</style><lalert(1) id=x style=""transition:color 1s"" ontransitionend=alert(1)></li>.com./"";>;XSS<;/A>;" (str.replace y "i" "alert(1)")))))
(assert (or (str.contains y "=""tr") (str.contains x "io")))
(assert (= "</coljavascript:up>" (str.replace z "gro" "javascript:")))
(assert (= "<del draggablexe"" ondragleave=""alert(1)"">test</del>" (str.replace x "=""tru" "x")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^.* .*$"))) (= ".com" (str.substr y 47 4)) (str.contains z "</colgroup")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{5}(?:[-\s]\d{4})?$"))) (not (= (str.at y 26) "r"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^1((3|5|8){1}\d{1}|70|77)\d{8}$"))))
(check-sat)
