; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {color:red;}</style><p id=x style=""transition:color 1s"" ontransitionend=alert(1)></p>") (= x """`'><script>\xE1\x9A\x80javascript:alert(1)</script>")))
(assert (or (= z "sound>") (= z "eter onmouseenter=""alert(1)"">test</meter>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "eter on" z)) (= (str.at x 4) "e")))
(assert (= (str.at y 4) "a"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^(\d+:\d{2}|\d+)$"))) (= """`'><script>\xE1\x9A\x80javascr alert(1)</script>" (str.replace x "ipt:" " ")) (not (= (str.at z 5) ">"))))
(assert (or (str.contains y "vasc") (not (str.in_re z ((_ re.from_regex ecma2020) "^[5]+$")))))
(check-sat)
