; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<!-- IE 10 in IE5-9 Standards mode -->") (= x "<table onbeforecopy=""alert(1)"" contenteditable>test</table>")))
(assert (or (= z "test</map>") (= z "=""alert(1)"">test</source>") (= z "/strike>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof " -->" x)) (not (= "<table onbeforecopy=""alert(1)"" contenteditable>te""t</table>" (str.replace x "s" """"))) (not (= (str.indexof z "st</m" 0) 2))))
(assert (= (str.indexof z "i" 0) 4))
(assert (or (not (str.suffixof "alert)" z)) (str.prefixof "<!-- IE 10" y)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z 0-9.,+-]*$"))) (not (= (str.at z 2) "s")) (str.prefixof "<!-- " y)))
(assert (or (= (str.indexof y "py=""a" 0) 17) (not (str.prefixof "<!" y))))
(check-sat)
