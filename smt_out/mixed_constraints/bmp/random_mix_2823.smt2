; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<isindex onmouseup=""alert(1)"">test</isindex>") (= x "<p onbeforecut=""alert(1)"" contenteditable>test</p>")))
(assert (or (= z "ript:alert('XSS')"">") (= z "rget {color:red;}</style><option id=x style=""transition:color 1s"" ontransitionend=alert(1)></option>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z ]{3,20}")) (str.suffixof "option>" y) (not (>= (str.len y) 141))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,12}")) (not (= (str.len x) 50)) (not (= "rget {color:red;}</style><option id=x style=""transition:color 1s"" nsitionend=alert(1)></option>" (str.replace z "ontra" "")))))
(assert (or (= (str.at z 1) "i") (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z\u{430}-\u{44f}\u{410}-\u{42f}'\u{491}\u{454}\u{490}\u{404}\u{406}\u{456}\u{407}\u{457}\s]{2,}"))))
(assert (or (not (>= (str.len y) 128)) (str.contains x "tedit") (= (str.indexof x " i" 0) 4)))
(assert (or (not (= (str.indexof x "=""" 0) 14)) (str.suffixof "e>test</p>" x) (= "/isi" (str.substr x 35 4))))
(assert (str.suffixof ">" z))
(check-sat)
