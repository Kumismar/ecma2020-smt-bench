; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rp id=x tabindex=1 ondeactivate=alert(1)></rp><input id=y autofocus>") (= x "<rb onmouseleave=""alert(1)"">test</rb>")))
(assert (or (= z "t=""alert(1)"">test</caption>") (= z " autofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "aption>" y)))
(assert (not (= "/capt" (str.substr y 55 5))))
(assert (or (not (str.prefixof "<r" y)) (= (str.indexof x "ous" 0) 7)))
(assert (or (not (= (str.at z 20) "a")) (not (str.suffixof "</caption>" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z]{3,4}(\d{6})((\D|\d){8})?$")))))
(assert (or (not (= "true"" <b>ndragstart=""alert(1)"">test</figcaption>" (str.replace z "o" "<b>"))) (not (str.contains (str.replace z "(1)"">" """") "lert""t"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z\s\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s]+$"))) (str.in_re z ((_ re.from_regex ecma2020) "[0-9]{12,19}"))))
(assert (= (str.at y 16) "="))
(assert (or (not (<= (str.len z) 19)) (str.contains (str.replace z "oc" "alert(1)") "falert(1)us>") (not (= (str.at x 34) "r"))))
(check-sat)
