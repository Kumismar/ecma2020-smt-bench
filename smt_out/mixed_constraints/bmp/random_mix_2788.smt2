; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<details oncut=""alert(1)"" contenteditable>test</details>") (= x "<applet ondblclick=""alert(1)"">test</applet>") (= x "<dd draggable=""true"" ondragend=""alert(1)"">test</dd>")))
(assert (or (= z "=""alert(1)"">test</embed>") (= z "</rt>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace z """aler" "javascript:") "=javascript:t(1)""") (<= (str.len y) 56) (= "<applet ondblclicalert(1)""alert(1)"">test</applet>=""alert(1)"">test</embed>" (str.replace y "k=" "alert(1)"))))
(assert (not (str.contains y "et></rt")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"))))
(assert (or (not (str.suffixof "applet>" x)) (not (str.contains y "ragend=""a")) (not (str.suffixof "ound>" y))))
(assert (or (not (= "lick=" (str.substr x 14 5))) (= "e""" (str.substr y 18 2))))
(assert (not (str.prefixof "<" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z. '-]{2,}"))) (not (= (str.at y 50) "("))))
(check-sat)
