; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bgsound oncontextmenu=""alert(1)"">test</bgsound>") (= x "<script src=""data:\xCB\x8F,javascript:alert(1)""></script>") (= x "<XSS STYLE=""behavior: url(%(htc)s);"">")))
(assert (or (= z "=""javascript:javascript:alert(1)"">X") (= z "r>")))
(assert (= y (str.++ x z)))
(assert (or (= "r: ur" (str.substr x 19 5)) (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z ]*$")) (= "ipt sr" (str.substr y 4 6))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]+.?[0-9]*$"))))
(assert (not (str.contains x "/scr")))
(assert (not (str.contains y "est</bgsou")))
(assert (or (not (str.suffixof "X" y)) (str.contains x "nd onc")))
(assert (not (= (str.at z 1) ">")))
(check-sat)
