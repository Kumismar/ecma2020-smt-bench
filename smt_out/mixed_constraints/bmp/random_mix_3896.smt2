; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<select draggable=""true"" ondrag=""alert(1)"">test</select>") (= x "<sub ondblclick=""alert(1)"">test</sub>")))
(assert (or (= z ">") (= z "ipt>\xE2\x80\x85javascript:alert(1)</script>") (= z "ndblclick=""alert(1)"">test</pre>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<sub ond" x)) (= (str.at x 4) "r") (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{2}.\d{2}.\d{4}$")))))
(assert (not (str.contains (str.replace x "te" " ") "1)""> st")))
(assert (= "ipt>\xE2\x80\x85javascript:alert(1)""cript>" (str.replace z "</s" """")))
(assert (or (not (str.suffixof "cript>" y)) (>= (str.len z) 28)))
(assert (or (= (str.at x 38) "(") (not (= (str.indexof z "\xE" 0) 4))))
(assert (not (str.prefixof "<sub" y)))
(assert (or (= (str.len x) 49) (not (= (str.indexof z "e=a" 0) 29))))
(assert (str.contains x "aggable"))
(assert (not (str.suffixof "/sub>" x)))
(check-sat)
