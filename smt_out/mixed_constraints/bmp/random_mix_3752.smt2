; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<input onblur=javascript:alert(1) autofocus><input autofocus>") (= x "<form id=""test"" /><button form=""test"" formaction=""javascript:alert(123)"">TESTHTML5FORMACTION") (= x "<\u{1d400}dd oncut=""alert(1)"" contenteditable>test</dd>")))
(assert (or (= z "drop=alert(1) contenteditable>drop here</nextid>") (= z "avascript:confirm(1)"">") (= z " tabindex=1 onbeforeactivate=alert(1)></button>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "CTION" x) (= "t onor>" (str.replace z "Err" "")) (not (str.in_re z ((_ re.from_regex ecma2020) "^([a-zA-Z\s]{3,})$")))))
(assert (= "nfirm" (str.substr z 12 5)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(?=^.{8,}$)((?=.*\\d)|(?=.*\\W+))(?![.\\n])(?=.*[A-Z])(?=.*[a-z]).*$"))) (<= (str.len z) 56)))
(assert (or (= "ut=""" (str.substr x 8 4)) (not (= (str.at x 60) ">")) (not (= "rm" (str.substr y 62 2)))))
(check-sat)
