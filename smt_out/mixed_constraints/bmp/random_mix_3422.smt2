; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "';alert(String.fromCharCode(88,83,83))//';alert(String.fromCharCode(88,83,83))//"";") (= x "<menuitem onkeyup=""alert(1)"" contenteditable>test</menuitem>") (= x "<aside onmouseover=""alert(1)"">test</aside>")))
(assert (or (= z " here</tr>") (= z "le>@keyframes x{}</style><button style=""animation-name:x"" onanimationend=""alert(1)""></button>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 103) (= (str.at x 26) ")") (str.prefixof " he" z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^([0-9]{6})-([0-9]{2})-([0-9]{4})$")) (= (str.indexof z ">" 0) 1) (str.suffixof "</button>" y)))
(assert (or (= (str.indexof z "re</" 0) 3) (= (str.indexof x " " 0) 6)))
(assert (or (str.prefixof "';ale" x) (not (str.suffixof "e</tr>" y)) (not (str.in_re y ((_ re.from_regex ecma2020) "\d{13}")))))
(assert (or (= """></nex" (str.substr y 86 7)) (not (str.prefixof "IPT&co" z))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[^()/\\\x40\\\x21\\\x26\\\x24\\\x25\\\x3C\\\x3E\.\][\\\x22,;|]+"))) (not (= "<menuitem onkeyup=""alert(1)"" contenjavascript:itable>test</menuitem>" (str.replace x "ted" "javascript:")))))
(check-sat)
