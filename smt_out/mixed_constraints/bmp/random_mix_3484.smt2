; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<iframe onkeypress=""alert(1)"" contenteditable>test</iframe>") (= x "<small id=x tabindex=1 onfocusin=aler\u{1f4a9}t(1)></small>") (= x "<select draggable=""true"" ondrag=""alert(1)"">test</select>")))
(assert (or (= z "est</img>") (= z "ut>") (= z "MG SRC=`javascript&#058;alert(\""RSnake says, 'XSS'\"")`&gt;")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[A-Za-z]\S+$"))) (= (str.len y) 65) (not (str.contains z "ke says, '"))))
(assert (or (str.prefixof "<style>:t" x) (str.contains (str.replace x "=""ale" "") "pastert(") (= (str.at z 1) "t")))
(assert (or (not (str.prefixof "<bli" y)) (not (= "mg>" (str.substr y 65 7)))))
(assert (or (not (str.contains (str.replace z "st</i" "x") "exm")) (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{2}.[0-9]{3}.[0-9]{3}/[0-9]{4}-[0-9]{2}|[0-9]{2}[0-9]{3}[0-9]{3}[0-9]{4}[0-9]{2}$")) (not (>= (str.len z) 59))))
(check-sat)
