; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object onfocusout=alert(1) tabindex=1 id=x></object><input autofocus>") (= x "<p id=x tabindex=1 onfocus=alert(1)></p>")))
(assert (or (= z "alert(1)"">test</tbody>") (= z "1)></nobr><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<" y) (not (str.in_re y ((_ re.from_regex ecma2020) "^(13[0-9]|14[579]|15[0-3,5-9]|16[6]|17[0135678]|18[0-9]|19[89])\d{8}$"))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[1-9][0-9]{5}$")))))
(assert (not (= (str.indexof z "tb" 0) 16)))
(assert (not (str.contains (str.replace x "ect o" "alert(1)") "jalert(1)nfo")))
(assert (or (not (= "ames x{}<" (str.substr x 13 9))) (not (str.suffixof "y>" z)) (not (str.contains x "=x></obje"))))
(assert (or (not (= "/p>ale" (str.substr y 37 6))) (= "bind" (str.substr y 30 4)) (not (str.contains (str.replace z "of" "alert(1)") " autalert(1)oc"))))
(check-sat)
