; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<nextid oncontextmenu=""alert(1)"">test</nextid>") (= x "<noscript draggable=""true"" ondrag=""alert(1)"">test</noscript>")))
(assert (or (= z "ragend=""alert(1)"">test</head>") (= z "style=""transition:color 10s"" ontransitioncancel=alert(1)></spacer>") (= z "rop here</dialog>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains z "p here")) (not (= ">" (str.substr x 45 2)))))
(assert (or (= (str.at x 24) "l") (not (str.contains z "op here<")) (not (str.prefixof "rop her" z))))
(assert (or (not (= (str.at z 4) "a")) (not (str.contains x "ex")) (str.suffixof "acer>" z)))
(assert (or (not (str.prefixof "<noscrip" y)) (not (>= (str.len x) 40))))
(assert (or (= (str.at y 76) "n") (str.prefixof "<nextid" x)))
(assert (or (not (= "p here</" (str.substr y 62 8))) (= (str.indexof z "end" 0) 3)))
(assert (str.in_re z ((_ re.from_regex ecma2020) "^[a-fA-F0-9]{6}$")))
(check-sat)
