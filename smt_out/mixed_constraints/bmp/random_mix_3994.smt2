; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<main id=x tabindex=1 onfocusin=alert(1)></main>") (= x "<script/src=&#100&#97&#116&#97:text/&#x6a&#x61&#x76&#x61&#x73&#x63&#x72&#x69&#x000070&#x074,&#x0061;&#x06c;&#x0065;&#x00000072;&#x00074;(1)></script>") (= x "<map draggable=""true"" on\u{1d400}dragleav\u{1f600}e=""alert(1)"">test</map>")))
(assert (or (= z " id=x style=""transition:color 1s"" ontransitionend=alert(1)></code>") (= z "ref begin=0 from=javascript:alert(1) to=&>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains y "=1 onfocus")) (= "refgin=0 from=javascript:alert(1) to=&>" (str.replace z " be" ""))))
(assert (or (not (str.suffixof "></code>" y)) (not (= (str.indexof x "t" 0) 6))))
(assert (or (str.prefixof "<map dra" x) (not (str.contains (str.replace x "binde" " ") "x ta x"))))
(assert (<= (str.len y) 225))
(assert (or (not (str.prefixof "r" z)) (not (= (str.indexof x "ert(" 0) 39)) (not (= "ascrip" (str.substr y 77 6)))))
(assert (not (str.contains x "ggable=""tr")))
(assert (or (str.prefixof "ref be" z) (= (str.at z 26) "t")))
(assert (or (not (= (str.indexof z """ ont" 0) 32)) (not (str.in_re x ((_ re.from_regex ecma2020) "^([0-2][0-9]|3[0-1])(\/|-)(0[1-9]|1[0-2])\2(\d{4})$")))))
(check-sat)
