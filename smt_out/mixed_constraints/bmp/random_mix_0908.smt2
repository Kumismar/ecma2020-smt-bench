; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<span id=x tabindex=1 ondeactivate=alert(1)></span><input id=y autofocus>") (= x "<\u{10348}element ondblclick=""alert(1)"">test</element>")))
(assert (or (= z "nd id=x tabindex=1 onbeforedeactivate=alert(1)></command><input autofocus>") (= z "meter>") (= z "nteditable>test</div>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at x 33) "e") (not (= (str.len z) 21))))
(assert (<= (str.len y) 67))
(assert (or (not (= "nteditxe>test</div>" (str.replace z "abl" "x"))) (not (= (str.len y) 94)) (= (str.indexof y "v" 0) 30)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "[\d]{2}"))))
(assert (or (= (str.indexof z "ter>" 0) 2) (not (str.in_re y ((_ re.from_regex ecma2020) "^([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)+$"))) (not (str.in_re x ((_ re.from_regex ecma2020) "\d{4}-\d{3}[0-9Xx]")))))
(assert (or (not (str.contains y "t(1)")) (= "s""></S" (str.substr y 48 6)) (not (= (str.indexof z ">test" 0) 10))))
(assert (= "ontentedit" (str.substr y 28 10)))
(assert (not (str.prefixof "nd i" z)))
(check-sat)
