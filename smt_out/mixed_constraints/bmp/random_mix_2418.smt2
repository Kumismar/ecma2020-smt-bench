; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x """`'><script>\xF0\x90\x96\x9Ajavascript:alert(1)</script>") (= x "<svg><strong onload=alert(1)></strong>")))
(assert (or (= z "ondragenter=""alert(1)"">test</embed>") (= z "p=""alert(1)"">test</html>") (= z "e=""true"" ondragend=""alert(1)"">test</iframe>")))
(assert (= y (str.++ x z)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^\S+\s\S+$")))
(assert (or (= "(" (str.substr z 25 1)) (= (str.at y 6) "c") (not (= (str.at z 59) "d"))))
(assert (or (= (str.indexof z "index" 0) 4) (= """" (str.substr z 2 1)) (not (= (str.at y 79) "e"))))
(assert (or (not (str.suffixof "st</html>" y)) (str.contains (str.replace y "r=" " ") "ente """) (str.contains z "nd")))
(assert (not (= (str.len y) 81)))
(check-sat)
