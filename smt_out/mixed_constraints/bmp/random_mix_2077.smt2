; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title oncut=""alert(1)"" contenteditable>test</title>") (= x "<isindex id=x tabindex=1 ondeactivate=alert(1)></isindex><input id=y autofocus>") (= x "<a href=http://foo.bar/#x=`y></a><img alt=""`><img src=x:\u{20000}x onerror=javascript:alert(1)>\u{1f4a9}</a>"">")))
(assert (or (= z "rt(1)"" contenteditable>test</script>") (= z """></object onbeforeload>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof """></" z)) (str.in_re x ((_ re.from_regex ecma2020) "[a-z\.]+@[a-z\.]+"))))
(assert (= (str.at x 39) "l"))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9A-Za-z-]+$"))) (str.prefixof "&#\u{10348}X03" y) (= "<a hrefhttp://foo.bar/#x=`y></a><img alt=""`><img src=x:\u{20000}x onerror=javascript:alert(1)>\u{1f4a9}</a>"">rt(1)"" contenteditable>test</script>" (str.replace y "=" ""))))
(assert (or (str.contains (str.replace z "/scri" "<b>") "st<<b>pt>") (str.suffixof "ad>" y)))
(check-sat)
