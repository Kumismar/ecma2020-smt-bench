; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<menu onclick=""alert(1)"">test</menu>") (= x "<u id=x tabindex=1 onfocus=alert(1)></u>") (= x "<small onpaste=""alert(1)"" contenteditable>test</small>")))
(assert (or (= z "t=""alert(1)"">test</noscript>") (= z "ditable>test</dl>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "t(1)></u>" x) (= "t=""aleralert(1)"">test</noscript>" (str.replace z "t(1)" "alert(1)")) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9]).{14,128}$")))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[0-9]{7,}$"))) (str.suffixof "ll>" x)))
(assert (or (not (= "di>test</dl>" (str.replace z "table" ""))) (str.suffixof "</u>" x) (= (str.indexof x "past" 0) 9)))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*?[1-9])\d{7,8}(\.\d+)?$"))) (not (<= (str.len x) 60)) (= (str.at z 4) "l")))
(assert (not (str.prefixof "n" z)))
(assert (or (not (= (str.at y 44) "s")) (= "e>test</dl" (str.substr z 6 10)) (= (str.indexof z "able>" 0) 3)))
(check-sat)
