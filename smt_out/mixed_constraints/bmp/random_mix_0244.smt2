; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby oncontextmenu=""alert(1)"">test</ruby>") (= x "\u{10348}<style>@keyframes x{}</style><meta style=""animation-name:x"" onanimationend=""alert(1)""></meta>") (= x "<input onfocusout=alert(1) id=x><input autofocus>")))
(assert (or (= z "</pre>") (= z "c=x onerror=""javascript:alert(1)"">")))
(assert (= y (str.++ x z)))
(assert (>= (str.len x) 40))
(assert (or (str.contains x ")"">test<") (not (str.in_re y ((_ re.from_regex ecma2020) "\+(9[976]\d|8[987530]\d|6[987]\d|5[90]\d|42\d|3[875]\d|2[98654321]\d|9[8543210]|8[6421]|6[6543210]|5[87654321]|4[987654310]|3[9643210]|2[70]|7|1|)\d{1,4}-\d{1,18}$")))))
(assert (or (not (= "1) id" (str.substr y 24 5))) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9]{4}[A-Z]{1}$"))) (not (= (str.at x 42) """"))))
(assert (not (= "anima" (str.substr x 43 5))))
(assert (not (= (str.len z) 34)))
(check-sat)
