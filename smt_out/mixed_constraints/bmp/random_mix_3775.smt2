; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<b onmouseenter=""alert(1)"">test</b>") (= x "<figcaption id=x tabindex=1 onactivate=alert(1)></figcaption>") (= x "<rp id=x tabindex=1 onfocus=alert(1)></rp>")))
(assert (or (= z "ge>") (= z "ofocus>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9-&)(:/' ]*$"))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^\D{1,15}$"))) (str.suffixof "/rp>" x)))
(assert (or (str.prefixof "g" z) (not (str.suffixof "est</q>" x)) (str.suffixof "</rp>ge>" y)))
(assert (or (= "" (str.replace z "ge>" "")) (= (str.len y) 68)))
(assert (not (= (str.indexof x """>tes" 0) 25)))
(assert (= (str.indexof x "></r" 0) 36))
(check-sat)
