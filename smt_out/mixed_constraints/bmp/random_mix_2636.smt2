; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "\u{201c}><s\u{201d}%2b\u{201d}cript>alert(document.cookie)</script>") (= x """><img src=x onerror=javascript:alert(('A'))>")))
(assert (or (= z "</br>") (= z "c") (= z "tabindex=1 onfocusin=alert(1)></source>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "ument")) (not (str.suffixof "'A'))>" x))))
(assert (>= (str.len y) 51))
(assert (not (= (str.indexof x "ic" 0) 4)))
(assert (= "usin=aler" (str.substr y 62 9)))
(assert (or (str.contains x "t>") (<= (str.len z) 4)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^\d{10,12}$"))))
(check-sat)
