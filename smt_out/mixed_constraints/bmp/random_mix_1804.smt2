; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article onmousedown=""alert(1)"">test</article>") (= x "<td id=x tabindex=1 onbeforeactivate=alert(1)></td>") (= x "<rb id=x tabindex=1 ondeactivate=alert(1)></rb><input id=y autofocus>")))
(assert (or (= z "t('xss'); var x='") (= z "k=""alert(1)"">test</element>")))
(assert (= y (str.++ x z)))
(assert (or (= "<article onmousedo""""alert(1)"">test</article>" (str.replace x "wn=" """")) (= (str.len x) 51)))
(assert (str.suffixof " var x='" z))
(assert (or (not (= (str.indexof x "d=y a" 0) 55)) (not (str.contains z "rt(1)"">te")) (not (= (str.indexof x "rtic" 0) 2))))
(assert (not (= "to" (str.substr z 2 2))))
(assert (or (str.prefixof "<td id=x t" x) (not (str.contains y "styl")) (not (str.in_re x ((_ re.from_regex ecma2020) "([^\s].{1,})")))))
(assert (= "<kejavascript:gen id=x onfocus=alert(1)>)""></applet>" (str.replace y "y" "javascript:")))
(check-sat)
