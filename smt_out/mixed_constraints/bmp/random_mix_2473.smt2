; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<bdo onmouseup=""alert(1)"">test</bdo>") (= x "<IMG SRC=x onwaiting=""alert(String.fromCharCode(88,83,83))"">") (= x "<script src=""\\%(jscript)s""></script>")))
(assert (or (= z "<mark onload=alert(1)></mark>") (= z "agend=""alert(1)"">test</datalist>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof y "seup=" 0) 10) (not (str.in_re z ((_ re.from_regex ecma2020) "^[\u{30a1}-\u{30f3}\u{30f4}\u{30fc}\u{3000}]+$")))))
(assert (or (= (str.at y 56) "t") (= (str.at x 9) "r")))
(assert (or (= """alert(1" (str.substr z 6 8)) (str.in_re y ((_ re.from_regex ecma2020) "^\+?(\d|-|\.| ){3,}$"))))
(assert (or (not (str.prefixof "<bdo onmo" x)) (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9@]+$")) (>= (str.len z) 28)))
(assert (not (str.contains (str.replace x "/" "") "est<b")))
(check-sat)
