; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<plaintext draggable=""true"" ondragend=""alert(1)"">test</plaintext>") (= x "<!-- IE 10 in IE5-9 Standards mode -->") (= x "<strike id=x tabindex=1 onbeforedeactivate=alert(1)></strike><input autofocus>")))
(assert (or (= z "article>") (= z " onerror=alert(/xssed/) />") (= z "table>test</basefont>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y "rike><in") (= (str.at x 18) "9") (str.contains (str.replace z "onerr" "<b>") " <b>or=a")))
(assert (not (= "<!-- IE 1" (str.substr y 0 9))))
(assert (not (str.contains z "icle")))
(assert (or (not (= (str.indexof z "></ma" 0) 24)) (not (= (str.at z 4) "c"))))
(assert (or (not (str.suffixof "basefont>" z)) (not (str.suffixof "rticle>" y)) (str.suffixof "e>" z)))
(assert (or (= (str.indexof y "pla" 0) 1) (not (= (str.indexof y "><inp" 0) 48)) (str.in_re y ((_ re.from_regex ecma2020) "^$|(0[1-9]|1[0-2])/(0[1-9]|[12]\d|3[01])/[0-9]{4}"))))
(check-sat)
