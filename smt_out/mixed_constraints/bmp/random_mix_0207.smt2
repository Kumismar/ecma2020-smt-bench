; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div oncut=""alert(1)"" contenteditable>test</div>") (= x "<menuitem draggable=""true"" ondragstart=""alert(1)"">test</menuitem>") (= x "<strong oncontextmenu=""alert(1)"">test</strong>")))
(assert (or (= z "ousemove=""alert(1)"">test</style>") (= z "1)"">test</isindex>") (= z "\u{1d400})"" contenteditable>test</menuitem>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at x 8) "m")))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "((?=.*[a-zA-Z0-9]).{6,})"))) (not (str.suffixof "t</style>" z)) (str.suffixof "ails>" x)))
(assert (or (= "est" (str.substr y 53 3)) (str.contains x "t</menui") (str.prefixof "\u{1d400})"" cont" z)))
(assert (or (= (str.indexof y "</m" 0) 54) (not (str.suffixof "yle>" z))))
(check-sat)
