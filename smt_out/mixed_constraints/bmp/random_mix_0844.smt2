; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<META HTTP-EQUIV=""Link"" Content=""<http://ha.ckers.org/xss.css>; REL=stylesheet"">") (= x "<s onmousedown=""alert(1)"">test</s>")))
(assert (or (= z "pt>") (= z """><x foo='?><script>alert(91)</script>'>"">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.prefixof "<s onm" y)) (not (>= (str.len z) 37)) (str.suffixof ">" x)))
(assert (or (str.contains y "TA HTTP") (str.contains z "x ") (= "<s onmousedown=""alert(1)"" st</s>pt>" (str.replace y ">te" " "))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-z0-9._-]+@[a-z0-9._-]+\.[a-z]{2,4}$"))) (str.suffixof "/h1>" x)))
(assert (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z \-'_]+$")))
(check-sat)
