; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<command ondblclick=""alert(1)"">test</command>") (= x "<video draggable=""true\u{1d400}"" ondrag=""alert(1)"">test</video>") (= x "<details onmouseenter=""alert(1)"">test</details>")))
(assert (or (= z "rk draggable=""true"" ondragleave=""alert(1)"">test</mark>") (= z "(1)"" contenteditable>test</figcaption>") (= z "cut=""alert(1)"" contenteditable>test</br>")))
(assert (= y (str.++ x z)))
(assert (str.suffixof "rk>" y))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^((0?[1-9])|(1[0-2]))$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9 ()]+$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(.){6,}$")) (not (str.suffixof "mand>" x)) (not (= (str.indexof z "anima" 0) 25))))
(assert (not (str.contains x "et")))
(assert (or (= (str.at x 1) "d") (= (str.at z 22) "e") (not (= (str.at y 14) "s"))))
(assert (or (not (= (str.indexof y "ig" 0) 73)) (not (= (str.indexof y "o" 0) 2)) (not (= (str.len z) 34))))
(check-sat)
