; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<img src=`xx:xx`onerror=alert(1)>") (= x """><h1><IFRAME SRC=# onmouseover=""alert(document.cookie)""></IFRAME>123</h1>")))
(assert (or (= z "bindex=1 id=x></i><input autofocus>") (= z "test</legend>") (= z " onmouseup=""alert(1)"">test</ins>")))
(assert (= y (str.++ x z)))
(assert (or (= "1" (str.substr x 30 1)) (not (str.in_re x ((_ re.from_regex ecma2020) "(\+?)([0-9]{10,})\b"))) (not (str.in_re x ((_ re.from_regex ecma2020) "^\d{4}[\-\/\s]?((((0[13578])|(1[02]))[\-\/\s]?(([0-2][0-9])|(3[01])))|(((0[469])|(11))[\-\/\s]?(([0-2][0-9])|(30)))|(02[\-\/\s]?[0-2][0-9]))$")))))
(assert (str.suffixof "ofocus>" z))
(assert (or (not (= "lert(1)>" (str.substr x 25 9))) (not (str.prefixof "test</leg" z))))
(assert (not (= "4" (str.substr z 4 1))))
(assert (not (= (str.indexof y "or=" 0) 21)))
(assert (str.suffixof "d>" y))
(assert (or (str.contains (str.replace y "est<" """") ">t""/") (= (str.len x) 33) (= (str.len x) 74)))
(assert (= (str.indexof y ".cook" 0) 47))
(assert (not (str.prefixof "test<" z)))
(check-sat)
