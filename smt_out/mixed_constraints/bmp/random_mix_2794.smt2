; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<pre onmouseup=""alert(1)"">test</pre>") (= x "<script>alert(1)</script\u{10348}>") (= x "<address onmouseleave=""alert(1)"">test</address>")))
(assert (or (= z "ource id=x tabindex=1 onfocus=alert(1)></source>") (= z "x tabindex=1 ondeactivate=alert(1)></textarea><input id=y autofocus>") (= z "mouseup=""alert(1)"">test</q>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y "t</" "x") """>tesxaddre")) (str.contains x """>test</") (str.prefixof "05,99,1" z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9._%+\/!#$%&'*=?^_`{|}~-]+@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]{2,})+$"))) (not (= (str.len y) 98))))
(assert (or (= (str.at y 8) "o") (not (= "mou" (str.substr y 7 3)))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[0-9]{7,8}-[0-9Kk]"))) (= "/pre>" (str.substr x 31 9)) (not (<= (str.len z) 29))))
(assert (or (not (str.contains x """>test<")) (not (= (str.at x 35) ">"))))
(assert (= "<pre onmo" (str.substr x 0 9)))
(assert (or (not (str.contains z """true")) (= (str.indexof y "e=" 0) 20)))
(check-sat)
