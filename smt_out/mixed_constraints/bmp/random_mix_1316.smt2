; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div draggable=""true"" contenteditable>drag me</div><image ondragover=alert(1) contenteditable>drop here</image>") (= x "<bdo ondblclick=""alert(1)"">test</bdo>") (= x "<br onkeyup=""alert(1)"" contenteditable>test</br>")))
(assert (or (= z "input autofocus>") (= z "rt(1)"">test</noembed>") (= z "ascript:document.vulnerable=true;//"">")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len z) 7) (not (str.prefixof "<div dra" y)) (not (str.contains (str.replace z "d>" "x") "ex"))))
(assert (= (str.indexof y "o on" 0) 3))
(assert (or (not (= (str.at x 6) "o")) (str.in_re x ((_ re.from_regex ecma2020) "^[_A-Za-z0-9-+.]+([_A-Za-z0-9-]+)*@[A-Za-z0-9-]+(.[A-Za-z0-9-]+)*(.[A-Za-z]{2,4}){1,2}$"))))
(assert (or (not (str.prefixof "rt(1" z)) (not (str.prefixof "<br onkeyu" y)) (not (= (str.indexof x "st<" 0) 29))))
(assert (not (str.contains y "e=true;/")))
(assert (str.suffixof ">" x))
(assert (= (str.indexof x "n" 0) 24))
(assert (not (str.suffixof "/sub>" x)))
(check-sat)
