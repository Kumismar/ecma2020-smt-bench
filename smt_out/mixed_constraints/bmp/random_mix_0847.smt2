; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "ABC<div style=""x:exp\x5Cression(javascript:alert(1)"">DEF") (= x "<map draggable=""true"" ondragend=""alert(1)"">test</map>") (= x "<IMG SRC=x ondrag=""alert(String.fromCharCode(88,83,83))"">")))
(assert (or (= z "ditable>test</iframe>") (= z ";"">") (= z "foot oncontextmenu=""alert(1)"">test</tfoot>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains (str.replace x " styl" " ") "iv e=") (not (= (str.len y) 98)) (not (str.prefixof "foot oncon" z))))
(assert (or (not (= (str.indexof z """>" 0) 1)) (not (str.contains z "table>test"))))
(assert (not (str.prefixof ";"">" z)))
(assert (or (not (str.contains (str.replace z "lert(" "javascript:") "ipt:ajavascript:""")) (not (= "<datalist oncon""xtmenu=""alert(1)"">test</datalist>" (str.replace x "te" """")))))
