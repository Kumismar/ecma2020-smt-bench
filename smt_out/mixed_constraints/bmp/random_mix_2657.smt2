; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<center onclick=""alert(1)"">test</center>") (= x "<img src\x47=x onerror=""javascript:alert(1)"">") (= x "<svg><fieldset onload=alert(1)></fieldset>")))
(assert (or (= z "(1)"">test</input>") (= z "s:e/**/xpression(alert('XSS'))>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "d=al")) (not (str.suffixof """>" x))))
(assert (or (not (= "=" (str.substr y 15 1))) (not (= (str.at x 8) "\")) (str.in_re x ((_ re.from_regex ecma2020) "^\d{9}?$"))))
(assert (or (= (str.indexof x "lert" 0) 23) (not (str.contains x "/ce")) (not (= (str.len y) 62))))
(assert (str.contains (str.replace y "cr" "") "javasipt"))
(assert (not (str.suffixof "</center>" x)))
(check-sat)
