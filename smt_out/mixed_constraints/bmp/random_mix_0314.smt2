; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<math>") (= x "&lt;A HREF=&q\u{1f4a9}uot;http://www.goog\u{1f600}le.com./&quot;&gt;XSS&lt;/A&gt;")))
(assert (or (= z "ss&quot;)}&lt;/STYLE&gt;") (= z "t</bdo>") (= z "esheet"">")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "t</bdo>" z) (not (= (str.indexof z "/bd" 0) 2))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{5}(?:-[0-9]{4})?$")) (= (str.at z 3) "b") (>= (str.len x) 2)))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^([\da-z_\.-]+)@([\da-z\.-]+)\.([a-z\.]{2,6})$"))))
(assert (or (str.contains z "et"">") (str.suffixof ";" x)))
(assert (= "lt;" (str.substr y 17 3)))
(assert (or (not (= (str.at y 66) "X")) (not (str.suffixof "math>" x)) (not (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.'!#$%&*+\/=?^{|}~_-]+(\.[a-zA-Z0-9.'!#$%&*+\/=?^{|}~_-]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*(\.[a-zA-Z]{2,4})")))))
(assert (= (str.indexof y " HREF" 0) 5))
(check-sat)
