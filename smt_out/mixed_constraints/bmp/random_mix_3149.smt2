; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a oncontextmenu=""alert(1)"">test</a>") (= x "<IMG STYLE=""xss:expr/*XSS*/ession(alert('XSS'))"">")))
(assert (or (= z "le=""true"" contenteditable>drag me</div><source ondrop=alert(1) contenteditable>drop here</source>") (= z "nteditable>test</a>") (= z "code>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "'XSS'" 0) 40)) (not (= (str.at z 20) "t"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^1[345678]\d{9}$"))))
(assert (not (str.prefixof " tabin" z)))
(assert (str.contains x "('XSS')"))
(assert (>= (str.len z) 15))
(assert (or (not (= (str.at y 5) "S")) (not (= (str.at y 70) "="))))
(assert (or (str.prefixof "<param i" y) (<= (str.len y) 156) (= (str.len y) 68)))
(check-sat)
