; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video autoplay onplaying=alert(1)><source src=""validvideo.mp4"" type=""video/mp4""></video>") (= x "<thead onkeypress=""alert(1)"" contenteditable>test</thead>") (= x "<head draggable=""true"" ondragend=""alert(1)"">test</head>")))
(assert (or (= z ";prompt&#x28;1&#x29;""/*/onerror='eval(src)'>") (= z "ue"" ondragleave=""alert(1)"">test</listing>")))
(assert (= y (str.++ x z)))
(assert (or (str.prefixof "<t" x) (= (str.at x 39) "(") (not (= (str.indexof z ")"">" 0) 24))))
(assert (or (not (str.contains (str.replace x "ert(" "alert(1)") "=""alalert(1)1)"">t")) (not (str.prefixof "<thead " x))))
(assert (not (= "ing>" (str.substr y 126 6))))
(assert (or (not (= (str.at z 35) "a")) (= (str.indexof z "'eva" 0) 32)))
(assert (str.prefixof "<thead" x))
(assert (or (= (str.indexof y "a" 0) 7) (not (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{5d0}-\u{5ea}_-].{2,50}$")))))
(check-sat)
