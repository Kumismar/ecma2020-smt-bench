; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<tr oncopy=""alert(1)"" contenteditable>test</tr>") (= x "<strike onclick=""alert(1)"">test</strike>") (= x "<dir onmouseover=""alert(1)"">test</dir>")))
(assert (or (= z "lockquote>") (= z "))>#alert(1)")))
(assert (= y (str.++ x z)))
(assert (str.contains (str.replace z ")>#al" "alert(1)") ")alert(1)er"))
(assert (or (= "<xund SRC=""javascript:document.vulnerable=true;"">" (str.replace x "bgso" "x")) (not (>= (str.len x) 32))))
(assert (or (not (str.prefixof "lockq" z)) (not (str.suffixof "uote>" y)) (not (str.prefixof "<tr oncopy" x))))
(assert (or (= (str.indexof z "q" 0) 4) (not (str.prefixof "loc" z)) (not (= (str.at x 30) "s"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^0\d{1,3}-?\d{2,4}-?\d{4}"))) (not (str.suffixof "1)" z))))
(assert (not (str.suffixof "xtarea>" z)))
(assert (not (= (str.len y) 48)))
(assert (= (str.at x 27) "."))
(check-sat)
