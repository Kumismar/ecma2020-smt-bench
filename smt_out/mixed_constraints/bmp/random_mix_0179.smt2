; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<article id=x tabindex=1 onfocusin=alert(1)></article>") (= x "<div draggable=""true"" contenteditable>drag me</div><map ondragover=alert(1) contenteditable>drop here</map>")))
(assert (or (= z "teditable>test</body>") (= z "hange=alert(1)>")))
(assert (= y (str.++ x z)))
(assert (<= (str.len y) 75))
(assert (or (str.prefixof "hange=a" z) (not (str.contains x "x ta")) (not (= (str.at x 89) "l"))))
(assert (or (str.suffixof "/article>" x) (not (str.contains x "er"))))
(assert (or (str.prefixof "hange=aler" z) (str.contains y "table>d")))
(assert (str.in_re x ((_ re.from_regex ecma2020) "(?=.*\d).{6,20}")))
(check-sat)
