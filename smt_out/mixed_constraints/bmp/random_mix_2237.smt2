; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a href=""javas\x00cript:javascript:alert(1)"" id=""fuzzelement1"">test</a>") (= x "<col draggable=""true"" ondragleave=""alert(1)"">test</col>")))
(assert (or (= z ">test</frameset>") (= z "t</main>") (= z "p id=x tabindex=1 onbeforedeactivate=alert(1)></optgroup><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (>= (str.len x) 64) (not (= (str.indexof z " " 0) 1))))
(assert (or (str.contains (str.replace z "ain" "javascript:") "</mjavascript:>") (str.prefixof ">test" z) (str.in_re y ((_ re.from_regex ecma2020) "^\+7\(\d\d\d\) \d\d\d-\d\d\d\d$"))))
(assert (or (str.contains y ">test</fra") (= (str.len z) 16)))
(assert (str.suffixof "/a>" x))
(assert (= ">" (str.substr y 86 3)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.{5,32}$)(?![_.])(?!.*[_.]{2})[a-zA-Z0-9._]+$"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^(\+4219\d{8,})"))))
(check-sat)
