; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1f4a9}svg><param onload=alert(1)></param>") (= x "<param onbeforecu\u{1f4a9}t=""alert(1)"" contenteditable>test</param>")))
(assert (or (= z "/figure>") (= z "caption>") (= z "out=""alert(1)"">test</li\u{10348}nk>")))
(assert (= y (str.++ x z)))
(assert (not (= "or" (str.substr x 12 2))))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[^;<>=]{2,100}$"))) (not (str.prefixof "<\u{1f4a9}svg><" x))))
(assert (or (str.prefixof "out=""aler" z) (= (str.at x 34) "t")))
(assert (or (not (str.suffixof "k>" z)) (not (= "re>" (str.substr z 5 7)))))
(assert (not (= "gur" (str.substr z 3 3))))
(assert (not (str.prefixof "<\u{1f4a9}svg><p" x)))
(assert (= (str.at z 7) ">"))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "\d{3}-\d{4}|\d{7}"))))
(check-sat)
