; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<video onmousedown=""alert(1)"">test</video>") (= x "<menu onkeyup=""alert(1)"" contenteditable>test</menu>") (= x "<audio id=x tabindex=1 onbeforedeactivate=alert(1)></audio><input autofocus>")))
(assert (or (= z "ck=""alert(1)"">test</span>") (= z "ert(1)></img>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.suffixof """>test</a>" y)) (= (str.at x 55) "d")))
(assert (or (not (= "/i" (str.substr z 8 2))) (= (str.indexof y ">te" 0) 29)))
(assert (or (= (str.at x 25) "(") (not (str.suffixof "obr>" z)) (str.contains y "l\u{1f4a9}e=""")))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9_\-!@$&\. ]{1,50}$"))))
(check-sat)
