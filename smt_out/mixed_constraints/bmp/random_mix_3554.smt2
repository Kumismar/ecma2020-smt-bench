; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup id=x tabindex=1 onfocus=alert(1)></colgroup>") (= x "<q draggable=""true"" ondragleave=""alert(1)"">test</q>") (= x "&lt;A HREF=&quot;http://www.gohttp://www.google.com/ogle.com/&quot;&gt;XSS&lt;/A&gt;")))
(assert (or (= z "tp://ha.ckers.org/scriptlet.html&quot;&gt;&lt;/OBJECT&gt;") (= z "ert(1)\u{20000}"">test</td>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "ble>dr" (str.substr z 1 6))) (= (str.indexof z "ot;&g" 0) 35)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Za-z\u{420}\u{421}\u{422}\u{423}\u{424}\u{425}\u{426}\u{427}\u{428}\u{429}\u{42a}\u{42b}\u{42c}\u{42d}\u{42e}\u{42f}\u{430}\u{431}\u{432}\u{433}\u{434}\u{435}\u{436}\u{438}\u{439}\u{43a}\u{43b}\u{43c}\u{43d}\u{43e}\u{43f}\u{440}\u{441}\u{442}\u{443}\u{444}\u{445}\u{446}\u{447}\u{448}\u{449}\u{44a}\u{44b}\u{44c}\u{44d}\u{44e}\u{44f}\u{2116}\u{451}\u{452}\u{453}\u{454}\u{455}\u{456}\u{458}\u{459}\u{45a}\u{45b}\u{45c}\u{a7}\u{45e}\u{45f}]*$"))) (not (str.prefixof ")>click" z)) (not (= (str.at y 64) "o"))))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9_.]{5,25}$")) (not (str.contains (str.replace z ")\u{20000}" " ") "1 "">tes")) (str.suffixof "oup>" x)))
(assert (= (str.at z 1) "<"))
(check-sat)
