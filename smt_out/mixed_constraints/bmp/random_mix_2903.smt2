; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<q id=x tabindex=1 ondeactivate=alert(1)></q><input id=y autofocus>") (= x "<svg><ol onload=alert(1)></ol>") (= x "<style>:target {color: red;}</style><sub id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></sub>")))
(assert (or (= z " ondrag=""alert(1)"">test</table>") (= z "ody onmouseenter=""alert(1)"">test</tbody>") (= z "nbeforeactivate=alert(1)></canvas>")))
(assert (= y (str.++ x z)))
(assert (not (str.contains z "/tbody>")))
(assert (not (= (str.indexof x "can" 0) 87)))
(assert (not (= (str.indexof x "=" 0) 5)))
(assert (= (str.indexof z "ag=""a" 0) 5))
(assert (or (str.suffixof "body>" y) (not (= "<multic<b> draggable=""true"" ondrag=""alert(1)"">test</multicol>ut autofocus>" (str.replace y "ol" "<b>"))) (= "</" (str.substr x 45 2))))
(assert (not (str.suffixof "b>" x)))
(assert (not (str.suffixof "cript>" y)))
(assert (or (not (= ")"">test</t" (str.substr z 16 10))) (str.prefixof "<style>" x)))
(assert (or (not (str.contains z "ag=""alert")) (not (= (str.at x 19) "o"))))
(assert (or (str.contains z "est</fi") (not (str.in_re z ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-za-z0-9.-]+\.[A-Za-z]{2,3}$")))))
(check-sat)
