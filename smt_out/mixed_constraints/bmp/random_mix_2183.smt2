; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<\u{1f600}code draggable=""true"" ondragenter=""alert(1)"">test</c\u{1f4a9}ode>") (= x "<wbr onmouseup=""alert(1)"">test</wbr>")))
(assert (or (= z "eup=""alert(1)"">test</menuitem>") (= z "/victimsite.com/admin.asp&deleteuser") (= z "art=""alert(1)"">test</style>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.indexof x """aler" 0) 15) (str.prefixof "<\u{1f600}code dra" y) (not (str.contains x "nmouseup"))))
(assert (str.in_re y ((_ re.from_regex ecma2020) "^[a-zA-Z][a-zA-Z0-9-_\s]{1,30}$")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "[a-zA-Z0-9._%+-]+@(?!gmail.com)(?!yahoo.com)(?!hotmail.com)(?!hotmail.co.il)(?!walla.co.il)(?!mail.ru)(?!outlook.com)(?!email.com)(?!icloud.com)(?!me.com)[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$"))))
(assert (or (= "e " (str.substr y 5 2)) (= (str.at y 6) " ") (not (str.in_re x ((_ re.from_regex ecma2020) "[A-Fa-f0-9_-]{5,5}")))))
(assert (or (not (str.contains (str.replace x "/w" "javascript:") "<javascript:b")) (str.contains y "alert(1)""")))
(check-sat)
