; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<em onmouseup=""alert(1)"">test</em>") (= x "<shadow draggable=""true"" ondragend=""alert(1)"">test</shadow>")))
(assert (or (= z " onfocus=alert(1)></image>") (= z "autofocus>") (= z "rt(1)"">test</bdo>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof x "st<" 0) 27)))
(assert (not (= "ggab" (str.substr x 11 4))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9\u{e0}\u{e1}\u{e2}\u{e3}\u{e4}\u{e5}\u{e7}\u{e8}\u{e9}\u{ea}\u{eb}\u{ec}\u{ed}\u{ee}\u{ef}\u{f0}\u{f2}\u{f3}\u{f4}\u{f5}\u{f6}\u{f9}\u{fa}\u{fb}\u{fc}\u{fd}\u{ff}\-'&]{4,}$"))) (not (= (str.at x 11) "u"))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^(|[0-9][0-9]*)$"))))
(assert (str.contains x "ra"))
(assert (<= (str.len y) 65))
(assert (or (not (= """>test<" (str.substr z 5 7))) (not (str.prefixof "<em onm" x))))
(assert (str.prefixof "<em on" y))
(check-sat)
