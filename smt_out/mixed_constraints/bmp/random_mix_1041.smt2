; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<scrscriptipt>alert(1)</scrscriptipt>") (= x "<form draggable=""true"" ondragstart=""aler\u{10348}t(1)"">test</form>")))
(assert (or (= z "ntouchmove=alert(1)>") (= z "ve=""alert(1)"">test</ruby>") (= z "y>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof z "t</" 0) 17)) (str.prefixof "one" z) (str.in_re y ((_ re.from_regex ecma2020) "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+.[A-Za-z]{2,3}$"))))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "number_spaces")) (str.contains y "rue"" ondr")))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[^\s*]([a-zA-Z\u{f1}\u{d1}\u{c0}-\u{ff}\s]+){0,150}$"))))
(assert (or (= (str.indexof x "s" 0) 1) (= (str.indexof y "g" 0) 9)))
(assert (or (not (str.prefixof "<scrscri" y)) (= "script" (str.substr x 27 6))))
(check-sat)
