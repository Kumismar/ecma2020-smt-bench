; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<colgroup onbeforecut=""alert(1)"" contenteditable>test</colgroup>") (= x "<header onmousedown=""alert(1)"">te\u{20000}st</header>") (= x "<template onmouseup=""alert(1)"">test</template>")))
(assert (or (= z "t(1)</s\u{10348}cript>") (= z "tenteditable>test</rp>")))
(assert (= y (str.++ x z)))
(assert (or (<= (str.len z) 28) (= (str.len y) 54) (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-Z\u{c0}-\u{17e}. -]{2,}"))))
(assert (not (= (str.indexof z "1)<" 0) 2)))
(assert (or (not (str.prefixof "t(1)</s\u{10348}c" z)) (= (str.len y) 98) (not (str.contains z "t<"))))
(assert (or (= (str.indexof z "</r" 0) 17) (str.prefixof "<temp" y) (not (str.suffixof "pt>" y))))
(assert (str.contains x "eade"))
(assert (str.prefixof "<c" y))
(check-sat)
