; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<object draggable=""true"" ondragstart=""alert(1)"">test</object>") (= x "<center onclick=""alert(1)"">test</center>")))
(assert (or (= z "sitioncancel=alert(1)></embed>") (= z "tofocus>") (= z "aggable=""true"" contenteditable>drag me</div><source ondragover=alert(1) contenteditable>drop here</source>")))
(assert (= y (str.++ x z)))
(assert (not (str.suffixof "e</source>" z)))
(assert (not (<= (str.len z) 16)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "(?!-)[a-zA-Z0-9-]{1,63}"))) (str.prefixof "ag" z) (str.contains y "nkeyup=""al")))
(assert (not (= "table>te" (str.substr z 11 8))))
(assert (or (= "=alert(1)>" (str.substr z 12 10)) (str.prefixof "agga" z) (not (= (str.indexof x "on" 0) 25))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^(\+?[\d -]{8,15}[,]{0,1})*$"))) (str.contains (str.replace y "em" """") "</""b") (str.in_re x ((_ re.from_regex ecma2020) "(?=.*?[\u{5c}u3041-\u{5c}u309F\u{5c}u30FC])[\u{5c}u3041-\u{5c}u309F\u{5c}u30FC\s]*"))))
(assert (not (= ">" (str.substr z 7 10))))
(check-sat)
