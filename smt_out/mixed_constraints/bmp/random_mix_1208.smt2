; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<a ondblclick=""alert(1)"">test</a>") (= x "<marquee draggable=""true"" ondragend=""alert(1)"">test</marquee>") (= x "<meter onkeypress=""alert(1)"" contenteditable>test</meter>")))
(assert (or (= z """alert(1)"">test</nav>") (= z "x tabindex=1 onfocusin=alert(1)></mark>") (= z "')}\""&gt;")))
(assert (= y (str.++ x z)))
(assert (not (= (str.at y 50) "n")))
(assert (or (= (str.indexof y "ar" 0) 2) (not (= (str.indexof z "binde" 0) 4))))
(assert (or (= ";" (str.substr z 8 6)) (not (str.suffixof "t;" y)) (str.contains z "</sc")))
(assert (str.prefixof "<me" x))
(assert (or (not (= (str.indexof x "qu" 0) 4)) (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9\u{e4}\u{f6}\u{fc}\u{c4}\u{d6}\u{dc}\u{e9}\u{e0}\u{e8}\u{c9}\u{c8}\u{df}]*$"))))
(check-sat)
