; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<h1 onmouseup=""alert(1)"">test</h1>") (= x "&#X003c;") (= x "<slot id=x tabindex=1 onfocusin=alert(1)></slot>")))
(assert (or (= z ")"">test</table>") (= z "ondeactivate=alert(1)></option><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (str.prefixof "<sl" x))
(assert (or (= (str.at z 43) "a") (= " onmouseu" (str.substr x 3 9)) (= (str.indexof x ")" 0) 39)))
(assert (or (not (= (str.at x 4) "t")) (not (str.contains z "le>")) (not (= "t(1)></temp""ate>" (str.replace z "l" """")))))
(assert (str.in_re z ((_ re.from_regex ecma2020) "[0-9+]{9,15}$")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[ABCEGHJKLMNPRSTVXY][0-9][ABCEGHJKLMNPRSTVWXYZ] ?[0-9][ABCEGHJKLMNPRSTVWXYZ][0-9]$"))) (= (str.at z 3) "t") (not (= (str.indexof y "est<" 0) 12))))
(assert (str.prefixof "<h1 on" y))
(assert (or (= (str.indexof z "fo" 0) 47) (str.contains z ">te")))
(check-sat)
