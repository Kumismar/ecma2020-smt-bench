; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style>:target {transform: rota\u{20000}te(1\u{1f600}80deg);}</style><blockquote id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></blockquote>") (= x "<caption oncontextmenu=""alert(1)"">test</caption>")))
(assert (or (= z "teditable>test</li>") (= z "tyle>@keyframes x{}</style><iframe style=""animation-name:x"" onanimationend=""alert(1)""></iframe>")))
(assert (= y (str.++ x z)))
(assert (= (str.at z 90) "r"))
(assert (or (str.contains y "1)"">test") (not (= (str.at y 111) "<"))))
(assert (or (= (str.indexof x "pt" 0) 3) (str.contains (str.replace z "t" "<b>") "<b>edi")))
(assert (str.contains x "nt"))
(assert (or (>= (str.len y) 16) (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z- ]{2,}")) (= (str.indexof z "styl" 0) 21)))
(assert (not (= "test</cap" (str.substr x 34 9))))
(assert (not (= (str.len z) 19)))
(check-sat)
