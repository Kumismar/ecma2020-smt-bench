; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<time oncut=""alert(1)"" contenteditable>test</time>") (= x "<style onReadyStateChange style onReadyStat\u{1f4a9}eChange=""\u{10348}javascript:javascript:alert(1)""></style onReadyStateChange>")))
(assert (or (= z "pt&lpar;1&rpar;&gt;'>") (= z "onbeforeactivate=alert(1)></div>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) ".{2,}\w*[a-zA-Z]\w*"))) (= (str.at x 7) "o") (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9]{5}(-[0-9]{4})?$")))))
(assert (or (= (str.at z 12) "v") (not (<= (str.len y) 155))))
(assert (or (= (str.indexof z "r;1&r" 0) 6) (= "onbeforeactivate=alert 1)></div>" (str.replace z "(" " ")) (not (= (str.at x 43) "<"))))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^([\w\d.\-+_\u{2018}]+)@((?:[-a-zA-Z0-9]+\.)+[a-zA-Z]{2,})$"))) (not (str.contains y "le on")) (not (<= (str.len z) 39))))
(assert (not (= (str.indexof z "p" 0) 0)))
(assert (str.prefixof "<styl" y))
(assert (= (str.indexof x "es" 0) 40))
(check-sat)
