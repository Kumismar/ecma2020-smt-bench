; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<title onmousedown=""alert(1)"">test</title>") (= x "<keygen onbeforecut=""alert(1)"" contentedita\u{20000}ble>test</keygen>")))
(assert (or (= z "itable>test</marquee>") (= z "ousemove=""alert(1)"">test</ruby>") (= z "sin=alert(1)></hea\u{10348}der>")))
(assert (= y (str.++ x z)))
(assert (or (str.suffixof "le>" x) (not (str.contains x "/title"))))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^[ 0-9]+$"))))
(assert (= (str.indexof x "t</" 0) 33))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^1[3456789]{1}\d{9}$"))) (not (str.suffixof "e>" y)) (not (str.in_re y ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[0-9])(?=.*[!@^#%*]).{8,20}$")))))
(assert (not (= (str.indexof y "1)" 0) 27)))
(check-sat)
