; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<marquee onStart marquee onStart=""javascript:j\u{20000}avascript:alert(1)""></marquee onStart>") (= x "<blockquote onpaste=""alert(1)"" contenteditable>test</blockquote>") (= x "<head onmouseover=""alert(1)"">test</head>")))
(assert (or (= z "e>") (= z "onpaste=""alert(1)"" contenteditable>test</param>")))
(assert (= y (str.++ x z)))
(assert (or (= (str.at z 0) "e") (str.contains z "npaste=""")))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "[8|9][0-9]{7}"))) (str.prefixof "<arti" y) (= "<marquee onStart marquee onStart= avascript:j\u{20000}avascript:alert(1)""></marquee onStart>" (str.replace x """j" " "))))
(assert (not (= (str.at x 45) "e")))
(assert (not (= "ste=""a" (str.substr z 4 6))))
(assert (or (str.suffixof "test</hr>" x) (not (str.prefixof "<blockquo" x))))
(assert (not (<= (str.len x) 48)))
(check-sat)
