; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<listing id=x tabindex=1 onbeforeactivate=alert(1)></listing>") (= x "<IMG SRC=x onsearch=""alert(String.fromCharCode(88,83,83))"">") (= x "<script draggabl\u{20000}e=""tr\u{1f600}ue"" ondragleave=""alert(1)"">test</script>")))
(assert (or (= z "load=alert(1)></sup>") (= z "&#x72&#x69&#x70&#x74&#x3A&#x61&#x6C&#x65&#x72&#x74&#x28&#x27&#x58&#x53&#x53&#x27&#x29>") (= z "bed>")))
(assert (= y (str.++ x z)))
(assert (or (str.in_re z ((_ re.from_regex ecma2020) "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\x7e\x60\x21\x40\x23\x24\x25\x5e\x26\x2a\x28\x29\x5f\x2d\x2b\x3d\x5b\x5d\x7b\x7d\x7c\x3a\x3b\x22\x27\x3c\x2c\x3e\x2e\x3f\x5c\x2f])[A-Za-z\d\x7e\x60\x21\x40\x23\x24\x25\x5e\x26\x2a\x28\x29\x5f\x2d\x2b\x3d\x5b\x5d\x7b\x7d\x7c\x3a\x3b\x22\x27\x3c\x2c\x3e\x2e\x3f\x5c\x2f]{8,}$")) (= (str.at z 25) "f") (= (str.len x) 61)))
(assert (or (= (str.indexof y "8,83," 0) 48) (= (str.indexof z "np" 0) 50)))
(assert (str.prefixof "<script" y))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "(?=.*[A-Z])(?=.*[0-9])(?=.*[a-z]).{8,25}"))) (str.in_re x ((_ re.from_regex ecma2020) "[\w]{1,}[\w.+-]{0,}@[\w-]{2,}([.][a-zA-Z]{2,}|[.][\w-]{2,}[.][a-zA-Z]{2,})$"))))
(assert (not (= "7" (str.substr z 79 1))))
(check-sat)
