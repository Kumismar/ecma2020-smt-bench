; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<SCRIPT>alert('XSS');</SCRIPT>") (= x "<!a foo=x=`y><img alt=""`><img src=xx:x onerror=alert(2)//"">")))
(assert (or (= z "alert(1)"">test</rt>") (= z "cus>")))
(assert (= y (str.++ x z)))
(assert (not (<= (str.len z) 19)))
(assert (or (= "<SCRIPT>alert('XSS');</SCRIPT>alert(1)"">te/rt>" (str.replace y "st<" "")) (str.contains y "t(\""XSS")))
(assert (or (= "tp&#5" (str.substr x 17 5)) (not (str.in_re z ((_ re.from_regex ecma2020) "[\d]{3,6}"))) (= ":" (str.substr x 36 1))))
(assert (or (not (str.prefixof "<SCRIPT>al" x)) (= (str.indexof x "img " 0) 14)))
(assert (or (not (= (str.at x 11) "r")) (not (<= (str.len x) 56))))
(assert (str.contains (str.replace z "us" "") "c>"))
(check-sat)
