; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ol onbeforepaste=""alert(1)"" contenteditable>test</ol>") (= x "<track draggable=""true"" ondragend=""alert(1)"">test</track>")))
(assert (or (= z "et {color:red;}</style><h1 id=x style=""transition:color 1s"" ontransitionend=alert(1)></h1>") (= z """alert(1)"">test</q>") (= z "; alert(var)</script>")))
(assert (= y (str.++ x z)))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "^([0|\+[0-9]{1,5})?([7-9][0-9]{9})$"))))
(assert (or (not (str.suffixof "h1>" y)) (= (str.indexof x "imat" 0) 69)))
(assert (or (not (str.suffixof "/q>" z)) (not (str.prefixof """" z))))
(assert (not (= "<ol onbeforepaste""""alert(1)"" contenteditable>test</ol>" (str.replace x "=" """"))))
(assert (not (str.prefixof "<ol " x)))
(assert (str.contains (str.replace z "nsi" " ") "tra tio"))
(assert (not (= "editable>t" (str.substr y 36 10))))
(assert (str.suffixof "test</q>" z))
(assert (not (str.in_re z ((_ re.from_regex ecma2020) "\d{2}[A-Z]{5}\d{4}[A-Z]{1}[A-Z\d]{1}[Z]{1}[A-Z\d]{1}"))))
(assert (or (= (str.at y 75) "s") (not (= (str.at z 12) "e"))))
(assert (str.prefixof """alert(1)" z))
(assert (= (str.at y 57) ">"))
(check-sat)
