; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<dd draggable=""true"" ondragend=""alert(1)"">test</dd>") (= x "<x onco\u{20000}ntextmenu=alert(\u{1f600}1)>right click this!") (= x "<noembed onkeyup=""a\u{10348}lert(1)"" contenteditable>test</noe\u{20000}mbed>")))
(assert (or (= z "t style=""animation-name:x"" onanimationend=""alert(1)""></output>") (= z "nuitem id=x tabindex=1 ondeactivate=alert(1)></menuitem><input id=y autofocus>") (= z "=alert(1)></ol>")))
(assert (= y (str.++ x z)))
(assert (or (= "<x onco\u{20000}ntextmenu=alert(\u{1f600}1right click this!" (str.replace x ")>" "")) (not (= (str.indexof x "=aler" 0) 17))))
(assert (or (str.prefixof "<" x) (not (= (str.indexof z "rt(1" 0) 39)) (str.in_re x ((_ re.from_regex ecma2020) "^(\s?[^\s,]+@[^\s,]+\.[^\s,]+\s?,)*(\s?[^\s,]+@[^\s,]+\.[^\s,]+)$"))))
(assert (or (= (str.indexof x "dit" 0) 37) (not (>= (str.len x) 41)) (str.prefixof "<noembe" y)))
(assert (or (not (str.suffixof "t>" y)) (not (str.in_re x ((_ re.from_regex ecma2020) "[a-zA-z ]+"))) (= "<dd draggaxle=""true"" ondragend=""alert(1)"">test</dd>" (str.replace x "b" "x"))))
(check-sat)
