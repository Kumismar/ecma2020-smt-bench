; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<fieldset onclick=""alert(1)"">test</fieldset>") (= x "<q id=x tabindex=1 onfocusin=alert(1)></q>") (= x "<canvas onclick=""alert(1)"">test</canvas>")))
(assert (or (= z "bdo>") (= z "nstart=""alert(1)""></s>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains (str.replace y ">te" "x") ")""xs")) (not (= (str.indexof x "abind" 0) 9))))
(assert (or (not (str.contains x """>test")) (= (str.at x 1) "q")))
(assert (<= (str.len x) 49))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "^[a-zA-Z0-9.-_+]{1,}@[a-zA-Z.-]{2,}[.]{1}[a-zA-Z]{2,}"))) (not (= "nstart=""alert(1)""x</s>" (str.replace z ">" "x"))) (not (str.contains (str.replace z "</s" """") "1)"">"">"))))
(check-sat)
