; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<div id=""137""><svg>") (= x "<fieldset onbeforecopy=""alert(1)"" contenteditable>test</fieldset>")))
(assert (or (= z "namespace prefix=""t"">") (= z "lick=""alert(1)"">test</wbr>") (= z "=""true"" contenteditable>drag me</div><spacer ondragover=alert(1) contenteditable>drop here</spacer>")))
(assert (= y (str.++ x z)))
(assert (or (not (str.contains x "e>t")) (not (str.contains z "rag me<"))))
(assert (or (not (str.in_re y ((_ re.from_regex ecma2020) "^[1-9]\d{9}$"))) (not (str.prefixof "<par" y))))
(assert (not (<= (str.len z) 27)))
(assert (or (not (str.in_re z ((_ re.from_regex ecma2020) "[0-9,\.\(\)\-\+]{5,25}"))) (str.prefixof "<fi" y) (str.contains x "ndex")))
(check-sat)
