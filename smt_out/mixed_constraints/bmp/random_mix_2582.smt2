; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ruby oncut=""alert(1)"" contenteditable>test</ruby>") (= x "<a href=""\xC2\xA0javascript:javascript:alert(1)"" id=""fuzzelement1"">test</a>")))
(assert (or (= z "lert(1)"">test</article>") (= z "or:red;}</style><frame id=x style=""transition:color 1s"" ontransitionend=alert(1)></frame>") (= z "alert(1)"" contenteditable>test</u>")))
(assert (= y (str.++ x z)))
(assert (not (str.prefixof "<s" x)))
(assert (or (not (str.contains z "le")) (not (= (str.len z) 34)) (= "t'http&#58;//ha&#alert(1)ckers&#46;\u{20000}org/xss&#46;css';&lt;/STYLE&gt;" (str.replace z "46;" "alert(1)"))))
(assert (or (not (str.contains x "er")) (not (str.in_re x ((_ re.from_regex ecma2020) "^[\u{5c}u4e00-\u{5c}u9fa5]{1,5}$")))))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "([1-9]|1[0-9]|2[0-9]|3[01]){1,2}.([1-9]|1[012]){1,2}.[0-9]{4}"))))
(assert (not (str.contains z "(1)></fra")))
(assert (or (not (str.contains (str.replace y "lem" "<b>") "e<b>ent")) (not (str.prefixof "<slot onc" y)) (= (str.indexof x "RiPt:" 0) 15)))
(assert (or (not (= "tentedita" (str.substr y 26 9))) (not (str.suffixof "t</u>" y)) (not (str.prefixof "<" x))))
(check-sat)
