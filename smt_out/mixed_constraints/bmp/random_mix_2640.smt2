; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "//--></SCRIPT><SCRIPT>alert(String.fromCharCode(88,83,83));") (= x "<mar\u{10348}k oncli\u{10348}ck=""alert(1)"">test</mark>") (= x "<style>:target {color:red;}</style><span id=x style=""transition:color 1s"" ontransitionend=alert(1)></span>")))
(assert (or (= z "ript:alert(1)</script>") (= z "efont><input id=y autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof x "rt(" 0) 93)) (str.prefixof "<mar\u{10348}k" y) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9() -]+$")))))
(assert (or (str.in_re x ((_ re.from_regex ecma2020) "^[0-9A-Za-z@.\-_]+$")) (<= (str.len z) 14) (not (str.contains (str.replace x "RIP" """") "></SC""T><S"))))
(assert (or (str.contains (str.replace z "=y " "x") "dxautof") (str.contains (str.replace y ">" "javascript:") "//--javascript:</") (not (str.contains z " id=y a"))))
(assert (or (not (= (str.indexof z "y" 0) 16)) (not (str.in_re y ((_ re.from_regex ecma2020) "[a-zA-Z\s]{1,15}")))))
(assert (or (not (= "ont" (str.substr y 40 3))) (not (>= (str.len x) 103))))
(check-sat)
