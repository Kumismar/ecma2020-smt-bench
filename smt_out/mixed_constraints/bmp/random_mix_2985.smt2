; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<del onblur=alert(1) tabindex=1 id=x></del><input autofocus>") (= x "<span onkeyup=""alert(1)"" contenteditable>test</span>") (= x "<! foo=""[[[Inception]]""><x foo=""]foo><script>alert(1)</script>"">")))
(assert (or (= z "3C;") (= z "c onmouseout=""alert(1)"">test</rtc>") (= z "nblur=alert(1) tabindex=1 id=x></data><input autofocus>")))
(assert (= y (str.++ x z)))
(assert (or (not (= "/de" (str.substr x 38 3))) (str.contains (str.replace y "=" "javascript:") "gablejavascript:""tru") (str.in_re z ((_ re.from_regex ecma2020) "^([0-9]|[0-9][0-9]|[\u{ff10}-\u{ff19}]|[\u{ff10}-\u{ff19}][\u{ff10}-\u{ff19}])$"))))
(assert (not (= "n lur=alert(1) tabindex=1 id=x></data><input autofocus>" (str.replace z "b" " "))))
(assert (or (str.prefixof "<! foo=""" y) (not (= (str.at z 92) "y"))))
(assert (not (str.in_re x ((_ re.from_regex ecma2020) "^[a-zA-Z0-9!$&*.=^`|~#%'+\/?_{}-]+@([a-zA-Z0-9_-]+\.)+[a-zA-Z]{2,4}$"))))
(assert (or (not (str.contains (str.replace x "n" "") "[[Icep")) (<= (str.len y) 86) (>= (str.len x) 62)))
(check-sat)
