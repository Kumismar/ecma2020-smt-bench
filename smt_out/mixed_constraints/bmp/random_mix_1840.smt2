; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<rtc onbeforecut=""alert(1)"" contenteditable>test</rtc>") (= x "<isindex onmouseleave=""alert(1)"">test</isindex>")))
(assert (or (= z "e=""true"" ondragleave=""alert(1)"">test</basefont>") (= z "t on\u{10348}keyup=""alert(1)"" contenteditable>test</datalist>")))
(assert (= y (str.++ x z)))
(assert (not (= "talert(1)keyup=""alert(1)"" contenteditable>test</datalist>" (str.replace z " on\u{10348}" "alert(1)"))))
(assert (or (str.contains x "x onmo") (not (= (str.indexof y """al" 0) 22)) (= (str.len y) 107)))
(assert (or (not (= (str.at y 46) ">")) (not (str.in_re y ((_ re.from_regex ecma2020) "^1([38][0-9]|4[579]|5[0-3,5-9]|6[6]|7[0135678]|9[89])\d{8}$"))) (= "<isin""x onmouseleave=""alert(1)"">test</isindex>t on\u{10348}keyup=""alert(1)"" contenteditable>test</datalist>" (str.replace y "de" """"))))
(assert (or (not (str.suffixof ">" x)) (str.contains (str.replace y "c" """") "t"" on")))
(check-sat)
