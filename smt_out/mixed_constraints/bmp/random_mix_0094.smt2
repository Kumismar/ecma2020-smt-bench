; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<ul onbeforecopy=""alert(1)"" contenteditable>test</ul>") (= x "<img src ?itworksonchrome?\/onerror = alert(1)")))
(assert (or (= z "ndrop=alert(1) contenteditable>drop here</cite>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (str.contains z "ditabl"))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^(0?[1-9]|[12][0-9]|3[01])[\/\-](0?[1-9]|1[012])[\/\-]\d{4}$")) (not (= (str.at y 17) "=")) (not (str.contains (str.replace y "edit" "alert(1)") "tentalert(1)ab"))))
(assert (or (= (str.indexof z """ on" 0) 51) (not (str.in_re y ((_ re.from_regex ecma2020) "^[0-9 () + -]{1,20}$"))) (not (= "<img src ?itworksonchrome?\/ojavascript:ror = alert(1)" (str.replace x "ner" "javascript:")))))
(assert (or (not (= (str.indexof x "rc" 0) 6)) (= "<bgsound""javascript:document.vulnerable=true;"">" (str.replace x " SRC=" ""))))
(check-sat)
