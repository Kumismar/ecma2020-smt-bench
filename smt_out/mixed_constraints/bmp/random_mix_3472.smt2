; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<style></style\x0A<img src=""about:blank"" onerror=javascript:alert(1)//></style>") (= x "<style>:target {color: red;}</style><source id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></source>")))
(assert (or (= z "icrosoft-com&#58;time\""&gt;") (= z "focus=alert(1)></i>") (= z " tabindex=1 onbeforeactivate=alert(1)></abbr>")))
(assert (= y (str.++ x z)))
(assert (= (str.indexof y "sty" 0) 1))
(assert (or (not (= (str.indexof x ")/" 0) 67)) (not (<= (str.len x) 84)) (str.contains z "lert(1)>")))
(assert (or (not (>= (str.len y) 132)) (not (str.contains (str.replace x "nce" """") "ca""l=ale")) (str.suffixof ";" z)))
(assert (or (str.in_re y ((_ re.from_regex ecma2020) "^(?:[a-fA-F0-9]{8}|[a-fA-F0-9]{11}|[a-fA-F0-9]{14}|[a-fA-F0-9]{15,16}|[a-fA-F0-9]{18})$")) (not (str.in_re y ((_ re.from_regex ecma2020) "^[_\.0-9a-z-]+@([0-9a-z][0-9a-z-]+\.)+[a-z]{2,3}$"))) (not (str.contains x "</s"))))
(check-sat)
