; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table draggable=""true"" ondragleave=""alert(1)"">test</table>") (= x "<animation xlink:href=""data:text/xml,%3Csvg xmlns='http://www.w3.org/2000/svg' onload='alert(88)'%3E%3C/svg%3E""/>")))
(assert (or (= z "ctivate=alert(1)></track>") (= z " onmouseleave=""alert(1)"">test</embed>") (= z ">")))
(assert (= y (str.++ x z)))
(assert (or (not (str.in_re x ((_ re.from_regex ecma2020) "^[0-9a-zA-Z]{5,5}"))) (str.in_re x ((_ re.from_regex ecma2020) "^[_a-zA-Z0-9-\+]+(\.[_a-zA-Z0-9-]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9]+)*(\.[a-zA-Z]{2,})$")) (not (= (str.indexof x "ab" 0) 2))))
(assert (or (not (= " tt ondblclick=""alert(1)"">test</tt>scrscriptipt>" (str.replace y "<" " "))) (not (str.suffixof ">" z))))
(assert (or (not (= "<an tion xlink:href=""data:text/xml,%3Csvg xmlns='http://www.w3.org/2000/svg' onload='alert(88)'%3E%3C/svg%3E""/>>" (str.replace y "ima" " "))) (str.prefixof "<ta" y) (= "st<" (str.substr x 49 3))))
(assert (or (str.suffixof "/embed>" z) (str.in_re x ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{1,}$")) (not (str.contains (str.replace x "ns=" "x") "lx'ht"))))
(assert (or (str.contains y "rg/2") (= (str.indexof y "lin" 0) 12)))
(assert (or (<= (str.len x) 61) (not (str.prefixof "<" y))))
(check-sat)
