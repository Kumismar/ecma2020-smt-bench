; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<section onmouseup=""alert(1)"">test</section>") (= x "[1].find(alert)")))
(assert (or (= z "nmouseout=""alert(1)"">test</strong>") (= z " onstorage=""alert(String.fromCharCode(88,83,83))"">") (= z "pt>alert(1)</script>")))
(assert (= y (str.++ x z)))
(assert (not (= (str.indexof z "(" 0) 16)))
(assert (or (not (= (str.indexof y "ert(1" 0) 19)) (str.suffixof "IPT>" x)))
(assert (or (not (= "rt" (str.substr x 23 2))) (str.suffixof ">" x) (not (str.in_re y ((_ re.from_regex ecma2020) "^([\w\d.\-+_\u{2018}]+)@((?:[-a-zA-Z0-9]+\.)+[a-zA-Z]{2,})$")))))
(assert (= "(1)</scri" (str.substr z 8 9)))
(assert (not (str.in_re y ((_ re.from_regex ecma2020) "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,6}$"))))
(assert (or (str.suffixof "ection>" x) (not (= "lert)" (str.substr x 10 6))) (not (= "<link REL=""stylesheet""x=""javascript:document.vulnerable=true;"">st</picture>" (str.replace y " HREF" "x")))))
(check-sat)
