; random_mix, BMP mode: x, z from disjunctions of constants, y = x ++ z, clauses of 1 to 3 random (negated) constraints of x, y, z: memberships, affixes, contains, lengths, str.at, str.indexof, str.substr, str.replace
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (= x "<table onmouseup=""alert(1)"">test</table>") (= x "&lt;scrscriptipt&gt;alert(1)&lt;/scrscriptipt&gt;")))
(assert (or (= z """ contenteditable>test</br>") (= z "up>")))
(assert (= y (str.++ x z)))
(assert (or (not (= (str.indexof y "e>" 0) 38)) (= "rsc" (str.substr y 6 3)) (str.prefixof "u" z)))
(assert (or (= "&lt;scrscriptipt&gt;alert(1)&lt;/scrscriptipt&gt;"" contenteditable>tex/br>" (str.replace y "st<" "x")) (not (str.prefixof "<form onmo" y)) (= "ous" (str.substr y 10 3))))
(assert (= (str.len x) 40))
(assert (or (not (= (str.at x 1) "l")) (= (str.indexof y "le>te" 0) 55)))
(assert (or (not (= """>test<" (str.substr x 26 7))) (not (str.in_re z ((_ re.from_regex ecma2020) "^[0-9]{1,2}:(?:00|15|30|45)$")))))
(check-sat)
