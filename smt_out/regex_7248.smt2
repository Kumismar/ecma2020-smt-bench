(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[a-zA-Z0-9.!#$%&’*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$")))
(assert (= x "<basefont id=x tabindex=1 onbeforedeactivate=alert(1)></basefont><input autofocus>"))
(check-sat)
