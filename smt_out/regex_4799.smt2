(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[^\s\._%+-][a-zA-Z0-9._%+-]+[^\s\._%+-]@[^\s\._%+-]([a-zA-Z0-9]([.-]?))+[^\s\._%+-]\.[a-zA-Z]{2,4}$")))
(assert (= x "<shadow draggable=""true"" ondragleave=""alert(1)"">test</shadow>"))
(check-sat)
