(set-logic QF_S)
(set-info :status sat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[a-zA-Z0-9!@#$%()_=+.,\/;:'\-\s\|\[\]\{\}\*]+")))
(assert (= x "<style>:target {transform: rotate(180deg);}</style><table id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></table>"))
(check-sat)
