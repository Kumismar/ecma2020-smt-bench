(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "(([X-Zx-z]{1})([-]?)(\d{7})([-]?)([A-z]{1}))|((\d{8})([-]?)([A-z]{1}))")))
(assert (= x "<style>@keyframes slidein {}</style><big style=""animation-duration:1s;animation-name:slidein;animation-iteration-count:2"" onanimationiteration=""alert(1)""></big>"))
(check-sat)
