(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^(\s)*([0-9]{3})(\s)*([0-9])(\s)*([0-9])(\s)*([0-9]{2})(\s)*([0-9]{1})(\s)*([0-9]{3})(\s)*$")))
(assert (= x "<header id=x tabindex=1 onbeforedeactivate=alert(1)></header><input autofocus>"))
(check-sat)
