(set-logic QF_S)
(set-info :status sat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "-?[0-9]*(\.[0-9]+)?")))
(assert (= x "<style>@keyframes x{from {left:0;}to {left: 1000px;}}:target {animation:10s ease-in-out 0s 1 x;}</style><element id=x style=""position:absolute;"" onanimationcancel=""alert(1)""></element>"))
(check-sat)
