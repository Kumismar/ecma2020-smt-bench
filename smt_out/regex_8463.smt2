(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "([0-9]|0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]\s(AM|PM|am|pm)|([0-9]|0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]")))
(assert (= x "<sub id=x tabindex=1 ondeactivate=alert(1)></sub><input id=y autofocus>"))
(check-sat)
