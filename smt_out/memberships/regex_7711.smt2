(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]{3,}@[A-Za-z]{1,}[.]{1}[A-Za-z.]{1,}")))
(assert (= x "<div draggable=""true"" contenteditable>drag me</div><figcaption ondragover=alert(1) contenteditable>drop here</figcaption>"))
(check-sat)
