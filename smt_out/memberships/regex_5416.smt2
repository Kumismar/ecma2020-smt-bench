(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}a-zA-Z]{2,128}[\u{430}-\u{44f}\u{410}-\u{42f}\u{451}\u{401}a-zA-Z\s]{0,128}$")))
(assert (= x "<cite onmouseup=""alert(1)"">test</cite>"))
(check-sat)
