(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[a-zA-Z]{5}[0-9]{4}[a-zA-Z]{1}$")))
(assert (= x "<style>:target {transform: rotate(180deg);}</style><form id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></form>"))
(check-sat)
