(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[A-Za-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$")))
(assert (= x "<style>:target {transform: rotate(180deg);}</style><area id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></area>"))
(check-sat)
