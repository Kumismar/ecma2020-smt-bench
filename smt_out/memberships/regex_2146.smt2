(assert (str.in_re x (re.from_ecma2020 "^[a-zA-Z][a-zA-Z\u{415}\u{4b9}\u{413}\u{458}\u{413}\u{b6}\u{414}\u{4b1}\u{414}\u{4b9}\u{413}\u{a7}\u{415}\u{4bb}\u{413}\u{4a3}\u{413}\u{2013}\u{414}\u{b0}\u{414}\u{4bb}\u{413}\u{4ae}0-9-_\.]{1,15}$")))
(assert (= x "<IMG SRC=x onmouseup=""alert(String.fromCharCode(88,83,83))"">"))
(check-sat)
