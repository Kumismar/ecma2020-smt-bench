(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "\s*[\w\-\+_]+(\.[\w\-\+_]+)*@[\w\-\+_]+\.[\w\-\+_]+(\.[\w\-\+_]+)*\s*")))
(assert (= x "<style>@keyframes x{}</style><param style=""animation-name:x"" onanimationend=""alert(1)""></param>"))
(check-sat)
