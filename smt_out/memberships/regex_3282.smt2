(assert (str.in_re x (re.from_ecma2020 "[A-Za-z0-9 \u{f1}\u{d1}\u{e1}\u{e9}\u{ed}\u{f3}\u{fa}\u{c1}\u{c9}\u{cd}\u{d3}\u{da}]{1,20}")))
