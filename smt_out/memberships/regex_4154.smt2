(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 ".*(\W+.*(\d+.*[A-Z]+|[A-Z]+.*\d+)|\d+.*(\W+.*[A-Z]+|[A-Z]+.*\W+)|[A-Z]+.*(\W+.*\d+|\d+.*\W+)).*")))
(assert (= x "<hgroup id=x tabindex=1 ondeactivate=alert(1)></hgroup><input id=y autofocus>"))
(check-sat)
