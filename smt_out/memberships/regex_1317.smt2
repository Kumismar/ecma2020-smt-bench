(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "\s*[\u{410}-\u{42f}\u{401}\u{430}-\u{44f}\u{451}]+[\u{410}-\u{42f}\u{401}\u{430}-\u{44f}\u{451}\s-]*")))
(assert (= x "<image onblur=alert(1) tabindex=1 id=x></image><input autofocus>"))
(check-sat)
