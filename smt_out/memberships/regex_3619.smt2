(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "(0[1-9]|[1,2][0-9]|3[0,1])/(0[1-9]|1[0-2])/(19[0-9][0-9]|2[0-9][0-9][0-9])")))
(assert (= x "<style>@keyframes x{from {left:0;}to {left: 1000px;}}:target {animation:10s ease-in-out 0s 1 x;}</style><center id=x style=""position:absolute;"" onanimationcancel=""alert(1)""></center>"))
(check-sat)
