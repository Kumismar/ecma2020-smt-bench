(assert (str.in_re x (re.from_ecma2020 "^[A-Za-z\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\u{407}\u{457}\u{406}\u{456}\u{404}\u{454}\u{490}\u{491}0-9\-\s]{5,60}$")))
