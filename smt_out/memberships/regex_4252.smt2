(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[A-Z a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Z a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[A-Z a-z0-9](?:[A-Z a-z0-9-]*[A-Z a-z0-9])?\.)+[A-Z a-z0-9](?:[A-Z a-z0-9-]*[A-Z a-z0-9])?")))
(assert (= x "&lt;TABLE BACKGROUND=&quot;javascript:alert(&apos;XSS&apos;)&quot;&gt;&lt;/TABLE&gt;"))
(check-sat)
