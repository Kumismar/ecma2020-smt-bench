(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[a-zA-Z0-9._%+]{1}[a-zA-Z0-9._%+-]*@([a-zA-Z0-9-]{2,63}\.)+[a-zA-Z]{2,7}$")))
(assert (= x "<style>:target {color: red;}</style><picture id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></picture>"))
(check-sat)
