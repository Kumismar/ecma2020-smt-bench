(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[a-zA-Z0-9.!#$%&\u{2019}*+/=?^_`{|}~-]{1,64}@[a-zA-Z0-9-]{1,64}[\.][a-zA-z]{2,}[\.]{0,1}[a-zA-z]{0,}$")))
(assert (= x "<map id=x tabindex=1 onbeforedeactivate=alert(1)></map><input autofocus>"))
(check-sat)
