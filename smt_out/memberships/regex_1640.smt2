(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "([\(]\d{3}[\)\s]{1,}\d{3}[\-]\d{4})|(\d{10})|(\d{3}[\s]\d{3}[\s]\d{4})|(\d{3}[\s]\d{3}[\-]\d{4})|(\d{3}[\s]\d{7})|([\(]\d{3}[\)\s]{1,}\d{3}[\s]\d{4})|([\(]\d{3}[\)\s]{1,}\d{7})|(\d{3}[\-]\d{3}[\-]\d{4})")))
(assert (= x "<big onbeforecut=""alert(1)"" contenteditable>test</big>"))
(check-sat)
