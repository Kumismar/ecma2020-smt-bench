(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "([+a-zA-Z0-9_\-\.]+)@(([a-z]{1,3}\.[a-z]{1,3}\.[a-z]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,24}|[0-9]{1,24})")))
(assert (= x "<u onkeyup=""alert(1)"" contenteditable>test</u>"))
(check-sat)
