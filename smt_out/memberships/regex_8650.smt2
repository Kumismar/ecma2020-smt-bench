(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "\d{2,5}-\d{1,5}-\d{1,5}")))
(assert (= x "<style>@keyframes x{from {left:0;}to {left: 1000px;}}:target {animation:10s ease-in-out 0s 1 x;}</style><input id=x style=""position:absolute;"" onanimationcancel=""alert(1)""></input>"))
(check-sat)
