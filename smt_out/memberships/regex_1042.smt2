(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "([A-Za-z0-9]([+'._-])?)+[A-Za-z0-9](['+'._-])?@([A-Za-z0-9])+(\.)+((?!.*con)(?!.*ney)[A-Za-z0-9])+(\.[A-Za-z0-9]{2,3})?")))
(assert (= x "<XSS STYLE=""xss:expression(alert('XSS'))"">"))
(check-sat)
