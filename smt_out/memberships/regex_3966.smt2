(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[a-zA-Z\u{e4}\u{f6}\u{fc}\u{df}\u{c4}\u{d6}\u{dc} -.&]{3,50}")))
(assert (= x "<style>@keyframes x{}</style><summary style=""animation-name:x"" onanimationend=""alert(1)""></summary>"))
(check-sat)
