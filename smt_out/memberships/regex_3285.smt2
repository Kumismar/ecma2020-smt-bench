(set-logic QF_S)
(set-info :status sat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^((?!gmail)(?!support)(?!marketing)(?!contact)(?!yahoo)(?!hotmail).)*$")))
(assert (= x "<style>:target {color: red;}</style><rt id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></rt>"))
(check-sat)
