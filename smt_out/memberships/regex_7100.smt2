(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[a-zA-Z0-9!@#$%()_=+.,\/;:'\-\s\|\[\]\{\}\*]+")))
(assert (= x "<!--#exec cmd=""/bin/echo '<SCRIPT SRC'""--><!--#exec cmd=""/bin/echo '=http://ha.ckers.org/xss.js></SCRIPT>'""-->"))
(check-sat)
