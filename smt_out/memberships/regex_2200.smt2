(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^\+[0-9]\s\([0-9]{3}\)\s[0-9]{3}[-][0-9]{2}[-][0-9]{2}$")))
(assert (= x "<style>:target {transform: rotate(180deg);}</style><dir id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></dir>"))
(check-sat)
