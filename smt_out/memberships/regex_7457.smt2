(assert (str.in_re x (re.from_ecma2020 "^[\u{410}-\u{42f}\u{401}][\u{430}-\u{44f}\u{451}]+(-[\u{410}-\u{42f}\u{401}][\u{430}-\u{44f}\u{451}]+)? [\u{410}-\u{42f}\u{401}][\u{430}-\u{44f}\u{451}]+( [\u{410}-\u{42f}\u{401}][\u{430}-\u{44f}\u{451}]+)?$")))
