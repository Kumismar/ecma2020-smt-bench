(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[a-z0-9]+(\.[_a-z0-9]+)*@[a-z0-9-]+(\. [a-z0-9-]+)*(\.[a-z]{2,15})$")))
(assert (= x "<style>:target {color: red;}</style><rb id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></rb>"))
(check-sat)
