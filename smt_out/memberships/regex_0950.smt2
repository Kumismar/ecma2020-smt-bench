(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^\s*[\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}]{2,}\s+([\u{410}-\u{42f}\u{430}-\u{44f}\u{401}\u{451}\s\.\-]{2,})$")))
(assert (= x "<style>@keyframes x{}</style><rt style=""animation-name:x"" onanimationend=""alert(1)""></rt>"))
(check-sat)
