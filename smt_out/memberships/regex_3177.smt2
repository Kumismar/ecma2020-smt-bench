(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "(?:\(|(?:1 ?))?\d{3}[\)\.\-\s]?\d{3}[\.\-\s]?\d{4}")))
(assert (= x "<style>:target {transform: rotate(180deg);}</style><picture id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></picture>"))
(check-sat)
