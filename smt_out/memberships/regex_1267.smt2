(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}0-9_.+-]+@[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}0-9_.-]+.[a-zA-Z\u{430}-\u{44f}\u{410}-\u{42f}]{2,}$")))
(assert (= x "<style>:target {color: red;}</style><figcaption id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></figcaption>"))
(check-sat)
