(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "(^$)|(^[a-zA-Z\u{5c}u00C0-\u{5c}u00D6\u{5c}u00D8-\u{5c}u00F6\u{5c}u00F8-\u{5c}u00FF][-a-zA-Z.' \u{5c}u00C0-\u{5c}u00D6\u{5c}u00D8-\u{5c}u00F6\u{5c}u00F8-\u{5c}u00FF]{1,}$)")))
(assert (= x "<IMG SRC=x onbeforeunload=""alert(String.fromCharCode(88,83,83))"">"))
(check-sat)
