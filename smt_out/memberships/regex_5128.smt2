(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[a-zA-Z-\u{e4}\u{f6}\u{fc}\u{df}\u{c4}\u{d6}\u{dc}. ]{2,}")))
(assert (= x "<style>:target {color:red;}</style><blink id=x style=""transition:color 1s"" ontransitionend=alert(1)></blink>"))
(check-sat)
