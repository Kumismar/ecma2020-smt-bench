(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "\d{8}-\d{1}-\d{2}")))
(assert (= x "<style>@keyframes x{from {left:0;}to {left: 1000px;}}:target {animation:10s ease-in-out 0s 1 x;}</style><link id=x style=""position:absolute;"" onanimationcancel=""alert(1)""></link>"))
(check-sat)
