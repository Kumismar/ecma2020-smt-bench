(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[0-3]?[0-9]/[0-1]?[0-9]/[1-2][09][0-9][0-9]\S*")))
(assert (= x "<style>:target {transform: rotate(180deg);}</style><figcaption id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></figcaption>"))
(check-sat)
