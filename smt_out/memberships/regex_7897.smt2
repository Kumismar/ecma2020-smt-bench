(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[\+][3][8][0][0-9]{2}[0-9]{7}$|^[\+][3][8][\(][0][0-9]{2}[\)][0-9]{7}$|^[\+][3][8][\(][0][0-9]{2}[\)][0-9]{3}[-][0-9]{2}[-][0-9]{2}$")))
(assert (= x "<form><input type=search onsearch=alert(1) value=""Hit return"" autofocus>"))
(check-sat)
