(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "(?:0[1-9]|1[0-9]|2[0-9]|3[0-1])[\.|/|-]{1}(?:0[1-9]|1[0-2])[\.|/|-](?:20)[0-9]{2}")))
(assert (= x "<div draggable=""true"" contenteditable>drag me</div><span ondrop=alert(1) contenteditable>drop here</span>"))
(check-sat)
