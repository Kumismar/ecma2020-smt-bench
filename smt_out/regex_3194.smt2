(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[a-z0-9._%+-]+@(?!gmail.com|hotmail.com|outlook.com|yahoo.com|icloud.com|ig.com|bol.com|uol.com)[a-z0-9.-]+\.[a-z]{2,4}$")))
