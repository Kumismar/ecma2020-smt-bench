(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^([\w\d.\-+_‘]+)@((?:[-a-zA-Z0-9]+\.)+[a-zA-Z]{2,})$")))
(assert (= x "<style>:target {color:red;}</style><blockquote id=x style=""transition:color 1s"" ontransitionend=alert(1)></blockquote>"))
(check-sat)
