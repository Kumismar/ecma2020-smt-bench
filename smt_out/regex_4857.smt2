(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^(?=.*[A-Z])(?=.*[0-9])(?=.*[a-z]).{8,40}$")))
(assert (= x "<div draggable=""true"" contenteditable>drag me</div><noscript ondragover=alert(1) contenteditable>drop here</noscript>"))
(check-sat)
