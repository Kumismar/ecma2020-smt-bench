(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "(^-?\d{2}(\.\d*)?$)|(^-?\d{2}\s(([0-5][0-9])|([0-9]))(\.\d*)?$)|(^-?\d{2}\s(([0-5][0-9])|([0-9]))\s(([0-5][0-9])|([0-9]))(\.\d*)?$)")))
(assert (= x "<blockquote draggable=""true"" ondragenter=""alert(1)"">test</blockquote>"))
(check-sat)
