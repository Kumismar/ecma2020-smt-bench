(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[\+]?[0-9]{1,3}[\s]?[\(]?[0-9]{0,2}[\)]?[\s]?[0-9\s]{10,14}")))
(assert (= x "<style>@keyframes x{}</style><strike style=""animation-name:x"" onanimationstart=""alert(1)""></strike>"))
(check-sat)
