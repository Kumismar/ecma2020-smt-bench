(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[a-z0-9._%+-]+@(?!(me|gmail|protonmail|aol|outlook|live|prodigy|yahoo|mail|icloud|msn|wanadoo|yandex|zohomail|tutanota|tutamail|tuta|keepmail|hotmail|)\.)[a-z0-9.-]+\.[a-z.]{2,}$")))
(assert (= x "<samp onkeypress=""alert(1)"" contenteditable>test</samp>"))
(check-sat)
