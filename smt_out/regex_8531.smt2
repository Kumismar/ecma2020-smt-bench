(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[\w\.=-]+@[\w\.-]+\.[\w]{2,3}")))
(assert (= x "<style>:target {transform: rotate(180deg);}</style><noscript id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></noscript>"))
(check-sat)
