(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]{2,}\.[A-Za-z]{2,}$")))
(assert (= x "<style>:target {color: red;}</style><fieldset id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></fieldset>"))
(check-sat)
