(assert (str.in_re x (re.from_ecma2020 "[A-Za-z0-9äüößÄÜÖ.!#$%&'*+-/=?^_`{|}~]{1,}@[a-zA-Z0-9.äüößÄÜÖ-]{1,}([.]{1}[a-zA-Z]{2,}|[.]{1}[a-zA-Z]{2,}[.]{1}[a-zA-Z]{2,})")))
