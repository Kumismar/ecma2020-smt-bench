(set-logic QF_S)
(set-info :status sat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "((http(s)?)://)?(www.)?[a-zA-Z0-9@:%._+~#=-]{2,256}.[a-z0-9]{2,6}[-a-zA-Z0-9@:%_+.~#?&/=)(]*")))
(assert (= x "<template id=x tabindex=1 ondeactivate=alert(1)></template><input id=y autofocus>"))
(check-sat)
