(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "https[A-Za-z0-9:_.\-/\x22,\x27]{1,620}")))
(assert (= x "<style>:target {transform: rotate(180deg);}</style><embed id=x style=""transition:transform 2s"" ontransitionrun=alert(1)></embed>"))
(check-sat)
