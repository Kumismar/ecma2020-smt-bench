(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!#^\-%*_?&])[A-Za-z\d@$!#^\-%_*?&]{6,}")))
(assert (= x "<style>:target {color:red;}</style><q id=x style=""transition:color 1s"" ontransitionend=alert(1)></q>"))
(check-sat)
