(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "((\w+\.)*\w+)@(\w+\.)+(com|kr|net|us|info|biz|co.in|in)")))
(assert (= x "<style>:target {color: red;}</style><blockquote id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></blockquote>"))
(check-sat)
