(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (str.in_re x (re.from_ecma2020 "[A-Za-z][0-9][A-Za-z] ?[0-9][A-Za-z][0-9]")))
(assert (= x "<style>:target {color: red;}</style><spacer id=x style=""transition:color 10s"" ontransitioncancel=alert(1)></spacer>"))
(check-sat)
